                                        ]
                                    },
                                    "code": "(function () {\n    const parse = (v) => (typeof v === 'string' ? JSON.parse(v) : v) || [];\n    const prs = parse($data.prs);\n    const items = parse($data.items);\n    const inProject = new Set(items.map(i => i && i.content && i.content.url).filter(Boolean));\n    const l1 = prs.filter(p => p && p.number\n        && !(p.closingIssuesReferences && p.closingIssuesReferences.totalCount)\n        && !inProject.has(p.url));\n    const since = Date.now() - 2 * 24 * 3600 * 1000;\n    const labelled = (labels) => (labels || []).some(l => String(l).indexOf('appmixer:') === 0 || l === 'non-connector-task');\n    const l2 = items.filter(i => i && i.content && i.content.url\n        && i.createdAt && Date.parse(i.createdAt) >= since\n        && !labelled(i.content.labels));\n    const lines = [];\n    if (l1.length) {\n        lines.push('*Open pull requests with no linked issue that are not in the project* (' + l1.length + ')');\n        l1.forEach(p => lines.push('• <' + p.url + '|#' + p.number + '> ' + p.title + ' — ' + (p.author ? p.author.login : '?')));\n    }\n    if (l2.length) {\n        if (lines.length) lines.push('');\n        lines.push('*Project items added in the last 2 days without a connector label* (' + l2.length + ')');\n        lines.push('_Add `appmixer:<connector>` or `non-connector-task`._');\n        l2.forEach(i => lines.push('• <' + i.content.url + '|' + (i.content.title || i.id) + '>'));\n    }\n    return { hasFindings: lines.length > 0, prsChecked: prs.length, itemsChecked: items.length,\n             level1: l1.length, level2: l2.length, text: lines.join('\\n') };\n})();"
                                }
