                                                "name": "data",
                                                "text": "{{{b4000000-0000-4000-8000-00000000bb01}}}"
                                            }
                                        ]
                                    },
                                    "code": "// Validates the stage result the host posted.\nJSON.stringify((function () {\n    const parse = (x) => (typeof x === 'string' && x ? JSON.parse(x) : (x || null));\n    const d = parse($data.data) || {};\n    const STAGES = ['Testing', 'Doc&Verification', 'Fix', 'Pre-release'];\n    const ok = /^PVTI_[A-Za-z0-9_-]+$/.test(d.itemNodeId || '') && /^PVT_[A-Za-z0-9_-]+$/.test(d.projectNodeId || '')\n        && /^PVTSSF_[A-Za-z0-9_-]+$/.test(d.statusFieldId || '') && /^Appmixer-ai\\/[A-Za-z0-9_.-]+#\\d+$/.test(d.target || '')\n        && STAGES.indexOf(d.stage) >= 0 && ['passed', 'failed', 'blocked'].indexOf(d.result) >= 0;\n    if (!ok) return { ok: false, reason: 'malformed stage result' };\n    const repo = d.target.split('#')[0];\n    const number = d.target.split('#')[1];\n    return {\n        ok: true,\n        stage: d.stage,\n        result: d.result,\n        summary: String(d.summary || '').slice(0, 1000),\n        report: String(d.report || '').slice(0, 20000),\n        itemNodeId: d.itemNodeId,\n        projectNodeId: d.projectNodeId,\n        statusFieldId: d.statusFieldId,\n        target: d.target,\n        prUrl: /^https:\\/\\/github\\.com\\/Appmixer-ai\\/appmixer-connectors\\/pull\\/\\d+$/.test(d.prUrl || '') ? d.prUrl : '',\n        codeFailures: Number(d.codeFailures) || 0,\n        fixable: d.fixable === true,\n        testingRun: /^\\d+-\\d{8}-\\d{6}$/.test(d.testingRun || '') ? d.testingRun : '',\n        repo,\n        number,\n        commentsUrl: '/repos/' + repo + '/issues/' + number + '/comments?per_page=100',\n        at: String(d.at || new Date().toISOString())\n    };\n})())"
                                }
                            }
                        }
                    }
                }
            },
            "x": 400,
            "y": 128
