                                    "code": "// Writes the stage result into the item's pipeline comment (or creates one).\nJSON.stringify((function () {\n    const parse = (x) => (typeof x === 'string' && x ? JSON.parse(x) : (x || null));\n\n    const RENDER = function (state, lastRun) {\n        const row = (r) => '- ' + String(r.at).slice(0, 16).replace('T', ' ') + ' UTC · ' + (r.from || '—') + ' → **' + r.to + '** (' + r.by + ')';\n        const icon = { passed: '✅', failed: '❌', blocked: '⏸️', running: '⏳' };\n        const stages = Object.keys(state.stages || {}).map((name) => {\n            const s = state.stages[name];\n            return ['', '### ' + name + ' ' + (icon[s.result] || '') + ' ' + s.result + ' · ' + String(s.at).slice(0, 16).replace('T', ' ') + ' UTC',\n                '', s.summary || '', s.report ? '\\n' + s.report : ''].join('\\n');\n        });\n        // \"--\" never reaches the HTML comment, so a report cannot close the state block early\n        const json = JSON.stringify(state).replace(/--/g, '\\\\u002d\\\\u002d');\n        return [\n            '🤖 **Pipeline** — status moves of this card on the ' + (state.organization || 'organization') + ' project board',\n            '',\n            state.runs.map(row).join('\\n'),\n            stages.join('\\n'),\n            '',\n            'Connector: ' + (state.connector || '—') + ' · PR: ' + (state.pr || '—') + (lastRun ? ' · last run `' + lastRun + '`' : ''),\n            '',\n            '<!-- pipeline: ' + json + ' -->'\n        ].join('\\n');\n    };\n    const READ_STATE = function (comments) {\n        const existing = (comments || []).filter((c) => typeof c.body === 'string' && c.body.indexOf('<!-- pipeline: ') >= 0)[0];\n        let state = { runs: [], stages: {} };\n        if (existing) {\n            const m = existing.body.match(/<!-- pipeline: (\\{[\\s\\S]*?\\}) -->/);\n            if (m) { try { state = JSON.parse(m[1]); } catch (e) { state = { runs: [], stages: {} }; } }\n        }\n        if (!Array.isArray(state.runs)) state.runs = [];\n        if (!state.stages || typeof state.stages !== 'object') state.stages = {};\n        return { existing, state };\n    };\n\n    const r = parse($data.result) || {};\n    const { existing, state } = READ_STATE(parse($data.comments) || []);\n    state.stages[r.stage] = { result: r.result, summary: r.summary, report: r.report, at: r.at };\n    const body = RENDER(state, '');\n    return existing\n        ? { method: 'PATCH', url: '/repos/' + r.repo + '/issues/comments/' + existing.id, body: JSON.stringify({ body }) }\n        : { method: 'POST', url: '/repos/' + r.repo + '/issues/' + r.number + '/comments', body: JSON.stringify({ body }) };\n})())"
                                }
                            }
                        }
                    }
