        "e4000000-0000-4000-8000-000000000005": {
            "type": "appmixer.utils.controls.CodeBlock",
            "version": "1.0.0",
            "label": "Pipeline comment",
            "errorHandling": {
                "autoRetry": true,
                "onError": "storeUnprocessed"
            },
            "source": {
                "in": {
                    "e4000000-0000-4000-8000-000000000004": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "e4000000-0000-4000-8000-000000000004": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "variables": {
                                        "b4000000-0000-4000-8000-00000000bb04": {
                                            "variable": "$.e4000000-0000-4000-8000-000000000002.out.result",
                                            "functions": []
                                        },
                                        "b4000000-0000-4000-8000-00000000bb05": {
                                            "variable": "$.e4000000-0000-4000-8000-000000000004.out.body",
                                            "functions": []
                                        }
                                    },
                                    "code": {}
                                },
                                "lambda": {
                                    "variables": {
                                        "ADD": [
                                            {
                                                "type": "text",
                                                "name": "result",
                                                "text": "{{{b4000000-0000-4000-8000-00000000bb04}}}"
                                            },
                                            {
                                                "type": "text",
                                                "name": "comments",
                                                "text": "{{{b4000000-0000-4000-8000-00000000bb05}}}"
                                            }
                                        ]
                                    },
                                    "code": "// Writes the stage result into the pipeline comment and decides what happens next:\n//   Testing passed → Review; failed with code failures on a PR vero may push to → In Progress and\n//   the fix stage (at most 3 rounds, then Needs input); other failures → In Progress;\n//   blocked → Needs input. Doc&Verification blocked → Needs input. Fix pushed → Testing again;\n//   Fix gave up → Needs input. Pre-release green → stays (a person merges), else → Needs input.\nJSON.stringify((function () {\n    const parse = (x) => (typeof x === 'string' && x ? JSON.parse(x) : (x || null));\n\n    const RENDER = function (state, lastRun) {\n        const row = (r) => '- ' + String(r.at).slice(0, 16).replace('T', ' ') + ' UTC · ' + (r.from || '—') + ' → **' + r.to + '** (' + r.by + ')';\n        const icon = { passed: '✅', failed: '❌', blocked: '⏸️', running: '⏳' };\n        const stages = Object.keys(state.stages || {}).map((name) => {\n            const s = state.stages[name];\n            return ['', '### ' + name + ' ' + (icon[s.result] || '') + ' ' + s.result + ' · ' + String(s.at).slice(0, 16).replace('T', ' ') + ' UTC',\n                '', s.summary || '', s.report ? '\\n' + s.report : ''].join('\\n');\n        });\n        // \"--\" never reaches the HTML comment, so a report cannot close the state block early\n        const json = JSON.stringify(state).replace(/--/g, '\\\\u002d\\\\u002d');\n        return [\n            '🤖 **Pipeline** — status moves of this card on the ' + (state.organization || 'organization') + ' project board',\n            '',\n            state.runs.map(row).join('\\n'),\n            stages.join('\\n'),\n            '',\n            'Connector: ' + (state.connector || '—') + ' · PR: ' + (state.pr || '—') + (lastRun ? ' · last run `' + lastRun + '`' : ''),\n            '',\n            '<!-- pipeline: ' + json + ' -->'\n        ].join('\\n');\n    };\n    const READ_STATE = function (comments) {\n        const existing = (comments || []).filter((c) => typeof c.body === 'string' && c.body.indexOf('<!-- pipeline: ') >= 0)[0];\n        let state = { runs: [], stages: {} };\n        if (existing) {\n            const m = existing.body.match(/<!-- pipeline: (\\{[\\s\\S]*?\\}) -->/);\n            if (m) { try { state = JSON.parse(m[1]); } catch (e) { state = { runs: [], stages: {} }; } }\n        }\n        if (!Array.isArray(state.runs)) state.runs = [];\n        if (!state.stages || typeof state.stages !== 'object') state.stages = {};\n        return { existing, state };\n    };\n\n    const r = parse($data.result) || {};\n    const { existing, state } = READ_STATE(parse($data.comments) || []);\n    const fix = state.fix || { rounds: 0 };\n    let next = '';\n    let startFix = false;\n    let summary = r.summary;\n    if (r.stage === 'Testing') {\n        if (r.result === 'passed') { next = 'Review'; fix.rounds = 0; }\n        else if (r.result === 'blocked') next = 'Needs input';\n        else if (r.codeFailures > 0 && r.fixable && r.testingRun) {\n            if (fix.rounds < 3) { startFix = true; fix.rounds += 1; next = 'In Progress'; summary += ' Fix round ' + fix.rounds + ' of 3 started.'; }\n            else { next = 'Needs input'; summary += ' 3 fix rounds did not make it green — a person has to look.'; }\n        } else next = 'In Progress';\n    } else if (r.stage === 'Doc&Verification') {\n        next = r.result === 'blocked' ? 'Needs input' : '';\n    } else if (r.stage === 'Fix') {\n        next = r.result === 'passed' ? 'Testing' : 'Needs input';\n    } else if (r.stage === 'Pre-release') {\n        // All green: the card stays, a person merges. Anything missing: Needs input with the list.\n        next = r.result === 'passed' ? '' : 'Needs input';\n    }\n    state.fix = fix;\n    state.stages[r.stage] = { result: r.result, summary: summary, report: r.report, at: r.at };\n    const body = RENDER(state, '');\n    const write = existing\n        ? { method: 'PATCH', url: '/repos/' + r.repo + '/issues/comments/' + existing.id, body: JSON.stringify({ body }) }\n        : { method: 'POST', url: '/repos/' + r.repo + '/issues/' + r.number + '/comments', body: JSON.stringify({ body }) };\n    return Object.assign(write, {\n        nextStatus: next,\n        startFix: startFix,\n        fixPayload: startFix ? JSON.stringify({ pr_url: r.prUrl, item_node_id: r.itemNodeId, project_node_id: r.projectNodeId, status_field_id: r.statusFieldId, target: r.target, testing_run: r.testingRun }) : ''\n    });\n})())"
                                }
                            }
                        }
                    }
                }
