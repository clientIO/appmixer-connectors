                                    "code": "// The isolate hands back only JSON-serializable primitives: return the result as a JSON string.\nJSON.stringify((function () {\n    const parse = (v) => { try { return typeof v === 'string' ? JSON.parse(v) : v; } catch (e) { return v; } };\n    const issue = { title: $data.title, labels: parse($data.labels) || [] };\n    const result = (function issueLabels(issue, bundles) {\n        const ROOT = 'src/appmixer/';\n        const MAX_NAME = 50;    // GitHub's limit on a label name\n        const MAX_LABELS = 5;   // same cut as for pull requests\n        // Connector names that are also ordinary words: they count only as an explicit ref (vendor.module).\n        const COMMON = ['front', 'line', 'box', 'tasks', 'http', 'email', 'mail', 'chat', 'data', 'files', 'file',\n            'calendar', 'sheets', 'docs', 'drive', 'storage', 'utils', 'test', 'ai', 'core', 'controls', 'database',\n            'list', 'records', 'agent', 'agents', 'teams', 'contacts', 'forms', 'tables', 'webhook', 'webhooks',\n            'timers', 'filters', 'converters', 'formatting', 'language', 'text', 'image', 'images', 'video',\n            'audio', 'search', 'news', 'notes', 'meetings', 'messages', 'events', 'people', 'projects', 'crm',\n            'books', 'desk', 'sign', 'analytics', 'ads', 'marketing', 'cloud', 'mcp', 'mcpservers', 'pages'];\n    \n        if ((issue.labels || []).some(l => String(l.name || l).startsWith('appmixer:'))) {\n            return { label: false, reason: 'already has a connector label' };\n        }\n    \n        // Bundle refs on dev: microsoft/mail -> ['microsoft', 'mail'].\n        const refs = (bundles || [])\n            .map(b => b.directory + '/')\n            .filter(d => d.startsWith(ROOT) && d.length > ROOT.length)\n            .map(d => d.slice(ROOT.length, -1).split('/'));\n        const nameOf = parts => 'appmixer:' + parts.join(':');\n        const collapsed = new Set(refs.filter(p => nameOf(p).length > MAX_NAME).map(p => p[0]));\n        const labelOf = parts => collapsed.has(parts[0]) ? 'appmixer:' + parts[0] : nameOf(parts);\n        const dirOf = parts => ROOT + (collapsed.has(parts[0]) ? parts[0] : parts.join('/'));\n    \n        const byRef = new Map();      // 'microsoft.mail' -> parts\n        const byName = new Map();     // 'mail' -> [parts, ...]\n        const vendors = new Map();    // 'microsoft' -> number of bundles below it\n        for (const parts of refs) {\n            byRef.set(parts.join('.').toLowerCase(), parts);\n            const last = parts[parts.length - 1].toLowerCase();\n            byName.set(last, (byName.get(last) || []).concat([parts]));\n            vendors.set(parts[0].toLowerCase(), (vendors.get(parts[0].toLowerCase()) || 0) + 1);\n        }\n    \n        const found = new Map();      // label -> directory\n        const add = parts => found.set(labelOf(parts), dirOf(parts));\n        const title = String(issue.title || '');\n    \n        // 1. An explicit ref anywhere in the title: microsoft.mail, ai/openai, appmixer.ai.typesafe,\n        //    or a component ref (jira.createIssue) - the longest prefix that is a bundle wins.\n        const tokens = title.match(/[A-Za-z0-9_]+(?:[./][A-Za-z0-9_]+)+/g) || [];\n        const matchedTokens = [];\n        for (const token of tokens) {\n            let parts = token.split(/[./]/);\n            if (parts[0].toLowerCase() === 'appmixer') parts = parts.slice(1);\n            if (parts.length < 2) continue;\n            let matched = false;\n            for (let n = parts.length; n >= 2 && !matched; n--) {\n                const ref = byRef.get(parts.slice(0, n).join('.').toLowerCase());\n                if (ref) {\n                    add(ref);\n                    matched = true;\n                }\n            }\n            // A vendor that is a bundle of its own followed by a component (jira.createIssue, slack.ListChannels).\n            if (!matched && byRef.has(parts[0].toLowerCase()) && !byRef.has(parts[1].toLowerCase())) {\n                add(byRef.get(parts[0].toLowerCase()));\n                matched = true;\n            }\n            if (matched) matchedTokens.push(token);\n        }\n    \n        // 2. The head of the title, before ': ', ' - ' or ' — ': 'Slack: ...', 'Google Drive - ...',\n        //    'slack 5.5.1: ...', 'Microsoft Teams SendChannelMessage: ...', 'Hubspot, Asana: ...'.\n        //    Each listed name counts by its first one to three words.\n        // An explicit ref already matched above is taken out, so ai/openai does not also count as 'openai'.\n        let head = title\n            .replace(/^(\\[[^\\]]*\\]\\s*)+/, '')\n            .split(/:\\s|:$|\\s[-–—]\\s/)[0]\n            .replace(/\\([^)]*\\)|\\[[^\\]]*\\]/g, ' ');\n        for (const token of matchedTokens) head = head.split(token).join(' ');\n        head = head.trim();\n        // Names people use for a module that is called differently in the repository.\n        const ALIASES = { sheets: 'spreadsheets' };\n        const matchWords = words => {\n            for (let k = Math.min(3, words.length); k >= 1; k--) {\n                const key = words.slice(0, k).map(w => ALIASES[w] || w).join('.');\n                const ref = byRef.get(key);\n                if (ref) return add(ref);\n                if (k > 1) continue;\n                const named = byName.get(key) || [];\n                if (named.length === 1 && !COMMON.includes(key)) return add(named[0]);\n                if ((vendors.get(key) || 0) > 1 && !COMMON.includes(key)) {\n                    // The vendor alone ('Microsoft: ...', 'microsoft auth: ...') is about its shared root.\n                    found.set('appmixer:' + key, ROOT + key);\n                }\n            }\n        };\n        if (head && head.length <= 80) {\n            for (const item of head.split(/,|\\s\\/\\s|\\/|&|\\+|\\sand\\s/)) {\n                const words = item.toLowerCase()\n                    .replace(/^\\s*appmixer[\\s.]+/, '')\n                    .split(/[\\s.]+/)\n                    .filter(w => w && !/^v?\\d/.test(w));\n                if (words.length) matchWords(words);\n            }\n        }\n    \n        const labels = Array.from(found.keys()).sort();\n        if (!labels.length) {\n            return { label: false, reason: 'no connector in the title' };\n        }\n        if (labels.length > MAX_LABELS) {\n            return { label: false, reason: 'names ' + labels.length + ' connectors, more than ' + MAX_LABELS };\n        }\n        return { label: true, labels, dirs: labels.map(l => found.get(l)) };\n    })(issue, parse($data.bundles) || []);\n    if (!result.label) {\n        return result;\n    }\n    // url is the issue's API URL: https://api.github.com/repos/{owner}/{repo}/issues/{number}\n    return {\n        label: true,\n        labels: result.labels.join(', '),\n        url: String($data.url).replace(/^https:\\/\\/api\\.github\\.com/, '') + '/labels',\n        body: JSON.stringify({ labels: result.labels })\n    };\n})());"
                                }
                            }
                        }
                    }
                }
            }
