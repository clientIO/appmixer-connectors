                "placeholder": "",
                "attrs": {
                    "service": "appmixer:github",
                    "components": [
                        "a2000000-0000-4000-8000-000000000003"
                    ],
                    "sharedAccountId": null
                },
                "options": {}
            },
            {
                "type": "inspectorField",
                "label": "Repositories to watch",
                "tooltip": "owner/repo, comma-separated. Each needs .github/workflows/claude-mention-responder.yml on its default branch.",
                "placeholder": "Appmixer-ai/appmixer-connectors",
                "source": "a2000000-0000-4000-8000-000000000001.config.properties.repositories",
                "attrs": {},
                "options": {}
            }
        ]
    }
