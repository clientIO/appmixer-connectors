{
    "name": "CI - @apx-vero mention -> repository_dispatch",
    "description": "When someone mentions @apx-vero on a pull request, starts the Claude mention responder workflow (repository_dispatch `apx-vero-mention`), which replies and pushes fixes.",
    "flow": {
        "a2000000-0000-4000-8000-000000000001": {
