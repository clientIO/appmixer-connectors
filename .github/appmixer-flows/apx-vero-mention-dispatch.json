                                "modifiers": {
                                    "repositoryId": {
                                        "b2000000-0000-4000-8000-000000000003": {
                                            "variable": "$.a2000000-0000-4000-8000-000000000001.out.repository.full_name",
                                            "functions": []
                                        }
                                    },
                                    "eventType": {},
                                    "clientPayload": {
                                        "b2000000-0000-4000-8000-000000000002": {
                                            "variable": "$.a2000000-0000-4000-8000-000000000001.out.subject.url",
                                            "functions": []
