                "onError": "storeUnprocessed"
            },
            "config": {
                "properties": {
                    "repositories": "Appmixer-ai/appmixer-connectors"
                }
            },
            "x": 208,
            "y": 128
        },
        "a2000000-0000-4000-8000-000000000002": {
