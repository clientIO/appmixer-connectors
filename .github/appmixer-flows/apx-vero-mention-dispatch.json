                                    }
                                },
                                "lambda": {
                                    "repositoryId": "{{{b2000000-0000-4000-8000-000000000003}}}",
                                    "eventType": "apx-vero-mention",
                                    "clientPayload": "{\"pr_url\": \"{{{b2000000-0000-4000-8000-000000000002}}}\"}"
