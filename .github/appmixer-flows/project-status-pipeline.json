                                                "name": "sender",
                                                "text": "{{{b3000000-0000-4000-8000-00000000bb07}}}"
                                            }
                                        ]
                                    },
                                    "code": "// The isolate hands back only JSON-serializable primitives: return the result as a JSON string.\nJSON.stringify((function () {\n    const parse = (x) => (typeof x === 'string' && x ? JSON.parse(x) : (x || null));\n    const item = parse($data.item) || {};\n    const changes = parse($data.changes) || {};\n    const node = parse($data.content) || {};\n    const field = changes.field_value || {};\n    const status = String(field.to || '');\n    const from = String(field.from || '');\n    if (!status) return { ok: false, reason: 'no target status in the change' };\n    if (!node.__typename || node.__typename === 'DraftIssue') {\n        return { ok: false, reason: 'draft issue: nothing to resolve', status, from };\n    }\n    const repoOf = (n) => (n && n.repository && n.repository.nameWithOwner) || '';\n    const labels = ((node.labels || {}).nodes || []).map((l) => l.name);\n    const connectors = labels.filter((l) => l.indexOf('appmixer:') === 0).map((l) => l.slice('appmixer:'.length));\n    let issue = null;\n    let pr = null;\n    if (node.__typename === 'Issue') {\n        issue = { number: node.number, url: node.url, repo: repoOf(node), title: node.title, state: node.state };\n        // The PR that closes the issue: an open one first, else the newest\n        const linked = ((node.closedByPullRequestsReferences || {}).nodes || []);\n        const chosen = linked.filter((p) => p.state === 'OPEN')[0] || linked[linked.length - 1];\n        if (chosen) pr = { number: chosen.number, url: chosen.url, repo: repoOf(chosen), state: chosen.state, isDraft: !!chosen.isDraft, branch: chosen.headRefName || '' };\n    } else if (node.__typename === 'PullRequest') {\n        pr = { number: node.number, url: node.url, repo: repoOf(node), title: node.title, state: node.state, isDraft: !!node.isDraft, branch: node.headRefName || '' };\n    } else {\n        return { ok: false, reason: 'unsupported content type ' + node.__typename, status, from };\n    }\n    const target = issue || pr;\n    return {\n        ok: true,\n        status,\n        from,\n        // Deterministic: a webhook redelivery of the same change produces the same id\n        runId: [item.node_id, status, item.updated_at].join(':'),\n        item: { nodeId: item.node_id, projectNodeId: item.project_node_id, contentType: item.content_type },\n        issue,\n        pr,\n        connector: connectors.join(','),\n        branch: pr ? pr.branch : '',\n        target: issue ? 'issue' : 'pr',\n        targetRepo: target.repo,\n        targetNumber: target.number,\n        commentsUrl: '/repos/' + target.repo + '/issues/' + target.number + '/comments?per_page=100',\n        by: String($data.sender || '')\n    };\n})())"
                                }
