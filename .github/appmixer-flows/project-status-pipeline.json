                                                "type": "text",
                                                "name": "comments",
                                                "text": "{{{b3000000-0000-4000-8000-00000000bb11}}}"
                                            }
                                        ]
                                    },
                                    "code": "// Finds the pipeline comment on the item, drops a run already recorded, otherwise rewrites the\n// comment with the new status move. The machine-readable state sits in <!-- pipeline: {...} -->.\nJSON.stringify((function () {\n    const parse = (x) => (typeof x === 'string' && x ? JSON.parse(x) : (x || null));\n    const event = parse($data.event) || {};\n    const comments = parse($data.comments) || [];\n    const MARK = '<!-- pipeline: ';\n    const existing = comments.filter((c) => typeof c.body === 'string' && c.body.indexOf(MARK) >= 0)[0];\n    let state = { runs: [] };\n    if (existing) {\n        const m = existing.body.match(/<!-- pipeline: (\\{[\\s\\S]*?\\}) -->/);\n        if (m) { try { state = JSON.parse(m[1]); } catch (e) { state = { runs: [] }; } }\n        if (!Array.isArray(state.runs)) state.runs = [];\n    }\n    if (state.runs.some((r) => r.id === event.runId)) {\n        return { duplicate: true, runId: event.runId };\n    }\n    const now = new Date().toISOString();\n    state.runs.push({ id: event.runId, at: now, from: event.from, to: event.status, by: event.by, stage: 'recorded' });\n    state.runs = state.runs.slice(-30);\n    state.connector = event.connector || '';\n    state.pr = event.pr ? event.pr.url : '';\n    const row = (r) => '- ' + r.at.slice(0, 16).replace('T', ' ') + ' UTC · ' + (r.from || '—') + ' → **' + r.to + '** (' + r.by + ')'\n        + (r.stage && r.stage !== 'recorded' ? ' · ' + r.stage : '');\n    const body = [\n        '🤖 **Pipeline** — status moves of this item on [@appmixer-connectors](https://github.com/orgs/Appmixer-ai/projects/7)',\n        '',\n        state.runs.map(row).join('\\n'),\n        '',\n        'Connector: ' + (event.connector || '—') + ' · PR: ' + (event.pr ? event.pr.url : '—') + ' · last run `' + event.runId + '`',\n        '',\n        MARK + JSON.stringify(state) + ' -->'\n    ].join('\\n');\n    return existing\n        ? { duplicate: false, method: 'PATCH', url: '/repos/' + event.targetRepo + '/issues/comments/' + existing.id, body: JSON.stringify({ body }) }\n        : { duplicate: false, method: 'POST', url: '/repos/' + event.targetRepo + '/issues/' + event.targetNumber + '/comments', body: JSON.stringify({ body }) };\n})())"
                                }
                            }
                        }
                    }
                }
