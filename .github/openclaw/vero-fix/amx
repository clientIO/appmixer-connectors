#!/usr/bin/env bash
# The appmixer CLI against dev-automated-00001 for the fix stage — TRUSTED wrapper. Logs in from the
# root-only /root/.openclaw/pipeline/appmixer.json and passes the token by environment, so vero can
# reproduce a failure (`./amx test component …`, `./amx e2e run <flowId>`, `./amx logs …`) without
# ever seeing the credentials. `publish` and destructive commands are refused: the fix is verified by
# the Testing stage that runs after the push, not by publishing from here.
set -euo pipefail
case "${1:-}" in
  publish|rm|delete|login|logout|url|alias|config|service-config|accounts|auth|people-tasks|user)
    echo "REFUSED: '$1' is not available in the fix stage"; exit 1 ;;
esac
TOKEN=$(node -e '
const a=require("/root/.openclaw/pipeline/appmixer.json");
fetch(a.apiUrl+"/user/auth",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({username:a.username,password:a.password})})
  .then(r=>r.json()).then(j=>process.stdout.write(j.token||""));')
API=$(node -e 'process.stdout.write(require("/root/.openclaw/pipeline/appmixer.json").apiUrl+"/")')
UI=$(node -e 'process.stdout.write(require("/root/.openclaw/pipeline/appmixer.json").uiUrl)')
APPMIXER_TOKEN="$TOKEN" APPMIXER_API_URL="$API" APPMIXER_SKILL_UI_URL="$UI" APPMIXER_NO_BANNER=1 exec appmixer "$@"
