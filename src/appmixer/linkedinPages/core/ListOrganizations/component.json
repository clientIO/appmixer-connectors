{
    "name": "appmixer.linkedinPages.core.ListOrganizations",
    "description": "List LinkedIn organization pages where the authenticated member is an approved administrator or content administrator. Used as a data source for the organization dropdown.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": true,
    "auth": {
        "service": "appmixer:linkedinPages",
        "scope": [
            "rw_organization_admin"
        ]
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {}
            },
            "inspector": {
                "inputs": {}
            }
        }
    ],
    "properties": {},
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "organizations": {
                        "type": "array",
                        "title": "Organizations",
                        "example": [
                            {
                                "id": "2414183",
                                "name": "DevTestCo"
                            }
                        ],
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "string",
                                    "title": "Organizations.ID",
                                    "example": "2414183"
                                },
                                "name": {
                                    "type": "string",
                                    "title": "Organizations.Name",
                                    "example": "DevTestCo"
                                }
                            }
                        }
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
