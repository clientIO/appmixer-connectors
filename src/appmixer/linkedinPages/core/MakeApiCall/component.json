{
    "name": "appmixer.linkedinPages.core.MakeApiCall",
    "description": "Performs an arbitrary authorized API call to the LinkedIn API.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:linkedinPages",
        "scope": [
            "w_organization_social",
            "rw_organization_admin"
        ]
    },
    "quota": {
        "manager": "appmixer:linkedinPages",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "url": {
                        "type": "string"
                    },
                    "method": {
                        "type": "string",
                        "enum": [
                            "GET",
                            "POST",
                            "PUT",
                            "PATCH",
                            "DELETE"
                        ]
                    },
                    "headers": {
                        "type": "string"
                    },
                    "parameters": {
                        "type": "string"
                    },
                    "body": {
                        "type": "string"
                    }
                },
                "required": [
                    "url",
                    "method"
                ]
            },
            "inspector": {
                "inputs": {
                    "url": {
                        "type": "text",
                        "index": 1,
                        "label": "API Endpoint Path",
                        "tooltip": "Enter the API endpoint path relative to <code>https://api.linkedin.com</code> (for example <code>/rest/organizationAcls</code>) or a full URL on that host. Other hosts are rejected. The LinkedIn-Version and X-Restli-Protocol-Version headers are added automatically."
                    },
                    "method": {
                        "type": "select",
                        "index": 2,
                        "label": "HTTP Method",
                        "defaultValue": "GET",
                        "tooltip": "Select the HTTP method for the API call.",
                        "options": [
                            {
                                "label": "GET",
                                "value": "GET"
                            },
                            {
                                "label": "POST",
                                "value": "POST"
                            },
                            {
                                "label": "PUT",
                                "value": "PUT"
                            },
                            {
                                "label": "PATCH",
                                "value": "PATCH"
                            },
                            {
                                "label": "DELETE",
                                "value": "DELETE"
                            }
                        ]
                    },
                    "parameters": {
                        "type": "key-value",
                        "keyLabel": "Key",
                        "valueLabel": "Value",
                        "addLabel": "Add item",
                        "removeLabel": "Remove item",
                        "label": "Query Parameters",
                        "index": 3,
                        "tooltip": "Optional query parameters."
                    },
                    "body": {
                        "type": "textarea",
                        "index": 4,
                        "label": "Request Body",
                        "tooltip": "Enter the request body as a JSON object (supports nested objects, arrays, and non-string values)."
                    },
                    "headers": {
                        "type": "key-value",
                        "keyLabel": "Key",
                        "valueLabel": "Value",
                        "addLabel": "Add item",
                        "removeLabel": "Remove item",
                        "label": "Request Headers",
                        "index": 5,
                        "tooltip": "Optional additional request headers."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "integer",
                        "title": "Status Code",
                        "example": 200
                    },
                    "headers": {
                        "type": "object",
                        "title": "Response Headers",
                        "example": {
                            "content-type": "application/json",
                            "x-restli-protocol-version": "2.0.0"
                        }
                    },
                    "body": {
                        "type": "object",
                        "title": "Response Body",
                        "example": {
                            "elements": [
                                {
                                    "role": "ADMINISTRATOR",
                                    "state": "APPROVED",
                                    "organization": "urn:li:organization:2414183"
                                }
                            ]
                        }
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
