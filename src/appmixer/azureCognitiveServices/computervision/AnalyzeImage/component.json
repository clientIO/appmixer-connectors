{
    "name": "appmixer.azureCognitiveServices.computervision.AnalyzeImage",
    "author": "David Durman <david@client.io>",
    "description": "This operation extracts a rich set of visual features based on the image content.",
    "private": false,
    "quota": {
        "manager": "appmixer:azureCognitiveServices",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "properties": {
                    "imageUrl": {
                        "type": "string"
                    },
                    "language": {
                        "type": "string"
                    },
                    "visualFeatures": { "type": ["string", "array"] }
                },
                "required": [
                    "imageUrl"
                ]
            },
            "inspector": {
                "inputs": {
                    "imageUrl": {
                        "type": "text",
                        "label": "Image URL",
                        "index": 1,
                        "tooltip": "Specify a URL of an image to analyze."
                    },
                    "language": {
                        "type": "select",
                        "label": "Language",
                        "defaultValue": "en",
                        "options": [
                            { "value": "en", "content": "English" },
                            { "value": "es", "content": "Spanish" },
                            { "value": "ja", "content": "Japanese" },
                            { "value": "pt", "content": "Portuguese" },
                            { "value": "zh", "content": "Simplified Chinese" }
                        ],
                        "index": 2,
                        "tooltip": "The desired language for output generation. Default is English."
                    },
                    "visualFeatures": {
                        "type": "multiselect",
                        "label": "Visual Features",
                        "defaultValue": "Categories",
                        "options": [
                            { "value": "Categories", "content": "Categories" },
                            { "value": "Tags", "content": "Tags" },
                            { "value": "Description", "content": "Description" },
                            { "value": "Faces", "content": "Faces" },
                            { "value": "ImageType", "content": "ImageType" },
                            { "value": "Color", "content": "Color" },
                            { "value": "Adult", "content": "Adult" },
                            { "value": "Objects", "content": "Objects" },
                            { "value": "Brands", "content": "Brands" }
                        ],
                        "index": 3,
                        "tooltip": "Visual feature types to return."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Description",
                    "value": "description",
                    "schema": {
                        "type": "object",
                        "example": {
                            "tags": [
                                "building",
                                "outdoor",
                                "sky"
                            ],
                            "captions": [
                                {
                                    "text": "a large building with a sign on the front",
                                    "confidence": 0.9319
                                }
                            ]
                        }
                    }
                },
                {
                    "label": "Categories",
                    "value": "categories",
                    "schema": {
                        "type": "array",
                        "example": [
                            {
                                "name": "building_",
                                "score": 0.93359375
                            }
                        ]
                    }
                },
                {
                    "label": "Tags",
                    "value": "tags",
                    "schema": {
                        "type": "array",
                        "example": [
                            {
                                "name": "building",
                                "confidence": 0.9981
                            },
                            {
                                "name": "sky",
                                "confidence": 0.9923
                            }
                        ]
                    }
                },
                {
                    "label": "Faces",
                    "value": "faces",
                    "schema": {
                        "type": "array",
                        "example": []
                    }
                },
                {
                    "label": "ImageType",
                    "value": "imageType",
                    "schema": {
                        "type": "object",
                        "example": {
                            "clipArtType": 0,
                            "lineDrawingType": 0
                        }
                    }
                },
                {
                    "label": "Color",
                    "value": "color",
                    "schema": {
                        "type": "object",
                        "example": {
                            "dominantColorForeground": "Grey",
                            "dominantColorBackground": "White",
                            "dominantColors": [
                                "White",
                                "Grey"
                            ],
                            "accentColor": "19538E",
                            "isBWImg": false
                        }
                    }
                },
                {
                    "label": "Adult",
                    "value": "adult",
                    "schema": {
                        "type": "object",
                        "example": {
                            "isAdultContent": false,
                            "isRacyContent": false,
                            "isGoryContent": false,
                            "adultScore": 0.0019,
                            "racyScore": 0.0031,
                            "goreScore": 0.0012,
                            "isOtherContent": true
                        }
                    }
                },
                {
                    "label": "Metadata",
                    "value": "metadata",
                    "schema": {
                        "type": "object",
                        "example": {
                            "width": 1024,
                            "height": 768,
                            "format": "Jpeg"
                        }
                    }
                },
                {
                    "label": "Description First Caption Text",
                    "value": "description.captions.[0].text",
                    "schema": {
                        "type": "string",
                        "example": "a large building with a sign on the front"
                    }
                },
                {
                    "label": "Description First Caption Confidence",
                    "value": "description.captions.[0].confidence",
                    "schema": {
                        "type": "number",
                        "example": 0.9319
                    }
                },
                {
                    "label": "Description First Caption Confidence",
                    "value": "description.captions.[0].confidence",
                    "schema": {
                        "type": "number",
                        "example": 0.9319
                    }
                },
                {
                    "label": "First Category Name",
                    "value": "categories.[0].name",
                    "schema": {
                        "type": "string",
                        "example": "building_"
                    }
                },
                {
                    "label": "First Category Score",
                    "value": "categories.[0].score",
                    "schema": {
                        "type": "number",
                        "example": 0.93359375
                    }
                },
                {
                    "label": "Is Adult Content",
                    "value": "adult.isAdultContent",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Is Racy Content",
                    "value": "adult.isRacyContent",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Is Gory Content",
                    "value": "adult.isGoryContent",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Is Other Content",
                    "value": "adult.isOtherContent",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "Dominant Color Foreground",
                    "value": "color.dominantColorForeground",
                    "schema": {
                        "type": "string",
                        "example": "Grey"
                    }
                },
                {
                    "label": "Dominant Color Background",
                    "value": "color.dominantColorBackground",
                    "schema": {
                        "type": "string",
                        "example": "White"
                    }
                },
                {
                    "label": "Is Black & White Image",
                    "value": "color.isBWImg",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Is Clip Art Image",
                    "value": "imageType.clipArtType",
                    "schema": {
                        "type": "integer",
                        "example": 0
                    }
                },
                {
                    "label": "Is Line Drawing Image",
                    "value": "imageType.lineDrawingType",
                    "schema": {
                        "type": "integer",
                        "example": 0
                    }
                },
                {
                    "label": "First Tag Name",
                    "value": "tags.[0].name",
                    "schema": {
                        "type": "string",
                        "example": "building"
                    }
                },
                {
                    "label": "First Tag Confidence",
                    "value": "tags.[0].confidence",
                    "schema": {
                        "type": "number",
                        "example": 0.9981
                    }
                },
                {
                    "label": "Number of Faces",
                    "value": "faces.length",
                    "schema": {
                        "type": "integer",
                        "example": 0
                    }
                },
                {
                    "label": "Number of Objects",
                    "value": "objects.length",
                    "schema": {
                        "type": "integer",
                        "example": 1
                    }
                },
                {
                    "label": "Number of Brands",
                    "value": "brands.length",
                    "schema": {
                        "type": "integer",
                        "example": 1
                    }
                },
                {
                    "label": "First Brand Name",
                    "value": "brands.[0].name",
                    "schema": {
                        "type": "string",
                        "example": "Microsoft"
                    }
                },
                {
                    "label": "Width",
                    "value": "metadata.width",
                    "schema": {
                        "type": "integer",
                        "example": 1024
                    }
                },
                {
                    "label": "Height",
                    "value": "metadata.height",
                    "schema": {
                        "type": "integer",
                        "example": 768
                    }
                },
                {
                    "label": "Format",
                    "value": "metadata.format",
                    "schema": {
                        "type": "string",
                        "example": "Jpeg"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
