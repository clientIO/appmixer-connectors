{
    "name": "appmixer.ai.groq.CreateTranscription",
    "label": "Create Transcription",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Generates a transcription of audio content to text.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:ai:groq"
    },
    "quota": {
        "manager": "appmixer:ai:groq",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "model": {
                        "type": "string"
                    },
                    "file": {
                        "type": "string"
                    },
                    "language": {
                        "type": "string"
                    },
                    "prompt": {
                        "type": "string"
                    },
                    "temperature": {
                        "type": "number"
                    }
                },
                "required": [
                    "model",
                    "file"
                ]
            },
            "inspector": {
                "inputs": {
                    "model": {
                        "type": "text",
                        "label": "Model",
                        "tooltip": "Insert a model ID or select one of the models available to your Groq account. Speech-to-text models are named <code>whisper-*</code>.",
                        "index": 1,
                        "defaultValue": "whisper-large-v3",
                        "source": {
                            "url": "/component/appmixer/ai/groq/ListModels?outPort=out",
                            "data": {
                                "properties": { "isSource": true },
                                "transform": "./ListModels#toSelectArray"
                            }
                        }
                    },
                    "file": {
                        "type": "filepicker",
                        "label": "Audio File",
                        "tooltip": "Upload an audio file (mp3, wav, etc.)",
                        "index": 2
                    },
                    "language": {
                        "type": "text",
                        "label": "Language",
                        "tooltip": "Language code (ISO 639-1) to improve accuracy.",
                        "index": 3
                    },
                    "prompt": {
                        "type": "textarea",
                        "label": "Prompt",
                        "tooltip": "Guide the model with prior text or style.",
                        "index": 4
                    },
                    "temperature": {
                        "type": "number",
                        "label": "Temperature",
                        "tooltip": "Controls randomness of output (0 to 1).",
                        "index": 5
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Transcription",
                    "value": "text",
                    "schema": {
                        "type": "string",
                        "example": "Welcome to the quarterly review call."
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
