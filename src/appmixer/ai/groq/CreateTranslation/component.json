{
    "name": "appmixer.ai.groq.CreateTranslation",
    "label": "Create Translation",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Translates spoken words in an audio or video file to English.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:ai:groq"
    },
    "quota": {
        "manager": "appmixer:ai:groq",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "model": {
                        "type": "string"
                    },
                    "file": {
                        "type": "string"
                    },
                    "prompt": {
                        "type": "string"
                    },
                    "temperature": {
                        "type": "number"
                    }
                },
                "required": [
                    "model",
                    "file"
                ]
            },
            "inspector": {
                "inputs": {
                    "model": {
                        "type": "text",
                        "label": "Model",
                        "tooltip": "Insert a model ID or select one of the models available to your Groq account. Speech-to-text models are named <code>whisper-*</code>.",
                        "index": 1,
                        "defaultValue": "whisper-large-v3",
                        "source": {
                            "url": "/component/appmixer/ai/groq/ListModels?outPort=out",
                            "data": {
                                "properties": { "isSource": true },
                                "transform": "./ListModels#toSelectArray"
                            }
                        }
                    },
                    "file": {
                        "type": "filepicker",
                        "label": "Audio File",
                        "tooltip": "Upload audio file (mp3, wav, etc.) to translate.",
                        "index": 2
                    },
                    "prompt": {
                        "type": "textarea",
                        "label": "Prompt",
                        "tooltip": "Optional English text to guide the model.",
                        "index": 3
                    },
                    "temperature": {
                        "type": "number",
                        "label": "Temperature",
                        "tooltip": "0 = deterministic, 1 = more random.",
                        "index": 4
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Translation",
                    "value": "text",
                    "schema": {
                        "type": "string",
                        "example": "Welcome to the quarterly review call."
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
