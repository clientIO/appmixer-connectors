{
    "name": "appmixer.ai.typesafe.AskQuestions",
    "label": "Ask Questions",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Ask several questions about the same content in one TypeSafe Jev request, mixing all three types: <code>choice</code> (Classify Text), <code>score</code> (Score Text) and <code>noul</code> (Verify Statement). This is the recommended way to ask more than one thing: the content is sent and billed once and the questions are evaluated in parallel, so it is faster and cheaper than one component per question. The answers are returned keyed by your question ids. Works best with English content.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:ai:typesafe"
    },
    "quota": {
        "manager": "appmixer:ai:typesafe",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "state": {},
                    "questions": {},
                    "model": {
                        "type": "string"
                    }
                },
                "required": [
                    "state"
                ]
            },
            "inspector": {
                "inputs": {
                    "state": {
                        "type": "textarea",
                        "label": "Content",
                        "index": 1,
                        "tooltip": "The text the questions are about. A JSON object or array mapped from a variable is sent as structured data. Text only, up to about 32k tokens."
                    },
                    "questions": {
                        "type": "expression",
                        "label": "Questions",
                        "index": 2,
                        "tooltip": "Required. The questions to ask about the content, one row each. All of them are answered in a single request. Every answer is available as its own output variable, named after the Question ID.",
                        "levels": [
                            "ADD"
                        ],
                        "fields": {
                            "id": {
                                "type": "text",
                                "label": "Question ID",
                                "index": 1,
                                "tooltip": "A short name for the answer, for example <code>department</code> or <code>is_urgent</code>. Letters, digits and underscores only; it names the output variables of this question."
                            },
                            "type": {
                                "type": "select",
                                "label": "Type",
                                "index": 2,
                                "defaultValue": "choice",
                                "tooltip": "Choice picks one of your options, Score rates on your scale, True or False checks a statement.",
                                "options": [
                                    {
                                        "label": "Choice (pick one option)",
                                        "value": "choice"
                                    },
                                    {
                                        "label": "Score (rate on a scale)",
                                        "value": "score"
                                    },
                                    {
                                        "label": "True or False (verify a statement)",
                                        "value": "noul"
                                    }
                                ]
                            },
                            "instructions": {
                                "type": "text",
                                "label": "Question",
                                "index": 3,
                                "tooltip": "What to decide, for example <code>Which team should handle this</code>, <code>How frustrated the customer appears</code> or the statement to verify, <code>The message is urgent</code>."
                            },
                            "options": {
                                "type": "textarea",
                                "label": "Options",
                                "index": 4,
                                "tooltip": "One option per line (2 to 255), as <code>key</code> or <code>key: description</code>, for example <code>billing: Payments, invoices and refunds</code>. The key is what the answer returns.",
                                "when": {
                                    "eq": {
                                        "./type": "choice"
                                    }
                                }
                            },
                            "levels": {
                                "type": "textarea",
                                "label": "Levels",
                                "index": 4,
                                "tooltip": "One level description per line (2 to 10), ordered from the lowest (level 0) to the highest, for example <code>Calm, just stating facts</code>.",
                                "when": {
                                    "eq": {
                                        "./type": "score"
                                    }
                                }
                            },
                            "trueCriteria": {
                                "type": "text",
                                "label": "When True",
                                "index": 4,
                                "tooltip": "Optional. Describe what makes the statement true.",
                                "when": {
                                    "eq": {
                                        "./type": "noul"
                                    }
                                }
                            },
                            "falseCriteria": {
                                "type": "text",
                                "label": "When False",
                                "index": 5,
                                "tooltip": "Optional. Describe what makes the statement false.",
                                "when": {
                                    "eq": {
                                        "./type": "noul"
                                    }
                                }
                            }
                        }
                    },
                    "model": {
                        "type": "text",
                        "label": "Model",
                        "index": 3,
                        "defaultValue": "jev-latest",
                        "tooltip": "Model name or alias. <code>jev-latest</code> is the stable alias, <code>jev-preview</code> the preview build; a version such as <code>jev-1.13.0</code> pins the model.",
                        "source": {
                            "url": "/component/appmixer/ai/typesafe/ListModels?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListModels#toSelectArray"
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/ai/typesafe/AskQuestions?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/state": "dummy",
                        "in/questions": "inputs/in/questions"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
