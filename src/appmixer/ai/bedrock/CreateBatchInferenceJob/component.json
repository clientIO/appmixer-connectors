{
    "name": "appmixer.ai.bedrock.CreateBatchInferenceJob",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a batch inference job to invoke a model on multiple prompts (100+).",
    "auth": {
        "service": "appmixer:ai:bedrock"
    },
    "version": "1.0.1",
    "inPorts": [{
        "name": "in",
        "schema": {
            "type": "object",
            "properties": {
                "jobName": { "type": "string" },
                "roleArn": { "type": "string" },
                "s3InputObjectBucket": { "type": "string" },
                "s3InputObjectKey": { "type": "string" },
                "s3OutputObjectBucket": { "type": "string" },
                "s3OutputObjectKey": { "type": "string" },
                "region": { "type": "string" },
                "model": { "type": "string" }
            },
            "required": ["region", "model",  "roleArn", "jobName", "s3OutputObjectBucket", "s3OutputObjectKey", "s3InputObjectBucket", "s3InputObjectKey"]
        },
        "inspector": {
            "inputs": {
                "jobName": {
                    "type": "text",
                    "label": "Job Name",
                    "index": 1,
                    "tooltip": "The name of the job."
                },
                "roleArn": {
                    "type": "text",
                    "label": "Role ARN",
                    "index": 2,
                    "tooltip": "IAM Role: Ensure that the IAM role specified in roleArn has the necessary permissions for both Bedrock operations and access to the specified S3 buckets. Example <code>arn:aws:iam::123456789:role/bedrock-model-invocation-role</code>."
                },
                "s3InputObjectBucket": {
                    "type": "text",
                    "label": "Input S3 Object Bucket",
                    "tooltip": "You can pass a JSONL file stored in your S3 as an input to your model. See <a target=_blank href=\"https://docs.aws.amazon.com/bedrock/latest/userguide/batch-inference-data.html\">AWS documentation for more details</a>. Select a bucket where your S3 object is located.",
                    "source": {
                        "url": "/component/appmixer/ai/bedrock/ListBuckets?outPort=out",
                        "data": {
                            "messages": { "in/region": "inputs/in/region" },
                            "transform": "./ListBuckets#toSelectArray"
                        }
                    },
                    "index": 3
                },
                "s3InputObjectKey": {
                    "type": "text",
                    "label": "Input S3 Object Key",
                    "tooltip": "You can pass a JSONL file stored in your S3 as an input to your model. See <a target=_blank href=\"https://docs.aws.amazon.com/bedrock/latest/userguide/batch-inference-data.html\">AWS documentation for more details</a>. Enter an object key to use as input to your model.",
                    "index": 4
                },
                "s3OutputObjectBucket": {
                    "type": "text",
                    "label": "Output S3 Object Bucket",
                    "tooltip": "The bucket for the output results.",
                    "source": {
                        "url": "/component/appmixer/ai/bedrock/ListBuckets?outPort=out",
                        "data": {
                            "messages": { "in/region": "inputs/in/region" },
                            "transform": "./ListBuckets#toSelectArray"
                        }
                    },
                    "index": 5
                },
                "s3OutputObjectKey": {
                    "type": "text",
                    "label": "Output S3 Object Key",
                    "tooltip": "The path to the results. For example <code>results/</code>.",
                    "index": 6
                },
                "region": {
                    "type": "text",
                    "label": "Region",
                    "index": 7,
                    "tooltip": "Your AWS instance region. If not select, us-east-1 will be used as default.",
                    "source": {
                        "url": "/component/appmixer/ai/bedrock/ListRegions?outPort=out"
                    }
                },
                "model": {
                    "type": "text",
                    "index": 8,
                    "label": "Model",
                    "tooltip": "ID of the model to use.",
                    "source": {
                        "url": "/component/appmixer/ai/bedrock/ListModels?outPort=out",
                        "data": {
                            "transform": "./ListModels#toSelectOptions",
                            "messages": {
                                "in/region": "inputs/in/region"
                            }
                        }
                    }
                }
            }
        }
    }],
    "outPorts": [{
        "name": "out",
        "options": [{
            "label": "Job",
            "value": "job",
            "schema": {
                "type": "object",
                "example": {
                    "jobArn": "arn:aws:bedrock:us-east-1:123456789012:model-invocation-job/abcd1234efgh",
                    "jobName": "product-descriptions-batch",
                    "modelId": "anthropic.claude-3-haiku-20240307-v1:0",
                    "roleArn": "arn:aws:iam::123456789012:role/bedrock-model-invocation-role",
                    "status": "Completed",
                    "submitTime": "2024-06-10T08:15:00.000Z",
                    "lastModifiedTime": "2024-06-10T09:02:31.000Z",
                    "endTime": "2024-06-10T09:02:31.000Z",
                    "inputDataConfig": {
                        "s3InputDataConfig": {
                            "s3InputFormat": "JSONL",
                            "s3Uri": "s3://my-bedrock-input/batch/records.jsonl"
                        }
                    },
                    "outputDataConfig": {
                        "s3OutputDataConfig": {
                            "s3Uri": "s3://my-bedrock-output/results/"
                        }
                    },
                    "timeoutDurationInHours": 24,
                    "jobExpirationTime": "2024-06-11T08:15:00.000Z"
                },
                "properties": {
                    "jobArn": { "type": "string" },
                    "jobName": { "type": "string" },
                    "modelId": { "type": "string" },
                    "clientRequestToken": { "type": "string" },
                    "roleArn": { "type": "string" },
                    "status": {
                        "type": "string",
                        "enum": [
                            "Submitted",
                            "InProgress",
                            "Completed",
                            "Failed",
                            "Stopping",
                            "Stopped",
                            "PartiallyCompleted",
                            "Expired",
                            "Validating",
                            "Scheduled"
                        ]
                    },
                    "message": { "type": "string" },
                    "submitTime": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "lastModifiedTime": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "endTime": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "inputDataConfig": {
                        "type": "object",
                        "properties": {
                            "s3InputDataConfig": {
                                "type": "object",
                                "properties": {
                                    "s3InputFormat": {
                                        "type": "string",
                                        "enum": ["JSONL"]
                                    },
                                    "s3Uri": { "type": "string" },
                                    "s3BucketOwner": { "type": "string" }
                                }
                            }
                        }
                    },
                    "outputDataConfig": {
                        "type": "object",
                        "properties": {
                            "s3OutputDataConfig": {
                                "type": "object",
                                "properties": {
                                    "s3Uri": { "type": "string" },
                                    "s3EncryptionKeyId": { "type": "string" },
                                    "s3BucketOwner": { "type": "string" }
                                }
                            }
                        }
                    },
                    "vpcConfig": {
                        "type": "object",
                        "properties": {
                            "subnetIds": {
                                "type": "array",
                                "items": { "type": "string" }
                            },
                            "securityGroupIds": {
                                "type": "array",
                                "items": { "type": "string" }
                            }
                        }
                    },
                    "timeoutDurationInHours": { "type": "integer" },
                    "jobExpirationTime": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            }
        }, {
            "label": "Input",
            "value": "input",
            "schema": {
                "type": "object",
                "example": {
                    "jobName": "product-descriptions-batch",
                    "roleArn": "arn:aws:iam::123456789012:role/bedrock-model-invocation-role",
                    "s3InputObjectBucket": "my-bedrock-input",
                    "s3InputObjectKey": "batch/records.jsonl",
                    "s3OutputObjectBucket": "my-bedrock-output",
                    "s3OutputObjectKey": "results/",
                    "region": "us-east-1",
                    "model": "anthropic.claude-3-haiku-20240307-v1:0"
                },
                "properties": {
                    "jobName": { "type": "string" },
                    "roleArn": { "type": "string" },
                    "s3InputObjectBucket": { "type": "string" },
                    "s3InputObjectKey": { "type": "string" },
                    "s3OutputObjectBucket": { "type": "string" },
                    "s3OutputObjectKey": { "type": "string" },
                    "region": { "type": "string" },
                    "model": { "type": "string" }
                }
            }
        }]
    }, {
        "name": "job",
        "options": [{
            "label": "Job",
            "value": "job",
            "schema": {
                "type": "object",
                "example": {
                    "jobArn": "arn:aws:bedrock:us-east-1:123456789012:model-invocation-job/abcd1234efgh"
                },
                "properties": {
                    "jobArn": { "type": "string" }
                }
            }
        }, {
            "label": "Input",
            "value": "input",
            "schema": {
                "type": "object",
                "example": {
                    "jobName": "product-descriptions-batch",
                    "roleArn": "arn:aws:iam::123456789012:role/bedrock-model-invocation-role",
                    "s3InputObjectBucket": "my-bedrock-input",
                    "s3InputObjectKey": "batch/records.jsonl",
                    "s3OutputObjectBucket": "my-bedrock-output",
                    "s3OutputObjectKey": "results/",
                    "region": "us-east-1",
                    "model": "anthropic.claude-3-haiku-20240307-v1:0"
                },
                "properties": {
                    "jobName": { "type": "string" },
                    "roleArn": { "type": "string" },
                    "s3InputObjectBucket": { "type": "string" },
                    "s3InputObjectKey": { "type": "string" },
                    "s3OutputObjectBucket": { "type": "string" },
                    "s3OutputObjectKey": { "type": "string" },
                    "region": { "type": "string" },
                    "model": { "type": "string" }
                }
            }
        }]
    }],
    "icon": "data:image/svg+xml;base64,"
}
