{
    "name": "appmixer.ai.bedrock.SendPrompt",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Send a prompt to an LLM and receive a response. Note that different models expect different input parameters and produce a different result. Read the documentation of each model to understand what result format to expect and what input parameters to provide.",
    "auth": {
        "service": "appmixer:ai:bedrock"
    },
    "inPorts": [{
        "name": "in",
        "schema": {
            "type": "object",
            "properties": {
                "prompt": { "type": "string" },
                "customInput": { "type": "object" },
                "region": { "type": "string" },
                "model": { "type": "string" }
            },
            "required": ["model"]
        },
        "inspector": {
            "inputs": {
                "prompt": {
                    "label": "Prompt",
                    "type": "textarea",
                    "tooltip": "The text prompt to send to the model.",
                    "index": 1
                },
                "customInput": {
                    "label": "Custom Model Input",
                    "type": "expression",
                    "levels": ["ADD"],
                    "fields": {
                        "key": {
                            "type": "text",
                            "label": "Key",
                            "tooltip": "The key of the input parameter.",
                            "index": 1
                        },
                        "value": {
                            "type": "text",
                            "label": "Value",
                            "tooltip": "The value of the input parameter.",
                            "index": 2
                        },
                        "type": {
                            "type": "select",
                            "label": "Type",
                            "tooltip": "The type of the input parameter.",
                            "defaultValue": "string",
                            "options": [
                                { "value": "string", "label": "String" },
                                { "value": "number", "label": "Number" },
                                { "value": "boolean", "label": "Boolean" },
                                { "value": "object", "label": "Object" },
                                { "value": "array", "label": "Array" }
                            ],
                            "index": 3
                        }
                    },
                    "tooltip": "Different models require different input parameter formats. Please refer to the <a target=_blank href=\"https://docs.aws.amazon.com/bedrock/latest/userguide/model-parameters.html\">model documentation</a> for the correct input format. For example, the Anthropic Claude text models expect <code>prompt</code> (required), <code>temperature</code>, ....; while the Amazon Titan text models expect <code>inputText</code> as a required parameter. Use the Custom Model Input to define a custom input if your model does not support the standard input format. In this case, leave the Prompt field empty. You can also use Custom Model Input to add additional parameters alongside a standard prompt, such as <code>temperature</code> or <code>max_tokens</code>.",
                    "index": 2

                },
                "region": {
                    "type": "text",
                    "label": "Region",
                    "index": 3,
                    "tooltip": "Your AWS instance region. If not select, us-east-1 will be used as default.",
                    "source": {
                        "url": "/component/appmixer/ai/bedrock/ListRegions?outPort=out"
                    }
                },
                "model": {
                    "type": "text",
                    "index": 4,
                    "label": "Model",
                    "tooltip": "ID of the model to use.",
                    "source": {
                        "url": "/component/appmixer/ai/bedrock/ListModels?outPort=out",
                        "data": {
                            "transform": "./ListModels#toSelectOptions",
                            "messages": {
                                "in/region": "inputs/in/region"
                            }
                        }
                    }
                }
            }
        }
    }],
    "outPorts": [{
        "name": "out",
        "options": [{
            "label": "Answer",
            "value": "answer",
            "schema": { "type": "string", "example": "Amazon Bedrock is a fully managed service that makes foundation models from leading AI companies available through a single API." }
        }, {
            "label": "Input",
            "value": "input",
            "schema": {
                "type": "object",
                "example": {
                    "modelId": "anthropic.claude-3-haiku-20240307-v1:0",
                    "messages": [{ "role": "user", "content": [{ "text": "What is Amazon Bedrock?" }] }],
                    "inferenceConfig": { "maxTokens": 512, "temperature": 0.5 }
                }
            }
        }]
    }],
    "icon": "data:image/svg+xml;base64,"
}
