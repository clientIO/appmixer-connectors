{
    "name": "appmixer.ai.agent.AIAgent",
    "label": "AI Agent",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Use AI agent to build agentic workflows. Connect tools and MCP servers, use memory and file inputs to build powerful agents.",
    "auth": {
        "service": "appmixer:ai:agent"
    },
    "version": "1.0.0",
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "model": { "type": "string" },
                "instructions": { "type": "string", "maxLength": 256000 },
                "stream": { "type": "boolean" },
                "knowledgebase": {}
            }
        },
        "inspector": {
            "inputs": {
                "model": {
                    "type": "text",
                    "index": 1,
                    "label": "Model",
                    "tooltip": "ID of the model to use.",
                    "defaultValue": "gpt-4o",
                    "source": {
                        "url": "/component/appmixer/ai/agent/ListModels?outPort=out",
                        "data": {
                            "transform": "./ListModels#toSelectOptions"
                        }
                    }
                },
                "instructions": {
                    "type": "textarea",
                    "label": "Instructions",
                    "index": 2,
                    "tooltip": "The system instructions that the assistant uses. The maximum length is 256,000 characters. For example 'You are a personal math tutor.'."
                },
                "stream": {
                    "type": "toggle",
                    "label": "Stream Responses",
                    "defaultValue": false,
                    "index": 3,
                    "tooltip": "Stream partial responses as they arrive from the model. Note that this only has an effect on the built-in chat utility. Responses are still sent as a complete answer to the output of the agent. Also note that for streaming to work, the 'Thread ID' configuration of the Agent must be set to the 'Thread ID' output of the 'Chat Trigger' component."
                },
                "knowledgebase": {
                    "label": "Knowledgebase",
                    "type": "expression",
                    "index": 4,
                    "tooltip": "Upload files to use as a knowledgebase for the AI Agent. The files will be used for RAG. The following file types are supported: .docx, .html/.htm, .pdf, .csv, .xlsx/.xls/.ods, .epub, .pptx, plain text, .zip (containing any of the supported file types).",
                    "levels": ["ADD"],
                    "fields": {
                        "fileId": {
                            "type": "filepicker",
                            "label": "File",
                            "tooltip": "The file to attach.",
                            "index": 1
                        }
                    }
                }
            }
        }
    },
    "inPorts": [{
        "name": "in",
        "schema": {
            "type": "object",
            "properties": {
                "prompt": { "type": "string" },
                "threadId": { "type": "string" },
                "storeId": { "type": "string" },
                "fileId": { "type": "string" }
            },
            "required": ["prompt"]
        },
        "inspector": {
            "inputs": {
                "prompt": {
                    "label": "Prompt",
                    "type": "textarea",
                    "index": 1
                },
                "threadId": {
                    "label": "Thread ID",
                    "type": "text",
                    "index": 2,
                    "tooltip": "By setting a thread ID you can keep the context of the conversation. If you do not set a thread ID, the AI Agent will not use memory and will not keep the context of the conversation. This is useful e.g. if you want to use the AI Agent as a simple question and answer tool."
                },
                "fileId": {
                    "label": "File ID",
                    "type": "filepicker",
                    "index": 3,
                    "tooltip": "Optionally, you can select a file to be used as additional context for the AI Agent. File types PNG, JPEG, GIF, WEBP and PDF have a direct model support. Other file types will be parsed as text and sent as a regular prompt. This is useful for CSV, JSON, .js, .py or other textual content. You can either upload a file directly or map a file from a previous connected component."
                },
                "storeId": {
                    "label": "Memory Data Store",
                    "type": "select",
                    "index": 4,
                    "source": {
                        "url": "/component/appmixer/utils/storage/ListStores?outPort=out",
                        "data": {
                            "transform": "./ListStores#toSelectArray"
                        }
                    },
                    "tooltip": "Select a data store to be used for storing the conversation context. Use this to preserve the context (memory) across agent executions. Additionally, by saving the history to a data store, you can create other flows that export the history to your custom databases or external tools. Explore the Storage trigger utilities to learn more about how to use the data store in your flows."
                }
            }
        }
    }],
    "outPorts": [{
        "name": "out",
        "options": [{
            "label": "Answer",
            "value": "answer",
            "schema": { "type": "string" }
        }, {
            "label": "Prompt",
            "value": "prompt",
            "schema": { "type": "string" }
        }, {
            "label": "Time (ms)",
            "value": "time",
            "schema": { "type": "integer" }
        }, {
            "label": "Usage",
            "value": "usage",
            "schema": {
                "type": "object",
                "properties": {
                    "prompt_tokens": { "type": "integer" },
                    "completion_tokens": { "type": "integer" },
                    "total_tokens": { "type": "integer" },
                    "prompt_tokens_details": {
                        "type": "object",
                        "properties": {
                            "cached_tokens": { "type": "integer" },
                            "audio_tokens": { "type": "integer" }
                        }
                    },
                    "completion_tokens_details": {
                        "type": "object",
                        "properties": {
                            "reasoning_tokens": { "type": "integer" },
                            "audio_tokens": { "type": "integer" },
                            "accepted_prediction_tokens": { "type": "integer" },
                            "rejected_prediction_tokens": { "type": "integer" }
                        }
                    }
                }
            }
        }]
    }, {
        "name": "tool",
        "options": [{
            "label": "Model Defined Parameter",
            "value": "modelDefinedParameter",
            "schema": { "type": "string" }
        }]
    }],
    "icon": "data:image/svg+xml;base64,"
}
