{
    "name": "appmixer.ai.gladia.TranscriptionCompleted",
    "label": "Transcription Completed",
    "description": "Triggers when a Gladia transcription job reaches the 'done' status (polling). Gladia webhook callbacks are configured per-job, so polling is the reliable account-level trigger mechanism.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "trigger": true,
    "tick": true,
    "auth": {
        "service": "appmixer:ai:gladia"
    },
    "quota": {
        "manager": "appmixer:ai:gladia",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "properties": {},
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": { "type": "string", "title": "Job ID", "example": "45463597-20b7-4af7-b3b3-f5fb778f7f0a" },
                    "status": { "type": "string", "title": "Status", "example": "done" },
                    "kind": { "type": "string", "title": "Kind", "example": "pre-recorded" },
                    "created_at": { "type": "string", "format": "date-time", "title": "Created At", "example": "2026-08-01T14:00:00.000Z" },
                    "completed_at": { "type": "string", "format": "date-time", "title": "Completed At", "example": "2026-08-01T14:01:12.000Z" },
                    "custom_metadata": { "type": "object", "title": "Custom Metadata", "example": { "orderId": "1234" } },
                    "result_url": { "type": "string", "title": "Result URL", "example": "https://api.gladia.io/v2/transcription/45463597-20b7-4af7-b3b3-f5fb778f7f0a" },
                    "result": {
                        "type": "object",
                        "title": "Result",
                        "properties": {
                            "metadata": {
                                "type": "object",
                                "title": "Metadata",
                                "properties": {
                                    "audio_duration": { "type": "number", "title": "Audio Duration (seconds)", "example": 128.5 },
                                    "number_of_distinct_channels": { "type": "integer", "title": "Distinct Channels", "example": 1 },
                                    "billing_time": { "type": "number", "title": "Billing Time (seconds)", "example": 128.5 },
                                    "transcription_time": { "type": "number", "title": "Transcription Time (seconds)", "example": 12.3 }
                                }
                            },
                            "transcription": {
                                "type": "object",
                                "title": "Transcription",
                                "properties": {
                                    "full_transcript": { "type": "string", "title": "Full Transcript", "example": "Hello and welcome to the meeting." },
                                    "languages": {
                                        "type": "array",
                                        "title": "Languages",
                                        "items": { "type": "string" },
                                        "example": ["en"]
                                    },
                                    "utterances": {
                                        "type": "array",
                                        "title": "Utterances",
                                        "example": [{ "text": "Hello and welcome to the meeting.", "language": "en", "start": 0.0, "end": 2.5, "confidence": 0.98, "speaker": 0 }],
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "text": { "type": "string", "title": "Text" },
                                                "language": { "type": "string", "title": "Language" },
                                                "start": { "type": "number", "title": "Start" },
                                                "end": { "type": "number", "title": "End" },
                                                "confidence": { "type": "number", "title": "Confidence" },
                                                "speaker": { "type": "integer", "title": "Speaker" }
                                            }
                                        }
                                    },
                                    "subtitles": {
                                        "type": "array",
                                        "title": "Subtitles",
                                        "example": [{ "format": "srt", "subtitles": "1\n00:00:00,000 --> 00:00:02,500\nHello and welcome to the meeting.\n" }],
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "format": { "type": "string", "title": "Format" },
                                                "subtitles": { "type": "string", "title": "Subtitles" }
                                            }
                                        }
                                    }
                                }
                            },
                            "diarization": {
                                "type": "object",
                                "title": "Diarization",
                                "properties": {
                                    "success": { "type": "boolean", "title": "Success", "example": true },
                                    "is_empty": { "type": "boolean", "title": "Is Empty", "example": false },
                                    "exec_time": { "type": "number", "title": "Execution Time (seconds)", "example": 0.42 },
                                    "error": { "type": "string", "title": "Error", "example": null },
                                    "results": {
                                        "type": "array",
                                        "title": "Speaker Segments",
                                        "example": [{ "text": "Hello and welcome to the meeting.", "language": "en", "start": 0.0, "end": 2.5, "confidence": 0.98, "channel": 0, "speaker": 0 }],
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "text": { "type": "string", "title": "Text" },
                                                "language": { "type": "string", "title": "Language" },
                                                "start": { "type": "number", "title": "Start" },
                                                "end": { "type": "number", "title": "End" },
                                                "confidence": { "type": "number", "title": "Confidence" },
                                                "channel": { "type": "integer", "title": "Channel" },
                                                "speaker": { "type": "integer", "title": "Speaker" }
                                            }
                                        }
                                    }
                                }
                            },
                            "translation": {
                                "type": "object",
                                "title": "Translation",
                                "properties": {
                                    "success": { "type": "boolean", "title": "Success", "example": true },
                                    "is_empty": { "type": "boolean", "title": "Is Empty", "example": false },
                                    "exec_time": { "type": "number", "title": "Execution Time (seconds)", "example": 1.8 },
                                    "error": { "type": "string", "title": "Error", "example": null },
                                    "results": {
                                        "type": "array",
                                        "title": "Translations",
                                        "example": [{ "languages": ["fr"], "full_transcript": "Bonjour et bienvenue a la reunion." }],
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "languages": {
                                                    "type": "array",
                                                    "title": "Languages",
                                                    "items": { "type": "string" }
                                                },
                                                "full_transcript": { "type": "string", "title": "Full Transcript" },
                                                "error": { "type": "string", "title": "Error" },
                                                "utterances": {
                                                    "type": "array",
                                                    "title": "Utterances",
                                                    "items": {
                                                        "type": "object",
                                                        "properties": {
                                                            "text": { "type": "string", "title": "Text" },
                                                            "language": { "type": "string", "title": "Language" },
                                                            "start": { "type": "number", "title": "Start" },
                                                            "end": { "type": "number", "title": "End" },
                                                            "confidence": { "type": "number", "title": "Confidence" },
                                                            "speaker": { "type": "integer", "title": "Speaker" }
                                                        }
                                                    }
                                                },
                                                "subtitles": {
                                                    "type": "array",
                                                    "title": "Subtitles",
                                                    "items": {
                                                        "type": "object",
                                                        "properties": {
                                                            "format": { "type": "string", "title": "Format" },
                                                            "subtitles": { "type": "string", "title": "Subtitles" }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            },
                            "summarization": {
                                "type": "object",
                                "title": "Summarization",
                                "properties": {
                                    "success": { "type": "boolean", "title": "Success", "example": true },
                                    "is_empty": { "type": "boolean", "title": "Is Empty", "example": false },
                                    "exec_time": { "type": "number", "title": "Execution Time (seconds)", "example": 2.1 },
                                    "error": { "type": "string", "title": "Error", "example": null },
                                    "results": { "type": "string", "title": "Summary", "example": "The team agreed to ship the release on Friday." }
                                }
                            },
                            "sentiment_analysis": {
                                "type": "object",
                                "title": "Sentiment Analysis",
                                "properties": {
                                    "success": { "type": "boolean", "title": "Success", "example": true },
                                    "is_empty": { "type": "boolean", "title": "Is Empty", "example": false },
                                    "exec_time": { "type": "number", "title": "Execution Time (seconds)", "example": 0.9 },
                                    "error": { "type": "string", "title": "Error", "example": null },
                                    "results": {
                                        "type": "array",
                                        "title": "Sentiment Segments",
                                        "example": [{ "text": "Hello and welcome to the meeting.", "sentiment": "neutral", "emotion": "neutral", "start": 0.0, "end": 2.5, "speaker": 0, "channel": 0 }],
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "text": { "type": "string", "title": "Text" },
                                                "sentiment": { "type": "string", "title": "Sentiment" },
                                                "emotion": { "type": "string", "title": "Emotion" },
                                                "start": { "type": "number", "title": "Start" },
                                                "end": { "type": "number", "title": "End" },
                                                "speaker": { "type": "integer", "title": "Speaker" },
                                                "channel": { "type": "integer", "title": "Channel" }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
