{
    "name": "appmixer.ai.gladia.DeleteTranscription",
    "label": "Delete Transcription",
    "description": "Permanently delete a Gladia transcription job and its data by ID. This action is irreversible.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:ai:gladia"
    },
    "quota": {
        "manager": "appmixer:ai:gladia",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "transcriptionId": { "type": "string" }
                },
                "required": ["transcriptionId"]
            },
            "inspector": {
                "inputs": {
                    "transcriptionId": {
                        "type": "text",
                        "index": 0,
                        "label": "Transcription ID",
                        "tooltip": "The ID of the transcription job to permanently delete."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {}
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
