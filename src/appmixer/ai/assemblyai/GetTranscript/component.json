{
    "name": "appmixer.ai.assemblyai.GetTranscript",
    "label": "Get Transcript",
    "description": "Retrieve a transcript by its id, including the full text, words, utterances (with speaker labels) and any enabled Audio Intelligence results. If the transcript failed, the component reports the error.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:ai:assemblyai"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "transcriptId": { "type": "string" }
                },
                "required": ["transcriptId"]
            },
            "inspector": {
                "inputs": {
                    "transcriptId": {
                        "type": "text",
                        "index": 1,
                        "label": "Transcript ID",
                        "tooltip": "The id returned by Transcribe Audio."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": { "type": "string", "title": "Transcript ID", "example": "5551722-f677-48a6-9287-39c0aafd9ac1" },
                    "status": { "type": "string", "title": "Status", "example": "completed" },
                    "text": { "type": "string", "title": "Text", "example": "Runner's knee runner's knee is a condition characterized by pain behind or around the kneecap." },
                    "language_code": { "type": "string", "title": "Language Code", "example": "en_us" },
                    "audio_url": { "type": "string", "title": "Audio URL", "example": "https://cdn.assemblyai.com/upload/463ce27f-0922-4ea9-9ce4-3353771c46f2" },
                    "audio_duration": { "type": "integer", "title": "Audio Duration (s)", "example": 281 },
                    "confidence": { "type": "number", "title": "Confidence", "example": 0.938 },
                    "words": {
                        "type": "array",
                        "title": "Words",
                        "items": {
                            "type": "object",
                            "properties": {
                                "text": { "type": "string", "example": "Runner's" },
                                "start": { "type": "integer", "example": 250 },
                                "end": { "type": "integer", "example": 650 },
                                "confidence": { "type": "number", "example": 0.97 },
                                "speaker": { "type": "string", "example": "A" }
                            }
                        },
                        "example": [{ "text": "Runner's", "start": 250, "end": 650, "confidence": 0.97, "speaker": "A" }]
                    },
                    "utterances": {
                        "type": "array",
                        "title": "Utterances",
                        "items": {
                            "type": "object",
                            "properties": {
                                "text": { "type": "string", "example": "Runner's knee is a condition." },
                                "start": { "type": "integer", "example": 250 },
                                "end": { "type": "integer", "example": 3450 },
                                "confidence": { "type": "number", "example": 0.94 },
                                "speaker": { "type": "string", "example": "A" }
                            }
                        },
                        "example": [{ "text": "Runner's knee is a condition.", "start": 250, "end": 3450, "confidence": 0.94, "speaker": "A" }]
                    },
                    "error": { "type": "string", "title": "Error", "example": "Download error, unable to download https://example.com/missing.mp3" },
                    "sentiment_analysis_results": {
                        "type": "array",
                        "title": "Sentiment Analysis Results",
                        "items": {
                            "type": "object",
                            "properties": {
                                "text": { "type": "string", "example": "Runner's knee is a condition characterized by pain." },
                                "sentiment": { "type": "string", "example": "NEUTRAL" },
                                "confidence": { "type": "number", "example": 0.8317765 },
                                "start": { "type": "integer", "example": 5327 },
                                "end": { "type": "integer", "example": 5827 },
                                "speaker": { "type": "string", "example": "A" }
                            }
                        },
                        "example": [{ "text": "Runner's knee.", "sentiment": "NEUTRAL", "confidence": 0.83, "start": 5327, "end": 5827, "speaker": "A" }]
                    },
                    "entities": {
                        "type": "array",
                        "title": "Entities",
                        "items": {
                            "type": "object",
                            "properties": {
                                "entity_type": { "type": "string", "example": "medical_condition" },
                                "text": { "type": "string", "example": "Runner's knee" },
                                "start": { "type": "integer", "example": 5327 },
                                "end": { "type": "integer", "example": 5827 },
                                "speaker": { "type": "string", "example": "A" }
                            }
                        },
                        "example": [{ "entity_type": "medical_condition", "text": "Runner's knee", "start": 5327, "end": 5827, "speaker": "A" }]
                    },
                    "iab_categories_result": {
                        "type": "object",
                        "title": "IAB Categories Result",
                        "properties": {
                            "status": { "type": "string", "title": "Status", "example": "success" },
                            "results": {
                                "type": "array",
                                "title": "Results",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "text": { "type": "string", "example": "Runner's knee is a condition characterized by pain." },
                                        "labels": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "label": { "type": "string", "example": "MedicalHealth>DiseasesAndConditions>FootHealth" },
                                                    "relevance": { "type": "number", "example": 0.9832 }
                                                }
                                            },
                                            "example": [{ "label": "MedicalHealth>DiseasesAndConditions>FootHealth", "relevance": 0.9832 }]
                                        },
                                        "timestamp": {
                                            "type": "object",
                                            "properties": {
                                                "start": { "type": "integer", "example": 5327 },
                                                "end": { "type": "integer", "example": 47944 }
                                            }
                                        }
                                    }
                                },
                                "example": [{ "text": "Runner's knee is a condition.", "labels": [{ "label": "MedicalHealth>DiseasesAndConditions>FootHealth", "relevance": 0.9832 }], "timestamp": { "start": 5327, "end": 47944 } }]
                            },
                            "summary": {
                                "type": "object",
                                "title": "Summary",
                                "example": { "MedicalHealth>DiseasesAndConditions>FootHealth": 0.9832, "HealthyLiving>FitnessAndExercise>RunningAndJogging": 0.8727 }
                            }
                        }
                    },
                    "content_safety_labels": {
                        "type": "object",
                        "title": "Content Safety Labels",
                        "properties": {
                            "status": { "type": "string", "title": "Status", "example": "success" },
                            "results": {
                                "type": "array",
                                "title": "Results",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "text": { "type": "string", "example": "A sprained ankle happens when the foot twists." },
                                        "labels": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "label": { "type": "string", "example": "health_issues" },
                                                    "confidence": { "type": "number", "example": 0.9677 },
                                                    "severity": { "type": "number", "example": 0.6365 }
                                                }
                                            },
                                            "example": [{ "label": "health_issues", "confidence": 0.9677, "severity": 0.6365 }]
                                        },
                                        "timestamp": {
                                            "type": "object",
                                            "properties": {
                                                "start": { "type": "integer", "example": 5327 },
                                                "end": { "type": "integer", "example": 47944 }
                                            }
                                        }
                                    }
                                },
                                "example": [{ "text": "A sprained ankle happens when the foot twists.", "labels": [{ "label": "health_issues", "confidence": 0.9677, "severity": 0.6365 }], "timestamp": { "start": 5327, "end": 47944 } }]
                            },
                            "summary": {
                                "type": "object",
                                "title": "Summary",
                                "example": { "health_issues": 0.9999 }
                            },
                            "severity_score_summary": {
                                "type": "object",
                                "title": "Severity Score Summary",
                                "example": { "health_issues": { "low": 0.72, "medium": 0.28, "high": 0 } }
                            }
                        }
                    },
                    "auto_highlights_result": {
                        "type": "object",
                        "title": "Auto Highlights Result",
                        "properties": {
                            "status": { "type": "string", "title": "Status", "example": "success" },
                            "results": {
                                "type": "array",
                                "title": "Results",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "text": { "type": "string", "example": "runners knee" },
                                        "count": { "type": "integer", "example": 3 },
                                        "rank": { "type": "number", "example": 0.08 },
                                        "timestamps": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "start": { "type": "integer", "example": 5327 },
                                                    "end": { "type": "integer", "example": 5827 }
                                                }
                                            },
                                            "example": [{ "start": 5327, "end": 5827 }]
                                        }
                                    }
                                },
                                "example": [{ "text": "runners knee", "count": 3, "rank": 0.08, "timestamps": [{ "start": 5327, "end": 5827 }] }]
                            }
                        }
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
