{
    "name": "appmixer.ai.mistral.Moderate",
    "label": "Moderate",
    "description": "Classifies text into content moderation categories (sexual, hate, violence, self-harm, PII and more).",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:ai:mistral"
    },
    "quota": {
        "manager": "appmixer:ai:mistral",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "text": {
                        "type": "string"
                    },
                    "model": {
                        "type": "string"
                    }
                },
                "required": [
                    "text"
                ]
            },
            "inspector": {
                "inputs": {
                    "text": {
                        "type": "textarea",
                        "index": 1,
                        "label": "Text",
                        "tooltip": "The text to classify into content moderation categories."
                    },
                    "model": {
                        "group": "advanced",
                        "type": "text",
                        "index": 2,
                        "label": "Model",
                        "tooltip": "ID of the moderation model to use.",
                        "defaultValue": "mistral-moderation-latest",
                        "source": {
                            "url": "/component/appmixer/ai/mistral/ListModels?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListModels#toModerationModelSelectArray"
                            }
                        }
                    }
                },
                "groups": {
                    "advanced": {
                        "label": "Advanced",
                        "closed": true,
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Flagged",
                    "value": "flagged",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Sexual",
                    "value": "categories.sexual",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Hate and Discrimination",
                    "value": "categories.hate_and_discrimination",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Violence and Threats",
                    "value": "categories.violence_and_threats",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Dangerous",
                    "value": "categories.dangerous",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Criminal",
                    "value": "categories.criminal",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Self-harm",
                    "value": "categories.selfharm",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Health",
                    "value": "categories.health",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Financial",
                    "value": "categories.financial",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Law",
                    "value": "categories.law",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "PII",
                    "value": "categories.pii",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Jailbreaking",
                    "value": "categories.jailbreaking",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Category Scores",
                    "value": "categoryScores",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "sexual": {
                                "type": "number",
                                "title": "Sexual Score",
                                "example": 0.0001
                            },
                            "hate_and_discrimination": {
                                "type": "number",
                                "title": "Hate and Discrimination Score",
                                "example": 0.0001
                            },
                            "violence_and_threats": {
                                "type": "number",
                                "title": "Violence and Threats Score",
                                "example": 0.0001
                            },
                            "selfharm": {
                                "type": "number",
                                "title": "Self-harm Score",
                                "example": 0.0001
                            },
                            "health": {
                                "type": "number",
                                "title": "Health Score",
                                "example": 0.0001
                            },
                            "financial": {
                                "type": "number",
                                "title": "Financial Score",
                                "example": 0.0001
                            },
                            "law": {
                                "type": "number",
                                "title": "Law Score",
                                "example": 0.0001
                            },
                            "pii": {
                                "type": "number",
                                "title": "PII Score",
                                "example": 0.0001
                            },
                            "dangerous": {
                                "type": "number",
                                "title": "Dangerous Score",
                                "example": 0.0001
                            },
                            "criminal": {
                                "type": "number",
                                "title": "Criminal Score",
                                "example": 0.0001
                            },
                            "jailbreaking": {
                                "type": "number",
                                "title": "Jailbreaking Score",
                                "example": 0.0001
                            }
                        },
                        "example": {
                            "sexual": 0.0001,
                            "violence_and_threats": 0.0001,
                            "pii": 0.0001
                        }
                    }
                },
                {
                    "label": "ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "mod-e5cc70bb28c444948073e77776eb30ef"
                    }
                },
                {
                    "label": "Model",
                    "value": "model",
                    "schema": {
                        "type": "string",
                        "example": "mistral-moderation-latest"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
