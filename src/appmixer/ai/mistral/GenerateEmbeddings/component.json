{
    "name": "appmixer.ai.mistral.GenerateEmbeddings",
    "label": "Generate Embeddings",
    "description": "Converts text into a vector embedding using a Mistral embedding model.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:ai:mistral"
    },
    "quota": {
        "manager": "appmixer:ai:mistral",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "text": {
                        "type": "string"
                    },
                    "model": {
                        "type": "string"
                    }
                },
                "required": [
                    "text"
                ]
            },
            "inspector": {
                "inputs": {
                    "text": {
                        "type": "textarea",
                        "index": 1,
                        "label": "Text",
                        "tooltip": "The text to convert into a vector embedding."
                    },
                    "model": {
                        "type": "text",
                        "index": 2,
                        "label": "Model",
                        "tooltip": "ID of the embedding model to use.",
                        "defaultValue": "mistral-embed",
                        "source": {
                            "url": "/component/appmixer/ai/mistral/ListModels?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListModels#toEmbeddingModelSelectArray"
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Embedding",
                    "value": "embedding",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "number",
                            "example": -0.0165863037109375
                        },
                        "example": [
                            -0.0165863037109375,
                            0.0219268798828125,
                            -0.007465362548828125
                        ]
                    }
                },
                {
                    "label": "Model",
                    "value": "model",
                    "schema": {
                        "type": "string",
                        "example": "mistral-embed"
                    }
                },
                {
                    "label": "Prompt Tokens",
                    "value": "promptTokens",
                    "schema": {
                        "type": "number",
                        "example": 9
                    }
                },
                {
                    "label": "Total Tokens",
                    "value": "totalTokens",
                    "schema": {
                        "type": "number",
                        "example": 9
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
