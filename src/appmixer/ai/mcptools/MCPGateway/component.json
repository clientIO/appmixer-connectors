{
    "name": "appmixer.ai.mcptools.MCPGateway",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Expose action components and MCP servers as tools of the MCP Server that you can install into your LLM clients such as Claude. Connect the components you want to expose to the 'tool' output port and mark the fields the model should fill with the 'Model Defined Parameter' variable.",
    "webhook": true,
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "webhook": {
                        "type": "string",
                        "title": "Webhook URL",
                        "example": "https://api.appmixer.com/flows/a1b2c3d4-e5f6-7890-abcd-ef1234567890/components/f0e9d8c7-b6a5-4321-9876-543210fedcba"
                    },
                    "componentId": {
                        "type": "string",
                        "title": "Component ID",
                        "example": "f0e9d8c7-b6a5-4321-9876-543210fedcba"
                    },
                    "flowId": {
                        "type": "string",
                        "title": "Flow ID",
                        "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
                    },
                    "tools": {
                        "type": "array",
                        "title": "Tools",
                        "example": [
                            {
                                "type": "function",
                                "function": {
                                    "name": "2oRMgurHVxbLEUavJPTjmE_SendEmail",
                                    "description": "Send an email message."
                                }
                            }
                        ],
                        "items": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "title": "Tools.Type",
                                    "example": "function"
                                },
                                "function": {
                                    "type": "object",
                                    "title": "Tools.Function",
                                    "properties": {
                                        "name": {
                                            "type": "string",
                                            "title": "Function.Name",
                                            "example": "2oRMgurHVxbLEUavJPTjmE_SendEmail"
                                        },
                                        "description": {
                                            "type": "string",
                                            "title": "Function.Description",
                                            "example": "Send an email message."
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        {
            "name": "tool",
            "options": [
                {
                    "label": "Model Defined Parameter",
                    "value": "modelDefinedParameter",
                    "schema": {
                        "type": "string",
                        "example": "Paris"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
