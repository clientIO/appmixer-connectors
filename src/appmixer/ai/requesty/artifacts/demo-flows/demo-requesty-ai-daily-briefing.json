{
    "name": "Demo Requesty - AI Daily Briefing",
    "type": "automation",
    "flow": {
        "aa000000-0000-0000-0000-000000000001": {
            "type": "appmixer.utils.controls.OnStart",
            "x": 208,
            "y": 320,
            "source": {},
            "errorHandling": {
                "autoRetry": false,
                "onError": "stopFlow"
            }
        },
        "aa000000-0000-0000-0000-000000000002": {
            "type": "appmixer.ai.requesty.SendPrompt",
            "x": 400,
            "y": 320,
            "source": {
                "in": {
                    "aa000000-0000-0000-0000-000000000001": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "aa000000-0000-0000-0000-000000000001": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {},
                                "lambda": {
                                    "model": "openai/gpt-4o-mini",
                                    "instructions": "You are a friendly productivity coach. Keep the output short, actionable and formatted as simple HTML (one <p> intro sentence and a <ul> with exactly 3 <li> tips). Do not wrap the output in markdown code fences.",
                                    "prompt": "Write a short daily briefing with 3 practical productivity tips for a busy software team."
                                }
                            }
                        }
                    }
                }
            },
            "errorHandling": {
                "autoRetry": false,
                "onError": "stopFlow"
            }
        },
        "aa000000-0000-0000-0000-000000000003": {
            "type": "appmixer.utils.email.SendEmail",
            "x": 592,
            "y": 320,
            "source": {
                "in": {
                    "aa000000-0000-0000-0000-000000000002": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "aa000000-0000-0000-0000-000000000002": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "html": {
                                        "content": {
                                            "variable": "$.aa000000-0000-0000-0000-000000000002.out.answer",
                                            "functions": []
                                        },
                                        "model": {
                                            "variable": "$.aa000000-0000-0000-0000-000000000002.out.model",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "to": "test@appmixer.com",
                                    "subject": "Your AI Daily Briefing (powered by Requesty)",
                                    "html": "<div style=\"font-family:Arial,sans-serif;max-width:600px;color:#222\"><h2 style=\"color:#5A4FF3\">AI Daily Briefing</h2>{{{content}}}<p style=\"color:#888;font-size:12px\">Generated by model {{{model}}} via the Requesty AI gateway.</p></div>"
                                }
                            }
                        }
                    }
                }
            },
            "errorHandling": {
                "autoRetry": false,
                "onError": "stopFlow"
            }
        }
    },
    "notes": {},
    "wizard": {
        "fields": []
    }
}
