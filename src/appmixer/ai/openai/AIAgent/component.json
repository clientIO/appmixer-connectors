{
    "name": "appmixer.ai.openai.AIAgent",
    "label": "AI Agent",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Build an AI agent responding with contextual answers or performing contextual actions.",
    "auth": {
        "service": "appmixer:ai:openai"
    },
    "version": "1.0.1",
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "stream": { "type": "boolean" }
            }
        },
        "inspector": {
            "inputs": {
                "stream": {
                    "type": "toggle",
                    "label": "Stream Responses",
                    "defaultValue": false,
                    "index": 1,
                    "tooltip": "Stream partial responses as they arrive from the model. Note that this only has an effect on the built-in chat utility. Responses are still sent as a complete answer to the output of the agent. Also note that for streaming to work, the 'Thread ID' configuration of the Agent must be set to the 'Thread ID' output of the 'Chat Trigger' component."
                }
            }
        }
    },
    "inPorts": [{
        "name": "in",
        "schema": {
            "type": "object",
            "properties": {
                "model": { "type": "string" },
                "instructions": { "type": "string", "maxLength": 256000 },
                "prompt": { "type": "string" },
                "threadId": { "type": "string" },
                "storeId": { "type": "string" },
                "fileId": { "type": "string" }
            },
            "required": ["prompt"]
        },
        "inspector": {
            "inputs": {
                "model": {
                    "type": "text",
                    "index": 1,
                    "label": "Model",
                    "tooltip": "ID of the model to use. Defaults to gpt-4o when left empty.",
                    "source": {
                        "url": "/component/appmixer/ai/openai/ListModels?outPort=out",
                        "data": {
                            "transform": "./ListModels#toSelectOptions"
                        }
                    }
                },
                "instructions": {
                    "type": "textarea",
                    "label": "Instructions",
                    "index": 2,
                    "tooltip": "The system instructions that the assistant uses. The maximum length is 256,000 characters. For example 'You are a personal math tutor.'."
                },
                "prompt": {
                    "label": "Prompt",
                    "type": "textarea",
                    "index": 3
                },
                "threadId": {
                    "label": "Thread ID",
                    "type": "text",
                    "index": 4,
                    "tooltip": "By setting a thread ID you can keep the context of the conversation. If you do not set a thread ID, the AI Agent will not use memory and will not keep the context of the conversation. This is useful e.g. if you want to use the AI Agent as a simple question and answer tool."
                },
                "fileId": {
                    "label": "File ID",
                    "type": "filepicker",
                    "index": 5,
                    "tooltip": "Optionally, you can select a file to be used as additional context for the AI Agent. File types PNG, JPEG, GIF, WEBP and PDF have a direct model support. Other file types will be parsed as text and sent as a regular prompt. This is useful for CSV, JSON, .js, .py or other textual content. You can either upload a file directly or map a file from a previous connected component."
                },
                "storeId": {
                    "label": "Memory Data Store",
                    "type": "text",
                    "index": 6,
                    "source": {
                        "url": "/component/appmixer/utils/storage/ListStores?outPort=out",
                        "data": {
                            "transform": "./ListStores#toSelectArray"
                        }
                    },
                    "tooltip": "Select a data store to be used for storing the conversation context. This is useful if you want to preserve the context across different executions. Additionally, by saving the history to a data store, you can create other flows that export the history to your custom databases or external tools. Explore the Storage utilities to learn more about how to use the data store in your flows."
                }
            }
        }
    }],
    "outPorts": [{
        "name": "out",
        "options": [{
            "label": "Answer",
            "value": "answer",
            "schema": { "type": "string", "example": "The capital of France is Paris." }
        }, {
            "label": "Prompt",
            "value": "prompt",
            "schema": { "type": "string", "example": "What is the capital of France?" }
        }, {
            "label": "Time (ms)",
            "value": "time",
            "schema": { "type": "integer", "example": 1834 }
        }, {
            "label": "Usage",
            "value": "usage",
            "schema": {
                "type": "object",
                "properties": {
                    "prompt_tokens": { "type": "integer", "title": "Prompt Tokens", "example": 42 },
                    "completion_tokens": { "type": "integer", "title": "Completion Tokens", "example": 18 },
                    "total_tokens": { "type": "integer", "title": "Total Tokens", "example": 60 },
                    "prompt_tokens_details": {
                        "type": "object",
                        "title": "Prompt Tokens Details",
                        "properties": {
                            "cached_tokens": { "type": "integer", "title": "Cached Tokens", "example": 0 },
                            "audio_tokens": { "type": "integer", "title": "Audio Tokens", "example": 0 }
                        }
                    },
                    "completion_tokens_details": {
                        "type": "object",
                        "title": "Completion Tokens Details",
                        "properties": {
                            "reasoning_tokens": { "type": "integer", "title": "Reasoning Tokens", "example": 0 },
                            "audio_tokens": { "type": "integer", "title": "Audio Tokens", "example": 0 },
                            "accepted_prediction_tokens": { "type": "integer", "title": "Accepted Prediction Tokens", "example": 0 },
                            "rejected_prediction_tokens": { "type": "integer", "title": "Rejected Prediction Tokens", "example": 0 }
                        }
                    }
                },
                "example": { "prompt_tokens": 42, "completion_tokens": 18, "total_tokens": 60 }
            }
        }]
    }, {
        "name": "tools",
        "options": [{
            "label": "Prompt",
            "value": "prompt",
            "schema": { "type": "string", "example": "What is the capital of France?" }
        }]
    }, {
        "name": "mcp"
    }],
    "icon": "data:image/svg+xml;base64,"
}
