{
    "name": "appmixer.ai.exa.NewSearchResult",
    "label": "New Search Result",
    "description": "Triggers when Exa finds a page matching your query that it has not returned before. The first run only records a baseline so existing pages do not fire the trigger.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "trigger": true,
    "tick": true,
    "auth": {
        "service": "appmixer:ai:exa"
    },
    "quota": {
        "manager": "appmixer:ai:exa",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "query": {
                    "type": "string"
                },
                "searchType": {
                    "type": "string"
                },
                "numResults": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                },
                "category": {
                    "type": "string"
                },
                "includeDomains": {
                    "type": "string"
                },
                "excludeDomains": {
                    "type": "string"
                },
                "includeText": {
                    "type": "boolean"
                }
            },
            "required": [
                "query"
            ]
        },
        "inspector": {
            "inputs": {
                "query": {
                    "type": "text",
                    "index": 1,
                    "label": "Query",
                    "tooltip": "The web search to watch. Exa is semantic, so a descriptive phrase works better than keywords."
                },
                "searchType": {
                    "type": "select",
                    "index": 2,
                    "label": "Search Type",
                    "defaultValue": "fast",
                    "tooltip": "<b>Fast</b> is the cheapest and is usually the right choice for a trigger that polls repeatedly. <b>Auto</b> lets Exa pick the best method. Deliberately limited to Exa's low-latency modes: the <code>deep</code> modes run multi-step research and would be charged on every poll. Use Find Search Results when you need one.",
                    "options": [
                        {
                            "label": "Fast",
                            "value": "fast"
                        },
                        {
                            "label": "Auto",
                            "value": "auto"
                        },
                        {
                            "label": "Instant",
                            "value": "instant"
                        }
                    ]
                },
                "numResults": {
                    "type": "number",
                    "index": 3,
                    "label": "Number Of Results",
                    "defaultValue": 10,
                    "tooltip": "How many results to fetch on every poll, between 1 and 100. New pages are detected within this window."
                },
                "category": {
                    "type": "select",
                    "index": 4,
                    "label": "Category",
                    "tooltip": "Only watch one kind of page. Leave empty to watch everything.",
                    "options": [
                        {
                            "label": "Company",
                            "value": "company"
                        },
                        {
                            "label": "People",
                            "value": "people"
                        },
                        {
                            "label": "Research paper",
                            "value": "research paper"
                        },
                        {
                            "label": "News",
                            "value": "news"
                        },
                        {
                            "label": "PDF",
                            "value": "pdf"
                        },
                        {
                            "label": "GitHub",
                            "value": "github"
                        },
                        {
                            "label": "Personal site",
                            "value": "personal site"
                        },
                        {
                            "label": "Financial report",
                            "value": "financial report"
                        }
                    ]
                },
                "includeDomains": {
                    "type": "text",
                    "index": 5,
                    "label": "Include Domains",
                    "tooltip": "Comma separated list of domains to restrict the search to."
                },
                "excludeDomains": {
                    "type": "text",
                    "index": 6,
                    "label": "Exclude Domains",
                    "tooltip": "Comma separated list of domains to leave out of the results."
                },
                "includeText": {
                    "type": "toggle",
                    "index": 7,
                    "label": "Include Page Text",
                    "tooltip": "Also return the cleaned full text of each new page. Costs extra Exa credits per page."
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "title",
                    "url"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Result ID",
                        "example": "https://exa.ai/blog/launch"
                    },
                    "title": {
                        "type": "string",
                        "title": "Title",
                        "example": "Introducing Exa Search"
                    },
                    "url": {
                        "type": "string",
                        "title": "URL",
                        "example": "https://exa.ai/blog/launch"
                    },
                    "publishedDate": {
                        "type": "string",
                        "title": "Published Date",
                        "example": "2024-11-08T00:00:00.000Z"
                    },
                    "author": {
                        "type": "string",
                        "title": "Author",
                        "example": "Jane Doe"
                    },
                    "image": {
                        "type": "string",
                        "title": "Image URL",
                        "example": "https://exa.ai/og-image.png"
                    },
                    "favicon": {
                        "type": "string",
                        "title": "Favicon URL",
                        "example": "https://exa.ai/favicon.ico"
                    },
                    "text": {
                        "type": "string",
                        "title": "Page Text",
                        "example": "Exa is a search engine built for AI."
                    },
                    "entities": {
                        "type": "array",
                        "title": "Entities",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "string",
                                    "title": "Entity ID",
                                    "example": "https://exa.ai/library/organization/sh0mvs0mk8r"
                                },
                                "type": {
                                    "type": "string",
                                    "title": "Entity Type",
                                    "example": "company"
                                }
                            }
                        },
                        "example": [
                            {
                                "id": "https://exa.ai/library/organization/sh0mvs0mk8r",
                                "type": "company"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
