{
    "name": "appmixer.ai.exa.FindSimilarLinks",
    "label": "Find Similar Links",
    "description": "Find web pages that are semantically similar to a given URL, optionally with their cleaned page content.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:ai:exa"
    },
    "quota": {
        "manager": "appmixer:ai:exa",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "url": {
                        "type": "string"
                    },
                    "numResults": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                    },
                    "excludeSourceDomain": {
                        "type": "boolean"
                    },
                    "category": {
                        "type": "string"
                    },
                    "includeDomains": {
                        "type": "string"
                    },
                    "excludeDomains": {
                        "type": "string"
                    },
                    "startPublishedDate": {
                        "type": "string",
                        "format": "date"
                    },
                    "endPublishedDate": {
                        "type": "string",
                        "format": "date"
                    },
                    "includeText": {
                        "type": "boolean"
                    },
                    "includeHighlights": {
                        "type": "boolean"
                    },
                    "summaryQuery": {
                        "type": "string"
                    },
                    "outputType": {
                        "type": "string"
                    }
                },
                "required": [
                    "url"
                ]
            },
            "inspector": {
                "inputs": {
                    "url": {
                        "type": "text",
                        "index": 1,
                        "label": "URL",
                        "tooltip": "The page to find similar pages for, e.g. <code>https://en.wikipedia.org/wiki/Web_search_engine</code>."
                    },
                    "numResults": {
                        "type": "number",
                        "index": 2,
                        "label": "Number Of Results",
                        "defaultValue": 10,
                        "tooltip": "How many similar pages to return, between 1 and 100."
                    },
                    "excludeSourceDomain": {
                        "type": "toggle",
                        "index": 3,
                        "label": "Exclude Source Domain",
                        "tooltip": "Leave out results from the same domain as the URL above \u2014 useful for finding competitors rather than sibling pages."
                    },
                    "category": {
                        "type": "select",
                        "index": 4,
                        "label": "Category",
                        "tooltip": "Restrict the results to one kind of page. Leave empty to search everything.",
                        "options": [
                            {
                                "label": "Company",
                                "value": "company"
                            },
                            {
                                "label": "People",
                                "value": "people"
                            },
                            {
                                "label": "Research paper",
                                "value": "research paper"
                            },
                            {
                                "label": "News",
                                "value": "news"
                            },
                            {
                                "label": "PDF",
                                "value": "pdf"
                            },
                            {
                                "label": "GitHub",
                                "value": "github"
                            },
                            {
                                "label": "Personal site",
                                "value": "personal site"
                            },
                            {
                                "label": "Financial report",
                                "value": "financial report"
                            }
                        ]
                    },
                    "includeDomains": {
                        "type": "text",
                        "index": 5,
                        "label": "Include Domains",
                        "tooltip": "Comma separated list of domains to restrict the results to."
                    },
                    "excludeDomains": {
                        "type": "text",
                        "index": 6,
                        "label": "Exclude Domains",
                        "tooltip": "Comma separated list of domains to leave out of the results."
                    },
                    "startPublishedDate": {
                        "type": "date-time",
                        "index": 7,
                        "label": "Published After",
                        "config": {
                            "enableTime": false
                        },
                        "tooltip": "Only return pages published on or after this date."
                    },
                    "endPublishedDate": {
                        "type": "date-time",
                        "index": 8,
                        "label": "Published Before",
                        "config": {
                            "enableTime": false
                        },
                        "tooltip": "Only return pages published on or before this date."
                    },
                    "includeText": {
                        "type": "toggle",
                        "index": 9,
                        "label": "Include Page Text",
                        "tooltip": "Also return the cleaned full text of each result. Costs extra Exa credits per page."
                    },
                    "includeHighlights": {
                        "type": "toggle",
                        "index": 10,
                        "label": "Include Highlights",
                        "tooltip": "Also return the most relevant snippets of each page."
                    },
                    "summaryQuery": {
                        "type": "text",
                        "index": 11,
                        "label": "Summary Query",
                        "tooltip": "Ask Exa to summarise each result with this question in mind. Leave empty for no summary."
                    },
                    "outputType": {
                        "type": "select",
                        "index": 12,
                        "label": "Output Type",
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/ai/exa/FindSimilarLinks?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType",
                        "in/url": "dummy"
                    }
                }
            }
        },
        {
            "name": "notFound",
            "schema": {
                "type": "object",
                "properties": {
                    "url": {
                        "type": "string",
                        "title": "URL",
                        "example": "https://en.wikipedia.org/wiki/Web_search_engine"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
