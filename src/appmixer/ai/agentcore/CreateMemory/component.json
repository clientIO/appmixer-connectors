{
    "name": "appmixer.ai.agentcore.CreateMemory",
    "description": "Create a new Amazon Bedrock AgentCore Memory resource.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:ai:agentcore"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": { "type": "string" },
                    "eventExpiryDuration": { "type": "integer" },
                    "description": { "type": "string" },
                    "memoryExecutionRoleArn": { "type": "string" },
                    "encryptionKeyArn": { "type": "string" },
                    "strategyType": {
                        "type": "string",
                        "enum": ["semantic", "summary", "userPreference"]
                    },
                    "strategyName": { "type": "string" },
                    "strategyNamespaces": { "type": "string" },
                    "waitForActive": { "type": "boolean" }
                },
                "required": ["name", "eventExpiryDuration"]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "label": "Name",
                        "index": 1,
                        "tooltip": "The name of the memory. Must be unique within your account, start with a letter and contain only letters, numbers and underscores (max 48 chars)."
                    },
                    "eventExpiryDuration": {
                        "type": "number",
                        "label": "Event Expiry Duration (days)",
                        "index": 2,
                        "defaultValue": 90,
                        "tooltip": "The number of days after which memory events expire. Between 3 and 365."
                    },
                    "description": {
                        "type": "textarea",
                        "label": "Description",
                        "index": 3,
                        "tooltip": "Optional description of the memory."
                    },
                    "memoryExecutionRoleArn": {
                        "type": "text",
                        "label": "Memory Execution Role ARN",
                        "index": 4,
                        "tooltip": "Optional IAM role ARN that grants the memory permission to access AWS services."
                    },
                    "encryptionKeyArn": {
                        "type": "text",
                        "label": "Encryption Key ARN",
                        "index": 5,
                        "tooltip": "Optional AWS KMS key ARN used to encrypt the memory data."
                    },
                    "strategyType": {
                        "type": "select",
                        "label": "Extraction Strategy",
                        "index": 6,
                        "tooltip": "Optional built-in memory strategy that extracts long-term memory records from events. Without a strategy the memory only stores raw events and never produces memory records. Advanced or multiple strategies can be configured via the Make API Call component.",
                        "options": [
                            { "label": "Semantic (facts)", "value": "semantic" },
                            { "label": "Summary", "value": "summary" },
                            { "label": "User Preference", "value": "userPreference" }
                        ]
                    },
                    "strategyName": {
                        "type": "text",
                        "label": "Strategy Name",
                        "index": 7,
                        "tooltip": "Required when an Extraction Strategy is selected. A name for the strategy (letters, numbers and underscores)."
                    },
                    "strategyNamespaces": {
                        "type": "text",
                        "label": "Strategy Namespaces",
                        "index": 8,
                        "tooltip": "Optional comma-separated list of namespaces the strategy writes records into, e.g. /facts/{actorId}. Supports the {actorId} and {sessionId} placeholders. Leave empty to use the AWS default namespace."
                    },
                    "waitForActive": {
                        "type": "toggle",
                        "label": "Wait Until Active",
                        "index": 9,
                        "tooltip": "When enabled, the component waits (up to ~3 minutes) until the memory finishes provisioning and reaches the ACTIVE state before continuing. A memory stays in the CREATING state for about a minute after creation and rejects Create Event calls until it is active, so enable this when the same flow adds events right after creating the memory."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": { "type": "string", "title": "Memory ID", "example": "myMemory-abc1234567" },
                    "arn": { "type": "string", "title": "Memory ARN", "example": "arn:aws:bedrock-agentcore:us-east-1:123456789012:memory/myMemory-abc1234567" },
                    "name": { "type": "string", "title": "Name", "example": "myMemory" },
                    "description": { "type": "string", "title": "Description", "example": "My agent memory" },
                    "status": { "type": "string", "title": "Status", "example": "CREATING" },
                    "eventExpiryDuration": { "type": "integer", "title": "Event Expiry Duration (days)", "example": 90 },
                    "createdAt": { "type": "string", "format": "date-time", "title": "Created At", "example": "2025-01-15T10:30:00Z" }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
