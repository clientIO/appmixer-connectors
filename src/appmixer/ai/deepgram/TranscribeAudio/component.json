{
    "name": "appmixer.ai.deepgram.TranscribeAudio",
    "label": "Transcribe Audio",
    "description": "Transcribes pre-recorded audio. Submits the job to Deepgram and returns the request ID immediately on the \"out\" port without holding a worker, then emits the finished transcript on the \"done\" port when Deepgram delivers it. Accepts an audio URL or a file (max 2 GB), with optional diarization, summarization, sentiment, topics and intents.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "webhook": true,
    "auth": {
        "service": "appmixer:ai:deepgram"
    },
    "quota": {
        "manager": "appmixer:ai:deepgram",
        "resources": "inference",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "audioUrl": { "type": "string" },
                    "fileId": { "type": "string" },
                    "model": { "type": "string" },
                    "language": { "type": "string" },
                    "detectLanguage": { "type": "boolean" },
                    "smartFormat": { "type": "boolean" },
                    "punctuate": { "type": "boolean" },
                    "diarize": { "type": "boolean" },
                    "summarize": { "type": "boolean" },
                    "sentiment": { "type": "boolean" },
                    "topics": { "type": "boolean" },
                    "intents": { "type": "boolean" },
                    "extraParams": { "type": "array" },
                    "correlationId": { "type": "string" }
                }
            },
            "inspector": {
                "inputs": {
                    "audioUrl": {
                        "type": "text",
                        "index": 1,
                        "label": "Audio URL",
                        "tooltip": "Publicly accessible URL of the audio file to transcribe. Provide either this or a File below."
                    },
                    "fileId": {
                        "type": "filepicker",
                        "index": 2,
                        "label": "File",
                        "tooltip": "Audio file to transcribe (max 2 GB). Provide either this or an Audio URL above."
                    },
                    "model": {
                        "type": "text",
                        "index": 3,
                        "label": "Model",
                        "defaultValue": "nova-3",
                        "tooltip": "Speech-to-text model, e.g. <code>nova-3</code> (default). Start typing to pick from the available STT models, or enter a model name manually.",
                        "source": {
                            "url": "/component/appmixer/ai/deepgram/ListModels?outPort=out",
                            "data": {
                                "transform": "./ListModels#toSelectArray",
                                "messages": {
                                    "in/outputType": "array",
                                    "in/isSource": true
                                }
                            }
                        }
                    },
                    "language": {
                        "type": "text",
                        "index": 4,
                        "label": "Language",
                        "tooltip": "BCP-47 language code, e.g. <code>en</code>. Leave empty to use the model default."
                    },
                    "detectLanguage": {
                        "type": "toggle",
                        "index": 5,
                        "label": "Detect Language",
                        "tooltip": "Automatically detect the spoken language."
                    },
                    "smartFormat": {
                        "type": "toggle",
                        "index": 6,
                        "label": "Smart Format",
                        "tooltip": "Apply formatting to dates, times, numbers, etc."
                    },
                    "punctuate": {
                        "type": "toggle",
                        "index": 7,
                        "label": "Punctuate",
                        "tooltip": "Add punctuation and capitalization."
                    },
                    "diarize": {
                        "type": "toggle",
                        "index": 8,
                        "label": "Diarize",
                        "tooltip": "Recognize and label distinct speakers."
                    },
                    "summarize": {
                        "type": "toggle",
                        "index": 9,
                        "label": "Summarize",
                        "tooltip": "Generate a summary (Audio Intelligence)."
                    },
                    "sentiment": {
                        "type": "toggle",
                        "index": 10,
                        "label": "Sentiment",
                        "tooltip": "Analyze sentiment (Audio Intelligence)."
                    },
                    "topics": {
                        "type": "toggle",
                        "index": 11,
                        "label": "Topics",
                        "tooltip": "Detect topics (Audio Intelligence)."
                    },
                    "intents": {
                        "type": "toggle",
                        "index": 12,
                        "label": "Intents",
                        "tooltip": "Detect intents (Audio Intelligence)."
                    },
                    "extraParams": {
                        "type": "key-value",
                        "index": 13,
                        "keyLabel": "Parameter",
                        "valueLabel": "Value",
                        "addLabel": "Add parameter",
                        "removeLabel": "Remove parameter",
                        "label": "Additional Query Parameters",
                        "tooltip": "Any additional Deepgram query parameters (e.g. redact, keyterm, search, replace)."
                    }
                    ,
                    "correlationId": {
                        "type": "text",
                        "index": 14,
                        "label": "Correlation ID",
                        "tooltip": "Optional. Any value of your own &mdash; an order number, a file name, a record ID. It is echoed back on both the <b>out</b> and <b>done</b> ports, so when several transcriptions run at once you can tell which finished transcript belongs to which input."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "request_id": { "type": "string", "title": "Request ID", "example": "b1f4a0c2-9d3e-4a7b-8c1d-2e5f6a7b8c9d" },
                    "audioUrl": { "type": "string", "title": "Audio URL", "example": "https://dpgr.am/spacewalk.wav" },
                    "fileId": { "type": "string", "title": "File ID", "example": "a1686006-35c8-4ffc-b23e-d687858cd418" },
                    "correlationId": { "type": "string", "title": "Correlation ID", "example": "order-4471" }
                }
            }
        },
        {
            "name": "done",
            "schema": {
                "type": "object",
                "properties": {
                    "request_id": { "type": "string", "title": "Request ID", "example": "b1f4a0c2-9d3e-4a7b-8c1d-2e5f6a7b8c9d" },
                    "audioUrl": { "type": "string", "title": "Audio URL", "example": "https://dpgr.am/spacewalk.wav" },
                    "fileId": { "type": "string", "title": "File ID", "example": "a1686006-35c8-4ffc-b23e-d687858cd418" },
                    "correlationId": { "type": "string", "title": "Correlation ID", "example": "order-4471" },
                    "error": { "type": "string", "title": "Error", "example": "ERR_ASR_FAILED: failed to process audio" },
                    "transcript": { "type": "string", "title": "Transcript", "example": "Hello, and welcome to the show." },
                    "metadata": {
                        "type": "object",
                        "title": "Metadata",
                        "properties": {
                            "duration": { "type": "number", "title": "Duration", "example": 42.5 },
                            "channels": { "type": "integer", "title": "Channels", "example": 1 }
                        }
                    },
                    "results": {
                        "type": "object",
                        "title": "Results",
                        "example": { "channels": [ { "alternatives": [ { "transcript": "Hello, and welcome to the show.", "confidence": 0.99 } ] } ] }
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
