{
    "name": "appmixer.ai.deepgram.TextToSpeech",
    "label": "Text to Speech",
    "description": "Generates speech audio from text using Deepgram Aura-2 and stores the result in File Storage, returning a file ID. Text is limited to 2000 characters per request.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:ai:deepgram"
    },
    "quota": {
        "manager": "appmixer:ai:deepgram",
        "resources": "inference",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "text": { "type": "string" },
                    "model": { "type": "string" },
                    "encoding": { "type": "string" },
                    "container": { "type": "string" },
                    "sampleRate": { "type": "integer" },
                    "bitRate": { "type": "integer" },
                    "fileName": { "type": "string" }
                },
                "required": [
                    "text"
                ]
            },
            "inspector": {
                "inputs": {
                    "text": {
                        "type": "textarea",
                        "index": 1,
                        "label": "Text",
                        "tooltip": "The text to convert to speech. Maximum 2000 characters."
                    },
                    "model": {
                        "type": "text",
                        "index": 2,
                        "label": "Voice",
                        "defaultValue": "aura-2-thalia-en",
                        "tooltip": "The Aura voice to use, e.g. <code>aura-2-thalia-en</code>. Start typing to pick from the TTS voices, or enter a model name manually.",
                        "source": {
                            "url": "/component/appmixer/ai/deepgram/ListModels?outPort=out",
                            "data": {
                                "transform": "./ListModels#toTtsSelectArray",
                                "messages": {
                                    "in/outputType": "array",
                                    "in/isSource": true
                                }
                            }
                        }
                    },
                    "encoding": {
                        "type": "select",
                        "index": 3,
                        "label": "Encoding",
                        "defaultValue": "mp3",
                        "tooltip": "Output audio encoding. Compressed encodings (mp3, opus, flac, aac) are REST-only.",
                        "options": [
                            { "label": "MP3", "value": "mp3" },
                            { "label": "Opus", "value": "opus" },
                            { "label": "FLAC", "value": "flac" },
                            { "label": "AAC", "value": "aac" },
                            { "label": "Linear16 (WAV)", "value": "linear16" }
                        ]
                    },
                    "container": {
                        "type": "text",
                        "index": 4,
                        "label": "Container",
                        "tooltip": "Optional container format, e.g. <code>wav</code> or <code>ogg</code>."
                    },
                    "sampleRate": {
                        "type": "select",
                        "index": 5,
                        "label": "Sample Rate",
                        "tooltip": "Output sample rate in Hz.",
                        "options": [
                            { "label": "8000", "value": 8000 },
                            { "label": "16000", "value": 16000 },
                            { "label": "24000", "value": 24000 },
                            { "label": "32000", "value": 32000 },
                            { "label": "48000", "value": 48000 }
                        ]
                    },
                    "bitRate": {
                        "type": "number",
                        "index": 6,
                        "label": "Bit Rate",
                        "tooltip": "Optional bit rate for compressed encodings."
                    },
                    "fileName": {
                        "type": "text",
                        "index": 7,
                        "label": "File Name",
                        "tooltip": "Optional name for the generated audio file in File Storage."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "fileId": { "type": "string", "title": "File ID", "example": "5f8d0d55b54764421b7156c9" },
                    "fileName": { "type": "string", "title": "File Name", "example": "deepgram-speech.mp3" },
                    "contentType": { "type": "string", "title": "Content Type", "example": "audio/mpeg" },
                    "characterCount": { "type": "integer", "title": "Character Count", "example": 128 }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
