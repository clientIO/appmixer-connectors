{
    "name": "appmixer.github.project.UpdateProjectItemField",
    "label": "Update Project Item Field",
    "description": "Set a single-select, number, text, date or iteration field on a Projects (v2) card. Single-select values are given by option name and resolved to the option ID.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:github",
        "scope": [
            "project",
            "repo"
        ]
    },
    "quota": {
        "manager": "appmixer:github",
        "resources": "requests-projects",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "projectId": {
                        "type": "string"
                    },
                    "itemId": {
                        "type": "string"
                    },
                    "fieldId": {
                        "type": "string"
                    },
                    "valueType": {
                        "type": "string",
                        "enum": ["single_select", "text", "number", "date", "iteration"]
                    },
                    "value": {
                        "type": "string"
                    }
                },
                "required": [
                    "projectId",
                    "itemId",
                    "fieldId",
                    "value"
                ]
            },
            "inspector": {
                "inputs": {
                    "projectId": {
                        "type": "text",
                        "tooltip": "The node ID of the project the card belongs to, for example 'PVT_kwDOAA12oc4AGXUu'.",
                        "label": "Project ID",
                        "index": 1
                    },
                    "itemId": {
                        "type": "text",
                        "tooltip": "The node ID of the project item (card) to update, for example 'PVTI_lADOAA12oc4AGXUuzgbi8fA'.",
                        "label": "Item ID",
                        "index": 2
                    },
                    "fieldId": {
                        "type": "text",
                        "tooltip": "The node ID of the field to set. Pick one of the project's fields or type the ID manually.",
                        "label": "Field ID",
                        "index": 3,
                        "source": {
                            "url": "/component/appmixer/github/project/GetProjectFields?outPort=out",
                            "data": {
                                "messages": {
                                    "in/projectId": "inputs/in/projectId",
                                    "in/outputType": "array"
                                },
                                "transform": "./transformers#fieldsToSelectArray"
                            }
                        }
                    },
                    "valueType": {
                        "type": "select",
                        "tooltip": "The data type of the field being written. This decides how the value is interpreted.",
                        "label": "Value Type",
                        "index": 4,
                        "defaultValue": "single_select",
                        "options": [
                            {
                                "label": "Single Select",
                                "value": "single_select"
                            },
                            {
                                "label": "Text",
                                "value": "text"
                            },
                            {
                                "label": "Number",
                                "value": "number"
                            },
                            {
                                "label": "Date",
                                "value": "date"
                            },
                            {
                                "label": "Iteration",
                                "value": "iteration"
                            }
                        ]
                    },
                    "value": {
                        "type": "text",
                        "tooltip": "The value to write. For single select and iteration fields give the option name (for example 'In Progress'); an option ID is accepted too. Dates accept any parseable date and are truncated to YYYY-MM-DD.",
                        "label": "Value",
                        "index": 5
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
