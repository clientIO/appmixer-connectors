{
    "name": "appmixer.github.project.GetNodeById",
    "label": "Get Node By ID",
    "description": "Resolve a GitHub global node ID (issue, pull request or draft issue) to its number, title, URL, state, repository and labels.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:github",
        "scope": [
            "read:project",
            "repo"
        ]
    },
    "quota": {
        "manager": "appmixer:github",
        "resources": "requests-projects",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "nodeId": {
                        "type": "string"
                    }
                },
                "required": [
                    "nodeId"
                ]
            },
            "inspector": {
                "inputs": {
                    "nodeId": {
                        "type": "text",
                        "tooltip": "The GitHub global node ID to resolve, for example the 'Content Node ID' emitted by the On Project Item Changed trigger.",
                        "label": "Node ID",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "ID",
                        "example": "I_kwDOAA12oc6abcde"
                    },
                    "type": {
                        "type": "string",
                        "title": "Type",
                        "example": "Issue"
                    },
                    "number": {
                        "type": "integer",
                        "title": "Number",
                        "example": 2834
                    },
                    "title": {
                        "type": "string",
                        "title": "Title",
                        "example": "Projects v2 components for board-driven agent workflow"
                    },
                    "url": {
                        "type": "string",
                        "title": "URL",
                        "example": "https://github.com/Appmixer-ai/appmixer-components/issues/2834"
                    },
                    "state": {
                        "type": "string",
                        "title": "State",
                        "example": "OPEN"
                    },
                    "body": {
                        "type": "string",
                        "title": "Body",
                        "example": "We want to drive connector development from a GitHub Projects board."
                    },
                    "isDraft": {
                        "type": "boolean",
                        "title": "Is Draft",
                        "example": false
                    },
                    "repository": {
                        "type": "object",
                        "title": "Repository",
                        "properties": {
                            "name": {
                                "type": "string",
                                "title": "Repository.Name",
                                "example": "appmixer-components"
                            },
                            "owner": {
                                "type": "string",
                                "title": "Repository.Owner",
                                "example": "Appmixer-ai"
                            },
                            "nameWithOwner": {
                                "type": "string",
                                "title": "Repository.Name With Owner",
                                "example": "Appmixer-ai/appmixer-components"
                            }
                        }
                    },
                    "labels": {
                        "type": "array",
                        "title": "Labels",
                        "example": ["enhancement", "connector"],
                        "items": {
                            "type": "string",
                            "title": "Labels.Label",
                            "example": "enhancement"
                        }
                    },
                    "assignees": {
                        "type": "array",
                        "title": "Assignees",
                        "example": ["octocat"],
                        "items": {
                            "type": "string",
                            "title": "Assignees.Login",
                            "example": "octocat"
                        }
                    }
                }
            }
        },
        {
            "name": "notFound"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
