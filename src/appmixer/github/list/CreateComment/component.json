{
    "name": "appmixer.github.list.CreateComment",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Post a comment to the conversation timeline of an issue or a pull request. This is not an inline comment on a line of a diff (use Create Review Comment), nor a reply inside a review thread (use Reply To Review Comment), nor a comment on a commit.",
    "private": false,
    "auth": {
        "service": "appmixer:github",
        "scope": [
            "user",
            "public_repo",
            "repo",
            "notifications",
            "gist"
        ]
    },
    "quota": {
        "manager": "appmixer:github",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "repositoryId": {
                        "type": "string"
                    },
                    "issue": {
                        "type": "string"
                    },
                    "body": {
                        "type": "string"
                    }
                },
                "required": [
                    "repositoryId",
                    "issue"
                ]
            },
            "inspector": {
                "inputs": {
                    "repositoryId": {
                        "type": "text",
                        "group": "transformation",
                        "label": "Repository",
                        "index": 1,
                        "tooltip": "Enter the repository in `owner/repo` format (e.g. `octocat/Hello-World`). You can also pick from the dynamically loaded list of your repositories.",
                        "source": {
                            "url": "/component/appmixer/github/list/ListRepos?outPort=repositories",
                            "data": {
                                "transform": "./transformers#reposToSelectArray"
                            }
                        }
                    },
                    "issue": {
                        "type": "text",
                        "group": "transformation",
                        "label": "Issue",
                        "index": 2,
                        "source": {
                            "url": "/component/appmixer/github/list/ListIssues?outPort=out",
                            "data": {
                                "properties": {
                                    "repositoryId": "inputs/in/repositoryId"
                                },
                                "transform": "./transformers#issuesToSelectArray"
                            }
                        },
                        "tooltip": "Select an Issue to comment on. You can also type the value manually."
                    },
                    "body": {
                        "type": "textarea",
                        "group": "transformation",
                        "tooltip": "Body of Comment.",
                        "label": "Body",
                        "index": 3
                    }
                },
                "groups": {
                    "transformation": {
                        "label": "Transformation",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "ID",
                    "value": "id",
                    "schema": {
                        "type": "integer",
                        "example": 1234567890
                    }
                },
                {
                    "label": "URL",
                    "value": "url",
                    "schema": {
                        "type": "string",
                        "example": "https://api.github.com/repos/octocat/Hello-World/issues/1"
                    }
                },
                {
                    "label": "Body",
                    "value": "body",
                    "schema": {
                        "type": "string",
                        "example": "I'm having a problem with this."
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-01-15T10:30:00Z"
                    }
                },
                {
                    "label": "User ID",
                    "value": "user.id",
                    "schema": {
                        "type": "integer",
                        "example": 583231
                    }
                },
                {
                    "label": "User Login",
                    "value": "user.login",
                    "schema": {
                        "type": "string",
                        "example": "octocat"
                    }
                }
            ]
        }
    ]
}
