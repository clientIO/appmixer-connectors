{
    "name": "appmixer.github.list.ListComments",
    "label": "List Comments",
    "description": "List all comments of an issue or pull request. Useful for finding a 'sticky' comment by an HTML marker before updating it.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:github",
        "scope": [
            "public_repo",
            "repo"
        ]
    },
    "quota": {
        "manager": "appmixer:github",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "repositoryId": {
                        "type": "string",
                        "pattern": "[^/]+[/][^/]+"
                    },
                    "issueNumber": {
                        "type": "string"
                    },
                    "outputType": {
                        "type": "string",
                        "enum": [
                            "array",
                            "first",
                            "object",
                            "file"
                        ]
                    }
                },
                "required": [
                    "repositoryId",
                    "issueNumber"
                ]
            },
            "inspector": {
                "inputs": {
                    "repositoryId": {
                        "type": "text",
                        "label": "Repository",
                        "index": 1,
                        "source": {
                            "url": "/component/appmixer/github/list/ListRepos?outPort=repositories",
                            "data": {
                                "transform": "./transformers#reposToSelectArray"
                            }
                        },
                        "tooltip": "The repository the issue lives in, in the 'owner/repo' form."
                    },
                    "issueNumber": {
                        "type": "text",
                        "label": "Issue Number",
                        "index": 2,
                        "tooltip": "The number of the issue or pull request whose comments to list."
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "index": 3,
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/github/list/ListComments?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType",
                        "in/repositoryId": "dummy/dummy",
                        "in/issueNumber": "1"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
