{
    "name": "appmixer.github.list.SubmitReview",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Submits a PullRequest review.",
    "private": false,
    "auth": {
        "service": "appmixer:github",
        "scope": [
            "user",
            "public_repo",
            "repo",
            "notifications",
            "gist"
        ]
    },
    "quota": {
        "manager": "appmixer:github",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "repositoryId": {
                        "type": "string"
                    },
                    "pullRequest": {
                        "type": "string"
                    },
                    "commitId": {
                        "type": "string"
                    },
                    "body": {
                        "type": "string"
                    },
                    "event": {
                        "type": "string"
                    }
                },
                "required": [
                    "repositoryId",
                    "pullRequest"
                ]
            },
            "inspector": {
                "inputs": {
                    "repositoryId": {
                        "type": "text",
                        "group": "transformation",
                        "label": "Repository",
                        "index": 1,
                        "source": {
                            "url": "/component/appmixer/github/list/ListRepos?outPort=repositories",
                            "data": {
                                "transform": "./transformers#reposToSelectArray"
                            }
                        },
                        "tooltip": "Enter the repository in `owner/repo` format (e.g. `octocat/Hello-World`). You can also pick from the dynamically loaded list of your repositories."
                    },
                    "pullRequest": {
                        "type": "text",
                        "group": "transformation",
                        "label": "Pull Request",
                        "index": 1,
                        "source": {
                            "url": "/component/appmixer/github/list/ListPRs?outPort=out",
                            "data": {
                                "properties": {
                                    "repositoryId": "inputs/in/repositoryId"
                                },
                                "transform": "./transformers#prToSelectArray"
                            }
                        },
                        "tooltip": "Select a Pull Request to update. You can also type the value manually."
                    },
                    "commitId": {
                        "type": "text",
                        "group": "transformation",
                        "tooltip": "The SHA of the commit that needs a review",
                        "label": "Commit SHA",
                        "index": 2
                    },
                    "body": {
                        "type": "textarea",
                        "group": "transformation",
                        "tooltip": "The body text of the pull request review.",
                        "label": "Comment",
                        "index": 3
                    },
                    "event": {
                        "type": "select",
                        "group": "transformation",
                        "label": "Event",
                        "index": 4,
                        "options": [
                            {
                                "label": "Comment",
                                "value": "COMMENT"
                            },
                            {
                                "label": "Approve",
                                "value": "APPROVE"
                            },
                            {
                                "label": "Request Changes",
                                "value": "REQUEST_CHANGES"
                            }
                        ],
                        "tooltip": "The review action you want to perform."
                    }
                },
                "groups": {
                    "transformation": {
                        "label": "Transformation",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "number",
                        "example": 555666777
                    }
                },
                {
                    "label": "Node Id",
                    "value": "node_id",
                    "schema": {
                        "type": "string",
                        "example": "MDEwOlJlcG9zaXRvcnkxMjk2MjY5"
                    }
                },
                {
                    "label": "User",
                    "value": "user",
                    "schema": {
                        "type": "object",
                        "example": {
                            "login": "octocat",
                            "id": 583231
                        }
                    }
                },
                {
                    "label": "Body",
                    "value": "body",
                    "schema": {
                        "type": "string",
                        "example": "LGTM! Nice refactoring of the auth module."
                    }
                },
                {
                    "label": "State",
                    "value": "state",
                    "schema": {
                        "type": "string",
                        "example": "APPROVED"
                    }
                },
                {
                    "label": "Html Url",
                    "value": "html_url",
                    "schema": {
                        "type": "string",
                        "example": "https://github.com/acme-corp/api-server/pull/42#pullrequestreview-555666777"
                    }
                },
                {
                    "label": "Pull Request Url",
                    "value": "pull_request_url",
                    "schema": {
                        "type": "string",
                        "example": "https://api.github.com/repos/octocat/Hello-World/pulls/1"
                    }
                },
                {
                    "label": "Author Association",
                    "value": "author_association",
                    "schema": {
                        "type": "string",
                        "example": "OWNER"
                    }
                },
                {
                    "label": "Links",
                    "value": "_links",
                    "schema": {
                        "type": "object",
                        "example": {}
                    }
                },
                {
                    "label": "Submitted At",
                    "value": "submitted_at",
                    "schema": {
                        "type": "string",
                        "example": "2026-01-15T14:00:00Z"
                    }
                },
                {
                    "label": "Commit Id",
                    "value": "commit_id",
                    "schema": {
                        "type": "string",
                        "example": "abc123def456789"
                    }
                }
            ]
        }
    ]
}
