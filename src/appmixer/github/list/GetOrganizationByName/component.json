{
    "name": "appmixer.github.list.GetOrganizationByName",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Fetches an organization by name.",
    "version": "1.0.1",
    "private": false,
    "auth": {
        "service": "appmixer:github",
        "scope": [
            "user",
            "public_repo",
            "repo",
            "notifications",
            "gist"
        ]
    },
    "quota": {
        "manager": "appmixer:github",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Login",
                    "value": "login",
                    "schema": {
                        "type": "string",
                        "example": "acme-corp"
                    }
                },
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "number",
                        "example": 12345678
                    }
                },
                {
                    "label": "Node Id",
                    "value": "node_id",
                    "schema": {
                        "type": "string",
                        "example": "MDEyOk9yZ2FuaXphdGlvbjEyMzQ1Njc4"
                    }
                },
                {
                    "label": "Url",
                    "value": "url",
                    "schema": {
                        "type": "string",
                        "example": "https://api.github.com/orgs/acme-corp"
                    }
                },
                {
                    "label": "Repos Url",
                    "value": "repos_url",
                    "schema": {
                        "type": "string",
                        "example": "https://api.github.com/orgs/acme-corp/repos"
                    }
                },
                {
                    "label": "Events Url",
                    "value": "events_url",
                    "schema": {
                        "type": "string",
                        "example": "https://api.github.com/users/octocat/events{/privacy}"
                    }
                },
                {
                    "label": "Hooks Url",
                    "value": "hooks_url",
                    "schema": {
                        "type": "string",
                        "example": "https://api.github.com/orgs/github/hooks"
                    }
                },
                {
                    "label": "Issues Url",
                    "value": "issues_url",
                    "schema": {
                        "type": "string",
                        "example": "https://api.github.com/orgs/github/issues"
                    }
                },
                {
                    "label": "Members Url",
                    "value": "members_url",
                    "schema": {
                        "type": "string",
                        "example": "https://api.github.com/orgs/github/members{/member}"
                    }
                },
                {
                    "label": "Public Members Url",
                    "value": "public_members_url",
                    "schema": {
                        "type": "string",
                        "example": "https://api.github.com/orgs/github/public_members{/member}"
                    }
                },
                {
                    "label": "Avatar Url",
                    "value": "avatar_url",
                    "schema": {
                        "type": "string",
                        "example": "https://github.com/images/error/octocat_happy.gif"
                    }
                },
                {
                    "label": "Description",
                    "value": "description",
                    "schema": {
                        "type": "string",
                        "example": "Building the future of automation"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Acme Corporation"
                    }
                },
                {
                    "label": "Company",
                    "value": "company",
                    "schema": {
                        "type": "string",
                        "example": "Acme Corp"
                    }
                },
                {
                    "label": "Blog",
                    "value": "blog",
                    "schema": {
                        "type": "string",
                        "example": "https://acme-corp.com"
                    }
                },
                {
                    "label": "Location",
                    "value": "location",
                    "schema": {
                        "type": "string",
                        "example": "San Francisco, CA"
                    }
                },
                {
                    "label": "Email",
                    "value": "email",
                    "schema": {
                        "type": "string",
                        "example": "dev@acme-corp.com"
                    }
                },
                {
                    "label": "Twitter Username",
                    "value": "twitter_username",
                    "schema": {
                        "type": "string",
                        "example": "acmecorp"
                    }
                },
                {
                    "label": "Is Verified",
                    "value": "is_verified",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "Has Organization Projects",
                    "value": "has_organization_projects",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "Has Repository Projects",
                    "value": "has_repository_projects",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "Public Repos",
                    "value": "public_repos",
                    "schema": {
                        "type": "number",
                        "example": 42
                    }
                },
                {
                    "label": "Public Gists",
                    "value": "public_gists",
                    "schema": {
                        "type": "number",
                        "example": 5
                    }
                },
                {
                    "label": "Followers",
                    "value": "followers",
                    "schema": {
                        "type": "number",
                        "example": 1500
                    }
                },
                {
                    "label": "Following",
                    "value": "following",
                    "schema": {
                        "type": "number",
                        "example": 0
                    }
                },
                {
                    "label": "Html Url",
                    "value": "html_url",
                    "schema": {
                        "type": "string",
                        "example": "https://github.com/acme-corp"
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "string",
                        "example": "2020-03-15T08:00:00Z"
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updated_at",
                    "schema": {
                        "type": "string",
                        "example": "2026-01-10T12:00:00Z"
                    }
                },
                {
                    "label": "Archived At",
                    "value": "archived_at",
                    "schema": {
                        "type": "string",
                        "example": null
                    }
                },
                {
                    "label": "Type",
                    "value": "type",
                    "schema": {
                        "type": "string",
                        "example": "Organization"
                    }
                }
            ]
        }
    ],
    "properties": {
        "schema": {
            "properties": {
                "organization": {
                    "type": "string"
                }
            },
            "required": [
                "organization"
            ]
        },
        "inspector": {
            "inputs": {
                "organization": {
                    "type": "text",
                    "group": "config",
                    "label": "Organization Name",
                    "index": 2,
                    "tooltip": "Enter the name of the organization to get."
                }
            },
            "groups": {
                "config": {
                    "label": "Configuration",
                    "index": 1
                }
            }
        }
    }
}
