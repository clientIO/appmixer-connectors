{
    "name": "appmixer.github.list.CreatePullRequest",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Create a new pull request.",
    "private": false,
    "auth": {
        "service": "appmixer:github",
        "scope": [
            "user",
            "public_repo",
            "repo",
            "notifications",
            "gist"
        ]
    },
    "quota": {
        "manager": "appmixer:github",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string"
                    },
                    "body": {
                        "type": "string"
                    },
                    "head": {
                        "type": "string"
                    },
                    "base": {
                        "type": "string"
                    },
                    "draft": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "title",
                    "head",
                    "base"
                ]
            },
            "inspector": {
                "inputs": {
                    "title": {
                        "type": "text",
                        "group": "transformation",
                        "tooltip": "Title of the PR.",
                        "label": "Title",
                        "index": 2
                    },
                    "body": {
                        "type": "textarea",
                        "group": "transformation",
                        "tooltip": "Description of the PR.",
                        "label": "Description",
                        "index": 3
                    },
                    "head": {
                        "type": "text",
                        "group": "transformation",
                        "label": "Head",
                        "index": 4,
                        "source": {
                            "url": "/component/appmixer/github/list/ListBranches?outPort=branches",
                            "data": {
                                "properties": {
                                    "repositoryId": "properties/repositoryId"
                                },
                                "transform": "./transformers#branchesToSelectArray"
                            }
                        },
                        "tooltip": "The name of the branch where your changes are implemented."
                    },
                    "base": {
                        "type": "text",
                        "group": "transformation",
                        "label": "Base",
                        "index": 5,
                        "source": {
                            "url": "/component/appmixer/github/list/ListBranches?outPort=branches",
                            "data": {
                                "properties": {
                                    "repositoryId": "properties/repositoryId"
                                },
                                "transform": "./transformers#branchesToSelectArray"
                            }
                        },
                        "tooltip": "The name of the branch you want the changes pulled into."
                    },
                    "draft": {
                        "type": "toggle",
                        "group": "transformation",
                        "label": "Draft",
                        "index": 6,
                        "tooltip": "If checked, the pull request will be created as a draft."
                    }
                },
                "groups": {
                    "transformation": {
                        "label": "Transformation",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "ID",
                    "value": "id",
                    "schema": {
                        "type": "integer",
                        "example": 1234567890
                    }
                },
                {
                    "label": "HTML URL",
                    "value": "html_url",
                    "schema": {
                        "type": "string",
                        "example": "https://github.com/octocat/Hello-World/issues/1"
                    }
                },
                {
                    "label": "URL",
                    "value": "url",
                    "schema": {
                        "type": "string",
                        "example": "https://api.github.com/repos/octocat/Hello-World/issues/1"
                    }
                },
                {
                    "label": "Title",
                    "value": "title",
                    "schema": {
                        "type": "string",
                        "example": "Found a bug"
                    }
                },
                {
                    "label": "Body",
                    "value": "body",
                    "schema": {
                        "type": "string",
                        "example": "I'm having a problem with this."
                    }
                },
                {
                    "label": "State",
                    "value": "state",
                    "schema": {
                        "type": "string",
                        "example": "open"
                    }
                },
                {
                    "label": "Number",
                    "value": "number",
                    "schema": {
                        "type": "integer",
                        "example": 42
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-01-15T10:30:00Z"
                    }
                },
                {
                    "label": "Closed At",
                    "value": "closed_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-01-16T08:00:00Z"
                    }
                },
                {
                    "label": "Assignee ID",
                    "value": "assignee.id",
                    "schema": {
                        "type": "integer",
                        "example": 583231
                    }
                },
                {
                    "label": "Assignee Login",
                    "value": "assignee.login",
                    "schema": {
                        "type": "string",
                        "example": "octocat"
                    }
                },
                {
                    "label": "Assignee Type",
                    "value": "assignee.type",
                    "schema": {
                        "type": "string",
                        "example": "User"
                    }
                },
                {
                    "label": "Assignee HTML URL",
                    "value": "assignee.html_url",
                    "schema": {
                        "type": "string",
                        "example": "https://github.com/octocat"
                    }
                },
                {
                    "label": "User ID",
                    "value": "user.id",
                    "schema": {
                        "type": "integer",
                        "example": 583231
                    }
                },
                {
                    "label": "User Login",
                    "value": "user.login",
                    "schema": {
                        "type": "string",
                        "example": "octocat"
                    }
                },
                {
                    "label": "User Type",
                    "value": "user.type",
                    "schema": {
                        "type": "string",
                        "example": "User"
                    }
                },
                {
                    "label": "User HTML URL",
                    "value": "user.html_url",
                    "schema": {
                        "type": "string",
                        "example": "https://github.com/octocat"
                    }
                },
                {
                    "label": "Head",
                    "value": "head.label",
                    "schema": {
                        "type": "string",
                        "example": "octocat:new-feature"
                    }
                },
                {
                    "label": "Base",
                    "value": "base.label",
                    "schema": {
                        "type": "string",
                        "example": "octocat:main"
                    }
                }
            ]
        }
    ],
    "properties": {
        "schema": {
            "properties": {
                "repositoryId": {
                    "type": "string",
                    "pattern": "[^/]+[/][^/]+"
                }
            },
            "required": [
                "repositoryId"
            ]
        },
        "inspector": {
            "inputs": {
                "repositoryId": {
                    "type": "text",
                    "group": "config",
                    "label": "Repository",
                    "index": 1,
                    "tooltip": "Enter the repository in `owner/repo` format (e.g. `octocat/Hello-World`). You can also pick from the dynamically loaded list of your repositories.",
                    "source": {
                        "url": "/component/appmixer/github/list/ListRepos?outPort=repositories",
                        "data": {
                            "transform": "./transformers#reposToSelectArray"
                        }
                    }
                }
            },
            "groups": {
                "config": {
                    "label": "Configuration",
                    "index": 1
                }
            }
        }
    }
}
