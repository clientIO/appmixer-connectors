{
    "name": "appmixer.github.list.NewReview",
    "label": "New Review",
    "description": "Triggers when a pull request review is submitted, with its state (Approved, Changes Requested or Commented). This is the only way to catch a review that carries a body but no inline comments — an approval with a note — which a trigger built on review comments cannot see. GitHub has no repository-wide reviews endpoint, so open pull requests touched since the last check are scanned one by one.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": false,
    "tick": true,
    "auth": {
        "service": "appmixer:github",
        "scope": [
            "public_repo",
            "repo"
        ]
    },
    "quota": {
        "manager": "appmixer:github",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "repositoryId": {
                    "type": "string",
                    "pattern": "[^/]+[/][^/]+"
                },
                "pullRequestNumber": {
                    "type": "string"
                },
                "state": {
                    "type": "string",
                    "enum": [
                        "any",
                        "APPROVED",
                        "CHANGES_REQUESTED",
                        "COMMENTED",
                        "DISMISSED"
                    ]
                },
                "author": {
                    "type": "string"
                },
                "authorType": {
                    "type": "string",
                    "enum": [
                        "any",
                        "bots",
                        "humans"
                    ]
                }
            },
            "required": [
                "repositoryId"
            ]
        },
        "inspector": {
            "inputs": {
                "repositoryId": {
                    "type": "text",
                    "group": "config",
                    "label": "Repository",
                    "index": 1,
                    "tooltip": "Enter the repository in `owner/repo` format (e.g. `octocat/Hello-World`). You can also pick from the dynamically loaded list of your repositories.",
                    "source": {
                        "url": "/component/appmixer/github/list/ListRepos?outPort=repositories",
                        "data": {
                            "transform": "./transformers#reposToSelectArray"
                        }
                    }
                },
                "pullRequestNumber": {
                    "type": "text",
                    "group": "config",
                    "label": "Pull Request Number",
                    "index": 2,
                    "tooltip": "Optional. Watch only this pull request (e.g. `1259`). Leave empty to watch the open pull requests of the whole repository; closed and merged ones are not scanned."
                },
                "state": {
                    "type": "select",
                    "group": "config",
                    "label": "State",
                    "index": 3,
                    "defaultValue": "any",
                    "tooltip": "Fire only on reviews submitted in this state.",
                    "options": [
                        {
                            "label": "Any state",
                            "value": "any"
                        },
                        {
                            "label": "Approved",
                            "value": "APPROVED"
                        },
                        {
                            "label": "Changes requested",
                            "value": "CHANGES_REQUESTED"
                        },
                        {
                            "label": "Commented",
                            "value": "COMMENTED"
                        },
                        {
                            "label": "Dismissed",
                            "value": "DISMISSED"
                        }
                    ]
                },
                "author": {
                    "type": "text",
                    "group": "config",
                    "label": "Author",
                    "index": 4,
                    "tooltip": "Optional. Comma-separated reviewer logins, matched case-insensitively as substrings (e.g. `copilot, dependabot`). Substring matching is intentional: the same actor is reported under a different login on every GitHub API surface, so `copilot` matches `Copilot` and `copilot-pull-request-reviewer` alike."
                },
                "authorType": {
                    "type": "select",
                    "group": "config",
                    "label": "Author Type",
                    "index": 5,
                    "defaultValue": "any",
                    "tooltip": "Restrict to reviews submitted by bot accounts (code review bots, apps) or by human accounts.",
                    "options": [
                        {
                            "label": "Anyone",
                            "value": "any"
                        },
                        {
                            "label": "Bots only",
                            "value": "bots"
                        },
                        {
                            "label": "Humans only",
                            "value": "humans"
                        }
                    ]
                }
            },
            "groups": {
                "config": {
                    "label": "Configuration",
                    "index": 1
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "ID",
                        "example": 3512480011
                    },
                    "node_id": {
                        "type": "string",
                        "title": "Node ID",
                        "example": "PRR_kwDOAA12oc6abcde"
                    },
                    "state": {
                        "type": "string",
                        "title": "State",
                        "example": "CHANGES_REQUESTED"
                    },
                    "body": {
                        "type": "string",
                        "title": "Body",
                        "example": "Looks good overall, two small things inline."
                    },
                    "html_url": {
                        "type": "string",
                        "title": "HTML URL",
                        "example": "https://github.com/Appmixer-ai/appmixer-connectors/pull/1259#pullrequestreview-3512480011"
                    },
                    "pull_request_url": {
                        "type": "string",
                        "title": "Pull Request URL",
                        "example": "https://api.github.com/repos/Appmixer-ai/appmixer-connectors/pulls/1259"
                    },
                    "pull_request_number": {
                        "type": "integer",
                        "title": "Pull Request Number",
                        "example": 1259
                    },
                    "commit_id": {
                        "type": "string",
                        "title": "Commit ID",
                        "example": "6dcb09b5b57875f334f61aebed695e2e4193db5e"
                    },
                    "submitted_at": {
                        "type": "string",
                        "title": "Submitted At",
                        "example": "2026-09-09T11:27:45Z"
                    },
                    "author_association": {
                        "type": "string",
                        "title": "Author Association",
                        "example": "MEMBER"
                    },
                    "user": {
                        "type": "object",
                        "title": "User",
                        "properties": {
                            "login": {
                                "type": "string",
                                "title": "User.Login",
                                "example": "Copilot"
                            },
                            "id": {
                                "type": "integer",
                                "title": "User.ID",
                                "example": 198982749
                            },
                            "type": {
                                "type": "string",
                                "title": "User.Type",
                                "example": "Bot"
                            }
                        }
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
