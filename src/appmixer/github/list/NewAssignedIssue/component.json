{
    "name": "appmixer.github.list.NewAssignedIssue",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Triggers whenever a new issue is assigned to the authenticated user. Optionally filter by a specific repository.",
    "private": false,
    "tick": true,
    "auth": {
        "service": "appmixer:github",
        "scope": [
            "user",
            "public_repo",
            "repo",
            "notifications",
            "gist"
        ]
    },
    "quota": {
        "manager": "appmixer:github",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "ID",
                        "example": 1234567890
                    },
                    "number": {
                        "type": "integer",
                        "title": "Number",
                        "example": 42
                    },
                    "title": {
                        "type": "string",
                        "title": "Title",
                        "example": "Found a bug"
                    },
                    "body": {
                        "type": "string",
                        "title": "Body",
                        "example": "I'm having a problem with this."
                    },
                    "state": {
                        "type": "string",
                        "title": "State",
                        "example": "open"
                    },
                    "html_url": {
                        "type": "string",
                        "title": "HTML URL",
                        "example": "https://github.com/octocat/Hello-World/issues/1"
                    },
                    "url": {
                        "type": "string",
                        "title": "URL",
                        "example": "https://api.github.com/repos/octocat/Hello-World/issues/1"
                    },
                    "created_at": {
                        "type": "string",
                        "title": "Created At",
                        "example": "2024-01-15T10:30:00Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "title": "Updated At",
                        "example": "2024-01-15T10:30:00Z"
                    },
                    "closed_at": {
                        "type": "string",
                        "title": "Closed At",
                        "example": "2024-01-16T08:00:00Z"
                    },
                    "repository_url": {
                        "type": "string",
                        "title": "Repository URL",
                        "example": "https://api.github.com/repos/octocat/Hello-World"
                    },
                    "user": {
                        "type": "object",
                        "title": "User",
                        "properties": {
                            "login": {
                                "type": "string",
                                "title": "User.Login",
                                "example": "octocat"
                            },
                            "id": {
                                "type": "integer",
                                "title": "User.ID",
                                "example": 583231
                            },
                            "html_url": {
                                "type": "string",
                                "title": "User.HTML URL",
                                "example": "https://github.com/octocat"
                            }
                        }
                    },
                    "assignee": {
                        "type": "object",
                        "title": "Assignee",
                        "properties": {
                            "login": {
                                "type": "string",
                                "title": "Assignee.Login",
                                "example": "octocat"
                            },
                            "id": {
                                "type": "integer",
                                "title": "Assignee.ID",
                                "example": 583231
                            }
                        }
                    },
                    "milestone": {
                        "type": "object",
                        "title": "Milestone",
                        "properties": {
                            "title": {
                                "type": "string",
                                "title": "Milestone.Title",
                                "example": "v1.0"
                            }
                        }
                    }
                }
            }
        }
    ],
    "properties": {
        "schema": {
            "properties": {
                "repositoryId": {
                    "type": "string",
                    "pattern": "[^/]+[/][^/]+"
                }
            },
            "required": []
        },
        "inspector": {
            "inputs": {
                "repositoryId": {
                    "type": "text",
                    "group": "config",
                    "label": "Repository",
                    "index": 1,
                    "tooltip": "Enter the repository in `owner/repo` format (e.g. `octocat/Hello-World`). You can also pick from the dynamically loaded list of your repositories.",
                    "source": {
                        "url": "/component/appmixer/github/list/ListRepos?outPort=repositories",
                        "data": {
                            "transform": "./transformers#reposToSelectArray"
                        }
                    }
                }
            },
            "groups": {
                "config": {
                    "label": "Configuration",
                    "index": 1
                }
            }
        }
    }
}
