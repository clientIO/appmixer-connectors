{
    "name": "appmixer.github.list.NewAssignedIssue",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Triggers whenever a new issue is assigned to the authenticated user. Optionally filter by a specific repository.",
    "private": false,
    "tick": true,
    "auth": {
        "service": "appmixer:github",
        "scope": [
            "user",
            "public_repo",
            "repo",
            "notifications",
            "gist"
        ]
    },
    "quota": {
        "manager": "appmixer:github",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "ID",
                    "value": "id",
                    "schema": {
                        "type": "integer",
                        "example": 1234567890
                    }
                },
                {
                    "label": "Number",
                    "value": "number",
                    "schema": {
                        "type": "integer",
                        "example": 42
                    }
                },
                {
                    "label": "Title",
                    "value": "title",
                    "schema": {
                        "type": "string",
                        "example": "Found a bug"
                    }
                },
                {
                    "label": "Body",
                    "value": "body",
                    "schema": {
                        "type": "string",
                        "example": "I'm having a problem with this."
                    }
                },
                {
                    "label": "State",
                    "value": "state",
                    "schema": {
                        "type": "string",
                        "example": "open"
                    }
                },
                {
                    "label": "HTML URL",
                    "value": "html_url",
                    "schema": {
                        "type": "string",
                        "example": "https://github.com/octocat/Hello-World/issues/1"
                    }
                },
                {
                    "label": "URL",
                    "value": "url",
                    "schema": {
                        "type": "string",
                        "example": "https://api.github.com/repos/octocat/Hello-World/issues/1"
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-01-15T10:30:00Z"
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updated_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-01-15T10:30:00Z"
                    }
                },
                {
                    "label": "Closed At",
                    "value": "closed_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-01-16T08:00:00Z"
                    }
                },
                {
                    "label": "Repository URL",
                    "value": "repository_url",
                    "schema": {
                        "type": "string",
                        "example": "https://api.github.com/repos/octocat/Hello-World"
                    }
                },
                {
                    "label": "User Login",
                    "value": "user.login",
                    "schema": {
                        "type": "string",
                        "example": "octocat"
                    }
                },
                {
                    "label": "User ID",
                    "value": "user.id",
                    "schema": {
                        "type": "integer",
                        "example": 583231
                    }
                },
                {
                    "label": "User HTML URL",
                    "value": "user.html_url",
                    "schema": {
                        "type": "string",
                        "example": "https://github.com/octocat"
                    }
                },
                {
                    "label": "Assignee Login",
                    "value": "assignee.login",
                    "schema": {
                        "type": "string",
                        "example": "octocat"
                    }
                },
                {
                    "label": "Assignee ID",
                    "value": "assignee.id",
                    "schema": {
                        "type": "integer",
                        "example": 583231
                    }
                },
                {
                    "label": "Milestone Title",
                    "value": "milestone.title",
                    "schema": {
                        "type": "string",
                        "example": "v1.0"
                    }
                }
            ]
        }
    ],
    "properties": {
        "schema": {
            "properties": {
                "repositoryId": {
                    "type": "string",
                    "pattern": "[^/]+[/][^/]+"
                }
            },
            "required": []
        },
        "inspector": {
            "inputs": {
                "repositoryId": {
                    "type": "text",
                    "group": "config",
                    "label": "Repository",
                    "index": 1,
                    "tooltip": "Enter the repository in `owner/repo` format (e.g. `octocat/Hello-World`). You can also pick from the dynamically loaded list of your repositories.",
                    "source": {
                        "url": "/component/appmixer/github/list/ListRepos?outPort=repositories",
                        "data": {
                            "transform": "./transformers#reposToSelectArray"
                        }
                    }
                }
            },
            "groups": {
                "config": {
                    "label": "Configuration",
                    "index": 1
                }
            }
        }
    }
}
