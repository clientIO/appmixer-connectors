{
    "name": "appmixer.github.list.NewPullRequestReviewComment",
    "label": "New Pull Request Review Comment",
    "description": "Triggers when a new review comment — a comment anchored to a line of a pull request diff — is posted anywhere in a repository. Optionally filter by pull request, author login or bots vs. humans. This is not the same as a comment in the pull request conversation (use New Issue Comment) nor a comment on a commit (use New Commit Comment).",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": false,
    "tick": true,
    "auth": {
        "service": "appmixer:github",
        "scope": [
            "public_repo",
            "repo"
        ]
    },
    "quota": {
        "manager": "appmixer:github",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "repositoryId": {
                    "type": "string",
                    "pattern": "[^/]+[/][^/]+"
                },
                "pullRequestNumber": {
                    "type": "string"
                },
                "author": {
                    "type": "string"
                },
                "authorType": {
                    "type": "string",
                    "enum": [
                        "any",
                        "bots",
                        "humans"
                    ]
                }
            },
            "required": [
                "repositoryId"
            ]
        },
        "inspector": {
            "inputs": {
                "repositoryId": {
                    "type": "text",
                    "group": "config",
                    "label": "Repository",
                    "index": 1,
                    "tooltip": "Enter the repository in `owner/repo` format (e.g. `octocat/Hello-World`). You can also pick from the dynamically loaded list of your repositories. One call covers the whole repository, so no pull request has to be named.",
                    "source": {
                        "url": "/component/appmixer/github/list/ListRepos?outPort=repositories",
                        "data": {
                            "transform": "./transformers#reposToSelectArray"
                        }
                    }
                },
                "pullRequestNumber": {
                    "type": "text",
                    "group": "config",
                    "label": "Pull Request Number",
                    "index": 2,
                    "tooltip": "Optional. Watch only this pull request (e.g. `1259`). Leave empty to watch review comments on every pull request in the repository."
                },
                "author": {
                    "type": "text",
                    "group": "config",
                    "label": "Author",
                    "index": 3,
                    "tooltip": "Optional. Comma-separated author logins, matched case-insensitively as substrings (e.g. `copilot, dependabot`). Substring matching is intentional: the same actor is reported under a different login on every GitHub API surface — GitHub Copilot is `Copilot` over REST but `copilot-pull-request-reviewer` over GraphQL — so `copilot` matches all of them."
                },
                "authorType": {
                    "type": "select",
                    "group": "config",
                    "label": "Author Type",
                    "index": 4,
                    "defaultValue": "any",
                    "tooltip": "Restrict to comments written by bot accounts (code review bots, apps) or by human accounts.",
                    "options": [
                        {
                            "label": "Anyone",
                            "value": "any"
                        },
                        {
                            "label": "Bots only",
                            "value": "bots"
                        },
                        {
                            "label": "Humans only",
                            "value": "humans"
                        }
                    ]
                }
            },
            "groups": {
                "config": {
                    "label": "Configuration",
                    "index": 1
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "ID",
                        "example": 2384759211
                    },
                    "node_id": {
                        "type": "string",
                        "title": "Node ID",
                        "example": "PRRC_kwDOAA12oc6abcde"
                    },
                    "body": {
                        "type": "string",
                        "title": "Body",
                        "example": "This loop can be replaced by a single map()."
                    },
                    "html_url": {
                        "type": "string",
                        "title": "HTML URL",
                        "example": "https://github.com/Appmixer-ai/appmixer-connectors/pull/1259#discussion_r2384759211"
                    },
                    "pull_request_url": {
                        "type": "string",
                        "title": "Pull Request URL",
                        "example": "https://api.github.com/repos/Appmixer-ai/appmixer-connectors/pulls/1259"
                    },
                    "pull_request_review_id": {
                        "type": "integer",
                        "title": "Pull Request Review ID",
                        "example": 3512480011
                    },
                    "in_reply_to_id": {
                        "type": "integer",
                        "title": "In Reply To ID",
                        "example": 2384759100
                    },
                    "path": {
                        "type": "string",
                        "title": "Path",
                        "example": "src/appmixer/github/lib.js"
                    },
                    "line": {
                        "type": "integer",
                        "title": "Line",
                        "example": 42
                    },
                    "start_line": {
                        "type": "integer",
                        "title": "Start Line",
                        "example": 38
                    },
                    "side": {
                        "type": "string",
                        "title": "Side",
                        "example": "RIGHT"
                    },
                    "subject_type": {
                        "type": "string",
                        "title": "Subject Type",
                        "example": "line"
                    },
                    "diff_hunk": {
                        "type": "string",
                        "title": "Diff Hunk",
                        "example": "@@ -38,7 +38,7 @@ module.exports = {\n-    const items = [];"
                    },
                    "commit_id": {
                        "type": "string",
                        "title": "Commit ID",
                        "example": "6dcb09b5b57875f334f61aebed695e2e4193db5e"
                    },
                    "author_association": {
                        "type": "string",
                        "title": "Author Association",
                        "example": "MEMBER"
                    },
                    "created_at": {
                        "type": "string",
                        "title": "Created At",
                        "example": "2026-09-09T11:27:45Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "title": "Updated At",
                        "example": "2026-09-09T11:27:45Z"
                    },
                    "user": {
                        "type": "object",
                        "title": "User",
                        "properties": {
                            "login": {
                                "type": "string",
                                "title": "User.Login",
                                "example": "Copilot"
                            },
                            "id": {
                                "type": "integer",
                                "title": "User.ID",
                                "example": 198982749
                            },
                            "type": {
                                "type": "string",
                                "title": "User.Type",
                                "example": "Bot"
                            }
                        }
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
