{
    "name": "appmixer.github.list.FindFiles",
    "label": "Find Files",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Finds files in a repository by name, optionally under a path, at a branch, tag or commit. Reads the whole tree in one request, so it also finds files the search index does not cover, e.g. on a pull request head. Use `*` in the name as a wildcard (`*.json`).",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:github",
        "scope": [
            "user",
            "public_repo",
            "repo",
            "notifications",
            "gist"
        ]
    },
    "quota": {
        "manager": "appmixer:github",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "repositoryId": {
                        "type": "string",
                        "description": "Repository as owner/repo or its GitHub URL."
                    },
                    "name": {
                        "type": "string",
                        "description": "File name to find; * matches any characters, e.g. *.json."
                    },
                    "path": {
                        "type": "string",
                        "description": "Only files under this directory."
                    },
                    "ref": {
                        "type": "string",
                        "description": "Branch, tag or commit SHA. Defaults to the default branch."
                    },
                    "outputType": {
                        "type": "string",
                        "enum": [
                            "array",
                            "first",
                            "object",
                            "file"
                        ]
                    }
                },
                "required": [
                    "repositoryId",
                    "name",
                    "outputType"
                ]
            },
            "inspector": {
                "inputs": {
                    "repositoryId": {
                        "type": "text",
                        "group": "config",
                        "label": "Repository",
                        "index": 1,
                        "tooltip": "The repository, in owner/repo format (e.g. octo-org/octo-repo) or as its GitHub URL."
                    },
                    "name": {
                        "type": "text",
                        "group": "config",
                        "label": "File Name",
                        "index": 2,
                        "tooltip": "The file name to find, e.g. bundle.json. Use * as a wildcard: *.json finds every JSON file. The name is matched against the file name only, not the path."
                    },
                    "path": {
                        "type": "text",
                        "group": "config",
                        "label": "Path",
                        "index": 3,
                        "tooltip": "Only look under this directory, e.g. src/connectors. Leave empty to search the whole repository."
                    },
                    "ref": {
                        "type": "text",
                        "group": "config",
                        "label": "Branch, Tag or Commit",
                        "index": 4,
                        "tooltip": "Where to look: a branch name, a tag or a commit SHA. A pull request head SHA works too, even when it comes from a fork. Leave empty for the default branch."
                    },
                    "outputType": {
                        "type": "select",
                        "group": "config",
                        "label": "Output Type",
                        "index": 5,
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first file only or one file at a time or stream the files to a file.",
                        "options": [
                            {
                                "label": "First File Only",
                                "value": "first"
                            },
                            {
                                "label": "All files at once",
                                "value": "array"
                            },
                            {
                                "label": "One file at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                },
                "groups": {
                    "config": {
                        "label": "Configuration",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/github/list/FindFiles?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType",
                        "in/repositoryId": "dummy",
                        "in/name": "dummy"
                    }
                }
            }
        },
        {
            "name": "notFound"
        }
    ]
}
