{
    "name": "appmixer.github.list.NewMention",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Triggers whenever the authenticated user is mentioned in an issue, pull request, or comment on GitHub. Optionally filter by one or more repositories.",
    "private": false,
    "tick": true,
    "auth": {
        "service": "appmixer:github",
        "scope": [
            "user",
            "public_repo",
            "repo",
            "notifications",
            "gist"
        ]
    },
    "quota": {
        "manager": "appmixer:github",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "properties": {
        "schema": {
            "properties": {
                "repositories": {
                    "type": "string"
                }
            }
        },
        "inspector": {
            "inputs": {
                "repositories": {
                    "type": "text",
                    "group": "config",
                    "label": "Repositories",
                    "index": 1,
                    "tooltip": "Optional. One or more repositories to watch for mentions, in `owner/repo` format, separated by commas (e.g. `octocat/Hello-World, octocat/Spoon-Knife`). Leave empty to watch mentions across all repositories."
                }
            },
            "groups": {
                "config": {
                    "label": "Configuration",
                    "index": 1
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "ID",
                    "value": "id",
                    "schema": {
                        "type": "integer",
                        "example": 1234567890
                    }
                },
                {
                    "label": "Reason",
                    "value": "reason",
                    "schema": {
                        "type": "string",
                        "example": "mention"
                    }
                },
                {
                    "label": "Subject Title",
                    "value": "subject.title",
                    "schema": {
                        "type": "string",
                        "example": "Found a bug"
                    }
                },
                {
                    "label": "Subject URL",
                    "value": "subject.url",
                    "schema": {
                        "type": "string",
                        "example": "https://api.github.com/repos/octocat/Hello-World/issues/1"
                    }
                },
                {
                    "label": "Subject Type",
                    "value": "subject.type",
                    "schema": {
                        "type": "string",
                        "example": "Issue"
                    }
                },
                {
                    "label": "Subject Latest Comment URL",
                    "value": "subject.latest_comment_url",
                    "schema": {
                        "type": "string",
                        "example": "https://api.github.com/repos/octocat/Hello-World/issues/comments/1"
                    }
                },
                {
                    "label": "Repository Full Name",
                    "value": "repository.full_name",
                    "schema": {
                        "type": "string",
                        "example": "octocat/Hello-World"
                    }
                },
                {
                    "label": "Repository ID",
                    "value": "repository.id",
                    "schema": {
                        "type": "integer",
                        "example": 1296269
                    }
                },
                {
                    "label": "Repository HTML URL",
                    "value": "repository.html_url",
                    "schema": {
                        "type": "string",
                        "example": "https://github.com/octocat/Hello-World"
                    }
                },
                {
                    "label": "URL",
                    "value": "url",
                    "schema": {
                        "type": "string",
                        "example": "https://api.github.com/repos/octocat/Hello-World/issues/1"
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updated_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-01-15T10:30:00Z"
                    }
                },
                {
                    "label": "Unread",
                    "value": "unread",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                }
            ]
        }
    ]
}
