{
    "name": "appmixer.github.list.NewMention",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Triggers whenever the authenticated user is mentioned in an issue, pull request, or comment on GitHub. Optionally filter by one or more repositories.",
    "private": false,
    "tick": true,
    "auth": {
        "service": "appmixer:github",
        "scope": [
            "user",
            "public_repo",
            "repo",
            "notifications",
            "gist"
        ]
    },
    "quota": {
        "manager": "appmixer:github",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "properties": {
        "schema": {
            "properties": {
                "repositories": {
                    "type": "string"
                }
            }
        },
        "inspector": {
            "inputs": {
                "repositories": {
                    "type": "text",
                    "group": "config",
                    "label": "Repositories",
                    "index": 1,
                    "tooltip": "Optional. One or more repositories to watch for mentions, in `owner/repo` format, separated by commas (e.g. `octocat/Hello-World, octocat/Spoon-Knife`). Leave empty to watch mentions across all repositories."
                }
            },
            "groups": {
                "config": {
                    "label": "Configuration",
                    "index": 1
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "ID",
                        "example": 1234567890
                    },
                    "reason": {
                        "type": "string",
                        "title": "Reason",
                        "example": "mention"
                    },
                    "subject": {
                        "type": "object",
                        "title": "Subject",
                        "properties": {
                            "title": {
                                "type": "string",
                                "title": "Subject.Title",
                                "example": "Found a bug"
                            },
                            "url": {
                                "type": "string",
                                "title": "Subject.URL",
                                "example": "https://api.github.com/repos/octocat/Hello-World/issues/1"
                            },
                            "type": {
                                "type": "string",
                                "title": "Subject.Type",
                                "example": "Issue"
                            },
                            "latest_comment_url": {
                                "type": "string",
                                "title": "Subject.Latest Comment URL",
                                "example": "https://api.github.com/repos/octocat/Hello-World/issues/comments/1"
                            }
                        }
                    },
                    "repository": {
                        "type": "object",
                        "title": "Repository",
                        "properties": {
                            "full_name": {
                                "type": "string",
                                "title": "Repository.Full Name",
                                "example": "octocat/Hello-World"
                            },
                            "id": {
                                "type": "integer",
                                "title": "Repository.ID",
                                "example": 1296269
                            },
                            "html_url": {
                                "type": "string",
                                "title": "Repository.HTML URL",
                                "example": "https://github.com/octocat/Hello-World"
                            }
                        }
                    },
                    "url": {
                        "type": "string",
                        "title": "URL",
                        "example": "https://api.github.com/repos/octocat/Hello-World/issues/1"
                    },
                    "updated_at": {
                        "type": "string",
                        "title": "Updated At",
                        "example": "2024-01-15T10:30:00Z"
                    },
                    "unread": {
                        "type": "boolean",
                        "title": "Unread",
                        "example": true
                    }
                }
            }
        }
    ]
}
