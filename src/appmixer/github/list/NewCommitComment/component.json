{
    "name": "appmixer.github.list.NewCommitComment",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Triggered when a new comment on a commit is created.",
    "private": false,
    "tick": true,
    "auth": {
        "service": "appmixer:github",
        "scope": [
            "user",
            "public_repo",
            "repo",
            "notifications",
            "gist"
        ]
    },
    "quota": {
        "manager": "appmixer:github",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "outPorts": [
        {
            "name": "comment",
            "options": [
                {
                    "label": "HTML URL",
                    "value": "html_url",
                    "schema": {
                        "type": "string",
                        "example": "https://github.com/octocat/Hello-World/issues/1"
                    }
                },
                {
                    "label": "Body",
                    "value": "body",
                    "schema": {
                        "type": "string",
                        "example": "I'm having a problem with this."
                    }
                },
                {
                    "label": "Commit ID",
                    "value": "commit_id",
                    "schema": {
                        "type": "string",
                        "example": "6dcb09b5b57875f334f61aebed695e2e4193db5e"
                    }
                },
                {
                    "label": "User Login",
                    "value": "user.login",
                    "schema": {
                        "type": "string",
                        "example": "octocat"
                    }
                },
                {
                    "label": "User ID",
                    "value": "user.id",
                    "schema": {
                        "type": "integer",
                        "example": 583231
                    }
                }
            ]
        }
    ],
    "properties": {
        "schema": {
            "properties": {
                "repositoryId": {
                    "type": "string",
                    "pattern": "[^/]+[/][^/]+"
                }
            },
            "required": [
                "repositoryId"
            ]
        },
        "inspector": {
            "inputs": {
                "repositoryId": {
                    "type": "text",
                    "group": "config",
                    "label": "Repository",
                    "index": 1,
                    "tooltip": "Enter the repository in `owner/repo` format (e.g. `octocat/Hello-World`). You can also pick from the dynamically loaded list of your repositories.",
                    "source": {
                        "url": "/component/appmixer/github/list/ListRepos?outPort=repositories",
                        "data": {
                            "transform": "./transformers#reposToSelectArray"
                        }
                    }
                }
            },
            "groups": {
                "config": {
                    "label": "Configuration",
                    "index": 1
                }
            }
        }
    }
}
