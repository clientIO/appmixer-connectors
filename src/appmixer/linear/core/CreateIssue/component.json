{
    "name": "appmixer.linear.core.CreateIssue",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Creates a new issue.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:linear"
    },
    "quota": {
        "manager": "appmixer:linear",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "teamId": {
                        "type": "string"
                    }
                },
                "required": [
                    "title",
                    "teamId"
                ]
            },
            "inspector": {
                "inputs": {
                    "title": {
                        "type": "text",
                        "tooltip": "The title of the issue",
                        "label": "Title",
                        "index": 0
                    },
                    "description": {
                        "type": "text",
                        "tooltip": "A detailed description of the issue",
                        "label": "Description",
                        "index": 1
                    },
                    "teamId": {
                        "type": "text",
                        "tooltip": "The ID of the team under which the issue is created",
                        "label": "Team Id",
                        "index": 2
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "f5c7a3d2-1b4e-4a9f-8c6d-3e2f1a0b5c4d"
                    }
                },
                {
                    "label": "Title",
                    "value": "title",
                    "schema": {
                        "type": "string",
                        "example": "Fix authentication timeout"
                    }
                },
                {
                    "label": "Description",
                    "value": "description",
                    "schema": {
                        "type": "string",
                        "example": "Users are logged out after 5 minutes of inactivity instead of the configured 30."
                    }
                },
                {
                    "label": "Url",
                    "value": "url",
                    "schema": {
                        "type": "string",
                        "example": "https://linear.app/acme/issue/ENG-123/fix-authentication-timeout"
                    }
                },
                {
                    "label": "Created At",
                    "value": "createdAt",
                    "schema": {
                        "type": "string",
                        "example": "2024-03-11T09:15:00.000Z"
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updatedAt",
                    "schema": {
                        "type": "string",
                        "example": "2024-03-12T14:25:30.000Z"
                    }
                },
                {
                    "label": "State",
                    "value": "state",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "State.Id"
                            },
                            "name": {
                                "type": "string",
                                "title": "State.Name"
                            },
                            "color": {
                                "type": "string",
                                "title": "State.Color"
                            }
                        },
                        "example": {
                            "id": "c4d5e6f7-8a9b-0c1d-2e3f-4a5b6c7d8e9f",
                            "name": "In Progress",
                            "color": "#f2c94c"
                        }
                    }
                },
                {
                    "label": "Assignee",
                    "value": "assignee",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Assignee.Id"
                            },
                            "name": {
                                "type": "string",
                                "title": "Assignee.Name"
                            },
                            "email": {
                                "type": "string",
                                "title": "Assignee.Email"
                            }
                        },
                        "example": {
                            "id": "b2c3d4e5-6f7a-8b9c-0d1e-2f3a4b5c6d7e",
                            "name": "Marcus Rodriguez",
                            "email": "marcus.rodriguez@example.com"
                        }
                    }
                },
                {
                    "label": "Creator",
                    "value": "creator",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Creator.Id"
                            },
                            "name": {
                                "type": "string",
                                "title": "Creator.Name"
                            },
                            "email": {
                                "type": "string",
                                "title": "Creator.Email"
                            }
                        },
                        "example": {
                            "id": "a1b2c3d4-5e6f-7a8b-9c0d-e1f2a3b4c5d6",
                            "name": "Sarah Chen",
                            "email": "sarah.chen@example.com"
                        }
                    }
                },
                {
                    "label": "Team",
                    "value": "team",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Team.Id"
                            },
                            "name": {
                                "type": "string",
                                "title": "Team.Name"
                            },
                            "key": {
                                "type": "string",
                                "title": "Team.Key"
                            }
                        },
                        "example": {
                            "id": "d5e6f7a8-9b0c-1d2e-3f4a-5b6c7d8e9f0a",
                            "name": "Engineering",
                            "key": "ENG"
                        }
                    }
                },
                {
                    "label": "Labels",
                    "value": "labels",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "nodes": {
                                "type": "array",
                                "items": {},
                                "title": "Labels.Nodes"
                            }
                        },
                        "example": {
                            "nodes": [
                                { "id": "e6f7a8b9-0c1d-2e3f-4a5b-6c7d8e9f0a1b", "name": "Bug" },
                                { "id": "f7a8b9c0-1d2e-3f4a-5b6c-7d8e9f0a1b2c", "name": "High Priority" }
                            ]
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}