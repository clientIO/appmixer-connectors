{
    "name": "appmixer.dropbox.files.CreateTextFile",
    "author": "Pawel Putko <pputko@ntrc.eu>",
    "description": "This action creates new text file.",
    "private": false,
    "auth": {
        "service": "appmixer:dropbox"
    },
    "inPorts": [
        {
            "name": "file",
            "schema": {
                "type": "object",
                "properties": {
                    "path": {
                        "type": "string",
                        "pattern": "(/(.|[\\r\\n])*)|(ns:[0-9]+(/.*)?)|(id:.*)"
                    },
                    "autorename": {
                        "type": "boolean"
                    },
                    "text": {
                        "type": "string"
                    }
                },
                "required": [
                    "path"
                ]
            },
            "inspector": {
                "inputs": {
                    "path": {
                        "type": "text",
                        "group": "transformation",
                        "index": 1,
                        "label": "Path",
                        "attrs": {
                            "label": {
                                "data-tooltip": "Type path to the new file. Ex. /Homework/math/Matrices.txt"
                            }
                        }
                    },
                    "autorename": {
                        "type": "select",
                        "options": [
                            {
                                "value": true,
                                "content": "Yes"
                            },
                            {
                                "value": false,
                                "content": "No"
                            }
                        ],
                        "group": "transformation",
                        "attrs": {
                            "label": {
                                "data-tooltip": "If there's a conflict, have the Dropbox server try to rename folder to avoid conflict?"
                            }
                        },
                        "label": "Auto rename",
                        "index": 2
                    },
                    "text": {
                        "type": "textarea",
                        "group": "transformation",
                        "attrs": {
                            "label": {
                                "data-tooltip": "Type text you want to save in file."
                            }
                        },
                        "label": "Text",
                        "index": 3
                    }
                },
                "groups": {
                    "transformation": {
                        "label": "Transformation",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "newTextFile",
            "options": [
                {
                    "label": "client_modified",
                    "value": "client_modified",
                    "example": "2024-07-15T12:30:00Z",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00Z"
                    }
                },
                {
                    "label": "content_hash",
                    "value": "content_hash",
                    "example": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
                    "schema": {
                        "type": "string",
                        "example": "599d71033d700ac892a0e48fa61b46d2811f0dcd6ae3f1fb6c6f35ad8cd63d4d"
                    }
                },
                {
                    "label": "id",
                    "value": "id",
                    "example": "id:abc123def456",
                    "schema": {
                        "type": "string",
                        "example": "id:a4ayc_80_OEAAAAAAAAAYa"
                    }
                },
                {
                    "label": "name",
                    "value": "name",
                    "example": "report.pdf",
                    "schema": {
                        "type": "string",
                        "example": "notes.txt"
                    }
                },
                {
                    "label": "path_display",
                    "value": "path_display",
                    "example": "/Documents/report.pdf",
                    "schema": {
                        "type": "string",
                        "example": "/Reports/notes.txt"
                    }
                },
                {
                    "label": "path_lower",
                    "value": "path_lower",
                    "example": "/documents/report.pdf",
                    "schema": {
                        "type": "string",
                        "example": "/reports/notes.txt"
                    }
                },
                {
                    "label": "rev",
                    "value": "rev",
                    "example": "015f2e5d4a1c70000000109d2de60",
                    "schema": {
                        "type": "string",
                        "example": "a1c10ce0dd78"
                    }
                },
                {
                    "label": "server_modified",
                    "value": "server_modified",
                    "example": "2024-07-15T12:35:00Z",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:01Z"
                    }
                },
                {
                    "label": "size",
                    "value": "size",
                    "example": 524288,
                    "schema": {
                        "type": "integer",
                        "example": 1024
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
