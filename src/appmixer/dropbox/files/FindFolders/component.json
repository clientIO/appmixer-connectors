{
    "name": "appmixer.dropbox.files.FindFolders",
    "author": "Pawel Putko <pputko@ntrc.eu>",
    "description": "This action finds folder.",
    "private": false,
    "auth": {
        "service": "appmixer:dropbox"
    },
    "inPorts": [
        {
            "name": "query",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "maxResults": {
                        "type": "number"
                    },
                    "mode": {
                        "type": "string"
                    }
                },
                "required": [
                    "name"
                ]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "group": "transformation",
                        "index": 1,
                        "label": "Find by name",
                        "attrs": {
                            "label": {
                                "data-tooltip": "Type name to find folder."
                            }
                        }
                    },
                    "maxResults": {
                        "type": "number",
                        "group": "transformation",
                        "index": 2,
                        "label": "Max results",
                        "attrs": {
                            "label": {
                                "data-tooltip": "Type max results you want in return."
                            }
                        }
                    },
                    "mode": {
                        "type": "select",
                        "options": [
                            {
                                "value": "filename",
                                "content": "Filename"
                            },
                            {
                                "value": "deleted_filename",
                                "content": "Deleted filename"
                            }
                        ],
                        "group": "transformation",
                        "attrs": {
                            "label": {
                                "data-tooltip": "Search mode."
                            }
                        },
                        "label": "Search mode",
                        "index": 3
                    }
                },
                "groups": {
                    "transformation": {
                        "label": "Transformation",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "folder",
            "options": [
                {
                    "label": "'.tag'",
                    "value": "'.tag'",
                    "example": "folder",
                    "schema": {
                        "type": "string",
                        "example": "folder"
                    }
                },
                {
                    "label": "id",
                    "value": "id",
                    "example": "id:abc123def456",
                    "schema": {
                        "type": "string",
                        "example": "id:a4ayc_80_OEAAAAAAAAAXz"
                    }
                },
                {
                    "label": "name",
                    "value": "name",
                    "example": "My Folder",
                    "schema": {
                        "type": "string",
                        "example": "math"
                    }
                },
                {
                    "label": "path_display",
                    "value": "path_display",
                    "example": "/Documents/My Folder",
                    "schema": {
                        "type": "string",
                        "example": "/Homework/math"
                    }
                },
                {
                    "label": "path_lower",
                    "value": "path_lower",
                    "example": "/documents/my folder",
                    "schema": {
                        "type": "string",
                        "example": "/homework/math"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
