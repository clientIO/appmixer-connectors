{
    "name": "appmixer.dropbox.files.RenameFile",
    "author": "Harsha Surisetty <harsha@client.io>",
    "description": "This action renames a file.",
    "private": false,
    "auth": {
        "service": "appmixer:dropbox"
    },
    "inPorts": [
        {
            "name": "file",
            "schema": {
                "type": "object",
                "properties": {
                    "path": {
                        "type": "string",
                        "pattern": "(/(.|[\\r\\n])*)|(ns:[0-9]+(/.*)?)|(id:.*)"
                    },
                    "newName": {
                        "type": "string"
                    }
                },
                "required": [
                    "path",
                    "newName"
                ]
            },
            "inspector": {
                "inputs": {
                    "path": {
                        "type": "text",
                        "group": "transformation",
                        "index": 1,
                        "label": "Path",
                        "attrs": {
                            "label": {
                                "data-tooltip": "Type the path to the file you want to rename. Ex. /Documents/old_file.txt"
                            }
                        }
                    },
                    "newName": {
                        "type": "text",
                        "group": "transformation",
                        "index": 2,
                        "label": "New Name",
                        "attrs": {
                            "label": {
                                "data-tooltip": "Type the new name for the file."
                            }
                        }
                    }
                },
                "groups": {
                    "transformation": {
                        "label": "Transformation",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "client_modified",
                    "value": "client_modified",
                    "example": "2024-07-15T12:30:00Z",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00Z"
                    }
                },
                {
                    "label": "content_hash",
                    "value": "content_hash",
                    "example": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
                    "schema": {
                        "type": "string",
                        "example": "599d71033d700ac892a0e48fa61b46d2811f0dcd6ae3f1fb6c6f35ad8cd63d4d"
                    }
                },
                {
                    "label": "id",
                    "value": "id",
                    "example": "id:abc123def456",
                    "schema": {
                        "type": "string",
                        "example": "id:a4ayc_80_OEAAAAAAAAAYa"
                    }
                },
                {
                    "label": "name",
                    "value": "name",
                    "example": "report.pdf",
                    "schema": {
                        "type": "string",
                        "example": "Q3 report final.pdf"
                    }
                },
                {
                    "label": "path_display",
                    "value": "path_display",
                    "example": "/Documents/report.pdf",
                    "schema": {
                        "type": "string",
                        "example": "/Reports/Q3 report final.pdf"
                    }
                },
                {
                    "label": "path_lower",
                    "value": "path_lower",
                    "example": "/documents/report.pdf",
                    "schema": {
                        "type": "string",
                        "example": "/reports/q3 report final.pdf"
                    }
                },
                {
                    "label": "rev",
                    "value": "rev",
                    "example": "015f2e5d4a1c70000000109d2de60",
                    "schema": {
                        "type": "string",
                        "example": "a1c10ce0dd79"
                    }
                },
                {
                    "label": "server_modified",
                    "value": "server_modified",
                    "example": "2024-07-15T12:35:00Z",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-11T10:05:00Z"
                    }
                },
                {
                    "label": "size",
                    "value": "size",
                    "example": 524288,
                    "schema": {
                        "type": "integer",
                        "example": 482133
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
