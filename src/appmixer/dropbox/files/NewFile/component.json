{
    "name": "appmixer.dropbox.files.NewFile",
    "author": "Pawel Putko <pputko@ntrc.eu>",
    "description": "This trigger fires every time a new file is added.",
    "private": false,
    "auth": {
        "service": "appmixer:dropbox"
    },
    "tick": true,
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "path": {
                    "type": "string"
                },
                "recursive": {
                    "type": "boolean"
                }
            }
        },
        "inspector": {
            "inputs": {
                "path": {
                    "type": "text",
                    "label": "Path",
                    "tooltip": "Enter a specific folder to monitor for new files. Example: <code>/Photos</code>.",
                    "index": 1
                },
                "recursive": {
                    "type": "toggle",
                    "label": "Recursive",
                    "defaultValue": false,
                    "tooltip": "Set to monitor the specified folder and all its subfolders for new files. By default, monitoring is not recursive. Note that the maximum number of files that can be monitored is 2000.",
                    "index": 2
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "newFile",
            "options": [
                {
                    "label": ".tag",
                    "value": ".tag",
                    "example": "file",
                    "schema": {
                        "type": "string",
                        "example": "file"
                    }
                },
                {
                    "label": "client_modified",
                    "value": "client_modified",
                    "example": "2024-07-15T12:30:00Z",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:25:00Z"
                    }
                },
                {
                    "label": "content_hash",
                    "value": "content_hash",
                    "example": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
                    "schema": {
                        "type": "string",
                        "example": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
                    }
                },
                {
                    "label": "id",
                    "value": "id",
                    "example": "id:abc123def456",
                    "schema": {
                        "type": "string",
                        "example": "id:a4ayc_80_OEAAAAAAAAAXw"
                    }
                },
                {
                    "label": "name",
                    "value": "name",
                    "example": "report.pdf",
                    "schema": {
                        "type": "string",
                        "example": "Prime_Numbers.txt"
                    }
                },
                {
                    "label": "path_display",
                    "value": "path_display",
                    "example": "/Documents/report.pdf",
                    "schema": {
                        "type": "string",
                        "example": "/Homework/math/Prime_Numbers.txt"
                    }
                },
                {
                    "label": "path_lower",
                    "value": "path_lower",
                    "example": "/documents/report.pdf",
                    "schema": {
                        "type": "string",
                        "example": "/homework/math/prime_numbers.txt"
                    }
                },
                {
                    "label": "rev",
                    "value": "rev",
                    "example": "015f2e5d4a1c70000000109d2de60",
                    "schema": {
                        "type": "string",
                        "example": "a1c10ce0dd78"
                    }
                },
                {
                    "label": "server_modified",
                    "value": "server_modified",
                    "example": "2024-07-15T12:35:00Z",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00Z"
                    }
                },
                {
                    "label": "size",
                    "value": "size",
                    "example": 524288,
                    "schema": {
                        "type": "integer",
                        "example": 7212
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
