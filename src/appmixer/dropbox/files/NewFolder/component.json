{
    "name": "appmixer.dropbox.files.NewFolder",
    "author": "Pawel Putko <pputko@ntrc.eu>",
    "description": "This trigger fires every time a new folder is added.",
    "private": false,
    "auth": {
        "service": "appmixer:dropbox"
    },
    "tick": true,
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "path": {
                    "type": "string"
                },
                "recursive": {
                    "type": "boolean"
                }
            }
        },
        "inspector": {
            "inputs": {
                "path": {
                    "type": "text",
                    "label": "Path",
                    "tooltip": "Enter a specific folder to monitor for new folders. Example: <code>/Photos</code>.",
                    "index": 1
                },
                "recursive": {
                    "type": "toggle",
                    "label": "Recursive",
                    "defaultValue": false,
                    "tooltip": "Set to monitor the specified folder and all its subfolders for new folders. By default, monitoring is not recursive. Note that the maximum number of folders that can be monitored is 2000.",
                    "index": 2
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "newFolder",
            "options": [
                {
                    "label": ".tag",
                    "value": ".tag",
                    "example": "folder",
                    "schema": {
                        "type": "string",
                        "example": "folder"
                    }
                },
                {
                    "label": "id",
                    "value": "id",
                    "example": "id:abc123def456",
                    "schema": {
                        "type": "string",
                        "example": "id:a4ayc_80_OEAAAAAAAAAXz"
                    }
                },
                {
                    "label": "name",
                    "value": "name",
                    "example": "My Folder",
                    "schema": {
                        "type": "string",
                        "example": "math"
                    }
                },
                {
                    "label": "path_display",
                    "value": "path_display",
                    "example": "/Documents/My Folder",
                    "schema": {
                        "type": "string",
                        "example": "/Homework/math"
                    }
                },
                {
                    "label": "path_lower",
                    "value": "path_lower",
                    "example": "/documents/my folder",
                    "schema": {
                        "type": "string",
                        "example": "/homework/math"
                    }
                },
                {
                    "label": "shared_folder_id",
                    "value": "shared_folder_id",
                    "example": "84528192421",
                    "schema": {
                        "type": "string",
                        "example": "84528192421"
                    }
                },
                {
                    "label": "sharing_info['read_only']",
                    "value": "sharing_info['read_only']",
                    "example": false,
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "sharing_info['shared_folder_id']",
                    "value": "sharing_info['shared_folder_id']",
                    "example": "84528192421",
                    "schema": {
                        "type": "string",
                        "example": "84528192421"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
