{
    "name": "appmixer.dropbox.files.DownloadFile",
    "author": "Jimoh Damilola <jimoh@client.io>",
    "description": "Download file from dropbox.",
    "private": false,
    "version": "1.1.1",
    "auth": {
        "service": "appmixer:dropbox"
    },
    "inPorts": [
        {
            "name": "file",
            "schema": {
                "type": "object",
                "properties": {
                    "fileId": {
                        "type": "string"
                    }
                },
                "required": [
                    "fileId"
                ]
            },
            "inspector": {
                "inputs": {
                    "fileId": {
                        "type": "text",
                        "index": 1,
                        "label": "Dropbox File ID",
                        "tooltip": "The id of the file that you want to download. To get the Dropbox File Id, use the FindFiles component and connect it to this component."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "downloaded",
            "options": [
                {
                    "label": "File ID",
                    "value": "fileId",
                    "example": "id:abc123def456",
                    "schema": {
                        "type": "string",
                        "example": "c3a1b7e2-5d4f-4e8a-9b6c-1f2e3d4c5b6a"
                    }
                },
                {
                    "label": "File Name",
                    "value": "filename",
                    "example": "report.pdf",
                    "schema": {
                        "type": "string",
                        "example": "Q3 report.pdf"
                    }
                },
                {
                    "label": "Chunk Size",
                    "value": "chunkSize",
                    "example": 8388608,
                    "schema": {
                        "type": "integer",
                        "example": 261120
                    }
                },
                {
                    "label": "File Length",
                    "value": "length",
                    "example": 524288,
                    "schema": {
                        "type": "integer",
                        "example": 482133
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
