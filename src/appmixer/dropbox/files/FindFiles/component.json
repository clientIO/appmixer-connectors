{
    "name": "appmixer.dropbox.files.FindFiles",
    "author": "Pawel Putko <pputko@ntrc.eu>",
    "description": "This action finds file.",
    "private": false,
    "auth": {
        "service": "appmixer:dropbox"
    },
    "inPorts": [
        {
            "name": "query",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "maxResults": {
                        "type": "number"
                    },
                    "path": {
                        "type": "string",
                        "pattern": "(/(.|[\\r\\n])*)?|id:.*|(ns:[0-9]+(/.*)?)"
                    },
                    "mode": {
                        "type": "string"
                    }
                },
                "required": [
                    "name"
                ]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "group": "transformation",
                        "index": 1,
                        "label": "Find by name",
                        "attrs": {
                            "label": {
                                "data-tooltip": "The string to search for. The search string is split on spaces into multiple tokens. For file name searching, the last token is used for prefix matching (i.e. \"bat c\" matches \"bat cave\" but not \"batman car\")."
                            }
                        }
                    },
                    "maxResults": {
                        "type": "number",
                        "group": "transformation",
                        "index": 2,
                        "label": "Max results",
                        "attrs": {
                            "label": {
                                "data-tooltip": "Type how much results do you want in return."
                            }
                        }
                    },
                    "path": {
                        "type": "text",
                        "group": "transformation",
                        "index": 3,
                        "label": "Find in path",
                        "attrs": {
                            "label": {
                                "data-tooltip": "Type path where file should be found."
                            }
                        }
                    },
                    "mode": {
                        "type": "select",
                        "options": [
                            {
                                "value": "filename",
                                "content": "Filename"
                            },
                            {
                                "value": "deleted_filename",
                                "content": "Deleted filename"
                            }
                        ],
                        "group": "transformation",
                        "attrs": {
                            "label": {
                                "data-tooltip": "Search mode."
                            }
                        },
                        "label": "Search mode",
                        "index": 4
                    }
                },
                "groups": {
                    "transformation": {
                        "label": "Transformation",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "file",
            "options": [
                {
                    "label": "'.tag'",
                    "value": "'.tag'",
                    "example": "file",
                    "schema": {
                        "type": "string",
                        "example": "file"
                    }
                },
                {
                    "label": "client_modified",
                    "value": "client_modified",
                    "example": "2024-07-15T12:30:00Z",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00Z"
                    }
                },
                {
                    "label": "content_hash",
                    "value": "content_hash",
                    "example": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
                    "schema": {
                        "type": "string",
                        "example": "599d71033d700ac892a0e48fa61b46d2811f0dcd6ae3f1fb6c6f35ad8cd63d4d"
                    }
                },
                {
                    "label": "id",
                    "value": "id",
                    "example": "id:abc123def456",
                    "schema": {
                        "type": "string",
                        "example": "id:a4ayc_80_OEAAAAAAAAAYa"
                    }
                },
                {
                    "label": "name",
                    "value": "name",
                    "example": "report.pdf",
                    "schema": {
                        "type": "string",
                        "example": "Q3 report.pdf"
                    }
                },
                {
                    "label": "path_display",
                    "value": "path_display",
                    "example": "/Documents/report.pdf",
                    "schema": {
                        "type": "string",
                        "example": "/Reports/Q3 report.pdf"
                    }
                },
                {
                    "label": "path_lower",
                    "value": "path_lower",
                    "example": "/documents/report.pdf",
                    "schema": {
                        "type": "string",
                        "example": "/reports/q3 report.pdf"
                    }
                },
                {
                    "label": "rev",
                    "value": "rev",
                    "example": "015f2e5d4a1c70000000109d2de60",
                    "schema": {
                        "type": "string",
                        "example": "a1c10ce0dd78"
                    }
                },
                {
                    "label": "server_modified",
                    "value": "server_modified",
                    "example": "2024-07-15T12:35:00Z",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:01Z"
                    }
                },
                {
                    "label": "size",
                    "value": "size",
                    "example": 524288,
                    "schema": {
                        "type": "integer",
                        "example": 482133
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
