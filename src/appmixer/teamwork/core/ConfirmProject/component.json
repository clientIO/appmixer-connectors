{
	"name": "appmixer.teamwork.core.ConfirmProject",
	"auth": {
		"service": "appmixer:teamwork"
	},
	"author": "hugh.marron@teamwork.com",
	"description": "Confirms a tenative Project in Teamwork.com",
	"private": false,
	"version": "1.0.0",
	"inPorts": [
		{
			"name": "in",
			"schema": {
				"type": "object",
				"properties": {
					"projectId": { "type": "integer" }
				},
				"required": [ "projectId" ]
			},
			"inspector": {
				"inputs": {
					"projectId": {
						"index": 0,
						"type": "select",
						"label": "Project",
						"source": {
							"url": "/component/appmixer/teamwork/core/ListProjects?outPort=projects",
							"data": {
								"transform": "ListProjects#toInspector"
							}
						}
					}
				}
			}
		}
	],
	"outPorts": [
		{
			"name": "project",
			"options":[
				{
					"label": "Id",
					"value": "id"
				}
			]
		}
	],

	"icon": "data:image/svg+xml;base64,"
}
