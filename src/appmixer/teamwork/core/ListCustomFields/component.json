{
	"name": "appmixer.teamwork.core.ListCustomFields",
	"auth": {
		"service": "appmixer:teamwork"
	},
	"author": "hugh.marron@teamwork.com",
	"description": "List custom fields in Teamwork.com",
	"private": false,
	"version": "1.0.0",
	"properties": {
		"schema": {
			"type": "object",
			"properties": {
				"customFieldId": { "type": "string", "title": "Custom Field" }
			}
		},
		"inspector": {
			"inputs": {}
		}
	},
	"inPorts": [
		{
			"name": "in",
			"schema": {
				"type": "object",
				"properties": {
					"searchTerm": { "type": "string" },
					"entity": { "type": "string" },
					"onlyTextAndNumber": { "type": "boolean" }
				},
				"required": ["entity"]
			},
			"inspector": {
				"inputs": {
					"searchTerm": {
						"index": 0,
						"type": "text",
						"label": "Search Term"
					},
					"entity":{
						"index": 1,
						"type": "select",
						"label": "Entity",
						"options": [
							{"content": "Project", "value": "project"},
							{"content": "Company", "value": "company"},
							{"content": "Task", "value": "task"}
						]

					}
				}
			}
		}
	],
	"outPorts": [
		{
			"name": "customfields",
			"options": [
				{
					"label": "Custom Fields",
					"value": "customfields",
					"schema": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"id": { "type": "number", "title": "ID" },
								"name": { "type": "string", "title": "Name" },
								"entity": { "type": "string", "title": "Entity" },
								"description": { "type": "string", "title": "Description" },
								"type": { "type": "string", "title": "Description" }
							}
						}
					}
				}
			]
		},
		{
			"name": "options",
			"options": [
				{
					"label": "Options",
					"value": "options",
					"schema": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"content": { "type": "string" },
								"value": { "type": "string" }
							}
						}
					}
				}
			]
		}
	],
	"icon": "data:image/svg+xml;base64,"
}
