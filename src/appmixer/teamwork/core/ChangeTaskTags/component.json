{
    "name": "appmixer.teamwork.core.ChangeTaskTags",
    "auth": {
        "service": "appmixer:teamwork"
    },
    "author": "sinead.cullinane@teamwork.com",
    "description": "Change the tags of a task in Teamwork.com",
    "private": false,
    "version": "1.0.0",
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "taskId": {
                        "type": "integer"
                    },
                    "operation": {
                        "type": "string",
                        "enum": [
                            "add",
                            "remove",
                            "replace",
                            "removeAllTags"
                        ]
                    },
                    "tagIds": {
                        "type": "array"
                    }
                },
                "required": [
                    "taskId",
                    "operation"
                ]
            },
            "inspector": {
                "inputs": {
                    "taskId": {
                        "index": 0,
                        "type": "number",
                        "label": "Task ID"
                    },
                    "operation": {
                        "index": 1,
                        "type": "select",
                        "label": "Operation",
                        "options": [
                            {
                                "content": "Add",
                                "value": "add"
                            },
                            {
                                "content": "Remove",
                                "value": "remove"
                            },
                            {
                                "content": "Replace",
                                "value": "replace"
                            },
                            {
                                "content": "Remove All Tags",
                                "value": "removeAllTags"
                            }
                        ],
                        "defaultValue": "add"
                    },
                    "tagIds": {
                        "when": {
                            "in": {
                                "operation": [
                                    "add",
                                    "replace",
                                    "remove"
                                ]
                            }
                        },
                        "index": 2,
                        "type": "multiselect",
                        "source": {
                            "url": "/component/appmixer/teamwork/core/ListTags?outPort=tags",
                            "data": {
                                "transform": "ListTags#toInspector"
                            }
                        },
                        "label": "Tags"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "tags",
            "options": [
                {
                    "label": "Task ID",
                    "value": "taskId"
                },
                {
                    "label": "Tags",
                    "value": "tags"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
