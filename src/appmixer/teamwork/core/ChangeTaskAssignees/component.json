{
    "name": "appmixer.teamwork.core.ChangeTaskAssignees",
    "auth": {
        "service": "appmixer:teamwork"
    },
    "author": "sinead.cullinane@teamwork.com",
    "description": "Change the assignees of a task in Teamwork.com",
    "private": false,
    "version": "1.0.0",
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "taskId": {
                        "type": "integer"
                    },
                    "operation": {
                        "type": "string",
                        "enum": [
                            "add",
                            "remove",
                            "reassign",
                            "removeAllAssignees"
                        ]
                    },
                    "selectedType": {
                        "type": "string",
                        "enum": [
                            "selected",
                            "project-owner",
                            "task-creator"
                        ]
                    },
                    "userIds": {
                        "type": "array"
                    },
                    "teamIds": {
                        "type": "array"
                    },
                    "companyIds": {
                        "type": "array"
                    }
                },
                "required": [
                    "taskId",
                    "operation"
                ]
            },
            "inspector": {
                "inputs": {
                    "taskId": {
                        "index": 0,
                        "type": "number",
                        "label": "Task ID"
                    },
                    "operation": {
                        "index": 1,
                        "type": "select",
                        "label": "Operation",
                        "options": [
                            {
                                "content": "Add",
                                "value": "add"
                            },
                            {
                                "content": "Remove",
                                "value": "remove"
                            },
                            {
                                "content": "Reassign",
                                "value": "reassign"
                            },
                            {
                                "content": "Remove All Assignees",
                                "value": "removeAllAssignees"
                            }
                        ],
                        "defaultValue": "add"
                    },
                    "selectedType": {
                        "when": {
                            "in": {
                                "operation": [
                                    "add",
                                    "reassign",
                                    "remove"
                                ]
                            }
                        },
                        "index": 2,
                        "type": "select",
                        "label": "Selected Type",
                        "options": [
                            {
                                "content": "Select People",
                                "value": "selected"
                            },
                            {
                                "content": "Task Creator",
                                "value": "task-creator"
                            }
                        ],
                        "defaultValue": "selected"
                    },
                    "userIds": {
                        "when": {
                            "eq": {
                                "selectedType": "selected"
                            }
                        },
                        "index": 3,
                        "type": "multiselect",
                        "source": {
                            "url": "/component/appmixer/teamwork/core/ListPeople?outPort=people",
                            "data": {
                                "transform": "ListPeople#toInspector"
                            }
                        },
                        "label": "Users"
                    },
                    "teamIds": {
                        "when": {
                            "eq": {
                                "selectedType": "selected"
                            }
                        },
                        "index": 4,
                        "type": "multiselect",
                        "source": {
                            "url": "/component/appmixer/teamwork/core/ListTeams?outPort=teams",
                            "data": {
                                "transform": "ListTeams#toInspector"
                            }
                        },
                        "label": "Teams"
                    },
                    "companyIds": {
                        "when": {
                            "eq": {
                                "selectedType": "selected"
                            }
                        },
                        "index": 5,
                        "type": "multiselect",
                        "source": {
                            "url": "/component/appmixer/teamwork/core/ListCompanies?outPort=companies",
                            "data": {
                                "transform": "ListCompanies#toInspector"
                            }
                        },
                        "label": "Companies"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "assignees",
            "options": [
                {
                    "label": "Task ID",
                    "value": "taskId"
                },
                {
                    "label": "Assignees",
                    "value": "assignees"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
