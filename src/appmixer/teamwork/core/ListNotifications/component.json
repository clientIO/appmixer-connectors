{
	"name": "appmixer.teamwork.core.ListNotifications",
	"auth": {
		"service": "appmixer:teamwork"
	},
	"author": "hugh.marron@teamwork.com",
	"description": "List notifications in Teamwork.com",
	"private": false,
	"version": "1.0.0",
	"inPorts": [
		{
			"name": "in",
			"schema": {
				"type": "object",
				"properties": {
					"daysAgo": { "type": "integer" },
					"orderMode": { "type": "string" },
					"limit": { "type": "integer" },
					"unreadOnly": { "type": "boolean" },
					"notifiedOnly": { "type": "boolean" },
					"fromUsers": { "type": "array" }
				},
				"required": [ "daysAgo" ]
			},
			"inspector": {
				"inputs": {
					"daysAgo": {
						"index": 0,
						"type": "number",
						"label": "Days Ago",
						"defaultValue": 1
					},
					"orderMode": {
						"index": 1,
						"type": "select",
						"label": "Order Mode",
						"options": [
							{ "content": "Ascending", "value": "asc" },
							{ "content": "Descending", "value": "desc" }
						]
					},
					"limit": {
						"index": 2,
						"type": "number",
						"label": "Limit"
					},
					"unreadOnly": {
						"index": 3,
						"type": "toggle",
						"defaultValue": false,
						"label": "Unread Only"
					},
					"notifiedOnly": {
						"index": 4,
						"type": "toggle",
						"defaultValue": false,
						"label": "Notified Only"
					},
					"fromUsers": {
						"index": 5,
						"type": "multiselect",
						"label": "From Users",
						"min": 0,
						"source": {
							"url": "/component/appmixer/teamwork/core/ListPeople?outPort=people",
							"data": {
								"transform": "ListPeople#toInspector"
							}
						}
					}
				}
			}
		}
	],
	"outPorts": [
		{
			"name": "notifications",
			"options": [
				{
					"label": "Notification",
					"value": "notifications",
					"schema": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"id": { "type": "number", "title": "ID" },
								"description": { "type": "string", "title": "Description" },
								"link": { "type": "string", "title": "Link" },
								"event": { "type": "string", "title": "Event" },
								"extraInfo": { "type": "string", "title": "Extra Info" },
								"date": { "type": "string", "title": "Date" },
								"user": { 
									"title": "User",
									"type": "object", 
									"properties": {
										"id": { "type": "number", "title": "ID" },
										"firstName": { "type": "string", "title": "First Name" },
										"lastName": { "type": "string", "title": "Last Name" }
									}
								},
								"item": { 
									"title": "Item",
									"type": "object", 
									"properties": {
										"id": { "type": "number", "title": "ID" },
										"type": { "type": "string", "title": "Type" }
									}
								},
								"project": { 
									"title": "Project",
									"type": "object", 
									"properties": {
										"id": { "type": "number", "title": "ID" },
										"name": { "type": "string", "title": "Name" }
									}
								}
							}
						}
					}

				}
			]
		}
	],
	"icon": "data:image/svg+xml;base64,"
}
