{
	"name": "appmixer.teamwork.core.ListSubtasks",
	"auth": {
		"service": "appmixer:teamwork"
	},
	"author": "hugh.marron@teamwork.com",
	"description": "List subtasks on a given task in Teamwork.com",
	"private": false,
	"version": "1.0.0",
	"inPorts": [
		{
			"name": "in",
			"schema": {
				"type": "object",
				"properties": {
					"searchTerm": { "type": "string" },
					"startDate": { "type": "string" },
					"endDate": { "type": "string" },
					"priority": { "type": "string" },
					"orderMode": { "type": "string" },
					"orderBy": { "type": "string" },
					"page": { "type": "integer" },
					"pageSize": { "type": "integer" },
					"projectId": { "type": "string" },
					"projectIds": { "type": "array" },
					"tasklistId": { "type": "string" },
					"parentTaskId": { "type": "string" },
					"responsiblePartyIds": { "type": "array" },
					"createdByUserIds": { "type": "array" },
					"includeSubtasks": { "type": "boolean" },
					"tagIds": { "type": "array" },
                    			"customfields": { "type":  "object" }
				},
				"required": ["parentTaskId"]
			},
			"inspector": {
				"inputs": {
					"projectId": {
						"index": 0,
						"type": "select",
						"label": "Project",
						"source": {
							"url": "/component/appmixer/teamwork/core/ListProjects?outPort=projects",
							"data": {
								"transform": "ListProjects#toInspector"
							}
						}
					},
					"tasklistId": {
						"index": 1,
						"type": "select",
						"label": "Task List",
						"source": {
							"url": "/component/appmixer/teamwork/core/ListProjectTasklists?outPort=tasklists",
							"data": {
								"messages": {
									"in/projectId": "inputs/in/projectId"
								},
								"transform": "ListProjectTasklists#toInspector"
							}
						}			
					},
					"parentTaskId": {
						"index": 2,
						"type": "select",
						"label": "Parent Task",
						"source": {
							"url": "/component/appmixer/teamwork/core/ListTasksInList?outPort=tasks",
							"data": {
								"messages": {
									"in/tasklistId": "inputs/in/tasklistId"
								},
								"transform": "ListTasksInList#toInspector"
							}
						}					
					},
					"searchTerm": {
						"index": 3,
						"type": "text",
						"label": "Search Term"
					},
					"startDate": {
						"index": 4,
						"type": "date-time",
						"label": "Start Date",
						"config": {
							"format": "YYYY-MM-DD"
						}
					},
					"endDate": {
						"index": 5,
						"type": "date-time",
						"label": "End Date",
						"config": {
							"format": "YYYY-MM-DD"
						}
					},
					"priority": {
						"index": 6,
						"type": "select",
						"label": "Priority",
						"options": [
							{"content": "High", "value": "high"},
							{"content": "Medium", "value": "medium"},
							{"content": "Low", "value": "low"}
						]
					},
					"orderMode": {
						"index": 7,
						"type": "select",
						"label": "Order Mode",
						"options": [
							{"content": "Ascending", "value": "asc"},
							{"content": "Descending", "value": "desc"}
						]
					},
					"orderBy": {
						"index": 8,
						"type": "select",
						"label": "Order By",
						"options": [
							{"content": "Start Date", "value": "startdate"},
							{"content": "Created At", "value": "createdat"},
							{"content": "Priority", "value": "priority"},
							{"content": "Project", "value": "project"},
							{"content": "Flattened Task List", "value": "flattenedtasklist"},
							{"content": "Company", "value": "company"},
							{"content": "Manual", "value": "manual"},
							{"content": "Active", "value": "active"},
							{"content": "Completed At", "value": "completedat"},
							{"content": "Due Start Date", "value": "duestartdate"},
							{"content": "All Dates", "value": "alldates"},
							{"content": "Task List Name", "value": "tasklistname"},
							{"content": "Task List Display Order", "value": "tasklistdisplayorder"},
							{"content": "Task List ID", "value": "tasklistid"},
							{"content": "Due Date", "value": "duedate"},
							{"content": "Updated At", "value": "updatedat"},
							{"content": "Task Name", "value": "taskname"},
							{"content": "Created By", "value": "createdby"},
							{"content": "Completed By", "value": "completedby"},
							{"content": "Assigned To", "value": "assignedto"},
							{"content": "Task Status", "value": "taskstatus"},
							{"content": "Task Due Date", "value": "taskduedate"},
							{"content": "Custom Field", "value": "customfield"},
							{"content": "Estimated Time", "value": "estimatedtime"},
							{"content": "Board Column", "value": "boardcolumn"},
							{"content": "Task Group ID", "value": "taskgroupid"},
							{"content": "Task Group Name", "value": "taskgroupname"},
							{"content": "Task Group", "value": "taskgroup"},
							{"content": "Display Order", "value": "displayorder"},
							{"content": "Project Manual", "value": "projectmanual"},
							{"content": "Stage Display Order", "value": "stagedisplayorder"},
							{"content": "Stage", "value": "stage"}
						]
					},
					"page": {
						"index": 9,
						"type": "number",
						"label": "Page",
						"min": 1
					},
					"pageSize": {
						"index": 10,
						"type": "number",
						"label": "Page Size",
						"min": 1
					},
					"projectIds": {
						"index": 11, 
						"type": "multiselect",
						"label": "Projects",
						"min": 0,
						"source": {
							"url": "/component/appmixer/teamwork/core/ListProjects?outPort=projects",
							"data": {
								"transform": "ListProjects#toInspector"
							}
						}

					},
					"responsiblePartyIds": {
						"index": 12,
						"type": "multiselect",
						"label": "Assignees",
						"min": 0,
						"source": {
							"url": "/component/appmixer/teamwork/core/ListPeople?outPort=people",
							"data": {
								"transform": "ListPeople#toInspector"
							}
						}
					},
					"createdByUserIds": {
						"index": 13,
						"type": "multiselect",
						"label": "Created By",
						"min": 0,
						"source": {
							"url": "/component/appmixer/teamwork/core/ListPeople?outPort=people",
							"data": {
								"transform": "ListPeople#toInspector"
							}
						}
					},
					"includeSubtasks": {
						"index": 14,
						"type": "toggle",
						"label": "Include Subtasks",
						"defaultValue": false
					},
					"tagIds": {
						"index": 15,
						"type": "multiselect",
						"label": "Tags",
						"source": {
							"url": "/component/appmixer/teamwork/core/ListTags?outPort=tags",
							"data": {
								"transform": "ListTags#toInspector"
							}
						}
					},
					"customfields": {
						"type": "expression",
						"label": "Custom Fields",
						"index": 16,
						"levels": ["AND"],
						"fields": {
							"name": {
								"type": "select",
								"label": "Field",
								"index": 1,
								"source": {
									"url": "/component/appmixer/teamwork/core/ListCustomFields?outPort=customfields",
									"data": {
										"messages": {
											"in/entity": "task",
											"in/onlyTextAndNumber": true
										},
										"transform": "./ListCustomFields#toInspector"
									}
								}
							},
							"value": {
								"type": "text",
								"label": "Value",
								"index": 2
							}
						}
					}
				}
			}
		}
	],
	"outPorts": [
		{
			"name": "tasks",
			"options": [
				{
					"label": "Tasks",
					"value": "tasks",
					"schema": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"id": { "type": "number", "title": "ID" },
								"name": { "type": "string", "title": "Name" },
								"description": { "type": "string", "title": "Description" },
								"priority": { "type": "string", "title": "Priority" },
								"tagIds": { "type": "array", "title": "Tag IDs" },
								"estimateMinutes": { "type": "number", "title": "Estimated Minutes" },
								"tasklistId": { "type": "number", "title": "Task List ID" }
							}
						}
					}
				}
			]
		}
	],
	"icon": "data:image/svg+xml;base64,"
}
	
