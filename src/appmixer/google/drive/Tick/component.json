{
    "name": "appmixer.google.drive.Tick",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Trigger every time a new file or folder is added to your Google Drive. This does not download the file content. Use DownloadFile if you need the file content.",
    "version": "2.0.0",
    "private": false,
    "webhook": true,
    "tick": true,
    "auth": {
        "service": "appmixer:google:drive",
        "scope": [
            "https://www.googleapis.com/auth/drive.readonly"
        ]
    },
    "quota": {
        "manager": "appmixer:google:drive",
        "resources": "readandwrite",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "outPorts": [
        {
            "name": "out"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}

