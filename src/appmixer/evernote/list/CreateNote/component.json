{
    "name": "appmixer.evernote.list.CreateNote",
    "author": "Tomasz Hencel <thencel@ntrc.eu>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Create a new note in a notebook.",
    "private": false,
    "auth": {
        "service": "appmixer:evernote"
    },
    "quota": {
        "manager": "appmixer:evernote:list",
        "resources": [ "note/createNote" ],
        "scope": { "userId": "{{userId}}" }
    },
    "inPorts": [
        {
            "name": "note",
            "schema": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "content": { "type": "string" }
                },
                "required": [
                    "title",
                    "content"
                ]
            },
            "inspector": {
                "inputs": {
                    "title": {
                        "type": "text",
                        "group": "transformation",
                        "label": "Note title",
                        "index": 0,
                        "attrs": {
                            "label": {
                                "data-tooltip": "The title of your note."
                            }
                        }
                    },
                    "content": {
                        "type": "textarea",
                        "group": "transformation",
                        "label": "Note body",
                        "index": 1,
                        "attrs": {
                            "label": {
                                "data-tooltip": "The body of your note."
                            }
                        }
                    }
                },
                "groups": {
                    "transformation": {
                        "label": "Transformation",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "newNote",
            "options": [
                {
                    "label": "guid",
                    "value": "guid",
                    "schema": {
                        "type": "string",
                        "example": "3a7b1c2d-4e5f-4a7b-8c9d-0e1f2a3b4c5d"
                    }
                },
                {
                    "label": "title",
                    "value": "title",
                    "schema": {
                        "type": "string",
                        "example": "Meeting notes"
                    }
                },
                {
                    "label": "content",
                    "value": "content",
                    "schema": {
                        "type": "string",
                        "example": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><!DOCTYPE en-note SYSTEM \"http://xml.evernote.com/pub/enml2.dtd\"><en-note><div>Agenda for Thursday</div></en-note>"
                    }
                },
                {
                    "label": "contentLength",
                    "value": "contentLength",
                    "schema": {
                        "type": "integer",
                        "example": 184
                    }
                },
                {
                    "label": "created",
                    "value": "created",
                    "schema": {
                        "type": "integer",
                        "example": 1789029000000
                    }
                },
                {
                    "label": "updated",
                    "value": "updated",
                    "schema": {
                        "type": "integer",
                        "example": 1789029600000
                    }
                },
                {
                    "label": "deleted",
                    "value": "deleted",
                    "schema": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "active",
                    "value": "active",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "notebookGuid",
                    "value": "notebookGuid",
                    "schema": {
                        "type": "string",
                        "example": "8f2e4d6c-1a3b-4c5d-9e7f-2b4d6f8a0c1e"
                    }
                },
                {
                    "label": "tagGuids",
                    "value": "tagGuids",
                    "schema": {
                        "type": "array",
                        "example": [
                            "c1d2e3f4-a5b6-4c7d-8e9f-0a1b2c3d4e5f"
                        ]
                    }
                },
                {
                    "label": "resources",
                    "value": "resources",
                    "schema": {
                        "type": [
                            "array",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "attributes",
                    "value": "attributes",
                    "schema": {
                        "type": "object",
                        "example": {
                            "subjectDate": 1789029000000,
                            "latitude": 50.0755,
                            "longitude": 14.4378,
                            "altitude": 235,
                            "author": "Jane Doe",
                            "source": "desktop.mac",
                            "sourceURL": "https://example.com/article",
                            "sourceApplication": "Evernote Web Clipper",
                            "shareDate": 1789030000000,
                            "reminderOrder": 1789029000000,
                            "reminderDoneTime": "2026-09-12T09:00:00.000Z",
                            "reminderTime": "2026-09-12T08:00:00.000Z",
                            "placeName": "Prague",
                            "contentClass": "evernote.clipper",
                            "applicationData": {
                                "fullMap": {
                                    "my.app": "42"
                                }
                            },
                            "lastEditedBy": "Jane Doe <jane.doe@example.com>",
                            "classifications": {
                                "meeting": "true"
                            },
                            "creatorId": 12345678,
                            "lastEditorId": 12345678
                        }
                    }
                },
                {
                    "label": "attributes.subjectDate",
                    "value": "attributes.subjectDate",
                    "schema": {
                        "type": "integer",
                        "example": 1789029000000
                    }
                },
                {
                    "label": "attributes.latitude",
                    "value": "attributes.latitude",
                    "schema": {
                        "type": "number",
                        "example": 50.0755
                    }
                },
                {
                    "label": "attributes.longitude",
                    "value": "attributes.longitude",
                    "schema": {
                        "type": "number",
                        "example": 14.4378
                    }
                },
                {
                    "label": "attributes.altitude",
                    "value": "attributes.altitude",
                    "schema": {
                        "type": "number",
                        "example": 235
                    }
                },
                {
                    "label": "attributes.author",
                    "value": "attributes.author",
                    "schema": {
                        "type": "string",
                        "example": "Jane Doe"
                    }
                },
                {
                    "label": "attributes.source",
                    "value": "attributes.source",
                    "schema": {
                        "type": "string",
                        "example": "desktop.mac"
                    }
                },
                {
                    "label": "attributes.sourceURL",
                    "value": "attributes.sourceURL",
                    "schema": {
                        "type": "string",
                        "example": "https://example.com/article"
                    }
                },
                {
                    "label": "attributes.sourceApplication",
                    "value": "attributes.sourceApplication",
                    "schema": {
                        "type": "string",
                        "example": "Evernote Web Clipper"
                    }
                },
                {
                    "label": "attributes.shareDate",
                    "value": "attributes.shareDate",
                    "schema": {
                        "type": "integer",
                        "example": 1789030000000
                    }
                },
                {
                    "label": "attributes.reminderOrder",
                    "value": "attributes.reminderOrder",
                    "schema": {
                        "type": "integer",
                        "example": 1789029000000
                    }
                },
                {
                    "label": "attributes.reminderDoneTime",
                    "value": "attributes.reminderDoneTime",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-12T09:00:00.000Z"
                    }
                },
                {
                    "label": "attributes.reminderTime",
                    "value": "attributes.reminderTime",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-12T08:00:00.000Z"
                    }
                },
                {
                    "label": "attributes.placeName",
                    "value": "attributes.placeName",
                    "schema": {
                        "type": "string",
                        "example": "Prague"
                    }
                },
                {
                    "label": "attributes.contentClass",
                    "value": "attributes.contentClass",
                    "schema": {
                        "type": "string",
                        "example": "evernote.clipper"
                    }
                },
                {
                    "label": "attributes.applicationData",
                    "value": "attributes.applicationData",
                    "schema": {
                        "type": "object",
                        "example": {
                            "fullMap": {
                                "my.app": "42"
                            }
                        }
                    }
                },
                {
                    "label": "attributes.lastEditedBy",
                    "value": "attributes.lastEditedBy",
                    "schema": {
                        "type": "string",
                        "example": "Jane Doe <jane.doe@example.com>"
                    }
                },
                {
                    "label": "attributes.classifications",
                    "value": "attributes.classifications",
                    "schema": {
                        "type": "object",
                        "example": {
                            "meeting": "true"
                        }
                    }
                },
                {
                    "label": "attributes.creatorId",
                    "value": "attributes.creatorId",
                    "schema": {
                        "type": "integer",
                        "example": 12345678
                    }
                },
                {
                    "label": "attributes.lastEditorId",
                    "value": "attributes.lastEditorId",
                    "schema": {
                        "type": "integer",
                        "example": 12345678
                    }
                },
                {
                    "label": "tagNames",
                    "value": "tagNames",
                    "schema": {
                        "type": "array",
                        "example": [
                            "meeting"
                        ]
                    }
                }
            ]
        }
    ],
    "properties": {
        "schema": {
            "properties": {
                "notebookGuid": { "type": "string" }
            }
        },
        "inspector": {
            "inputs": {
                "notebookGuid": {
                    "type": "text",
                    "group": "config",
                    "label": "Notebook",
                    "index": 1,
                    "source": {
                        "url": "/component/appmixer/evernote/list/ListNotebooks?outPort=notebooks",
                        "data": {
                            "transform": "./transformers#notebooksToSelectArray"
                        }
                    },
                    "attrs": {
                        "label": {
                            "data-tooltip": "Select a Notebook."
                        }
                    }
                }
            },
            "groups": {
                "config": {
                    "label": "Configuration",
                    "index": 1
                }
            }
        }
    }
}
