{
    "name": "appmixer.quickbooks.accounting.UpdatedBill",
    "author": "Conor Quin <conor.quin@teamwork.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Triggered when a bill is updated.",
    "version": "1.0.0",
    "private": false,
    "webhook": true,
    "auth": {
        "service": "appmixer:quickbooks"
    },
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "Id": {
                        "type": "string",
                        "title": "Id",
                        "example": "250"
                    },
                    "SyncToken": {
                        "type": "string",
                        "title": "SyncToken",
                        "example": "1"
                    },
                    "domain": {
                        "type": "string",
                        "title": "domain",
                        "example": "QBO"
                    },
                    "sparse": {
                        "type": "boolean",
                        "title": "sparse",
                        "example": false
                    },
                    "DocNumber": {
                        "type": "string",
                        "title": "DocNumber",
                        "example": "BILL-2026-035"
                    },
                    "TxnDate": {
                        "type": "string",
                        "title": "TxnDate",
                        "example": "2026-01-10"
                    },
                    "DueDate": {
                        "type": "string",
                        "title": "DueDate",
                        "example": "2026-02-10"
                    },
                    "TotalAmt": {
                        "type": "number",
                        "title": "TotalAmt",
                        "example": 2400.00
                    },
                    "Balance": {
                        "type": "number",
                        "title": "Balance",
                        "example": 2400.00
                    },
                    "HomeBalance": {
                        "type": "number",
                        "title": "HomeBalance",
                        "example": 2400.00
                    },
                    "PrivateNote": {
                        "type": "string",
                        "title": "PrivateNote",
                        "example": "Cloud hosting - January (amended)"
                    },
                    "ExchangeRate": {
                        "type": "number",
                        "title": "ExchangeRate",
                        "example": 1
                    },
                    "VendorRef": {
                        "type": "object",
                        "title": "VendorRef",
                        "properties": {
                            "value": {
                                "type": "string",
                                "title": "VendorRef.value",
                                "example": "55"
                            },
                            "name": {
                                "type": "string",
                                "title": "VendorRef.name",
                                "example": "Cloud Hosting Provider"
                            }
                        }
                    },
                    "APAccountRef": {
                        "type": "object",
                        "title": "APAccountRef",
                        "properties": {
                            "value": {
                                "type": "string",
                                "title": "APAccountRef.value",
                                "example": "33"
                            },
                            "name": {
                                "type": "string",
                                "title": "APAccountRef.name",
                                "example": "Accounts Payable"
                            }
                        }
                    },
                    "SalesTermRef": {
                        "type": "object",
                        "title": "SalesTermRef",
                        "properties": {
                            "value": {
                                "type": "string",
                                "title": "SalesTermRef.value",
                                "example": "3"
                            },
                            "name": {
                                "type": "string",
                                "title": "SalesTermRef.name",
                                "example": "Net 30"
                            }
                        }
                    },
                    "CurrencyRef": {
                        "type": "object",
                        "title": "CurrencyRef",
                        "properties": {
                            "value": {
                                "type": "string",
                                "title": "CurrencyRef.value",
                                "example": "USD"
                            },
                            "name": {
                                "type": "string",
                                "title": "CurrencyRef.name",
                                "example": "United States Dollar"
                            }
                        }
                    },
                    "DepartmentRef": {
                        "type": "object",
                        "title": "DepartmentRef",
                        "properties": {
                            "value": {
                                "type": "string",
                                "title": "DepartmentRef.value",
                                "example": "1"
                            },
                            "name": {
                                "type": "string",
                                "title": "DepartmentRef.name",
                                "example": "Operations"
                            }
                        }
                    },
                    "VendorAddr": {
                        "type": "object",
                        "title": "VendorAddr",
                        "properties": {
                            "Id": {
                                "type": "string",
                                "title": "VendorAddr.Id",
                                "example": "5"
                            },
                            "Line1": {
                                "type": "string",
                                "title": "VendorAddr.Line1",
                                "example": "789 Supplier Ave"
                            },
                            "City": {
                                "type": "string",
                                "title": "VendorAddr.City",
                                "example": "Palo Alto"
                            },
                            "CountrySubDivisionCode": {
                                "type": "string",
                                "title": "VendorAddr.CountrySubDivisionCode",
                                "example": "CA"
                            },
                            "PostalCode": {
                                "type": "string",
                                "title": "VendorAddr.PostalCode",
                                "example": "94301"
                            }
                        }
                    },
                    "Line": {
                        "type": "array",
                        "title": "Line",
                        "items": {
                            "type": "object"
                        },
                        "example": [
                            {
                                "Id": "1",
                                "LineNum": 1,
                                "Description": "Cloud infrastructure - Jan",
                                "Amount": 2400.00,
                                "DetailType": "AccountBasedExpenseLineDetail",
                                "AccountBasedExpenseLineDetail": {
                                    "AccountRef": {
                                        "value": "7",
                                        "name": "Cloud Services"
                                    },
                                    "BillableStatus": "NotBillable",
                                    "CustomerRef": {
                                        "value": "12",
                                        "name": "Project Alpha"
                                    },
                                    "TaxCodeRef": {
                                        "value": "NON"
                                    }
                                }
                            }
                        ]
                    },
                    "LinkedTxn": {
                        "type": "array",
                        "title": "LinkedTxn",
                        "items": {
                            "type": "object"
                        },
                        "example": [
                            {
                                "TxnId": "500",
                                "TxnType": "BillPaymentCheck"
                            }
                        ]
                    },
                    "MetaData": {
                        "type": "object",
                        "title": "MetaData",
                        "properties": {
                            "CreateTime": {
                                "type": "string",
                                "title": "MetaData.CreateTime",
                                "example": "2026-01-10T08:00:00-08:00"
                            },
                            "LastUpdatedTime": {
                                "type": "string",
                                "title": "MetaData.LastUpdatedTime",
                                "example": "2026-01-14T16:30:00-08:00"
                            }
                        }
                    }
                }
            }
        }
    ]
}
