{
    "name": "appmixer.quickbooks.accounting.CreateBill",
    "author": "Jiří Hofman <jirka@client.io>",
    "description": "Create a new bill.",
    "auth": {
        "service": "appmixer:quickbooks",
        "scope": [
            "com.intuit.quickbooks.accounting",
            "openid",
            "profile",
            "email",
            "phone",
            "address"
        ]
    },
    "inPorts": [
        {
            "name": "in",
            "inspector": {
                "inputs": {
                    "vendorId": {
                        "type": "text",
                        "index": 1,
                        "label": "Vendor ID",
                        "tooltip": "Reference to the vendor for this transaction."
                    },
                    "minorVersion": {
                        "type": "number",
                        "index": 2,
                        "label": "Minor Version",
                        "defaultValue": 75,
                        "tooltip": "Minor version of the request. Note: Versions below 75 are ignored and will default to version 75. Use version 75 or higher for current features. See the <a target='_blank' rel='noopener noreferrer' href='https://developer.intuit.com/app/developer/qbo/docs/learn/explore-the-quickbooks-online-api/minor-versions'>docs</a> for more details."
                    },
                    "currency": {
                        "type": "text",
                        "index": 3,
                        "label": "Currency",
                        "tooltip": "A three letter string representing the ISO 4217 code for the currency. For example, USD, AUD, EUR, and so on."
                    },
                    "dueDate": {
                        "type": "date-time",
                        "config": {
                            "format": "YYYY-MM-DD",
                            "enableTime": false
                        },
                        "index": 4,
                        "label": "Due Date",
                        "tooltip": "Date when the payment of the transaction is due."
                    },
                    "lineItemsJSON": {
                        "type": "textarea",
                        "index": 5,
                        "label": "Line Items JSON",
                        "tooltip": "Line items in a raw JSON format. This is only for an advanced use. See <a target='_blank' rel='noopener noreferrer' href='https://developer.intuit.com/app/developer/qbo/docs/api/accounting/most-commonly-used/invoice#create-an-invoice'>Quickbooks documentation</a> for more details. An example: <code>[{ \"DetailType\": \"AccountBasedExpenseLineDetail\", \"Amount\": 50, \"Description\": \"My service\", \"AccountBasedExpenseLineDetail\": { \"AccountRef\": {\"value\":7} } }]</code>."
                    },
                    "txnDate": {
                        "type": "date-time",
                        "config": {
                            "format": "YYYY-MM-DD",
                            "enableTime": false
                        },
                        "index": 6,
                        "label": "TxnDate",
                        "tooltip": "The date entered by the user when this transaction occurred. For posting transactions, this is the posting date that affects the financial statements. If the date is not supplied, the current date on the server is used."
                    },
                    "docNumber": {
                        "type": "text",
                        "index": 7,
                        "label": "Doc Number",
                        "tooltip": "Reference number for the transaction. If not explicitly provided at create time, this field is populated based on the setting of Preferences:CustomTxnNumber."
                    },
                    "privateNote": {
                        "type": "text",
                        "index": 8,
                        "label": "Private Note",
                        "tooltip": "User entered, organization-private note about the transaction. This note does not appear on the invoice to the customer. This field maps to the Statement Memo field on the Invoice form in the QuickBooks Online UI."
                    },
                    "apAccountId": {
                        "type": "text",
                        "index": 9,
                        "label": "AP Account ID",
                        "tooltip": "Specifies to which AP account the bill is credited."
                    },
                    "salesTermId": {
                        "type": "text",
                        "index": 10,
                        "label": "Sales Term ID",
                        "tooltip": "Reference to the Term associated with the transaction."
                    },
                    "departmentId": {
                        "type": "text",
                        "index": 11,
                        "label": "Department ID",
                        "tooltip": "Reference to the Department associated with the transaction."
                    },
                    "linkedTxnJSON": {
                        "type": "textarea",
                        "index": 12,
                        "label": "Linked transactions JSON",
                        "tooltip": "Linked transactions in a raw JSON format. This is only for an advanced use. Zero or more transactions linked to this Bill object. The LinkedTxn.TxnType can be set to PurchaseOrder, BillPaymentCheck or if using Minor Version 55 and above ReimburseCharge. Use LinkedTxn.TxnId as the ID of the transaction."
                    },
                    "exchangeRate": {
                        "type": "number",
                        "index": 13,
                        "label": "Exchange Rate",
                        "tooltip": "The number of home currency units it takes to equal one unit of currency specified by Currency. Applicable if multicurrency is enabled for the company."
                    }
                }
            },
            "schema": {
                "type": "object",
                "properties": {
                    "vendorId": {
                        "type": "string"
                    },
                    "minorVersion": {
                        "type": "string"
                    },
                    "currency": {
                        "type": "string"
                    },
                    "dueDate": {
                        "type": "string",
                        "pattern": "^[0-9]{4}-[0|1][0-9]-[0-3][0-9]$"
                    },
                    "lineItemsJSON": {
                        "type": "string"
                    },
                    "txnDate": {
                        "type": "string",
                        "pattern": "^[0-9]{4}-[0|1][0-9]-[0-3][0-9]$"
                    },
                    "docNumber": {
                        "type": "string"
                    },
                    "privateNote": {
                        "type": "string"
                    },
                    "apAccountId": {
                        "type": "string"
                    },
                    "salesTermId": {
                        "type": "string"
                    },
                    "departmentId": {
                        "type": "string"
                    },
                    "linkedTxnJSON": {
                        "type": "string"
                    },
                    "exchangeRate": {
                        "type": "number"
                    }
                },
                "oneOf": [
                    {
                        "required": [
                            "vendorId",
                            "lineItems"
                        ]
                    },
                    {
                        "required": [
                            "vendorId",
                            "lineItemsJSON"
                        ]
                    }
                ]
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "SalesTermRef",
                    "value": "SalesTermRef",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "value": {
                                "label": "value",
                                "value": "value"
                            }
                        },
                        "example": {
                            "value": "3",
                            "name": "Net 30"
                        }
                    }
                },
                {
                    "label": "DueDate",
                    "value": "DueDate",
                    "schema": {
                        "example": "2026-02-15"
                    }
                },
                {
                    "label": "VendorAddr",
                    "value": "VendorAddr",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "value": {
                                "label": "ID",
                                "value": "Id"
                            },
                            "Line1": {
                                "label": "Line1",
                                "value": "Line1"
                            },
                            "Line2": {
                                "label": "Line2",
                                "value": "Line2"
                            },
                            "Line3": {
                                "label": "Line3",
                                "value": "Line3"
                            },
                            "Line4": {
                                "label": "Line4",
                                "value": "Line4"
                            },
                            "Line5": {
                                "label": "Line5",
                                "value": "Line5"
                            }
                        },
                        "example": {
                            "Line1": "123 Vendor Street",
                            "City": "San Jose",
                            "CountrySubDivisionCode": "CA",
                            "PostalCode": "95131"
                        }
                    }
                },
                {
                    "label": "Balance",
                    "value": "Balance",
                    "schema": {
                        "example": 1500.0
                    }
                },
                {
                    "label": "HomeBalance",
                    "value": "HomeBalance",
                    "schema": {
                        "example": 1500.0
                    }
                },
                {
                    "label": "domain",
                    "value": "domain",
                    "schema": {
                        "example": "QBO"
                    }
                },
                {
                    "label": "sparse",
                    "value": "sparse",
                    "schema": {
                        "example": false
                    }
                },
                {
                    "label": "Id",
                    "value": "Id",
                    "schema": {
                        "example": "301"
                    }
                },
                {
                    "label": "SyncToken",
                    "value": "SyncToken",
                    "schema": {
                        "example": "0"
                    }
                },
                {
                    "label": "MetaData",
                    "value": "MetaData",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "CreateTime": {
                                "label": "CreateTime",
                                "value": "CreateTime"
                            },
                            "LastUpdatedTime": {
                                "label": "LastUpdatedTime",
                                "value": "LastUpdatedTime"
                            },
                            "LastModifiedByRef": {
                                "label": "LastModifiedByRef",
                                "value": "LastModifiedByRef",
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "value": {
                                            "label": "value",
                                            "value": "value"
                                        }
                                    }
                                }
                            }
                        },
                        "example": {
                            "CreateTime": "2026-01-15T10:30:00-08:00",
                            "LastUpdatedTime": "2026-01-15T10:30:00-08:00"
                        }
                    }
                },
                {
                    "label": "DocNumber",
                    "value": "DocNumber",
                    "schema": {
                        "example": "BILL-2026-042"
                    }
                },
                {
                    "label": "TxnDate",
                    "value": "TxnDate",
                    "schema": {
                        "example": "2026-01-15"
                    }
                },
                {
                    "label": "CurrencyRef",
                    "value": "CurrencyRef",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "value": {
                                "label": "value",
                                "value": "value"
                            },
                            "name": {
                                "label": "name",
                                "value": "name"
                            }
                        },
                        "example": {
                            "value": "USD",
                            "name": "United States Dollar"
                        }
                    }
                },
                {
                    "label": "ExchangeRate",
                    "value": "ExchangeRate",
                    "schema": {
                        "type": "number",
                        "example": 1
                    }
                },
                {
                    "label": "PrivateNote",
                    "value": "PrivateNote",
                    "schema": {
                        "example": "Monthly office supplies"
                    }
                },
                {
                    "label": "Line",
                    "value": "Line",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "Id": {
                                    "label": "Id",
                                    "value": "Id"
                                },
                                "LineNum": {
                                    "label": "LineNum",
                                    "value": "LineNum"
                                },
                                "Description": {
                                    "label": "Description",
                                    "value": "Description"
                                },
                                "Amount": {
                                    "label": "Amount",
                                    "value": "Amount"
                                },
                                "DetailType": {
                                    "label": "DetailType",
                                    "value": "DetailType"
                                },
                                "AccountBasedExpenseLineDetail": {
                                    "label": "AccountBasedExpenseLineDetail",
                                    "value": "AccountBasedExpenseLineDetail",
                                    "schema": {
                                        "type": "object",
                                        "properties": {
                                            "AccountRef": {
                                                "label": "AccountRef",
                                                "value": "AccountRef",
                                                "schema": {
                                                    "type": "object",
                                                    "properties": {
                                                        "value": {
                                                            "label": "value",
                                                            "value": "value"
                                                        },
                                                        "name": {
                                                            "label": "name",
                                                            "value": "name"
                                                        }
                                                    }
                                                }
                                            },
                                            "BillableStatus": {
                                                "label": "BillableStatus",
                                                "value": "BillableStatus"
                                            },
                                            "TaxCodeRef": {
                                                "label": "TaxCodeRef",
                                                "value": "TaxCodeRef",
                                                "schema": {
                                                    "type": "object",
                                                    "properties": {
                                                        "value": {
                                                            "label": "value",
                                                            "value": "value"
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "example": [
                            {
                                "Amount": 1500.0,
                                "DetailType": "AccountBasedExpenseLineDetail"
                            }
                        ]
                    }
                },
                {
                    "label": "VendorRef",
                    "value": "VendorRef",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "value": {
                                "label": "value",
                                "value": "value"
                            },
                            "name": {
                                "label": "name",
                                "value": "name"
                            }
                        },
                        "example": {
                            "value": "42",
                            "name": "Office Supplies Inc"
                        }
                    }
                },
                {
                    "label": "APAccountRef",
                    "value": "APAccountRef",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "value": {
                                "label": "value",
                                "value": "value"
                            },
                            "name": {
                                "label": "name",
                                "value": "name"
                            }
                        },
                        "example": {
                            "value": "33",
                            "name": "Accounts Payable"
                        }
                    }
                },
                {
                    "label": "DepartmentRef",
                    "value": "DepartmentRef",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "name": {
                                "label": "name",
                                "value": "name"
                            },
                            "value": {
                                "label": "value",
                                "value": "value"
                            }
                        },
                        "example": {
                            "value": "1",
                            "name": "Operations"
                        }
                    }
                },
                {
                    "label": "TotalAmt",
                    "value": "TotalAmt",
                    "schema": {
                        "example": 1500.0
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
