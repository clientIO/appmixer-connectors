{
    "name": "appmixer.quickbooks.accounting.SendInvoice",
    "author": "Harsha Surisetty <harsha@client.io>",
    "description": "Send an invoice.",
    "version": "1.0.1",
    "auth": {
        "service": "appmixer:quickbooks",
        "scope": [
            "com.intuit.quickbooks.accounting",
            "openid",
            "profile",
            "email",
            "phone",
            "address"
        ]
    },
    "inPorts": [
        {
            "name": "in",
            "inspector": {
                "inputs": {
                    "invoiceId": {
                        "type": "text",
                        "index": 1,
                        "label": "Invoice ID",
                        "tooltip": "Invoice ID."
                    }
                }
            },
            "schema": {
                "type": "object",
                "properties": {
                    "invoiceId": {
                        "type": "string"
                    }
                },
                "required": ["invoiceId"]
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Txn Date",
                    "value": "TxnDate",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10"
                    }
                },
                {
                    "label": "Domain",
                    "value": "domain",
                    "schema": {
                        "type": "string",
                        "example": "QBO"
                    }
                },
                {
                    "label": "Print Status",
                    "value": "PrintStatus",
                    "schema": {
                        "type": "string",
                        "example": "NeedToPrint"
                    }
                },
                {
                    "label": "Sales Term Ref Value",
                    "value": "SalesTermRef.value",
                    "schema": {
                        "type": "string",
                        "example": "3"
                    }
                },
                {
                    "label": "Total Amt",
                    "value": "TotalAmt",
                    "schema": {
                        "type": "number",
                        "example": 1725
                    }
                },
                {
                    "label": "Line",
                    "value": "Line",
                    "schema": {
                        "type": "array",
                        "example": [
                            {
                                "Id": "1",
                                "LineNum": 1,
                                "Description": "Consulting services",
                                "Amount": 1500,
                                "DetailType": "SalesItemLineDetail",
                                "SalesItemLineDetail": {
                                    "ItemRef": {
                                        "value": "1",
                                        "name": "Services"
                                    },
                                    "UnitPrice": 150,
                                    "Qty": 10,
                                    "TaxCodeRef": {
                                        "value": "TAX"
                                    }
                                }
                            },
                            {
                                "Amount": 1500,
                                "DetailType": "SubTotalLineDetail",
                                "SubTotalLineDetail": {}
                            }
                        ]
                    }
                },
                {
                    "label": "Due Date",
                    "value": "DueDate",
                    "schema": {
                        "type": "string",
                        "example": "2026-10-10"
                    }
                },
                {
                    "label": "Apply Tax After Discount",
                    "value": "ApplyTaxAfterDiscount",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Doc Number",
                    "value": "DocNumber",
                    "schema": {
                        "type": "string",
                        "example": "1037"
                    }
                },
                {
                    "label": "Sparse",
                    "value": "sparse",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Customer Memo Value",
                    "value": "CustomerMemo.value",
                    "schema": {
                        "type": "string",
                        "example": "Thank you for your business!"
                    }
                },
                {
                    "label": "Deposit",
                    "value": "Deposit",
                    "schema": {
                        "type": "number",
                        "example": 0
                    }
                },
                {
                    "label": "Balance",
                    "value": "Balance",
                    "schema": {
                        "type": "number",
                        "example": 1725
                    }
                },
                {
                    "label": "Customer Ref Name",
                    "value": "CustomerRef.name",
                    "schema": {
                        "type": "string",
                        "example": "Acme Corporation"
                    }
                },
                {
                    "label": "Customer Ref Value",
                    "value": "CustomerRef.value",
                    "schema": {
                        "type": "string",
                        "example": "58"
                    }
                },
                {
                    "label": "Txn Tax Detail Txn Tax Code Ref Value",
                    "value": "TxnTaxDetail.TxnTaxCodeRef.value",
                    "schema": {
                        "type": "string",
                        "example": "2"
                    }
                },
                {
                    "label": "Txn Tax Detail Total Tax",
                    "value": "TxnTaxDetail.TotalTax",
                    "schema": {
                        "type": "number",
                        "example": 225
                    }
                },
                {
                    "label": "Txn Tax Detail Tax Line",
                    "value": "TxnTaxDetail.TaxLine",
                    "schema": {
                        "type": "array",
                        "example": [
                            {
                                "Amount": 225,
                                "DetailType": "TaxLineDetail",
                                "TaxLineDetail": {
                                    "TaxRateRef": {
                                        "value": "3"
                                    },
                                    "PercentBased": true,
                                    "TaxPercent": 15,
                                    "NetAmountTaxable": 1500
                                }
                            }
                        ]
                    }
                },
                {
                    "label": "Sync Token",
                    "value": "SyncToken",
                    "schema": {
                        "type": "string",
                        "example": "0"
                    }
                },
                {
                    "label": "Linked Txn",
                    "value": "LinkedTxn",
                    "schema": {
                        "type": "array",
                        "example": []
                    }
                },
                {
                    "label": "Bill Email Address",
                    "value": "BillEmail.Address",
                    "schema": {
                        "type": "string",
                        "example": "billing@acme.example.com"
                    }
                },
                {
                    "label": "Ship Addr City",
                    "value": "ShipAddr.City",
                    "schema": {
                        "type": "string",
                        "example": "San Francisco"
                    }
                },
                {
                    "label": "Ship Addr Line 1",
                    "value": "ShipAddr.Line1",
                    "schema": {
                        "type": "string",
                        "example": "500 Howard St"
                    }
                },
                {
                    "label": "Ship Addr Postal Code",
                    "value": "ShipAddr.PostalCode",
                    "schema": {
                        "type": "string",
                        "example": "94105"
                    }
                },
                {
                    "label": "Ship Addr Lat",
                    "value": "ShipAddr.Lat",
                    "schema": {
                        "type": "string",
                        "example": "37.7894"
                    }
                },
                {
                    "label": "Ship Addr Long",
                    "value": "ShipAddr.Long",
                    "schema": {
                        "type": "string",
                        "example": "-122.3964"
                    }
                },
                {
                    "label": "Ship Addr Country Sub Division Code",
                    "value": "ShipAddr.CountrySubDivisionCode",
                    "schema": {
                        "type": "string",
                        "example": "CA"
                    }
                },
                {
                    "label": "Ship Addr Id",
                    "value": "ShipAddr.Id",
                    "schema": {
                        "type": "string",
                        "example": "121"
                    }
                },
                {
                    "label": "Email Status",
                    "value": "EmailStatus",
                    "schema": {
                        "type": "string",
                        "example": "NotSet"
                    }
                },
                {
                    "label": "Bill Addr Line 4",
                    "value": "BillAddr.Line4",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "Bill Addr Line 3",
                    "value": "BillAddr.Line3",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "Bill Addr Line 2",
                    "value": "BillAddr.Line2",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "Suite 400"
                    }
                },
                {
                    "label": "Bill Addr Line 1",
                    "value": "BillAddr.Line1",
                    "schema": {
                        "type": "string",
                        "example": "500 Howard St"
                    }
                },
                {
                    "label": "Bill Addr Long",
                    "value": "BillAddr.Long",
                    "schema": {
                        "type": "string",
                        "example": "-122.3964"
                    }
                },
                {
                    "label": "Bill Addr Lat",
                    "value": "BillAddr.Lat",
                    "schema": {
                        "type": "string",
                        "example": "37.7894"
                    }
                },
                {
                    "label": "Bill Addr Id",
                    "value": "BillAddr.Id",
                    "schema": {
                        "type": "string",
                        "example": "120"
                    }
                },
                {
                    "label": "Meta Data Create Time",
                    "value": "MetaData.CreateTime",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T01:30:00-07:00"
                    }
                },
                {
                    "label": "Meta Data Last Updated Time",
                    "value": "MetaData.LastUpdatedTime",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T01:30:00-07:00"
                    }
                },
                {
                    "label": "Custom Field",
                    "value": "CustomField",
                    "schema": {
                        "type": "array",
                        "example": [
                            {
                                "DefinitionId": "1",
                                "Name": "Crew #",
                                "Type": "StringType"
                            }
                        ]
                    }
                },
                {
                    "label": "Id",
                    "value": "Id",
                    "schema": {
                        "type": "string",
                        "example": "130"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
