{
    "name": "appmixer.quickbooks.accounting.Attachable",
    "author": "Jiří Hofman <jirka@client.io>",
    "description": "Upload a file to QuickBooks Online and attach it to an entity.",
    "auth": {
        "service": "appmixer:quickbooks",
        "scope": [
            "com.intuit.quickbooks.accounting",
            "openid",
            "profile",
            "email",
            "phone",
            "address"
        ]
    },
    "inPorts": [
        {
            "name": "in",
            "inspector": {
                "inputs": {
                    "entityId": {
                        "type": "number",
                        "index": 1,
                        "label": "Entity ID",
                        "tooltip": "ID of the entity to attach the file to."
                    },
                    "minorVersion": {
                        "type": "number",
                        "index": 2,
                        "label": "Minor Version",
                        "defaultValue": 75,
                        "tooltip": "Minor version of the request. Note: Versions below 75 are ignored and will default to version 75. Use version 75 or higher for current features. See the <a target='_blank' rel='noopener noreferrer' href='https://developer.intuit.com/app/developer/qbo/docs/learn/explore-the-quickbooks-online-api/minor-versions'>docs</a> for more details."
                    },
                    "entityType": {
                        "type": "select",
                        "options": [
                            {
                                "label": "Bill",
                                "value": "Bill"
                            },
                            {
                                "label": "Invoice",
                                "value": "Invoice"
                            }
                        ],
                        "index": 3,
                        "label": "Entity Type",
                        "tooltip": "Type of the entity to attach the file to."
                    },
                    "attachment": {
                        "type": "filepicker",
                        "index": 4,
                        "label": "Attachment",
                        "tooltip": "The file to be attached. For allowed extensions see the <a target='_blank' rel='noopener noreferrer' href='https://developer.intuit.com/app/developer/qbo/docs/workflows/attach-images-and-notes#approved-file-types'>docs</a>."
                    }
                }
            },
            "schema": {
                "type": "object",
                "properties": {
                    "entityId": {
                        "type": "number"
                    },
                    "minorVersion": {
                        "type": "number"
                    },
                    "entityType": {
                        "type": "string"
                    },
                    "attachment": {
                        "type": "string"
                    }
                },
                "required": [
                    "entityId",
                    "entityType",
                    "attachment"
                ]
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "FileName",
                    "value": "FileName",
                    "schema": {
                        "example": "receipt-2026-01.pdf"
                    }
                },
                {
                    "label": "FileAccessUri",
                    "value": "FileAccessUri",
                    "schema": {
                        "example": "https://qbo.intuit.com/upload/v3/company/12345/upload"
                    }
                },
                {
                    "label": "TempDownloadUri",
                    "value": "TempDownloadUri",
                    "schema": {
                        "example": "https://qbo.intuit.com/download/v3/company/12345/receipt.pdf"
                    }
                },
                {
                    "label": "Size",
                    "value": "Size",
                    "schema": {
                        "example": 245760
                    }
                },
                {
                    "label": "ContentType",
                    "value": "ContentType",
                    "schema": {
                        "example": "application/pdf"
                    }
                },
                {
                    "label": "ThumbnailFileAccessUri",
                    "value": "ThumbnailFileAccessUri",
                    "schema": {
                        "example": "https://qbo.intuit.com/upload/v3/company/12345/thumb.jpg"
                    }
                },
                {
                    "label": "domain",
                    "value": "domain",
                    "schema": {
                        "example": "QBO"
                    }
                },
                {
                    "label": "sparse",
                    "value": "sparse",
                    "schema": {
                        "example": false
                    }
                },
                {
                    "label": "Id",
                    "value": "Id",
                    "schema": {
                        "example": "200"
                    }
                },
                {
                    "label": "SyncToken",
                    "value": "SyncToken",
                    "schema": {
                        "example": "0"
                    }
                },
                {
                    "label": "MetaData",
                    "value": "MetaData",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "CreateTime": {
                                "label": "CreateTime",
                                "value": "CreateTime"
                            },
                            "LastUpdatedTime": {
                                "label": "LastUpdatedTime",
                                "value": "LastUpdatedTime"
                            }
                        },
                        "example": {
                            "CreateTime": "2026-01-15T10:30:00-08:00",
                            "LastUpdatedTime": "2026-01-15T10:30:00-08:00"
                        }
                    }
                },
                {
                    "label": "AttachableRef",
                    "value": "AttachableRef",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "EntityRef": {
                                    "label": "EntityRef",
                                    "value": "EntityRef",
                                    "schema": {
                                        "type": "object",
                                        "properties": {
                                            "value": {
                                                "label": "value",
                                                "value": "value"
                                            },
                                            "type": {
                                                "label": "type",
                                                "value": "type"
                                            }
                                        }
                                    }
                                },
                                "IncludeOnSend": {
                                    "label": "IncludeOnSend",
                                    "value": "IncludeOnSend"
                                }
                            }
                        },
                        "example": [
                            {
                                "EntityRef": {
                                    "value": "145",
                                    "type": "Invoice"
                                },
                                "IncludeOnSend": false
                            }
                        ]
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
