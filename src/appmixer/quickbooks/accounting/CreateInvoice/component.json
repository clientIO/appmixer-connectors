{
    "name": "appmixer.quickbooks.accounting.CreateInvoice",
    "author": "Harsha Surisetty <harsha@client.io>",
    "description": "Create a new invoice.",
    "version": "1.0.2",
    "auth": {
        "service": "appmixer:quickbooks",
        "scope": [
            "com.intuit.quickbooks.accounting",
            "openid",
            "profile",
            "email",
            "phone",
            "address"
        ]
    },
    "inPorts": [
        {
            "name": "in",
            "inspector": {
                "inputs": {
                    "customerId": {
                        "type": "text",
                        "index": 1,
                        "source": {
                            "url": "/component/appmixer/quickbooks/accounting/ListCustomers?outPort=out",
                            "data": {
                                "messages": {
                                    "in/baseId": "inputs/in/baseId",
                                    "in/isSource": true
                                },
                                "transform": "./transformers#customersToSelectArray"
                            }
                        },
                        "label": "Customer ID",
                        "tooltip": "Select a customer."
                    },
                    "minorVersion": {
                        "type": "number",
                        "index": 1,
                        "label": "Minor Version",
                        "defaultValue": 75,
                        "tooltip": "Minor version of the request. Note: Versions below 75 are ignored and will default to version 75. Use version 75 or higher for current features. See the <a target='_blank' rel='noopener noreferrer' href='https://developer.intuit.com/app/developer/qbo/docs/learn/explore-the-quickbooks-online-api/minor-versions'>docs</a> for more details."
                    },
                    "currency": {
                        "type": "text",
                        "index": 2,
                        "label": "Currency",
                        "tooltip": "A three letter string representing the ISO 4217 code for the currency. For example, USD, AUD, EUR, and so on."
                    },
                    "dueDate": {
                        "type": "date-time",
                        "config": {
                            "format": "YYYY-MM-DD",
                            "enableTime": false
                        },
                        "index": 3,
                        "label": "Due Date",
                        "tooltip": "Date when the payment of the transaction is due."
                    },
                    "lineItems": {
                        "type": "expression",
                        "index": 4,
                        "label": "Line Items",
                        "tooltip": "Line items with DetailType <code>SalesItemLineDetail</code>. For advanced usage, see <b>Line Items JSON</b> below.",
                        "levels": ["AND"],
                        "fields": {
                            "description": {
                                "type": "text",
                                "label": "Description",
                                "tooltip": "Description.",
                                "index": 1
                            },
                            "amount": {
                                "type": "number",
                                "label": "Amount",
                                "tooltip": "Amount.",
                                "index": 2
                            },
                            "quantity": {
                                "type": "number",
                                "label": "Quantity",
                                "tooltip": "Quantity.",
                                "index": 3
                            },
                            "discountAmt": {
                                "type": "number",
                                "label": "Discount Amount",
                                "tooltip": "Discount Amount.",
                                "index": 4
                            },
                            "discountRate": {
                                "type": "number",
                                "label": "DiscountRate",
                                "tooltip": "The discount rate applied to this line. If both Discount Amount and Discount Rate are supplied, Discount Rate takes precedence and Discount Amount is recalculated by QuickBooks services based on amount of Discount Rate.",
                                "index": 5
                            },
                            "unitPrice": {
                                "type": "number",
                                "label": "Unit Price",
                                "tooltip": "Unit price of the subject item. Corresponds to the Rate column on the QuickBooks Online UI to specify either unit price, a discount, or a tax rate for item. If used for unit price, the monetary value of the service or product, as expressed in the home currency. You can override the unit price of the subject item by supplying a new value with create or update operations. If used for a discount or tax rate, express the percentage as a fraction. For example, specify 0.4 for 40% tax.",
                                "index": 6
                            }
                        }
                    },
                    "lineItemsJSON": {
                        "type": "textarea",
                        "index": 5,
                        "label": "Line Items JSON",
                        "tooltip": "Line items in a raw JSON format. This is only for an advanced use. See <a target='_blank' rel='noopener noreferrer' href='https://developer.intuit.com/app/developer/qbo/docs/api/accounting/most-commonly-used/invoice#create-an-invoice'>Quickbooks documentation</a> for more details. An example: [{ \"DetailType\": \"SalesItemLineDetail\", \"Amount\": 50, \"Description\": \"My service\", \"SalesItemLineDetail\": { \"Qty\": 2 } }]."
                    },
                    "docNumber": {
                        "type": "text",
                        "index": 6,
                        "label": "Doc Number",
                        "tooltip": "Reference number for the transaction. If not explicitly provided at create time, this field is populated based on the setting of Preferences:CustomTxnNumber."
                    },
                    "billEmail": {
                        "type": "text",
                        "index": 7,
                        "label": "Billing Email",
                        "tooltip": "Identifies the e-mail address where the invoice is sent."
                    },
                    "billEmailCc": {
                        "type": "text",
                        "index": 8,
                        "label": "Bill Email CC",
                        "tooltip": "Identifies the carbon copy e-mail address where the invoice is sent."
                    },
                    "billEmailBcc": {
                        "type": "text",
                        "index": 9,
                        "label": "Bill Email BCC",
                        "tooltip": "Identifies the blind carbon copy e-mail address where the invoice is sent."
                    },
                    "billAddrPostalCode": {
                        "type": "text",
                        "index": 10,
                        "label": "Bill Address Postal Code",
                        "tooltip": "Identifies the bill-to address of the invoice."
                    },
                    "billAddrCity": {
                        "type": "text",
                        "index": 11,
                        "label": "Bill Address City",
                        "tooltip": "Billing"
                    },
                    "billAddrCountry": {
                        "type": "text",
                        "index": 12,
                        "label": "Bill Address Country",
                        "tooltip": "Country name. For international addresses - countries should be passed as 3 ISO alpha-3 characters or the full name of the country."
                    },
                    "billAddrLine1": {
                        "type": "text",
                        "index": 13,
                        "label": "Bill Address Line 1",
                        "tooltip": "Billing"
                    },
                    "billAddrLine2": {
                        "type": "text",
                        "index": 14,
                        "label": "Bill Address Line 2",
                        "tooltip": "Billing"
                    },
                    "billAddrCountrySubDivisionCode": {
                        "type": "text",
                        "index": 15,
                        "label": "Bill Address Region",
                        "tooltip": "Region within a country. For example, state name for USA, province name for Canada."
                    },
                    "billAddrLat": {
                        "type": "text",
                        "index": 16,
                        "label": "Bill Address Latitude",
                        "tooltip": "Latitude coordinate of Geocode (Geospacial Entity Object Code)."
                    },
                    "billAddrLon": {
                        "type": "text",
                        "index": 17,
                        "label": "Bill Address Longitude",
                        "tooltip": "Longitude coordinate of Geocode (Geospacial Entity Object Code)."
                    },
                    "shipDate": {
                        "type": "date-time",
                        "config": {
                            "format": "YYYY-MM-DD",
                            "enableTime": false
                        },
                        "index": 18,
                        "label": "Ship Date",
                        "tooltip": "Date for delivery of goods or services."
                    },
                    "shipAddrPostalCode": {
                        "type": "text",
                        "index": 19,
                        "label": "Ship Address Postal Code",
                        "tooltip": "Identifies the address where the goods must be shipped."
                    },
                    "shipAddrCity": {
                        "type": "text",
                        "index": 20,
                        "label": "Ship Address City",
                        "tooltip": "Shipping"
                    },
                    "shipAddrCountry": {
                        "type": "text",
                        "index": 21,
                        "label": "Ship Address Country",
                        "tooltip": "Country name. For international addresses - countries should be passed as 3 ISO alpha-3 characters or the full name of the country."
                    },
                    "shipAddrLine1": {
                        "type": "text",
                        "index": 22,
                        "label": "Ship Address Line 1",
                        "tooltip": "Shipping"
                    },
                    "shipAddrLine2": {
                        "type": "text",
                        "index": 23,
                        "label": "Ship Address Line 2",
                        "tooltip": "Shipping"
                    },
                    "shipAddrCountrySubDivisionCode": {
                        "type": "text",
                        "index": 24,
                        "label": "Ship Address Region",
                        "tooltip": "Region within a country. For example, state name for USA, province name for Canada."
                    },
                    "shipAddrLat": {
                        "type": "text",
                        "index": 25,
                        "label": "Ship Address Latitude",
                        "tooltip": "Latitude coordinate of Geocode (Geospacial Entity Object Code)."
                    },
                    "shipAddrLon": {
                        "type": "text",
                        "index": 26,
                        "label": "Ship Address Longitude",
                        "tooltip": "Longitude coordinate of Geocode (Geospacial Entity Object Code)."
                    },
                    "shipFromAddrPostalCode": {
                        "type": "text",
                        "index": 27,
                        "label": "Ship From Address Postal Code",
                        "tooltip": "Identifies the address where the goods are shipped from. For transactions without shipping, it represents the address where the sale took place."
                    },
                    "shipFromAddrCity": {
                        "type": "text",
                        "index": 28,
                        "label": "Ship From Address City",
                        "tooltip": "Shipping"
                    },
                    "shipFromAddrCountry": {
                        "type": "text",
                        "index": 29,
                        "label": "Ship From Address Country",
                        "tooltip": "Country name. For international addresses - countries should be passed as 3 ISO alpha-3 characters or the full name of the country."
                    },
                    "shipFromAddrLine1": {
                        "type": "text",
                        "index": 30,
                        "label": "Ship From Address Line 1",
                        "tooltip": "Shipping"
                    },
                    "shipFromAddrLine2": {
                        "type": "text",
                        "index": 31,
                        "label": "Ship From Address Line 2",
                        "tooltip": "Shipping"
                    },
                    "shipFromAddrCountrySubDivisionCode": {
                        "type": "text",
                        "index": 32,
                        "label": "Ship From Address Region",
                        "tooltip": "Region within a country. For example, state name for USA, province name for Canada."
                    },
                    "shipFromAddrLat": {
                        "type": "text",
                        "index": 33,
                        "label": "Ship From Address Latitude",
                        "tooltip": "Latitude coordinate of Geocode (Geospacial Entity Object Code)."
                    },
                    "shipFromAddrLon": {
                        "type": "text",
                        "index": 34,
                        "label": "Ship From Address Longitude",
                        "tooltip": "Longitude coordinate of Geocode (Geospacial Entity Object Code)."
                    },
                    "trackingNum": {
                        "type": "text",
                        "index": 35,
                        "label": "Tracking Number",
                        "tooltip": "Shipping provider's tracking number for the delivery of the goods associated with the transaction."
                    },
                    "printStatus": {
                        "type": "select",
                        "index": 36,
                        "label": "Print Status",
                        "tooltip": "Printing status of the invoice.",
                        "options": [
                            {
                                "label": "Not Set",
                                "value": "NotSet"
                            },
                            {
                                "label": "Need To Print",
                                "value": "NeedToPrint"
                            },
                            {
                                "label": "Print Complete",
                                "value": "PrintComplete"
                            }
                        ]
                    },
                    "globalTaxCalculation": {
                        "type": "select",
                        "index": 37,
                        "label": "Global Tax Calculation",
                        "tooltip": "Method in which tax is applied.",
                        "options": [
                            {
                                "label": "Tax Excluded",
                                "value": "TaxExcluded"
                            },
                            {
                                "label": "Tax Inclusive",
                                "value": "TaxInclusive"
                            },
                            {
                                "label": "Not Applicable",
                                "value": "NotApplicable"
                            }
                        ]
                    },
                    "allowOnlineACHPayment": {
                        "type": "toggle",
                        "index": 38,
                        "label": "Allow Online ACH Payment",
                        "tooltip": "Specifies if this invoice can be paid with online bank transfers and corresponds to the Free bank transfer online payment check box on the QuickBooks UI. If set, allow invoice to be paid with online bank transfers. Otherwise, online bank transfers are not allowed."
                    },
                    "privateNote": {
                        "type": "text",
                        "index": 39,
                        "label": "Private Note",
                        "tooltip": "User entered, organization-private note about the transaction. This note does not appear on the invoice to the customer. This field maps to the Statement Memo field on the Invoice form in the QuickBooks Online UI."
                    },
                    "customerMemo": {
                        "type": "text",
                        "index": 40,
                        "label": "Customer Memo",
                        "tooltip": "User-entered message to the customer; this message is visible to end user on their transactions."
                    },
                    "exchangeRate": {
                        "type": "number",
                        "index": 41,
                        "label": "Exchange Rate",
                        "tooltip": "The number of home currency units it takes to equal one unit of currency specified by Currency. Applicable if multicurrency is enabled for the company."
                    },
                    "deposit": {
                        "type": "number",
                        "index": 42,
                        "label": "Deposit",
                        "tooltip": "The deposit made towards this invoice."
                    },
                    "allowOnlineCreditCardPayment": {
                        "type": "toggle",
                        "index": 43,
                        "label": "Allow Online Credit Card Payment",
                        "tooltip": "Specifies if online credit card payments are allowed for this invoice and corresponds to the Cards online payment check box on the QuickBooks UI. If set, allow invoice to be paid with online credit card payments. Otherwise, online credit card payments are not allowed."
                    },
                    "applyTaxAfterDiscount": {
                        "type": "toggle",
                        "index": 44,
                        "label": "Apply Tax After Discount",
                        "tooltip": "If not set, calculate the sales tax first, and then apply the discount. If set, subtract the discount first and then calculate the sales tax."
                    },
                    "txnDate": {
                        "type": "date-time",
                        "config": {
                            "format": "YYYY-MM-DD",
                            "enableTime": false
                        },
                        "index": 45,
                        "label": "Transaction Date",
                        "tooltip": "The date entered by the user when this transaction occurred."
                    }
                }
            },
            "schema": {
                "type": "object",
                "properties": {
                    "customerId": {
                        "type": "string"
                    },
                    "minorVersion": {
                        "type": "string"
                    },
                    "currency": {
                        "type": "string"
                    },
                    "dueDate": {
                        "type": "string",
                        "pattern": "^[0-9]{4}-[0|1][0-9]-[0-3][0-9]$"
                    },
                    "lineItems": {
                        "type": "object"
                    },
                    "lineItemsJSON": {
                        "type": "string"
                    },
                    "docNumber": {
                        "type": "string"
                    },
                    "billEmail": {
                        "type": "string"
                    },
                    "billEmailCc": {
                        "type": "string"
                    },
                    "billEmailBcc": {
                        "type": "string"
                    },
                    "billAddrPostalCode": {
                        "type": "string"
                    },
                    "billAddrCity": {
                        "type": "string"
                    },
                    "billAddrCountry": {
                        "type": "string"
                    },
                    "billAddrLine1": {
                        "type": "string"
                    },
                    "billAddrLine2": {
                        "type": "string"
                    },
                    "billAddrCountrySubDivisionCode": {
                        "type": "string"
                    },
                    "billAddrLat": {
                        "type": "string"
                    },
                    "billAddrLon": {
                        "type": "string"
                    },
                    "shipDate": {
                        "type": "string",
                        "pattern": "^[0-9]{4}-[0|1][0-9]-[0-3][0-9]$"
                    },
                    "shipAddrPostalCode": {
                        "type": "string"
                    },
                    "shipAddrCity": {
                        "type": "string"
                    },
                    "shipAddrCountry": {
                        "type": "string"
                    },
                    "shipAddrLine1": {
                        "type": "string"
                    },
                    "shipAddrLine2": {
                        "type": "string"
                    },
                    "shipAddrCountrySubDivisionCode": {
                        "type": "string"
                    },
                    "shipAddrLat": {
                        "type": "string"
                    },
                    "shipAddrLon": {
                        "type": "string"
                    },
                    "shipFromAddrPostalCode": {
                        "type": "string"
                    },
                    "shipFromAddrCity": {
                        "type": "string"
                    },
                    "shipFromAddrCountry": {
                        "type": "string"
                    },
                    "shipFromAddrLine1": {
                        "type": "string"
                    },
                    "shipFromAddrLine2": {
                        "type": "string"
                    },
                    "shipFromAddrCountrySubDivisionCode": {
                        "type": "string"
                    },
                    "shipFromAddrLat": {
                        "type": "string"
                    },
                    "shipFromAddrLon": {
                        "type": "string"
                    },
                    "trackingNum": {
                        "type": "string"
                    },
                    "printStatus": {
                        "type": "string"
                    },
                    "globalTaxCalculation": {
                        "type": "string"
                    },
                    "allowOnlineACHPayment": {
                        "type": "boolean"
                    },
                    "privateNote": {
                        "type": "string"
                    },
                    "customerMemo": {
                        "type": "string"
                    },
                    "exchangeRate": {
                        "type": "number"
                    },
                    "deposit": {
                        "type": "number"
                    },
                    "allowOnlineCreditCardPayment": {
                        "type": "boolean"
                    },
                    "applyTaxAfterDiscount": {
                        "type": "boolean"
                    },
                    "txnDate": {
                        "type": "string",
                        "pattern": "^[0-9]{4}-[0|1][0-9]-[0-3][0-9]$"
                    }
                },
                "required": ["customerId"]
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Txn Date",
                    "value": "TxnDate",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10"
                    }
                },
                {
                    "label": "Domain",
                    "value": "domain",
                    "schema": {
                        "type": "string",
                        "example": "QBO"
                    }
                },
                {
                    "label": "Print Status",
                    "value": "PrintStatus",
                    "schema": {
                        "type": "string",
                        "example": "NeedToPrint"
                    }
                },
                {
                    "label": "Sales Term Ref Value",
                    "value": "SalesTermRef.value",
                    "schema": {
                        "type": "string",
                        "example": "3"
                    }
                },
                {
                    "label": "Total Amt",
                    "value": "TotalAmt",
                    "schema": {
                        "type": "number",
                        "example": 1725
                    }
                },
                {
                    "label": "Line",
                    "value": "Line",
                    "schema": {
                        "type": "array",
                        "example": [
                            {
                                "Id": "1",
                                "LineNum": 1,
                                "Description": "Consulting services",
                                "Amount": 1500,
                                "DetailType": "SalesItemLineDetail",
                                "SalesItemLineDetail": {
                                    "ItemRef": {
                                        "value": "1",
                                        "name": "Services"
                                    },
                                    "UnitPrice": 150,
                                    "Qty": 10,
                                    "TaxCodeRef": {
                                        "value": "TAX"
                                    }
                                }
                            },
                            {
                                "Amount": 1500,
                                "DetailType": "SubTotalLineDetail",
                                "SubTotalLineDetail": {}
                            }
                        ]
                    }
                },
                {
                    "label": "Due Date",
                    "value": "DueDate",
                    "schema": {
                        "type": "string",
                        "example": "2026-10-10"
                    }
                },
                {
                    "label": "Apply Tax After Discount",
                    "value": "ApplyTaxAfterDiscount",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Doc Number",
                    "value": "DocNumber",
                    "schema": {
                        "type": "string",
                        "example": "1037"
                    }
                },
                {
                    "label": "Sparse",
                    "value": "sparse",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Customer Memo Value",
                    "value": "CustomerMemo.value",
                    "schema": {
                        "type": "string",
                        "example": "Thank you for your business!"
                    }
                },
                {
                    "label": "Deposit",
                    "value": "Deposit",
                    "schema": {
                        "type": "number",
                        "example": 0
                    }
                },
                {
                    "label": "Balance",
                    "value": "Balance",
                    "schema": {
                        "type": "number",
                        "example": 1725
                    }
                },
                {
                    "label": "Customer Ref Name",
                    "value": "CustomerRef.name",
                    "schema": {
                        "type": "string",
                        "example": "Acme Corporation"
                    }
                },
                {
                    "label": "Customer Ref Value",
                    "value": "CustomerRef.value",
                    "schema": {
                        "type": "string",
                        "example": "58"
                    }
                },
                {
                    "label": "Txn Tax Detail Txn Tax Code Ref Value",
                    "value": "TxnTaxDetail.TxnTaxCodeRef.value",
                    "schema": {
                        "type": "string",
                        "example": "2"
                    }
                },
                {
                    "label": "Txn Tax Detail Total Tax",
                    "value": "TxnTaxDetail.TotalTax",
                    "schema": {
                        "type": "number",
                        "example": 225
                    }
                },
                {
                    "label": "Txn Tax Detail Tax Line",
                    "value": "TxnTaxDetail.TaxLine",
                    "schema": {
                        "type": "array",
                        "example": [
                            {
                                "Amount": 225,
                                "DetailType": "TaxLineDetail",
                                "TaxLineDetail": {
                                    "TaxRateRef": {
                                        "value": "3"
                                    },
                                    "PercentBased": true,
                                    "TaxPercent": 15,
                                    "NetAmountTaxable": 1500
                                }
                            }
                        ]
                    }
                },
                {
                    "label": "Sync Token",
                    "value": "SyncToken",
                    "schema": {
                        "type": "string",
                        "example": "0"
                    }
                },
                {
                    "label": "Linked Txn",
                    "value": "LinkedTxn",
                    "schema": {
                        "type": "array",
                        "example": []
                    }
                },
                {
                    "label": "Bill Email Address",
                    "value": "BillEmail.Address",
                    "schema": {
                        "type": "string",
                        "example": "billing@acme.example.com"
                    }
                },
                {
                    "label": "Ship Addr City",
                    "value": "ShipAddr.City",
                    "schema": {
                        "type": "string",
                        "example": "San Francisco"
                    }
                },
                {
                    "label": "Ship Addr Line 5",
                    "value": "ShipAddr.Line5",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "Ship Addr Line 4",
                    "value": "ShipAddr.Line4",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "Ship Addr Line 3",
                    "value": "ShipAddr.Line3",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "Ship Addr Line 2",
                    "value": "ShipAddr.Line2",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "Suite 400"
                    }
                },
                {
                    "label": "Ship Addr Line 1",
                    "value": "ShipAddr.Line1",
                    "schema": {
                        "type": "string",
                        "example": "500 Howard St"
                    }
                },
                {
                    "label": "Ship Addr Postal Code",
                    "value": "ShipAddr.PostalCode",
                    "schema": {
                        "type": "string",
                        "example": "94105"
                    }
                },
                {
                    "label": "Ship Addr Lat",
                    "value": "ShipAddr.Lat",
                    "schema": {
                        "type": "string",
                        "example": "37.7894"
                    }
                },
                {
                    "label": "Ship Addr Long",
                    "value": "ShipAddr.Long",
                    "schema": {
                        "type": "string",
                        "example": "-122.3964"
                    }
                },
                {
                    "label": "Ship Addr Country Sub Division Code",
                    "value": "ShipAddr.CountrySubDivisionCode",
                    "schema": {
                        "type": "string",
                        "example": "CA"
                    }
                },
                {
                    "label": "Ship Addr Country",
                    "value": "ShipAddr.Country",
                    "schema": {
                        "type": "string",
                        "example": "USA"
                    }
                },
                {
                    "label": "Ship Addr Id",
                    "value": "ShipAddr.Id",
                    "schema": {
                        "type": "string",
                        "example": "121"
                    }
                },
                {
                    "label": "Email Status",
                    "value": "EmailStatus",
                    "schema": {
                        "type": "string",
                        "example": "NotSet"
                    }
                },
                {
                    "label": "Bill Addr Line 5",
                    "value": "BillAddr.Line5",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
