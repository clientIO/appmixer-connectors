{
    "name": "appmixer.jira.projects.CreateProject",
    "author": "Jimoh Damilola <jimoh@client.io>",
    "description": "Create a project in Jira. It does not work on Cloud Free Plan accounts.",
    "private": false,
    "auth": {
        "service": "appmixer:jira",
        "scope": [
            "write:project:jira",
            "read:project:jira"
        ]
    },
    "properties": {
        "schema": {
            "properties": {
                "projectType": {
                    "type": "string"
                }
            }
        },
        "inspector": {
            "inputs": {
                "projectType": {
                    "type": "select",
                    "label": "Project Type",
                    "index": 1,
                    "tooltip": "The project type, which dictates the application-specific feature set",
                    "options": [
                        {
                            "value": "business",
                            "content": "Jira Core"
                        },
                        {
                            "value": "service_desk",
                            "content": "Jira Service Desk"
                        },
                        {
                            "value": "software",
                            "content": "Jira Software"
                        }
                    ]
                }
            }
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "key": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "projectTemplateKey": {
                        "type": "string"
                    },
                    "assigneeType": {
                        "type": "string"
                    },
                    "leadAccountId": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "categoryId": {
                        "type": "string"
                    },
                    "url": {
                        "type": "string"
                    },
                    "avatarId": {
                        "type": "string"
                    },
                    "issueSecurityScheme": {
                        "type": "string"
                    },
                    "permissionScheme": {
                        "type": "string"
                    },
                    "notificationScheme": {
                        "type": "string"
                    }
                },
                "required": [
                    "key",
                    "name",
                    "projectTemplateKey"
                ]
            },
            "inspector": {
                "inputs": {
                    "key": {
                        "type": "text",
                        "label": "Project Key",
                        "index": 1,
                        "tooltip": "Project keys must be unique and start with an uppercase letter followed by one or more uppercase alphanumeric characters. The maximum length is 10 characters."
                    },
                    "name": {
                        "type": "text",
                        "label": "Project Name",
                        "index": 2,
                        "tooltip": "The name of the project."
                    },
                    "projectTemplateKey": {
                        "type": "select",
                        "label": "Project Template",
                        "index": 3,
                        "tooltip": "A prebuilt configuration for a project. The type of the project template must match with the type of the project type.",
                        "source": {
                            "url": "/component/appmixer/jira/projects/ListTemplates?outPort=templates",
                            "data": {
                                "properties": {
                                    "projectType": "properties/projectType"
                                }
                            }
                        }
                    },
                    "leadAccountId": {
                        "type": "text",
                        "label": "Lead Account ID",
                        "tooltip": "The account ID of the project lead. Leave empty to use the connected account's user.",
                        "index": 4,
                        "source": {
                            "url": "/component/appmixer/jira/issues/ListField?outPort=out",
                            "data": {
                                "messages": {
                                    "in": {
                                        "type": "assignee"
                                    }
                                },
                                "transform": "./ListField#fieldToSelectArray"
                            }
                        }
                    },
                    "description": {
                        "type": "text",
                        "tooltip": "A brief description of the project.",
                        "label": "Description",
                        "index": 5
                    },
                    "categoryId": {
                        "type": "text",
                        "label": "Category ID",
                        "index": 6,
                        "tooltip": "The ID of the project's category."
                    },
                    "assigneeType": {
                        "type": "select",
                        "label": "Assignee Type",
                        "index": 7,
                        "tooltip": "The default assignee when creating issues for this project.",
                        "options": [
                            {
                                "value": "PROJECT_LEAD",
                                "content": "Project Lead"
                            },
                            {
                                "value": "UNASSIGNED",
                                "content": "Unassigned"
                            }
                        ],
                        "defaultValue": "UNASSIGNED"
                    },
                    "url": {
                        "type": "text",
                        "label": "Project URL",
                        "index": 8,
                        "tooltip": "A link to information about this project, such as project documentation."
                    },
                    "avatarId": {
                        "type": "text",
                        "label": "Avatar ID",
                        "index": 9,
                        "tooltip": "An integer value for the project's avatar."
                    },
                    "issueSecurityScheme": {
                        "type": "text",
                        "label": "Security Issue",
                        "index": 10,
                        "tooltip": "The ID of the issue security scheme for the project, which enables you to control who can and cannot view issues."
                    },
                    "permissionScheme": {
                        "type": "text",
                        "label": "Permission Scheme",
                        "index": 11,
                        "tooltip": "The ID of the permission scheme for the project."
                    },
                    "notificationScheme": {
                        "type": "text",
                        "label": "Notification Scheme",
                        "index": 12,
                        "tooltip": "The ID of the notification scheme for the project"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "project",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Project ID",
                        "example": "10001"
                    },
                    "key": {
                        "type": "string",
                        "title": "Project Key",
                        "example": "PROJ"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
