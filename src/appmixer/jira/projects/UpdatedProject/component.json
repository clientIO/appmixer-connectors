{
    "name": "appmixer.jira.projects.UpdatedProject",
    "description": "Triggers when a project is updated (Webhook).",
    "author": "Jimoh Damilola <jimoh@client.io>",
    "webhook": true,
    "auth": {
        "service": "appmixer:jira",
        "scope": [
            "read:issue-type:jira",
            "read:project:jira",
            "read:project.property:jira",
            "read:user:jira",
            "read:application-role:jira",
            "read:avatar:jira",
            "read:group:jira",
            "read:issue-type-hierarchy:jira",
            "read:project-category:jira",
            "read:project-version:jira",
            "read:project.component:jira"
        ]
    },
    "properties": {
        "schema": {
            "properties": {
                "generateInspector": {
                    "type": "boolean"
                },
                "url": {}
            }
        },
        "inspector": {
            "inputs": {
                "url": {
                    "source": {
                        "url": "/component/appmixer/jira/projects/UpdatedProject?outPort=project",
                        "data": {
                            "properties": {
                                "generateInspector": true
                            }
                        }
                    }
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "project",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Project ID",
                        "example": "10001"
                    },
                    "key": {
                        "type": "string",
                        "title": "Project Key",
                        "example": "PROJ"
                    },
                    "name": {
                        "type": "string",
                        "title": "Project Name",
                        "example": "My Project"
                    },
                    "description": {
                        "type": "string",
                        "title": "Project Description",
                        "example": "A sample project."
                    },
                    "lead": {
                        "type": "object",
                        "title": "Project Lead",
                        "properties": {
                            "key": {
                                "type": "string",
                                "title": "Lead Key",
                                "example": "lead"
                            },
                            "accountId": {
                                "type": "string",
                                "title": "Lead Account ID",
                                "example": "5b10a2844c20165700ede21g"
                            },
                            "name": {
                                "type": "string",
                                "title": "Lead Name",
                                "example": "lead"
                            },
                            "avatarUrls": {
                                "type": "object",
                                "title": "Lead Avatar URLs",
                                "example": {
                                    "48x48": "https://example.atlassian.net/secure/useravatar?size=large&ownerId=lead&avatarId=10100"
                                }
                            },
                            "displayName": {
                                "type": "string",
                                "title": "Lead Display Name",
                                "example": "Project Lead"
                            },
                            "active": {
                                "type": "boolean",
                                "title": "Lead Status",
                                "example": true
                            }
                        }
                    },
                    "components": {
                        "type": "array",
                        "title": "Project Components",
                        "example": []
                    },
                    "issueTypes": {
                        "type": "array",
                        "title": "Project Issue Types",
                        "example": []
                    },
                    "email": {
                        "type": "string",
                        "title": "Project Email",
                        "example": "lead@example.com"
                    },
                    "url": {
                        "type": "string",
                        "title": "Project URL",
                        "example": "https://example.atlassian.net/browse/PROJ"
                    },
                    "assigneeType": {
                        "type": "string",
                        "title": "Project Assignee Type",
                        "example": "PROJECT_LEAD"
                    },
                    "versions": {
                        "type": "array",
                        "title": "Project versions",
                        "example": []
                    },
                    "roles": {
                        "type": "object",
                        "title": "Project Roles",
                        "example": {}
                    },
                    "avatarUrls": {
                        "type": "object",
                        "title": "Project Avatar URLs",
                        "example": {
                            "48x48": "https://example.atlassian.net/secure/projectavatar?size=large&avatarId=10324"
                        }
                    },
                    "projectCategory": {
                        "type": "object",
                        "title": "Project Category",
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Category ID",
                                "example": "10000"
                            },
                            "name": {
                                "type": "string",
                                "title": "Category Name",
                                "example": "First Category"
                            },
                            "description": {
                                "type": "string",
                                "title": "Category Description",
                                "example": "First category description."
                            }
                        }
                    },
                    "simplified": {
                        "type": "boolean",
                        "title": "Project Simplified",
                        "example": false
                    },
                    "style": {
                        "type": "string",
                        "title": "Project Style",
                        "example": "classic"
                    },
                    "properties": {
                        "type": "array",
                        "title": "Project Properties",
                        "example": []
                    },
                    "insight": {
                        "type": "object",
                        "title": "Project Insight",
                        "example": {
                            "totalIssueCount": 100,
                            "lastIssueUpdateTime": "2026-06-29T12:00:00.000+0000"
                        }
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
