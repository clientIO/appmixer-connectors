{
    "name": "appmixer.figma.core.FindComments",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Fetches all comments for a given Figma file, with support for an optional search query filter.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:figma"
    },
    "quota": {
        "manager": "appmixer:figma",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "fileId": {
                        "type": "string"
                    },
                    "query": {
                        "type": "string",
                        "default": ""
                    },
                    "outputType": {
                        "type": "string"
                    }
                },
                "required": [
                    "fileId"
                ]
            },
            "inspector": {
                "inputs": {
                    "fileId": {
                        "type": "text",
                        "tooltip": "The unique identifier of the Figma file whose comments are to be retrieved.",
                        "label": "File Id",
                        "index": 0
                    },
                    "query": {
                        "type": "text",
                        "tooltip": "Optional search term to filter comments.",
                        "label": "Query",
                        "index": 1
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "index": 2,
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/figma/core/FindComments?outPort=out",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType",
                        "in/fileId": "any"
                    }
                }
            }
        },
        {
            "name": "notFound",
            "options": [
                {
                    "label": "Message",
                    "value": "message",
                    "schema": {
                        "type": "string",
                        "example": "No comments found"
                    }
                },
                {
                    "label": "File Id",
                    "value": "fileId",
                    "schema": {
                        "type": "string",
                        "example": "ExampleFileKey123"
                    }
                }
            ]
            
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}