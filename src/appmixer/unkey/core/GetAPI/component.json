{
    "name": "appmixer.unkey.core.GetAPI",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieve information about a specific API.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:unkey"
    },
    "quota": {
        "manager": "appmixer:unkey",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "apiId": {
                        "type": "string"
                    }
                },
                "required": ["apiId"]
            },
            "inspector": {
                "inputs": {
                    "apiId": {
                        "type": "text",
                        "label": "API ID",
                        "index": 1,
                        "tooltip": "The ID of the API to retrieve"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": { "type": "string", "title": "API ID", "example": "api_4cFJhZ8wKqV2nRtX" },
                    "name": { "type": "string", "title": "Name", "example": "production" }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
