{
    "name": "appmixer.unkey.core.UpdateKeyCredits",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Update the credits for a key. Use this to set, increment, or decrement the number of credits available for a key.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:unkey"
    },
    "quota": {
        "manager": "appmixer:unkey",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "keyId": {
                        "type": "string"
                    },
                    "operation": {
                        "type": "string"
                    },
                    "value": {
                        "type": "integer"
                    }
                },
                "required": ["keyId", "operation", "value"]
            },
            "inspector": {
                "inputs": {
                    "keyId": {
                        "type": "text",
                        "label": "Key ID",
                        "index": 1,
                        "tooltip": "The ID of the key to update"
                    },
                    "operation": {
                        "type": "select",
                        "label": "Operation",
                        "index": 2,
                        "options": [
                            { "label": "Set", "value": "set" },
                            { "label": "Increment", "value": "increment" },
                            { "label": "Decrement", "value": "decrement" }
                        ],
                        "tooltip": "The operation to perform on the credits count"
                    },
                    "value": {
                        "type": "number",
                        "label": "Value",
                        "index": 3,
                        "tooltip": "The value to set, increment, or decrement"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "credits": { "type": ["integer", "null"], "title": "Credits", "example": 1500 },
                    "refill": {
                        "type": ["object", "null"],
                        "title": "Refill",
                        "example": { "interval": "monthly", "amount": 1000, "refillDay": 1 }
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
