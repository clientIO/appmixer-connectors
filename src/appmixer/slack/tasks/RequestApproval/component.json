{
    "name": "appmixer.slack.tasks.RequestApproval",
    "description": "Slack Task allows human approval inside workflows, with Slack user selection.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "webhook": true,
    "auth": {
        "service": "appmixer:slack",
        "scope": [
            "channels:read",
            "chat:write"
        ]
    },
    "quota": {
        "manager": "appmixer:slack:list",
        "resources": "postMessage",
        "maxWait": 30000,
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "task",
            "schema": {
                "type": "object",
                "properties": {
                    "title": { "type": "string" },
                    "description": { "type": "string" },
                    "requester": { "type": "string" },
                    "approver": { "type": "string" },
                    "decisionBy": { "type": "string", "format": "date-time" },
                    "channel": { "type": "string" }
                },
                "required": ["title", "description", "requester", "approver", "decisionBy", "channel"]
            },
            "inspector": {
                "inputs": {
                    "title": {
                        "type": "text",
                        "label": "Task title",
                        "index": 1,
                        "tooltip": "The title of the request."
                    },
                    "description": {
                        "type": "text",
                        "label": "Description",
                        "index": 2,
                        "tooltip": "The description of the request."
                    },
                    "requester": {
                        "type": "text",
                        "label": "Requester (Slack user)",
                        "index": 3,
                        "tooltip": "Select the Slack user who is the requester.",
                        "source": {
                            "url": "/component/appmixer/slack/list/ListUsers?outPort=out",
                            "data": {
                                "transform": "./transformers#usersToSelectArray",
                                "messages": {
                                    "in/outputType": "array",
                                    "in/isSource": true
                                }
                            }
                        }
                    },
                    "approver": {
                        "type": "text",
                        "label": "Approver (Slack user)",
                        "index": 4,
                        "tooltip": "Select the Slack user who is the approver.",
                        "source": {
                            "url": "/component/appmixer/slack/list/ListUsers?outPort=out",
                            "data": {
                                "transform": "./transformers#usersToSelectArray",
                                "messages": {
                                    "in/outputType": "array",
                                    "in/isSource": true
                                }
                            }
                        }
                    },
                    "decisionBy": {
                        "type": "date-time",
                        "label": "Decision by",
                        "index": 5,
                        "tooltip": "The time by which the request must be rejected or confirmed."
                    },
                    "channel": {
                        "type": "text",
                        "label": "Channel",
                        "index": 6,
                        "tooltip": "Select the Slack channel where the approval request will be posted.",
                        "source": {
                            "url": "/component/appmixer/slack/list/ListChannels?outPort=channels",
                            "data": {
                                "messages": {
                                    "in/types": "private_channel,public_channel"
                                },
                                "transform": "ListChannels#channelsToSelectArray"
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "created",
            "options": [
                {
                    "label": "Task ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "3f2b9c1e-7a4d-4e8b-9c6f-1d2e3a4b5c6d"
                    }
                },
                {
                    "label": "Title",
                    "value": "title",
                    "schema": {
                        "type": "string",
                        "example": "Approve Q3 marketing budget"
                    }
                },
                {
                    "label": "Description",
                    "value": "description",
                    "schema": {
                        "type": "string",
                        "example": "Please review the attached budget before Friday."
                    }
                },
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "string",
                        "example": "pending"
                    }
                },
                {
                    "label": "Approver",
                    "value": "approver",
                    "schema": {
                        "type": "string",
                        "example": "U0DEF67890"
                    }
                },
                {
                    "label": "Requester",
                    "value": "requester",
                    "schema": {
                        "type": "string",
                        "example": "U0ABC12345"
                    }
                },
                {
                    "label": "Decision by",
                    "value": "decisionBy",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-19T15:00:00.000Z"
                    }
                },
                {
                    "label": "Decision Made",
                    "value": "decisionMade",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                }
            ]
        },
        {
