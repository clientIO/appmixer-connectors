{
    "name": "appmixer.slack.files.GetFileMetadata",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Gets information about a file.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:slack",
        "scope": [
            "files:read"
        ]
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "file": {
                        "type": "string"
                    }
                },
                "required": [
                    "file"
                ]
            },
            "inspector": {
                "inputs": {
                    "file": {
                        "type": "text",
                        "index": 1,
                        "label": "Slack File ID",
                        "tooltip": "ID of file to retrieve."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Slack File ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "F07ABC12345"
                    }
                },
                {
                    "label": "Created",
                    "value": "created",
                    "schema": {
                        "type": "number",
                        "example": 1737024600
                    }
                },
                {
                    "label": "Timestamp",
                    "value": "timestamp",
                    "schema": {
                        "type": "number",
                        "example": 1737024600
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "project-plan.pdf"
                    }
                },
                {
                    "label": "Title",
                    "value": "title",
                    "schema": {
                        "type": "string",
                        "example": "Project Plan Q1 2026"
                    }
                },
                {
                    "label": "MIME Type",
                    "value": "mimetype",
                    "schema": {
                        "type": "string",
                        "example": "application/pdf"
                    }
                },
                {
                    "label": "File Type",
                    "value": "filetype",
                    "schema": {
                        "type": "string",
                        "example": "pdf"
                    }
                },
                {
                    "label": "Pretty Type",
                    "value": "pretty_type",
                    "schema": {
                        "type": "string",
                        "example": "PDF"
                    }
                },
                {
                    "label": "User",
                    "value": "user",
                    "schema": {
                        "type": "string",
                        "example": "U0ABC12345"
                    }
                },
                {
                    "label": "User Team",
                    "value": "user_team",
                    "schema": {
                        "type": "string",
                        "example": "T0ABC12345"
                    }
                },
                {
                    "label": "Editable",
                    "value": "editable",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Size",
                    "value": "size",
                    "schema": {
                        "type": "number",
                        "example": 524288
                    }
                },
                {
                    "label": "Mode",
                    "value": "mode",
                    "schema": {
                        "type": "string",
                        "example": "hosted"
                    }
                },
                {
                    "label": "Is External",
                    "value": "is_external",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "External Type",
                    "value": "external_type",
                    "schema": {
                        "type": "string",
                        "example": ""
                    }
                },
                {
                    "label": "Is Public",
                    "value": "is_public",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Public URL Shared",
                    "value": "public_url_shared",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Display As Bot",
                    "value": "display_as_bot",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Username",
                    "value": "username",
                    "schema": {
                        "type": "string",
                        "example": ""
                    }
                },
                {
                    "label": "URL Private",
                    "value": "url_private",
                    "schema": {
                        "type": "string",
                        "example": "https://files.slack.com/files-pri/T0ABC-F07ABC12345/project-plan.pdf"
                    }
                },
                {
                    "label": "URL Private Download",
                    "value": "url_private_download",
                    "schema": {
                        "type": "string",
                        "example": "https://files.slack.com/files-tmb/T0ABC-F07ABC12345/project-plan.pdf"
                    }
                },
                {
                    "label": "Media Display Type",
                    "value": "media_display_type",
                    "schema": {
                        "type": "string",
                        "example": "unknown"
                    }
                },
                {
                    "label": "Permalink",
                    "value": "permalink",
                    "schema": {
                        "type": "string",
                        "example": "https://myworkspace.slack.com/files/U0ABC/F07ABC12345/project-plan.pdf"
                    }
                },
                {
                    "label": "Permalink Public",
                    "value": "permalink_public",
                    "schema": {
                        "type": "string",
                        "example": "https://slack-files.com/T0ABC-F07ABC12345-a1b2c3d4e5"
                    }
                },
                {
                    "label": "Comments Count",
                    "value": "comments_count",
                    "schema": {
                        "type": "number",
                        "example": 0
                    }
                },
                {
                    "label": "Is Starred",
                    "value": "is_starred",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Shares",
                    "value": "shares",
                    "schema": {
                        "type": "object",
                        "example": {
                            "public": {
                                "C0ABC12345": [
                                    {
                                        "ts": "1737024600.111333",
                                        "channel_name": "general",
                                        "team_id": "T0ABC12345",
                                        "share_user_id": "U0ABC12345",
                                        "reply_count": 0
                                    }
                                ]
                            }
                        }
                    }
                },
                {
                    "label": "Channels",
                    "value": "channels",
                    "schema": {
                        "type": "array",
                        "example": "C0ABC12345"
                    }
                },
                {
                    "label": "Groups",
                    "value": "groups",
                    "schema": {
                        "type": "array",
                        "example": []
                    }
                },
                {
                    "label": "IMS",
                    "value": "ims",
                    "schema": {
                        "type": "array",
                        "example": []
                    }
                },
                {
                    "label": "Has More Shares",
                    "value": "has_more_shares",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Has Rich Preview",
                    "value": "has_rich_preview",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "File Access",
                    "value": "file_access",
                    "schema": {
                        "type": "string",
                        "example": "visible"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
