{
    "name": "appmixer.slack.list.NewUserWebhook",
    "label": "New User",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "This trigger fires every time a new user is created in or joins your team.",
    "private": false,
    "webhook": true,
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:slack",
        "scope": [
            "users:read"
        ]
    },
    "outPorts": [
        {
            "name": "user",
            "options": [
                {
                    "label": "User Id",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "U0GHI11223"
                    }
                },
                {
                    "label": "Team Id",
                    "value": "team_id",
                    "schema": {
                        "type": "string",
                        "example": "T0ABC12345"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "jane.doe"
                    }
                },
                {
                    "label": "Color",
                    "value": "color",
                    "schema": {
                        "type": "string",
                        "example": "9f69e7"
                    }
                },
                {
                    "label": "Real Name",
                    "value": "real_name",
                    "schema": {
                        "type": "string",
                        "example": "Jane Doe"
                    }
                },
                {
                    "label": "Tz",
                    "value": "tz",
                    "schema": {
                        "type": "string",
                        "example": "Europe/Prague"
                    }
                },
                {
                    "label": "Tz Label",
                    "value": "tz_label",
                    "schema": {
                        "type": "string",
                        "example": "Central European Summer Time"
                    }
                },
                {
                    "label": "Tz Offset",
                    "value": "tz_offset",
                    "schema": {
                        "type": "integer",
                        "example": 7200
                    }
                },
                {
                    "label": "Is Admin",
                    "value": "is_admin",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Is Owner",
                    "value": "is_owner",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Is Primary Owner",
                    "value": "is_primary_owner",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Is Restricted",
                    "value": "is_restricted",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Is Ultra Restricted",
                    "value": "is_ultra_restricted",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Is Bot",
                    "value": "is_bot",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Is App User",
                    "value": "is_app_user",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Updated",
                    "value": "updated",
                    "schema": {
                        "type": "integer",
                        "example": 1757493000
                    }
                },
                {
                    "label": "Profile Email",
                    "value": "profile.email",
                    "schema": {
                        "type": "string",
                        "example": "jane.doe@example.com"
                    }
                },
                {
                    "label": "Profile First Name",
                    "value": "profile.first_name",
                    "schema": {
                        "type": "string",
                        "example": "Jane"
                    }
                },
                {
                    "label": "Profile Last Name",
                    "value": "profile.last_name",
                    "schema": {
                        "type": "string",
                        "example": "Doe"
                    }
                },
                {
                    "label": "Profile Real Name",
                    "value": "profile.real_name",
                    "schema": {
                        "type": "string",
                        "example": "Jane Doe"
                    }
                },
                {
                    "label": "Profile Real Name Normalized",
                    "value": "profile.real_name_normalized",
                    "schema": {
                        "type": "string",
                        "example": "Jane Doe"
                    }
                },
                {
                    "label": "Profile Display Name",
                    "value": "profile.display_name",
                    "schema": {
                        "type": "string",
                        "example": "jane"
                    }
                },
                {
                    "label": "Profile Display Name Normalized",
                    "value": "profile.display_name_normalized",
                    "schema": {
                        "type": "string",
                        "example": "jane"
                    }
                }
            ]
        }
    ]
}
