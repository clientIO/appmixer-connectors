{
    "name": "appmixer.slack.list.NewChannelMessageRT",
    "label": "New Channel Message",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "This trigger fires every time a message is posted to a public or private channel.",
    "webhook": true,
    "version": "3.0.0",
    "auth": {
        "service": "appmixer:slack",
        "scope": [
            "channels:read",
            "groups:read",
            "channels:history"
        ]
    },
    "outPorts": [
        {
            "name": "message",
            "options": [
                {
                    "label": "Message Timestamp",
                    "value": "ts",
                    "schema": {
                        "type": "string",
                        "example": "1737024600.654321"
                    }
                },
                {
                    "label": "Message Type",
                    "value": "type",
                    "schema": {
                        "type": "string",
                        "example": "message"
                    }
                },
                {
                    "label": "Text",
                    "value": "text",
                    "schema": {
                        "type": "string",
                        "example": "Deployment completed successfully ✅"
                    }
                },
                {
                    "label": "User",
                    "value": "user",
                    "schema": {
                        "type": "string",
                        "example": "U0DEF67890"
                    }
                },
                {
                    "label": "App ID",
                    "value": "app_id",
                    "schema": {
                        "type": "string",
                        "example": "A0ABC12345"
                    }
                },
                {
                    "label": "Bot ID",
                    "value": "bot_id",
                    "schema": {
                        "type": "string",
                        "example": "B0ABC12345"
                    }
                },
                {
                    "label": "Team",
                    "value": "team",
                    "schema": {
                        "type": "string",
                        "example": "T0ABC12345"
                    }
                },
                {
                    "label": "Channel",
                    "value": "channel",
                    "schema": {
                        "type": "string",
                        "example": "C0ABC12345"
                    }
                },
                {
                    "label": "Channel Type",
                    "value": "channel_type",
                    "schema": {
                        "type": "string",
                        "example": "channel"
                    }
                },
                {
                    "label": "Event Timestamp",
                    "value": "event_ts",
                    "schema": {
                        "type": "string",
                        "example": "1737024600.654321"
                    }
                },
                {
                    "label": "Blocks",
                    "value": "blocks",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string"
                                },
                                "block_id": {
                                    "type": "string"
                                },
                                "elements": {
                                    "type": "array"
                                }
                            }
                        },
                        "example": [
                            {
                                "type": "rich_text",
                                "block_id": "Xk9pQ",
                                "elements": [
                                    {
                                        "type": "rich_text_section",
                                        "elements": [
                                            {
                                                "type": "text",
                                                "text": "Deployment completed successfully ✅"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                },
                {
                    "label": "Bot Profile",
                    "value": "bot_profile",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Bot Profile.Id"
                            },
                            "deleted": {
                                "type": "boolean",
                                "title": "Bot Profile.Deleted"
                            },
                            "name": {
                                "type": "string",
                                "title": "Bot Profile.Name"
                            },
                            "updated": {
                                "type": "number",
                                "title": "Bot Profile.Updated"
                            },
                            "app_id": {
                                "type": "string",
                                "title": "Bot Profile.App Id"
                            },
                            "icons": {
                                "type": "object",
                                "properties": {
                                    "image_36": {
                                        "type": "string",
                                        "title": "Bot Profile.Icons.Image 36"
                                    },
                                    "image_48": {
                                        "type": "string",
                                        "title": "Bot Profile.Icons.Image 48"
                                    },
                                    "image_72": {
                                        "type": "string",
                                        "title": "Bot Profile.Icons.Image 72"
                                    }
                                },
                                "title": "Bot Profile.Icons"
                            },
                            "team_id": {
                                "type": "string",
                                "title": "Bot Profile.Team Id"
                            }
                        },
                        "title": "Bot Profile",
                        "example": {
                            "id": "B0ABC12345",
                            "app_id": "A0ABC12345",
                            "name": "Deploy Bot",
                            "icons": {
                                "image_48": "https://avatars.slack-edge.com/2026-01-01/1234_48.png"
                            },
                            "deleted": false,
                            "team_id": "T0ABC12345"
                        }
                    }
                }
            ]
        }
    ],
    "properties": {
        "schema": {
            "properties": {
                "channelId": {
                    "type": "string"
                },
                "ignoreBotMessages": {
                    "type": "boolean"
                }
            },
            "required": [
                "channelId"
            ]
        },
        "inspector": {
            "inputs": {
                "channelId": {
                    "type": "text",
                    "label": "Channel",
                    "index": 1,
                    "source": {
                        "url": "/component/appmixer/slack/list/ListChannels?outPort=channels",
                        "data": {
                            "transform": "ListChannels#channelsToSelectArray"
                        }
                    },
                    "tooltip": "Select a channel."
                },
                "ignoreBotMessages": {
                    "type": "toggle",
                    "label": "Ignore bot messages. If enabled, the trigger will not fire when a bot posts a message.",
                    "defaultValue": true,
                    "index": 2
                }
            }
        }
    }
}
