{
    "name": "appmixer.logscale.core.SendEvent",
    "description": "Send a single event to CrowdStrike Falcon LogScale via the HTTP Event Collector ingestion API.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:logscale"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "event": {
                        "oneOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "object"
                            }
                        ]
                    },
                    "source": {
                        "type": "string"
                    },
                    "type": {
                        "type": "string"
                    },
                    "repository": {
                        "type": "string"
                    }
                },
                "required": [
                    "event"
                ]
            },
            "inspector": {
                "inputs": {
                    "event": {
                        "type": "textarea",
                        "label": "Event",
                        "index": 1,
                        "tooltip": "Event payload to ingest. You can provide plain text or a JSON object string."
                    },
                    "source": {
                        "type": "text",
                        "label": "Source",
                        "index": 2,
                        "tooltip": "Optional origin designation for the log event."
                    },
                    "type": {
                        "type": "text",
                        "label": "Type",
                        "index": 3,
                        "tooltip": "Optional parser or sourcetype value. Supports PACKAGENAME:PARSERNAME format."
                    },
                    "repository": {
                        "type": "text",
                        "label": "Repository",
                        "index": 4,
                        "tooltip": "Optional target repository name. Sent to LogScale as the index field."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Status Code",
                    "value": "status",
                    "schema": {
                        "type": "integer",
                        "example": 200
                    }
                },
                {
                    "label": "Response Headers",
                    "value": "headers",
                    "schema": {
                        "type": "object",
                        "properties": {},
                        "example": {
                            "content-type": "application/json",
                            "content-length": "27",
                            "date": "Wed, 10 Sep 2026 08:30:00 GMT"
                        }
                    }
                },
                {
                    "label": "Response Body",
                    "value": "body",
                    "schema": {
                        "type": "object",
                        "properties": {},
                        "example": {
                            "text": "Success",
                            "code": 0
                        }
                    }
                },
                {
                    "label": "Request Body",
                    "value": "requestBody",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "event": {},
                            "source": {
                                "type": "string"
                            },
                            "sourcetype": {
                                "type": "string"
                            },
                            "index": {
                                "type": "string"
                            },
                            "time": {
                                "type": "integer"
                            }
                        },
                        "example": {
                            "source": "prod-server-01",
                            "sourcetype": "json",
                            "index": "default",
                            "time": 1700000000
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
