{
    "name": "appmixer.logscale.core.SendEvents",
    "description": "Send multiple events to CrowdStrike Falcon LogScale via the HTTP Event Collector ingestion API.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:logscale"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "events": {
                        "type": "string"
                    },
                    "source": {
                        "type": "string"
                    },
                    "type": {
                        "type": "string"
                    },
                    "repository": {
                        "type": "string"
                    }
                },
                "required": [
                    "events"
                ]
            },
            "inspector": {
                "inputs": {
                    "events": {
                        "type": "textarea",
                        "label": "Events",
                        "index": 1,
                        "tooltip": "Batch payload as a JSON array or newline-delimited JSON objects. Lines can be full HEC objects or plain event values wrapped as JSON. Example: [{\"event\": \"login\", \"user\": \"john\"}, {\"event\": \"logout\", \"user\": \"jane\"}] or one per line."
                    },
                    "source": {
                        "type": "text",
                        "label": "Source",
                        "index": 2,
                        "tooltip": "Optional default origin designation applied to entries that do not already define source. Example: \"prod-server-01\" or \"application-logs\"."
                    },
                    "type": {
                        "type": "text",
                        "label": "Type",
                        "index": 3,
                        "tooltip": "Optional default parser or sourcetype value applied to entries that do not already define sourcetype. Example: \"json\", \"syslog\", \"apache_access\", or \"csv\"."
                    },
                    "repository": {
                        "type": "text",
                        "label": "Repository",
                        "index": 4,
                        "tooltip": "Optional default repository name applied to entries that do not already define index. Example: \"default\", \"security-logs\", or \"application-events\"."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Status Code",
                    "value": "status",
                    "schema": {
                        "type": "integer",
                        "example": 200
                    }
                },
                {
                    "label": "Response Headers",
                    "value": "headers",
                    "schema": {
                        "type": "object",
                        "properties": {},
                        "example": {
                            "content-type": "application/json",
                            "content-length": "27",
                            "date": "Wed, 10 Sep 2026 08:30:00 GMT"
                        }
                    }
                },
                {
                    "label": "Response Body",
                    "value": "body",
                    "schema": {
                        "type": "object",
                        "properties": {},
                        "example": {
                            "text": "Success",
                            "code": 0
                        }
                    }
                },
                {
                    "label": "Events Count",
                    "value": "eventsCount",
                    "schema": {
                        "type": "integer",
                        "example": 10
                    }
                },
                {
                    "label": "Request Body",
                    "value": "requestBody",
                    "schema": {
                        "type": "string",
                        "example": "{\"event\":\"login\",\"source\":\"prod-server-01\"}"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
