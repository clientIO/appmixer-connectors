{
    "name": "appmixer.postgres.db.Query",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Query your PostgreSQL database table.",
    "private": false,
    "auth": {
        "service": "appmixer:postgres"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "properties": {
                    "query": {
                        "type": "string"
                    },
                    "outputType": {
                        "type": "string"
                    },
                    "asyncMode": {
                        "type": "boolean"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "query": {
                        "type": "text",
                        "label": "Query",
                        "index": 1,
                        "tooltip": "Enter an SQL query."
                    },
                    "outputType": {
                        "type": "select",
                        "options": [
                            {
                                "content": "One row at a time",
                                "value": "row"
                            },
                            {
                                "content": "All rows at once",
                                "value": "rows"
                            },
                            {
                                "content": "Stream to file",
                                "value": "file"
                            }
                        ],
                        "index": 2,
                        "label": "Output Type",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or one row at a time or stream the rows to a file. For large datasets, streaming the rows to a file is the most efficient method (in Async Mode the result is streamed to a CSV file and only the File ID is delivered)."
                    },
                    "asyncMode": {
                        "type": "toggle",
                        "label": "Async Mode",
                        "index": 3,
                        "defaultValue": false,
                        "tooltip": "Enable for long-running queries that may exceed the standard timeout (~23 minutes). Uses the PostgreSQL dblink extension to execute the query asynchronously in a background read-only session. Requires CREATE EXTENSION IF NOT EXISTS dblink on the target database. Only a single read-only SELECT (or WITH ... SELECT) statement is supported. For large result sets choose the Stream to file output type — the result is streamed to a CSV file."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/postgres/db/Query?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        },
        {
            "name": "emptyResult",
            "options": [
                {
                    "label": "SQL Query",
                    "value": "query",
                    "schema": {
                        "type": "string",
                        "example": "SELECT * FROM users WHERE status = 'active'"
                    }
                },
                {
                    "label": "Message",
                    "value": "message",
                    "schema": {
                        "type": "string",
                        "example": "Query returned no results."
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
