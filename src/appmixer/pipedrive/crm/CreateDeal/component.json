{
    "name": "appmixer.pipedrive.crm.CreateDeal",
    "author": "Pawel Putko <pputko@ntrc.eu>",
    "description": "This action creates deal.",
    "inPorts": [
        {
            "name": "deal",
            "schema": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string"
                    },
                    "value": {
                        "type": "string"
                    },
                    "currency": {
                        "type": "string"
                    },
                    "user_id": {
                        "type": "number"
                    },
                    "org_id": {
                        "type": "number"
                    },
                    "person_id": {
                        "type": "number"
                    },
                    "stage_id": {
                        "type": "number"
                    },
                    "status": {
                        "enum": [
                            "open",
                            "won",
                            "lost",
                            "deleted"
                        ]
                    },
                    "lost_reason": {
                        "type": "string"
                    },
                    "visible_to": {},
                    "add_time": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "required": [
                    "title"
                ]
            },
            "inspector": {
                "inputs": {
                    "title": {
                        "type": "text",
                        "group": "transformation",
                        "index": 1,
                        "label": "Title",
                        "attrs": {
                            "label": {
                                "data-tooltip": "Deal title."
                            }
                        }
                    },
                    "value": {
                        "type": "text",
                        "group": "transformation",
                        "index": 2,
                        "label": "Value",
                        "attrs": {
                            "label": {
                                "data-tooltip": "Value of the deal."
                            }
                        }
                    },
                    "currency": {
                        "type": "text",
                        "group": "transformation",
                        "index": 3,
                        "label": "Currency",
                        "attrs": {
                            "label": {
                                "data-tooltip": "Currency of the deal. Accepts a 3-character currency code."
                            }
                        },
                        "source": {
                            "url": "/component/appmixer/pipedrive/crm/ListCurrencies?outPort=out",
                            "data": {
                                "transform": "./transformers#currenciesToSelectArray"
                            }
                        }
                    },
                    "user_id": {
                        "type": "text",
                        "group": "transformation",
                        "index": 4,
                        "label": "User id",
                        "attrs": {
                            "label": {
                                "data-tooltip": "Id of the user who will be marked as the owner of this deal."
                            }
                        },
                        "source": {
                            "url": "/component/appmixer/pipedrive/crm/ListUsers?outPort=out",
                            "data": {
                                "transform": "./transformers#usersToSelectArray"
                            }
                        }
                    },
                    "org_id": {
                        "type": "text",
                        "group": "transformation",
                        "index": 5,
                        "label": "Organization id",
                        "attrs": {
                            "label": {
                                "data-tooltip": "Id of the organization this deal will be associated with."
                            }
                        },
                        "source": {
                            "url": "/component/appmixer/pipedrive/crm/ListOrganizations?outPort=out",
                            "data": {
                                "transform": "./transformers#organizationsToSelectArray"
                            }
                        }
                    },
                    "person_id": {
                        "type": "text",
                        "group": "transformation",
                        "index": 6,
                        "label": "Person id",
                        "attrs": {
                            "label": {
                                "data-tooltip": "Id of the person this deal will be associated with."
                            }
                        },
                        "source": {
                            "url": "/component/appmixer/pipedrive/crm/ListPeople?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./transformers#peopleToSelectArray"
                            }
                        }
                    },
                    "stage_id": {
                        "type": "text",
                        "group": "transformation",
                        "index": 7,
                        "label": "Stage id",
                        "attrs": {
                            "label": {
                                "data-tooltip": "Id of the stage this deal will be placed in a pipeline"
                            }
                        },
                        "source": {
                            "url": "/component/appmixer/pipedrive/crm/ListStages?outPort=out",
                            "data": {
                                "transform": "./transformers#stagesToSelectArray"
                            }
                        }
                    },
                    "status": {
                        "type": "select",
                        "options": [
                            {
                                "value": "open",
                                "content": "Open"
                            },
                            {
                                "value": "won",
                                "content": "Won"
                            },
                            {
                                "value": "lost",
                                "content": "Lost"
                            },
                            {
                                "value": "deleted",
                                "content": "Deleted"
                            }
                        ],
                        "group": "transformation",
                        "index": 8,
                        "label": "Status",
                        "attrs": {
                            "label": {
                                "data-tooltip": "Value of the deal."
                            }
                        }
                    },
                    "lost_reason": {
                        "type": "text",
                        "group": "transformation",
                        "index": 9,
                        "label": "Lost reason",
                        "attrs": {
                            "label": {
                                "data-tooltip": "Optional message about why the deal was lost (to be used when status=lost)"
                            }
                        }
                    },
                    "visible_to": {
                        "type": "select",
                        "group": "transformation",
                        "index": 10,
                        "label": "Visible to",
                        "options": [
                            {
                                "content": "Owner & followers (private)",
                                "value": 1
                            },
                            {
                                "content": "Entire company (shared)",
                                "value": 3
                            }
                        ]
                    },
                    "add_time": {
                        "type": "date-time",
                        "group": "transformation",
                        "index": 11,
                        "label": "Add time",
                        "attrs": {
                            "label": {
                                "data-tooltip": "Optional creation date & time of the deal in UTC."
                            }
                        }
                    }
                },
                "groups": {
                    "transformation": {
                        "label": "Transformation",
                        "index": 1
                    }
                }
            }
        }
    ],
