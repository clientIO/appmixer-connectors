{
    "name": "appmixer.pipedrive.crm.NewActivity",
    "author": "Tomáš Waldauf <tomas@client.io>",
    "description": "This trigger fires any time a new activity is added to Pipedrive.",
    "tick": true,
    "outPorts": [
        {
            "name": "activity",
            "options": [
                {
                    "label": "id",
                    "value": "id",
                    "schema": {
                        "type": "integer",
                        "example": 1234
                    }
                },
                {
                    "label": "company_id",
                    "value": "company_id",
                    "schema": {
                        "type": "integer",
                        "example": 7654321
                    }
                },
                {
                    "label": "user_id",
                    "value": "user_id",
                    "schema": {
                        "type": "integer",
                        "example": 12345678
                    }
                },
                {
                    "label": "done",
                    "value": "done",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "type",
                    "value": "type",
                    "schema": {
                        "type": "string",
                        "example": "call"
                    }
                },
                {
                    "label": "reference_type",
                    "value": "reference_type",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "reference_id",
                    "value": "reference_id",
                    "schema": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "due_date",
                    "value": "due_date",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-15"
                    }
                },
                {
                    "label": "due_time",
                    "value": "due_time",
                    "schema": {
                        "type": "string",
                        "example": "14:00"
                    }
                },
                {
                    "label": "duration",
                    "value": "duration",
                    "schema": {
                        "type": "string",
                        "example": "00:30"
                    }
                },
                {
                    "label": "add_time",
                    "value": "add_time",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10 08:30:00"
                    }
                },
                {
                    "label": "marked_as_done_time",
                    "value": "marked_as_done_time",
                    "schema": {
                        "type": "string",
                        "example": ""
                    }
                },
                {
                    "label": "subject",
                    "value": "subject",
                    "schema": {
                        "type": "string",
                        "example": "Follow-up call"
                    }
                },
                {
                    "label": "deal_id",
                    "value": "deal_id",
                    "schema": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "example": 56
                    }
                },
                {
                    "label": "org_id",
                    "value": "org_id",
                    "schema": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "example": 98765432
                    }
                },
                {
                    "label": "person_id",
                    "value": "person_id",
                    "schema": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "example": 87654321
                    }
                },
                {
                    "label": "active_flag",
                    "value": "active_flag",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "update_time",
                    "value": "update_time",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10 08:30:00"
                    }
                },
                {
                    "label": "gcal_event_id",
                    "value": "gcal_event_id",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "google_calendar_id",
                    "value": "google_calendar_id",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "google_calendar_etag",
                    "value": "google_calendar_etag",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "note",
                    "value": "note",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "<p>Discuss the renewal terms.</p>"
                    }
                },
                {
                    "label": "person_name",
                    "value": "person_name",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "Michael Chen"
                    }
                },
                {
                    "label": "org_name",
                    "value": "org_name",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "Acme Corp"
                    }
                },
                {
                    "label": "deal_title",
                    "value": "deal_title",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "Enterprise deal - Acme Corp"
                    }
                },
                {
                    "label": "assigned_to_user_id",
                    "value": "assigned_to_user_id",
                    "schema": {
                        "type": "integer",
                        "example": 12345678
                    }
                },
                {
                    "label": "created_by_user_id",
                    "value": "created_by_user_id",
                    "schema": {
                        "type": "integer",
                        "example": 12345678
                    }
                },
                {
                    "label": "owner_name",
                    "value": "owner_name",
                    "schema": {
                        "type": "string",
                        "example": "Jane Doe"
                    }
                },
                {
                    "label": "person_dropbox_bcc",
                    "value": "person_dropbox_bcc",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "acme@pipedrivemail.com"
                    }
                },
                {
                    "label": "deal_dropbox_bcc",
                    "value": "deal_dropbox_bcc",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "acme+deal56@pipedrivemail.com"
                    }
                }
            ]
        }
    ],    
    "auth": {
        "service": "appmixer:pipedrive"
    },
    "quota": {
        "manager": "appmixer:pipedrive",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },    
    "properties": {},
    "icon": "data:image/svg+xml;base64,"
}
