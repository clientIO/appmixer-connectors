{
    "name": "appmixer.pipedrive.crm.NewProduct",
    "author": "Pawel Putko <pputko@ntrc.eu>",
    "description": "This trigger fires any time a new product is added to Pipedrive.",
    "tick": true,
    "outPorts": [
        {
            "name": "product",
            "options": [
                {
                    "label": "id",
                    "value": "id",
                    "schema": {
                        "type": "integer",
                        "example": 17
                    }
                },
                {
                    "label": "active_flag",
                    "value": "active_flag",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "add_time",
                    "value": "add_time",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10 08:30:00"
                    }
                },
                {
                    "label": "code",
                    "value": "code",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "ENT-ANNUAL"
                    }
                },
                {
                    "label": "files_count",
                    "value": "files_count",
                    "schema": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "first_char",
                    "value": "first_char",
                    "schema": {
                        "type": "string",
                        "example": "e"
                    }
                },
                {
                    "label": "followers_count",
                    "value": "followers_count",
                    "schema": {
                        "type": "integer",
                        "example": 1
                    }
                },
                {
                    "label": "name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Enterprise plan (annual)"
                    }
                },
                {
                    "label": "owner_id",
                    "value": "owner_id",
                    "schema": {
                        "type": "object",
                        "example": {
                            "id": 12345678,
                            "name": "Jane Doe",
                            "email": "jane.doe@acme.example.com",
                            "has_pic": 0,
                            "pic_hash": null,
                            "active_flag": true,
                            "value": 12345678
                        }
                    }
                },
                {
                    "label": "closed_deals_count",
                    "value": "closed_deals_count",
                    "schema": {
                        "type": "integer",
                        "example": 0
                    }
                },
                {
                    "label": "prices.[0].cost",
                    "value": "prices.[0].cost",
                    "schema": {
                        "type": "number",
                        "example": 0
                    }
                },
                {
                    "label": "prices.[0].currency",
                    "value": "prices.[0].currency",
                    "schema": {
                        "type": "string",
                        "example": "USD"
                    }
                },
                {
                    "label": "prices.[0].id",
                    "value": "prices.[0].id",
                    "schema": {
                        "type": "integer",
                        "example": 21
                    }
                },
                {
                    "label": "prices.[0].overhead_cost",
                    "value": "prices.[0].cost",
                    "schema": {
                        "type": "number",
                        "example": 0
                    }
                },
                {
                    "label": "prices.[0].price",
                    "value": "prices.[0].price",
                    "schema": {
                        "type": "number",
                        "example": 12000
                    }
                },
                {
                    "label": "prices.[0].product_id",
                    "value": "prices.[0].product_id",
                    "schema": {
                        "type": "integer",
                        "example": 17
                    }
                },
                {
                    "label": "selectable",
                    "value": "selectable",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "tax",
                    "value": "tax",
                    "schema": {
                        "type": "number",
                        "example": 0
                    }
                },
                {
                    "label": "unit",
                    "value": "unit",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "seat"
                    }
                },
                {
                    "label": "update_time",
                    "value": "update_time",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10 08:30:00"
                    }
                },
                {
                    "label": "visible_to",
                    "value": "visible_to",
                    "schema": {
                        "type": "string",
                        "example": "3"
                    }
                }
            ]
        }
    ],
    "auth": {
        "service": "appmixer:pipedrive"
    },
    "quota": {
        "manager": "appmixer:pipedrive",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "icon": "data:image/svg+xml;base64,"
}
