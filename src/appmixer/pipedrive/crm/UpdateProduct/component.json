{
    "name": "appmixer.pipedrive.crm.UpdateProduct",
    "author": "Pawel Putko <pputko@ntrc.eu>",
    "description": "This action creates new product to Pipedrive.",
    "inPorts": [
        {
            "name": "product",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "number"
                    },
                    "name": {
                        "type": "string"
                    },
                    "owner_id": {
                        "type": "number"
                    },
                    "code": {
                        "type": "string"
                    },
                    "unit": {
                        "type": "string"
                    },
                    "tax": {
                        "type": "number"
                    },
                    "visible_to": {},
                    "active_flag": {},
                    "currency": {
                        "type": "string"
                    },
                    "price": {
                        "type": "number"
                    },
                    "cost": {
                        "type": "number"
                    },
                    "overhead_cost": {
                        "type": "number"
                    }
                },
                "required": [
                    "id"
                ]
            },
            "inspector": {
                "inputs": {
                    "id": {
                        "type": "text",
                        "index": 0,
                        "label": "Product id",
                        "tooltip": "Id of product you want to update.",
                        "source": {
                            "url": "/component/appmixer/pipedrive/crm/ListProducts?outPort=out",
                            "data": {
                                "transform": "./transformers#productsToSelectArray"
                            }
                        }
                    },
                    "name": {
                        "type": "text",
                        "index": 1,
                        "label": "Name",
                        "tooltip": "Full name of product."
                    },
                    "owner_id": {
                        "type": "text",
                        "index": 2,
                        "label": "Owner id",
                        "tooltip": "Id of user who owns this contact.",
                        "source": {
                            "url": "/component/appmixer/pipedrive/crm/ListUsers?outPort=out",
                            "data": {
                                "transform": "./transformers#usersToSelectArray"
                            }
                        }
                    },
                    "code": {
                        "type": "text",
                        "index": 3,
                        "label": "Product code",
                        "tooltip": "Product code."
                    },
                    "unit": {
                        "type": "text",
                        "index": 4,
                        "label": "Unit",
                        "tooltip": "Unit in which this product is sold."
                    },
                    "tax": {
                        "type": "number",
                        "index": 5,
                        "label": "Tax",
                        "tooltip": "Tax percentage."
                    },
                    "visible_to": {
                        "type": "select",
                        "index": 6,
                        "label": "Visible to",
                        "tooltip": "Control whether the person is visible to your entire company or if you require more privacy.",
                        "options": [
                            {
                                "content": "Owner & followers (private)",
                                "value": 1
                            },
                            {
                                "content": "Entire company (shared)",
                                "value": 3
                            }
                        ]
                    },
                    "active_flag": {
                        "type": "select",
                        "index": 7,
                        "label": "Active flag",
                        "tooltip": "Whether this product will be made active or not.",
                        "options": [
                            {
                                "content": "Yes",
                                "value": 1
                            },
                            {
                                "content": "No",
                                "value": 0
                            }
                        ]
                    },
                    "currency": {
                        "type": "text",
                        "index": 8,
                        "label": "Currency",
                        "tooltip": "Currency.",
                        "source": {
                            "url": "/component/appmixer/pipedrive/crm/ListCurrencies?outPort=out",
                            "data": {
                                "transform": "./transformers#currenciesToSelectArray"
                            }
                        }
                    },
                    "price": {
                        "type": "number",
                        "index": 9,
                        "label": "Price",
                        "tooltip": "Price of product."
                    },
                    "cost": {
                        "type": "number",
                        "index": 10,
                        "label": "Cost",
                        "tooltip": "Cost of product (optional)."
                    },
                    "overhead_cost": {
                        "type": "number",
                        "index": 11,
                        "label": "Overhead cost",
                        "tooltip": "Overhead cost of product (optional)."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "updatedProduct",
            "options": [
                {
                    "label": "id",
                    "value": "id",
                    "schema": {
                        "type": "integer",
                        "example": 17
                    }
                },
                {
                    "label": "active_flag",
                    "value": "active_flag",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "add_time",
                    "value": "add_time",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10 08:30:00"
                    }
                },
                {
                    "label": "code",
                    "value": "code",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "ENT-ANNUAL"
                    }
                },
                {
                    "label": "files_count",
                    "value": "files_count",
                    "schema": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "first_char",
                    "value": "first_char",
                    "schema": {
                        "type": "string",
                        "example": "e"
                    }
                },
                {
                    "label": "followers_count",
                    "value": "followers_count",
                    "schema": {
                        "type": "integer",
                        "example": 1
                    }
                },
                {
                    "label": "name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Enterprise plan (annual)"
                    }
                },
                {
                    "label": "owner_id",
                    "value": "owner_id",
                    "schema": {
                        "type": "object",
                        "example": {
                            "id": 12345678,
                            "name": "Jane Doe",
                            "email": "jane.doe@acme.example.com",
                            "has_pic": 0,
                            "pic_hash": null,
                            "active_flag": true,
                            "value": 12345678
                        }
                    }
                },
                {
                    "label": "closed_deals_count",
                    "value": "closed_deals_count",
                    "schema": {
                        "type": "integer",
                        "example": 0
                    }
                },
                {
                    "label": "prices.[0].cost",
                    "value": "prices.[0].cost",
                    "schema": {
                        "type": "number",
                        "example": 0
                    }
                },
                {
                    "label": "prices.[0].currency",
                    "value": "prices.[0].currency",
                    "schema": {
                        "type": "string",
                        "example": "USD"
                    }
                },
                {
                    "label": "prices.[0].id",
                    "value": "prices.[0].id",
                    "schema": {
                        "type": "integer",
                        "example": 21
                    }
                },
                {
                    "label": "prices.[0].overhead_cost",
                    "value": "prices.[0].overhead_cost",
                    "schema": {
                        "type": "number",
                        "example": 0
                    }
                },
                {
                    "label": "prices.[0].price",
                    "value": "prices.[0].price",
                    "schema": {
                        "type": "number",
                        "example": 12000
                    }
                },
                {
                    "label": "prices.[0].product_id",
                    "value": "prices.[0].product_id",
                    "schema": {
                        "type": "integer",
                        "example": 17
                    }
                },
                {
                    "label": "selectable",
                    "value": "selectable",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "tax",
                    "value": "tax",
                    "schema": {
                        "type": "number",
                        "example": 0
                    }
                },
                {
                    "label": "unit",
                    "value": "unit",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "seat"
                    }
                },
                {
                    "label": "update_time",
                    "value": "update_time",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10 08:30:00"
                    }
                },
                {
                    "label": "visible_to",
                    "value": "visible_to",
                    "schema": {
                        "type": "string",
                        "example": "3"
                    }
                }
            ]
        }
    ],
    "auth": {
        "service": "appmixer:pipedrive"
    },
    "quota": {
        "manager": "appmixer:pipedrive",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "icon": "data:image/svg+xml;base64,"
}
