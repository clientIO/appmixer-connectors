{
    "name": "appmixer.pipedrive.crm.CreateLead",
    "author": "Appmixer <info@appmixer.com>",
    "description": "This action creates new lead to Pipedrive.",
    "inPorts": [
        {
            "name": "lead",
            "schema": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string"
                    },
                    "ownerId": {
                        "type": "number"
                    },
                    "organizationId": {
                        "type": "number"
                    },
                    "amount": {
                        "type": "number"
                    },
                    "currency": {
                        "type": "string"
                    },
                    "visibleTo": {
                        "type": "string"
                    }
                },
                "required": [
                    "title",
                    "organizationId",
                    "amount",
                    "currency"
                ]
            },
            "inspector": {
                "inputs": {
                    "title": {
                        "type": "text",
                        "group": "transformation",
                        "index": 1,
                        "label": "Title",
                        "tooltip": "Title of the lead."
                    },
                    "ownerId": {
                        "type": "text",
                        "group": "transformation",
                        "index": 2,
                        "label": "Owner id",
                        "tooltip": "Id of the user who will be assigned to the lead. If not provided, the user making the request will be used.",
                        "source": {
                            "url": "/component/appmixer/pipedrive/crm/ListUsers?outPort=out",
                            "data": {
                                "transform": "./transformers#usersToSelectArray"
                            }
                        }
                    },
                    "organizationId": {
                        "type": "text",
                        "group": "transformation",
                        "index": 3,
                        "label": "Organization id",
                        "tooltip": "Id of the organization to which the lead will be assigned.",
                        "source": {
                            "url": "/component/appmixer/pipedrive/crm/ListOrganizations?outPort=out",
                            "data": {
                                "transform": "./transformers#organizationsToSelectArray"
                            }
                        }
                    },
                    "amount": {
                        "type": "text",
                        "group": "transformation",
                        "index": 4,
                        "label": "Amount",
                        "tooltip": "The monetary value of the lead."
                    },
                    "currency": {
                        "type": "text",
                        "group": "transformation",
                        "index": 5,
                        "label": "Currency",
                        "tooltip": "The currency of the lead amount.",
                        "source": {
                            "url": "/component/appmixer/pipedrive/crm/ListCurrencies?outPort=out",
                            "data": {
                                "transform": "./transformers#currenciesToSelectArray"
                            }
                        }
                    },
                    "visibleTo": {
                        "type": "select",
                        "group": "transformation",
                        "index": 6,
                        "label": "Visible to",
                        "tooltip": "The visibility of the lead. If omitted, the visibility will be set to the default visibility setting of this item type for the authorized user.",
                        "options": [
                            {
                                "content": "Owner & followers (private)",
                                "value": "1"
                            },
                            {
                                "content": "Entire company (shared)",
                                "value": "3"
                            }
                        ]
                    }
                },
                "groups": {
                    "transformation": {
                        "label": "Transformation",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "newLead",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "abc-def-123-456"
                    }
                },
                {
                    "label": "Title",
                    "value": "title",
                    "schema": {
                        "type": "string",
                        "example": "Enterprise deal - Acme Corp"
                    }
                },
                {
                    "label": "Owner Id",
                    "value": "owner_id",
                    "schema": {
                        "type": "number",
                        "example": 12345678
                    }
                },
                {
                    "label": "Creator Id",
                    "value": "creator_id",
                    "schema": {
                        "type": "number",
                        "example": 12345678
                    }
                },
                {
                    "label": "Person Id",
                    "value": "person_id",
                    "schema": {
                        "type": "number",
                        "example": 87654321
                    }
                },
                {
                    "label": "Organization Id",
                    "value": "organization_id",
                    "schema": {
                        "type": "string",
                        "example": "98765432"
                    }
                },
                {
                    "label": "Source Name",
                    "value": "source_name",
                    "schema": {
                        "type": "string",
                        "example": "API"
                    }
                },
                {
                    "label": "Origin",
                    "value": "origin",
                    "schema": {
                        "type": "string",
                        "example": "API"
                    }
                },
                {
                    "label": "Origin Id",
                    "value": "origin_id",
                    "schema": {
                        "type": "string",
                        "example": ""
                    }
                },
                {
                    "label": "Channel",
                    "value": "channel",
                    "schema": {
                        "type": "number",
                        "example": 0
                    }
                },
                {
                    "label": "Channel Id",
                    "value": "channel_id",
                    "schema": {
                        "type": "string",
                        "example": ""
                    }
                },
                {
                    "label": "Is Archived",
                    "value": "is_archived",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Was Seen",
                    "value": "was_seen",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Amount",
                    "value": "value.amount",
                    "schema": {
                        "type": "number",
                        "example": 5000
                    }
                },
                {
                    "label": "Currency",
                    "value": "value.currency",
                    "schema": {
                        "type": "string",
                        "example": "USD"
                    }
                },
                {
                    "label": "Expected Close Date",
                    "value": "expected_close_date",
                    "schema": {
                        "type": "string",
                        "example": "2026-03-15"
                    }
                },
                {
                    "label": "Next Activity Id",
                    "value": "next_activity_id",
                    "schema": {
                        "type": "number",
                        "example": 0
                    }
                },
                {
                    "label": "Add Time",
                    "value": "add_time",
                    "schema": {
                        "type": "string",
                        "example": "2026-01-15T10:30:00Z"
                    }
                },
                {
                    "label": "Update Time",
                    "value": "update_time",
                    "schema": {
                        "type": "string",
                        "example": "2026-01-15T10:30:00Z"
                    }
                },
                {
                    "label": "Visible To",
                    "value": "visible_to",
                    "schema": {
                        "type": "string",
                        "example": "3"
                    }
                },
                {
                    "label": "Cc Email",
                    "value": "cc_email",
                    "schema": {
                        "type": "string",
                        "example": "company+deal@pipedrivemail.com"
                    }
                }
            ]
        }
    ],
    "auth": {
        "service": "appmixer:pipedrive"
    },
    "quota": {
        "manager": "appmixer:pipedrive",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "icon": "data:image/svg+xml;base64,"
}
