{
    "name": "appmixer.pipedrive.crm.NewPipeline",
    "author": "Pawel Putko <pputko@ntrc.eu>",
    "description": "This trigger fires any time a new pipeline is added to Pipedrive.",
    "tick": true,
    "outPorts": [
        {
            "name": "pipeline",
            "options": [
                {
                    "label": "id",
                    "value": "id",
                    "schema": {
                        "type": "integer",
                        "example": 3
                    }
                },
                {
                    "label": "active",
                    "value": "active",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "add_time",
                    "value": "add_time",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10 08:30:00"
                    }
                },
                {
                    "label": "name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Enterprise sales"
                    }
                },
                {
                    "label": "order_nr",
                    "value": "order_nr",
                    "schema": {
                        "type": "integer",
                        "example": 2
                    }
                },
                {
                    "label": "selected",
                    "value": "selected",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "update_time",
                    "value": "update_time",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "url_title",
                    "value": "url_title",
                    "schema": {
                        "type": "string",
                        "example": "enterprise-sales"
                    }
                }
            ]
        }
    ],
    "auth": {
        "service": "appmixer:pipedrive"
    },
    "quota": {
        "manager": "appmixer:pipedrive",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },    
    "icon": "data:image/svg+xml;base64,"
}
