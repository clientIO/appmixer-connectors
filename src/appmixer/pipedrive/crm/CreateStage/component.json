{
    "name": "appmixer.pipedrive.crm.CreateStage",
    "author": "Pawel Putko <pawel.putko@neoteric.eu>",
    "description": "This action creates new stage to Pipedrive.",
    "inPorts": [
        {
            "name": "stage",
            "schema": {
                "type": "object",
                "properties": {
                    "name": { "type": "string" },
                    "pipeline_id": { "type": "number" },
                    "deal_probability": { "type": "number" },
                    "rotten_flag": {},
                    "rotten_days": { "type": "number" }
                },
                "required": [
                    "name",
                    "pipeline_id"
                ]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "group": "transformation",
                        "index": 1,
                        "label": "Name",
                        "attrs": {
                            "label": { "data-tooltip": "Name of the stage." }
                        }
                    },
                    "pipeline_id": {
                        "type": "text",
                        "group": "transformation",
                        "index": 2,
                        "label": "Pipeline id",
                        "attrs": {
                            "label": { "data-tooltip": "Id of the pipeline to add stage to." }
                        },
                        "source": {
                            "url": "/component/appmixer/pipedrive/crm/ListPipelines?outPort=out",
                            "data": {
                                "transform": "./transformers#pipelinesToSelectArray"
                            }
                        }
                    },
                    "deal_probability": {
                        "type": "number",
                        "group": "transformation",
                        "index": 3,
                        "label": "Deal probability",
                        "attrs": {
                            "label": { "data-tooltip": "Deal success probability percentage. Used/shown when deal weighted values are used." }
                        }
                    },
                    "rotten_flag": {
                        "type": "select",
                        "group": "transformation",
                        "index": 4,
                        "label": "Rotten flag",
                        "attrs": {
                            "label": { "data-tooltip": "Whether deals in this stage can become rotten." }
                        },
                        "options": [
                            { "content": "YES", "value": 1 },
                            { "content": "NO", "value": 0 }
                        ]
                    },
                    "rotten_days": {
                        "type": "number",
                        "group": "transformation",
                        "index": 5,
                        "label": "Rotten days",
                        "when": {
                            "eq": {
                                "rotten_flag": true
                            }
                        },
                        "attrs": {
                            "label": { "data-tooltip": "Number of days the deals not updated in this stage would become rotten." }
                        }
                    }
                },
                "groups": {
                    "transformation": {
                        "label": "Transformation",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "newStage",
            "options": [
                {
                    "label": "id",
                    "value": "id",
                    "schema": {
                        "type": "integer",
                        "example": 7
                    }
                },
                {
                    "label": "active_flag",
                    "value": "active_flag",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "add_time",
                    "value": "add_time",
                    "schema": {
                        "type": "string",
                        "example": "2024-05-22 14:47:28"
                    }
                },
                {
                    "label": "deal_probability",
                    "value": "deal_probability",
                    "schema": {
                        "type": "integer",
                        "example": 60
                    }
                },
                {
                    "label": "name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Proposal made"
                    }
                },
                {
                    "label": "order_nr",
                    "value": "order_nr",
                    "schema": {
                        "type": "integer",
                        "example": 3
                    }
                },
                {
                    "label": "pipeline_id",
                    "value": "pipeline_id",
                    "schema": {
                        "type": "integer",
                        "example": 1
                    }
                },
                {
                    "label": "rotten_days",
                    "value": "rotten_days",
                    "schema": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "rotten_flag",
                    "value": "rotten_flag",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "update_time",
                    "value": "update_time",
                    "schema": {
                        "type": "string",
                        "example": "2024-05-22 14:47:28"
                    }
                }
            ]
        }
    ],
    "auth": {
        "service": "appmixer:pipedrive"
    },
    "quota": {
        "manager": "appmixer:pipedrive",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "icon": "data:image/svg+xml;base64,"
}
