{
    "name": "appmixer.pipedrive.crm.NewDeal",
    "author": "Tomáš Waldauf <tomas@client.io>",
    "description": "This trigger fires any time a new deal is added to Pipedrive.",
    "tick": true,
    "outPorts": [
        {
            "name": "deal",
            "options": [
                {
                    "label": "Deal id",
                    "value": "id",
                    "schema": {
                        "type": "integer",
                        "example": 56
                    }
                },
                {
                    "label": "Person id",
                    "value": "person_id",
                    "schema": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "example": {
                            "active_flag": true,
                            "name": "Michael Chen",
                            "email": [
                                {
                                    "label": "work",
                                    "value": "michael.chen@acme.example.com",
                                    "primary": true
                                }
                            ],
                            "phone": [
                                {
                                    "label": "work",
                                    "value": "+15552345678",
                                    "primary": true
                                }
                            ],
                            "owner_id": 12345678,
                            "value": 87654321
                        }
                    }
                },
                {
                    "label": "Organisation id",
                    "value": "org_id",
                    "schema": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "example": {
                            "name": "Acme Corp",
                            "people_count": 3,
                            "owner_id": 12345678,
                            "address": "500 Howard St, San Francisco, CA 94105, USA",
                            "active_flag": true,
                            "cc_email": "acme@pipedrivemail.com",
                            "value": 98765432
                        }
                    }
                },
                {
                    "label": "Stage id",
                    "value": "stage_id",
                    "schema": {
                        "type": "integer",
                        "example": 2
                    }
                },
                {
                    "label": "Title",
                    "value": "title",
                    "schema": {
                        "type": "string",
                        "example": "Enterprise deal - Acme Corp"
                    }
                },
                {
                    "label": "Value",
                    "value": "value",
                    "schema": {
                        "type": "number",
                        "example": 25000
                    }
                },
                {
                    "label": "Currency",
                    "value": "currency",
                    "schema": {
                        "type": "string",
                        "example": "USD"
                    }
                },
                {
                    "label": "Add time",
                    "value": "add_time",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10 08:30:00"
                    }
                },
                {
                    "label": "Update time",
                    "value": "update_time",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10 08:30:00"
                    }
                },
                {
                    "label": "Active",
                    "value": "active",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "Deleted",
                    "value": "deleted",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "string",
                        "example": "open"
                    }
                },
                {
                    "label": "Next activity date",
                    "value": "next_activity_date",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "2026-09-15"
                    }
                },
                {
                    "label": "Next activity time",
                    "value": "next_activity_time",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "14:00:00"
                    }
                },
                {
                    "label": "Lost reason",
                    "value": "lost_reason",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "Close time",
                    "value": "close_time",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "Pipeline id",
                    "value": "pipeline_id",
                    "schema": {
                        "type": "integer",
                        "example": 1
                    }
                },
                {
                    "label": "Won time",
                    "value": "won_time",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "Lost time",
                    "value": "lost_time",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "Products count",
                    "value": "products_count",
                    "schema": {
                        "type": "integer",
                        "example": 0
                    }
                },
                {
                    "label": "Person name",
                    "value": "person_name",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "Michael Chen"
                    }
                },
                {
                    "label": "Organisation name",
                    "value": "org_name",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "Acme Corp"
                    }
                },
                {
                    "label": "Formatted value",
                    "value": "formatted_value",
                    "schema": {
                        "type": "string",
                        "example": "$25,000"
                    }
                },
                {
                    "label": "Rotten time",
                    "value": "rotten_time",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "Cc email",
                    "value": "cc_email",
                    "schema": {
                        "type": "string",
                        "example": "acme+deal56@pipedrivemail.com"
                    }
                }
            ]
        }
    ],
    "auth": {
        "service": "appmixer:pipedrive"
    },
    "quota": {
        "manager": "appmixer:pipedrive",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },    
    "properties": {},
    "icon": "data:image/svg+xml;base64,"
}
