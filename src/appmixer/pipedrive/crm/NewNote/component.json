{
    "name": "appmixer.pipedrive.crm.NewNote",
    "author": "Pawel Putko <pawel.putko@neoteric.eu>",
    "description": "This trigger fires any time a new note is added to Pipedrive.",
    "tick": true,
    "outPorts": [
        {
            "name": "newNote",
            "options": [
                {
                    "label": "id",
                    "value": "id",
                    "schema": {
                        "type": "integer",
                        "example": 4321
                    }
                },
                {
                    "label": "active_flag",
                    "value": "active_flag",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "add_time",
                    "value": "add_time",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10 08:30:00"
                    }
                },
                {
                    "label": "content",
                    "value": "content",
                    "schema": {
                        "type": "string",
                        "example": "<p>Customer asked for a quote with annual billing.</p>"
                    }
                },
                {
                    "label": "deal.title",
                    "value": "deal.title",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "Enterprise deal - Acme Corp"
                    }
                },
                {
                    "label": "deal_id",
                    "value": "deal_id",
                    "schema": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "example": 56
                    }
                },
                {
                    "label": "last_update_user_id",
                    "value": "last_update_user_id",
                    "schema": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "organization.name",
                    "value": "organization.name",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "Acme Corp"
                    }
                },
                {
                    "label": "org_id",
                    "value": "org_id",
                    "schema": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "example": 98765432
                    }
                },
                {
                    "label": "person.name",
                    "value": "person.name",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "Michael Chen"
                    }
                },
                {
                    "label": "person_id",
                    "value": "person_id",
                    "schema": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "example": 87654321
                    }
                },
                {
                    "label": "pinned_to_deal_flag",
                    "value": "pinned_to_deal_flag",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "pinned_to_organization_flag",
                    "value": "pinned_to_organization_flag",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "pinned_to_person_flag",
                    "value": "pinned_to_person_flag",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "update_time",
                    "value": "update_time",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10 08:30:00"
                    }
                },
                {
                    "label": "user.email",
                    "value": "user.email",
                    "schema": {
                        "type": "string",
                        "example": "jane.doe@acme.example.com"
                    }
                },
                {
                    "label": "user.icon_url",
                    "value": "user['icon_url']",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "user.is_you",
                    "value": "user['is_you']",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "user.name",
                    "value": "user.name",
                    "schema": {
                        "type": "string",
                        "example": "Jane Doe"
                    }
                },
                {
                    "label": "user_id",
                    "value": "user_id",
                    "schema": {
                        "type": "integer",
                        "example": 12345678
                    }
                }
            ]
        }
    ],
    "auth": {
        "service": "appmixer:pipedrive"
    },
    "quota": {
        "manager": "appmixer:pipedrive",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },    
    "icon": "data:image/svg+xml;base64,"
}
