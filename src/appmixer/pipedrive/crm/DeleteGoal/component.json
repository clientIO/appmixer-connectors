{
    "name": "appmixer.pipedrive.crm.DeleteGoal",
    "author": "Pawel Putko <pawel.putko@neoteric.eu>",
    "description": "This action delete existing goal in pipedrive.",
    "private": true,
    "inPorts": [
        {
            "name": "goal",
            "schema": {
                "type": "object",
                "properties": {
                    "id": { "type": "string" }
                },
                "required": ["id"]
            },
            "inspector": {
                "inputs": {
                    "id": {
                        "type": "text",
                        "group": "transformation",
                        "index": 1,
                        "label": "Goal id",
                        "attrs": {
                            "label": { "data-tooltip": "Goal id." }
                        },
                        "source": {
                            "url": "/component/appmixer/pipedrive/crm/ListGoals?outPort=out",
                            "data": {
                                "transform": "./transformers#goalsToSelectArray"
                            }
                        }
                    }
                },
                "groups": {
                    "transformation": {
                        "label": "Transformation",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "deletedGoal",
            "options": [
                {
                    "label": "id",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "7d2c5e1a"
                    }
                }
            ]
        }
    ],
    "auth": {
        "service": "appmixer:pipedrive"
    },
    "quota": {
        "manager": "appmixer:pipedrive",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "icon": "data:image/svg+xml;base64,"
}
