{
    "name": "appmixer.docusign.esignature.RequestSignature",
    "author": "Harsha Surisetty <Harsha@client.io>",
    "description": "Request a signature for the attached document from a specified list of signers.",
    "icon": "data:image/svg+xml;base64,",    
    "private": false,
    "auth": {
        "service": "appmixer:docusign"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "signers": {
                        "type": "object"
                    },
                    "subject": {
                        "type": "string"
                    },
                    "message": {
                        "type": "string"
                    },
                    "documents": {
                        "type": "object"
                    }
                },
                "required": [
                    "signers", "subject", "documents"
                ]
            },
            "inspector": {
                "inputs": {
                    "signers": {
                        "type": "expression",
                        "label": "Signers",
                        "levels": [
                            "AND"
                        ],
                        "index": 1,
                        "tooltip": "List of signers.",
                        "fields": {
                            "email": {
                                "type": "text",
                                "label": "Email address",
                                "required": true,
                                "index": 1,
                                "tooltip": "Provide an email address of the signer of the document."
                            },
                            "name": {
                                "type": "text",
                                "label": "Name",
                                "index": 2,
                                "required": true,
                                "tooltip": "Provide a name of the signer."
                            }
                        }
                    },
                    "subject": {
                        "type": "text",
                        "label": "Subject",
                        "index": 2
                    },
                    "message": {
                        "type": "textarea",
                        "label": "Message",
                        "index": 3
                    },
                    "documents": {
                        "type": "expression",
                        "label": "Document",
                        "levels": [
                            "AND"
                        ],
                        "index": 4,
                        "tooltip": "Select Documents",
                        "fields": {
                            "document": {
                                "type": "filepicker",
                                "label": "Document",
                                "required": true,
                                "tooltip": " A document to sign.",
                                "index": 1
                            },
                            "name": {
                                "type": "text",
                                "label": "Name",
                                "index": 2,
                                "tooltip": "Provide a name of the document."
                            },
                            "fileExtension": {
                                "type": "text",
                                "label": "File Extension",
                                "index": 3,
                                "required": true,
                                "tooltip": "Provide a extension of the file."
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Envelope ID",
                    "value": "envelopeId",
                    "schema": {
                        "type": "string",
                        "example": "1a2b3c4d-5e6f-7890-abcd-ef1234567890"
                    }
                },
                {
                    "label": "Envelope Uri",
                    "value": "uri",
                    "schema": {
                        "type": "string",
                        "example": "/envelopes/1a2b3c4d-5e6f-7890-abcd-ef1234567890"
                    }
                },
                {
                    "label": "Status Date Time",
                    "value": "statusDateTime",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:06.0000000Z"
                    }
                },
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "string",
                        "example": "sent"
                    }
                }
            ]
        },
        {
            "name": "completed",
            "options": [
                {
                    "label": "Status",
                    "value": "data.envelopeSummary.status",
                    "schema": {
                        "type": "string",
                        "example": "completed"
                    }
                },
                {
                    "label": "Documents Uri",
                    "value": "data.envelopeSummary.documentsUri",
                    "schema": {
                        "type": "string",
                        "example": "/envelopes/1a2b3c4d-5e6f-7890-abcd-ef1234567890/documents"
                    }
                },
                {
                    "label": "Recipients Uri",
                    "value": "data.envelopeSummary.recipientsUri",
                    "schema": {
                        "type": "string",
                        "example": "/envelopes/1a2b3c4d-5e6f-7890-abcd-ef1234567890/recipients"
                    }
                },
                {
                    "label": "Attachments Uri",
                    "value": "data.envelopeSummary.attachmentsUri",
                    "schema": {
                        "type": "string",
                        "example": "/envelopes/1a2b3c4d-5e6f-7890-abcd-ef1234567890/attachments"
                    }
                },
                {
                    "label": "Envelope Uri",
                    "value": "data.envelopeSummary.envelopeUri",
                    "schema": {
                        "type": "string",
                        "example": "/envelopes/1a2b3c4d-5e6f-7890-abcd-ef1234567890"
                    }
                },
                {
                    "label": "Email Subject",
                    "value": "data.envelopeSummary.emailSubject",
                    "schema": {
                        "type": "string",
                        "example": "Please sign: Service Agreement"
                    }
                },
                {
                    "label": "Email Blurb",
                    "value": "data.envelopeSummary.emailBlurb",
                    "schema": {
                        "type": "string",
                        "example": "Hi John, please review and sign the attached agreement."
                    }
                },
                {
                    "label": "Envelope Id",
                    "value": "data.envelopeId",
                    "schema": {
                        "type": "string",
                        "example": "1a2b3c4d-5e6f-7890-abcd-ef1234567890"
                    }
                },
                {
                    "label": "Signing Location",
                    "value": "data.envelopeSummary.signingLocation",
                    "schema": {
                        "type": "string",
                        "example": "online"
                    }
                },
                {
                    "label": "Custom Fields Uri",
                    "value": "data.envelopeSummary.customFieldsUri",
                    "schema": {
                        "type": "string",
                        "example": "/envelopes/1a2b3c4d-5e6f-7890-abcd-ef1234567890/custom_fields"
                    }
                },
                {
                    "label": "Notification Uri",
                    "value": "data.envelopeSummary.notificationUri",
                    "schema": {
                        "type": "string",
                        "example": "/envelopes/1a2b3c4d-5e6f-7890-abcd-ef1234567890/notification"
                    }
                },
                {
                    "label": "Enable Wet Sign",
                    "value": "data.envelopeSummary.enableWetSign",
                    "schema": {
                        "type": "string",
                        "example": "true"
                    }
                },
                {
                    "label": "Allow Markup",
                    "value": "data.envelopeSummary.allowMarkup",
                    "schema": {
                        "type": "string",
                        "example": "false"
                    }
                },
                {
                    "label": "Allow Reassign",
                    "value": "data.envelopeSummary.allowReassign",
                    "schema": {
                        "type": "string",
                        "example": "true"
                    }
                },
                {
                    "label": "Created Date Time",
                    "value": "data.envelopeSummary.createdDateTime",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00.0000000Z"
                    }
                },
                {
                    "label": "Last Modified Date Time",
                    "value": "data.envelopeSummary.lastModifiedDateTime",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:05.0000000Z"
                    }
                },
                {
                    "label": "Delivered Date Time",
                    "value": "data.envelopeSummary.deliveredDateTime",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:41:02.0000000Z"
                    }
                },
                {
                    "label": "Initial Sent Date Time",
                    "value": "data.envelopeSummary.initialSentDateTime",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:06.0000000Z"
                    }
                },
                {
                    "label": "Sent Date Time",
                    "value": "data.envelopeSummary.sentDateTime",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:06.0000000Z"
                    }
                },
                {
                    "label": "Completed Date Time",
                    "value": "data.envelopeSummary.completedDateTime",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T09:12:44.0000000Z"
                    }
                },
                {
                    "label": "Status Changed Date Time",
                    "value": "data.envelopeSummary.statusChangedDateTime",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T09:12:44.0000000Z"
                    }
                },
                {
                    "label": "Documents Combined Uri",
                    "value": "data.envelopeSummary.documentsCombinedUri",
                    "schema": {
                        "type": "string",
                        "example": "/envelopes/1a2b3c4d-5e6f-7890-abcd-ef1234567890/documents/combined"
                    }
                },
                {
                    "label": "Certificate Uri",
                    "value": "data.envelopeSummary.certificateUri",
                    "schema": {
                        "type": "string",
                        "example": "/envelopes/1a2b3c4d-5e6f-7890-abcd-ef1234567890/documents/certificate"
                    }
                },
                {
                    "label": "Templates Uri",
                    "value": "data.envelopeSummary.templatesUri",
                    "schema": {
                        "type": "string",
                        "example": "/envelopes/1a2b3c4d-5e6f-7890-abcd-ef1234567890/templates"
                    }
                },
                {
                    "label": "Expire Enabled",
                    "value": "data.envelopeSummary.expireEnabled",
                    "schema": {
                        "type": "string",
                        "example": "true"
                    }
                },
                {
                    "label": "Expire Date Time",
                    "value": "data.envelopeSummary.expireDateTime",
                    "schema": {
                        "type": "string",
                        "example": "2027-01-08T08:30:06.0000000Z"
                    }
                },
                {
                    "label": "Expire After",
                    "value": "data.envelopeSummary.expireAfter",
                    "schema": {
                        "type": "string",
                        "example": "120"
                    }
                },
                {
                    "label": "Sender.user Name",
                    "value": "data.envelopeSummary.sender.userName",
                    "schema": {
                        "type": "string",
                        "example": "Jane Doe"
                    }
                },
                {
                    "label": "Sender.user Id",
                    "value": "data.envelopeSummary.sender.userId",
                    "schema": {
                        "type": "string",
                        "example": "b5c2d3e4-f5a6-7890-bcde-f01234567890"
                    }
                },
                {
                    "label": "Sender.account Id",
                    "value": "data.envelopeSummary.sender.accountId",
                    "schema": {
                        "type": "string",
                        "example": "a4b1c2d3-e4f5-6789-abcd-ef0123456789"
                    }
                },
                {
                    "label": "Sender.email",
                    "value": "data.envelopeSummary.sender.email",
                    "schema": {
                        "type": "string",
                        "example": "jane.doe@example.com"
                    }
                },
                {
                    "label": "Purge State",
                    "value": "data.envelopeSummary.purgeState",
                    "schema": {
                        "type": "string",
                        "example": "unpurged"
                    }
                },
                {
                    "label": "Envelope Id Stamping",
                    "value": "data.envelopeSummary.envelopeIdStamping",
                    "schema": {
                        "type": "string",
                        "example": "true"
                    }
                },
                {
                    "label": "Is21 C F R Part11",
                    "value": "data.envelopeSummary.is21CFRPart11",
                    "schema": {
                        "type": "string",
                        "example": "false"
                    }
                },
                {
                    "label": "Signer Can Sign On Mobile",
                    "value": "data.envelopeSummary.signerCanSignOnMobile",
                    "schema": {
                        "type": "string",
                        "example": "true"
                    }
                },
                {
                    "label": "Auto Navigation",
                    "value": "data.envelopeSummary.autoNavigation",
                    "schema": {
                        "type": "string",
                        "example": "true"
                    }
                },
                {
                    "label": "Is Signature Provider Envelope",
                    "value": "data.envelopeSummary.isSignatureProviderEnvelope",
                    "schema": {
                        "type": "string",
                        "example": "false"
                    }
                },
                {
                    "label": "Has Form Data Changed",
                    "value": "data.envelopeSummary.hasFormDataChanged",
                    "schema": {
                        "type": "string",
                        "example": "false"
                    }
                },
                {
                    "label": "Allow Comments",
                    "value": "data.envelopeSummary.allowComments",
                    "schema": {
                        "type": "string",
                        "example": "true"
                    }
                },
                {
                    "label": "Has Comments",
                    "value": "data.envelopeSummary.hasComments",
                    "schema": {
                        "type": "string",
                        "example": "false"
                    }
                },
                {
                    "label": "Allow View History",
                    "value": "data.envelopeSummary.allowViewHistory",
                    "schema": {
                        "type": "string",
                        "example": "true"
                    }
                },
                {
                    "label": "Envelope Metadata.allow Advanced Correct",
                    "value": "data.envelopeSummary.envelopeMetadata.allowAdvancedCorrect",
                    "schema": {
                        "type": "string",
                        "example": "true"
                    }
                },
                {
                    "label": "Envelope Metadata.enable Sign With Notary",
                    "value": "data.envelopeSummary.envelopeMetadata.enableSignWithNotary",
                    "schema": {
                        "type": "string",
                        "example": "false"
                    }
                },
                {
                    "label": "Envelope Metadata.allow Correct",
                    "value": "data.envelopeSummary.envelopeMetadata.allowCorrect",
                    "schema": {
                        "type": "string",
                        "example": "true"
                    }
                },
                {
                    "label": "Any Signer",
                    "value": "data.envelopeSummary.anySigner",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "Envelope Location",
                    "value": "data.envelopeSummary.envelopeLocation",
                    "schema": {
                        "type": "string",
                        "example": "current_site"
                    }
                },
                {
                    "label": "Is Dynamic Envelope",
                    "value": "data.envelopeSummary.isDynamicEnvelope",
                    "schema": {
                        "type": "string",
                        "example": "false"
                    }
                }
            ]
        }
    ]
}
