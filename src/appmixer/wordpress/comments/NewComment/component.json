{
    "name": "appmixer.wordpress.comments.NewComment",
    "author": "Tomasz Hencel <thencel@ntrc.eu>",
    "description": "This trigger fires every time a new comment is added.",
    "private": false,
    "tick": true,
    "auth": {
        "service": "appmixer:wordpress",
        "scope": ["global"]
    },
    "outPorts": [
        {
            "name": "comment",
            "options": [
                {
                    "label": "ID",
                    "value": "ID",
                    "schema": {
                        "type": "integer",
                        "example": 87
                    }
                },
                {
                    "label": "URL",
                    "value": "URL",
                    "schema": {
                        "type": "string",
                        "example": "https://acmeblog.wordpress.com/2026/09/10/hello-automation/#comment-87"
                    }
                },
                {
                    "label": "post.title",
                    "value": "post.title",
                    "schema": {
                        "type": "string",
                        "example": "Hello automation"
                    }
                },
                {
                    "label": "post.ID",
                    "value": "post.ID",
                    "schema": {
                        "type": "integer",
                        "example": 1042
                    }
                },
                {
                    "label": "post.type",
                    "value": "post.type",
                    "schema": {
                        "type": "string",
                        "example": "post"
                    }
                },
                {
                    "label": "post.link",
                    "value": "post.link",
                    "schema": {
                        "type": "string",
                        "example": "https://public-api.wordpress.com/rest/v1.1/sites/123456789/posts/1042"
                    }
                },
                {
                    "label": "author.ID",
                    "value": "author.ID",
                    "schema": {
                        "type": "integer",
                        "example": 23456789
                    }
                },
                {
                    "label": "author.URL",
                    "value": "author.URL",
                    "schema": {
                        "type": "string",
                        "example": "https://johnreader.example.com"
                    }
                },
                {
                    "label": "author.login",
                    "value": "author.login",
                    "schema": {
                        "type": "string",
                        "example": "johnreader"
                    }
                },
                {
                    "label": "author.email",
                    "value": "author.email",
                    "schema": {
                        "type": [
                            "string",
                            "boolean"
                        ],
                        "example": false
                    }
                },
                {
                    "label": "author.name",
                    "value": "author.name",
                    "schema": {
                        "type": "string",
                        "example": "John Reader"
                    }
                },
                {
                    "label": "author.first_name",
                    "value": "author.first_name",
                    "schema": {
                        "type": "string",
                        "example": "John"
                    }
                },
                {
                    "label": "author.last_name",
                    "value": "author.last_name",
                    "schema": {
                        "type": "string",
                        "example": "Reader"
                    }
                },
                {
                    "label": "author.nice_name",
                    "value": "author.nice_name",
                    "schema": {
                        "type": "string",
                        "example": "johnreader"
                    }
                },
                {
                    "label": "author.avatar_URL",
                    "value": "author.avatar_URL",
                    "schema": {
                        "type": "string",
                        "example": "https://0.gravatar.com/avatar/b1946ac92492d2347c6235b4d2611184?s=96&d=identicon&r=G"
                    }
                },
                {
                    "label": "author.profile_URL",
                    "value": "author.profile_URL",
                    "schema": {
                        "type": "string",
                        "example": "https://gravatar.com/johnreader"
                    }
                },
                {
                    "label": "author.site_ID",
                    "value": "author.site_ID",
                    "schema": {
                        "type": "integer",
                        "example": 0
                    }
                },
                {
                    "label": "date ",
                    "value": "date",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T11:02:00+02:00"
                    }
                },
                {
                    "label": "short_URL",
                    "value": "short_URL",
                    "schema": {
                        "type": "string",
                        "example": "https://wp.me/pNxYz-gO%23comment-87"
                    }
                },
                {
                    "label": "content",
                    "value": "content",
                    "schema": {
                        "type": "string",
                        "example": "<p>Great write-up, thanks!</p>\n"
                    }
                },
                {
                    "label": "status",
                    "value": "status",
                    "schema": {
                        "type": "string",
                        "example": "approved"
                    }
                },
                {
                    "label": "parent.ID",
                    "value": "parent.ID",
                    "schema": {
                        "type": "integer",
                        "example": 85
                    }
                },
                {
                    "label": "parent.type",
                    "value": "parent.type",
                    "schema": {
                        "type": "string",
                        "example": "comment"
                    }
                },
                {
                    "label": "parent.link",
                    "value": "parent.link",
                    "schema": {
                        "type": "string",
                        "example": "https://public-api.wordpress.com/rest/v1.1/sites/123456789/comments/85"
                    }
                },
                {
                    "label": "type",
                    "value": "type",
                    "schema": {
                        "type": "string",
                        "example": "comment"
                    }
                },
                {
                    "label": "like_count",
                    "value": "like_count",
                    "schema": {
                        "type": "integer",
                        "example": 0
                    }
                },
                {
                    "label": "i_like",
                    "value": "i_like",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "meta.links.help",
                    "value": "meta.links.help",
                    "schema": {
                        "type": "string",
                        "example": "https://public-api.wordpress.com/rest/v1.1/sites/123456789/comments/87/help"
                    }
                },
                {
                    "label": "meta.links.likes",
                    "value": "meta.links.likes",
                    "schema": {
                        "type": "string",
                        "example": "https://public-api.wordpress.com/rest/v1.1/sites/123456789/comments/87/likes/"
                    }
                },
                {
                    "label": "meta.links.post",
                    "value": "meta.links.post",
                    "schema": {
                        "type": "string",
                        "example": "https://public-api.wordpress.com/rest/v1.1/sites/123456789/posts/1042"
                    }
                },
                {
                    "label": "meta.links.replies",
                    "value": "meta.links.replies",
                    "schema": {
                        "type": "string",
                        "example": "https://public-api.wordpress.com/rest/v1.1/sites/123456789/comments/87/replies/"
                    }
                },
                {
                    "label": "meta.links.self",
                    "value": "meta.links.self",
                    "schema": {
                        "type": "string",
                        "example": "https://public-api.wordpress.com/rest/v1.1/sites/123456789/comments/87"
                    }
                },
                {
                    "label": "meta.links.site",
                    "value": "meta.links.site",
                    "schema": {
                        "type": "string",
                        "example": "https://public-api.wordpress.com/rest/v1.1/sites/123456789"
                    }
                }
            ]
        }
    ],
    "properties": {
        "schema": {
            "properties": {
                "siteId": {
                    "type": "number"
                },
                "postId": {
                    "type": "number"
                }
            },
            "required": [
                "siteId"
            ]
        },
        "inspector": {
            "inputs": {
                "siteId": {
                    "type": "text",
                    "label": "Site",
                    "index": 1,
                    "source": {
                        "url": "/component/appmixer/wordpress/posts/ListSites?outPort=sites",
                        "data": {
                            "transform": "./transformers#sitesToSelectArray"
                        }
                    },
                    "tooltip": "Select a site."
                },
                "postId": {
                    "type": "text",
                    "label": "Post",
                    "index": 2,
                    "source": {
                        "url": "/component/appmixer/wordpress/posts/ListPosts?outPort=posts",
                        "data": {
                            "properties": {
                                "siteId": "properties/siteId"
                            },
                            "transform": "./transformers#postsToSelectArray"
                        }
                    },
                    "tooltip": "Select a post."
                }
            }
        }
    },
    "icon": "data:image/svg+xml;base64,"
}
