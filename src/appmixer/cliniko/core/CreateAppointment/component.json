{
    "name": "appmixer.cliniko.core.CreateAppointment",
    "label": "Create Appointment",
    "description": "Books a new individual (one-on-one) appointment. End time is derived from the appointment type duration unless you set it explicitly.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:cliniko"
    },
    "quota": {
        "manager": "appmixer:cliniko",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "patientId": {
                        "type": "string"
                    },
                    "practitionerId": {
                        "type": "string"
                    },
                    "businessId": {
                        "type": "string"
                    },
                    "appointmentTypeId": {
                        "type": "string"
                    },
                    "startsAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "endsAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "notes": {
                        "type": "string"
                    },
                    "patientCaseId": {
                        "type": "string"
                    }
                },
                "required": [
                    "patientId",
                    "practitionerId",
                    "businessId",
                    "appointmentTypeId",
                    "startsAt"
                ]
            },
            "inspector": {
                "inputs": {
                    "patientId": {
                        "type": "text",
                        "index": 1,
                        "label": "Patient",
                        "tooltip": "Start typing to search your patients, or enter a Patient ID directly.",
                        "source": {
                            "url": "/component/appmixer/cliniko/core/FindPatients?outPort=out",
                            "data": {
                                "transform": "./FindPatients#toSelectArray",
                                "messages": {
                                    "in/outputType": "array",
                                    "in/isSource": true
                                }
                            }
                        }
                    },
                    "practitionerId": {
                        "type": "text",
                        "index": 2,
                        "label": "Practitioner",
                        "tooltip": "Start typing to pick a practitioner, or enter a Practitioner ID directly.",
                        "source": {
                            "url": "/component/appmixer/cliniko/core/ListPractitioners?outPort=out",
                            "data": {
                                "transform": "./ListPractitioners#toSelectArray",
                                "messages": {
                                    "in/outputType": "array",
                                    "in/isSource": true
                                }
                            }
                        }
                    },
                    "businessId": {
                        "type": "text",
                        "index": 3,
                        "label": "Business",
                        "tooltip": "Start typing to pick a business (clinic location), or enter a Business ID directly.",
                        "source": {
                            "url": "/component/appmixer/cliniko/core/ListBusinesses?outPort=out",
                            "data": {
                                "transform": "./ListBusinesses#toSelectArray",
                                "messages": {
                                    "in/outputType": "array",
                                    "in/isSource": true
                                }
                            }
                        }
                    },
                    "appointmentTypeId": {
                        "type": "text",
                        "index": 4,
                        "label": "Appointment Type",
                        "tooltip": "Start typing to pick an appointment type, or enter an Appointment Type ID directly.",
                        "source": {
                            "url": "/component/appmixer/cliniko/core/ListAppointmentTypes?outPort=out",
                            "data": {
                                "transform": "./ListAppointmentTypes#toSelectArray",
                                "messages": {
                                    "in/outputType": "array",
                                    "in/isSource": true
                                }
                            }
                        }
                    },
                    "startsAt": {
                        "type": "date-time",
                        "index": 5,
                        "label": "Starts At",
                        "tooltip": "Start of the appointment. Cliniko stores appointment times in UTC."
                    },
                    "endsAt": {
                        "type": "date-time",
                        "index": 6,
                        "label": "Ends At",
                        "tooltip": "Leave empty to use the duration configured on the appointment type."
                    },
                    "notes": {
                        "type": "textarea",
                        "index": 7,
                        "label": "Notes"
                    },
                    "patientCaseId": {
                        "type": "text",
                        "index": 8,
                        "label": "Patient Case ID",
                        "tooltip": "Optional patient case (referral) this appointment belongs to."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Appointment ID",
                        "example": "2021658404375760861"
                    },
                    "patient_id": {
                        "type": "string",
                        "title": "Patient ID",
                        "example": "2021658306572980085"
                    },
                    "patient_name": {
                        "type": "string",
                        "title": "Patient Name",
                        "example": "Test Patient"
                    },
                    "practitioner_id": {
                        "type": "string",
                        "title": "Practitioner ID",
                        "example": "2021656762171526868"
                    },
                    "business_id": {
                        "type": "string",
                        "title": "Business ID",
                        "example": "2021656766541991379"
                    },
                    "appointment_type_id": {
                        "type": "string",
                        "title": "Appointment Type ID",
                        "example": "2021656765636021706"
                    },
                    "patient_case_id": {
                        "type": "string",
                        "title": "Patient Case ID",
                        "example": ""
                    },
                    "starts_at": {
                        "type": "string",
                        "title": "Starts At",
                        "format": "date-time",
                        "example": "2026-09-01T09:00:00Z"
                    },
                    "ends_at": {
                        "type": "string",
                        "title": "Ends At",
                        "format": "date-time",
                        "example": "2026-09-01T09:30:00Z"
                    },
                    "notes": {
                        "type": "string",
                        "title": "Notes",
                        "example": "First consultation."
                    },
                    "patient_arrived": {
                        "type": "boolean",
                        "title": "Patient Arrived",
                        "example": false
                    },
                    "did_not_arrive": {
                        "type": "boolean",
                        "title": "Did Not Arrive",
                        "example": false
                    },
                    "cancelled_at": {
                        "type": "string",
                        "title": "Cancelled At",
                        "format": "date-time",
                        "example": ""
                    },
                    "cancellation_note": {
                        "type": "string",
                        "title": "Cancellation Note",
                        "example": ""
                    },
                    "cancellation_reason": {
                        "type": "integer",
                        "title": "Cancellation Reason",
                        "example": 30
                    },
                    "cancellation_reason_description": {
                        "type": "string",
                        "title": "Cancellation Reason Description",
                        "example": "Sick"
                    },
                    "email_reminder_sent": {
                        "type": "boolean",
                        "title": "Email Reminder Sent",
                        "example": false
                    },
                    "sms_reminder_sent": {
                        "type": "boolean",
                        "title": "SMS Reminder Sent",
                        "example": false
                    },
                    "invoice_status": {
                        "type": "integer",
                        "title": "Invoice Status",
                        "example": 0
                    },
                    "treatment_note_status": {
                        "type": "integer",
                        "title": "Treatment Note Status",
                        "example": 0
                    },
                    "telehealth_url": {
                        "type": "string",
                        "title": "Telehealth URL",
                        "example": "https://example.eu1.cliniko.com/appointments/2021658404375760861/connect"
                    },
                    "archived_at": {
                        "type": "string",
                        "title": "Archived At",
                        "format": "date-time",
                        "example": ""
                    },
                    "created_at": {
                        "type": "string",
                        "title": "Created At",
                        "format": "date-time",
                        "example": "2026-08-21T08:34:22Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "title": "Updated At",
                        "format": "date-time",
                        "example": "2026-08-21T08:34:22Z"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
