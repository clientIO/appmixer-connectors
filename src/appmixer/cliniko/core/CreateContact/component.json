{
    "name": "appmixer.cliniko.core.CreateContact",
    "label": "Create Contact",
    "description": "Creates a contact - a referring doctor, a third-party payer or any other non-patient contact. Cliniko requires a First Name or a Last Name even for a company contact.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:cliniko"
    },
    "quota": {
        "manager": "appmixer:cliniko",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "firstName": {
                        "type": "string"
                    },
                    "lastName": {
                        "type": "string"
                    },
                    "preferredName": {
                        "type": "string"
                    },
                    "companyName": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "typeCode": {
                        "type": "integer"
                    },
                    "doctorType": {
                        "type": "string"
                    },
                    "providerNumber": {
                        "type": "string"
                    },
                    "occupation": {
                        "type": "string"
                    },
                    "phoneNumber": {
                        "type": "string"
                    },
                    "phoneType": {
                        "type": "string"
                    },
                    "address1": {
                        "type": "string"
                    },
                    "address2": {
                        "type": "string"
                    },
                    "address3": {
                        "type": "string"
                    },
                    "city": {
                        "type": "string"
                    },
                    "state": {
                        "type": "string"
                    },
                    "postCode": {
                        "type": "string"
                    },
                    "countryCode": {
                        "type": "string"
                    },
                    "notes": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "firstName": {
                        "type": "text",
                        "index": 1,
                        "label": "First Name"
                    },
                    "lastName": {
                        "type": "text",
                        "index": 2,
                        "label": "Last Name"
                    },
                    "preferredName": {
                        "type": "text",
                        "index": 3,
                        "label": "Preferred Name"
                    },
                    "companyName": {
                        "type": "text",
                        "index": 4,
                        "label": "Company Name",
                        "tooltip": "Use this for organisations such as third-party payers."
                    },
                    "title": {
                        "type": "text",
                        "index": 5,
                        "label": "Title",
                        "tooltip": "For example Mr, Ms or Dr."
                    },
                    "email": {
                        "type": "text",
                        "index": 6,
                        "label": "Email"
                    },
                    "typeCode": {
                        "type": "select",
                        "index": 7,
                        "label": "Type",
                        "tooltip": "What kind of contact this is.",
                        "options": [
                            {
                                "label": "Standard",
                                "value": 0
                            },
                            {
                                "label": "Doctor",
                                "value": 1
                            },
                            {
                                "label": "3rd Party Payer",
                                "value": 2
                            }
                        ],
                        "defaultValue": 0
                    },
                    "doctorType": {
                        "type": "select",
                        "index": 8,
                        "label": "Doctor Type",
                        "tooltip": "Only meaningful when Type is Doctor.",
                        "options": [
                            {
                                "label": "General Practitioner",
                                "value": "general_practitioner"
                            },
                            {
                                "label": "Specialist",
                                "value": "specialist"
                            }
                        ]
                    },
                    "providerNumber": {
                        "type": "text",
                        "index": 9,
                        "label": "Provider Number"
                    },
                    "occupation": {
                        "type": "text",
                        "index": 10,
                        "label": "Occupation"
                    },
                    "phoneNumber": {
                        "type": "text",
                        "index": 11,
                        "label": "Phone Number",
                        "tooltip": "Sent together with Phone Type as the contact's phone number."
                    },
                    "phoneType": {
                        "type": "select",
                        "index": 12,
                        "label": "Phone Type",
                        "tooltip": "Only used when Phone Number is filled in.",
                        "defaultValue": "Work",
                        "options": [
                            {
                                "label": "Work",
                                "value": "Work"
                            },
                            {
                                "label": "Mobile",
                                "value": "Mobile"
                            },
                            {
                                "label": "Home",
                                "value": "Home"
                            },
                            {
                                "label": "Fax",
                                "value": "Fax"
                            },
                            {
                                "label": "Other",
                                "value": "Other"
                            }
                        ]
                    },
                    "address1": {
                        "type": "text",
                        "index": 13,
                        "label": "Address Line 1"
                    },
                    "address2": {
                        "type": "text",
                        "index": 14,
                        "label": "Address Line 2"
                    },
                    "address3": {
                        "type": "text",
                        "index": 15,
                        "label": "Address Line 3"
                    },
                    "city": {
                        "type": "text",
                        "index": 16,
                        "label": "City"
                    },
                    "state": {
                        "type": "text",
                        "index": 17,
                        "label": "State"
                    },
                    "postCode": {
                        "type": "text",
                        "index": 18,
                        "label": "Post Code"
                    },
                    "countryCode": {
                        "type": "text",
                        "index": 19,
                        "label": "Country Code",
                        "tooltip": "Two-letter ISO 3166-1 country code, for example <code>AU</code> or <code>GB</code>."
                    },
                    "notes": {
                        "type": "textarea",
                        "index": 20,
                        "label": "Notes"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Contact ID",
                        "example": "2021659200000000001"
                    },
                    "first_name": {
                        "type": "string",
                        "title": "First Name",
                        "example": "Jana"
                    },
                    "last_name": {
                        "type": "string",
                        "title": "Last Name",
                        "example": "Novakova"
                    },
                    "preferred_name": {
                        "type": "string",
                        "title": "Preferred Name",
                        "example": "Jana"
                    },
                    "company_name": {
                        "type": "string",
                        "title": "Company Name",
                        "example": "Prague General Practice"
                    },
                    "email": {
                        "type": "string",
                        "title": "Email",
                        "example": "jana.novakova@example.com"
                    },
                    "type": {
                        "type": "string",
                        "title": "Type",
                        "example": "Doctor"
                    },
                    "type_code": {
                        "type": "integer",
                        "title": "Type Code",
                        "example": 1
                    },
                    "doctor_type": {
                        "type": "string",
                        "title": "Doctor Type",
                        "example": "general_practitioner"
                    },
                    "provider_number": {
                        "type": "string",
                        "title": "Provider Number",
                        "example": "PN12345"
                    },
                    "occupation": {
                        "type": "string",
                        "title": "Occupation",
                        "example": "General Practitioner"
                    },
                    "title": {
                        "type": "string",
                        "title": "Title",
                        "example": "Dr"
                    },
                    "address_1": {
                        "type": "string",
                        "title": "Address Line 1",
                        "example": "5 Main Street"
                    },
                    "address_2": {
                        "type": "string",
                        "title": "Address Line 2",
                        "example": ""
                    },
                    "address_3": {
                        "type": "string",
                        "title": "Address Line 3",
                        "example": ""
                    },
                    "city": {
                        "type": "string",
                        "title": "City",
                        "example": "Prague"
                    },
                    "state": {
                        "type": "string",
                        "title": "State",
                        "example": "Praha"
                    },
                    "post_code": {
                        "type": "string",
                        "title": "Post Code",
                        "example": "11000"
                    },
                    "country": {
                        "type": "string",
                        "title": "Country",
                        "example": "Czechia"
                    },
                    "country_code": {
                        "type": "string",
                        "title": "Country Code",
                        "example": "CZ"
                    },
                    "notes": {
                        "type": "string",
                        "title": "Notes",
                        "example": ""
                    },
                    "phone_numbers": {
                        "type": "array",
                        "title": "Phone Numbers",
                        "items": {
                            "type": "object",
                            "properties": {
                                "number": {
                                    "type": "string",
                                    "title": "Number"
                                },
                                "phone_type": {
                                    "type": "string",
                                    "title": "Phone Type"
                                },
                                "normalized_number": {
                                    "type": "string",
                                    "title": "Normalized Number"
                                }
                            }
                        },
                        "example": [
                            {
                                "number": "0-123-456-78",
                                "phone_type": "Work",
                                "normalized_number": "42012345678"
                            }
                        ]
                    },
                    "archived_at": {
                        "type": "string",
                        "title": "Archived At",
                        "format": "date-time",
                        "example": ""
                    },
                    "created_at": {
                        "type": "string",
                        "title": "Created At",
                        "format": "date-time",
                        "example": "2026-08-21T09:20:00Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "title": "Updated At",
                        "format": "date-time",
                        "example": "2026-08-21T09:20:00Z"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
