{
    "name": "appmixer.cliniko.core.GetNextAvailableTime",
    "label": "Get Next Available Time",
    "description": "Returns the single next bookable appointment start time for a practitioner at a business, for a given appointment type. The business, practitioner and appointment type must all be enabled for online bookings in Cliniko - otherwise the endpoint answers 404. Cliniko allows a window of at most 7 days and will not look into the past.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:cliniko"
    },
    "quota": {
        "manager": "appmixer:cliniko",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "businessId": {
                        "type": "string"
                    },
                    "practitionerId": {
                        "type": "string"
                    },
                    "appointmentTypeId": {
                        "type": "string"
                    },
                    "fromDate": {
                        "type": "string",
                        "format": "date"
                    },
                    "toDate": {
                        "type": "string",
                        "format": "date"
                    }
                },
                "required": [
                    "businessId",
                    "practitionerId",
                    "appointmentTypeId"
                ]
            },
            "inspector": {
                "inputs": {
                    "businessId": {
                        "type": "text",
                        "index": 1,
                        "label": "Business",
                        "tooltip": "Start typing to pick a business (clinic location), or enter a Business ID directly.",
                        "source": {
                            "url": "/component/appmixer/cliniko/core/ListBusinesses?outPort=out",
                            "data": {
                                "transform": "./ListBusinesses#toSelectArray",
                                "messages": {
                                    "in/outputType": "array",
                                    "in/isSource": true
                                }
                            }
                        }
                    },
                    "practitionerId": {
                        "type": "text",
                        "index": 2,
                        "label": "Practitioner",
                        "tooltip": "Start typing to pick a practitioner, or enter a Practitioner ID directly.",
                        "source": {
                            "url": "/component/appmixer/cliniko/core/ListPractitioners?outPort=out",
                            "data": {
                                "transform": "./ListPractitioners#toSelectArray",
                                "messages": {
                                    "in/outputType": "array",
                                    "in/isSource": true
                                }
                            }
                        }
                    },
                    "appointmentTypeId": {
                        "type": "text",
                        "index": 3,
                        "label": "Appointment Type",
                        "tooltip": "Start typing to pick an appointment type, or enter an Appointment Type ID directly.",
                        "source": {
                            "url": "/component/appmixer/cliniko/core/ListAppointmentTypes?outPort=out",
                            "data": {
                                "transform": "./ListAppointmentTypes#toSelectArray",
                                "messages": {
                                    "in/outputType": "array",
                                    "in/isSource": true
                                }
                            }
                        }
                    },
                    "fromDate": {
                        "type": "date-time",
                        "index": 4,
                        "label": "From",
                        "config": {
                            "enableTime": false
                        },
                        "tooltip": "First day of the window. Leave empty for today. Must not be earlier than today in the account time zone."
                    },
                    "toDate": {
                        "type": "date-time",
                        "index": 5,
                        "label": "To",
                        "config": {
                            "enableTime": false
                        },
                        "tooltip": "Last day of the window. Leave empty for 6 days after From - Cliniko allows at most 7 days between From and To."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "appointment_start": {
                        "type": "string",
                        "title": "Appointment Start",
                        "format": "date-time",
                        "example": "2026-09-01T07:00:00Z"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
