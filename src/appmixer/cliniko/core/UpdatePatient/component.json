{
    "name": "appmixer.cliniko.core.UpdatePatient",
    "label": "Update Patient",
    "description": "Updates an existing patient. Only the fields you fill in are sent - everything else is left untouched. Returns an empty object.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:cliniko"
    },
    "quota": {
        "manager": "appmixer:cliniko",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "patientId": {
                        "type": "string"
                    },
                    "firstName": {
                        "type": "string"
                    },
                    "lastName": {
                        "type": "string"
                    },
                    "preferredFirstName": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "dateOfBirth": {
                        "type": "string",
                        "format": "date"
                    },
                    "sex": {
                        "type": "string"
                    },
                    "genderIdentity": {
                        "type": "string"
                    },
                    "occupation": {
                        "type": "string"
                    },
                    "phoneNumber": {
                        "type": "string"
                    },
                    "phoneType": {
                        "type": "string"
                    },
                    "address1": {
                        "type": "string"
                    },
                    "address2": {
                        "type": "string"
                    },
                    "address3": {
                        "type": "string"
                    },
                    "city": {
                        "type": "string"
                    },
                    "state": {
                        "type": "string"
                    },
                    "postCode": {
                        "type": "string"
                    },
                    "countryCode": {
                        "type": "string"
                    },
                    "notes": {
                        "type": "string"
                    },
                    "appointmentNotes": {
                        "type": "string"
                    },
                    "emergencyContact": {
                        "type": "string"
                    },
                    "referralSource": {
                        "type": "string"
                    },
                    "timeZone": {
                        "type": "string"
                    },
                    "medicare": {
                        "type": "string"
                    },
                    "acceptedEmailMarketing": {
                        "type": "boolean"
                    },
                    "acceptedSmsMarketing": {
                        "type": "boolean"
                    },
                    "acceptedPrivacyPolicy": {
                        "type": "boolean"
                    },
                    "receivesConfirmationEmails": {
                        "type": "boolean"
                    },
                    "receivesCancellationEmails": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "patientId"
                ]
            },
            "inspector": {
                "inputs": {
                    "patientId": {
                        "type": "text",
                        "index": 1,
                        "label": "Patient",
                        "tooltip": "Start typing to search your patients, or enter a Patient ID directly.",
                        "source": {
                            "url": "/component/appmixer/cliniko/core/FindPatients?outPort=out",
                            "data": {
                                "transform": "./FindPatients#toSelectArray",
                                "messages": {
                                    "in/outputType": "array",
                                    "in/isSource": true
                                }
                            }
                        }
                    },
                    "firstName": {
                        "type": "text",
                        "index": 2,
                        "label": "First Name"
                    },
                    "lastName": {
                        "type": "text",
                        "index": 3,
                        "label": "Last Name"
                    },
                    "preferredFirstName": {
                        "type": "text",
                        "index": 4,
                        "label": "Preferred First Name"
                    },
                    "title": {
                        "type": "text",
                        "index": 5,
                        "label": "Title",
                        "tooltip": "For example Mr, Ms or Dr."
                    },
                    "email": {
                        "type": "text",
                        "index": 6,
                        "label": "Email"
                    },
                    "dateOfBirth": {
                        "type": "date-time",
                        "index": 7,
                        "label": "Date of Birth",
                        "config": {
                            "enableTime": false
                        }
                    },
                    "sex": {
                        "type": "text",
                        "index": 8,
                        "label": "Sex",
                        "tooltip": "Free text, for example Female, Male or Intersex."
                    },
                    "genderIdentity": {
                        "type": "text",
                        "index": 9,
                        "label": "Gender Identity"
                    },
                    "occupation": {
                        "type": "text",
                        "index": 10,
                        "label": "Occupation"
                    },
                    "phoneNumber": {
                        "type": "text",
                        "index": 11,
                        "label": "Phone Number",
                        "tooltip": "Sent together with Phone Type as the patient's phone number."
                    },
                    "phoneType": {
                        "type": "select",
                        "index": 12,
                        "label": "Phone Type",
                        "tooltip": "Only used when Phone Number is filled in.",
                        "defaultValue": "Mobile",
                        "options": [
                            {
                                "label": "Mobile",
                                "value": "Mobile"
                            },
                            {
                                "label": "Home",
                                "value": "Home"
                            },
                            {
                                "label": "Work",
                                "value": "Work"
                            },
                            {
                                "label": "Fax",
                                "value": "Fax"
                            },
                            {
                                "label": "Other",
                                "value": "Other"
                            }
                        ]
                    },
                    "address1": {
                        "type": "text",
                        "index": 13,
                        "label": "Address Line 1"
                    },
                    "address2": {
                        "type": "text",
                        "index": 14,
                        "label": "Address Line 2"
                    },
                    "address3": {
                        "type": "text",
                        "index": 15,
                        "label": "Address Line 3"
                    },
                    "city": {
                        "type": "text",
                        "index": 16,
                        "label": "City"
                    },
                    "state": {
                        "type": "text",
                        "index": 17,
                        "label": "State"
                    },
                    "postCode": {
                        "type": "text",
                        "index": 18,
                        "label": "Post Code"
                    },
                    "countryCode": {
                        "type": "text",
                        "index": 19,
                        "label": "Country Code",
                        "tooltip": "Two-letter ISO 3166-1 country code, for example <code>AU</code> or <code>GB</code>."
                    },
                    "notes": {
                        "type": "textarea",
                        "index": 20,
                        "label": "Notes"
                    },
                    "appointmentNotes": {
                        "type": "textarea",
                        "index": 21,
                        "label": "Appointment Notes",
                        "tooltip": "Shown on every appointment for this patient."
                    },
                    "emergencyContact": {
                        "type": "text",
                        "index": 22,
                        "label": "Emergency Contact"
                    },
                    "referralSource": {
                        "type": "text",
                        "index": 23,
                        "label": "Referral Source"
                    },
                    "timeZone": {
                        "type": "text",
                        "index": 24,
                        "label": "Time Zone",
                        "tooltip": "Time zone identifier for this patient, for example <code>Europe/London</code>. Defaults to the account time zone."
                    },
                    "medicare": {
                        "type": "text",
                        "index": 25,
                        "label": "Medicare Number",
                        "tooltip": "Australian accounts only."
                    },
                    "acceptedEmailMarketing": {
                        "type": "toggle",
                        "index": 26,
                        "label": "Accepted Email Marketing"
                    },
                    "acceptedSmsMarketing": {
                        "type": "toggle",
                        "index": 27,
                        "label": "Accepted SMS Marketing"
                    },
                    "acceptedPrivacyPolicy": {
                        "type": "toggle",
                        "index": 28,
                        "label": "Accepted Privacy Policy"
                    },
                    "receivesConfirmationEmails": {
                        "type": "toggle",
                        "index": 29,
                        "label": "Receives Confirmation Emails"
                    },
                    "receivesCancellationEmails": {
                        "type": "toggle",
                        "index": 30,
                        "label": "Receives Cancellation Emails"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {}
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
