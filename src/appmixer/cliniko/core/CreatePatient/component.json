{
    "name": "appmixer.cliniko.core.CreatePatient",
    "label": "Create Patient",
    "description": "Creates a new patient. Last Name is the only field Cliniko requires.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:cliniko"
    },
    "quota": {
        "manager": "appmixer:cliniko",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "firstName": {
                        "type": "string"
                    },
                    "lastName": {
                        "type": "string"
                    },
                    "preferredFirstName": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "dateOfBirth": {
                        "type": "string",
                        "format": "date"
                    },
                    "sex": {
                        "type": "string"
                    },
                    "genderIdentity": {
                        "type": "string"
                    },
                    "occupation": {
                        "type": "string"
                    },
                    "phoneNumber": {
                        "type": "string"
                    },
                    "phoneType": {
                        "type": "string"
                    },
                    "address1": {
                        "type": "string"
                    },
                    "address2": {
                        "type": "string"
                    },
                    "address3": {
                        "type": "string"
                    },
                    "city": {
                        "type": "string"
                    },
                    "state": {
                        "type": "string"
                    },
                    "postCode": {
                        "type": "string"
                    },
                    "countryCode": {
                        "type": "string"
                    },
                    "notes": {
                        "type": "string"
                    },
                    "appointmentNotes": {
                        "type": "string"
                    },
                    "emergencyContact": {
                        "type": "string"
                    },
                    "referralSource": {
                        "type": "string"
                    },
                    "timeZone": {
                        "type": "string"
                    },
                    "medicare": {
                        "type": "string"
                    },
                    "acceptedEmailMarketing": {
                        "type": "boolean"
                    },
                    "acceptedSmsMarketing": {
                        "type": "boolean"
                    },
                    "acceptedPrivacyPolicy": {
                        "type": "boolean"
                    },
                    "receivesConfirmationEmails": {
                        "type": "boolean"
                    },
                    "receivesCancellationEmails": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "lastName"
                ]
            },
            "inspector": {
                "inputs": {
                    "firstName": {
                        "type": "text",
                        "index": 1,
                        "label": "First Name"
                    },
                    "lastName": {
                        "type": "text",
                        "index": 2,
                        "label": "Last Name"
                    },
                    "preferredFirstName": {
                        "type": "text",
                        "index": 3,
                        "label": "Preferred First Name"
                    },
                    "title": {
                        "type": "text",
                        "index": 4,
                        "label": "Title",
                        "tooltip": "For example Mr, Ms or Dr."
                    },
                    "email": {
                        "type": "text",
                        "index": 5,
                        "label": "Email"
                    },
                    "dateOfBirth": {
                        "type": "date-time",
                        "index": 6,
                        "label": "Date of Birth",
                        "config": {
                            "enableTime": false
                        }
                    },
                    "sex": {
                        "type": "text",
                        "index": 7,
                        "label": "Sex",
                        "tooltip": "Free text, for example Female, Male or Intersex."
                    },
                    "genderIdentity": {
                        "type": "text",
                        "index": 8,
                        "label": "Gender Identity"
                    },
                    "occupation": {
                        "type": "text",
                        "index": 9,
                        "label": "Occupation"
                    },
                    "phoneNumber": {
                        "type": "text",
                        "index": 10,
                        "label": "Phone Number",
                        "tooltip": "Sent together with Phone Type as the patient's phone number."
                    },
                    "phoneType": {
                        "type": "select",
                        "index": 11,
                        "label": "Phone Type",
                        "tooltip": "Only used when Phone Number is filled in.",
                        "defaultValue": "Mobile",
                        "options": [
                            {
                                "label": "Mobile",
                                "value": "Mobile"
                            },
                            {
                                "label": "Home",
                                "value": "Home"
                            },
                            {
                                "label": "Work",
                                "value": "Work"
                            },
                            {
                                "label": "Fax",
                                "value": "Fax"
                            },
                            {
                                "label": "Other",
                                "value": "Other"
                            }
                        ]
                    },
                    "address1": {
                        "type": "text",
                        "index": 12,
                        "label": "Address Line 1"
                    },
                    "address2": {
                        "type": "text",
                        "index": 13,
                        "label": "Address Line 2"
                    },
                    "address3": {
                        "type": "text",
                        "index": 14,
                        "label": "Address Line 3"
                    },
                    "city": {
                        "type": "text",
                        "index": 15,
                        "label": "City"
                    },
                    "state": {
                        "type": "text",
                        "index": 16,
                        "label": "State"
                    },
                    "postCode": {
                        "type": "text",
                        "index": 17,
                        "label": "Post Code"
                    },
                    "countryCode": {
                        "type": "text",
                        "index": 18,
                        "label": "Country Code",
                        "tooltip": "Two-letter ISO 3166-1 country code, for example <code>AU</code> or <code>GB</code>."
                    },
                    "notes": {
                        "type": "textarea",
                        "index": 19,
                        "label": "Notes"
                    },
                    "appointmentNotes": {
                        "type": "textarea",
                        "index": 20,
                        "label": "Appointment Notes",
                        "tooltip": "Shown on every appointment for this patient."
                    },
                    "emergencyContact": {
                        "type": "text",
                        "index": 21,
                        "label": "Emergency Contact"
                    },
                    "referralSource": {
                        "type": "text",
                        "index": 22,
                        "label": "Referral Source"
                    },
                    "timeZone": {
                        "type": "text",
                        "index": 23,
                        "label": "Time Zone",
                        "tooltip": "Time zone identifier for this patient, for example <code>Europe/London</code>. Defaults to the account time zone."
                    },
                    "medicare": {
                        "type": "text",
                        "index": 24,
                        "label": "Medicare Number",
                        "tooltip": "Australian accounts only."
                    },
                    "acceptedEmailMarketing": {
                        "type": "toggle",
                        "index": 25,
                        "label": "Accepted Email Marketing"
                    },
                    "acceptedSmsMarketing": {
                        "type": "toggle",
                        "index": 26,
                        "label": "Accepted SMS Marketing"
                    },
                    "acceptedPrivacyPolicy": {
                        "type": "toggle",
                        "index": 27,
                        "label": "Accepted Privacy Policy"
                    },
                    "receivesConfirmationEmails": {
                        "type": "toggle",
                        "index": 28,
                        "label": "Receives Confirmation Emails"
                    },
                    "receivesCancellationEmails": {
                        "type": "toggle",
                        "index": 29,
                        "label": "Receives Cancellation Emails"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Patient ID",
                        "example": "2021658306572980085"
                    },
                    "first_name": {
                        "type": "string",
                        "title": "First Name",
                        "example": "Test"
                    },
                    "last_name": {
                        "type": "string",
                        "title": "Last Name",
                        "example": "Patient"
                    },
                    "label": {
                        "type": "string",
                        "title": "Full Name",
                        "example": "Test Patient"
                    },
                    "preferred_first_name": {
                        "type": "string",
                        "title": "Preferred First Name",
                        "example": "Testy"
                    },
                    "email": {
                        "type": "string",
                        "title": "Email",
                        "example": "test.patient@example.com"
                    },
                    "date_of_birth": {
                        "type": "string",
                        "title": "Date of Birth",
                        "format": "date",
                        "example": "1990-05-12"
                    },
                    "sex": {
                        "type": "string",
                        "title": "Sex",
                        "example": "Female"
                    },
                    "gender_identity": {
                        "type": "string",
                        "title": "Gender Identity",
                        "example": "Female"
                    },
                    "title": {
                        "type": "string",
                        "title": "Title",
                        "example": "Ms"
                    },
                    "occupation": {
                        "type": "string",
                        "title": "Occupation",
                        "example": "Teacher"
                    },
                    "medicare": {
                        "type": "string",
                        "title": "Medicare Number",
                        "example": "1234567890"
                    },
                    "medicare_reference_number": {
                        "type": "string",
                        "title": "Medicare Reference Number",
                        "example": "1"
                    },
                    "address_1": {
                        "type": "string",
                        "title": "Address Line 1",
                        "example": "12 Queen Street"
                    },
                    "address_2": {
                        "type": "string",
                        "title": "Address Line 2",
                        "example": "Apartment 3"
                    },
                    "address_3": {
                        "type": "string",
                        "title": "Address Line 3",
                        "example": ""
                    },
                    "city": {
                        "type": "string",
                        "title": "City",
                        "example": "Prague"
                    },
                    "state": {
                        "type": "string",
                        "title": "State",
                        "example": "Praha"
                    },
                    "post_code": {
                        "type": "string",
                        "title": "Post Code",
                        "example": "11000"
                    },
                    "country": {
                        "type": "string",
                        "title": "Country",
                        "example": "Czechia"
                    },
                    "country_code": {
                        "type": "string",
                        "title": "Country Code",
                        "example": "CZ"
                    },
                    "notes": {
                        "type": "string",
                        "title": "Notes",
                        "example": "Referred by Dr. Novak."
                    },
                    "appointment_notes": {
                        "type": "string",
                        "title": "Appointment Notes",
                        "example": "Prefers morning appointments."
                    },
                    "emergency_contact": {
                        "type": "string",
                        "title": "Emergency Contact",
                        "example": "Jan Patient, +420 123 456 789"
                    },
                    "referral_source": {
                        "type": "string",
                        "title": "Referral Source",
                        "example": "Google"
                    },
                    "time_zone": {
                        "type": "string",
                        "title": "Time Zone",
                        "example": "Prague"
                    },
                    "accepted_email_marketing": {
                        "type": "boolean",
                        "title": "Accepted Email Marketing",
                        "example": false
                    },
                    "accepted_sms_marketing": {
                        "type": "boolean",
                        "title": "Accepted SMS Marketing",
                        "example": false
                    },
                    "accepted_privacy_policy": {
                        "type": "boolean",
                        "title": "Accepted Privacy Policy",
                        "example": true
                    },
                    "receives_confirmation_emails": {
                        "type": "boolean",
                        "title": "Receives Confirmation Emails",
                        "example": true
                    },
                    "receives_cancellation_emails": {
                        "type": "boolean",
                        "title": "Receives Cancellation Emails",
                        "example": true
                    },
                    "patient_phone_numbers": {
                        "type": "array",
                        "title": "Phone Numbers",
                        "items": {
                            "type": "object",
                            "properties": {
                                "number": {
                                    "type": "string",
                                    "title": "Number"
                                },
                                "phone_type": {
                                    "type": "string",
                                    "title": "Phone Type"
                                },
                                "normalized_number": {
                                    "type": "string",
                                    "title": "Normalized Number"
                                }
                            }
                        },
                        "example": [
                            {
                                "number": "0-123-456-78",
                                "phone_type": "Mobile",
                                "normalized_number": "42012345678"
                            }
                        ]
                    },
                    "archived_at": {
                        "type": "string",
                        "title": "Archived At",
                        "format": "date-time",
                        "example": ""
                    },
                    "created_at": {
                        "type": "string",
                        "title": "Created At",
                        "format": "date-time",
                        "example": "2026-08-21T08:34:10Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "title": "Updated At",
                        "format": "date-time",
                        "example": "2026-08-21T08:34:10Z"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
