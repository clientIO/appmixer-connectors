{
    "name": "appmixer.cliniko.core.CancelAppointment",
    "label": "Cancel Appointment",
    "description": "Cancels an individual appointment, keeping it on record with a cancellation reason. This is not a deletion - the appointment stays in Cliniko and reporting. Returns an empty object.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:cliniko"
    },
    "quota": {
        "manager": "appmixer:cliniko",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "appointmentId": {
                        "type": "string"
                    },
                    "cancellationReason": {
                        "type": "integer"
                    },
                    "cancellationNote": {
                        "type": "string"
                    }
                },
                "required": [
                    "appointmentId"
                ]
            },
            "inspector": {
                "inputs": {
                    "appointmentId": {
                        "type": "text",
                        "index": 1,
                        "label": "Appointment",
                        "tooltip": "Start typing to search recent appointments, or enter an Appointment ID directly.",
                        "source": {
                            "url": "/component/appmixer/cliniko/core/FindAppointments?outPort=out",
                            "data": {
                                "transform": "./FindAppointments#toSelectArray",
                                "messages": {
                                    "in/outputType": "array",
                                    "in/isSource": true
                                }
                            }
                        }
                    },
                    "cancellationReason": {
                        "type": "select",
                        "index": 2,
                        "label": "Cancellation Reason",
                        "tooltip": "Why the appointment was cancelled. Feeds Cliniko's cancellation reporting.",
                        "options": [
                            {
                                "label": "Feeling better",
                                "value": 10
                            },
                            {
                                "label": "Condition worse",
                                "value": 20
                            },
                            {
                                "label": "Sick",
                                "value": 30
                            },
                            {
                                "label": "Away",
                                "value": 40
                            },
                            {
                                "label": "Other",
                                "value": 50
                            },
                            {
                                "label": "Work",
                                "value": 60
                            }
                        ]
                    },
                    "cancellationNote": {
                        "type": "textarea",
                        "index": 3,
                        "label": "Cancellation Note"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {}
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
