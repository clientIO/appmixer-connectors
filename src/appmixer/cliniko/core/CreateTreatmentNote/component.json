{
    "name": "appmixer.cliniko.core.CreateTreatmentNote",
    "label": "Create Treatment Note",
    "description": "Creates a treatment note for a patient. Cliniko stores note bodies as a structured sections object, so Content takes JSON in the shape <code>{\"sections\":[{\"name\":\"Subjective\",\"questions\":[{\"name\":\"Complaint\",\"type\":\"text\",\"answer\":\"...\"}]}]}</code>. Copy the shape from an existing note (Find Treatment Notes) or from the treatment note template.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:cliniko"
    },
    "quota": {
        "manager": "appmixer:cliniko",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "patientId": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "content": {
                        "type": "string"
                    },
                    "draft": {
                        "type": "boolean"
                    },
                    "treatmentNoteTemplateId": {
                        "type": "string"
                    },
                    "bookingId": {
                        "type": "string"
                    }
                },
                "required": [
                    "patientId"
                ]
            },
            "inspector": {
                "inputs": {
                    "patientId": {
                        "type": "text",
                        "index": 1,
                        "label": "Patient",
                        "tooltip": "Start typing to search your patients, or enter a Patient ID directly.",
                        "source": {
                            "url": "/component/appmixer/cliniko/core/FindPatients?outPort=out",
                            "data": {
                                "transform": "./FindPatients#toSelectArray",
                                "messages": {
                                    "in/outputType": "array",
                                    "in/isSource": true
                                }
                            }
                        }
                    },
                    "title": {
                        "type": "text",
                        "index": 2,
                        "label": "Title"
                    },
                    "content": {
                        "type": "textarea",
                        "index": 3,
                        "label": "Content",
                        "tooltip": "The note body as a JSON object with a <code>sections</code> array."
                    },
                    "draft": {
                        "type": "toggle",
                        "index": 4,
                        "label": "Draft",
                        "tooltip": "Save as an unfinished draft instead of finalising the note."
                    },
                    "treatmentNoteTemplateId": {
                        "type": "text",
                        "index": 5,
                        "label": "Treatment Note Template ID",
                        "tooltip": "Optional template the note is based on."
                    },
                    "bookingId": {
                        "type": "text",
                        "index": 6,
                        "label": "Booking ID",
                        "tooltip": "Optional appointment this note belongs to."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Treatment Note ID",
                        "example": "2021659000000000001"
                    },
                    "patient_id": {
                        "type": "string",
                        "title": "Patient ID",
                        "example": "2021658306572980085"
                    },
                    "practitioner_id": {
                        "type": "string",
                        "title": "Practitioner ID",
                        "example": "2021656762171526868"
                    },
                    "booking_id": {
                        "type": "string",
                        "title": "Booking ID",
                        "example": "2021658404375760861"
                    },
                    "treatment_note_template_id": {
                        "type": "string",
                        "title": "Treatment Note Template ID",
                        "example": "2021656766000000001"
                    },
                    "title": {
                        "type": "string",
                        "title": "Title",
                        "example": "Initial assessment"
                    },
                    "author_name": {
                        "type": "string",
                        "title": "Author Name",
                        "example": "Vladimir Talas"
                    },
                    "draft": {
                        "type": "boolean",
                        "title": "Draft",
                        "example": false
                    },
                    "content": {
                        "type": "object",
                        "title": "Content",
                        "example": {
                            "sections": [
                                {
                                    "name": "Subjective",
                                    "questions": [
                                        {
                                            "name": "Complaint",
                                            "type": "text",
                                            "answer": "Lower back pain"
                                        }
                                    ]
                                }
                            ]
                        }
                    },
                    "finalized_at": {
                        "type": "string",
                        "title": "Finalized At",
                        "format": "date-time",
                        "example": "2026-08-21T09:00:00Z"
                    },
                    "pinned_at": {
                        "type": "string",
                        "title": "Pinned At",
                        "format": "date-time",
                        "example": ""
                    },
                    "archived_at": {
                        "type": "string",
                        "title": "Archived At",
                        "format": "date-time",
                        "example": ""
                    },
                    "created_at": {
                        "type": "string",
                        "title": "Created At",
                        "format": "date-time",
                        "example": "2026-08-21T09:00:00Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "title": "Updated At",
                        "format": "date-time",
                        "example": "2026-08-21T09:00:00Z"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
