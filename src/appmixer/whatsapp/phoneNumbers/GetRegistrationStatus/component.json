{
    "name": "appmixer.whatsapp.phoneNumbers.GetRegistrationStatus",
    "author": "Appmixer <info@appmixer.com>",
    "label": "Get Sender Registration Status",
    "description": "Check whether YOUR business sender phone number is registered on the WhatsApp Cloud API. Read-only — no side effects. Use for diagnostics or as a branch condition before sending messages. Returns `registered: true` when platform_type is CLOUD_API.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:whatsapp"
    },
    "quota": {
        "manager": "appmixer:whatsapp",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "businessAccountId": {
                        "type": "string"
                    },
                    "phoneNumberId": {
                        "type": "string"
                    }
                },
                "required": [
                    "businessAccountId",
                    "phoneNumberId"
                ]
            },
            "inspector": {
                "inputs": {
                    "businessAccountId": {
                        "type": "text",
                        "index": 1,
                        "label": "WhatsApp Business Account ID",
                        "tooltip": "Select the WhatsApp Business Account (WABA). If the dropdown is empty, enter your WABA ID manually — you can find it in Meta Business Manager (business.facebook.com → Settings → Accounts → WhatsApp Accounts).",
                        "source": {
                            "url": "/component/appmixer/whatsapp/businessAccounts/ListBusinessAccounts?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListBusinessAccounts#toSelectArray"
                            }
                        }
                    },
                    "phoneNumberId": {
                        "type": "text",
                        "index": 2,
                        "label": "Phone Number ID",
                        "tooltip": "ID of YOUR business sender phone number to check. Pick from the dropdown (populated when the WABA above is filled in), or paste a Phone Number ID manually.",
                        "source": {
                            "url": "/component/appmixer/whatsapp/phoneNumbers/ListPhoneNumbers?outPort=out",
                            "data": {
                                "messages": {
                                    "in/businessAccountId": "inputs/in/businessAccountId",
                                    "in/phoneNumberId": "any"
                                },
                                "transform": "./ListPhoneNumbers#toSelectArray",
                                "properties": {
                                    "isSource": true
                                }
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "registered": {
                        "type": "boolean",
                        "title": "Registered on Cloud API",
                        "example": true
                    },
                    "platformType": {
                        "type": "string",
                        "title": "Platform Type",
                        "example": "CLOUD_API"
                    },
                    "codeVerified": {
                        "type": "boolean",
                        "title": "Phone Number Verified",
                        "example": true
                    },
                    "codeVerificationStatus": {
                        "type": "string",
                        "title": "Code Verification Status",
                        "example": "VERIFIED"
                    },
                    "messagingLimit": {
                        "type": "string",
                        "title": "Messaging Tier Limit",
                        "example": "TIER_1K"
                    },
                    "displayPhoneNumber": {
                        "type": "string",
                        "title": "Display Phone Number",
                        "example": "+1 555-635-4389"
                    },
                    "verifiedName": {
                        "type": "string",
                        "title": "Verified Name",
                        "example": "Acme Test"
                    },
                    "qualityRating": {
                        "type": "string",
                        "title": "Quality Rating",
                        "example": "GREEN"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
