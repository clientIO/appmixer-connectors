{
    "name": "appmixer.whatsapp.media.UploadMedia",
    "author": "Appmixer <info@appmixer.com>",
    "label": "Upload Media",
    "description": "Upload media (image/video/audio/document) to WhatsApp servers. Returns a media ID valid for 24 hours.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:whatsapp"
    },
    "quota": {
        "manager": "appmixer:whatsapp",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "businessAccountId": {
                        "type": "string"
                    },
                    "phoneNumberId": {
                        "type": "string"
                    },
                    "fileId": {
                        "type": "string"
                    },
                    "mimeType": {
                        "type": "string"
                    }
                },
                "required": [
                    "businessAccountId",
                    "phoneNumberId",
                    "fileId",
                    "mimeType"
                ]
            },
            "inspector": {
                "inputs": {
                    "businessAccountId": {
                        "type": "text",
                        "index": 1,
                        "label": "WhatsApp Business Account ID",
                        "tooltip": "Select the WhatsApp Business Account (WABA). If the dropdown is empty, enter your WABA ID manually — you can find it in Meta Business Manager (business.facebook.com → Settings → Accounts → WhatsApp Accounts).",
                        "source": {
                            "url": "/component/appmixer/whatsapp/businessAccounts/ListBusinessAccounts?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListBusinessAccounts#toSelectArray"
                            }
                        }
                    },
                    "phoneNumberId": {
                        "type": "text",
                        "index": 2,
                        "label": "Sender Phone Number",
                        "tooltip": "Sender phone number — the number the message is sent FROM. Pick from the dropdown (populated when the WABA above is filled in), or paste a Phone Number ID manually.",
                        "source": {
                            "url": "/component/appmixer/whatsapp/phoneNumbers/ListPhoneNumbers?outPort=out",
                            "data": {
                                "messages": {
                                    "in/businessAccountId": "inputs/in/businessAccountId",
                                    "in/phoneNumberId": "any",
                                    "in/fileId": "any",
                                    "in/mimeType": "any"
                                },
                                "transform": "./ListPhoneNumbers#toSelectArray",
                                "properties": {
                                    "isSource": true
                                }
                            }
                        }
                    },
                    "fileId": {
                        "type": "filepicker",
                        "index": 3,
                        "label": "File",
                        "tooltip": "Appmixer file to upload (from a previous component output)."
                    },
                    "mimeType": {
                        "type": "select",
                        "index": 4,
                        "label": "MIME Type",
                        "tooltip": "Media MIME type. See <a href=\"https://developers.facebook.com/docs/whatsapp/cloud-api/reference/media\" target=\"_blank\">supported types</a>.",
                        "options": [
                            {
                                "label": "image/jpeg",
                                "value": "image/jpeg"
                            },
                            {
                                "label": "image/png",
                                "value": "image/png"
                            },
                            {
                                "label": "video/mp4",
                                "value": "video/mp4"
                            },
                            {
                                "label": "video/3gpp",
                                "value": "video/3gpp"
                            },
                            {
                                "label": "audio/aac",
                                "value": "audio/aac"
                            },
                            {
                                "label": "audio/mp4",
                                "value": "audio/mp4"
                            },
                            {
                                "label": "audio/mpeg",
                                "value": "audio/mpeg"
                            },
                            {
                                "label": "audio/amr",
                                "value": "audio/amr"
                            },
                            {
                                "label": "audio/ogg",
                                "value": "audio/ogg"
                            },
                            {
                                "label": "application/pdf",
                                "value": "application/pdf"
                            },
                            {
                                "label": "application/vnd.ms-powerpoint",
                                "value": "application/vnd.ms-powerpoint"
                            },
                            {
                                "label": "application/msword",
                                "value": "application/msword"
                            },
                            {
                                "label": "application/vnd.ms-excel",
                                "value": "application/vnd.ms-excel"
                            },
                            {
                                "label": "text/plain",
                                "value": "text/plain"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "mediaId": {
                        "type": "string",
                        "title": "Media ID",
                        "example": "1456982531234567"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
