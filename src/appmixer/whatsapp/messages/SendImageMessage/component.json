{
    "name": "appmixer.whatsapp.messages.SendImageMessage",
    "author": "Appmixer <info@appmixer.com>",
    "label": "Send Image Message",
    "description": "Send an image to a WhatsApp user. Provide either a media ID (uploaded via UploadMedia) or a public HTTPS link. Can only be sent within 24 hours of the recipient's last message to you. Important: A successful response does NOT guarantee delivery. Use the \"Message Status Updated\" trigger to track delivery status.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:whatsapp"
    },
    "quota": {
        "manager": "appmixer:whatsapp",
        "resources": "messages",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "businessAccountId": {
                        "type": "string"
                    },
                    "phoneNumberId": {
                        "type": "string"
                    },
                    "to": {
                        "type": "string"
                    },
                    "contextMessageId": {
                        "type": "string"
                    },
                    "mediaId": {
                        "type": "string"
                    },
                    "link": {
                        "type": "string"
                    },
                    "caption": {
                        "type": "string"
                    }
                },
                "required": [
                    "businessAccountId",
                    "phoneNumberId",
                    "to"
                ]
            },
            "inspector": {
                "inputs": {
                    "businessAccountId": {
                        "type": "text",
                        "index": 1,
                        "label": "WhatsApp Business Account ID",
                        "tooltip": "Select the WhatsApp Business Account (WABA). If the dropdown is empty, enter your WABA ID manually — you can find it in Meta Business Manager (business.facebook.com → Settings → Accounts → WhatsApp Accounts).",
                        "source": {
                            "url": "/component/appmixer/whatsapp/businessAccounts/ListBusinessAccounts?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListBusinessAccounts#toSelectArray"
                            }
                        }
                    },
                    "phoneNumberId": {
                        "type": "text",
                        "index": 2,
                        "label": "Sender Phone Number",
                        "tooltip": "Sender phone number — the number the message is sent FROM. Pick from the dropdown (populated when the WABA above is filled in), or paste a Phone Number ID manually.",
                        "source": {
                            "url": "/component/appmixer/whatsapp/phoneNumbers/ListPhoneNumbers?outPort=out",
                            "data": {
                                "messages": {
                                    "in/businessAccountId": "inputs/in/businessAccountId",
                                    "in/phoneNumberId": "any",
                                    "in/to": "any"
                                },
                                "transform": "./ListPhoneNumbers#toSelectArray",
                                "properties": {
                                    "isSource": true
                                }
                            }
                        }
                    },
                    "to": {
                        "type": "text",
                        "index": 3,
                        "label": "Recipient Phone Number",
                        "tooltip": "Recipient's phone number in E.164 format (e.g. <code>+1XXXXXXXXXX</code>)."
                    },
                    "mediaId": {
                        "type": "text",
                        "index": 4,
                        "label": "Media ID",
                        "tooltip": "Optional. ID of a previously uploaded image (via UploadMedia). Use either Media ID or Link."
                    },
                    "link": {
                        "type": "text",
                        "index": 5,
                        "label": "Image Link (URL)",
                        "tooltip": "Optional. Publicly-accessible HTTPS URL of the image. JPEG or PNG, max 5 MB."
                    },
                    "caption": {
                        "type": "textarea",
                        "index": 6,
                        "label": "Caption",
                        "tooltip": "Optional caption for the image."
                    },
                    "contextMessageId": {
                        "type": "text",
                        "index": 7,
                        "label": "Reply To Message ID",
                        "tooltip": "Optional. The WhatsApp message ID to reply to (creates a threaded reply)."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "messageId": {
                        "type": "string",
                        "title": "Message ID",
                        "example": "wamid.HBgLMTIzNDU2Nzg5MFASCQAB"
                    },
                    "contactWaId": {
                        "type": "string",
                        "title": "Contact WhatsApp ID",
                        "example": "1234567890"
                    },
                    "input": {
                        "type": "string",
                        "title": "Recipient Input",
                        "example": "+1234567890"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
