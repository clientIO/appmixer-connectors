{
    "name": "appmixer.whatsapp.businessAccounts.ListBusinessAccounts",
    "author": "Appmixer <info@appmixer.com>",
    "label": "List Business Accounts",
    "description": "List the WhatsApp Business Accounts (WABA) granted to the connected account during authentication. Used internally as a dropdown source for the WhatsApp Business Account ID field on other components, but also useful as a standalone action component.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:whatsapp"
    },
    "quota": {
        "manager": "appmixer:whatsapp",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        "in"
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "businessAccounts": {
                        "type": "array",
                        "title": "Business Accounts",
                        "example": [],
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "string",
                                    "title": "Business Account ID (WABA)",
                                    "example": "102290129340398"
                                },
                                "name": {
                                    "type": "string",
                                    "title": "Name",
                                    "example": "Acme Corp WABA"
                                }
                            }
                        }
                    },
                    "count": {
                        "type": "integer",
                        "title": "Count",
                        "example": 1
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
