{
    "name": "appmixer.spotify.core.ListPlaylistItems",
    "label": "List Playlist Items",
    "description": "Lists the tracks of a Spotify playlist, following Spotify's pagination to the end. Each record carries the track plus the entry's own metadata (when and by whom it was added).",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:spotify"
    },
    "quota": {
        "manager": "appmixer:spotify",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "playlistId": {
                        "type": "string"
                    },
                    "market": {
                        "type": "string"
                    },
                    "outputType": {
                        "type": "string"
                    }
                },
                "required": [
                    "playlistId"
                ]
            },
            "inspector": {
                "inputs": {
                    "playlistId": {
                        "type": "text",
                        "index": 1,
                        "label": "Playlist",
                        "tooltip": "Start typing to pick one of your playlists, or enter a playlist ID, <code>spotify:playlist:</code> URI or open.spotify.com link directly.",
                        "source": {
                            "url": "/component/appmixer/spotify/core/ListPlaylists?outPort=out",
                            "data": {
                                "transform": "./ListPlaylists#toSelectArray",
                                "messages": {
                                    "in/outputType": "array",
                                    "in/isSource": true
                                }
                            }
                        }
                    },
                    "market": {
                        "type": "text",
                        "index": 2,
                        "label": "Market",
                        "tooltip": "Optional ISO 3166-1 alpha-2 country code (e.g. <code>CZ</code>) to return the track as it is available in that market."
                    },
                    "outputType": {
                        "type": "select",
                        "index": 3,
                        "label": "Output Type",
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, first item only, one item at a time, or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/spotify/core/ListPlaylistItems?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/playlistId": "dummy",
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
