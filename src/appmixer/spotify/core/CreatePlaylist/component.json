{
    "name": "appmixer.spotify.core.CreatePlaylist",
    "label": "Create Playlist",
    "description": "Creates a new playlist for the connected Spotify account. The playlist is private unless you make it public.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:spotify"
    },
    "quota": {
        "manager": "appmixer:spotify",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "public": {
                        "type": "boolean"
                    },
                    "collaborative": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "name"
                ]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "index": 1,
                        "label": "Playlist Name",
                        "tooltip": "The name of the new playlist. Spotify does not require it to be unique."
                    },
                    "description": {
                        "type": "textarea",
                        "index": 2,
                        "label": "Description",
                        "tooltip": "Optional description shown on the playlist page."
                    },
                    "public": {
                        "type": "toggle",
                        "index": 3,
                        "label": "Public",
                        "defaultValue": false,
                        "tooltip": "When on, the playlist appears on the account's public profile. Off by default."
                    },
                    "collaborative": {
                        "type": "toggle",
                        "index": 4,
                        "label": "Collaborative",
                        "defaultValue": false,
                        "tooltip": "When on, anyone with the link can add items. Spotify only allows this on a private playlist, so turning it on forces Public off."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Playlist ID",
                        "example": "37i9dQZF1DX0XUsuxWHRQd"
                    },
                    "uri": {
                        "type": "string",
                        "title": "Playlist URI",
                        "example": "spotify:playlist:37i9dQZF1DX0XUsuxWHRQd"
                    },
                    "name": {
                        "type": "string",
                        "title": "Playlist Name",
                        "example": "Radio 1 - BLN 2026-09-11"
                    },
                    "description": {
                        "type": "string",
                        "title": "Description",
                        "example": "Tracklist of the show broadcast on 2026-09-11."
                    },
                    "public": {
                        "type": "boolean",
                        "title": "Public",
                        "example": false
                    },
                    "collaborative": {
                        "type": "boolean",
                        "title": "Collaborative",
                        "example": false
                    },
                    "snapshotId": {
                        "type": "string",
                        "title": "Snapshot ID",
                        "example": "MTgsMGRkYzcxMmQwZWMyZWU4ZmY0YjM2ZDY3ZDBmMTgyODdmYjFiZGQxNw=="
                    },
                    "ownerId": {
                        "type": "string",
                        "title": "Owner ID",
                        "example": "radio1listener"
                    },
                    "ownerName": {
                        "type": "string",
                        "title": "Owner Name",
                        "example": "Radio 1 Listener"
                    },
                    "totalItems": {
                        "type": "integer",
                        "title": "Total Items",
                        "example": 0
                    },
                    "externalUrl": {
                        "type": "string",
                        "title": "Spotify URL",
                        "example": "https://open.spotify.com/playlist/37i9dQZF1DX0XUsuxWHRQd"
                    },
                    "imageUrl": {
                        "type": "string",
                        "title": "Cover Image URL",
                        "example": "https://i.scdn.co/image/ab67706f00000002ca5a7517156021292e5663a6"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
