{
    "name": "appmixer.spotify.core.DeletePlaylist",
    "label": "Delete Playlist",
    "description": "Removes a playlist from the connected account's library. Spotify has no hard delete for playlists - this is what the Spotify clients themselves call \"Delete\".",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:spotify"
    },
    "quota": {
        "manager": "appmixer:spotify",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "playlistId": {
                        "type": "string"
                    }
                },
                "required": [
                    "playlistId"
                ]
            },
            "inspector": {
                "inputs": {
                    "playlistId": {
                        "type": "text",
                        "index": 1,
                        "label": "Playlist",
                        "tooltip": "Start typing to pick one of your playlists, or enter a playlist ID, <code>spotify:playlist:</code> URI or open.spotify.com link directly.",
                        "source": {
                            "url": "/component/appmixer/spotify/core/ListPlaylists?outPort=out",
                            "data": {
                                "transform": "./ListPlaylists#toSelectArray",
                                "messages": {
                                    "in/outputType": "array",
                                    "in/isSource": true
                                }
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {}
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
