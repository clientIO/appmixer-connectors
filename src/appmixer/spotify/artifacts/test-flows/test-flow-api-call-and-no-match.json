                                    "url": "/me/playlists",
                                    "method": "GET",
                                    "parameters": "[{\"key\": \"limit\", \"value\": \"1\"}]",
                                    "headers": "[{\"key\": \"Accept\", \"value\": \"application/json\"}]"
                                }
                            }
                        }
                    }
                }
            },
            "errorHandling": { "autoRetry": false, "onError": "stopFlow" }
        },
