                                                "assertion": "equal",
                                                "expected": "200"
                                            },
                                            {
                                                "field": "{{{3152e936-54fb-445c-9a42-c8e71adccc38}}}",
                                                "assertion": "equal",
                                                "expected": "1"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "errorHandling": { "autoRetry": false, "onError": "stopFlow" }
        },
