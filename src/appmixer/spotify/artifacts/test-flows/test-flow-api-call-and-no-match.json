                                "modifiers": {
                                    "expression": {
                                        "ddda66fe-24d6-47bd-8838-a6d387642d57": {
                                            "variable": "$.9c7ba656-40dd-478c-8352-bee02e3f4259.out.statusCode",
                                            "functions": []
                                        },
                                        "3152e936-54fb-445c-9a42-c8e71adccc38": {
                                            "variable": "$.9c7ba656-40dd-478c-8352-bee02e3f4259.out.body",
                                            "functions": [
                                                {
                                                    "name": "g_jsonPath",
