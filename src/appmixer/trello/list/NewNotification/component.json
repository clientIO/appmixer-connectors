{
    "name": "appmixer.trello.list.NewNotification",
    "author": "Robert Beinaravicius <rbeinaravicius@ntrc.eu>",
    "icon": "data:image/svg+xml;base64,",
    "description": "This trigger fires every time you get a new notification in Trello.",
    "private": false,
    "tick": true,
    "version": "1.0.1",
    "auth": {
        "service": "appmixer:trello"
    },
    "quota": {
        "manager": "appmixer:trello",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "outPorts": [
        {
            "name": "notification",
            "options": [
                {
                    "label": "id",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "5f1e8a9b2c3d4e5f6a7b8c9d"
                    }
                },
                {
                    "label": "date",
                    "value": "date",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00.000Z"
                    }
                },
                {
                    "label": "type",
                    "value": "type",
                    "schema": {
                        "type": "string",
                        "example": "addedToCard"
                    }
                },
                {
                    "label": "unread",
                    "value": "unread",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "idMemberCreator",
                    "value": "idMemberCreator",
                    "schema": {
                        "type": "string",
                        "example": "5a1b2c3d4e5f6a7b8c9d0e1f"
                    }
                },
                {
                    "label": "memberCreator.id",
                    "value": "memberCreator.id",
                    "schema": {
                        "type": "string",
                        "example": "5a1b2c3d4e5f6a7b8c9d0e1f"
                    }
                },
                {
                    "label": "memberCreator.avatarHash",
                    "value": "memberCreator.avatarHash",
                    "schema": {
                        "type": "string",
                        "example": "a8f5f167f44f4964e6c998dee827110c"
                    }
                },
                {
                    "label": "memberCreator.fullName",
                    "value": "memberCreator.fullName",
                    "schema": {
                        "type": "string",
                        "example": "Jane Doe"
                    }
                },
                {
                    "label": "memberCreator.initials",
                    "value": "memberCreator.initials",
                    "schema": {
                        "type": "string",
                        "example": "JD"
                    }
                },
                {
                    "label": "memberCreator.username",
                    "value": "memberCreator.username",
                    "schema": {
                        "type": "string",
                        "example": "janedoe"
                    }
                }
            ]
        }
    ]
}
