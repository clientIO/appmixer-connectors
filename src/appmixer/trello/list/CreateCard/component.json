{
    "name": "appmixer.trello.list.CreateCard",
    "author": "Robert Beinaravicius <rbeinaravicius@ntrc.eu>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Create a new card in Trello on a specific board and list.",
    "private": false,
    "version": "1.1.1",
    "auth": {
        "service": "appmixer:trello"
    },
    "quota": {
        "manager": "appmixer:trello",
        "resources": "CreateCard",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "boardId": { "type": "string" },
                    "name": { "type": "string" },
                    "boardListId": { "type": "string" },
                    "description": { "type": "string", "maxLength": 16384 },
                    "position": { "enum": [ "top", "bottom" ] },
                    "dueDate": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "checklistName": { "type": "string", "maxLength": 16384 },
                    "checklistItems": { "type": "string" },
                    "labels": { "type": "string" }
                },
                "required": [
                    "name",
                    "boardListId"
                ]
            },
            "inspector": {
                "inputs": {
                    "boardId": {
                        "type": "text",
                        "label": "Board",
                        "index": 1,
                        "source": {
                            "url": "/component/appmixer/trello/list/ListBoards?outPort=boards",
                            "data": {
                                "transform": "./transformers#boardsToSelectArray"
                            }
                        },
                        "tooltip": "Select a board."
                    },
                    "boardListId": {
                        "type": "text",
                        "label": "Board List",
                        "index": 2,
                        "source": {
                            "url": "/component/appmixer/trello/list/ListBoardsList?outPort=lists",
                            "data": {
                                "messages": {
                                    "in/boardId": "inputs/in/boardId",
                                    "in/isSource": true
                                },
                                "transform": "./transformers#boardListsToSelectArray"
                            }
                        },
                        "tooltip": "Select a list."
                    },
                    "name": {
                        "type": "text",
                        "label": "Card Name",
                        "tooltip": "The name for the card.",
                        "index": 3
                    },
                    "description": {
                        "type": "text",
                        "label": "Card Description",
                        "tooltip": "The description for the card.",
                        "index": 4
                    },
                    "position": {
                        "type": "select",
                        "options": [
                            { "value": "top", "content": "top"},
                            { "value": "bottom", "content": "bottom"}
                        ],
                        "defaultValue": "bottom",
                        "label": "Card Position",
                        "tooltip": "The position of the new card.",
                        "index": 5
                    },
                    "dueDate": {
                        "type": "date-time",
                        "label": "Due Date",
                        "index": 6,
                        "tooltip": "The card due date. It must be in the RFC3339 format. <br/><br/>Example: <i>2017-04-12T23:20:50.52Z</i> <br/> <br/>represents 20 minutes and 50.52 seconds after the 23rd hour of April 12th, 2017 in UTC."
                    },
                    "checklistName": {
                        "type": "text",
                        "label": "Checklist Name",
                        "tooltip": "The name of the checklist.",
                        "index": 7
                    },
                    "checklistItems": {
                        "type": "textarea",
                        "label": "Checklist Items",
                        "tooltip": "Enter up to 10 checklist items. Each item should be on a new line. If you need to add more items, you can do so after creating the card and using the AddChecklistToCard or AddChecklistItemToCard components.",
                        "index": 8
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "card",
            "options": [
                {
                    "label": "id",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "5f1e8a9b2c3d4e5f6a7b8c9d"
                    }
                },
                {
                    "label": "badges",
                    "value": "badges",
                    "schema": {
                        "type": "object",
                        "example": {
                            "votes": 0,
                            "viewingMemberVoted": false,
                            "subscribed": false,
                            "fogbugz": "",
                            "checkItems": 0,
                            "checkItemsChecked": 0,
                            "comments": 0,
                            "attachments": 0,
                            "description": true,
                            "due": "2026-09-20T12:00:00.000Z",
                            "dueComplete": false
                        }
                    }
                },
                {
                    "label": "badges.votes",
                    "value": "badges.votes",
                    "schema": {
                        "type": "integer",
                        "example": 0
                    }
                },
                {
                    "label": "badges.viewingMemberVoted",
                    "value": "badges.viewingMemberVoted",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "badges.subscribed",
                    "value": "badges.subscribed",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "badges.fogbugz",
                    "value": "badges.fogbugz",
                    "schema": {
                        "type": "string",
                        "example": ""
                    }
                },
                {
                    "label": "badges.checkItems",
                    "value": "badges.checkItems",
                    "schema": {
                        "type": "integer",
                        "example": 0
                    }
                },
                {
                    "label": "badges.checkItemsChecked",
                    "value": "badges.checkItemsChecked",
                    "schema": {
                        "type": "integer",
                        "example": 0
                    }
                },
                {
                    "label": "badges.comments",
                    "value": "badges.comments",
                    "schema": {
                        "type": "integer",
                        "example": 0
                    }
                },
                {
                    "label": "badges.attachments",
                    "value": "badges.attachments",
                    "schema": {
                        "type": "integer",
                        "example": 0
                    }
                },
                {
                    "label": "badges.description",
                    "value": "badges.description",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "badges.due",
                    "value": "badges.due",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "2026-09-20T12:00:00.000Z"
                    }
                },
                {
                    "label": "badges.dueComplete",
                    "value": "badges.dueComplete",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "checkItemStates",
                    "value": "checkItemStates",
                    "schema": {
                        "type": "array",
                        "example": []
                    }
                },
                {
                    "label": "closed",
                    "value": "closed",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "dateLastActivity",
                    "value": "dateLastActivity",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00.000Z"
                    }
                },
                {
                    "label": "desc",
                    "value": "desc",
                    "schema": {
                        "type": "string",
                        "example": "Customer asked for a quote with annual billing."
                    }
                },
                {
                    "label": "descData",
                    "value": "descData",
                    "schema": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "example": {
                            "emoji": {}
                        }
                    }
                },
                {
                    "label": "due",
                    "value": "due",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "2026-09-20T12:00:00.000Z"
                    }
                },
                {
                    "label": "dueComplete",
                    "value": "dueComplete",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "email",
                    "value": "email",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "idBoard",
                    "value": "idBoard",
                    "schema": {
                        "type": "string",
                        "example": "5f1e8a9b2c3d4e5f6a7b8c00"
                    }
                },
                {
                    "label": "idChecklists",
                    "value": "idChecklists",
                    "schema": {
                        "type": "array",
                        "example": []
                    }
                },
                {
                    "label": "idLabels",
                    "value": "idLabels",
                    "schema": {
                        "type": "array",
                        "example": [
                            "5f1e8a9b2c3d4e5f6a7b8c9e"
                        ]
                    }
                },
                {
                    "label": "idList",
                    "value": "idList",
                    "schema": {
                        "type": "string",
                        "example": "5f1e8a9b2c3d4e5f6a7b8c01"
                    }
                },
                {
                    "label": "idMembers",
                    "value": "idMembers",
                    "schema": {
                        "type": "array",
                        "example": []
                    }
                },
                {
                    "label": "idShort",
                    "value": "idShort",
                    "schema": {
                        "type": "integer",
                        "example": 42
                    }
                },
                {
                    "label": "idAttachmentCover",
                    "value": "idAttachmentCover",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "manualCoverAttachment",
                    "value": "manualCoverAttachment",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "labels",
                    "value": "labels",
                    "schema": {
                        "type": "array",
                        "example": [
                            {
                                "id": "5f1e8a9b2c3d4e5f6a7b8c9e",
                                "idBoard": "5f1e8a9b2c3d4e5f6a7b8c00",
                                "name": "Urgent",
                                "color": "red"
                            }
                        ]
                    }
                },
                {
                    "label": "name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Prepare Q3 report"
                    }
                },
                {
                    "label": "pos",
                    "value": "pos",
                    "schema": {
                        "type": "number",
                        "example": 65535
                    }
                },
                {
                    "label": "shortUrl",
                    "value": "shortUrl",
                    "schema": {
                        "type": "string",
                        "example": "https://trello.com/c/AbCd1234"
                    }
                },
                {
                    "label": "url",
                    "value": "url",
                    "schema": {
                        "type": "string",
                        "example": "https://trello.com/c/AbCd1234/42-prepare-q3-report"
                    }
                }
            ]
        }
    ]
}
