{
    "name": "appmixer.trello.list.FindCard",
    "author": "Pawel Putko <pputko@ntrc.eu>",
    "icon": "data:image/svg+xml;base64,",
    "description": "This action finds card in trello board.",
    "private": false,
    "version": "1.0.1",
    "auth": {
        "service": "appmixer:trello"
    },
    "quota": {
        "manager": "appmixer:trello",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "query": { "type": "string", "maxLength": 16384 },
                    "boardId": { "type": "string" }
                },
                "required": [
                    "query"
                ]
            },
            "inspector": {
                "inputs": {
                    "query": {
                        "type": "text",
                        "label": "Query",
                        "index": 1,
                        "tooltip": "Search query."
                    },
                    "boardId": {
                        "type": "select",
                        "label": "Board",
                        "index": 1,
                        "source": {
                            "url": "/component/appmixer/trello/list/ListBoards?outPort=boards",
                            "data": {
                                "transform": "./transformers#boardsToSelectArray"
                            }
                        },
                        "tooltip": "Select a board if you want to search specific board only."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "card",
            "options": [
                {
                    "label": "id",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "5f1e8a9b2c3d4e5f6a7b8c9d"
                    }
                },
                {
                    "label": "badges",
                    "value": "badges",
                    "schema": {
                        "type": "object",
                        "example": {
                            "votes": 0,
                            "viewingMemberVoted": false,
                            "subscribed": false,
                            "fogbugz": "",
                            "checkItems": 0,
                            "checkItemsChecked": 0,
                            "comments": 0,
                            "attachments": 0,
                            "description": true,
                            "due": "2024-09-20T12:00:00.000Z",
                            "dueComplete": false
                        }
                    }
                },
                {
                    "label": "badges.votes",
                    "value": "badges.votes",
                    "schema": {
                        "type": "integer",
                        "example": 0
                    }
                },
                {
                    "label": "badges.viewingMemberVoted",
                    "value": "badges.viewingMemberVoted",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "badges.subscribed",
                    "value": "badges.subscribed",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "badges.fogbugz",
                    "value": "badges.fogbugz",
                    "schema": {
                        "type": "string",
                        "example": ""
                    }
                },
                {
                    "label": "badges.checkItems",
                    "value": "badges.checkItems",
                    "schema": {
                        "type": "integer",
                        "example": 0
                    }
                },
                {
                    "label": "badges.checkItemsChecked",
                    "value": "badges.checkItemsChecked",
                    "schema": {
                        "type": "integer",
                        "example": 0
                    }
                },
                {
                    "label": "badges.comments",
                    "value": "badges.comments",
                    "schema": {
                        "type": "integer",
                        "example": 0
                    }
                },
                {
                    "label": "badges.attachments",
                    "value": "badges.attachments",
                    "schema": {
                        "type": "integer",
                        "example": 0
                    }
                },
                {
                    "label": "badges.description",
                    "value": "badges.description",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "badges.due",
                    "value": "badges.due",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "2024-09-20T12:00:00.000Z"
                    }
                },
                {
                    "label": "badges.dueComplete",
                    "value": "badges.dueComplete",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "checkItemStates",
                    "value": "checkItemStates",
                    "schema": {
                        "type": "array",
                        "example": []
                    }
                },
                {
                    "label": "closed",
                    "value": "closed",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "dateLastActivity",
                    "value": "dateLastActivity",
                    "schema": {
                        "type": "string",
                        "example": "2024-09-10T08:30:00.000Z"
                    }
                },
                {
                    "label": "desc",
                    "value": "desc",
                    "schema": {
                        "type": "string",
                        "example": "Customer asked for a quote with annual billing."
                    }
                },
                {
                    "label": "descData",
                    "value": "descData",
                    "schema": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "example": {
                            "emoji": {}
                        }
                    }
                },
                {
                    "label": "due",
                    "value": "due",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "2024-09-20T12:00:00.000Z"
                    }
                },
                {
                    "label": "dueComplete",
                    "value": "dueComplete",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "email",
                    "value": "email",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "idBoard",
                    "value": "idBoard",
                    "schema": {
                        "type": "string",
                        "example": "5f1e8a9b2c3d4e5f6a7b8c00"
                    }
                },
                {
                    "label": "idChecklists",
                    "value": "idChecklists",
                    "schema": {
                        "type": "array",
                        "example": []
                    }
                },
                {
                    "label": "idLabels",
                    "value": "idLabels",
                    "schema": {
                        "type": "array",
                        "example": [
                            "5f1e8a9b2c3d4e5f6a7b8c9e"
                        ]
                    }
                },
                {
                    "label": "idList",
                    "value": "idList",
                    "schema": {
                        "type": "string",
                        "example": "5f1e8a9b2c3d4e5f6a7b8c01"
                    }
                },
                {
                    "label": "idMembers",
                    "value": "idMembers",
                    "schema": {
                        "type": "array",
                        "example": []
                    }
                },
                {
                    "label": "idShort",
                    "value": "idShort",
                    "schema": {
                        "type": "integer",
                        "example": 42
                    }
                },
                {
                    "label": "idAttachmentCover",
                    "value": "idAttachmentCover",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "manualCoverAttachment",
                    "value": "manualCoverAttachment",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "labels",
                    "value": "labels",
                    "schema": {
                        "type": "array",
                        "example": [
                            {
                                "id": "5f1e8a9b2c3d4e5f6a7b8c9e",
                                "idBoard": "5f1e8a9b2c3d4e5f6a7b8c00",
                                "name": "Urgent",
                                "color": "red"
                            }
                        ]
                    }
                },
                {
                    "label": "name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Prepare Q3 report"
                    }
                },
                {
                    "label": "pos",
                    "value": "pos",
                    "schema": {
                        "type": "number",
                        "example": 65535
                    }
                },
                {
                    "label": "shortUrl",
                    "value": "shortUrl",
                    "schema": {
                        "type": "string",
                        "example": "https://trello.com/c/AbCd1234"
                    }
                },
                {
                    "label": "url",
                    "value": "url",
                    "schema": {
                        "type": "string",
                        "example": "https://trello.com/c/AbCd1234/42-prepare-q3-report"
                    }
                }
            ]
        },
        {
            "name": "notFound",
            "options": [
                {
                    "label": "Query",
                    "value": "query",
                    "schema": {
                        "type": "string",
                        "example": "Q3 report"
                    }
                }
            ]
        }
    ]
}
