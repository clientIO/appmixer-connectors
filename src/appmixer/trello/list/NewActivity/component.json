{
    "name": "appmixer.trello.list.NewActivity",
    "author": "Robert Beinaravicius <rbeinaravicius@ntrc.eu>",
    "icon": "data:image/svg+xml;base64,",
    "description": "This trigger fires every time there is activity in Trello.",
    "private": false,
    "tick": true,
    "auth": {
        "service": "appmixer:trello"
    },
    "quota": {
        "manager": "appmixer:trello",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "outPorts": [
        {
            "name": "activity",
            "options": [
                {
                    "label": "id",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "5f1e8a9b2c3d4e5f6a7b8c02"
                    }
                },
                {
                    "label": "date",
                    "value": "date",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00.000Z"
                    }
                },
                {
                    "label": "type",
                    "value": "type",
                    "schema": {
                        "type": "string",
                        "example": "commentCard"
                    }
                },
                {
                    "label": "idMemberCreator",
                    "value": "idMemberCreator",
                    "schema": {
                        "type": "string",
                        "example": "5a1b2c3d4e5f6a7b8c9d0e1f"
                    }
                },
                {
                    "label": "memberCreator.id",
                    "value": "memberCreator.id",
                    "schema": {
                        "type": "string",
                        "example": "5a1b2c3d4e5f6a7b8c9d0e1f"
                    }
                },
                {
                    "label": "memberCreator.avatarHash",
                    "value": "memberCreator.avatarHash",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "a8f5f167f44f4964e6c998dee827110c"
                    }
                },
                {
                    "label": "memberCreator.fullName",
                    "value": "memberCreator.fullName",
                    "schema": {
                        "type": "string",
                        "example": "Jane Doe"
                    }
                },
                {
                    "label": "memberCreator.initials",
                    "value": "memberCreator.initials",
                    "schema": {
                        "type": "string",
                        "example": "JD"
                    }
                },
                {
                    "label": "memberCreator.username",
                    "value": "memberCreator.username",
                    "schema": {
                        "type": "string",
                        "example": "janedoe"
                    }
                }
            ]
        }
    ],
    "properties": {
        "schema": {
            "properties": {
                "boardId": { "type": "string" },
                "boardListId": { "type": "string" },
                "boardListCardId": { "type": "string" }
            }
        },
        "inspector": {
            "inputs": {
                "boardId": {
                    "type": "text",
                    "label": "Board",
                    "index": 1,
                    "source": {
                        "url": "/component/appmixer/trello/list/ListBoards?outPort=boards",
                        "data": {
                            "transform": "./transformers#boardsToSelectArray"
                        }
                    },
                    "tooltip": "Select a board."
                },
                "boardListId": {
                    "type": "text",
                    "label": "Board List",
                    "index": 2,
                    "source": {
                        "url": "/component/appmixer/trello/list/ListBoardsList?outPort=lists",
                        "data": {
                            "messages": {
                                "in/boardId": "properties/boardId"
                            },
                            "transform": "./transformers#boardListsToSelectArray"
                        }
                    },
                    "tooltip": "Select a list."
                },
                "boardListCardId": {
                    "type": "text",
                    "label": "Card",
                    "index": 3,
                    "source": {
                        "url": "/component/appmixer/trello/list/ListBoardsCards?outPort=cards",
                        "data": {
                            "messages": {
                                "in/boardId": "properties/boardId"
                            },
                            "transform": "./transformers#cardListsToSelectArray"
                        }
                    },
                    "tooltip": "Select a card."
                }
            }
        }
    },
    "version": "1.0.1"
}
