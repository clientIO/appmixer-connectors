{
    "name": "appmixer.trello.list.AddAttachmentToCard",
    "author": "Robert Beinaravicius <rbeinaravicius@ntrc.eu>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Add an attachment to a specific card.",
    "private": false,
    "version": "1.0.1",
    "auth": {
        "service": "appmixer:trello"
    },
    "quota": {
        "manager": "appmixer:trello",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "boardId": { "type": "string" },
                    "url": { "type": "string" },
                    "name": {
                        "type": "string",
                        "maxLength": 256
                    },
                    "boardListCardId": { "type": "string" }
                },
                "required": [
                    "url",
                    "boardListCardId"
                ]
            },
            "inspector": {
                "inputs": {
                    "boardId": {
                        "type": "text",
                        "label": "Board",
                        "index": 1,
                        "source": {
                            "url": "/component/appmixer/trello/list/ListBoards?outPort=boards",
                            "data": {
                                "transform": "./transformers#boardsToSelectArray"
                            }
                        },
                        "tooltip": "Select a board."
                    },
                    "boardListCardId": {
                        "type": "text",
                        "label": "Card",
                        "index": 2,
                        "source": {
                            "url": "/component/appmixer/trello/list/ListBoardsCards?outPort=cards",
                            "data": {
                                "messages": {
                                    "in/boardId": "inputs/in/boardId"
                                },
                                "transform": "./transformers#cardListsToSelectArray"
                            }
                        },
                        "tooltip": "Select a card."
                    },
                    "url": {
                        "type": "text",
                        "label": "Attach a Link",
                        "index": 3,
                        "tooltip": "Paste any link here."
                    },
                    "name": {
                        "type": "text",
                        "label": "Attachment Name",
                        "tooltip": "The name for the attachment.",
                        "index": 4
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "attachment",
            "options": [
                {
                    "label": "id",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "65f2a1b3c4d5e6f701234568"
                    }
                },
                {
                    "label": "bytes",
                    "value": "bytes",
                    "schema": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "date",
                    "value": "date",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00.000Z"
                    }
                },
                {
                    "label": "edgeColor",
                    "value": "edgeColor",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "idMember",
                    "value": "idMember",
                    "schema": {
                        "type": "string",
                        "example": "5a1f2b3c4d5e6f7a8b9c0d1f"
                    }
                },
                {
                    "label": "isUpload",
                    "value": "isUpload",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "mimeType",
                    "value": "mimeType",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": ""
                    }
                },
                {
                    "label": "name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Project brief"
                    }
                },
                {
                    "label": "previews",
                    "value": "previews",
                    "schema": {
                        "type": "array",
                        "example": []
                    }
                },
                {
                    "label": "url",
                    "value": "url",
                    "schema": {
                        "type": "string",
                        "example": "https://example.com/project-brief.pdf"
                    }
                },
                {
                    "label": "pos",
                    "value": "pos",
                    "schema": {
                        "type": "number",
                        "example": 16384
                    }
                }
            ]
        }
    ]
}
