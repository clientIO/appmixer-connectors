{
    "name": "appmixer.trello.list.NewCard",
    "author": "Robert Beinaravicius <rbeinaravicius@ntrc.eu>",
    "icon": "data:image/svg+xml;base64,",
    "description": "This trigger fires every time a new card is added in Trello.",
    "private": false,
    "tick": true,
    "auth": {
        "service": "appmixer:trello"
    },
    "quota": {
        "manager": "appmixer:trello",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "outPorts": [
        {
            "name": "card",
            "options": [
                {
                    "label": "idCard",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "5f1e8a9b2c3d4e5f6a7b8c9d"
                    }
                },
                {
                    "label": "name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Prepare Q3 report"
                    }
                },
                {
                    "label": "desc",
                    "value": "desc",
                    "schema": {
                        "type": "string",
                        "example": "Customer asked for a quote with annual billing."
                    }
                },
                {
                    "label": "due",
                    "value": "due",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "2026-09-20T12:00:00.000Z"
                    }
                },
                {
                    "label": "idBoard",
                    "value": "idBoard",
                    "schema": {
                        "type": "string",
                        "example": "5f1e8a9b2c3d4e5f6a7b8c00"
                    }
                },
                {
                    "label": "idList",
                    "value": "idList",
                    "schema": {
                        "type": "string",
                        "example": "5f1e8a9b2c3d4e5f6a7b8c01"
                    }
                },
                {
                    "label": "shortLink",
                    "value": "shortLink",
                    "schema": {
                        "type": "string",
                        "example": "AbCd1234"
                    }
                },
                {
                    "label": "shortUrl",
                    "value": "shortUrl",
                    "schema": {
                        "type": "string",
                        "example": "https://trello.com/c/AbCd1234"
                    }
                },
                {
                    "label": "url",
                    "value": "url",
                    "schema": {
                        "type": "string",
                        "example": "https://trello.com/c/AbCd1234/42-prepare-q3-report"
                    }
                }
            ]
        }
    ],
    "properties": {
        "schema": {
            "properties": {
                "boardId": { "type": "string" },
                "boardListId": { "type": "string" }
            },
            "required": [
                "boardId"
            ]
        },
        "inspector": {
            "inputs": {
                "boardId": {
                    "type": "text",
                    "label": "Board",
                    "index": 1,
                    "source": {
                        "url": "/component/appmixer/trello/list/ListBoards?outPort=boards",
                        "data": {
                            "transform": "./transformers#boardsToSelectArray"
                        }
                    },
                    "tooltip": "Select a board."
                },
                "boardListId": {
                    "type": "text",
                    "label": "Board List",
                    "index": 2,
                    "source": {
                        "url": "/component/appmixer/trello/list/ListBoardsList?outPort=lists",
                        "data": {
                            "messages": {
                                "in/boardId": "properties/boardId"
                            },
                            "transform": "./transformers#boardListsToSelectArray"
                        }
                    },
                    "tooltip": "Select a list. If not selected, component will trigger whenever a new card is created in any board list."
                }
            }
        }
    },
    "version": "1.0.1"
}
