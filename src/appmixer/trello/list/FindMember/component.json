{
    "name": "appmixer.trello.list.FindMember",
    "author": "Pawel Putko <pputko@ntrc.eu>",
    "icon": "data:image/svg+xml;base64,",
    "description": "This action finds member in trello board.",
    "private": false,
    "version": "1.0.1",
    "auth": {
        "service": "appmixer:trello"
    },
    "quota": {
        "manager": "appmixer:trello",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": { "type": "string", "maxLength": 16384 },
                    "boardId": {
                        "oneOf": [
                            { "type": "string" },
                            { "type": "null" }
                        ]
                    }
                },
                "required": [
                    "name"
                ]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "label": "Member Name",
                        "tooltip": "The name of the member.",
                        "index": 1
                    },
                    "boardId": {
                        "type": "select",
                        "label": "Board",
                        "index": 2,
                        "source": {
                            "url": "/component/appmixer/trello/list/ListBoards?outPort=boards",
                            "data": {
                                "transform": "./transformers#boardsToSelectArray"
                            }
                        },
                        "tooltip": "Select a board if you want to search specific board only."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "member",
            "options": [
                {
                    "label": "avatarHash",
                    "value": "avatarHash",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "fc8faaaee46666a4eb8b626c08933e16"
                    }
                },
                {
                    "label": "avatarSource",
                    "value": "avatarSource",
                    "schema": {
                        "type": "string",
                        "example": "gravatar"
                    }
                },
                {
                    "label": "bio",
                    "value": "bio",
                    "schema": {
                        "type": "string",
                        "example": "Product designer at Acme"
                    }
                },
                {
                    "label": "confirmed",
                    "value": "confirmed",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "email",
                    "value": "email",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "jane.doe@example.com"
                    }
                },
                {
                    "label": "fullName",
                    "value": "fullName",
                    "schema": {
                        "type": "string",
                        "example": "Jane Doe"
                    }
                },
                {
                    "label": "gravatarHash",
                    "value": "gravatarHash",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "0a1e804f6e35a65ae5e1f7ef4c92471c"
                    }
                },
                {
                    "label": "id",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "5a1f2b3c4d5e6f7a8b9c0d1f"
                    }
                },
                {
                    "label": "idBoards",
                    "value": "idBoards",
                    "schema": {
                        "type": "array",
                        "example": [
                            "5abbe4b7ddc1b351ef961414"
                        ]
                    }
                },
                {
                    "label": "idBoardsPinned",
                    "value": "idBoardsPinned",
                    "schema": {
                        "type": [
                            "array",
                            "null"
                        ],
                        "example": [
                            "5abbe4b7ddc1b351ef961414"
                        ]
                    }
                },
                {
                    "label": "idEnterprise",
                    "value": "idEnterprise",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "idEnterprisesAdmin",
                    "value": "idEnterprisesAdmin",
                    "schema": {
                        "type": "array",
                        "example": []
                    }
                },
                {
                    "label": "idOrganizations",
                    "value": "idOrganizations",
                    "schema": {
                        "type": "array",
                        "example": [
                            "5a1f2b3c4d5e6f7a8b9c0d1e"
                        ]
                    }
                },
                {
                    "label": "idPremOrgsAdmin",
                    "value": "idPremOrgsAdmin",
                    "schema": {
                        "type": "array",
                        "example": []
                    }
                },
                {
                    "label": "initials",
                    "value": "initials",
                    "schema": {
                        "type": "string",
                        "example": "JD"
                    }
                },
                {
                    "label": "limits.boards.totalPerMember.status",
                    "value": "limits.boards.totalPerMember.status",
                    "schema": {
                        "type": "string",
                        "example": "ok"
                    }
                },
                {
                    "label": "limits.boards.totalPerMember.disableAt",
                    "value": "limits.boards.totalPerMember.disableAt",
                    "schema": {
                        "type": "integer",
                        "example": 36000
                    }
                },
                {
                    "label": "limits.boards.totalPerMember.warnAt",
                    "value": "limits.boards.totalPerMember.warnAt",
                    "schema": {
                        "type": "integer",
                        "example": 32400
                    }
                },
                {
                    "label": "limits.orgs.totalPerMember.status",
                    "value": "limits.orgs.totalPerMember.status",
                    "schema": {
                        "type": "string",
                        "example": "ok"
                    }
                },
                {
                    "label": "limits.orgs.totalPerMember.disableAt",
                    "value": "limits.orgs.totalPerMember.disableAt",
                    "schema": {
                        "type": "integer",
                        "example": 850
                    }
                },
                {
                    "label": "limits.orgs.totalPerMember.warnAt",
                    "value": "limits.orgs.totalPerMember.warnAt",
                    "schema": {
                        "type": "integer",
                        "example": 765
                    }
                },
                {
                    "label": "loginTypes",
                    "value": "loginTypes",
                    "schema": {
                        "type": "array",
                        "example": [
                            "password"
                        ]
                    }
                },
                {
                    "label": "memberType",
                    "value": "memberType",
                    "schema": {
                        "type": "string",
                        "example": "normal"
                    }
                },
                {
                    "label": "messagesDismissed",
                    "value": "messagesDismissed",
                    "schema": {
                        "type": "array",
                        "example": [
                            {
                                "name": "ad-security-features",
                                "count": "1",
                                "lastDismissed": "2024-03-11T20:19:46.809Z",
                                "_id": "5abbe4b7ddc1b351ef961415"
                            }
                        ]
                    }
                },
                {
                    "label": "oneTimeMessagesDismissed",
                    "value": "oneTimeMessagesDismissed",
                    "schema": {
                        "type": "array",
                        "example": [
                            "create-first-board"
                        ]
                    }
                },
                {
                    "label": "prefs.colorBlind",
                    "value": "prefs.colorBlind",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "prefs.minutesBeforeDeadlineToNotify",
                    "value": "prefs.minutesBeforeDeadlineToNotify",
                    "schema": {
                        "type": "integer",
                        "example": 1440
                    }
                },
                {
                    "label": "prefs.minutesBetweenSummaries",
                    "value": "prefs.minutesBetweenSummaries",
                    "schema": {
                        "type": "integer",
                        "example": 60
                    }
                },
                {
                    "label": "prefs.sendSummaries",
                    "value": "prefs.sendSummaries",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "prefs.locale",
                    "value": "prefs.locale",
                    "schema": {
                        "type": "string",
                        "example": "en-US"
                    }
                },
                {
                    "label": "premiumFeatures",
                    "value": "premiumFeatures",
                    "schema": {
                        "type": "array",
                        "example": [
                            "additionalBoardBackgrounds",
                            "additionalStickers",
                            "customBoardBackgrounds",
                            "customEmoji",
                            "customStickers",
                            "plugins"
                        ]
                    }
                },
                {
                    "label": "products",
                    "value": "products",
                    "schema": {
                        "type": "array",
                        "example": []
                    }
                },
                {
                    "label": "status",
                    "value": "status",
                    "schema": {
                        "type": "string",
                        "example": "disconnected"
                    }
                },
                {
                    "label": "trophies",
                    "value": "trophies",
                    "schema": {
                        "type": "array",
                        "example": []
                    }
                },
                {
                    "label": "uploadedAvatarHash",
                    "value": "uploadedAvatarHash",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "dac3ad49ff117829dd63a79bb2ea3426"
                    }
                },
                {
                    "label": "url",
                    "value": "url",
                    "schema": {
                        "type": "string",
                        "example": "https://trello.com/janedoe"
                    }
                },
                {
                    "label": "username",
                    "value": "username",
                    "schema": {
                        "type": "string",
                        "example": "janedoe"
                    }
                }
            ]
        },
        {
            "name": "notFound",
            "options": [
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Jane Doe"
                    }
                }
            ]
        }
    ]
}
