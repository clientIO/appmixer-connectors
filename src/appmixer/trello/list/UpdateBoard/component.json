                        "example": true
                    }
                },
                {
                    "label": "prefs.voting",
                    "value": "prefs.voting",
                    "schema": {
                        "type": "string",
                        "example": "disabled"
                    }
                },
                {
                    "label": "shortUrl",
                    "value": "shortUrl",
                    "schema": {
                        "type": "string",
                        "example": "https://trello.com/b/nC8QJJoZ"
                    }
                },
                {
                    "label": "url",
                    "value": "url",
                    "schema": {
                        "type": "string",
                        "example": "https://trello.com/b/nC8QJJoZ/sprint-planning"
                    }
                }
            ]
        }
    ]
}
