{
    "name": "appmixer.trello.list.UpdateBoard",
    "author": "Pawel Putko <pputko@ntrc.eu>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Update a board's name and description.",
    "private": false,
    "version": "1.0.1",
    "auth": {
        "service": "appmixer:trello"
    },
    "quota": {
        "manager": "appmixer:trello",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "boardId": { "type": "string" },
                    "name": { "type": "string", "maxLength": 16384 },
                    "description": { "type": "string", "maxLength": 16384 }
                },
                "required": [ "boardId" ]
            },
            "inspector": {
                "inputs": {
                    "boardId": {
                        "type": "text",
                        "label": "Board",
                        "index": 1,
                        "source": {
                            "url": "/component/appmixer/trello/list/ListBoards?outPort=boards",
                            "data": {
                                "transform": "./transformers#boardsToSelectArray"
                            }
                        },
                        "tooltip": "Select a board."
                    },
                    "name": {
                        "type": "text",
                        "label": "Board Name",
                        "tooltip": "The new name for the board.",
                        "index": 1
                    },
                    "description": {
                        "type": "text",
                        "label": "Board Description",
                        "tooltip": "The new description for the board.",
                        "index": 2
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "board",
            "options": [
                {
                    "label": "closed",
                    "value": "closed",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "desc",
                    "value": "desc",
                    "schema": {
                        "type": "string",
                        "example": "Sprint planning for the web team"
                    }
                },
                {
                    "label": "descData",
                    "value": "descData",
                    "schema": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "id",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "5abbe4b7ddc1b351ef961414"
                    }
                },
                {
                    "label": "idOrganization",
                    "value": "idOrganization",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "5a1f2b3c4d5e6f7a8b9c0d1e"
                    }
                },
                {
                    "label": "labelNames.black",
                    "value": "labelNames.black",
                    "schema": {
                        "type": "string",
                        "example": ""
                    }
                },
                {
                    "label": "labelNames.blue",
                    "value": "labelNames.blue",
                    "schema": {
                        "type": "string",
                        "example": ""
                    }
                },
                {
                    "label": "labelNames.green",
                    "value": "labelNames.green",
                    "schema": {
                        "type": "string",
                        "example": ""
                    }
                },
                {
                    "label": "labelNames.lime",
                    "value": "labelNames.lime",
                    "schema": {
                        "type": "string",
                        "example": ""
                    }
                },
                {
                    "label": "labelNames.orange",
                    "value": "labelNames.orange",
                    "schema": {
                        "type": "string",
                        "example": ""
                    }
                },
                {
                    "label": "labelNames.pink",
                    "value": "labelNames.pink",
                    "schema": {
                        "type": "string",
                        "example": ""
                    }
                },
                {
                    "label": "labelNames.purple",
                    "value": "labelNames.purple",
                    "schema": {
                        "type": "string",
                        "example": ""
                    }
                },
                {
                    "label": "labelNames.red",
                    "value": "labelNames.red",
                    "schema": {
                        "type": "string",
                        "example": ""
                    }
                },
                {
                    "label": "labelNames.sky",
                    "value": "labelNames.sky",
                    "schema": {
                        "type": "string",
                        "example": ""
                    }
                },
                {
                    "label": "name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Sprint Planning"
                    }
                },
                {
                    "label": "pinned",
                    "value": "pinned",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "prefs.background",
                    "value": "prefs.background",
                    "schema": {
                        "type": "string",
                        "example": "blue"
                    }
                },
                {
                    "label": "prefs.backgroundBrightness",
