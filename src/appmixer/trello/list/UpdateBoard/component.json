                },
                {
                    "label": "prefs.canBePrivate",
                    "value": "prefs.canBePrivate",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "prefs.canBePublic",
                    "value": "prefs.canBePublic",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "prefs.canInvite",
                    "value": "prefs.canInvite",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "prefs.cardAging",
                    "value": "prefs.cardAging",
                    "schema": {
                        "type": "string",
                        "example": "regular"
                    }
                },
                {
                    "label": "prefs.cardCovers",
                    "value": "prefs.cardCovers",
                    "schema": {
