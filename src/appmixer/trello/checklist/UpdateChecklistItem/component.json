{
    "name": "appmixer.trello.checklist.UpdateChecklistItem",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Update an item in a checklist on a card.",
    "private": false,
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:trello"
    },
    "quota": {
        "manager": "appmixer:trello",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "boardId": {
                        "type": "string"
                    },
                    "boardListCardId": {
                        "type": "string"
                    },
                    "checklistId": {
                        "type": "string"
                    },
                    "checklistItemId": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string",
                        "maxLength": 16384
                    },
                    "state": {
                        "type": "string"
                    }
                },
                "required": [
                    "boardListCardId",
                    "checklistItemId",
                    "name"
                ]
            },
            "inspector": {
                "inputs": {
                    "boardId": {
                        "type": "text",
                        "label": "Board",
                        "index": 1,
                        "source": {
                            "url": "/component/appmixer/trello/list/ListBoards?outPort=boards",
                            "data": {
                                "transform": "./transformers#boardsToSelectArray"
                            }
                        },
                        "tooltip": "Select a board to choose a card in the following field. Or use the Card ID and Checklist Item ID directly and skip this field."
                    },
                    "boardListCardId": {
                        "type": "text",
                        "label": "Card",
                        "index": 2,
                        "source": {
                            "url": "/component/appmixer/trello/list/ListBoardsCards?outPort=cards",
                            "data": {
                                "messages": {
                                    "in/boardId": "inputs/in/boardId",
                                    "in/isSource": true
                                },
                                "transform": "./transformers#cardListsToSelectArray"
                            }
                        },
                        "tooltip": "Select a card from a board from the previous component. Or use the Checklist ID directly and skip this field."
                    },
                    "checklistId": {
                        "type": "text",
                        "label": "Checklist",
                        "source": {
                            "url": "/component/appmixer/trello/checklist/ListCardChecklists?outPort=out",
                            "data": {
                                "messages": {
                                    "in/boardListCardId": "inputs/in/boardListCardId",
                                    "in/isSource": true
                                },
                                "transform": "./transformers#cardChecklistsToSelectArray"
                            }
                        },
                        "tooltip": "The ID of the checklist from which to remove an item. You can skip this field and use the Checklist Item ID directly.",
                        "index": 3
                    },
                    "checklistItemId": {
                        "type": "select",
                        "label": "Checklist Item",
                        "tooltip": "The ID of the checklist item to update.",
                        "index": 4
                    },
                    "name": {
                        "type": "text",
                        "label": "Checklist Item Name",
                        "index": 5,
                        "tooltip": "New name of the checklist item."
                    },
                    "state": {
                        "type": "select",
                        "label": "State",
                        "tooltip": "The state of the checklist item.",
                        "index": 6,
                        "defaultValue": "incomplete",
                        "options": [
                            {
                                "label": "Complete",
                                "value": "complete"
                            },
                            {
                                "label": "Incomplete",
                                "value": "incomplete"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Checklist ID",
                    "value": "idChecklist",
                    "schema": {
                        "type": "string",
                        "example": "6789abcdef012345"
                    }
                },
                {
                    "label": "Checklist Item ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "7890abcdef012345"
                    }
                },
                {
                    "label": "Checklist Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Review pull requests (done)"
                    }
                },
                {
                    "label": "Position",
                    "value": "pos",
                    "schema": {
                        "type": "number",
                        "example": 16384
                    }
                },
                {
                    "label": "State",
                    "value": "state",
                    "schema": {
                        "example": "complete"
                    }
                },
                {
                    "label": "Due",
                    "value": "due",
                    "schema": {
                        "example": "2026-01-20T17:00:00.000Z"
                    }
                },
                {
                    "label": "Due Reminder",
                    "value": "dueReminder",
                    "schema": {
                        "example": "-1"
                    }
                },
                {
                    "label": "Member ID",
                    "value": "idMember",
                    "schema": {
                        "example": "abc123member456"
                    }
                },
                {
                    "label": "Limits",
                    "value": "limits",
                    "schema": {
                        "type": "object",
                        "example": {}
                    }
                }
            ]
        }
    ]
}
