{
    "name": "appmixer.airtop.core.FindSessions",
    "description": "Find Airtop sessions, optionally filtered by status. Returns a maximum of 100 sessions. The connection URLs are present only for sessions that are still running.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:airtop"
    },
    "quota": {
        "manager": "appmixer:airtop",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string"
                    },
                    "outputType": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "status": {
                        "type": "select",
                        "index": 1,
                        "label": "Status",
                        "tooltip": "Filter sessions by status. Leave empty to return sessions in any status.",
                        "options": [
                            {
                                "label": "All",
                                "value": ""
                            },
                            {
                                "label": "Awaiting Capacity",
                                "value": "awaitingCapacity"
                            },
                            {
                                "label": "Initializing",
                                "value": "initializing"
                            },
                            {
                                "label": "Running",
                                "value": "running"
                            },
                            {
                                "label": "Ended",
                                "value": "ended"
                            },
                            {
                                "label": "Completed",
                                "value": "completed"
                            },
                            {
                                "label": "Cancelled",
                                "value": "cancelled"
                            }
                        ]
                    },
                    "outputType": {
                        "type": "select",
                        "index": 2,
                        "label": "Output Type",
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, first item only, one item at a time, or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/airtop/core/FindSessions?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        },
        {
            "name": "notFound"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
