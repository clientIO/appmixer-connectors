{
    "name": "appmixer.airtop.core.TakeScreenshot",
    "description": "Take a screenshot of a browser window and store it as a file. The component outputs the File ID; the image itself never travels through the flow.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:airtop"
    },
    "quota": {
        "manager": "appmixer:airtop",
        "resources": "browser-operations",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "sessionId": {
                        "type": "string"
                    },
                    "windowId": {
                        "type": "string"
                    },
                    "maxWidth": {
                        "type": "integer"
                    },
                    "maxHeight": {
                        "type": "integer"
                    },
                    "costThresholdCredits": {
                        "type": "integer"
                    },
                    "timeThresholdSeconds": {
                        "type": "integer"
                    }
                },
                "required": [
                    "sessionId",
                    "windowId"
                ]
            },
            "inspector": {
                "inputs": {
                    "sessionId": {
                        "type": "text",
                        "index": 1,
                        "label": "Session ID",
                        "tooltip": "The ID of the Airtop session, typically taken from the output of the Create Session component."
                    },
                    "windowId": {
                        "type": "text",
                        "index": 2,
                        "label": "Window ID",
                        "tooltip": "The ID of the browser window, typically taken from the output of the Create Window component."
                    },
                    "maxWidth": {
                        "type": "number",
                        "index": 3,
                        "label": "Max Width (px)",
                        "tooltip": "Scale the screenshot down to fit this width, preserving the aspect ratio."
                    },
                    "maxHeight": {
                        "type": "number",
                        "index": 4,
                        "label": "Max Height (px)",
                        "tooltip": "Scale the screenshot down to fit this height, preserving the aspect ratio."
                    },
                    "costThresholdCredits": {
                        "type": "number",
                        "index": 5,
                        "label": "Cost Threshold (credits)",
                        "tooltip": "Cancel the operation once it exceeds this many credits. Leave empty to use the Airtop default."
                    },
                    "timeThresholdSeconds": {
                        "type": "number",
                        "index": 6,
                        "label": "Time Threshold (seconds)",
                        "tooltip": "Cancel the operation once it runs longer than this many seconds, between 1 and 300. Leave empty to use the Airtop default."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "fileId",
                    "fileName",
                    "fileSize",
                    "status",
                    "requestId"
                ],
                "properties": {
                    "fileId": {
                        "type": "string",
                        "title": "File ID",
                        "example": "6a8da10544249be6241ce1ad"
                    },
                    "fileName": {
                        "type": "string",
                        "title": "File Name",
                        "example": "airtop-screenshot-1756900000000.jpg"
                    },
                    "fileSize": {
                        "type": "integer",
                        "title": "File Size (bytes)",
                        "example": 48213
                    },
                    "status": {
                        "type": "string",
                        "title": "Status",
                        "example": "success"
                    },
                    "requestId": {
                        "type": "string",
                        "title": "Request ID",
                        "example": "b1c0b7d3-6e37-4a5e-9d3b-3f2a1c8f9e11"
                    },
                    "credits": {
                        "type": "integer",
                        "title": "Credits Used",
                        "example": 12
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
