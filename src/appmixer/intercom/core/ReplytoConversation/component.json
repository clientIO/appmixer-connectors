                                        },
                                        "author": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "string",
                                                    "title": "Conversation Parts.Conversation Parts.Author.Id"
                                                },
                                                "type": {
                                                    "type": "string",
