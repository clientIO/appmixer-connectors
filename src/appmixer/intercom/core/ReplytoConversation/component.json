                },
                {
                    "label": "Sla Applied",
                    "value": "sla_applied",
                    "schema": {
                        "type": "string",
                        "example": null
                    }
                },
                {
                    "label": "Statistics",
                    "value": "statistics",
                    "schema": {
                        "type": "string",
                        "example": null
                    }
                },
                {
                    "label": "Conversation Rating",
                    "value": "conversation_rating",
                    "schema": {
                        "type": "string",
                        "example": null
                    }
                },
                {
                    "label": "Teammates",
                    "value": "teammates",
                    "schema": {
                        "type": "string",
                        "example": null
                    }
                },
                {
                    "label": "Title",
                    "value": "title",
                    "schema": {
                        "type": "string",
                        "example": "Question about billing"
                    }
                },
                {
                    "label": "Custom Attributes",
                    "value": "custom_attributes",
                    "schema": {
                        "type": "object",
                        "properties": {},
                        "example": {
                            "issue_type": "API"
                        }
                    }
                },
                {
                    "label": "Topics",
                    "value": "topics",
                    "schema": {
                        "type": "object",
                        "properties": {},
                        "example": {
                            "type": "topic.list",
                            "topics": [],
                            "total_count": 0
                        }
                    }
                },
                {
                    "label": "Ticket",
                    "value": "ticket",
                    "schema": {
                        "type": "string",
                        "example": null
