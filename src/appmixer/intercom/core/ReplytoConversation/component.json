                },
                {
                    "label": "Ai Agent Participated",
                    "value": "ai_agent_participated",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Conversation Parts",
                    "value": "conversation_parts",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "type": {
                                "type": "string",
                                "title": "Conversation Parts.Type"
                            },
                            "conversation_parts": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "type": {
                                            "type": "string",
