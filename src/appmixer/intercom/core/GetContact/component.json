            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "id": {
                        "type": "text",
                        "tooltip": "The unique identifier of the contact",
                        "label": "Contact Id",
                        "index": 0
                    }
                }
            }
        }
    ],
