{
    "name": "appmixer.intercom.core.GetCompany",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Get detailed information about a specific company using its unique identifier. Please note that the changes made using the Intercom API are not reflected in real time.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:intercom"
    },
    "quota": {
        "manager": "appmixer:intercom",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "id": {
                        "type": "text",
                        "tooltip": "The unique identifier of the company",
                        "label": "Company Id",
                        "index": 0
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Type",
                    "value": "type",
                    "schema": {
                        "type": "string",
                        "example": "company"
                    }
                },
                {
                    "label": "Company Remote Id",
                    "value": "company_id",
                    "schema": {
                        "type": "string",
                        "example": "company-abc123"
                    }
                },
                {
                    "label": "Company Id",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "6789abcdef567890"
                    }
                },
                {
                    "label": "App Id",
                    "value": "app_id",
                    "schema": {
                        "type": "string",
                        "example": "app123xyz"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "TechStart Inc."
                    }
                },
                {
                    "label": "Remote Created At",
                    "value": "remote_created_at",
                    "schema": {
                        "type": "number",
                        "example": 1672531200
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "number",
                        "example": 1672531200
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updated_at",
                    "schema": {
                        "type": "number",
                        "example": 1737024600
                    }
                },
                {
                    "label": "Monthly Spend",
                    "value": "monthly_spend",
                    "schema": {
                        "type": "number",
                        "example": 299
                    }
                },
                {
                    "label": "Session Count",
                    "value": "session_count",
                    "schema": {
                        "type": "number",
                        "example": 45
                    }
                },
                {
                    "label": "User Count",
                    "value": "user_count",
                    "schema": {
                        "type": "number",
                        "example": 12
                    }
                },
                {
                    "label": "Tags",
                    "value": "tags",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "type": {
                                "type": "string",
                                "title": "Tags.Type"
                            },
                            "tags": {
                                "type": "array",
                                "items": {},
                                "title": "Tags.Tags"
                            }
                        },
                        "example": {
                            "type": "tag.list",
                            "tags": [
                                {
                                    "type": "tag",
                                    "id": "2084335",
                                    "name": "enterprise"
                                }
                            ]
                        }
                    }
                },
                {
                    "label": "Segments",
                    "value": "segments",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "type": {
                                "type": "string",
                                "title": "Segments.Type"
                            },
                            "segments": {
                                "type": "array",
                                "items": {},
                                "title": "Segments.Segments"
                            }
                        },
                        "example": {
                            "type": "segment.list",
                            "segments": [
                                {
                                    "type": "segment",
                                    "id": "5d2f5e3a1c2b3a0012345678",
                                    "name": "Active"
                                }
                            ]
                        }
                    }
                },
                {
                    "label": "Plan",
                    "value": "plan",
                    "schema": {
                        "type": "object",
                        "properties": {},
                        "example": {
                            "type": "plan",
                            "id": "plan-pro",
                            "name": "Professional"
                        }
                    }
                },
                {
                    "label": "Custom Attributes",
                    "value": "custom_attributes",
                    "schema": {
                        "type": "object",
                        "properties": {},
                        "example": {
                            "industry": "Software",
                            "plan_tier": "growth"
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
