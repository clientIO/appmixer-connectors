{
    "name": "appmixer.facebook.page.NewPagePost",
    "author": "Martin Krcmar <martin@client.io>",
    "icon": "data:image/svg+xml;base64,",
    "description": "This trigger fires every time a new post is created on page.",
    "private": false,
    "tick": true,
    "auth": {
        "service": "appmixer:facebook",
        "scope": [
            "pages_read_engagement",
            "pages_read_user_content"
        ]
    },
    "quota": {
        "manager": "appmixer:facebook",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "outPorts": [
        {
            "name": "post",
            "options": [
                {
                    "label": "created_time",
                    "value": "created_time",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00+0000"
                    }
                },
                {
                    "label": "id",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "104857361234567_987654321098765"
                    }
                },
                {
                    "label": "Page name",
                    "value": "pageName",
                    "schema": {
                        "type": "string",
                        "example": "Acme Inc"
                    }
                },
                {
                    "label": "Page ID",
                    "value": "pageId",
                    "schema": {
                        "type": "string",
                        "example": "104857361234567"
                    }
                },
                {
                    "label": "message",
                    "value": "message",
                    "schema": {
                        "type": "string",
                        "example": "We are hiring! Join our engineering team."
                    }
                }
            ]
        }
    ],
    "properties": {
        "schema": {
            "properties": {
                "pageId": { "type": "string" }
            },
            "required": [
                "pageId"
            ]
        },
        "inspector": {
            "inputs": {
                "pageId": {
                    "type": "text",
                    "label": "Page",
                    "index": 1,
                    "source": {
                        "url": "/component/appmixer/facebook/page/ListPages?outPort=pages",
                        "data": {
                            "transform": "./ListPages#toSelectArray"
                        }
                    },
                    "tooltip": "Select page."
                }
            }
        }
    }
}
