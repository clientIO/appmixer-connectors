{
    "name": "appmixer.facebook.page.FindPagePosts",
    "author": "Appmixer <info@appmixer.com>",
    "label": "Find Page Posts",
    "description": "Find posts published by a Facebook Page you manage, newest first, optionally limited to a time range. When no post matches, the input is emitted on the Not Found port.",
    "auth": {
        "service": "appmixer:facebook",
        "scope": [
            "pages_show_list",
            "pages_read_engagement"
        ]
    },
    "quota": {
        "manager": "appmixer:facebook",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "pageId": { "type": "string" },
                    "since": { "type": "string", "format": "date-time" },
                    "until": { "type": "string", "format": "date-time" },
                    "maxResults": { "type": "integer", "minimum": 1, "maximum": 1000 },
                    "outputType": { "type": "string", "enum": ["first", "array", "object", "file"] }
                },
                "required": ["pageId"]
            },
            "inspector": {
                "inputs": {
                    "pageId": {
                        "type": "text",
                        "label": "Page",
                        "index": 1,
                        "source": {
                            "url": "/component/appmixer/facebook/page/ListPages?outPort=pages",
                            "data": {
                                "transform": "./ListPages#toSelectArray"
                            }
                        },
                        "tooltip": "Select a page you manage, or enter its Page ID."
                    },
                    "since": {
                        "type": "date-time",
                        "label": "Since",
                        "index": 2,
                        "tooltip": "Only return posts created at or after this time."
                    },
                    "until": {
                        "type": "date-time",
                        "label": "Until",
                        "index": 3,
                        "tooltip": "Only return posts created before this time."
                    },
                    "maxResults": {
                        "type": "number",
                        "label": "Maximum Results",
                        "index": 4,
                        "defaultValue": 100,
                        "tooltip": "How many of the newest posts to return, 1 to 1000. Facebook serves 100 posts per request, and each request counts against the 200 requests per hour limit."
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "index": 5,
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, first item only, one item at a time, or stream the items to a file.",
                        "options": [
                            { "label": "First Item Only", "value": "first" },
                            { "label": "All items at once", "value": "array" },
                            { "label": "One item at a time", "value": "object" },
                            { "label": "Store to CSV file", "value": "file" }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/facebook/page/FindPagePosts?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/pageId": "dummy",
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        },
        {
            "name": "notFound",
            "schema": {
                "type": "object",
                "properties": {
                    "pageId": { "type": "string", "title": "Page ID", "example": "104857361234567" },
                    "since": { "type": "string", "title": "Since", "example": "2026-09-01T00:00:00.000Z" },
                    "until": { "type": "string", "title": "Until", "example": "2026-09-30T23:59:59.000Z" }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
