{
    "name": "appmixer.shopify.inventory.InventoryLevelUpdated",
    "description": "Triggers when the inventory quantities of a product variant at a location change, e.g. for low-stock alerts.",
    "author": "Appmixer <info@appmixer.com>",
    "private": false,
    "webhook": true,
    "auth": {
        "service": "appmixer:shopify",
        "scope": [
            "read_inventory",
            "read_locations",
            "read_products"
        ]
    },
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "isActive",
                    "createdAt",
                    "updatedAt",
                    "quantities",
                    "item",
                    "location",
                    "webhookTopic"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Inventory Level ID",
                        "example": "gid://shopify/InventoryLevel/164439392337?inventory_item_id=64806874841169"
                    },
                    "isActive": {
                        "type": "boolean",
                        "title": "Active",
                        "example": true
                    },
                    "createdAt": {
                        "type": "string",
                        "title": "Created At",
                        "example": "2026-10-02T10:36:04Z",
                        "format": "date-time"
                    },
                    "updatedAt": {
                        "type": "string",
                        "title": "Updated At",
                        "example": "2026-10-02T15:33:11Z",
                        "format": "date-time"
                    },
                    "quantities": {
                        "type": "array",
                        "title": "Quantities",
                        "items": {
                            "type": "object",
                            "required": [
                                "name",
                                "quantity"
                            ],
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "title": "Name",
                                    "example": "available"
                                },
                                "quantity": {
                                    "type": "integer",
                                    "title": "Quantity",
                                    "example": 7
                                }
                            }
                        },
                        "example": [
                            {
                                "name": "available",
                                "quantity": 7
                            },
                            {
                                "name": "on_hand",
                                "quantity": 9
                            },
                            {
                                "name": "committed",
                                "quantity": 2
                            },
                            {
                                "name": "incoming",
                                "quantity": 0
                            },
                            {
                                "name": "reserved",
                                "quantity": 0
                            }
                        ]
                    },
                    "item": {
                        "type": "object",
                        "title": "Inventory Item",
                        "required": [
                            "id",
                            "legacyResourceId",
                            "tracked",
                            "variants"
                        ],
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Inventory Item.ID",
                                "example": "gid://shopify/InventoryItem/64806874841169"
                            },
                            "legacyResourceId": {
                                "type": "string",
                                "title": "Inventory Item.Legacy Resource ID",
                                "example": "64806874841169"
                            },
                            "sku": {
                                "type": "string",
                                "title": "Inventory Item.SKU",
                                "example": "SNOW-OOS-01"
                            },
                            "tracked": {
                                "type": "boolean",
                                "title": "Inventory Item.Tracked",
                                "example": true
                            },
                            "variants": {
                                "type": "array",
                                "title": "Inventory Item.Variants",
                                "items": {
                                    "type": "object",
                                    "required": [
                                        "id",
                                        "legacyResourceId",
                                        "title",
                                        "displayName",
                                        "product"
                                    ],
                                    "properties": {
                                        "id": {
                                            "type": "string",
                                            "title": "ID",
                                            "example": "gid://shopify/ProductVariant/62788973264977"
                                        },
                                        "legacyResourceId": {
                                            "type": "string",
                                            "title": "Legacy Resource ID",
                                            "example": "62788973264977"
                                        },
                                        "title": {
                                            "type": "string",
                                            "title": "Title",
                                            "example": "Default Title"
                                        },
                                        "displayName": {
                                            "type": "string",
                                            "title": "Display Name",
                                            "example": "The Out of Stock Snowboard - Default Title"
                                        },
                                        "product": {
                                            "type": "object",
                                            "title": "Product",
                                            "required": [
                                                "id",
                                                "title"
                                            ],
                                            "properties": {
                                                "id": {
                                                    "type": "string",
                                                    "title": "Product.ID",
                                                    "example": "gid://shopify/Product/16344831623249"
                                                },
                                                "title": {
                                                    "type": "string",
                                                    "title": "Product.Title",
                                                    "example": "The Out of Stock Snowboard"
                                                }
                                            }
                                        }
                                    }
                                },
                                "example": [
                                    {
                                        "id": "gid://shopify/ProductVariant/62788973264977",
                                        "legacyResourceId": "62788973264977",
                                        "title": "Default Title",
                                        "displayName": "The Out of Stock Snowboard - Default Title",
                                        "product": {
                                            "id": "gid://shopify/Product/16344831623249",
                                            "title": "The Out of Stock Snowboard"
                                        }
                                    }
                                ]
                            }
                        }
                    },
                    "location": {
                        "type": "object",
                        "title": "Location",
                        "required": [
                            "id",
                            "legacyResourceId",
                            "name"
                        ],
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Location.ID",
                                "example": "gid://shopify/Location/124679880785"
                            },
                            "legacyResourceId": {
                                "type": "string",
                                "title": "Location.Legacy Resource ID",
                                "example": "124679880785"
                            },
                            "name": {
                                "type": "string",
                                "title": "Location.Name",
                                "example": "Shop location"
                            }
                        }
                    },
                    "webhookTopic": {
                        "type": "string",
                        "title": "Webhook Topic",
                        "example": "inventory_levels/update"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
