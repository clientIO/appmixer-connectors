{
    "name": "appmixer.shopify.orders.NewRefund",
    "description": "Triggers when a refund is created on an order.",
    "author": "Appmixer <info@appmixer.com>",
    "private": false,
    "trigger": true,
    "webhook": true,
    "auth": {
        "service": "appmixer:shopify",
        "scope": [
            "read_orders"
        ]
    },
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "legacyResourceId",
                    "createdAt",
                    "updatedAt",
                    "processedAt",
                    "totalRefundedSet",
                    "refundLineItems",
                    "transactions",
                    "orderAdjustments",
                    "order",
                    "webhookTopic"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "ID",
                        "example": "gid://shopify/Refund/1221986910289"
                    },
                    "legacyResourceId": {
                        "type": "string",
                        "title": "Legacy Resource ID",
                        "example": "1221986910289"
                    },
                    "note": {
                        "type": "string",
                        "title": "Note",
                        "example": "Damaged in transit"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created At",
                        "example": "2026-10-05T08:25:09Z"
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Updated At",
                        "example": "2026-10-05T08:25:09Z"
                    },
                    "processedAt": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Processed At",
                        "example": "2026-10-05T08:25:09Z"
                    },
                    "totalRefundedSet": {
                        "type": "object",
                        "title": "Total Refunded",
                        "required": [
                            "shopMoney"
                        ],
                        "properties": {
                            "shopMoney": {
                                "type": "object",
                                "title": "Total Refunded.Shop Money",
                                "required": [
                                    "amount",
                                    "currencyCode"
                                ],
                                "properties": {
                                    "amount": {
                                        "type": "string",
                                        "title": "Total Refunded.Shop Money.Amount",
                                        "example": "25.0"
                                    },
                                    "currencyCode": {
                                        "type": "string",
                                        "title": "Total Refunded.Shop Money.Currency Code",
                                        "example": "USD"
                                    }
                                }
                            }
                        }
                    },
                    "return": {
                        "type": "object",
                        "title": "Return",
                        "required": [
                            "id",
                            "name"
                        ],
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Return.ID",
                                "example": "gid://shopify/Return/945684561"
                            },
                            "name": {
                                "type": "string",
                                "title": "Return.Name",
                                "example": "#1026-R1"
                            }
                        }
                    },
                    "refundLineItems": {
                        "type": "array",
                        "title": "Refund Line Items",
                        "items": {
                            "type": "object",
                            "required": [
                                "quantity",
                                "restockType",
                                "restocked",
                                "priceSet",
                                "subtotalSet",
                                "totalTaxSet",
                                "lineItem"
                            ],
                            "properties": {
                                "id": {
                                    "type": "string",
                                    "title": "ID",
                                    "example": "gid://shopify/RefundLineItem/1202700058705"
                                },
                                "quantity": {
                                    "type": "integer",
                                    "title": "Quantity",
                                    "example": 1
                                },
                                "restockType": {
                                    "type": "string",
                                    "title": "Restock Type",
                                    "example": "NO_RESTOCK"
                                },
                                "restocked": {
                                    "type": "boolean",
                                    "title": "Restocked",
                                    "example": false
                                },
                                "location": {
                                    "type": "object",
                                    "title": "Location",
                                    "required": [
                                        "id",
                                        "name"
                                    ],
                                    "properties": {
                                        "id": {
                                            "type": "string",
                                            "title": "Location.ID",
                                            "example": "gid://shopify/Location/124679880785"
                                        },
                                        "name": {
                                            "type": "string",
                                            "title": "Location.Name",
                                            "example": "Shop location"
                                        }
                                    }
                                },
                                "priceSet": {
                                    "type": "object",
                                    "title": "Price",
                                    "required": [
                                        "shopMoney"
                                    ],
                                    "properties": {
                                        "shopMoney": {
                                            "type": "object",
                                            "title": "Price.Shop Money",
                                            "required": [
                                                "amount",
                                                "currencyCode"
                                            ],
                                            "properties": {
                                                "amount": {
                                                    "type": "string",
                                                    "title": "Price.Shop Money.Amount",
                                                    "example": "885.95"
                                                },
                                                "currencyCode": {
                                                    "type": "string",
                                                    "title": "Price.Shop Money.Currency Code",
                                                    "example": "USD"
                                                }
                                            }
                                        }
                                    }
                                },
                                "subtotalSet": {
                                    "type": "object",
                                    "title": "Subtotal",
                                    "required": [
                                        "shopMoney"
                                    ],
                                    "properties": {
                                        "shopMoney": {
                                            "type": "object",
                                            "title": "Subtotal.Shop Money",
                                            "required": [
                                                "amount",
                                                "currencyCode"
                                            ],
                                            "properties": {
                                                "amount": {
                                                    "type": "string",
                                                    "title": "Subtotal.Shop Money.Amount",
                                                    "example": "881.08"
                                                },
                                                "currencyCode": {
                                                    "type": "string",
                                                    "title": "Subtotal.Shop Money.Currency Code",
                                                    "example": "USD"
                                                }
                                            }
                                        }
                                    }
                                },
                                "totalTaxSet": {
                                    "type": "object",
                                    "title": "Total Tax",
                                    "required": [
                                        "shopMoney"
                                    ],
                                    "properties": {
                                        "shopMoney": {
                                            "type": "object",
                                            "title": "Total Tax.Shop Money",
                                            "required": [
                                                "amount",
                                                "currencyCode"
                                            ],
                                            "properties": {
                                                "amount": {
                                                    "type": "string",
                                                    "title": "Total Tax.Shop Money.Amount",
                                                    "example": "0.0"
                                                },
                                                "currencyCode": {
                                                    "type": "string",
                                                    "title": "Total Tax.Shop Money.Currency Code",
                                                    "example": "USD"
                                                }
                                            }
                                        }
                                    }
                                },
                                "lineItem": {
                                    "type": "object",
                                    "title": "Line Item",
                                    "required": [
                                        "id",
                                        "name"
                                    ],
                                    "properties": {
                                        "id": {
                                            "type": "string",
                                            "title": "Line Item.ID",
                                            "example": "gid://shopify/LineItem/46373199282257"
                                        },
                                        "name": {
                                            "type": "string",
                                            "title": "Line Item.Name",
                                            "example": "The Minimal Snowboard"
                                        },
                                        "sku": {
                                            "type": "string",
                                            "title": "Line Item.SKU",
                                            "example": "SB-MIN"
                                        }
                                    }
                                }
                            }
                        },
                        "example": [
                            {
                                "id": "gid://shopify/RefundLineItem/1202700058705",
                                "quantity": 1,
                                "restockType": "NO_RESTOCK",
                                "restocked": false,
                                "location": null,
                                "priceSet": {
                                    "shopMoney": {
                                        "amount": "885.95",
                                        "currencyCode": "USD"
                                    }
                                },
                                "subtotalSet": {
                                    "shopMoney": {
                                        "amount": "881.08",
                                        "currencyCode": "USD"
                                    }
                                },
                                "totalTaxSet": {
                                    "shopMoney": {
                                        "amount": "0.0",
                                        "currencyCode": "USD"
                                    }
                                },
                                "lineItem": {
                                    "id": "gid://shopify/LineItem/46373199282257",
                                    "name": "The Minimal Snowboard",
                                    "sku": null
                                }
                            }
                        ]
                    },
                    "transactions": {
                        "type": "array",
                        "title": "Transactions",
                        "items": {
                            "type": "object",
                            "required": [
                                "id",
                                "kind",
                                "status",
                                "test",
                                "createdAt",
                                "amountSet"
                            ],
                            "properties": {
                                "id": {
                                    "type": "string",
                                    "title": "ID",
                                    "example": "gid://shopify/OrderTransaction/9876543210"
                                },
                                "kind": {
                                    "type": "string",
                                    "title": "Kind",
                                    "example": "SALE"
                                },
                                "status": {
                                    "type": "string",
                                    "title": "Status",
                                    "example": "SUCCESS"
                                },
                                "gateway": {
                                    "type": "string",
                                    "title": "Gateway",
                                    "example": "manual"
                                },
                                "test": {
                                    "type": "boolean",
                                    "title": "Test",
                                    "example": false
                                },
                                "createdAt": {
                                    "type": "string",
                                    "format": "date-time",
                                    "title": "Created At",
                                    "example": "2026-10-05T08:24:35Z"
                                },
                                "processedAt": {
                                    "type": "string",
                                    "format": "date-time",
                                    "title": "Processed At",
                                    "example": "2026-10-05T08:24:35Z"
                                },
                                "errorCode": {
                                    "type": "string",
                                    "title": "Error Code",
                                    "example": "CARD_DECLINED"
                                },
                                "paymentId": {
                                    "type": "string",
                                    "title": "Payment ID",
                                    "example": "c123.1"
                                },
                                "amountSet": {
                                    "type": "object",
                                    "title": "Amount",
                                    "required": [
                                        "shopMoney"
                                    ],
                                    "properties": {
                                        "shopMoney": {
                                            "type": "object",
                                            "title": "Amount.Shop Money",
                                            "required": [
                                                "amount",
                                                "currencyCode"
                                            ],
                                            "properties": {
                                                "amount": {
                                                    "type": "string",
                                                    "title": "Amount.Shop Money.Amount",
                                                    "example": "25.0"
                                                },
                                                "currencyCode": {
                                                    "type": "string",
                                                    "title": "Amount.Shop Money.Currency Code",
                                                    "example": "USD"
                                                }
                                            }
                                        }
                                    }
                                },
                                "parentTransaction": {
                                    "type": "object",
                                    "title": "Parent Transaction",
                                    "required": [
                                        "id"
                                    ],
                                    "properties": {
                                        "id": {
                                            "type": "string",
                                            "title": "Parent Transaction.ID",
                                            "example": "gid://shopify/OrderTransaction/9876543200"
                                        }
                                    }
                                }
                            }
                        },
                        "example": [
                            {
                                "id": "gid://shopify/OrderTransaction/9876543210",
                                "kind": "REFUND",
                                "status": "SUCCESS",
                                "gateway": "manual",
                                "test": false,
                                "createdAt": "2026-10-05T08:24:35Z",
                                "processedAt": "2026-10-05T08:24:35Z",
                                "errorCode": null,
                                "paymentId": "c123.1",
                                "amountSet": {
                                    "shopMoney": {
                                        "amount": "25.0",
                                        "currencyCode": "USD"
                                    }
                                },
                                "parentTransaction": null
                            }
                        ]
                    },
                    "orderAdjustments": {
                        "type": "array",
                        "title": "Order Adjustments",
                        "items": {
                            "type": "object",
                            "required": [
                                "id",
                                "amountSet",
                                "taxAmountSet"
                            ],
                            "properties": {
                                "id": {
                                    "type": "string",
                                    "title": "ID",
                                    "example": "gid://shopify/OrderAdjustment/671076450385"
                                },
                                "reason": {
                                    "type": "string",
                                    "title": "Reason",
                                    "example": "REFUND_DISCREPANCY"
                                },
                                "amountSet": {
                                    "type": "object",
                                    "title": "Amount",
                                    "required": [
                                        "shopMoney"
                                    ],
                                    "properties": {
                                        "shopMoney": {
                                            "type": "object",
                                            "title": "Amount.Shop Money",
                                            "required": [
                                                "amount",
                                                "currencyCode"
                                            ],
                                            "properties": {
                                                "amount": {
                                                    "type": "string",
                                                    "title": "Amount.Shop Money.Amount",
                                                    "example": "881.08"
                                                },
                                                "currencyCode": {
                                                    "type": "string",
                                                    "title": "Amount.Shop Money.Currency Code",
                                                    "example": "USD"
                                                }
                                            }
                                        }
                                    }
                                },
                                "taxAmountSet": {
                                    "type": "object",
                                    "title": "Tax Amount",
                                    "required": [
                                        "shopMoney"
                                    ],
                                    "properties": {
                                        "shopMoney": {
                                            "type": "object",
                                            "title": "Tax Amount.Shop Money",
                                            "required": [
                                                "amount",
                                                "currencyCode"
                                            ],
                                            "properties": {
                                                "amount": {
                                                    "type": "string",
                                                    "title": "Tax Amount.Shop Money.Amount",
                                                    "example": "0.0"
                                                },
                                                "currencyCode": {
                                                    "type": "string",
                                                    "title": "Tax Amount.Shop Money.Currency Code",
                                                    "example": "USD"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "example": [
                            {
                                "id": "gid://shopify/OrderAdjustment/671076450385",
                                "reason": "REFUND_DISCREPANCY",
                                "amountSet": {
                                    "shopMoney": {
                                        "amount": "881.08",
                                        "currencyCode": "USD"
                                    }
                                },
                                "taxAmountSet": {
                                    "shopMoney": {
                                        "amount": "0.0",
                                        "currencyCode": "USD"
                                    }
                                }
                            }
                        ]
                    },
                    "order": {
                        "type": "object",
                        "title": "Order",
                        "required": [
                            "id",
                            "legacyResourceId",
                            "name"
                        ],
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Order.ID",
                                "example": "gid://shopify/Order/17292422217809"
                            },
                            "legacyResourceId": {
                                "type": "string",
                                "title": "Order.Legacy Resource ID",
                                "example": "17292422217809"
                            },
                            "name": {
                                "type": "string",
                                "title": "Order.Name",
                                "example": "#1026"
                            }
                        }
                    },
                    "webhookTopic": {
                        "type": "string",
                        "title": "Webhook Topic",
                        "example": "refunds/create"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
