{
    "name": "appmixer.shopify.orders.UpdatedOrder",
    "author": "Jimoh Damilola <jimoh@client.io>",
    "description": "This trigger fires every time an order is updated on Shopify.",
    "icon": "data:image/svg+xml;base64,",
    "private": false,
    "webhook": true,
    "auth": {
        "service": "appmixer:shopify"
    },
    "outPorts": [
        {
            "name": "order",
            "options": [
                {
                    "label": "App ID",
                    "value": "app_id",
                    "schema": {
                        "type": "number",
                        "example": 580111
                    }
                },
                {
                    "label": "Billing Address",
                    "value": "billing_address",
                    "schema": {
                        "type": "object",
                        "example": {
                            "first_name": "John",
                            "last_name": "Doe",
                            "address1": "123 Main St",
                            "city": "New York",
                            "province": "NY",
                            "country": "US",
                            "zip": "10001"
                        }
                    }
                },
                {
                    "label": "Browser IP",
                    "value": "browser_ip",
                    "schema": {
                        "type": "string",
                        "example": "192.168.1.1"
                    }
                },
                {
                    "label": "Buyer Accepts Marketing",
                    "value": "buyer_accepts_marketing",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Cancel Reason",
                    "value": "cancel_reason",
                    "schema": {
                        "type": "string",
                        "example": "customer"
                    }
                },
                {
                    "label": "Date Cancelled",
                    "value": "cancelled_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-03-15T10:30:00-04:00"
                    }
                },
                {
                    "label": "Cart Token",
                    "value": "cart_token",
                    "schema": {
                        "type": "string",
                        "example": "abc123def456"
                    }
                },
                {
                    "label": "Client Details",
                    "value": "client_details",
                    "schema": {
                        "type": "object",
                        "example": {
                            "browser_ip": "192.168.1.1",
                            "user_agent": "Mozilla/5.0"
                        }
                    }
                },
                {
                    "label": "Date Closed",
                    "value": "closed_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-03-20T14:00:00-04:00"
                    }
                },
                {
                    "label": "Confirmed",
                    "value": "confirmed",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "Date Created",
                    "value": "created_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-03-10T09:00:00-04:00"
                    }
                },
                {
                    "label": "Currency",
                    "value": "currency",
                    "schema": {
                        "type": "string",
                        "example": "USD"
                    }
                },
                {
                    "label": "Customer",
                    "value": "customer",
                    "schema": {
                        "type": "object",
                        "example": {
                            "id": 207119551,
                            "email": "john@example.com",
                            "first_name": "John",
                            "last_name": "Doe"
                        }
                    }
                },
                {
                    "label": "Customer Locale",
                    "value": "customer_locale",
                    "schema": {
                        "type": "string",
                        "example": "en"
                    }
                },
                {
                    "label": "Discount Applications",
                    "value": "discount_applications",
                    "schema": {
                        "type": "array",
                        "example": [
                            {
                                "type": "discount_code",
                                "value": "10.0",
                                "value_type": "percentage"
                            }
                        ]
                    }
                },
                {
                    "label": "Discount Codes",
                    "value": "discount_codes",
                    "schema": {
                        "type": "array",
                        "example": [
                            {
                                "code": "SPRING10",
                                "amount": "10.00",
                                "type": "percentage"
                            }
                        ]
                    }
                },
                {
                    "label": "Email",
                    "value": "email",
                    "schema": {
                        "type": "string",
                        "example": "john.doe@example.com"
                    }
                },
                {
                    "label": "Financial Status",
                    "value": "financial_status",
                    "schema": {
                        "type": "string",
                        "example": "paid"
                    }
                },
                {
                    "label": "Order Fulfillments",
                    "value": "fulfillments",
                    "schema": {
                        "type": "array",
                        "example": [
                            {
                                "id": 255858046,
                                "status": "success",
                                "tracking_number": "1Z999AA10123456784"
                            }
                        ]
                    }
                },
                {
                    "label": "Fulfillment Status",
                    "value": "fulfillment_status",
                    "schema": {
                        "type": "string",
                        "example": "fulfilled"
                    }
                },
                {
                    "label": "Gateway",
                    "value": "gateway",
                    "schema": {
                        "type": "string",
                        "example": "shopify_payments"
                    }
                },
                {
                    "label": "ID",
                    "value": "id",
                    "schema": {
                        "type": "number",
                        "example": 450789469
                    }
                },
                {
                    "label": "Landing Site",
                    "value": "landing_site",
                    "schema": {
                        "type": "string",
                        "example": "/products/great-product"
                    }
                },
                {
                    "label": "Line Items",
                    "value": "line_items",
                    "schema": {
                        "type": "array",
                        "example": [
                            {
                                "id": 466157049,
                                "title": "IPod Nano - 8GB",
                                "quantity": 1,
                                "price": "199.00"
                            }
                        ]
                    }
                },
                {
                    "label": "Location ID",
                    "value": "location_id",
                    "schema": {
                        "type": "number",
                        "example": 487838322
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "#1001"
                    }
                },
                {
                    "label": "Note",
                    "value": "note",
                    "schema": {
                        "type": "string",
                        "example": "Please gift wrap this order"
                    }
                },
                {
                    "label": "Note Attributes",
                    "value": "note_attributes",
                    "schema": {
                        "type": "array",
                        "example": [
                            {
                                "name": "color",
                                "value": "red"
                            }
                        ]
                    }
                },
                {
                    "label": "Number",
                    "value": "number",
                    "schema": {
                        "type": "number",
                        "example": 1
                    }
                },
                {
                    "label": "Order Number",
                    "value": "order_number",
                    "schema": {
                        "type": "number",
                        "example": 1001
                    }
                },
                {
                    "label": "Order Status URL",
                    "value": "order_status_url",
                    "schema": {
                        "type": "string",
                        "example": "https://mystore.myshopify.com/orders/abc123/authenticate"
                    }
                },
                {
                    "label": "Payment Details",
                    "value": "payment_details",
                    "schema": {
                        "type": "object",
                        "example": {
                            "credit_card_company": "Visa",
                            "credit_card_number": "xxxx-xxxx-xxxx-4242"
                        }
                    }
                },
                {
                    "label": "Payment Gateway Names",
                    "value": "payment_gateway_names",
                    "schema": {
                        "type": "array",
                        "example": [
                            "shopify_payments"
                        ]
                    }
                },
                {
                    "label": "Phone",
                    "value": "phone",
                    "schema": {
                        "type": "string",
                        "example": "+15145556789"
                    }
                },
                {
                    "label": "Presentment Currency",
                    "value": "presentment_currency",
                    "schema": {
                        "type": "string",
                        "example": "USD"
                    }
                },
                {
                    "label": "Date Processed",
                    "value": "processed_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-03-10T09:05:00-04:00"
                    }
                },
                {
                    "label": "Processing Method",
                    "value": "processing_method",
                    "schema": {
                        "type": "string",
                        "example": "direct"
                    }
                },
                {
                    "label": "Referring Site",
                    "value": "referring_site",
                    "schema": {
                        "type": "string",
                        "example": "https://www.google.com"
                    }
                },
                {
                    "label": "Refunds",
                    "value": "refunds",
                    "schema": {
                        "type": "array",
                        "example": []
                    }
                },
                {
                    "label": "Shipping Address",
                    "value": "shipping_address",
                    "schema": {
                        "type": "object",
                        "example": {
                            "first_name": "John",
                            "last_name": "Doe",
                            "address1": "456 Oak Ave",
                            "city": "Los Angeles",
                            "province": "CA",
                            "country": "US",
                            "zip": "90001"
                        }
                    }
                },
                {
                    "label": "Shipping Lines",
                    "value": "shipping_lines",
                    "schema": {
                        "type": "array",
                        "example": [
                            {
                                "title": "Standard Shipping",
                                "price": "5.99",
                                "code": "standard"
                            }
                        ]
                    }
                },
                {
                    "label": "Source Identifier",
                    "value": "source_identifier",
                    "schema": {
                        "type": "string",
                        "example": "abc123"
                    }
                },
                {
                    "label": "Source Name",
                    "value": "source_name",
                    "schema": {
                        "type": "string",
                        "example": "web"
                    }
                },
                {
                    "label": "Subtotal Price",
                    "value": "subtotal_price",
                    "schema": {
                        "type": "string",
                        "example": "199.00"
                    }
                },
                {
                    "label": "Subtotal Price Set",
                    "value": "subtotal_price_set",
                    "schema": {
                        "type": "object",
                        "example": {
                            "shop_money": {
                                "amount": "199.00",
                                "currency_code": "USD"
                            }
                        }
                    }
                },
                {
                    "label": "Tags",
                    "value": "tags",
                    "schema": {
                        "type": "string",
                        "example": "vip, priority"
                    }
                },
                {
                    "label": "Tax Lines",
                    "value": "tax_lines",
                    "schema": {
                        "type": "array",
                        "example": [
                            {
                                "title": "State Tax",
                                "price": "11.94",
                                "rate": 0.06
                            }
                        ]
                    }
                },
                {
                    "label": "Taxes Included",
                    "value": "taxes_included",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Test",
                    "value": "test",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Token",
                    "value": "token",
                    "schema": {
                        "type": "string",
                        "example": "abc123def456ghi789"
                    }
                },
                {
                    "label": "Total Discounts",
                    "value": "total_discounts",
                    "schema": {
                        "type": "string",
                        "example": "10.00"
                    }
                },
                {
                    "label": "Total Discounts Set",
                    "value": "total_discounts_set",
                    "schema": {
                        "type": "object",
                        "example": {
                            "shop_money": {
                                "amount": "10.00",
                                "currency_code": "USD"
                            }
                        }
                    }
                },
                {
                    "label": "Total Line Items Price",
                    "value": "total_line_items_price",
                    "schema": {
                        "type": "string",
                        "example": "199.00"
                    }
                },
                {
                    "label": "Total Line Items Price Set",
                    "value": "total_line_items_price_set",
                    "schema": {
                        "type": "object",
                        "example": {
                            "shop_money": {
                                "amount": "199.00",
                                "currency_code": "USD"
                            }
                        }
                    }
                },
                {
                    "label": "Total Price",
                    "value": "total_price",
                    "schema": {
                        "type": "string",
                        "example": "204.99"
                    }
                },
                {
                    "label": "Total Price Set",
                    "value": "total_price_set",
                    "schema": {
                        "type": "object",
                        "example": {
                            "shop_money": {
                                "amount": "204.99",
                                "currency_code": "USD"
                            }
                        }
                    }
                },
                {
                    "label": "Total Shipping Price Set",
                    "value": "total_shipping_price_set",
                    "schema": {
                        "type": "object",
                        "example": {
                            "shop_money": {
                                "amount": "5.99",
                                "currency_code": "USD"
                            }
                        }
                    }
                },
                {
                    "label": "Total Tax",
                    "value": "total_tax",
                    "schema": {
                        "type": "string",
                        "example": "11.94"
                    }
                },
                {
                    "label": "Total Tax Set",
                    "value": "total_tax_set",
                    "schema": {
                        "type": "object",
                        "example": {
                            "shop_money": {
                                "amount": "11.94",
                                "currency_code": "USD"
                            }
                        }
                    }
                },
                {
                    "label": "Total Tip Received",
                    "value": "total_tip_received",
                    "schema": {
                        "type": "string",
                        "example": "0.00"
                    }
                },
                {
                    "label": "Total Weight",
                    "value": "total_weight",
                    "schema": {
                        "type": "number",
                        "example": 500
                    }
                },
                {
                    "label": "Date Updated",
                    "value": "updated_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-03-15T12:00:00-04:00"
                    }
                },
                {
                    "label": "User ID",
                    "value": "user_id",
                    "schema": {
                        "type": "number",
                        "example": 799407056
                    }
                },
                {
                    "label": "Webhook Topic",
                    "value": "webhookTopic",
                    "schema": {
                        "type": "string",
                        "example": "orders/create"
                    }
                }
            ]
        }
    ]
}
