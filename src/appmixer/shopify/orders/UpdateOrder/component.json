{
    "name": "appmixer.shopify.orders.UpdateOrder",
    "description": "Update an order's contact details, note, tags, PO number or shipping address. Fields left empty are not changed.",
    "author": "Jimoh Damilola <jimoh@client.io>",
    "private": false,
    "auth": {
        "service": "appmixer:shopify",
        "scope": [
            "write_orders"
        ]
    },
    "quota": {
        "manager": "appmixer:shopify",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "phone": {
                        "type": "string"
                    },
                    "note": {
                        "type": "string"
                    },
                    "tags": {
                        "type": "string"
                    },
                    "poNumber": {
                        "type": "string"
                    },
                    "shippingFirstName": {
                        "type": "string"
                    },
                    "shippingLastName": {
                        "type": "string"
                    },
                    "shippingCompany": {
                        "type": "string"
                    },
                    "shippingAddress1": {
                        "type": "string"
                    },
                    "shippingAddress2": {
                        "type": "string"
                    },
                    "shippingCity": {
                        "type": "string"
                    },
                    "shippingProvinceCode": {
                        "type": "string"
                    },
                    "shippingCountryCode": {
                        "type": "string"
                    },
                    "shippingZip": {
                        "type": "string"
                    },
                    "shippingPhone": {
                        "type": "string"
                    }
                },
                "required": [
                    "id"
                ]
            },
            "inspector": {
                "inputs": {
                    "id": {
                        "type": "text",
                        "label": "Order",
                        "index": 1,
                        "tooltip": "Pick an order, or enter its ID: the global ID (gid://shopify/Order/450789469) or the numeric ID from the order's admin URL.",
                        "source": {
                            "url": "/component/appmixer/shopify/orders/FindOrders?outPort=out",
                            "data": {
                                "messages": {
                                    "in/outputType": "array"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./FindOrders#ordersToSelectArray"
                            }
                        }
                    },
                    "email": {
                        "type": "text",
                        "label": "Email",
                        "index": 2,
                        "tooltip": "The customer's email address for this order."
                    },
                    "phone": {
                        "type": "text",
                        "label": "Phone",
                        "index": 3,
                        "tooltip": "The customer's phone number for this order, in E.164 format (for example +15145556789)."
                    },
                    "note": {
                        "type": "textarea",
                        "label": "Note",
                        "index": 4,
                        "tooltip": "Replaces the order note."
                    },
                    "tags": {
                        "type": "text",
                        "label": "Tags",
                        "index": 5,
                        "tooltip": "Comma-separated tags. Replaces all tags of the order."
                    },
                    "poNumber": {
                        "type": "text",
                        "label": "PO Number",
                        "index": 6,
                        "tooltip": "The purchase order number."
                    },
                    "shippingFirstName": {
                        "type": "text",
                        "label": "First Name",
                        "index": 20,
                        "group": "shippingAddress"
                    },
                    "shippingLastName": {
                        "type": "text",
                        "label": "Last Name",
                        "index": 21,
                        "group": "shippingAddress"
                    },
                    "shippingCompany": {
                        "type": "text",
                        "label": "Company",
                        "index": 22,
                        "group": "shippingAddress"
                    },
                    "shippingAddress1": {
                        "type": "text",
                        "label": "Address Line 1",
                        "index": 23,
                        "group": "shippingAddress"
                    },
                    "shippingAddress2": {
                        "type": "text",
                        "label": "Address Line 2",
                        "index": 24,
                        "group": "shippingAddress"
                    },
                    "shippingCity": {
                        "type": "text",
                        "label": "City",
                        "index": 25,
                        "group": "shippingAddress"
                    },
                    "shippingProvinceCode": {
                        "type": "text",
                        "label": "Province Code",
                        "index": 26,
                        "group": "shippingAddress",
                        "tooltip": "State or province code, for example <code>ON</code> or <code>CA</code>. Names are not accepted."
                    },
                    "shippingCountryCode": {
                        "type": "text",
                        "label": "Country Code",
                        "index": 27,
                        "group": "shippingAddress",
                        "tooltip": "Two-letter ISO country code, for example <code>CZ</code> or <code>US</code>. Names are not accepted."
                    },
                    "shippingZip": {
                        "type": "text",
                        "label": "Postal Code",
                        "index": 28,
                        "group": "shippingAddress"
                    },
                    "shippingPhone": {
                        "type": "text",
                        "label": "Phone",
                        "index": 29,
                        "group": "shippingAddress"
                    }
                },
                "groups": {
                    "shippingAddress": {
                        "label": "Shipping Address",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
