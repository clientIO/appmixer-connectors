{
    "name": "appmixer.shopify.orders.FindOrders",
    "description": "Find orders matching a Shopify search query and filters. Returns up to 250 orders.",
    "author": "Appmixer <info@appmixer.com>",
    "private": false,
    "auth": {
        "service": "appmixer:shopify",
        "scope": [
            "read_orders",
            "read_customers"
        ]
    },
    "quota": {
        "manager": "appmixer:shopify",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string",
                        "maxLength": 16384
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "any",
                            "open",
                            "closed",
                            "cancelled"
                        ]
                    },
                    "financialStatus": {
                        "type": "string",
                        "enum": [
                            "any",
                            "authorized",
                            "pending",
                            "paid",
                            "partially_paid",
                            "refunded",
                            "partially_refunded",
                            "voided",
                            "expired",
                            "unpaid"
                        ]
                    },
                    "fulfillmentStatus": {
                        "type": "string",
                        "enum": [
                            "any",
                            "shipped",
                            "partial",
                            "unshipped",
                            "unfulfilled",
                            "fulfilled",
                            "scheduled",
                            "on_hold",
                            "request_declined"
                        ]
                    },
                    "customerId": {
                        "type": "string"
                    },
                    "createdAtMin": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "createdAtMax": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updatedAtMin": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updatedAtMax": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "sortKey": {
                        "type": "string",
                        "enum": [
                            "CREATED_AT",
                            "UPDATED_AT",
                            "PROCESSED_AT",
                            "ORDER_NUMBER",
                            "TOTAL_PRICE",
                            "CUSTOMER_NAME",
                            "FINANCIAL_STATUS",
                            "FULFILLMENT_STATUS",
                            "ID"
                        ]
                    },
                    "reverse": {
                        "type": "boolean"
                    },
                    "outputType": {
                        "type": "string",
                        "enum": [
                            "first",
                            "array",
                            "object",
                            "file"
                        ]
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "query": {
                        "type": "text",
                        "label": "Search Query",
                        "index": 1,
                        "tooltip": "Optional Shopify order search query, for example <code>email:jane@example.com</code>, <code>tag:wholesale</code> or <code>name:#1001</code>. See the <a href=\"https://shopify.dev/docs/api/admin-graphql/latest/queries/orders#argument-query\" target=\"_blank\">order search syntax</a>. Combined with the filters below; leave everything empty for all orders."
                    },
                    "status": {
                        "type": "select",
                        "label": "Status",
                        "index": 2,
                        "defaultValue": "any",
                        "tooltip": "Only orders with this status.",
                        "options": [
                            {
                                "value": "any",
                                "label": "Any"
                            },
                            {
                                "value": "open",
                                "label": "Open"
                            },
                            {
                                "value": "closed",
                                "label": "Closed (archived)"
                            },
                            {
                                "value": "cancelled",
                                "label": "Cancelled"
                            }
                        ]
                    },
                    "financialStatus": {
                        "type": "select",
                        "label": "Financial Status",
                        "index": 3,
                        "defaultValue": "any",
                        "tooltip": "Only orders with this payment status. Unpaid = authorized, pending or partially paid.",
                        "options": [
                            {
                                "value": "any",
                                "label": "Any"
                            },
                            {
                                "value": "authorized",
                                "label": "Authorized"
                            },
                            {
                                "value": "pending",
                                "label": "Pending"
                            },
                            {
                                "value": "paid",
                                "label": "Paid"
                            },
                            {
                                "value": "partially_paid",
                                "label": "Partially paid"
                            },
                            {
                                "value": "refunded",
                                "label": "Refunded"
                            },
                            {
                                "value": "partially_refunded",
                                "label": "Partially refunded"
                            },
                            {
                                "value": "voided",
                                "label": "Voided"
                            },
                            {
                                "value": "expired",
                                "label": "Expired"
                            },
                            {
                                "value": "unpaid",
                                "label": "Unpaid"
                            }
                        ]
                    },
                    "fulfillmentStatus": {
                        "type": "select",
                        "label": "Fulfillment Status",
                        "index": 4,
                        "defaultValue": "any",
                        "tooltip": "Only orders with this fulfillment status.",
                        "options": [
                            {
                                "value": "any",
                                "label": "Any"
                            },
                            {
                                "value": "shipped",
                                "label": "Shipped (fulfilled)"
                            },
                            {
                                "value": "partial",
                                "label": "Partially fulfilled"
                            },
                            {
                                "value": "unshipped",
                                "label": "Unshipped"
                            },
                            {
                                "value": "unfulfilled",
                                "label": "Unfulfilled or partially fulfilled"
                            },
                            {
                                "value": "scheduled",
                                "label": "Scheduled"
                            },
                            {
                                "value": "on_hold",
                                "label": "On hold"
                            },
                            {
                                "value": "request_declined",
                                "label": "Request declined"
                            }
                        ]
                    },
                    "customerId": {
                        "type": "text",
                        "label": "Customer",
                        "index": 5,
                        "tooltip": "Only orders of this customer. Pick a customer, or enter the customer ID (global or numeric).",
                        "source": {
                            "url": "/component/appmixer/shopify/customers/FindCustomers?outPort=out",
                            "data": {
                                "messages": {
                                    "in/outputType": "array"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./FindCustomers#customersToSelectArray"
                            }
                        }
                    },
                    "createdAtMin": {
                        "type": "date-time",
                        "label": "Created After",
                        "index": 6,
                        "tooltip": "Only orders created at or after this time."
                    },
                    "createdAtMax": {
                        "type": "date-time",
                        "label": "Created Before",
                        "index": 7,
                        "tooltip": "Only orders created at or before this time."
                    },
                    "updatedAtMin": {
                        "type": "date-time",
                        "label": "Updated After",
                        "index": 8,
                        "tooltip": "Only orders last updated at or after this time."
                    },
                    "updatedAtMax": {
                        "type": "date-time",
                        "label": "Updated Before",
                        "index": 9,
                        "tooltip": "Only orders last updated at or before this time."
                    },
                    "sortKey": {
                        "type": "select",
                        "label": "Sort By",
                        "index": 10,
                        "defaultValue": "CREATED_AT",
                        "tooltip": "The field to sort the orders by.",
                        "options": [
                            {
                                "value": "CREATED_AT",
                                "label": "Date created"
                            },
                            {
                                "value": "UPDATED_AT",
                                "label": "Date updated"
                            },
                            {
                                "value": "PROCESSED_AT",
                                "label": "Date processed"
                            },
                            {
                                "value": "ORDER_NUMBER",
                                "label": "Order number"
                            },
                            {
                                "value": "TOTAL_PRICE",
                                "label": "Total price"
                            },
                            {
                                "value": "CUSTOMER_NAME",
                                "label": "Customer name"
                            },
                            {
                                "value": "FINANCIAL_STATUS",
                                "label": "Financial status"
                            },
                            {
                                "value": "FULFILLMENT_STATUS",
                                "label": "Fulfillment status"
                            },
                            {
                                "value": "ID",
                                "label": "ID"
                            }
                        ]
                    },
                    "reverse": {
                        "type": "toggle",
                        "label": "Descending",
                        "index": 11,
                        "defaultValue": true,
                        "tooltip": "Sort in descending order (newest, highest or Z first)."
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "index": 12,
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "options": [
                            {
                                "value": "first",
                                "label": "First Item Only"
                            },
                            {
                                "value": "array",
                                "label": "All items at once"
                            },
                            {
                                "value": "object",
                                "label": "One item at a time"
                            },
                            {
                                "value": "file",
                                "label": "Store to CSV file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/shopify/orders/FindOrders?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        },
        {
            "name": "notFound"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
