{
    "name": "appmixer.shopify.products.UpdateProduct",
    "author": "Jimoh Damilola <jimoh@client.io>",
    "description": "When triggered, updates a specific product.",
    "icon": "data:image/svg+xml;base64,",
    "private": false,
    "auth": {
        "service": "appmixer:shopify"
    },
    "quota": {
        "manager": "appmixer:shopify",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "body_html": {
                        "type": "string"
                    },
                    "vendor": {
                        "type": "string"
                    },
                    "product_type": {
                        "type": "string"
                    },
                    "attachment": {
                        "type": "string"
                    },
                    "tags": {
                        "type": "string"
                    },
                    "published": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "id"
                ]
            },
            "inspector": {
                "inputs": {
                    "id": {
                        "type": "text",
                        "label": "Product ID",
                        "source": {
                            "url": "/component/appmixer/shopify/products/ListProducts?outPort=products",
                            "data": {
                                "properties": {
                                    "sendWholeArray": true
                                },
                                "transform": "./ListProducts#productsToSelectArray"
                            }
                        },
                        "index": 1
                    },
                    "title": {
                        "type": "text",
                        "label": "Product Title",
                        "index": 2,
                        "tooltip": "The name of the product."
                    },
                    "body_html": {
                        "type": "textarea",
                        "label": "Product Description",
                        "index": 3,
                        "tooltip": "A description of the product. Supports HTML formatting."
                    },
                    "vendor": {
                        "type": "text",
                        "label": "Product Vendor",
                        "index": 4,
                        "tooltip": "The name of the product's vendor."
                    },
                    "product_type": {
                        "type": "text",
                        "label": "Product Type",
                        "index": 5,
                        "tooltip": "Categorization for the product used for filtering and searching."
                    },
                    "attachment": {
                        "type": "text",
                        "label": "Product Image",
                        "index": 6,
                        "tooltip": "A base64 encoded string of the product image."
                    },
                    "tags": {
                        "type": "text",
                        "label": "Product Tags",
                        "index": 7,
                        "tooltip": "A string of comma-separated tags that are used for filtering and search."
                    },
                    "published": {
                        "type": "toggle",
                        "label": "Publish Product",
                        "index": 8,
                        "tooltip": "Turn it on to publish the product on the Online Store channel"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "product",
            "options": [
                {
                    "label": "Product Description",
                    "value": "body_html",
                    "schema": {
                        "type": "string",
                        "example": "<p>The best product ever made.</p>"
                    }
                },
                {
                    "label": "Date Created",
                    "value": "created_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-03-10T09:00:00-04:00"
                    }
                },
                {
                    "label": "Handle",
                    "value": "handle",
                    "schema": {
                        "type": "string",
                        "example": "great-product"
                    }
                },
                {
                    "label": "ID",
                    "value": "id",
                    "schema": {
                        "type": "number",
                        "example": 450789469
                    }
                },
                {
                    "label": "Image",
                    "value": "image",
                    "schema": {
                        "type": "object",
                        "example": {
                            "src": "https://cdn.shopify.com/s/files/1/0001/0001/products/image.jpg",
                            "alt": "Product image"
                        }
                    }
                },
                {
                    "label": "Images",
                    "value": "images",
                    "schema": {
                        "type": "array",
                        "example": [
                            {
                                "id": 850703190,
                                "src": "https://cdn.shopify.com/s/files/1/0001/0001/products/image.jpg"
                            }
                        ]
                    }
                },
                {
                    "label": "Custom Property Names",
                    "value": "options",
                    "schema": {
                        "type": "array",
                        "example": [
                            {
                                "id": 594680422,
                                "name": "Color",
                                "values": [
                                    "Blue",
                                    "Red"
                                ]
                            }
                        ]
                    }
                },
                {
                    "label": "Product Type",
                    "value": "product_type",
                    "schema": {
                        "type": "string",
                        "example": "Accessories"
                    }
                },
                {
                    "label": "Date Published",
                    "value": "published_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-03-01T09:00:00-04:00"
                    }
                },
                {
                    "label": "Published Scope",
                    "value": "published_scope",
                    "schema": {
                        "type": "string",
                        "example": "global"
                    }
                },
                {
                    "label": "Tags",
                    "value": "tags",
                    "schema": {
                        "type": "string",
                        "example": "vip, priority"
                    }
                },
                {
                    "label": "Template Suffix",
                    "value": "template_suffix",
                    "schema": {
                        "type": "string",
                        "example": null
                    }
                },
                {
                    "label": "Title",
                    "value": "title",
                    "schema": {
                        "type": "string",
                        "example": "IPod Nano - 8GB"
                    }
                },
                {
                    "label": "Metafields Title",
                    "value": "metafields_global_title_tag",
                    "schema": {
                        "type": "string",
                        "example": "IPod Nano - 8GB | My Store"
                    }
                },
                {
                    "label": "Metafields Description",
                    "value": "metafields_global_description_tag",
                    "schema": {
                        "type": "string",
                        "example": "The best iPod Nano with 8GB storage."
                    }
                },
                {
                    "label": "Date Updated",
                    "value": "updated_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-03-15T12:00:00-04:00"
                    }
                },
                {
                    "label": "Variants",
                    "value": "variants",
                    "schema": {
                        "type": "array",
                        "example": [
                            {
                                "id": 808950810,
                                "title": "Default Title",
                                "price": "199.00",
                                "sku": "IPOD2008PINK"
                            }
                        ]
                    }
                },
                {
                    "label": "Vendor",
                    "value": "vendor",
                    "schema": {
                        "type": "string",
                        "example": "Apple"
                    }
                }
            ]
        }
    ]
}
