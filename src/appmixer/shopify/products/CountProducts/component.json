{
    "name": "appmixer.shopify.products.CountProducts",
    "description": "Count the products that match a search query and filters.",
    "author": "Jimoh Damilola <jimoh@client.io>",
    "private": false,
    "auth": {
        "service": "appmixer:shopify",
        "scope": [
            "read_products"
        ]
    },
    "quota": {
        "manager": "appmixer:shopify",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string",
                        "maxLength": 16384
                    },
                    "vendor": {
                        "type": "string"
                    },
                    "productType": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "collectionId": {
                        "type": "string"
                    },
                    "tag": {
                        "type": "string"
                    },
                    "createdAtMin": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "createdAtMax": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updatedAtMin": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updatedAtMax": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "query": {
                        "type": "text",
                        "label": "Search Query",
                        "index": 0,
                        "tooltip": "Shopify product search syntax, for example <code>title:shirt*</code> or <code>sku:TS-ORG-M</code>. Combined with the filters below. Leave empty to match all products."
                    },
                    "vendor": {
                        "type": "text",
                        "label": "Vendor",
                        "index": 1,
                        "tooltip": "Only products from this vendor."
                    },
                    "productType": {
                        "type": "text",
                        "label": "Product Type",
                        "index": 2,
                        "tooltip": "Only products of this product type."
                    },
                    "status": {
                        "type": "select",
                        "label": "Status",
                        "index": 3,
                        "tooltip": "Only products with this status. Leave empty for any status.",
                        "options": [
                            {
                                "label": "Any",
                                "value": ""
                            },
                            {
                                "label": "Active",
                                "value": "ACTIVE"
                            },
                            {
                                "label": "Draft",
                                "value": "DRAFT"
                            },
                            {
                                "label": "Archived",
                                "value": "ARCHIVED"
                            },
                            {
                                "label": "Unlisted",
                                "value": "UNLISTED"
                            }
                        ]
                    },
                    "collectionId": {
                        "type": "text",
                        "label": "Collection ID",
                        "index": 4,
                        "tooltip": "Only products in this collection (gid://shopify/Collection/123 or the numeric ID 123)."
                    },
                    "tag": {
                        "type": "text",
                        "label": "Tag",
                        "index": 5,
                        "tooltip": "Only products with this tag."
                    },
                    "createdAtMin": {
                        "type": "date-time",
                        "label": "Created After",
                        "index": 6,
                        "tooltip": "Only products created at or after this date."
                    },
                    "createdAtMax": {
                        "type": "date-time",
                        "label": "Created Before",
                        "index": 7,
                        "tooltip": "Only products created at or before this date."
                    },
                    "updatedAtMin": {
                        "type": "date-time",
                        "label": "Updated After",
                        "index": 8,
                        "tooltip": "Only products last updated at or after this date."
                    },
                    "updatedAtMax": {
                        "type": "date-time",
                        "label": "Updated Before",
                        "index": 9,
                        "tooltip": "Only products last updated at or before this date."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "count"
                ],
                "properties": {
                    "count": {
                        "type": "integer",
                        "title": "Count",
                        "example": 24
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
