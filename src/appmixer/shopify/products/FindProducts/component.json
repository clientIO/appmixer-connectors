{
    "name": "appmixer.shopify.products.FindProducts",
    "description": "Find products by a search query and filters. Returns at most 250 products. Each product carries up to 100 variants and 50 media.",
    "author": "Jimoh Damilola <jimoh@client.io>",
    "private": false,
    "auth": {
        "service": "appmixer:shopify",
        "scope": [
            "read_products"
        ]
    },
    "quota": {
        "manager": "appmixer:shopify",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string",
                        "maxLength": 16384
                    },
                    "vendor": {
                        "type": "string"
                    },
                    "productType": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "collectionId": {
                        "type": "string"
                    },
                    "tag": {
                        "type": "string"
                    },
                    "createdAtMin": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "createdAtMax": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updatedAtMin": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updatedAtMax": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "sortKey": {
                        "type": "string"
                    },
                    "reverse": {
                        "type": "boolean"
                    },
                    "outputType": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "query": {
                        "type": "text",
                        "label": "Search Query",
                        "index": 0,
                        "tooltip": "Shopify product search syntax, for example <code>title:shirt*</code> or <code>sku:TS-ORG-M</code>. Combined with the filters below. Leave empty to match all products."
                    },
                    "vendor": {
                        "type": "text",
                        "label": "Vendor",
                        "index": 1,
                        "tooltip": "Only products from this vendor."
                    },
                    "productType": {
                        "type": "text",
                        "label": "Product Type",
                        "index": 2,
                        "tooltip": "Only products of this product type."
                    },
                    "status": {
                        "type": "select",
                        "label": "Status",
                        "index": 3,
                        "tooltip": "Only products with this status. Leave empty for any status.",
                        "options": [
                            {
                                "label": "Any",
                                "value": ""
                            },
                            {
                                "label": "Active",
                                "value": "ACTIVE"
                            },
                            {
                                "label": "Draft",
                                "value": "DRAFT"
                            },
                            {
                                "label": "Archived",
                                "value": "ARCHIVED"
                            },
                            {
                                "label": "Unlisted",
                                "value": "UNLISTED"
                            }
                        ]
                    },
                    "collectionId": {
                        "type": "text",
                        "label": "Collection ID",
                        "index": 4,
                        "tooltip": "Only products in this collection (gid://shopify/Collection/123 or the numeric ID 123)."
                    },
                    "tag": {
                        "type": "text",
                        "label": "Tag",
                        "index": 5,
                        "tooltip": "Only products with this tag."
                    },
                    "createdAtMin": {
                        "type": "date-time",
                        "label": "Created After",
                        "index": 6,
                        "tooltip": "Only products created at or after this date."
                    },
                    "createdAtMax": {
                        "type": "date-time",
                        "label": "Created Before",
                        "index": 7,
                        "tooltip": "Only products created at or before this date."
                    },
                    "updatedAtMin": {
                        "type": "date-time",
                        "label": "Updated After",
                        "index": 8,
                        "tooltip": "Only products last updated at or after this date."
                    },
                    "updatedAtMax": {
                        "type": "date-time",
                        "label": "Updated Before",
                        "index": 9,
                        "tooltip": "Only products last updated at or before this date."
                    },
                    "sortKey": {
                        "type": "select",
                        "label": "Sort By",
                        "index": 10,
                        "tooltip": "The field to sort the products by. Relevance needs a search query.",
                        "options": [
                            {
                                "label": "Default (ID)",
                                "value": ""
                            },
                            {
                                "label": "Created At",
                                "value": "CREATED_AT"
                            },
                            {
                                "label": "Updated At",
                                "value": "UPDATED_AT"
                            },
                            {
                                "label": "Published At",
                                "value": "PUBLISHED_AT"
                            },
                            {
                                "label": "Title",
                                "value": "TITLE"
                            },
                            {
                                "label": "Vendor",
                                "value": "VENDOR"
                            },
                            {
                                "label": "Product Type",
                                "value": "PRODUCT_TYPE"
                            },
                            {
                                "label": "Total Inventory",
                                "value": "INVENTORY_TOTAL"
                            },
                            {
                                "label": "Relevance",
                                "value": "RELEVANCE"
                            }
                        ]
                    },
                    "reverse": {
                        "type": "toggle",
                        "label": "Descending",
                        "index": 11,
                        "tooltip": "Sort in descending order (newest, Z to A, highest first)."
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ],
                        "index": 12
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/shopify/products/FindProducts?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        },
        {
            "name": "notFound"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
