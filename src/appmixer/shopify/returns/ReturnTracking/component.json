{
    "name": "appmixer.shopify.returns.ReturnTracking",
    "description": "Triggers on the selected return events: a return is requested, approved, declined, cancelled, closed, reopened or updated.",
    "author": "Appmixer <info@appmixer.com>",
    "private": false,
    "webhook": true,
    "auth": {
        "service": "appmixer:shopify",
        "scope": [
            "read_returns",
            "read_orders"
        ]
    },
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "topics": {
                    "type": [
                        "array",
                        "string"
                    ]
                }
            }
        },
        "inspector": {
            "inputs": {
                "topics": {
                    "type": "multiselect",
                    "label": "Return Events",
                    "index": 1,
                    "defaultValue": [
                        "returns/request",
                        "returns/approve",
                        "returns/decline",
                        "returns/cancel",
                        "returns/close",
                        "returns/reopen",
                        "returns/update"
                    ],
                    "tooltip": "Select which return events fire this trigger. All events are tracked by default.",
                    "options": [
                        {
                            "content": "Return requested",
                            "value": "returns/request"
                        },
                        {
                            "content": "Return approved",
                            "value": "returns/approve"
                        },
                        {
                            "content": "Return declined",
                            "value": "returns/decline"
                        },
                        {
                            "content": "Return cancelled",
                            "value": "returns/cancel"
                        },
                        {
                            "content": "Return closed",
                            "value": "returns/close"
                        },
                        {
                            "content": "Return reopened",
                            "value": "returns/reopen"
                        },
                        {
                            "content": "Return updated",
                            "value": "returns/update"
                        }
                    ]
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "name",
                    "status",
                    "totalQuantity",
                    "createdAt",
                    "order",
                    "returnLineItems",
                    "reverseFulfillmentOrders",
                    "webhookTopic"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Return ID",
                        "example": "gid://shopify/Return/14381973585"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "#1018-R1"
                    },
                    "status": {
                        "type": "string",
                        "title": "Status",
                        "example": "OPEN"
                    },
                    "totalQuantity": {
                        "type": "integer",
                        "title": "Total Quantity",
                        "example": 1
                    },
                    "createdAt": {
                        "type": "string",
                        "title": "Created At",
                        "example": "2026-10-03T09:00:00Z",
                        "format": "date-time"
                    },
                    "requestApprovedAt": {
                        "type": "string",
                        "title": "Request Approved At",
                        "example": "2026-10-03T10:00:00Z",
                        "format": "date-time"
                    },
                    "closedAt": {
                        "type": "string",
                        "title": "Closed At",
                        "example": "2026-10-06T12:00:00Z",
                        "format": "date-time"
                    },
                    "order": {
                        "type": "object",
                        "title": "Order",
                        "required": [
                            "id",
                            "legacyResourceId",
                            "name"
                        ],
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Order.ID",
                                "example": "gid://shopify/Order/7801814876320"
                            },
                            "legacyResourceId": {
                                "type": "string",
                                "title": "Order.Legacy Resource ID",
                                "example": "7801814876320"
                            },
                            "name": {
                                "type": "string",
                                "title": "Order.Name",
                                "example": "#1018"
                            }
                        }
                    },
                    "decline": {
                        "type": "object",
                        "title": "Decline",
                        "required": [
                            "reason"
                        ],
                        "properties": {
                            "reason": {
                                "type": "string",
                                "title": "Decline.Reason",
                                "example": "RETURN_PERIOD_ENDED"
                            },
                            "note": {
                                "type": "string",
                                "title": "Decline.Note",
                                "example": "The 30-day return window has passed."
                            }
                        }
                    },
                    "returnLineItems": {
                        "type": "array",
                        "title": "Return Line Items",
                        "items": {
                            "type": "object",
                            "required": [
                                "id",
                                "quantity",
                                "returnReasonNote"
                            ],
                            "properties": {
                                "id": {
                                    "type": "string",
                                    "title": "ID",
                                    "example": "gid://shopify/ReturnLineItem/22573695185"
                                },
                                "quantity": {
                                    "type": "integer",
                                    "title": "Quantity",
                                    "example": 1
                                },
                                "customerNote": {
                                    "type": "string",
                                    "title": "Customer Note",
                                    "example": "Too small"
                                },
                                "returnReasonNote": {
                                    "type": "string",
                                    "title": "Return Reason Note",
                                    "example": ""
                                },
                                "returnReasonDefinition": {
                                    "type": "object",
                                    "title": "Return Reason",
                                    "required": [
                                        "handle",
                                        "name"
                                    ],
                                    "properties": {
                                        "handle": {
                                            "type": "string",
                                            "title": "Return Reason.Handle",
                                            "example": "size-too-small"
                                        },
                                        "name": {
                                            "type": "string",
                                            "title": "Return Reason.Name",
                                            "example": "Size too small"
                                        }
                                    }
                                },
                                "fulfillmentLineItem": {
                                    "type": "object",
                                    "title": "Fulfillment Line Item",
                                    "required": [
                                        "id",
                                        "lineItem"
                                    ],
                                    "properties": {
                                        "id": {
                                            "type": "string",
                                            "title": "Fulfillment Line Item.ID",
                                            "example": "gid://shopify/FulfillmentLineItem/16893829329105"
                                        },
                                        "lineItem": {
                                            "type": "object",
                                            "title": "Fulfillment Line Item.Line Item",
                                            "required": [
                                                "id",
                                                "name"
                                            ],
                                            "properties": {
                                                "id": {
                                                    "type": "string",
                                                    "title": "Fulfillment Line Item.Line Item.ID",
                                                    "example": "gid://shopify/LineItem/17193826779345"
                                                },
                                                "name": {
                                                    "type": "string",
                                                    "title": "Fulfillment Line Item.Line Item.Name",
                                                    "example": "The Multi-location Snowboard"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "example": [
                            {
                                "id": "gid://shopify/ReturnLineItem/22573695185",
                                "quantity": 1,
                                "customerNote": "Too small",
                                "returnReasonNote": "",
                                "returnReasonDefinition": {
                                    "handle": "size-too-small",
                                    "name": "Size too small"
                                },
                                "fulfillmentLineItem": {
                                    "id": "gid://shopify/FulfillmentLineItem/16893829329105",
                                    "lineItem": {
                                        "id": "gid://shopify/LineItem/17193826779345",
                                        "name": "The Multi-location Snowboard"
                                    }
                                }
                            }
                        ]
                    },
                    "reverseFulfillmentOrders": {
                        "type": "array",
                        "title": "Reverse Fulfillment Orders",
                        "items": {
                            "type": "object",
                            "required": [
                                "id",
                                "status"
                            ],
                            "properties": {
                                "id": {
                                    "type": "string",
                                    "title": "ID",
                                    "example": "gid://shopify/ReverseFulfillmentOrder/12960858257"
                                },
                                "status": {
                                    "type": "string",
                                    "title": "Status",
                                    "example": "OPEN"
                                }
                            }
                        },
                        "example": [
                            {
                                "id": "gid://shopify/ReverseFulfillmentOrder/12960858257",
                                "status": "OPEN"
                            }
                        ]
                    },
                    "webhookTopic": {
                        "type": "string",
                        "title": "Webhook Topic",
                        "example": "returns/request"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
