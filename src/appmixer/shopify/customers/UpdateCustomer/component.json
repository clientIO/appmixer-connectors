{
    "name": "appmixer.shopify.customers.UpdateCustomer",
    "description": "Update a customer. Only the fields you fill in are changed.",
    "author": "Jimoh Damilola <jimoh@client.io>",
    "private": false,
    "auth": {
        "service": "appmixer:shopify",
        "scope": [
            "write_customers"
        ]
    },
    "quota": {
        "manager": "appmixer:shopify",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "firstName": {
                        "type": "string"
                    },
                    "lastName": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "phone": {
                        "type": "string"
                    },
                    "note": {
                        "type": "string"
                    },
                    "tags": {
                        "type": "string"
                    },
                    "emailMarketingState": {
                        "type": "string"
                    },
                    "taxExempt": {
                        "type": "boolean"
                    },
                    "taxExemptions": {
                        "type": [
                            "array",
                            "string"
                        ]
                    },
                    "metafields": {
                        "type": "object"
                    }
                },
                "required": [
                    "id"
                ]
            },
            "inspector": {
                "inputs": {
                    "id": {
                        "type": "text",
                        "label": "Customer",
                        "index": 0,
                        "tooltip": "Pick a customer, or enter its ID — the global ID (gid://shopify/Customer/…) or the numeric ID.",
                        "source": {
                            "url": "/component/appmixer/shopify/customers/FindCustomers?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "messages": {
                                    "in/outputType": "array"
                                },
                                "transform": "./FindCustomers#customersToSelectArray"
                            }
                        }
                    },
                    "firstName": {
                        "type": "text",
                        "label": "First Name",
                        "index": 1,
                        "group": "overview",
                        "tooltip": "New first name."
                    },
                    "lastName": {
                        "type": "text",
                        "label": "Last Name",
                        "index": 2,
                        "group": "overview",
                        "tooltip": "New last name."
                    },
                    "email": {
                        "type": "text",
                        "label": "Email",
                        "index": 3,
                        "group": "overview",
                        "tooltip": "New email address. Must be unique in the store."
                    },
                    "phone": {
                        "type": "text",
                        "label": "Phone",
                        "index": 4,
                        "group": "overview",
                        "tooltip": "New phone number in E.164 format, for example +16135551111. Must be unique in the store."
                    },
                    "note": {
                        "type": "textarea",
                        "label": "Note",
                        "index": 5,
                        "group": "overview",
                        "tooltip": "New note about the customer. Replaces the current note."
                    },
                    "tags": {
                        "type": "text",
                        "label": "Tags",
                        "index": 6,
                        "group": "overview",
                        "tooltip": "Comma-separated tags, for example \"VIP, wholesale\". Replaces all current tags."
                    },
                    "emailMarketingState": {
                        "type": "select",
                        "label": "Email Marketing",
                        "index": 7,
                        "group": "overview",
                        "tooltip": "Change whether the customer receives marketing emails. Leave empty to keep the current consent.",
                        "options": [
                            {
                                "label": "Subscribed",
                                "value": "SUBSCRIBED"
                            },
                            {
                                "label": "Unsubscribed",
                                "value": "UNSUBSCRIBED"
                            }
                        ]
                    },
                    "taxExempt": {
                        "type": "toggle",
                        "label": "Tax Exempt",
                        "index": 8,
                        "group": "tax",
                        "tooltip": "Whether the customer is exempt from paying taxes on their orders. Leave untouched to keep the current setting."
                    },
                    "taxExemptions": {
                        "type": "multiselect",
                        "label": "Tax Exemptions",
                        "index": 9,
                        "group": "tax",
