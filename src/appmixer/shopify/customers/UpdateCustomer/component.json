                    "metafields": {
                        "type": "expression",
                        "label": "Metafields",
                        "index": 10,
                        "group": "metafields",
                        "levels": [
                            "ADD"
                        ],
                        "tooltip": "Custom data stored on the customer. A metafield with the same namespace and key is overwritten.",
                        "fields": {
                            "namespace": {
                                "type": "text",
                                "label": "Namespace",
                                "index": 1,
                                "tooltip": "Groups metafields, for example \"custom\". Defaults to the app's namespace when empty."
                            },
                            "key": {
                                "type": "text",
                                "label": "Key",
                                "index": 2,
                                "tooltip": "Name of the metafield within the namespace, for example \"loyalty_level\"."
                            },
                            "type": {
                                "type": "select",
                                "label": "Type",
                                "index": 3,
                                "defaultValue": "single_line_text_field",
                                "tooltip": "Type of the value. Must match the metafield definition, if the store has one for this namespace and key.",
