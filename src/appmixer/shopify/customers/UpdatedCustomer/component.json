{
    "name": "appmixer.shopify.customers.UpdatedCustomer",
    "description": "Triggers when a customer is updated. Changes made within 2 seconds of creating the customer are skipped.",
    "author": "Jimoh Damilola <jimoh@client.io>",
    "private": false,
    "webhook": true,
    "auth": {
        "service": "appmixer:shopify",
        "scope": [
            "read_customers",
            "read_orders"
        ]
    },
    "quota": {
        "manager": "appmixer:shopify",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "legacyResourceId",
                    "displayName",
                    "tags",
                    "state",
                    "locale",
                    "verifiedEmail",
                    "taxExempt",
                    "taxExemptions",
                    "numberOfOrders",
                    "createdAt",
                    "updatedAt",
                    "amountSpent",
                    "addresses",
                    "metafields",
                    "webhookTopic"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Customer ID",
                        "example": "gid://shopify/Customer/27606879338577"
                    },
                    "legacyResourceId": {
                        "type": "string",
                        "title": "Legacy Resource ID",
                        "example": "27606879338577"
                    },
                    "displayName": {
                        "type": "string",
                        "title": "Display Name",
                        "example": "Jane Doe"
                    },
                    "firstName": {
                        "type": "string",
                        "title": "First Name",
                        "example": "Jane"
                    },
                    "lastName": {
                        "type": "string",
                        "title": "Last Name",
                        "example": "Doe"
                    },
                    "note": {
                        "type": "string",
                        "title": "Note",
                        "example": "Prefers delivery after 5 pm"
                    },
                    "tags": {
                        "type": "array",
                        "title": "Tags",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "VIP",
                            "wholesale"
                        ]
                    },
                    "state": {
                        "type": "string",
                        "title": "State",
                        "example": "DISABLED"
                    },
                    "locale": {
                        "type": "string",
                        "title": "Locale",
                        "example": "en"
                    },
                    "verifiedEmail": {
                        "type": "boolean",
                        "title": "Verified Email",
                        "example": true
                    },
                    "taxExempt": {
                        "type": "boolean",
                        "title": "Tax Exempt",
                        "example": false
                    },
                    "taxExemptions": {
                        "type": "array",
                        "title": "Tax Exemptions",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "CA_STATUS_CARD_EXEMPTION"
                        ]
                    },
                    "numberOfOrders": {
                        "type": "string",
                        "title": "Number of Orders",
                        "example": "3"
                    },
                    "createdAt": {
                        "type": "string",
                        "title": "Created At",
                        "example": "2026-10-05T08:22:51Z",
                        "format": "date-time"
                    },
                    "updatedAt": {
                        "type": "string",
                        "title": "Updated At",
                        "example": "2026-10-05T08:22:52Z",
                        "format": "date-time"
                    },
                    "amountSpent": {
                        "type": "object",
                        "title": "Amount Spent",
                        "required": [
                            "amount",
                            "currencyCode"
                        ],
                        "properties": {
                            "amount": {
                                "type": "string",
                                "title": "Amount Spent.Amount",
                                "example": "199.9"
                            },
                            "currencyCode": {
                                "type": "string",
                                "title": "Amount Spent.Currency Code",
                                "example": "USD"
                            }
                        }
                    },
                    "defaultEmailAddress": {
                        "type": "object",
                        "title": "Default Email Address",
                        "required": [
                            "emailAddress",
                            "marketingState"
                        ],
                        "properties": {
                            "emailAddress": {
                                "type": "string",
                                "title": "Default Email Address.Email Address",
                                "example": "jane.doe@example.com"
                            },
                            "marketingState": {
                                "type": "string",
                                "title": "Default Email Address.Marketing State",
                                "example": "SUBSCRIBED"
                            },
                            "marketingOptInLevel": {
                                "type": "string",
                                "title": "Default Email Address.Marketing Opt-in Level",
                                "example": "SINGLE_OPT_IN"
                            },
                            "marketingUpdatedAt": {
                                "type": "string",
                                "title": "Default Email Address.Marketing Updated At",
                                "example": "2026-10-05T08:22:50Z",
                                "format": "date-time"
                            }
                        }
                    },
                    "defaultPhoneNumber": {
                        "type": "object",
                        "title": "Default Phone Number",
                        "required": [
                            "phoneNumber",
                            "smsMarketingConsent"
                        ],
                        "properties": {
                            "phoneNumber": {
                                "type": "string",
                                "title": "Default Phone Number.Phone Number",
                                "example": "+420777123456"
                            },
                            "smsMarketingConsent": {
                                "type": "object",
                                "title": "Default Phone Number.SMS Marketing Consent",
                                "required": [
                                    "state"
                                ],
                                "properties": {
                                    "state": {
                                        "type": "string",
                                        "title": "Default Phone Number.SMS Marketing Consent.State",
                                        "example": "NOT_SUBSCRIBED"
                                    },
                                    "optInLevel": {
                                        "type": "string",
                                        "title": "Default Phone Number.SMS Marketing Consent.Opt-in Level",
                                        "example": "SINGLE_OPT_IN"
                                    },
                                    "updatedAt": {
                                        "type": "string",
                                        "title": "Default Phone Number.SMS Marketing Consent.Updated At",
                                        "example": "2026-10-05T08:22:50Z",
                                        "format": "date-time"
                                    }
                                }
                            }
                        }
                    },
                    "defaultAddress": {
                        "type": "object",
                        "title": "Default Address",
                        "required": [
                            "id"
                        ],
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Default Address.ID",
                                "example": "gid://shopify/MailingAddress/38344136425553?model_name=CustomerAddress"
                            },
                            "firstName": {
                                "type": "string",
                                "title": "Default Address.First Name",
                                "example": "Jane"
                            },
                            "lastName": {
                                "type": "string",
                                "title": "Default Address.Last Name",
                                "example": "Doe"
                            },
                            "company": {
                                "type": "string",
                                "title": "Default Address.Company",
                                "example": "Acme Inc."
                            },
                            "address1": {
                                "type": "string",
                                "title": "Default Address.Address Line 1",
                                "example": "Havanska 155"
                            },
                            "address2": {
                                "type": "string",
                                "title": "Default Address.Address Line 2",
                                "example": "Floor 2"
                            },
                            "city": {
                                "type": "string",
                                "title": "Default Address.City",
                                "example": "Prague"
                            },
                            "province": {
                                "type": "string",
                                "title": "Default Address.Province",
                                "example": "Ontario"
                            },
                            "provinceCode": {
                                "type": "string",
                                "title": "Default Address.Province Code",
                                "example": "ON"
                            },
                            "country": {
                                "type": "string",
                                "title": "Default Address.Country",
                                "example": "Czech Republic"
                            },
                            "countryCodeV2": {
                                "type": "string",
                                "title": "Default Address.Country Code",
                                "example": "CZ"
                            },
                            "zip": {
                                "type": "string",
                                "title": "Default Address.ZIP",
                                "example": "170 00"
                            },
                            "phone": {
                                "type": "string",
                                "title": "Default Address.Phone",
                                "example": "+420777123456"
                            }
                        }
                    },
                    "addresses": {
                        "type": "array",
                        "title": "Addresses",
                        "items": {
                            "type": "object",
                            "required": [
                                "id"
                            ],
                            "properties": {
                                "id": {
                                    "type": "string",
                                    "title": "ID",
                                    "example": "gid://shopify/MailingAddress/38344136425553?model_name=CustomerAddress"
                                },
                                "firstName": {
                                    "type": "string",
                                    "title": "First Name",
                                    "example": "Jane"
                                },
                                "lastName": {
                                    "type": "string",
                                    "title": "Last Name",
                                    "example": "Doe"
                                },
                                "company": {
                                    "type": "string",
                                    "title": "Company",
                                    "example": "Acme Inc."
                                },
                                "address1": {
                                    "type": "string",
                                    "title": "Address Line 1",
                                    "example": "Havanska 155"
                                },
                                "address2": {
                                    "type": "string",
                                    "title": "Address Line 2",
                                    "example": "Floor 2"
                                },
                                "city": {
                                    "type": "string",
                                    "title": "City",
                                    "example": "Prague"
                                },
                                "province": {
                                    "type": "string",
                                    "title": "Province",
                                    "example": "Ontario"
                                },
                                "provinceCode": {
                                    "type": "string",
                                    "title": "Province Code",
                                    "example": "ON"
                                },
                                "country": {
                                    "type": "string",
                                    "title": "Country",
                                    "example": "Czech Republic"
                                },
                                "countryCodeV2": {
                                    "type": "string",
                                    "title": "Country Code",
                                    "example": "CZ"
                                },
                                "zip": {
                                    "type": "string",
                                    "title": "ZIP",
                                    "example": "170 00"
                                },
                                "phone": {
                                    "type": "string",
                                    "title": "Phone",
                                    "example": "+420777123456"
                                }
                            }
                        },
                        "example": [
                            {
                                "id": "gid://shopify/MailingAddress/38344136425553?model_name=CustomerAddress",
                                "firstName": "Jane",
                                "lastName": "Doe",
                                "company": "Acme Inc.",
                                "address1": "Havanska 155",
                                "address2": null,
                                "city": "Prague",
                                "province": null,
                                "provinceCode": null,
                                "country": "Czech Republic",
                                "countryCodeV2": "CZ",
                                "zip": "170 00",
                                "phone": "+420777123456"
                            }
                        ]
                    },
                    "metafields": {
                        "type": "array",
                        "title": "Metafields",
                        "items": {
                            "type": "object",
                            "required": [
                                "namespace",
                                "key",
                                "type",
                                "value"
                            ],
                            "properties": {
                                "namespace": {
                                    "type": "string",
                                    "title": "Namespace",
                                    "example": "custom"
                                },
                                "key": {
                                    "type": "string",
                                    "title": "Key",
                                    "example": "loyalty_level"
                                },
                                "type": {
                                    "type": "string",
                                    "title": "Type",
                                    "example": "single_line_text_field"
                                },
                                "value": {
                                    "type": "string",
                                    "title": "Value",
                                    "example": "gold"
                                }
                            }
                        },
                        "example": [
                            {
                                "namespace": "custom",
                                "key": "loyalty_level",
                                "type": "single_line_text_field",
                                "value": "gold"
                            }
                        ]
                    },
                    "lastOrder": {
                        "type": "object",
                        "title": "Last Order",
                        "required": [
                            "id",
                            "name"
                        ],
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Last Order.ID",
                                "example": "gid://shopify/Order/6012345678901"
                            },
                            "name": {
                                "type": "string",
                                "title": "Last Order.Name",
                                "example": "#1001"
                            }
                        }
                    },
                    "webhookTopic": {
                        "type": "string",
                        "title": "Webhook Topic",
                        "example": "customers/update"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
