{
    "product": {
        "type": "object",
        "required": [
            "id", "legacyResourceId", "title", "handle", "descriptionHtml", "vendor", "productType", "status", "tags",
            "createdAt", "updatedAt", "totalInventory", "tracksInventory", "hasOnlyDefaultVariant", "seo", "priceRangeV2",
            "options", "variants", "media"
        ],
        "properties": {
            "id": { "type": "string", "title": "Product ID", "example": "gid://shopify/Product/16347478065233" },
            "legacyResourceId": { "type": "string", "title": "Legacy Resource ID", "example": "16347478065233" },
            "title": { "type": "string", "title": "Title", "example": "Organic Cotton T-Shirt" },
            "handle": { "type": "string", "title": "Handle", "example": "organic-cotton-t-shirt" },
            "descriptionHtml": { "type": "string", "title": "Description HTML", "example": "<p>Soft, breathable organic cotton.</p>" },
            "vendor": { "type": "string", "title": "Vendor", "example": "Acme Apparel" },
            "productType": { "type": "string", "title": "Product Type", "example": "T-Shirts" },
            "status": { "type": "string", "title": "Status", "example": "ACTIVE" },
            "tags": { "type": "array", "title": "Tags", "items": { "type": "string" }, "example": ["summer", "cotton"] },
            "createdAt": { "type": "string", "format": "date-time", "title": "Created At", "example": "2026-10-05T08:22:31Z" },
            "updatedAt": { "type": "string", "format": "date-time", "title": "Updated At", "example": "2026-10-05T08:22:33Z" },
            "publishedAt": { "type": "string", "format": "date-time", "title": "Published At", "example": "2026-10-05T08:22:40Z" },
            "templateSuffix": { "type": "string", "title": "Template Suffix", "example": "special" },
            "onlineStoreUrl": { "type": "string", "title": "Online Store URL", "example": "https://acme.example.com/products/organic-cotton-t-shirt" },
            "totalInventory": { "type": "integer", "title": "Total Inventory", "example": 42 },
            "tracksInventory": { "type": "boolean", "title": "Tracks Inventory", "example": true },
            "hasOnlyDefaultVariant": { "type": "boolean", "title": "Has Only Default Variant", "example": false },
            "seo": {
                "type": "object",
                "title": "SEO",
                "properties": {
                    "title": { "type": "string", "title": "SEO.Title", "example": "Organic Cotton T-Shirt | Acme" },
                    "description": { "type": "string", "title": "SEO.Description", "example": "Soft, breathable organic cotton tee." }
                }
            },
            "category": {
                "type": "object",
                "title": "Category",
                "required": ["id", "name", "fullName"],
                "properties": {
                    "id": { "type": "string", "title": "Category.ID", "example": "gid://shopify/TaxonomyCategory/aa-1-13-8" },
                    "name": { "type": "string", "title": "Category.Name", "example": "T-Shirts" },
                    "fullName": { "type": "string", "title": "Category.Full Name", "example": "Apparel & Accessories > Clothing > Clothing Tops > T-Shirts" }
                }
            },
            "priceRangeV2": {
                "type": "object",
                "title": "Price Range",
                "required": ["minVariantPrice", "maxVariantPrice"],
                "properties": {
                    "minVariantPrice": {
                        "type": "object",
                        "title": "Price Range.Min Variant Price",
                        "required": ["amount", "currencyCode"],
                        "properties": {
                            "amount": { "type": "string", "title": "Price Range.Min Variant Price.Amount", "example": "19.0" },
                            "currencyCode": { "type": "string", "title": "Price Range.Min Variant Price.Currency Code", "example": "USD" }
                        }
                    },
                    "maxVariantPrice": {
                        "type": "object",
                        "title": "Price Range.Max Variant Price",
                        "required": ["amount", "currencyCode"],
                        "properties": {
                            "amount": { "type": "string", "title": "Price Range.Max Variant Price.Amount", "example": "24.0" },
                            "currencyCode": { "type": "string", "title": "Price Range.Max Variant Price.Currency Code", "example": "USD" }
                        }
                    }
                }
            },
            "options": {
                "type": "array",
                "title": "Options",
                "items": {
                    "type": "object",
                    "required": ["id", "name", "position", "values"],
                    "properties": {
                        "id": { "type": "string", "title": "Option ID", "example": "gid://shopify/ProductOption/18960245588049" },
                        "name": { "type": "string", "title": "Name", "example": "Size" },
                        "position": { "type": "integer", "title": "Position", "example": 1 },
                        "values": { "type": "array", "title": "Values", "items": { "type": "string" }, "example": ["S", "M", "L"] }
                    }
                },
                "example": [{ "id": "gid://shopify/ProductOption/18960245588049", "name": "Size", "position": 1, "values": ["S", "M", "L"] }]
            },
            "variants": {
                "type": "array",
                "title": "Variants",
                "items": {
                    "type": "object",
                    "required": [
                        "id", "legacyResourceId", "title", "displayName", "price", "position", "inventoryPolicy", "taxable",
                        "availableForSale", "createdAt", "updatedAt", "barcodes", "selectedOptions", "inventoryItem"
                    ],
                    "properties": {
                        "id": { "type": "string", "title": "Variant ID", "example": "gid://shopify/ProductVariant/62809874268241" },
                        "legacyResourceId": { "type": "string", "title": "Legacy Resource ID", "example": "62809874268241" },
                        "title": { "type": "string", "title": "Title", "example": "M" },
                        "displayName": { "type": "string", "title": "Display Name", "example": "Organic Cotton T-Shirt - M" },
                        "sku": { "type": "string", "title": "SKU", "example": "TS-ORG-M" },
                        "price": { "type": "string", "title": "Price", "example": "19.00" },
                        "compareAtPrice": { "type": "string", "title": "Compare At Price", "example": "25.00" },
                        "position": { "type": "integer", "title": "Position", "example": 1 },
                        "inventoryPolicy": { "type": "string", "title": "Inventory Policy", "example": "DENY" },
                        "inventoryQuantity": { "type": "integer", "title": "Inventory Quantity", "example": 14 },
                        "taxable": { "type": "boolean", "title": "Taxable", "example": true },
                        "availableForSale": { "type": "boolean", "title": "Available For Sale", "example": true },
                        "createdAt": { "type": "string", "format": "date-time", "title": "Created At", "example": "2026-10-05T08:22:31Z" },
                        "updatedAt": { "type": "string", "format": "date-time", "title": "Updated At", "example": "2026-10-05T08:22:31Z" },
                        "barcodes": {
                            "type": "array",
                            "title": "Barcodes",
                            "items": {
                                "type": "object",
                                "required": ["value"],
                                "properties": {
                                    "type": { "type": "string", "title": "Type", "example": "EAN_13" },
                                    "value": { "type": "string", "title": "Value", "example": "4006381333931" }
                                }
                            },
                            "example": [{ "type": "EAN_13", "value": "4006381333931" }]
                        },
                        "selectedOptions": {
                            "type": "array",
                            "title": "Selected Options",
                            "items": {
                                "type": "object",
                                "required": ["name", "value"],
                                "properties": {
                                    "name": { "type": "string", "title": "Name", "example": "Size" },
                                    "value": { "type": "string", "title": "Value", "example": "M" }
                                }
                            },
                            "example": [{ "name": "Size", "value": "M" }]
                        },
                        "inventoryItem": {
                            "type": "object",
                            "title": "Inventory Item",
                            "required": ["id", "tracked", "requiresShipping", "measurement"],
                            "properties": {
                                "id": { "type": "string", "title": "Inventory Item.ID", "example": "gid://shopify/InventoryItem/64827969437777" },
                                "tracked": { "type": "boolean", "title": "Inventory Item.Tracked", "example": true },
                                "requiresShipping": { "type": "boolean", "title": "Inventory Item.Requires Shipping", "example": true },
                                "measurement": {
                                    "type": "object",
                                    "title": "Inventory Item.Measurement",
                                    "properties": {
                                        "weight": {
                                            "type": "object",
                                            "title": "Inventory Item.Measurement.Weight",
                                            "required": ["unit", "value"],
                                            "properties": {
                                                "unit": { "type": "string", "title": "Inventory Item.Measurement.Weight.Unit", "example": "GRAMS" },
                                                "value": { "type": "number", "title": "Inventory Item.Measurement.Weight.Value", "example": 180 }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "example": [{
                    "id": "gid://shopify/ProductVariant/62809874268241",
                    "legacyResourceId": "62809874268241",
                    "title": "M",
                    "displayName": "Organic Cotton T-Shirt - M",
                    "sku": "TS-ORG-M",
                    "price": "19.00",
                    "compareAtPrice": null,
                    "position": 1,
                    "inventoryPolicy": "DENY",
                    "inventoryQuantity": 14,
                    "taxable": true,
                    "availableForSale": true,
                    "createdAt": "2026-10-05T08:22:31Z",
                    "updatedAt": "2026-10-05T08:22:31Z",
                    "barcodes": [],
                    "selectedOptions": [{ "name": "Size", "value": "M" }],
                    "inventoryItem": {
                        "id": "gid://shopify/InventoryItem/64827969437777",
                        "tracked": true,
                        "requiresShipping": true,
                        "measurement": { "weight": { "unit": "GRAMS", "value": 180 } }
                    }
                }]
            },
            "media": {
                "type": "array",
                "title": "Media",
                "items": {
                    "type": "object",
                    "required": ["id", "mediaContentType", "status"],
                    "properties": {
                        "id": { "type": "string", "title": "Media ID", "example": "gid://shopify/MediaImage/73881115492433" },
                        "alt": { "type": "string", "title": "Alt Text", "example": "Front view" },
                        "mediaContentType": { "type": "string", "title": "Media Content Type", "example": "IMAGE" },
                        "status": { "type": "string", "title": "Status", "example": "READY" },
                        "preview": {
                            "type": "object",
                            "title": "Preview",
                            "properties": {
                                "image": {
                                    "type": "object",
                                    "title": "Preview.Image",
                                    "required": ["url"],
                                    "properties": {
                                        "url": { "type": "string", "title": "Preview.Image.URL", "example": "https://cdn.shopify.com/s/files/1/1079/6174/5489/files/front.png?v=1791188552" },
                                        "width": { "type": "integer", "title": "Preview.Image.Width", "example": 480 },
                                        "height": { "type": "integer", "title": "Preview.Image.Height", "example": 480 }
                                    }
                                }
                            }
                        }
                    }
                },
                "example": [{
                    "id": "gid://shopify/MediaImage/73881115492433",
                    "alt": "Front view",
                    "mediaContentType": "IMAGE",
                    "status": "READY",
                    "preview": { "image": { "url": "https://cdn.shopify.com/s/files/1/1079/6174/5489/files/front.png?v=1791188552", "width": 480, "height": 480 } }
                }]
            }
        }
    }
}
