{
    "name": "appmixer.shopify.checkouts.AbandonedCart",
    "author": "Appmixer <info@appmixer.com>",
    "description": "This trigger fires when a cart/checkout is abandoned on Shopify (polls abandoned checkouts).",
    "icon": "data:image/svg+xml;base64,",
    "private": false,
    "tick": true,
    "auth": {
        "service": "appmixer:shopify"
    },
    "outPorts": [
        {
            "name": "checkout",
            "options": [
                {
                    "label": "ID",
                    "value": "id",
                    "schema": {
                        "type": "number",
                        "example": 8850485379234
                    }
                },
                {
                    "label": "Token",
                    "value": "token",
                    "schema": {
                        "type": "string",
                        "example": "abc123def456ghi789"
                    }
                },
                {
                    "label": "Cart Token",
                    "value": "cart_token",
                    "schema": {
                        "type": "string",
                        "example": "68778783ad298f1c80c3bafcddeea02f"
                    }
                },
                {
                    "label": "Email",
                    "value": "email",
                    "schema": {
                        "type": "string",
                        "example": "john.doe@example.com"
                    }
                },
                {
                    "label": "Gateway",
                    "value": "gateway",
                    "schema": {
                        "type": "string",
                        "example": null
                    }
                },
                {
                    "label": "Buyer Accepts Marketing",
                    "value": "buyer_accepts_marketing",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-03-10T09:00:00-04:00"
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updated_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-03-10T09:12:00-04:00"
                    }
                },
                {
                    "label": "Landing Site",
                    "value": "landing_site",
                    "schema": {
                        "type": "string",
                        "example": "/products/great-product"
                    }
                },
                {
                    "label": "Note",
                    "value": "note",
                    "schema": {
                        "type": "string",
                        "example": null
                    }
                },
                {
                    "label": "Currency",
                    "value": "currency",
                    "schema": {
                        "type": "string",
                        "example": "USD"
                    }
                },
                {
                    "label": "Completed At",
                    "value": "completed_at",
                    "schema": {
                        "type": "string",
                        "example": null
                    }
                },
                {
                    "label": "Phone",
                    "value": "phone",
                    "schema": {
                        "type": "string",
                        "example": "+15145556789"
                    }
                },
                {
                    "label": "Customer Locale",
                    "value": "customer_locale",
                    "schema": {
                        "type": "string",
                        "example": "en"
                    }
                },
                {
                    "label": "Line Items",
                    "value": "line_items",
                    "schema": {
                        "type": "array",
                        "example": [
                            {
                                "key": "abc123",
                                "title": "IPod Nano - 8GB",
                                "quantity": 1,
                                "price": "199.00",
                                "product_id": 632910392,
                                "variant_id": 39072856
                            }
                        ]
                    }
                },
                {
                    "label": "Abandoned Checkout Url",
                    "value": "abandoned_checkout_url",
                    "schema": {
                        "type": "string",
                        "example": "https://mystore.myshopify.com/12345/checkouts/abc123/recover"
                    }
                },
                {
                    "label": "Subtotal Price",
                    "value": "subtotal_price",
                    "schema": {
                        "type": "string",
                        "example": "199.00"
                    }
                },
                {
                    "label": "Total Tax",
                    "value": "total_tax",
                    "schema": {
                        "type": "string",
                        "example": "11.94"
                    }
                },
                {
                    "label": "Total Price",
                    "value": "total_price",
                    "schema": {
                        "type": "string",
                        "example": "204.99"
                    }
                },
                {
                    "label": "Customer",
                    "value": "customer",
                    "schema": {
                        "type": "object",
                        "example": {
                            "id": 207119551,
                            "email": "john.doe@example.com",
                            "first_name": "John",
                            "last_name": "Doe"
                        }
                    }
                },
                {
                    "label": "Shipping Address",
                    "value": "shipping_address",
                    "schema": {
                        "type": "object",
                        "example": {
                            "first_name": "John",
                            "last_name": "Doe",
                            "address1": "456 Oak Ave",
                            "city": "Los Angeles",
                            "province": "CA",
                            "country": "US",
                            "zip": "90001"
                        }
                    }
                },
                {
                    "label": "Billing Address",
                    "value": "billing_address",
                    "schema": {
                        "type": "object",
                        "example": {
                            "first_name": "John",
                            "last_name": "Doe",
                            "address1": "123 Main St",
                            "city": "New York",
                            "province": "NY",
                            "country": "US",
                            "zip": "10001"
                        }
                    }
                }
            ]
        }
    ]
}
