{
    "name": "appmixer.shopify.checkouts.AbandonedCart",
    "description": "Triggers when a checkout of the online store is abandoned: the customer entered contact details and left without paying. Shopify lists a checkout as abandoned with a delay of several minutes; the trigger checks the newest 250 abandoned checkouts every minute.",
    "author": "Appmixer <info@appmixer.com>",
    "private": false,
    "tick": true,
    "auth": {
        "service": "appmixer:shopify",
        "scope": [
            "read_orders",
            "read_customers"
        ]
    },
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "name",
                    "abandonedCheckoutUrl",
                    "createdAt",
                    "updatedAt",
                    "note",
                    "taxesIncluded",
                    "discountCodes",
                    "customAttributes",
                    "subtotalPriceSet",
                    "totalDiscountSet",
                    "totalLineItemsPriceSet",
                    "totalPriceSet",
                    "lineItems"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Checkout ID",
                        "example": "gid://shopify/AbandonedCheckout/72420962140241"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "#72420962140241"
                    },
                    "abandonedCheckoutUrl": {
                        "type": "string",
                        "title": "Abandoned Checkout URL",
                        "example": "https://example-store.myshopify.com/107961745489/checkouts/ac/hWNHVSMfAwqum6xvRm7dyFu7/recover?key=938cca59d2e3eb603f988e4b8729d706"
                    },
                    "createdAt": {
                        "type": "string",
                        "title": "Created At",
                        "example": "2026-10-02T13:27:33Z",
                        "format": "date-time"
                    },
                    "updatedAt": {
                        "type": "string",
                        "title": "Updated At",
                        "example": "2026-10-02T23:28:00Z",
                        "format": "date-time"
                    },
                    "completedAt": {
                        "type": "string",
                        "title": "Completed At",
                        "example": "2026-10-03T09:12:45Z",
                        "format": "date-time"
                    },
                    "note": {
                        "type": "string",
                        "title": "Note",
                        "example": "Gift wrap, please"
                    },
                    "taxesIncluded": {
                        "type": "boolean",
                        "title": "Taxes Included",
                        "example": false
                    },
                    "discountCodes": {
                        "type": "array",
                        "title": "Discount Codes",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "WELCOME10"
                        ]
                    },
                    "customAttributes": {
                        "type": "array",
                        "title": "Custom Attributes",
                        "items": {
                            "type": "object",
                            "required": [
                                "key"
                            ],
                            "properties": {
                                "key": {
                                    "type": "string",
                                    "title": "Key",
                                    "example": "gift"
                                },
                                "value": {
                                    "type": "string",
                                    "title": "Value",
                                    "example": "yes"
                                }
                            }
                        },
                        "example": [
                            {
                                "key": "gift",
                                "value": "yes"
                            }
                        ]
                    },
                    "subtotalPriceSet": {
                        "type": "object",
                        "title": "Subtotal Price",
                        "required": [
                            "shopMoney"
                        ],
                        "properties": {
                            "shopMoney": {
                                "type": "object",
                                "title": "Subtotal Price.Shop Money",
                                "required": [
                                    "amount",
                                    "currencyCode"
                                ],
                                "properties": {
                                    "amount": {
                                        "type": "string",
                                        "title": "Subtotal Price.Shop Money.Amount",
                                        "example": "693.45"
                                    },
                                    "currencyCode": {
                                        "type": "string",
                                        "title": "Subtotal Price.Shop Money.Currency Code",
                                        "example": "USD"
                                    }
                                }
                            }
                        }
                    },
                    "totalDiscountSet": {
                        "type": "object",
                        "title": "Total Discount",
                        "required": [
                            "shopMoney"
                        ],
                        "properties": {
                            "shopMoney": {
                                "type": "object",
                                "title": "Total Discount.Shop Money",
                                "required": [
                                    "amount",
                                    "currencyCode"
                                ],
                                "properties": {
                                    "amount": {
                                        "type": "string",
                                        "title": "Total Discount.Shop Money.Amount",
                                        "example": "0.0"
                                    },
                                    "currencyCode": {
                                        "type": "string",
                                        "title": "Total Discount.Shop Money.Currency Code",
                                        "example": "USD"
                                    }
                                }
                            }
                        }
                    },
                    "totalLineItemsPriceSet": {
                        "type": "object",
                        "title": "Total Line Items Price",
                        "required": [
                            "shopMoney"
                        ],
                        "properties": {
                            "shopMoney": {
                                "type": "object",
                                "title": "Total Line Items Price.Shop Money",
                                "required": [
                                    "amount",
                                    "currencyCode"
                                ],
                                "properties": {
                                    "amount": {
                                        "type": "string",
                                        "title": "Total Line Items Price.Shop Money.Amount",
                                        "example": "693.45"
                                    },
                                    "currencyCode": {
                                        "type": "string",
                                        "title": "Total Line Items Price.Shop Money.Currency Code",
                                        "example": "USD"
                                    }
                                }
                            }
                        }
                    },
                    "totalTaxSet": {
                        "type": "object",
                        "title": "Total Tax",
                        "required": [
                            "shopMoney"
                        ],
                        "properties": {
                            "shopMoney": {
                                "type": "object",
                                "title": "Total Tax.Shop Money",
                                "required": [
                                    "amount",
                                    "currencyCode"
                                ],
                                "properties": {
                                    "amount": {
                                        "type": "string",
                                        "title": "Total Tax.Shop Money.Amount",
                                        "example": "0.0"
                                    },
                                    "currencyCode": {
                                        "type": "string",
                                        "title": "Total Tax.Shop Money.Currency Code",
                                        "example": "USD"
                                    }
                                }
                            }
                        }
                    },
                    "totalPriceSet": {
                        "type": "object",
                        "title": "Total Price",
                        "required": [
                            "shopMoney"
                        ],
                        "properties": {
                            "shopMoney": {
                                "type": "object",
                                "title": "Total Price.Shop Money",
                                "required": [
                                    "amount",
                                    "currencyCode"
                                ],
                                "properties": {
                                    "amount": {
                                        "type": "string",
                                        "title": "Total Price.Shop Money.Amount",
                                        "example": "693.45"
                                    },
                                    "currencyCode": {
                                        "type": "string",
                                        "title": "Total Price.Shop Money.Currency Code",
                                        "example": "USD"
                                    }
                                }
                            }
                        }
                    },
                    "customer": {
                        "type": "object",
                        "title": "Customer",
                        "required": [
                            "id",
                            "legacyResourceId",
                            "displayName"
                        ],
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Customer.ID",
                                "example": "gid://shopify/Customer/27598980087889"
                            },
                            "legacyResourceId": {
                                "type": "string",
                                "title": "Customer.Legacy Resource ID",
                                "example": "27598980087889"
                            },
                            "displayName": {
                                "type": "string",
                                "title": "Customer.Display Name",
                                "example": "Jane Doe"
                            },
                            "defaultEmailAddress": {
                                "type": "object",
                                "title": "Customer.Default Email Address",
                                "required": [
                                    "emailAddress"
                                ],
                                "properties": {
                                    "emailAddress": {
                                        "type": "string",
                                        "title": "Customer.Default Email Address.Email Address",
                                        "example": "jane.doe@example.com"
                                    }
                                }
                            },
                            "defaultPhoneNumber": {
                                "type": "object",
                                "title": "Customer.Default Phone Number",
                                "required": [
                                    "phoneNumber"
                                ],
                                "properties": {
                                    "phoneNumber": {
                                        "type": "string",
                                        "title": "Customer.Default Phone Number.Phone Number",
                                        "example": "+16135550135"
                                    }
                                }
                            }
                        }
                    },
                    "shippingAddress": {
                        "type": "object",
                        "title": "Shipping Address",
                        "required": [
                            "id"
                        ],
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Shipping Address.ID",
                                "example": "gid://shopify/MailingAddress/38344136425553?model_name=CustomerAddress"
                            },
                            "firstName": {
                                "type": "string",
                                "title": "Shipping Address.First Name",
                                "example": "Jane"
                            },
                            "lastName": {
                                "type": "string",
                                "title": "Shipping Address.Last Name",
                                "example": "Doe"
                            },
                            "company": {
                                "type": "string",
                                "title": "Shipping Address.Company",
                                "example": "Acme Inc."
                            },
                            "address1": {
                                "type": "string",
                                "title": "Shipping Address.Address Line 1",
                                "example": "150 Elgin Street"
                            },
                            "address2": {
                                "type": "string",
                                "title": "Shipping Address.Address Line 2",
                                "example": "Suite 800"
                            },
                            "city": {
                                "type": "string",
                                "title": "Shipping Address.City",
                                "example": "Ottawa"
                            },
                            "province": {
                                "type": "string",
                                "title": "Shipping Address.Province",
                                "example": "Ontario"
                            },
                            "provinceCode": {
                                "type": "string",
                                "title": "Shipping Address.Province Code",
                                "example": "ON"
                            },
                            "country": {
                                "type": "string",
                                "title": "Shipping Address.Country",
                                "example": "Canada"
                            },
                            "countryCodeV2": {
                                "type": "string",
                                "title": "Shipping Address.Country Code",
                                "example": "CA"
                            },
                            "zip": {
                                "type": "string",
                                "title": "Shipping Address.ZIP",
                                "example": "K2P 1L4"
                            },
                            "phone": {
                                "type": "string",
                                "title": "Shipping Address.Phone",
                                "example": "+16135550135"
                            }
                        }
                    },
                    "billingAddress": {
                        "type": "object",
                        "title": "Billing Address",
                        "required": [
                            "id"
                        ],
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Billing Address.ID",
                                "example": "gid://shopify/MailingAddress/38344136425553?model_name=CustomerAddress"
                            },
                            "firstName": {
                                "type": "string",
                                "title": "Billing Address.First Name",
                                "example": "Jane"
                            },
                            "lastName": {
                                "type": "string",
                                "title": "Billing Address.Last Name",
                                "example": "Doe"
                            },
                            "company": {
                                "type": "string",
                                "title": "Billing Address.Company",
                                "example": "Acme Inc."
                            },
                            "address1": {
                                "type": "string",
                                "title": "Billing Address.Address Line 1",
                                "example": "150 Elgin Street"
                            },
                            "address2": {
                                "type": "string",
                                "title": "Billing Address.Address Line 2",
                                "example": "Suite 800"
                            },
                            "city": {
                                "type": "string",
                                "title": "Billing Address.City",
                                "example": "Ottawa"
                            },
                            "province": {
                                "type": "string",
                                "title": "Billing Address.Province",
                                "example": "Ontario"
                            },
                            "provinceCode": {
                                "type": "string",
                                "title": "Billing Address.Province Code",
                                "example": "ON"
                            },
                            "country": {
                                "type": "string",
                                "title": "Billing Address.Country",
                                "example": "Canada"
                            },
                            "countryCodeV2": {
                                "type": "string",
                                "title": "Billing Address.Country Code",
                                "example": "CA"
                            },
                            "zip": {
                                "type": "string",
                                "title": "Billing Address.ZIP",
                                "example": "K2P 1L4"
                            },
                            "phone": {
                                "type": "string",
                                "title": "Billing Address.Phone",
                                "example": "+16135550135"
                            }
                        }
                    },
                    "lineItems": {
                        "type": "array",
                        "title": "Line Items",
                        "items": {
                            "type": "object",
                            "required": [
                                "id",
                                "quantity",
                                "originalUnitPriceSet",
                                "originalTotalPriceSet",
                                "discountedTotalPriceSet"
                            ],
                            "properties": {
                                "id": {
                                    "type": "string",
                                    "title": "ID",
                                    "example": "gid://shopify/AbandonedCheckoutLineItem/ee015e1efa018c1b9c0c05e330f8fc65?checkout=47661deb0143428e4de409b48e960643&index=0"
                                },
                                "title": {
                                    "type": "string",
                                    "title": "Title",
                                    "example": "The Multi-location Snowboard"
                                },
                                "variantTitle": {
                                    "type": "string",
                                    "title": "Variant Title",
                                    "example": "Blue / 152 cm"
                                },
                                "sku": {
                                    "type": "string",
                                    "title": "SKU",
                                    "example": "SNOW-ML-152"
                                },
                                "quantity": {
                                    "type": "integer",
                                    "title": "Quantity",
                                    "example": 1
                                },
                                "originalUnitPriceSet": {
                                    "type": "object",
                                    "title": "Original Unit Price",
                                    "required": [
                                        "shopMoney"
                                    ],
                                    "properties": {
                                        "shopMoney": {
                                            "type": "object",
                                            "title": "Original Unit Price.Shop Money",
                                            "required": [
                                                "amount",
                                                "currencyCode"
                                            ],
                                            "properties": {
                                                "amount": {
                                                    "type": "string",
                                                    "title": "Original Unit Price.Shop Money.Amount",
                                                    "example": "693.45"
                                                },
                                                "currencyCode": {
                                                    "type": "string",
                                                    "title": "Original Unit Price.Shop Money.Currency Code",
                                                    "example": "USD"
                                                }
                                            }
                                        }
                                    }
                                },
                                "originalTotalPriceSet": {
                                    "type": "object",
                                    "title": "Original Total Price",
                                    "required": [
                                        "shopMoney"
                                    ],
                                    "properties": {
                                        "shopMoney": {
                                            "type": "object",
                                            "title": "Original Total Price.Shop Money",
                                            "required": [
                                                "amount",
                                                "currencyCode"
                                            ],
                                            "properties": {
                                                "amount": {
                                                    "type": "string",
                                                    "title": "Original Total Price.Shop Money.Amount",
                                                    "example": "693.45"
                                                },
                                                "currencyCode": {
                                                    "type": "string",
                                                    "title": "Original Total Price.Shop Money.Currency Code",
                                                    "example": "USD"
                                                }
                                            }
                                        }
                                    }
                                },
                                "discountedTotalPriceSet": {
                                    "type": "object",
                                    "title": "Discounted Total Price",
                                    "required": [
                                        "shopMoney"
                                    ],
                                    "properties": {
                                        "shopMoney": {
                                            "type": "object",
                                            "title": "Discounted Total Price.Shop Money",
                                            "required": [
                                                "amount",
                                                "currencyCode"
                                            ],
                                            "properties": {
                                                "amount": {
                                                    "type": "string",
                                                    "title": "Discounted Total Price.Shop Money.Amount",
                                                    "example": "693.45"
                                                },
                                                "currencyCode": {
                                                    "type": "string",
                                                    "title": "Discounted Total Price.Shop Money.Currency Code",
                                                    "example": "USD"
                                                }
                                            }
                                        }
                                    }
                                },
                                "product": {
                                    "type": "object",
                                    "title": "Product",
                                    "required": [
                                        "id",
                                        "title"
                                    ],
                                    "properties": {
                                        "id": {
                                            "type": "string",
                                            "title": "Product.ID",
                                            "example": "gid://shopify/Product/16344831754321"
                                        },
                                        "title": {
                                            "type": "string",
