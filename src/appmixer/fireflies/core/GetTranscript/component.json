{
    "name": "appmixer.fireflies.core.GetTranscript",
    "label": "Get Transcript",
    "description": "Retrieve a single Fireflies meeting transcript by its ID, including summary, action items, speakers and sentence-level transcript.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:fireflies"
    },
    "quota": {
        "manager": "appmixer:fireflies",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "transcriptId": { "type": "string" }
                },
                "required": ["transcriptId"]
            },
            "inspector": {
                "inputs": {
                    "transcriptId": {
                        "type": "text",
                        "index": 0,
                        "label": "Transcript ID",
                        "tooltip": "The unique ID of the transcript to retrieve. You can obtain it from Find Transcripts, List Transcripts or the New Transcript trigger."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": { "type": "string", "title": "Transcript ID", "example": "01HXY2ZK9QF3M4N5P6Q7R8S9T" },
                    "title": { "type": "string", "title": "Title", "example": "Weekly Sync — Product" },
                    "host_email": { "type": "string", "title": "Host Email", "example": "host@example.com" },
                    "organizer_email": { "type": "string", "title": "Organizer Email", "example": "organizer@example.com" },
                    "transcript_url": { "type": "string", "title": "Transcript URL", "example": "https://app.fireflies.ai/view/01HXY2ZK9QF3M4N5P6Q7R8S9T" },
                    "meeting_link": { "type": "string", "title": "Meeting Link", "example": "https://zoom.us/j/123456789" },
                    "duration": { "type": "number", "title": "Duration (minutes)", "example": 32.5 },
                    "dateString": { "type": "string", "format": "date-time", "title": "Date", "example": "2026-08-01T14:00:00.000Z" },
                    "date": { "type": "number", "title": "Date (epoch ms)", "example": 1754056800000 },
                    "audio_url": { "type": "string", "title": "Audio URL", "example": "https://api.fireflies.ai/audio/01HXY2ZK9QF3M4N5P6Q7R8S9T.mp3" },
                    "video_url": { "type": "string", "title": "Video URL", "example": "https://api.fireflies.ai/video/01HXY2ZK9QF3M4N5P6Q7R8S9T.mp4" },
                    "participants": {
                        "type": "array",
                        "title": "Participants",
                        "items": { "type": "string" },
                        "example": ["organizer@example.com", "guest@example.com"]
                    },
                    "speakers": {
                        "type": "array",
                        "title": "Speakers",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": { "type": "integer" },
                                "name": { "type": "string" }
                            }
                        },
                        "example": [{ "id": 0, "name": "Jane Doe" }, { "id": 1, "name": "John Smith" }]
                    },
                    "summary": {
                        "type": "object",
                        "title": "Summary",
                        "properties": {
                            "overview": { "type": "string" },
                            "short_summary": { "type": "string" },
                            "action_items": { "type": "string" },
                            "keywords": { "type": "array", "items": { "type": "string" } },
                            "outline": { "type": "string" },
                            "bullet_gist": { "type": "string" },
                            "gist": { "type": "string" }
                        },
                        "example": {
                            "short_summary": "The team reviewed the roadmap and agreed on Q3 priorities.",
                            "action_items": "Jane to draft the spec. John to schedule the kickoff.",
                            "keywords": ["roadmap", "Q3", "priorities"]
                        }
                    },
                    "sentences": {
                        "type": "array",
                        "title": "Sentences",
                        "items": {
                            "type": "object",
                            "properties": {
                                "index": { "type": "integer" },
                                "speaker_name": { "type": "string" },
                                "speaker_id": { "type": "string" },
                                "text": { "type": "string" },
                                "start_time": { "type": "number" },
                                "end_time": { "type": "number" }
                            }
                        },
                        "example": [{ "index": 0, "speaker_name": "Jane Doe", "text": "Let's get started.", "start_time": 1.2, "end_time": 2.8 }]
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
