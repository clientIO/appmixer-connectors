{
    "name": "appmixer.constantContact.core.CreateContact",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new contact.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:constantContact"
    },
    "quota": {
        "manager": "appmixer:constantContact",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "email_address": {
                        "type": "string"
                    },                  
                    "permission_to_send": {
                        "type": "string"
                    },  
                    "first_name": {
                        "type": "string",
                        "title": "First Name"
                    },
                    "last_name": {
                        "type": "string",
                        "title": "Last Name"
                    },
                    "company_name": {
                        "type": "string",
                        "title": "Company Name"
                    },
                    "job_title": {
                        "type": "string",
                        "title": "Job Title"
                    },
                    "list_memberships": {
                        "type": ["array", "string"],
                        "items": {
                            "type": "string"
                        },
                        "title": "List Memberships"
                    },
                    "tags": {
                        "type": ["array", "string"],
                        "items": {
                            "type": "string"
                        },
                        "title": "Tags"
                    },
                    "create_source": {
                        "type": "string",
                        "title": "Create Source"
                    }
                },
                "required": [
                    "email_address",
                    "permission_to_send",
                    "create_source"
                ]
            },
            "inspector": {
                "inputs": {
                    "email_address": {
                        "type": "text",
                        "label": "Email Address",
                        "tooltip": "Email address of the contact.",
                        "index": 1
                    },
                    "permission_to_send": {
                        "type": "select",
                        "label": "Permission To Send",
                        "tooltip": "Identifies the type of permission that the Constant Contact account has been granted to send email to the contact.",
                        "options": [
                            {
                                "label": "Explicit",
                                "value": "explicit"
                            },
                            {
                                "label": "Implicit",
                                "value": "implicit"
                            },
                            {
                                "label": "Pending Confirmation",
                                "value": "pending_confirmation"
                            },
                            {
                                "label": "Unsubscribed",
                                "value": "unsubscribed"
                            },
                            {
                                "label": "Temporary Hold",
                                "value": "temp_hold"
                            },
                            {
                                "label": "Not Set",
                                "value": "not_set"
                            }
                        ],
                        "index": 1
                    },
                    "first_name": {
                        "type": "text",
                        "tooltip": "First name of the contact.",
                        "label": "First Name",
                        "index": 2
                    },
                    "last_name": {
                        "type": "text",
                        "tooltip": "Last name of the contact.",
                        "label": "Last Name",
                        "index": 3
                    },
                    "company_name": {
                        "type": "text",
                        "tooltip": "Company name.",
                        "label": "Company Name",
                        "index": 4
                    },
                    "job_title": {
                        "type": "text",
                        "tooltip": "Job title.",
                        "label": "Job Title",
                        "index": 5
                    },
                    "list_memberships": {
                        "type": "multiselect",
                        "tooltip": "List IDs to subscribe the contact to.",
                        "label": "List Memberships",
                        "index": 6,
                        "source": {
                            "url": "/component/appmixer/constantContact/core/FindContactLists?outPort=out",
                            "data": {
                                "transform": "./FindContactLists#listsToSelectArray"
                            }
                        }
                    },
                    "tags": {
                        "type": "multiselect",
                        "tooltip": "Tags to apply to the contact.",
                        "label": "Tags",
                        "index": 7,
                        "source": {
                            "url": "/component/appmixer/constantContact/core/ListTags?outPort=out",
                            "data": {
                                "transform": "./ListTags#tagsToSelectArray"
                            }
                        }
                    },
                    "create_source": {
                        "type": "select",
                        "tooltip": "Source of the create operation.",
                        "label": "Create Source",
                        "options": [
                            {
                                "label": "Account",
                                "value": "Account"
                            },
                            {
                                "label": "Contact",
                                "value": "Contact"
                            }
                        ],
                        "index": 8
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Contact ID",
                    "value": "contact_id",
                    "schema": {
                        "type": "string",
                        "example": "1618ae62-4752-11e9-9c8a-fa163e6b01c1"
                    }
                },
                {
                    "label": "Email Address",
                    "value": "email_address",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "address": {
                                "type": "string",
                                "title": "Email Address.Address"
                            },
                            "permission_to_send": {
                                "type": "string",
                                "title": "Email Address.Permission To Send"
                            }
                        },
                        "example": {
                            "address": "sarah.johnson@example.com",
                            "permission_to_send": "explicit"
                        }
                    }
                },
                {
                    "label": "First Name",
                    "value": "first_name",
                    "schema": {
                        "type": "string",
                        "example": "Sarah"
                    }
                },
                {
                    "label": "Last Name",
                    "value": "last_name",
                    "schema": {
                        "type": "string",
                        "example": "Johnson"
                    }
                },
                {
                    "label": "Job Title",
                    "value": "job_title",
                    "schema": {
                        "type": "string",
                        "example": "Marketing Manager"
                    }
                },
                {
                    "label": "Company Name",
                    "value": "company_name",
                    "schema": {
                        "type": "string",
                        "example": "Acme Inc"
                    }
                },
                {
                    "label": "Create Source",
                    "value": "create_source",
                    "schema": {
                        "type": "string",
                        "example": "Account"
                    }
                },
                {
                    "label": "Birthday Month",
                    "value": "birthday_month",
                    "schema": {
                        "type": "number",
                        "example": 11
                    }
                },
                {
                    "label": "Birthday Day",
                    "value": "birthday_day",
                    "schema": {
                        "type": "number",
                        "example": 24
                    }
                },
                {
                    "label": "Anniversary",
                    "value": "anniversary",
                    "schema": {
                        "type": "string",
                        "example": "2006-11-15"
                    }
                },
                {
                    "label": "Custom Fields",
                    "value": "custom_fields",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "custom_field_id": {
                                    "type": "string",
                                    "title": "Custom Fields.Custom Field Id"
                                },
                                "value": {
                                    "type": "string",
                                    "title": "Custom Fields.Value"
                                },
                                "choice_ids": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    },
                                    "title": "Custom Fields.Choice Ids"
                                }
                            }
                        },
                        "example": [
                            {
                                "custom_field_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                                "value": "Gold Tier",
                                "choice_ids": ["c1d2e3f4-a5b6-7890-cdef-ab1234567890"]
                            }
                        ]
                    }
                },
                {
                    "label": "Phone Numbers",
                    "value": "phone_numbers",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "phone_number": {
                                    "type": "string",
                                    "title": "Phone Numbers.Phone Number"
                                },
                                "kind": {
                                    "type": "string",
                                    "title": "Phone Numbers.Kind"
                                }
                            }
                        },
                        "example": [
                            {
                                "phone_number": "+15551234567",
                                "kind": "home"
                            }
                        ]
                    }
                },
                {
                    "label": "Street Addresses",
                    "value": "street_addresses",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "kind": {
                                    "type": "string",
                                    "title": "Street Addresses.Kind"
                                },
                                "street": {
                                    "type": "string",
                                    "title": "Street Addresses.Street"
                                },
                                "city": {
                                    "type": "string",
                                    "title": "Street Addresses.City"
                                },
                                "state": {
                                    "type": "string",
                                    "title": "Street Addresses.State"
                                },
                                "postal_code": {
                                    "type": "string",
                                    "title": "Street Addresses.Postal Code"
                                },
                                "country": {
                                    "type": "string",
                                    "title": "Street Addresses.Country"
                                }
                            }
                        },
                        "example": [
                            {
                                "kind": "home",
                                "street": "123 Elm Street",
                                "city": "Austin",
                                "state": "TX",
                                "postal_code": "78701",
                                "country": "US"
                            }
                        ]
                    }
                },
                {
                    "label": "List Memberships",
                    "value": "list_memberships",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "07936f78-662a-11eb-af0a-fa163e56c9b0"
                        ]
                    }
                },
                {
                    "label": "Taggings",
                    "value": "taggings",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "3a2b1c0d-4e5f-6a7b-8c9d-0e1f2a3b4c5d"
                        ]
                    }
                },
                {
                    "label": "Notes",
                    "value": "notes",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "note_id": {
                                    "type": "string",
                                    "title": "Notes.Note Id"
                                },
                                "created_at": {
                                    "type": "string",
                                    "title": "Notes.Created At"
                                },
                                "content": {
                                    "type": "string",
                                    "title": "Notes.Content"
                                }
                            }
                        },
                        "example": [
                            {
                                "note_id": "d4e5f6a7-b8c9-0123-d456-e78901234567",
                                "created_at": "2026-01-15T10:30:00Z",
                                "content": "Spoke with contact about upgrading subscription plan."
                            }
                        ]
                    }
                },
                {
                    "label": "Sms Channel",
                    "value": "sms_channel",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "full_sms_address": {
                                "type": "string",
                                "title": "Sms Channel.Full Sms Address"
                            },
                            "sms_channel_consents": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "sms_consent_permission": {
                                            "type": "string",
                                            "title": "Sms Channel.Sms Channel Consents.Sms Consent Permission"
                                        },
                                        "consent_type": {
                                            "type": "string",
                                            "title": "Sms Channel.Sms Channel Consents.Consent Type"
                                        },
                                        "consent_medium_details": {
                                            "type": "string",
                                            "title": "Sms Channel.Sms Channel Consents.Consent Medium Details"
                                        }
                                    }
                                },
                                "title": "Sms Channel.Sms Channel Consents"
                            }
                        },
                        "example": {
                            "full_sms_address": "+15559876543",
                            "sms_channel_consents": [
                                {
                                    "sms_consent_permission": "explicit",
                                    "consent_type": "promotional",
                                    "consent_medium_details": "Web form opt-in"
                                }
                            ]
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}