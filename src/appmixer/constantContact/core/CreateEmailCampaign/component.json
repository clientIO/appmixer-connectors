{
    "name": "appmixer.constantContact.core.CreateEmailCampaign",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new email campaign in Constant Contact.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:constantContact"
    },
    "quota": {
        "manager": "appmixer:constantContact",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "subject": {
                        "type": "string"
                    },
                    "fromName": {
                        "type": "string"
                    },
                    "fromEmail": {
                        "type": "string"
                    },
                    "replyToEmail": {
                        "type": "string"
                    },
                    "htmlContent": {
                        "type": "string"
                    },
                    "preheader": {
                        "type": "string"
                    },
                    "addressLine1": {
                        "type": "string"
                    },
                    "addressLine2": {
                        "type": "string"
                    },
                    "addressLine3": {
                        "type": "string"
                    },
                    "addressOptional": {
                        "type": "string"
                    },
                    "city": {
                        "type": "string"
                    },
                    "stateCode": {
                        "type": "string"
                    },
                    "stateNonUsName": {
                        "type": "string"
                    },
                    "postalCode": {
                        "type": "string"
                    },
                    "countryCode": {
                        "type": "string"
                    },
                    "organizationName": {
                        "type": "string"
                    }
                },
                "required": [
                    "name",
                    "subject", 
                    "fromName",
                    "fromEmail",
                    "replyToEmail",
                    "htmlContent"
                ]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "index": 1,
                        "label": "Campaign Name",
                        "tooltip": "Name for the campaign"
                    },
                    "subject": {
                        "type": "text",
                        "index": 2,
                        "label": "Subject Line",
                        "tooltip": "Email subject line"
                    },
                    "fromName": {
                        "type": "text",
                        "index": 3,
                        "label": "From Name",
                        "tooltip": "Sender's display name"
                    },
                    "fromEmail": {
                        "type": "text",
                        "index": 4,
                        "label": "From Email",
                        "tooltip": "Sender's email address"
                    },
                    "replyToEmail": {
                        "type": "text",
                        "index": 5,
                        "label": "Reply-To Email",
                        "tooltip": "Reply-to email address"
                    },
                    "htmlContent": {
                        "type": "textarea",
                        "index": 6,
                        "label": "HTML Content",
                        "tooltip": "HTML body content"
                    },
                    "preheader": {
                        "type": "text",
                        "index": 7,
                        "label": "Preheader",
                        "tooltip": "Short summary that follows the subject line in the email client"
                    },
                    "addressLine1": {
                        "type": "text",
                        "index": 8,
                        "label": "Address Line 1",
                        "tooltip": "First line of physical address for the footer"
                    },
                    "addressLine2": {
                        "type": "text",
                        "index": 9,
                        "label": "Address Line 2",
                        "tooltip": "Second line of physical address for the footer"
                    },
                    "addressLine3": {
                        "type": "text",
                        "index": 10,
                        "label": "Address Line 3",
                        "tooltip": "Third line of physical address for the footer"
                    },
                    "addressOptional": {
                        "type": "text",
                        "index": 11,
                        "label": "Additional Address Info",
                        "tooltip": "Optional additional address information for the footer"
                    },
                    "city": {
                        "type": "text",
                        "index": 12,
                        "label": "City",
                        "tooltip": "City name"
                    },
                    "stateCode": {
                        "type": "text",
                        "index": 13,
                        "label": "State Code",
                        "tooltip": "State code (e.g., CA, NY, MA)"
                    },
                    "stateNonUsName": {
                        "type": "text",
                        "index": 14,
                        "label": "State/Province (Non-US)",
                        "tooltip": "State or province name for non-US addresses"
                    },
                    "postalCode": {
                        "type": "text",
                        "index": 15,
                        "label": "Postal Code",
                        "tooltip": "ZIP code or postal code"
                    },
                    "countryCode": {
                        "type": "text",
                        "index": 16,
                        "label": "Country Code",
                        "tooltip": "Country code (e.g., US, CA, GB)"
                    },
                    "organizationName": {
                        "type": "text",
                        "index": 17,
                        "label": "Organization Name",
                        "tooltip": "Name of the organization"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Campaign Activities",
                    "value": "campaign_activities",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "campaign_activity_id": {
                                    "type": "string",
                                    "title": "Campaign Activities.Campaign Activity Id",
                                    "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
                                },
                                "role": {
                                    "type": "string",
                                    "title": "Campaign Activities.Role",
                                    "example": "primary_email"
                                }
                            }
                        },
                        "example": [
                            {
                                "campaign_activity_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                                "role": "primary_email"
                            }
                        ]
                    }
                },
                {
                    "label": "Campaign Id",
                    "value": "campaign_id",
                    "schema": {
                        "type": "string",
                        "example": "b3c4d5e6-f7a8-9012-bcde-f12345678901"
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "string",
                        "example": "2026-01-15T10:30:00Z"
                    }
                },
                {
                    "label": "Current Status",
                    "value": "current_status",
                    "schema": {
                        "type": "string",
                        "example": "DRAFT"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Spring Newsletter 2026"
                    }
                },
                {
                    "label": "Type",
                    "value": "type",
                    "schema": {
                        "type": "string",
                        "example": "NEWSLETTER"
                    }
                },
                {
                    "label": "Type Code",
                    "value": "type_code",
                    "schema": {
                        "type": "number",
                        "example": 10
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updated_at",
                    "schema": {
                        "type": "string",
                        "example": "2026-01-15T10:30:00Z"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}