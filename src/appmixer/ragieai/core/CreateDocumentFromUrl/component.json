{
    "name": "appmixer.ragieai.core.CreateDocumentFromUrl",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Creates a new document in RagieAI from a URL.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:ragieai"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "required": [
                    "url"
                ],
                "properties": {
                    "url": {
                        "type": "string",
                        "description": "The URL to fetch the document from"
                    },
                    "name": {
                        "type": "string",
                        "description": "Optional name for the document. If not provided, will be derived from URL"
                    },
                    "metadata": {
                        "type": "string",
                        "description": "Optional metadata for the document"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "url": {
                        "type": "text",
                        "index": 1,
                        "label": "Document URL",
                        "tooltip": "The URL to fetch the document from"
                    },
                    "name": {
                        "type": "text",
                        "index": 2,
                        "label": "Document Name",
                        "tooltip": "Optional name for the document. If not provided, will be derived from URL"
                    },
                    "metadata": {
                        "type": "textarea",
                        "index": 3,
                        "label": "Metadata",
                        "tooltip": "Optional metadata for the document (JSON object)"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Document ID",
                        "example": "3fa2b8c1-6d4e-4f7a-9b21-8c5e0d7a4f12"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Q3 Sales Report.pdf"
                    },
                    "url": {
                        "type": "string",
                        "title": "URL",
                        "example": "https://example.com/reports/q3-sales-report.pdf"
                    },
                    "status": {
                        "type": "string",
                        "title": "Status",
                        "example": "pending"
                    },
                    "created_at": {
                        "type": "string",
                        "title": "Created At",
                        "example": "2024-05-10T08:30:00.123456Z"
                    },
                    "metadata": {
                        "type": "object",
                        "title": "Metadata",
                        "example": {
                            "department": "sales",
                            "year": 2024
                        }
                    }
                }
            },
            "options": [
                {
                    "label": "Document ID",
                    "value": "id"
                },
                {
                    "label": "Name",
                    "value": "name"
                },
                {
                    "label": "URL",
                    "value": "url"
                },
                {
                    "label": "Status",
                    "value": "status"
                },
                {
                    "label": "Created At",
                    "value": "created_at"
                },
                {
                    "label": "Metadata",
                    "value": "metadata"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
