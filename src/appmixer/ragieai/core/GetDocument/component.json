{
    "name": "appmixer.ragieai.core.GetDocument",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieves a document from RagieAI by ID.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:ragieai"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "required": [
                    "documentId"
                ],
                "properties": {
                    "documentId": {
                        "type": "string",
                        "description": "The ID of the document to retrieve"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "documentId": {
                        "type": "text",
                        "index": 0,
                        "label": "Document ID",
                        "tooltip": "The ID of the document to retrieve"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Document ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "3fa2b8c1-6d4e-4f7a-9b21-8c5e0d7a4f12"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Q3 Sales Report.pdf"
                    }
                },
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "string",
                        "example": "ready"
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00.123456Z"
                    }
                },
                {
                    "label": "Metadata",
                    "value": "metadata",
                    "schema": {
                        "type": "object",
                        "example": {
                            "department": "sales",
                            "year": 2026
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
