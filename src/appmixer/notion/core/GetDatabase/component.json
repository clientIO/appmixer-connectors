{
    "name": "appmixer.notion.core.GetDatabase",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Gets a selected Database using its ID.",
    "auth": {
        "service": "appmixer:notion"
    },
    "quota": {
        "manager": "appmixer:notion",
        "resources": "general",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "private": false,
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "databaseId": {
                        "type": "string"
                    }
                },
                "required": [
                    "databaseId"
                ]
            },
            "inspector": {
                "inputs": {
                    "databaseId": {
                        "type": "text",
                        "index": 1,
                        "label": "Database ID",
                        "tooltip": "Enter the ID of the database that you want to get."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Object",
                    "value": "object",
                    "schema": {
                        "type": "string",
                        "example": "database"
                    }
                },
                {
                    "label": "Database ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "d4e5f6a7-b8c9-0123-defa-234567890123"
                    }
                },
                {
                    "label": "Cover",
                    "value": "cover",
                    "schema": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "example": {
                            "type": "external",
                            "external": {
                                "url": "https://images.unsplash.com/photo-1506744038136-46273834b3fb"
                            }
                        }
                    }
                },
                {
                    "label": "Icon",
                    "value": "icon",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "type": {
                                "title": "Icon.Type",
                                "type": "string"
                            },
                            "external": {
                                "title": "Icon.External",
                                "type": "object",
                                "properties": {
                                    "url": {
                                        "title": "Icon.External.URL",
                                        "type": "string"
                                    }
                                }
                            }
                        },
                        "example": {
                            "type": "emoji",
                            "emoji": "📋"
                        }
                    }
                },
                {
                    "label": "Created Time",
                    "value": "created_time",
                    "schema": {
                        "type": "string",
                        "example": "2025-11-01T08:00:00.000Z"
                    }
                },
                {
                    "label": "Created By",
                    "value": "created_by",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "object": {
                                "title": "Created By.Object",
                                "type": "string"
                            },
                            "id": {
                                "title": "Created By.ID",
                                "type": "string"
                            }
                        },
                        "example": {
                            "object": "user",
                            "id": "c2f20311-9e54-4d11-8c79-7398424ae41e"
                        }
                    }
                },
                {
                    "label": "Last Edited By",
                    "value": "last_edited_by",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "object": {
                                "title": "Last Edited By.Object",
                                "type": "string"
                            },
                            "id": {
                                "title": "Last Edited By.ID",
                                "type": "string"
                            }
                        },
                        "example": {
                            "object": "user",
                            "id": "c2f20311-9e54-4d11-8c79-7398424ae41e"
                        }
                    }
                },
                {
                    "label": "Last Edited Time",
                    "value": "last_edited_time",
                    "schema": {
                        "type": "string",
                        "example": "2026-01-15T10:30:00.000Z"
                    }
                },
                {
                    "label": "Title",
                    "value": "title",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "title": "Title.Type",
                                    "type": "string"
                                },
                                "text": {
                                    "title": "Title.Text",
                                    "type": "object",
                                    "properties": {
                                        "content": {
                                            "title": "Title.Text.Content",
                                            "type": "string"
                                        },
                                        "link": {
                                            "title": "Title.Text.Link",
                                            "type": "string"
                                        }
                                    }
                                },
                                "annotations": {
                                    "title": "Title.Annotations",
                                    "type": "object",
                                    "properties": {
                                        "bold": {
                                            "title": "Title.Annotations.Bold",
                                            "type": "boolean"
                                        },
                                        "italic": {
                                            "title": "Title.Annotations.Italic",
                                            "type": "boolean"
                                        },
                                        "strikethrough": {
                                            "title": "Title.Annotations.Strikethrough",
                                            "type": "boolean"
                                        },
                                        "underline": {
                                            "title": "Title.Annotations.Underline",
                                            "type": "boolean"
                                        },
                                        "code": {
                                            "title": "Title.Annotations.Code",
                                            "type": "boolean"
                                        },
                                        "color": {
                                            "title": "Title.Annotations.Color",
                                            "type": "string"
                                        }
                                    }
                                },
                                "plain_text": {
                                    "title": "Title.Plain_Text",
                                    "type": "string"
                                },
                                "href": {
                                    "title": "Title.Href",
                                    "type": "string"
                                }
                            }
                        },
                        "example": "Project Tracker"
                    }
                },
                {
                    "label": "Description",
                    "value": "description",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object"
                        },
                        "example": [
                            {
                                "type": "text",
                                "text": {
                                    "content": "All active projects",
                                    "link": null
                                },
                                "plain_text": "All active projects",
                                "href": null
                            }
                        ]
                    }
                },
                {
                    "label": "Is Inline",
                    "value": "is_inline",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
