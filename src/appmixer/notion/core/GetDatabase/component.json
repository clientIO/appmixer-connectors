                                                            "title": "Properties.Tags.Multi_Select.Options.Description",
                                                            "type": "string"
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            },
                            "created_by": {
                                "title": "Properties.Created_By",
                                "type": "object",
                                "properties": {
                                    "id": {
                                        "title": "Properties.Created_By.ID",
                                        "type": "string"
                                    },
                                    "name": {
                                        "title": "Properties.Created_By.Name",
                                        "type": "string"
                                    },
                                    "type": {
                                        "title": "Properties.Created_By.Type",
                                        "type": "string"
