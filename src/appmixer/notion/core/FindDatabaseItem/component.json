{
    "name": "appmixer.notion.core.FindDatabaseItem",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Find an item in a specified Notion database.",
    "auth": {
        "service": "appmixer:notion"
    },
    "private": false,
    "quota": {
        "manager": "appmixer:notion",
        "resources": "general",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "properties": {
        "schema": {
            "properties": {
                "databaseId": {
                    "type": "string"
                }
            },
            "required": [
                "databaseId"
            ]
        },
        "inspector": {
            "inputs": {
                "databaseId": {
                    "type": "text",
                    "label": "Database ID",
                    "index": 1,
                    "tooltip": "Select a database from the picker or enter a Database ID.",
                    "source": {
                        "url": "/component/appmixer/notion/core/ListDatabases?outPort=out",
                        "data": {
                            "properties": {
                                "sendWholeArray": true
                            },
                            "transform": "./ListDatabases#databaseToSelectArray"
                        }
                    }
                }
            }
        }
    },
    "inPorts": [
        {
            "name": "in",
            "source": {
                "url": "/component/appmixer/notion/core/FindDatabaseItem?outPort=out",
                "data": {
                    "properties": {
                        "generateInspector": true,
                        "databaseId": "properties/databaseId"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Object",
                    "value": "object",
                    "schema": {
                        "type": "string",
                        "example": "page"
                    }
                },
                {
                    "label": "Object ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "c3d4e5f6-a7b8-9012-cdef-123456789012"
                    }
                },
                {
                    "label": "Created Time",
                    "value": "created_time",
                    "schema": {
                        "type": "string",
                        "example": "2026-01-10T08:00:00.000Z"
                    }
                },
                {
                    "label": "Last Edited Time",
                    "value": "last_edited_time",
                    "schema": {
                        "type": "string",
                        "example": "2026-01-14T16:30:00.000Z"
                    }
                },
                {
                    "label": "Created By",
                    "value": "created_by",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "object": {
                                "title": "Created By.Object",
                                "type": "string"
                            },
                            "id": {
                                "title": "Created By.ID",
                                "type": "string"
                            }
                        },
                        "example": {
                            "object": "user",
                            "id": "8a2f4c6e-1b3d-4e5f-a7b9-0c1d2e3f4a5b"
                        }
                    }
                },
                {
                    "label": "Last Edited By",
                    "value": "last_edited_by",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "object": {
                                "title": "Last Edited By.Object",
                                "type": "string"
                            },
                            "id": {
                                "title": "Last Edited By.ID",
                                "type": "string"
                            }
                        },
                        "example": {
                            "object": "user",
                            "id": "8a2f4c6e-1b3d-4e5f-a7b9-0c1d2e3f4a5b"
                        }
                    }
                },
                {
                    "label": "Cover",
                    "value": "cover",
                    "schema": {
                        "type": "string",
                        "example": null
                    }
                },
                {
                    "label": "Icon",
                    "value": "icon",
                    "schema": {
                        "type": "string",
                        "example": null
                    }
                },
                {
                    "label": "Parent",
                    "value": "parent",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "type": {
                                "title": "Parent.Type",
                                "type": "string"
                            },
                            "database_id": {
                                "title": "Parent.Database ID",
                                "type": "string"
                            }
                        },
                        "example": {
                            "type": "database_id",
                            "database_id": "d9824bdc-8445-4327-be8b-5b47500af6ce"
                        }
                    }
                },
                {
                    "label": "Archived",
                    "value": "archived",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "In Trash",
                    "value": "in_trash",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Properties.Status",
                    "value": "properties.status",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "title": "Properties.Status.ID",
                                "type": "string"
                            },
                            "name": {
                                "title": "Properties.Status.Name",
                                "type": "string"
                            },
                            "color": {
                                "title": "Properties.Status.Color",
                                "type": "string"
                            }
                        },
                        "example": {
                            "id": "86ddb6ec-0627-47f8-800d-b65afd28be13",
                            "name": "In progress",
                            "color": "blue"
                        }
                    }
                },
                {
                    "label": "Properties.Phone",
                    "value": "properties.phone_number",
                    "schema": {
                        "type": "string",
                        "example": "555-0123"
                    }
                },
                {
                    "label": "Properties.Text",
                    "value": "properties.rich_text",
                    "schema": {
                        "type": "string",
                        "example": "Follow up with the client next week"
                    }
                },
                {
                    "label": "Properties.Email",
                    "value": "properties.email",
                    "schema": {
                        "type": "string",
                        "example": "jane.doe@example.com"
                    }
                },
                {
                    "label": "Properties.URL",
                    "value": "properties.url",
                    "schema": {
                        "type": "string",
                        "example": "https://example.com/brief"
                    }
                },
                {
                    "label": "Properties.Files",
                    "value": "properties.files",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "title": "Files Name",
                                    "type": "string"
                                },
                                "external.url": {
                                    "title": "Files External URL",
                                    "type": "string"
                                }
                            }
                        },
                        "example": [
                            {
                                "name": "brief.pdf",
                                "type": "external",
                                "external": {
                                    "url": "https://example.com/brief.pdf"
                                }
                            }
                        ]
                    }
                },
                {
                    "label": "Properties.Multi-select",
                    "value": "properties.multi_select",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "title": "Multi-select Name",
                                    "type": "string"
                                },
                                "color": {
                                    "title": "Multi-select Color",
                                    "type": "string"
                                }
                            }
                        },
                        "example": [
                            {
                                "name": "Marketing",
                                "color": "purple"
                            }
                        ]
                    }
                },
                {
                    "label": "Properties.Date",
                    "value": "properties.date",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "start": {
                                "title": "Date Start",
                                "type": "string"
                            },
                            "end": {
                                "title": "Date End",
                                "type": "string"
                            }
                        },
                        "example": {
                            "start": "2024-05-10",
                            "end": "2024-05-12"
                        }
                    }
                },
                {
                    "label": "Properties.Title",
                    "value": "properties.title",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "text.content": {
                                    "title": "Title Content",
                                    "type": "string"
                                }
                            }
                        },
                        "example": [
                            {
                                "type": "text",
                                "text": {
                                    "content": "Quarterly planning"
                                },
                                "plain_text": "Quarterly planning"
                            }
                        ]
                    }
                },
                {
                    "label": "URL",
                    "value": "url",
                    "schema": {
                        "type": "string",
                        "example": "https://www.notion.so/c3d4e5f6a7b89012cdef123456789012"
                    }
                }
            ]
        },
        {
            "name": "notFound"
        }
    ]
}
