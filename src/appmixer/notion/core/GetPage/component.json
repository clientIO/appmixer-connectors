{
    "name": "appmixer.notion.core.GetPage",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Gets a page or a database item using its ID.",
    "auth": {
        "service": "appmixer:notion"
    },
    "quota": {
        "manager": "appmixer:notion",
        "resources": "general",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "private": false,
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "pageId": {
                        "type": "string"
                    }
                },
                "required": [
                    "pageId"
                ]
            },
            "inspector": {
                "inputs": {
                    "pageId": {
                        "type": "text",
                        "index": 1,
                        "label": "Page ID",
                        "tooltip": "Enter the ID of the page that you want to get."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Object",
                    "value": "object",
                    "schema": {
                        "type": "string",
                        "example": "page"
                    }
                },
                {
                    "label": "Page ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "e5f6a7b8-c9d0-1234-efab-345678901234"
                    }
                },
                {
                    "label": "Created Time",
                    "value": "created_time",
                    "schema": {
                        "type": "string",
                        "example": "2025-12-20T08:00:00.000Z"
                    }
                },
                {
                    "label": "Last Edited Time",
                    "value": "last_edited_time",
                    "schema": {
                        "type": "string",
                        "example": "2026-01-15T10:30:00.000Z"
                    }
                },
                {
                    "label": "Created By",
                    "value": "created_by",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "object": {
                                "title": "Created By.Object",
                                "type": "string"
                            },
                            "id": {
                                "title": "Created By.ID",
                                "type": "string"
                            }
                        },
                        "example": {
                            "object": "user",
                            "id": "c2f20311-9e54-4d11-8c79-7398424ae41e"
                        }
                    }
                },
                {
                    "label": "Last Edited By",
                    "value": "last_edited_by",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "object": {
                                "title": "Last Edited By.Object",
                                "type": "string"
                            },
                            "id": {
                                "title": "Last Edited By.ID",
                                "type": "string"
                            }
                        },
                        "example": {
                            "object": "user",
                            "id": "c2f20311-9e54-4d11-8c79-7398424ae41e"
                        }
                    }
                },
                {
                    "label": "Cover",
                    "value": "cover",
                    "schema": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "example": {
                            "type": "external",
                            "external": {
                                "url": "https://images.unsplash.com/photo-1506744038136-46273834b3fb"
                            }
                        }
                    }
                },
                {
                    "label": "Icon",
                    "value": "icon",
                    "schema": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "example": {
                            "type": "emoji",
                            "emoji": "🚀"
                        }
                    }
                },
                {
                    "label": "Parent",
