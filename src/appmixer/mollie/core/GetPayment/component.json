{
    "name": "appmixer.mollie.core.GetPayment",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieves a specific payment by its payment ID. Essential for checking payment status and details.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:mollie"
    },
    "quota": {
        "manager": "appmixer:mollie",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "paymentId": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "paymentId": {
                        "type": "text",
                        "tooltip": "The ID of the payment to retrieve (e.g., tr_7UhSN1zuXS).",
                        "label": "Payment Id",
                        "index": 0
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Resource",
                    "value": "resource",
                    "schema": {
                        "type": "string",
                        "example": "payment"
                    }
                },
                {
                    "label": "Payment ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "tr_7UhSN1zuXS"
                    }
                },
                {
                    "label": "Mode",
                    "value": "mode",
                    "schema": {
                        "type": "string",
                        "example": "live"
                    }
                },
                {
                    "label": "Created At",
                    "value": "createdAt",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00.0Z"
                    }
                },
                {
                    "label": "Amount",
                    "value": "amount",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "value": {
                                "type": "string",
                                "title": "Amount.Value"
                            },
                            "currency": {
                                "type": "string",
                                "title": "Amount.Currency"
                            }
                        },
                        "example": {
                            "value": "25.00",
                            "currency": "EUR"
                        }
                    }
                },
                {
                    "label": "Description",
                    "value": "description",
                    "schema": {
                        "type": "string",
                        "example": "Order ord_8wmqcHMN4U"
                    }
                },
                {
                    "label": "Method",
                    "value": "method",
                    "schema": {
                        "type": "string",
                        "example": "ideal"
                    }
                },
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "string",
                        "example": "paid"
                    }
                },
                {
                    "label": "Paid At",
                    "value": "paidAt",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:32:14.0Z"
                    }
                },
                {
                    "label": "Is Cancelable",
                    "value": "isCancelable",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Metadata",
                    "value": "metadata",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "orderId": {
                                "type": "string",
                                "title": "Metadata.Order Id"
                            }
                        },
                        "example": {
                            "orderId": "ord_8wmqcHMN4U"
                        }
                    }
                },
                {
                    "label": "Locale",
                    "value": "locale",
                    "schema": {
                        "type": "string",
                        "example": "nl_NL"
                    }
                },
                {
                    "label": "Country Code",
                    "value": "countryCode",
                    "schema": {
                        "type": "string",
                        "example": "NL"
                    }
                },
                {
                    "label": "Profile Id",
                    "value": "profileId",
                    "schema": {
                        "type": "string",
                        "example": "pfl_QkEhN94Ba"
                    }
                },
                {
                    "label": "Sequence Type",
                    "value": "sequenceType",
                    "schema": {
                        "type": "string",
                        "example": "oneoff"
                    }
                },
                {
                    "label": "Redirect Url",
                    "value": "redirectUrl",
                    "schema": {
                        "type": "string",
                        "example": "https://webshop.example.org/order/ord_8wmqcHMN4U/"
                    }
                },
                {
                    "label": "Webhook Url",
                    "value": "webhookUrl",
                    "schema": {
                        "type": "string",
                        "example": "https://webshop.example.org/payments/webhook/"
                    }
                },
                {
                    "label": "Links",
                    "value": "_links",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "self": {
                                "type": "object",
                                "properties": {
                                    "href": {
                                        "type": "string",
                                        "title": "Links.Self.Href"
                                    },
                                    "type": {
                                        "type": "string",
                                        "title": "Links.Self.Type"
                                    }
                                },
                                "title": "Links.Self"
                            }
                        },
                        "example": {
                            "self": {
                                "href": "https://api.mollie.com/v2/payments/tr_7UhSN1zuXS",
                                "type": "application/hal+json"
                            }
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}