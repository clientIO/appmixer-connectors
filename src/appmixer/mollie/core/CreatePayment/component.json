{
    "name": "appmixer.mollie.core.CreatePayment",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Creates a new payment.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:mollie"
    },
    "quota": {
        "manager": "appmixer:mollie",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "description": {
                        "type": "string"
                    },
                    "currency": {
                        "type": "string"
                    },
                    "amount": {
                        "type": "string"
                    },
                    "redirectUrl": {
                        "type": "string"
                    },
                    "cancelUrl": {
                        "type": "string"
                    },
                    "webhookUrl": {
                        "type": "string"
                    },
                    "locale": {
                        "type": "string",
                        "enum": ["en_US", "en_GB", "nl_NL", "nl_BE", "de_DE", "de_AT", "de_CH", "fr_FR", "fr_BE", "es_ES", "ca_ES", "pt_PT", "it_IT", "nb_NO", "sv_SE", "fi_FI", "da_DK", "is_IS", "hu_HU", "pl_PL", "lv_LV", "lt_LT"]
                    },
                    "method": {
                        "type": "string",
                        "enum": ["alma", "applepay", "bacs", "bancomatpay", "bancontact", "banktransfer", "belfius", "billie", "bizum", "blik", "creditcard", "directdebit", "eps", "giftcard", "ideal", "in3", "kbc", "klarna", "mbway", "mobilepay", "multibanco", "mybank", "paybybank", "payconiq", "paypal", "paysafecard", "pointofsale", "przelewy24", "riverty", "satispay", "swish", "trustly", "twint", "vipps", "voucher"]
                    },
                    "metadata": {
                        "type": "string"
                    }
                },
                "required": [
                    "description",
                    "amount",
                    "currency",
                    "redirectUrl"
                ]
            },
            "inspector": {
                "inputs": {
                    "description": {
                        "type": "text",
                        "label": "Description",
                        "tooltip": "The description of the payment shown to your customer on their card or bank statement. Maximum 255 characters.",
                        "index": 1
                    },
                    "amount": {
                        "type": "text",
                        "label": "Amount",
                        "tooltip": "The payment amount as a decimal string, e.g. '10.00'",
                        "index": 2
                    },
                    "currency": {
                        "type": "text",
                        "label": "Currency",
                        "tooltip": "Three-character ISO 4217 currency code, e.g. 'EUR', 'USD'",
                        "index": 3
                    },
                    "redirectUrl": {
                        "type": "text",
                        "label": "Redirect URL",
                        "tooltip": "The URL your customer will be redirected to after completing the payment",
                        "index": 4
                    },
                    "cancelUrl": {
                        "type": "text",
                        "label": "Cancel URL",
                        "tooltip": "The URL your customer will be redirected to when they cancel the payment",
                        "index": 5
                    },
                    "webhookUrl": {
                        "type": "text",
                        "label": "Webhook URL",
                        "tooltip": "The webhook URL where payment status updates will be sent",
                        "index": 6
                    },
                    "locale": {
                        "type": "select",
                        "label": "Locale",
                        "tooltip": "The language to be used in the hosted payment pages. Setting this improves conversion rates.",
                        "index": 7,
                        "options": [
                            { "clearItem": true, "content": "-- Clear selection --" },
                            { "label": "English (US)", "value": "en_US" },
                            { "label": "English (GB)", "value": "en_GB" },
                            { "label": "Dutch (NL)", "value": "nl_NL" },
                            { "label": "Dutch (BE)", "value": "nl_BE" },
                            { "label": "German (DE)", "value": "de_DE" },
                            { "label": "German (AT)", "value": "de_AT" },
                            { "label": "German (CH)", "value": "de_CH" },
                            { "label": "French (FR)", "value": "fr_FR" },
                            { "label": "French (BE)", "value": "fr_BE" },
                            { "label": "Spanish (ES)", "value": "es_ES" },
                            { "label": "Catalan (ES)", "value": "ca_ES" },
                            { "label": "Portuguese (PT)", "value": "pt_PT" },
                            { "label": "Italian (IT)", "value": "it_IT" },
                            { "label": "Norwegian (NO)", "value": "nb_NO" },
                            { "label": "Swedish (SE)", "value": "sv_SE" },
                            { "label": "Finnish (FI)", "value": "fi_FI" },
                            { "label": "Danish (DK)", "value": "da_DK" },
                            { "label": "Icelandic (IS)", "value": "is_IS" },
                            { "label": "Hungarian (HU)", "value": "hu_HU" },
                            { "label": "Polish (PL)", "value": "pl_PL" },
                            { "label": "Latvian (LV)", "value": "lv_LV" },
                            { "label": "Lithuanian (LT)", "value": "lt_LT" }
                        ]
                    },
                    "method": {
                        "type": "select",
                        "label": "Payment Method",
                        "tooltip": "Choose a specific payment method to skip the payment method selection screen, or leave empty to show all available methods",
                        "index": 8,
                        "options": [
                            { "clearItem": true, "content": "-- Clear selection --" },
                            { "label": "Credit Card", "value": "creditcard" },
                            { "label": "PayPal", "value": "paypal" },
                            { "label": "iDEAL", "value": "ideal" },
                            { "label": "Bancontact", "value": "bancontact" },
                            { "label": "Bank Transfer", "value": "banktransfer" },
                            { "label": "SEPA Direct Debit", "value": "directdebit" },
                            { "label": "Apple Pay", "value": "applepay" },
                            { "label": "Klarna Pay Later", "value": "klarna" },
                            { "label": "Sofort", "value": "directdebit" },
                            { "label": "Gift Card", "value": "giftcard" },
                            { "label": "KBC/CBC Payment Button", "value": "kbc" },
                            { "label": "Belfius Pay Button", "value": "belfius" }
                        ]
                    },
                    "metadata": {
                        "type": "text",
                        "label": "Metadata",
                        "tooltip": "Custom data as JSON string that will be saved alongside the payment (optional, max ~1kB)",
                        "index": 9
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Resource",
                    "value": "resource",
                    "schema": {
                        "type": "string",
                        "example": "payment"
                    }
                },
                {
                    "label": "Payment ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "tr_7UhSN1zuXS"
                    }
                },
                {
                    "label": "Mode",
                    "value": "mode",
                    "schema": {
                        "type": "string",
                        "example": "test"
                    }
                },
                {
                    "label": "Created At",
                    "value": "createdAt",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00.0Z"
                    }
                },
                {
                    "label": "Payment Amount",
                    "value": "amount",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "value": {
                                "type": "string",
                                "title": "Value"
                            },
                            "currency": {
                                "type": "string",
                                "title": "Currency"
                            }
                        },
                        "example": {
                            "value": "25.00",
                            "currency": "EUR"
                        }
                    }
                },
                {
                    "label": "Description",
                    "value": "description",
                    "schema": {
                        "type": "string",
                        "example": "Order #12345"
                    }
                },
                {
                    "label": "Method",
                    "value": "method",
                    "schema": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "Metadata",
                    "value": "metadata",
                    "schema": {
                        "type": "object",
                        "example": {
                            "orderId": "12345"
                        }
                    }
                },
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "string",
                        "example": "open"
                    }
                },
                {
                    "label": "Is Cancelable",
                    "value": "isCancelable",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Expires At",
                    "value": "expiresAt",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:45:00.0Z"
                    }
                },
                {
                    "label": "Checkout URL",
                    "value": "_links",
                    "schema": {
                        "type": "object",
                        "example": {
                            "self": {
                                "href": "https://api.mollie.com/v2/payments/tr_7UhSN1zuXS",
                                "type": "application/hal+json"
                            },
                            "checkout": {
                                "href": "https://www.mollie.com/checkout/select-method/7UhSN1zuXS",
                                "type": "text/html"
                            },
                            "dashboard": {
                                "href": "https://www.mollie.com/dashboard/org_12345678/payments/tr_7UhSN1zuXS",
                                "type": "text/html"
                            }
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}