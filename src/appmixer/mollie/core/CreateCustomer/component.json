{
    "name": "appmixer.mollie.core.CreateCustomer",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Creates a simple minimal representation of a customer. Required for managing customer accounts and recurring payments.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:mollie"
    },
    "quota": {
        "manager": "appmixer:mollie",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "locale": {
                        "type": "string",
                        "enum": [
                            "en_US", "en_GB", "nl_NL", "nl_BE", "de_DE", "de_AT", "de_CH", 
                            "fr_FR", "fr_BE", "es_ES", "ca_ES", "pt_PT", "it_IT", "nb_NO", 
                            "sv_SE", "fi_FI", "da_DK", "is_IS", "hu_HU", "pl_PL", "lv_LV", "lt_LT"
                        ]
                    },
                    "metadata": {
                        "type": "string"
                    }
                },
                "required": [

                ]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "tooltip": "Full name of the customer.",
                        "label": "Name",
                        "index": 0
                    },
                    "email": {
                        "type": "text",
                        "tooltip": "Email address of the customer.",
                        "label": "Email",
                        "index": 1
                    },
                    "locale": {
                        "type": "select",
                        "tooltip": "Customer locale.",
                        "label": "Locale",
                        "index": 2,
                        "options": [
                            { "clearItem": true, "content": "-- Clear selection --" },
                            { "label": "English (US)", "value": "en_US" },
                            { "label": "English (GB)", "value": "en_GB" },
                            { "label": "Dutch (NL)", "value": "nl_NL" },
                            { "label": "Dutch (BE)", "value": "nl_BE" },
                            { "label": "German (DE)", "value": "de_DE" },
                            { "label": "German (AT)", "value": "de_AT" },
                            { "label": "German (CH)", "value": "de_CH" },
                            { "label": "French (FR)", "value": "fr_FR" },
                            { "label": "French (BE)", "value": "fr_BE" },
                            { "label": "Spanish (ES)", "value": "es_ES" },
                            { "label": "Catalan (ES)", "value": "ca_ES" },
                            { "label": "Portuguese (PT)", "value": "pt_PT" },
                            { "label": "Italian (IT)", "value": "it_IT" },
                            { "label": "Norwegian (NO)", "value": "nb_NO" },
                            { "label": "Swedish (SE)", "value": "sv_SE" },
                            { "label": "Finnish (FI)", "value": "fi_FI" },
                            { "label": "Danish (DK)", "value": "da_DK" },
                            { "label": "Icelandic (IS)", "value": "is_IS" },
                            { "label": "Hungarian (HU)", "value": "hu_HU" },
                            { "label": "Polish (PL)", "value": "pl_PL" },
                            { "label": "Latvian (LV)", "value": "lv_LV" },
                            { "label": "Lithuanian (LT)", "value": "lt_LT" }
                        ]
                    },
                    "metadata": {
                        "type": "textarea",
                        "tooltip": "Arbitrary data you can attach to the customer. It can be a JSON object or a string.",
                        "label": "Metadata",
                        "index": 3
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Resource",
                    "value": "resource",
                    "schema": {
                        "type": "string",
                        "example": "customer"
                    }
                },
                {
                    "label": "Customer ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "cst_kEn1PlbG"
                    }
                },
                {
                    "label": "Mode",
                    "value": "mode",
                    "schema": {
                        "type": "string",
                        "example": "test"
                    }
                },
                {
                    "label": "Customer Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Customer A"
                    }
                },
                {
                    "label": "Customer Email",
                    "value": "email",
                    "schema": {
                        "type": "string",
                        "example": "customer@example.org"
                    }
                },
                {
                    "label": "Locale",
                    "value": "locale",
                    "schema": {
                        "type": "string",
                        "example": "nl_NL"
                    }
                },
                {
                    "label": "Metadata",
                    "value": "metadata",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "crmId": {
                                "type": "string",
                                "title": "Metadata.Crm ID"
                            }
                        },
                        "example": {
                            "crmId": "4830207"
                        }
                    }
                },
                {
                    "label": "Created At",
                    "value": "createdAt",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00.0Z"
                    }
                },
                {
                    "label": "Links",
                    "value": "_links",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "self": {
                                "type": "object",
                                "properties": {
                                    "href": {
                                        "type": "string",
                                        "title": "Links.Self.Href"
                                    },
                                    "type": {
                                        "type": "string",
                                        "title": "Links.Self.Type"
                                    }
                                },
                                "title": "Links.Self"
                            }
                        },
                        "example": {
                            "self": {
                                "href": "https://api.mollie.com/v2/customers/cst_kEn1PlbG",
                                "type": "application/hal+json"
                            }
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}