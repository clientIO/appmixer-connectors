{
    "name": "appmixer.mollie.core.GetCustomer",
    "description": "Retrieve a single customer by its ID. Essential for customer management workflows.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:mollie"
    },
    "quota": {
        "manager": "appmixer:mollie",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "customerId": {
                        "type": "string"
                    }
                },
                "required": [
                    "customerId"
                ]
            },
            "inspector": {
                "inputs": {
                    "customerId": {
                        "type": "text",
                        "label": "Customer ID",
                        "index": 0,
                        "tooltip": "The ID of the customer to retrieve (e.g., cst_4qqhO89gsT)."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Resource",
                    "value": "resource",
                    "schema": {
                        "type": "string",
                        "example": "customer"
                    }
                },
                {
                    "label": "Customer ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "cst_kEn1PlbG"
                    }
                },
                {
                    "label": "Mode",
                    "value": "mode",
                    "schema": {
                        "type": "string",
                        "example": "test"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Customer A"
                    }
                },
                {
                    "label": "Email",
                    "value": "email",
                    "schema": {
                        "type": "string",
                        "example": "customer@example.org"
                    }
                },
                {
                    "label": "Locale",
                    "value": "locale",
                    "schema": {
                        "type": "string",
                        "example": "nl_NL"
                    }
                },
                {
                    "label": "Metadata",
                    "value": "metadata",
                    "schema": {
                        "type": "object",
                        "example": {
                            "crmId": "4830207"
                        }
                    }
                },
                {
                    "label": "Created At",
                    "value": "createdAt",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00.0Z"
                    }
                },
                {
                    "label": "Links",
                    "value": "_links",
                    "schema": {
                        "type": "object",
                        "example": {
                            "self": {
                                "href": "https://api.mollie.com/v2/customers/cst_kEn1PlbG",
                                "type": "application/hal+json"
                            },
                            "dashboard": {
                                "href": "https://www.mollie.com/dashboard/org_12345678/customers/cst_kEn1PlbG",
                                "type": "text/html"
                            }
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}