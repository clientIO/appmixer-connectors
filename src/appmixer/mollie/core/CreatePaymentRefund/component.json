{
    "name": "appmixer.mollie.core.CreatePaymentRefund",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Creates a refund for a specific payment. Critical for handling returns and customer service.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:mollie"
    },
    "quota": {
        "manager": "appmixer:mollie",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "paymentId": {
                        "type": "string"
                    },
                    "amount_value": {
                        "type": "string"
                    },
                    "amount_currency": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "metadata": {
                        "type": "object"
                    }
                },
                "required": [
                    "paymentId"
                ]
            },
            "inspector": {
                "inputs": {
                    "paymentId": {
                        "type": "text",
                        "tooltip": "The ID of the original payment to refund (e.g., tr_7UhSN1zuXS).",
                        "label": "Payment ID",
                        "index": 0
                    },
                    "amount_value": {
                        "type": "text",
                        "tooltip": "Refund amount as a string with 2 decimals, e.g. \"5.00\". Optional - if not provided, the full payment amount will be refunded.",
                        "label": "Amount Value",
                        "index": 1
                    },
                    "amount_currency": {
                        "type": "text",
                        "tooltip": "ISO 4217 currency code of the refund amount (e.g., EUR, USD). Only required if specifying a custom amount.",
                        "label": "Amount Currency",
                        "index": 2
                    },
                    "description": {
                        "type": "text",
                        "tooltip": "Optional description for the refund.",
                        "label": "Description",
                        "index": 3
                    },
                    "metadata": {
                        "type": "text",
                        "tooltip": "Arbitrary data you can attach to the refund.",
                        "label": "Metadata",
                        "index": 4
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Resource",
                    "value": "resource",
                    "schema": {
                        "type": "string",
                        "example": "refund"
                    }
                },
                {
                    "label": "Refund ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "re_4qqhO89gsT"
                    }
                },
                {
                    "label": "Amount",
                    "value": "amount",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "value": {
                                "type": "string",
                                "title": "Value"
                            },
                            "currency": {
                                "type": "string",
                                "title": "Currency"
                            }
                        },
                        "example": {
                            "value": "5.00",
                            "currency": "EUR"
                        }
                    }
                },
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "string",
                        "example": "pending"
                    }
                },
                {
                    "label": "Created At",
                    "value": "createdAt",
                    "schema": {
                        "type": "string",
                        "example": "2024-03-14T17:09:02+00:00"
                    }
                },
                {
                    "label": "Description",
                    "value": "description",
                    "schema": {
                        "type": "string",
                        "example": "Order #12345"
                    }
                },
                {
                    "label": "Metadata",
                    "value": "metadata",
                    "schema": {
                        "type": "object",
                        "example": {
                            "bookkeeping_id": 12345
                        }
                    }
                },
                {
                    "label": "Payment ID",
                    "value": "paymentId",
                    "schema": {
                        "type": "string",
                        "example": "tr_7UhSN1zuXS"
                    }
                },
                {
                    "label": "Links",
                    "value": "_links",
                    "schema": {
                        "type": "object",
                        "example": {
                            "self": {
                                "href": "https://api.mollie.com/v2/payments/tr_7UhSN1zuXS/refunds/re_4qqhO89gsT",
                                "type": "application/hal+json"
                            },
                            "payment": {
                                "href": "https://api.mollie.com/v2/payments/tr_7UhSN1zuXS",
                                "type": "application/hal+json"
                            },
                            "documentation": {
                                "href": "https://docs.mollie.com/reference/create-refund",
                                "type": "text/html"
                            }
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}