{
    "name": "appmixer.clearbit.enrichment.FindCompany",
    "author": "Tomasz Hencel <thencel@ntrc.eu>",
    "description": "Find company via clearbit.",
    "webhook": true,
    "private": false,
    "auth": {
        "service": "appmixer:clearbit"
    },
    "quota": {
        "manager": "appmixer:clearbit",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "attributes",
            "schema": {
                "type": "object",
                "properties": {
                    "domain": { "type": "string" },
                    "companyName": { "type": "string" },
                    "linkedIn": { "type": "string" },
                    "twitter": { "type": "string" },
                    "facebook": { "type": "string" }
                },
                "required": [
                    "domain"
                ]
            },
            "inspector": {
                "inputs": {
                    "domain": {
                        "type": "text",
                        "group": "transformation",
                        "label": "Company domain",
                        "attrs": {
                            "label": {
                                "data-tooltip": "Domain of company you are looking for."
                            }
                        },
                        "index": 1
                    },
                    "companyName": {
                        "type": "text",
                        "group": "transformation",
                        "label": "Name",
                        "attrs": {
                            "label": {
                                "data-tooltip": "Name of company you are looking for."
                            }
                        },
                        "index": 2
                    },
                    "linkedIn": {
                        "type": "text",
                        "group": "transformation",
                        "label": "LinkedIn link",
                        "attrs": {
                            "label": {
                                "data-tooltip": "The LinkedIn URL for the company."
                            }
                        },
                        "index": 3
                    },
                    "twitter": {
                        "type": "text",
                        "group": "transformation",
                        "label": "Twitter link",
                        "attrs": {
                            "label": {
                                "data-tooltip": "The Twitter handle for the company."
                            }
                        },
                        "index": 4
                    },
                    "facebook": {
                        "type": "text",
                        "group": "transformation",
                        "label": "Facebook link",
                        "attrs": {
                            "label": {
                                "data-tooltip": "The Facebook URL for the company."
                            }
                        },
                        "index": 5
                    }
                },
                "groups": {
                    "transformation": {
                        "label": "Transformation",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "company",
            "options": [
                { "label": "category.industry", "value": "category.industry", "schema": { "type": "string", "example": "Internet Software & Services" } },
                { "label": "category.industryGroup", "value": "category.industryGroup", "schema": { "type": "string", "example": "Software & Services" } },
                { "label": "category.sector", "value": "category.sector", "schema": { "type": "string", "example": "Information Technology" } },
                { "label": "category.subIndustry", "value": "category.subIndustry", "schema": { "type": "string", "example": "Internet Software & Services" } },
                { "label": "crunchbase.handle", "value": "crunchbase.handle", "schema": { "type": "string", "example": "organization/uber" } },
                { "label": "description", "value": "description", "schema": { "type": "string", "example": "Get a taxi, private car or rideshare from your mobile phone. Uber connects you with a driver in minutes. Use our app in cities around the world." } },
                { "label": "domain", "value": "domain", "schema": { "type": "string", "example": "uber.com" } },
                { "label": "domainAliases", "value": "domainAliases", "schema": { "type": "array", "example": ["uber.org", "ubercab.com"] } },
                { "label": "emailProvider", "value": "emailProvider", "schema": { "type": "boolean", "example": false } },
                { "label": "facebook.handle", "value": "facebook.handle", "schema": { "type": "string", "example": "uber" } },
                { "label": "foundedYear", "value": "foundedYear", "schema": { "type": "integer", "example": 2009 } },
                { "label": "geo.city", "value": "geo.city", "schema": { "type": "string", "example": "San Francisco" } },
                { "label": "geo.country", "value": "geo.country", "schema": { "type": "string", "example": "United States" } },
                { "label": "geo.countryCode", "value": "geo.countryCode", "schema": { "type": "string", "example": "US" } },
                { "label": "geo.lat", "value": "geo.lat", "schema": { "type": "number", "example": 37.7752315 } },
                { "label": "geo.lng", "value": "geo.lng", "schema": { "type": "number", "example": -122.4175278 } },
                { "label": "geo.postalCode", "value": "geo.postalCode", "schema": { "type": "string", "example": "94103" } },
                { "label": "geo.state", "value": "geo.state", "schema": { "type": "string", "example": "California" } },
                { "label": "geo.stateCode", "value": "geo.stateCode", "schema": { "type": "string", "example": "CA" } },
                { "label": "geo.streetName", "value": "geo.streetName", "schema": { "type": "string", "example": "Market Street" } },
                { "label": "geo.streetNumber", "value": "geo.streetNumber", "schema": { "type": "string", "example": "1455" } },
                { "label": "geo.subPremise", "value": "geo.subPremise", "schema": { "type": "string", "example": null } },
                { "label": "id", "value": "id", "schema": { "type": "string", "example": "3f5d6a4e-c284-4f78-bfdf-7669b45af907" } },
                { "label": "indexedAt", "value": "indexedAt", "schema": { "type": "string", "example": "2024-11-07T00:00:00.000Z" } },
                { "label": "legalName", "value": "legalName", "schema": { "type": "string", "example": "Uber Technologies, Inc." } },
                { "label": "linkedin.handle", "value": "linkedin.handle", "schema": { "type": "string", "example": "company/uber-com" } },
                { "label": "location", "value": "location", "schema": { "type": "string", "example": "1455 Market St, San Francisco, CA 94103, USA" } },
                { "label": "logo", "value": "logo", "schema": { "type": "string", "example": "https://logo.clearbit.com/uber.com" } },
                { "label": "metrics.alexaGlobalRank", "value": "metrics.alexaGlobalRank", "schema": { "type": "integer", "example": 943 } },
                { "label": "metrics.alexaUsRank", "value": "metrics.alexaUsRank", "schema": { "type": "integer", "example": 544 } },
                { "label": "metrics.annualRevenue", "value": "metrics.annualRevenue", "schema": { "type": "integer", "example": 37281000000 } },
                { "label": "metrics.employees", "value": "metrics.employees", "schema": { "type": "integer", "example": 30400 } },
                { "label": "metrics.employeesRange", "value": "metrics.employeesRange", "schema": { "type": "string", "example": "10k-50k" } },
                { "label": "metrics.googleRank", "value": "metrics.googleRank", "schema": { "type": "integer", "example": 7 } },
                { "label": "metrics.marketCap", "value": "metrics.marketCap", "schema": { "type": "integer", "example": 75000000000 } },
                { "label": "metrics.raised", "value": "metrics.raised", "schema": { "type": "integer", "example": 10610000000 } },
                { "label": "name", "value": "name", "schema": { "type": "string", "example": "Uber" } },
                { "label": "phone", "value": "phone", "schema": { "type": "string", "example": "+1 415-555-0100" } },
                { "label": "site.emailAddresses", "value": "site.emailAddresses", "schema": { "type": "string", "example": "domains@uber.com, press@uber.com" } },
                { "label": "site.h1", "value": "site.h1", "schema": { "type": "string", "example": "Go anywhere with Uber" } },
                { "label": "site.metaAuthor", "value": "site.metaAuthor", "schema": { "type": "string", "example": "Uber Technologies" } },
                { "label": "site.metaDescription", "value": "site.metaDescription", "schema": { "type": "string", "example": "Request a ride, hop in, and go. Or become a driver and earn money on your schedule." } },
                { "label": "site.phoneNumbers", "value": "site.phoneNumbers", "schema": { "type": "string", "example": "+1 415-555-0100" } },
                { "label": "site.title", "value": "site.title", "schema": { "type": "string", "example": "Uber - Earn Money by Driving or Get a Ride Now" } },
                { "label": "site.url", "value": "site.url", "schema": { "type": "string", "example": "https://www.uber.com" } },
                { "label": "tags", "value": "tags", "schema": { "type": "string", "example": "Technology, Marketplace, Mobile, B2C, Ground Transportation, Transportation, Internet" } },
                { "label": "tech", "value": "tech", "schema": { "type": "string", "example": "google_analytics, double_click, mixpanel, optimizely, nginx, google_apps" } },
                { "label": "ticker", "value": "ticker", "schema": { "type": "string", "example": "UBER" } },
                { "label": "timeZone", "value": "timeZone", "schema": { "type": "string", "example": "America/Los_Angeles" } },
                { "label": "twitter.avatar", "value": "twitter.avatar", "schema": { "type": "string", "example": "https://pbs.twimg.com/profile_images/697242369154940928/p9jxYqy5_normal.png" } },
                { "label": "twitter.bio", "value": "twitter.bio", "schema": { "type": "string", "example": "Evolving the way the world moves by seamlessly connecting riders to drivers through our app. Question, concern, or praise? Tweet at @Uber_Support." } },
                { "label": "twitter.followers", "value": "twitter.followers", "schema": { "type": "integer", "example": 570351 } },
                { "label": "twitter.following", "value": "twitter.following", "schema": { "type": "integer", "example": 377 } },
                { "label": "twitter.handle", "value": "twitter.handle", "schema": { "type": "string", "example": "Uber" } },
                { "label": "twitter.id", "value": "twitter.id", "schema": { "type": "string", "example": "19103481" } },
                { "label": "twitter.location", "value": "twitter.location", "schema": { "type": "string", "example": "Global" } },
                { "label": "twitter.site", "value": "twitter.site", "schema": { "type": "string", "example": "https://www.uber.com" } },
                { "label": "type", "value": "type", "schema": { "type": "string", "example": "public" } },
                { "label": "url", "value": "url", "schema": { "type": "string", "example": "https://uber.com" } },
                { "label": "utcOffset", "value": "utcOffset", "schema": { "type": "integer", "example": -7 } }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}
