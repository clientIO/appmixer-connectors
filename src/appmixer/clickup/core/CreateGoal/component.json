{
    "name": "appmixer.clickup.core.CreateGoal",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new goal in ClickUp.",
    "private": false,
    "auth": {
        "service": "appmixer:clickup"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "teamId": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "dueDate": {
                        "type": "string"
                    },
                    "color": {
                        "type": "string"
                    },
                    "multipleOwners": {
                        "type": "boolean"
                    },
                    "owners": {
                        "type": "string"
                    }
                },
                "required": [
                    "teamId",
                    "name"
                ]
            },
            "inspector": {
                "inputs": {
                    "teamId": {
                        "type": "text",
                        "label": "Team ID",
                        "index": 1,
                        "tooltip": "Specify the Team ID (Workspace ID)."
                    },
                    "name": {
                        "type": "text",
                        "label": "Name",
                        "index": 2,
                        "tooltip": "Specify the name of the goal."
                    },
                    "description": {
                        "type": "text",
                        "label": "Description",
                        "index": 3,
                        "tooltip": "Specify the description of the goal."
                    },
                    "dueDate": {
                        "type": "date-time",
                        "label": "Due Date",
                        "index": 4,
                        "tooltip": "Specify the due date of the goal."
                    },
                    "color": {
                        "type": "text",
                        "label": "Color",
                        "index": 5,
                        "tooltip": "Hex color code e.g. #FF0000"
                    },
                    "multipleOwners": {
                        "type": "toggle",
                        "label": "Multiple Owners",
                        "index": 6,
                        "tooltip": "Enable to allow multiple owners for this goal."
                    },
                    "owners": {
                        "type": "text",
                        "label": "Owners",
                        "index": 7,
                        "tooltip": "Comma-separated list of owner user IDs."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "goal": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Goal ID",
                                "example": "1041d841-11ae-45bc-8d94-f2d1187a824b"
                            },
                            "pretty_id": {
                                "type": "string",
                                "title": "Pretty ID",
                                "example": "1"
                            },
                            "name": {
                                "type": "string",
                                "title": "Name",
                                "example": "Reduce onboarding time"
                            },
                            "team_id": {
                                "type": "string",
                                "title": "Team ID",
                                "example": "9015365726"
                            },
                            "creator": {
                                "type": "number",
                                "title": "Creator User ID",
                                "example": 62612899
                            },
                            "color": {
                                "type": "string",
                                "title": "Color",
                                "example": "#32a852"
                            },
                            "date_created": {
                                "type": "string",
                                "title": "Date Created",
                                "example": "1787901544394"
                            },
                            "start_date": {
                                "type": "string",
                                "title": "Start Date",
                                "example": "1787901544394"
                            },
                            "due_date": {
                                "type": "string",
                                "title": "Due Date",
                                "example": "1787987944271"
                            },
                            "description": {
                                "type": "string",
                                "title": "Description",
                                "example": "Cut the median onboarding time in half."
                            },
                            "private": {
                                "type": "boolean",
                                "title": "Private",
                                "example": false
                            },
                            "archived": {
                                "type": "boolean",
                                "title": "Archived",
                                "example": false
                            },
                            "multiple_owners": {
                                "type": "boolean",
                                "title": "Multiple Owners",
                                "example": true
                            },
                            "owners": {
                                "type": "array",
                                "title": "Members",
                                "example": [
                                    {
                                        "id": 62612899,
                                        "username": "Jane Doe",
                                        "email": "jane.doe@example.com"
                                    }
                                ],
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "number",
                                            "title": "User ID",
                                            "example": 62612899
                                        },
                                        "username": {
                                            "type": "string",
                                            "title": "Username",
                                            "example": "Jane Doe"
                                        },
                                        "email": {
                                            "type": "string",
                                            "title": "Email",
                                            "example": "jane.doe@example.com"
                                        }
                                    }
                                }
                            },
                            "key_result_count": {
                                "type": "number",
                                "title": "Key Result Count",
                                "example": 2
                            },
                            "percent_completed": {
                                "type": "number",
                                "title": "Percent Completed",
                                "example": 0
                            },
                            "pretty_url": {
                                "type": "string",
                                "title": "Goal URL",
                                "example": "https://app.clickup.com/9015365726/goals/1"
                            }
                        },
                        "title": "Goal"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
