{
    "name": "appmixer.clickup.core.CreateList",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new list.",
    "private": false,
    "auth": {
        "service": "appmixer:clickup"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "spaceId": {
                        "type": "string"
                    },
                    "folderId": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "content": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "priority": {
                        "type": "number"
                    },
                    "dueDate": {
                        "type": "string"
                    },
                    "dueDateTime": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "spaceId",
                    "name"
                ]
            },
            "inspector": {
                "inputs": {
                    "spaceId": {
                        "type": "text",
                        "label": "Space ID",
                        "index": 1,
                        "source": {
                            "url": "/component/appmixer/clickup/core/GetSpaces?outPort=out",
                            "data": {
                                "transform": "./GetSpaces#toSelectArray"
                            }
                        },
                        "tooltip": "Enter a Space ID or select it from the picker."
                    },
                    "folderId": {
                        "type": "text",
                        "label": "Folder ID",
                        "index": 2,
                        "tooltip": "Specify the folder ID. If provided, the list will be created inside this folder. Otherwise, it will be a folderless list in the space."
                    },
                    "name": {
                        "type": "text",
                        "label": "Name",
                        "index": 3,
                        "tooltip": "Specify the name of the list."
                    },
                    "content": {
                        "type": "text",
                        "label": "Content",
                        "index": 4,
                        "tooltip": "Specify the content (description) of the list."
                    },
                    "status": {
                        "type": "text",
                        "label": "Status",
                        "index": 5,
                        "tooltip": "Specify the status of the list."
                    },
                    "priority": {
                        "type": "select",
                        "label": "Priority",
                        "index": 6,
                        "tooltip": "Specify the priority of the list.",
                        "options": [
                            {
                                "label": "Urgent",
                                "value": 1
                            },
                            {
                                "label": "High",
                                "value": 2
                            },
                            {
                                "label": "Normal",
                                "value": 3
                            },
                            {
                                "label": "Low",
                                "value": 4
                            }
                        ]
                    },
                    "dueDate": {
                        "type": "date-time",
                        "label": "Due Date",
                        "index": 7,
                        "tooltip": "Specify the due date of the list."
                    },
                    "dueDateTime": {
                        "type": "toggle",
                        "label": "Due Date Time",
                        "index": 8,
                        "tooltip": "If true, the time of the due date will be included."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "List ID",
                        "example": "901525378924"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Sprint 42"
                    },
                    "orderindex": {
                        "type": "number",
                        "title": "Order Index",
                        "example": 0
                    },
                    "content": {
                        "type": "string",
                        "title": "Content",
                        "example": "Work planned for sprint 42."
                    },
                    "status": {
                        "type": "object",
                        "properties": {
                            "status": {
                                "type": "string",
                                "title": "Status",
                                "example": "in progress"
                            },
                            "color": {
                                "type": "string",
                                "title": "Color",
                                "example": "#1090e0"
                            },
                            "type": {
                                "type": "string",
                                "title": "Type",
                                "example": "custom"
                            }
                        },
                        "title": "Status"
                    },
                    "priority": {
                        "type": "object",
                        "properties": {
                            "priority": {
                                "type": "string",
                                "title": "Priority",
                                "example": "high"
                            },
                            "color": {
                                "type": "string",
                                "title": "Color",
                                "example": "#ffcc00"
                            }
                        },
                        "title": "Priority"
                    },
                    "due_date": {
                        "type": "string",
                        "title": "Due Date",
                        "example": "1787987944271"
                    },
                    "start_date": {
                        "type": "string",
                        "title": "Start Date",
                        "example": "1787901544394"
                    },
                    "folder": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Folder ID",
                                "example": "901517496232"
                            },
                            "name": {
                                "type": "string",
                                "title": "Folder Name",
                                "example": "Q3 Roadmap"
                            }
                        },
                        "title": "Folder"
                    },
                    "space": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Space ID",
                                "example": "90151198160"
                            },
                            "name": {
                                "type": "string",
                                "title": "Space Name",
                                "example": "Product"
                            }
                        },
                        "title": "Space"
                    },
                    "archived": {
                        "type": "boolean",
                        "title": "Archived",
                        "example": false
                    },
                    "override_statuses": {
                        "type": "boolean",
                        "title": "Override Statuses",
                        "example": false
                    },
                    "task_count": {
                        "type": "number",
                        "title": "Task Count",
                        "example": 12
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
