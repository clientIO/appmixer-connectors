{
    "name": "appmixer.clickup.core.CreateGoalKeyResult",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a key result for a goal.",
    "private": false,
    "auth": {
        "service": "appmixer:clickup"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "goalId": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "type": {
                        "type": "string"
                    },
                    "stepsStart": {
                        "type": "number"
                    },
                    "stepsEnd": {
                        "type": "number"
                    },
                    "unit": {
                        "type": "string"
                    },
                    "owners": {
                        "type": "string"
                    },
                    "taskIds": {
                        "type": "string"
                    },
                    "listIds": {
                        "type": "string"
                    }
                },
                "required": [
                    "goalId",
                    "name",
                    "type"
                ]
            },
            "inspector": {
                "inputs": {
                    "goalId": {
                        "type": "text",
                        "label": "Goal ID",
                        "index": 1,
                        "tooltip": "Specify the goal ID to create a key result for."
                    },
                    "name": {
                        "type": "text",
                        "label": "Name",
                        "index": 2,
                        "tooltip": "Specify the name of the key result."
                    },
                    "type": {
                        "type": "select",
                        "label": "Type",
                        "index": 3,
                        "tooltip": "Specify the type of the key result.",
                        "options": [
                            {
                                "label": "Automatic",
                                "value": "automatic"
                            },
                            {
                                "label": "Boolean",
                                "value": "boolean"
                            },
                            {
                                "label": "Currency",
                                "value": "currency"
                            },
                            {
                                "label": "Number",
                                "value": "number"
                            },
                            {
                                "label": "Percentage",
                                "value": "percentage"
                            }
                        ]
                    },
                    "stepsStart": {
                        "type": "number",
                        "label": "Steps Start",
                        "index": 4,
                        "tooltip": "Specify the starting value for the key result."
                    },
                    "stepsEnd": {
                        "type": "number",
                        "label": "Steps End",
                        "index": 5,
                        "tooltip": "Specify the ending value for the key result."
                    },
                    "unit": {
                        "type": "text",
                        "label": "Unit",
                        "index": 6,
                        "tooltip": "Specify the unit of measurement for the key result."
                    },
                    "owners": {
                        "type": "text",
                        "label": "Owners",
                        "index": 7,
                        "tooltip": "Comma-separated list of owner user IDs."
                    },
                    "taskIds": {
                        "type": "text",
                        "label": "Task IDs",
                        "index": 8,
                        "tooltip": "Comma-separated list of task IDs."
                    },
                    "listIds": {
                        "type": "text",
                        "label": "List IDs",
                        "index": 9,
                        "tooltip": "Comma-separated list of list IDs."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "key_result": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Key Result ID",
                                "example": "4838928f-e35d-4d6f-a5de-63eb3ee4d3b8"
                            },
                            "goal_id": {
                                "type": "string",
                                "title": "Goal ID",
                                "example": "1041d841-11ae-45bc-8d94-f2d1187a824b"
                            },
                            "name": {
                                "type": "string",
                                "title": "Name",
                                "example": "Onboarding sessions completed"
                            },
                            "creator": {
                                "type": "number",
                                "title": "Creator User ID",
                                "example": 62612899
                            },
                            "type": {
                                "type": "string",
                                "title": "Type",
                                "example": "number"
                            },
                            "date_created": {
                                "type": "string",
                                "title": "Date Created",
                                "example": "1787901545187"
                            },
                            "unit": {
                                "type": "string",
                                "title": "Unit",
                                "example": "sessions"
                            },
                            "percent_completed": {
                                "type": "number",
                                "title": "Percent Completed",
                                "example": 50
                            },
                            "completed": {
                                "type": "boolean",
                                "title": "Completed",
                                "example": false
                            },
                            "owners": {
                                "type": "array",
                                "title": "Members",
                                "example": [
                                    {
                                        "id": 62612899,
                                        "username": "Jane Doe",
                                        "email": "jane.doe@example.com"
                                    }
                                ],
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "number",
                                            "title": "User ID",
                                            "example": 62612899
                                        },
                                        "username": {
                                            "type": "string",
                                            "title": "Username",
                                            "example": "Jane Doe"
                                        },
                                        "email": {
                                            "type": "string",
                                            "title": "Email",
                                            "example": "jane.doe@example.com"
                                        }
                                    }
                                }
                            }
                        },
                        "title": "Key Result"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
