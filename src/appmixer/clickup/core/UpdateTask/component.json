                    "watchers": {
                        "type": "array",
                        "title": "Watchers",
                        "example": [
                            {
                                "id": 62612899,
                                "username": "Jane Doe",
                                "email": "jane.doe@example.com"
                            }
                        ],
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "number",
                                    "title": "ID",
                                    "example": 62612899
                                },
                                "username": {
                                    "type": "string",
                                    "title": "Username",
                                    "example": "Jane Doe"
