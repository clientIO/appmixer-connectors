                        "items": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "title": "Name",
                                    "example": "urgent"
                                },
                                "tag_fg": {
                                    "type": "string",
                                    "title": "Foreground Color",
                                    "example": "#ffffff"
