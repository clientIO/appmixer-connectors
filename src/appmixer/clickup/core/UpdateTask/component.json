{
    "name": "appmixer.clickup.core.UpdateTask",
    "author": "Harsha Surisetty <harsha@client.io>",
    "description": "Create a new task in ClickUp.",
    "private": false,
    "auth": {
        "service": "appmixer:clickup"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "taskId": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "tags": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "priority": {
                        "type": "number"
                    },
                    "dueDate": {
                        "type": "string"
                    },
                    "dueDateTime": {
                        "type": "boolean"
                    },
                    "startDate": {
                        "type": "string"
                    },
                    "startDateTime": {
                        "type": "boolean"
                    },
                    "notifyAll": {
                        "type": "boolean"
                    },
                    "parent": {
                        "type": "string"
                    },
                    "archived": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "taskId"
                ]
            },
            "inspector": {
                "inputs": {
                    "taskId": {
                        "type": "number",
                        "label": "Task ID",
                        "index": 1,
                        "tooltip": "Specify the task ID to update."
                    },
                    "name": {
                        "type": "text",
                        "label": "Name",
                        "index": 2,
                        "tooltip": "Specify the name of the task."
                    },
                    "description": {
                        "type": "text",
                        "label": "Description",
                        "index": 3,
                        "tooltip": "Specify the description of the task."
                    },
                    "status": {
                        "type": "select",
                        "label": "Status",
                        "index": 7,
                        "options": [
                            {
                                "label": "To Do",
                                "value": "to do"
                            },
                            {
                                "label": "In Progress",
                                "value": "in progress"
                            },
                            {
                                "label": "Complete",
                                "value": "complete"
                            }
                        ],
                        "tooltip": "Specify the task status."
                    },
                    "priority": {
                        "type": "select",
                        "label": "Priority",
                        "index": 8,
                        "tooltip": "Specify the priority of the task.",
                        "options": [
                            {
                                "label": "Low",
                                "value": 4
                            },
                            {
                                "label": "Normal",
                                "value": 3
                            },
                            {
                                "label": "High",
                                "value": 2
                            },
                            {
                                "label": "Urgent",
                                "value": 1
                            }
                        ]
                    },
                    "dueDate": {
                        "type": "date-time",
                        "label": "Due Date",
                        "index": 9,
                        "tooltip": "Specify the due date of the task."
                    },
                    "dueDateTime": {
                        "type": "toggle",
                        "label": "Due Date  Time",
                        "index": 10,
                        "tooltip": "If true, the time of due date will be included."
                    },
                    "startDate": {
                        "type": "date-time",
                        "label": "Start Date",
                        "index": 12,
                        "tooltip": "Specify the start date of the task."
                    },
                    "startDateTime": {
                        "type": "toggle",
                        "label": "Start Date Time",
                        "index": 13,
                        "tooltip": "If true, the time of start date will be included."
                    },
                    "notifyAll": {
                        "type": "toggle",
                        "label": "Notify All",
                        "index": 14,
                        "tooltip": "If 'Notify All' is true, notifications will be sent to everyone including the creator of the comment."
                    },
                    "parent": {
                        "type": "text",
                        "label": "Parent Id",
                        "index": 15,
                        "tooltip": "<p>You can move a subtask to another parent task by including <code>\"parent\"</code> with a valid <code>task id</code>.<br> <br>You cannot convert a subtask to a task by setting <code>\"parent\"</code> to <code>null</code>.</p>"
                    },
                    "archived": {
                        "type": "toggle",
                        "label": "Archived",
                        "index": 16,
                        "tooltip": "If 'Archived' is true, the task will be archived."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Task ID",
                        "example": "86cbb4hct"
                    },
                    "custom_id": {
                        "type": "string",
                        "title": "Custom ID",
                        "example": "ENG-42"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Ship the release notes"
                    },
                    "text_content": {
                        "type": "string",
                        "title": "Text Content",
                        "example": "Draft and publish the release notes."
                    },
                    "description": {
                        "type": "string",
                        "title": "Description",
                        "example": "Draft and publish the release notes."
                    },
                    "status": {
                        "type": "object",
                        "properties": {
                            "status": {
                                "type": "string",
                                "title": "Status",
                                "example": "in progress"
                            },
                            "color": {
                                "type": "string",
                                "title": "Color",
                                "example": "#1090e0"
                            },
                            "type": {
                                "type": "string",
                                "title": "Type",
                                "example": "custom"
                            }
                        },
                        "title": "Status"
                    },
                    "orderindex": {
                        "type": "string",
                        "title": "Order Index",
                        "example": "1.00000000000000000000"
                    },
                    "date_created": {
                        "type": "string",
                        "title": "Date Created",
                        "example": "1787901544394"
                    },
                    "date_updated": {
                        "type": "string",
                        "title": "Date Updated",
                        "example": "1787901544394"
                    },
                    "date_closed": {
                        "type": "string",
                        "title": "Date Closed",
                        "example": "1787987944271"
                    },
                    "creator": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "number",
                                "title": "User ID",
                                "example": 62612899
                            },
                            "username": {
                                "type": "string",
                                "title": "Username",
                                "example": "Jane Doe"
                            },
                            "email": {
                                "type": "string",
                                "title": "Email",
                                "example": "jane.doe@example.com"
                            }
                        },
                        "title": "User"
                    },
                    "assignees": {
                        "type": "array",
                        "title": "Assignees",
                        "example": [
                            {
                                "id": 62612899,
                                "username": "Jane Doe",
                                "email": "jane.doe@example.com"
                            }
                        ],
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "number",
                                    "title": "ID",
                                    "example": 62612899
                                },
                                "username": {
                                    "type": "string",
                                    "title": "Username",
                                    "example": "Jane Doe"
                                },
                                "email": {
                                    "type": "string",
                                    "title": "Email",
                                    "example": "jane.doe@example.com"
                                }
                            }
