{
    "name": "appmixer.clickup.core.CreateTimeEntry",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new time entry in ClickUp.",
    "private": false,
    "auth": {
        "service": "appmixer:clickup"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "teamId": {
                        "type": "string"
                    },
                    "start": {
                        "type": "string"
                    },
                    "duration": {
                        "type": "number"
                    },
                    "taskId": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "billable": {
                        "type": "boolean"
                    },
                    "tags": {
                        "type": "string"
                    }
                },
                "required": [
                    "teamId",
                    "start",
                    "duration"
                ]
            },
            "inspector": {
                "inputs": {
                    "teamId": {
                        "type": "text",
                        "label": "Team ID",
                        "index": 1,
                        "tooltip": "Specify the Team ID (Workspace ID)."
                    },
                    "start": {
                        "type": "date-time",
                        "label": "Start",
                        "index": 2,
                        "tooltip": "Specify the start date and time of the time entry."
                    },
                    "duration": {
                        "type": "number",
                        "label": "Duration (minutes)",
                        "index": 3,
                        "tooltip": "Specify the duration of the time entry in minutes."
                    },
                    "taskId": {
                        "type": "text",
                        "label": "Task ID",
                        "index": 4,
                        "tooltip": "Optionally specify the Task ID to associate with this time entry."
                    },
                    "description": {
                        "type": "text",
                        "label": "Description",
                        "index": 5,
                        "tooltip": "Optionally specify a description for the time entry."
                    },
                    "billable": {
                        "type": "toggle",
                        "label": "Billable",
                        "index": 6,
                        "defaultValue": true,
                        "tooltip": "Specify whether the time entry is billable. Defaults to true."
                    },
                    "tags": {
                        "type": "text",
                        "label": "Tags",
                        "index": 7,
                        "tooltip": "A comma-separated list of tag names."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "data": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Time Entry ID",
                                "example": "5236259827034710185"
                            },
                            "wid": {
                                "type": "string",
                                "title": "Workspace (Team) ID",
                                "example": "9015365726"
                            },
                            "description": {
                                "type": "string",
                                "title": "Description",
                                "example": "Pairing on the release"
                            },
                            "billable": {
                                "type": "boolean",
                                "title": "Billable",
                                "example": true
                            },
                            "start": {
                                "type": "number",
                                "title": "Start",
                                "example": 1787897946095
                            },
                            "end": {
                                "type": "string",
                                "title": "End",
                                "example": "1787898546095"
                            },
                            "duration": {
                                "type": "number",
                                "title": "Duration (ms)",
                                "example": 600000
                            },
                            "at": {
                                "type": "number",
                                "title": "Last Modified",
                                "example": 1787897946095
                            },
                            "is_locked": {
                                "type": "boolean",
                                "title": "Locked",
                                "example": false
                            },
                            "task": {
                                "type": "object",
                                "properties": {
                                    "id": {
                                        "type": "string",
                                        "title": "Task ID",
                                        "example": "86cbb4hct"
                                    },
                                    "name": {
                                        "type": "string",
                                        "title": "Task Name",
                                        "example": "Ship the release notes"
                                    },
                                    "status": {
                                        "type": "object",
                                        "properties": {
                                            "status": {
                                                "type": "string",
                                                "title": "Status",
                                                "example": "in progress"
                                            },
                                            "color": {
                                                "type": "string",
                                                "title": "Color",
                                                "example": "#1090e0"
                                            },
                                            "type": {
                                                "type": "string",
                                                "title": "Type",
                                                "example": "custom"
                                            }
                                        },
                                        "title": "Status"
                                    }
                                },
                                "title": "Task"
                            },
                            "user": {
                                "type": "object",
                                "properties": {
                                    "id": {
                                        "type": "number",
                                        "title": "User ID",
                                        "example": 62612899
                                    },
                                    "username": {
                                        "type": "string",
                                        "title": "Username",
                                        "example": "Jane Doe"
                                    },
                                    "email": {
                                        "type": "string",
                                        "title": "Email",
                                        "example": "jane.doe@example.com"
                                    }
                                },
                                "title": "User"
                            },
                            "tags": {
                                "type": "array",
                                "title": "Tags",
                                "example": [
                                    {
                                        "name": "billable-work",
                                        "tag_fg": "#ffffff",
                                        "tag_bg": "#000000"
                                    }
                                ],
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "name": {
                                            "type": "string",
                                            "title": "Name",
                                            "example": "billable-work"
                                        },
                                        "tag_fg": {
                                            "type": "string",
                                            "title": "Foreground Color",
                                            "example": "#ffffff"
                                        },
                                        "tag_bg": {
                                            "type": "string",
                                            "title": "Background Color",
                                            "example": "#000000"
                                        }
                                    }
                                }
                            },
                            "task_location": {
                                "type": "object",
                                "properties": {
                                    "list_id": {
                                        "type": "string",
                                        "title": "List ID",
                                        "example": "901525378924"
                                    },
                                    "folder_id": {
                                        "type": "string",
                                        "title": "Folder ID",
                                        "example": "901517496232"
                                    },
                                    "space_id": {
                                        "type": "string",
                                        "title": "Space ID",
                                        "example": "90151198160"
                                    }
                                },
                                "title": "Task Location"
                            }
                        },
                        "title": "Time Entry"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
