{
    "name": "appmixer.clickup.core.FindTasks",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Get tasks in a List. Returns a maximum of 100 tasks per one request.",
    "private": false,
    "auth": {
        "service": "appmixer:clickup"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "spaceId": {
                        "type": "string"
                    },
                    "listId": {
                        "type": "string"
                    },
                    "folderId": {
                        "type": "string"
                    },
                    "assigneeIds": {
                        "type": "string"
                    },
                    "statuses": {
                        "type": [
                            "array",
                            "string"
                        ]
                    },
                    "tags": {
                        "type": "string"
                    },
                    "orderBy": {
                        "type": "string"
                    },
                    "outputType": {
                        "type": "string"
                    }
                },
                "required": [
                    "listId"
                ]
            },
            "inspector": {
                "inputs": {
                    "spaceId": {
                        "type": "text",
                        "label": "Space ID",
                        "index": 0,
                        "source": {
                            "url": "/component/appmixer/clickup/core/GetSpaces?outPort=out",
                            "data": {
                                "transform": "./GetSpaces#toSelectArray"
                            }
                        },
                        "tooltip": "Enter a Space ID or select it from the picker."
                    },
                    "folderId": {
                        "type": "text",
                        "label": "Folder ID",
                        "index": 1,
                        "source": {
                            "url": "/component/appmixer/clickup/core/ListFolders?outPort=out",
                            "data": {
                                "transform": "./ListFolders#toSelectArray",
                                "properties": {
                                    "variableFetch": true
                                },
                                "messages": {
                                    "in/spaceId": "inputs/in/spaceId"
                                }
                            }
                        },
                        "tooltip": "If not provided, only tasks from root lists (lists not contained within any folder) are searched. If provided, tasks from lists within the selected folder are searched."
                    },
                    "listId": {
                        "type": "text",
                        "label": "List ID",
                        "index": 2,
                        "source": {
                            "url": "/component/appmixer/clickup/core/GetLists?outPort=out",
                            "data": {
                                "transform": "./GetLists#toSelectArray",
                                "messages": {
                                    "in/spaceId": "inputs/in/spaceId",
                                    "in/folderId": "inputs/in/folderId"
                                },
                                "properties": {
                                    "variableFetch": true
                                }
                            }
                        },
                        "tooltip": "Enter a List ID or select it from the picker."
                    },
                    "statuses": {
                        "type": "multiselect",
                        "label": "Statuses",
                        "tooltip": "Select the Statuses.",
                        "index": 3,
                        "options": [
                            {
                                "label": "To Do",
                                "value": "to do"
                            },
                            {
                                "label": "In Progress",
                                "value": "in progress"
                            },
                            {
                                "label": "Completed",
                                "value": "completed"
                            }
                        ]
                    },
                    "assigneeIds": {
                        "type": "text",
                        "label": "Assignee IDs",
                        "index": 4,
                        "tooltip": "Filter by a comma separated list of Assignee IDs."
                    },
                    "tags": {
                        "type": "text",
                        "label": "Tags",
                        "index": 5,
                        "tooltip": "Filter by a comma separated list of Tags."
                    },
                    "orderBy": {
                        "type": "select",
                        "label": "Order By",
                        "index": 6,
                        "tooltip": "Order by a particular field. By default, tasks are ordered by created date.",
                        "defaultValue": "created",
                        "options": [
                            {
                                "label": "ID",
                                "value": "id"
                            },
                            {
                                "label": "Created At",
                                "value": "created"
                            },
                            {
                                "label": "Updated At",
                                "value": "updated"
                            },
                            {
                                "label": "Due Date",
                                "value": "due_date"
                            }
                        ]
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "index": 7,
                        "defaultValue": "first",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or one item at a time or stream the items to a file. For large datasets, streaming the rows to a file is the most efficient method.",
                        "options": [
                            {
                                "label": "First Found",
                                "value": "first"
                            },
                            {
                                "label": "All at once",
                                "value": "array"
                            },
                            {
                                "label": "One at a time",
                                "value": "object"
                            },
                            {
                                "label": "File",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "tasks",
            "source": {
                "url": "/component/appmixer/clickup/core/FindTasks?outPort=tasks&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType",
                        "in/listId": "dummy"
                    }
                }
            }
        },
        {
            "name": "notFound"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
