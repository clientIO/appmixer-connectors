{
    "name": "appmixer.clickup.core.GetLists",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Get lists from a space or folder.",
    "private": false,
    "auth": {
        "service": "appmixer:clickup"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "spaceId": {
                        "type": "string"
                    },
                    "folderId": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "spaceId": {
                        "type": "text",
                        "label": "Space ID",
                        "index": 1,
                        "tooltip": "Enter a Space ID or select it from the picker.",
                        "source": {
                            "url": "/component/appmixer/clickup/core/GetSpaces?outPort=out",
                            "data": {
                                "transform": "./GetSpaces#toSelectArray"
                            }
                        }
                    },
                    "folderId": {
                        "type": "text",
                        "label": "Folder ID",
                        "index": 2,
                        "tooltip": "Lists within a specific folder. If not provided, lists will be retrieved from the space root.",
                        "source": {
                            "url": "/component/appmixer/clickup/core/ListFolders?outPort=out",
                            "data": {
                                "messages": {
                                    "in/spaceId": "inputs/in/spaceId"
                                },
                                "properties": {
                                    "variableFetch": true
                                },
                                "transform": "./ListFolders#toSelectArray"
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "lists": {
                        "type": "array",
                        "title": "Lists",
                        "example": [
                            {
                                "id": "901525378924",
                                "name": "Sprint 42",
                                "task_count": 12,
                                "archived": false
                            }
                        ],
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "string",
                                    "title": "List ID",
                                    "example": "901525378924"
                                },
                                "name": {
                                    "type": "string",
                                    "title": "Name",
                                    "example": "Sprint 42"
                                },
                                "orderindex": {
                                    "type": "number",
                                    "title": "Order Index",
                                    "example": 0
                                },
                                "content": {
                                    "type": "string",
                                    "title": "Content",
                                    "example": "Work planned for sprint 42."
                                },
                                "status": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "title": "Status",
                                            "example": "in progress"
                                        },
                                        "color": {
                                            "type": "string",
                                            "title": "Color",
                                            "example": "#1090e0"
                                        },
                                        "type": {
                                            "type": "string",
                                            "title": "Type",
                                            "example": "custom"
                                        }
                                    },
                                    "title": "Status"
                                },
                                "priority": {
                                    "type": "object",
                                    "properties": {
                                        "priority": {
                                            "type": "string",
                                            "title": "Priority",
                                            "example": "high"
                                        },
                                        "color": {
                                            "type": "string",
                                            "title": "Color",
                                            "example": "#ffcc00"
                                        }
                                    },
                                    "title": "Priority"
                                },
                                "due_date": {
                                    "type": "string",
                                    "title": "Due Date",
                                    "example": "1787987944271"
                                },
                                "start_date": {
                                    "type": "string",
                                    "title": "Start Date",
                                    "example": "1787901544394"
                                },
                                "folder": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "string",
                                            "title": "Folder ID",
                                            "example": "901517496232"
                                        },
                                        "name": {
                                            "type": "string",
                                            "title": "Folder Name",
                                            "example": "Q3 Roadmap"
                                        }
                                    },
                                    "title": "Folder"
                                },
                                "space": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "string",
                                            "title": "Space ID",
                                            "example": "90151198160"
                                        },
                                        "name": {
                                            "type": "string",
                                            "title": "Space Name",
                                            "example": "Product"
                                        }
                                    },
                                    "title": "Space"
                                },
                                "archived": {
                                    "type": "boolean",
                                    "title": "Archived",
                                    "example": false
                                },
                                "override_statuses": {
                                    "type": "boolean",
                                    "title": "Override Statuses",
                                    "example": false
                                },
                                "task_count": {
                                    "type": "number",
                                    "title": "Task Count",
                                    "example": 12
                                }
                            }
                        }
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
