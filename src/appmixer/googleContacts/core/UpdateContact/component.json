{
    "name": "appmixer.googleContacts.core.UpdateContact",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Updates an existing contact.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:googleContacts",
        "scope": [
            "https://www.googleapis.com/auth/contacts"
        ]
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "contactId": {
                        "type": "string"
                    },
                    "firstName": {
                        "type": "string"
                    },
                    "familyName": {
                        "type": "string"
                    },
                    "emails": {
                        "type": "object"
                    },
                    "phones": {
                        "type": "object"
                    },
                    "notes": {
                        "type": "string"
                    }
                },
                "required": [
                    "contactId"
                ]
            },
            "inspector": {
                "inputs": {
                    "contactId": {
                        "type": "text",
                        "label": "Contact ID",
                        "index": 0,
                        "tooltip": "Accepts either raw ID (e.g., c123...) or full resource name (people/c123...)."
                    },
                    "firstName": {
                        "type": "text",
                        "label": "First Name",
                        "index": 1
                    },
                    "familyName": {
                        "type": "text",
                        "label": "Family Name",
                        "index": 2
                    },
                    "emails": {
                        "index": 3,
                        "type": "expression",
                        "label": "Emails",
                        "levels": [
                            "ADD"
                        ],
                        "fields": {
                            "value": {
                                "type": "text",
                                "label": "Email",
                                "index": 1
                            },
                            "displayName": {
                                "type": "text",
                                "label": "Display Name",
                                "index": 2
                            },
                            "type": {
                                "type": "select",
                                "label": "Type",
                                "options": [
                                    {
                                        "clearItem": true,
                                        "label": "<empty>"
                                    },
                                    {
                                        "value": "home",
                                        "label": "Home"
                                    },
                                    {
                                        "value": "work",
                                        "label": "Work"
                                    },
                                    {
                                        "value": "other",
                                        "label": "Other"
                                    }
                                ],
                                "index": 3
                            }
                        }
                    },
                    "phones": {
                        "index": 4,
                        "type": "expression",
                        "label": "Phone Numbers",
                        "levels": [
                            "ADD"
                        ],
                        "fields": {
                            "value": {
                                "type": "text",
                                "label": "Phone Number",
                                "index": 1
                            },
                            "type": {
                                "type": "select",
                                "label": "Type",
                                "options": [
                                    {
                                        "clearItem": true,
                                        "label": "<empty>"
                                    },
                                    {
                                        "value": "home",
                                        "label": "Home"
                                    },
                                    {
                                        "value": "work",
                                        "label": "Work"
                                    },
                                    {
                                        "value": "mobile",
                                        "label": "Mobile"
                                    },
                                    {
                                        "value": "homefax",
                                        "label": "Home Fax"
                                    },
                                    {
                                        "value": "workfax",
                                        "label": "Work Fax"
                                    },
                                    {
                                        "value": "otherFax",
                                        "label": "Other Fax"
                                    },
                                    {
                                        "value": "pager",
                                        "label": "Pager"
                                    },
                                    {
                                        "value": "workMobile",
                                        "label": "Work Mobile"
                                    },
                                    {
                                        "value": "workPager",
                                        "label": "Work Pager"
                                    },
                                    {
                                        "value": "main",
                                        "label": "Main"
                                    },
                                    {
                                        "value": "googleVoice",
                                        "label": "Google Voice"
                                    },
                                    {
                                        "value": "other",
                                        "label": "Other"
                                    }
                                ],
                                "index": 3
                            }
                        }
                    },
                    "notes": {
                        "type": "text",
                        "label": "Notes",
                        "index": 5
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Contact ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "people/c1234567890123456"
                    }
                },
                {
                    "label": "ETag",
                    "value": "etag",
                    "schema": {
                        "type": "string",
                        "example": "%EgUBAi43PRoEAQIFByIMV3B2dUNUZkFXdz0="
                    }
                },
                {
                    "label": "Update Time",
                    "value": "updateTime",
                    "schema": {
                        "type": "string",
                        "example": "2026-01-15T14:30:00.000Z"
                    }
                },
                {
                    "label": "Display Name",
                    "value": "displayName",
                    "schema": {
                        "type": "string",
                        "example": "Michael Chen"
                    }
                },
                {
                    "label": "First Name",
                    "value": "givenName",
                    "schema": {
                        "type": "string",
                        "example": "Michael"
                    }
                },
                {
                    "label": "Display Name Last First",
                    "value": "displayNameLastFirst",
                    "schema": {
                        "type": "string",
                        "example": "Chen, Michael"
                    }
                },
                {
                    "label": "Unstructured Name",
                    "value": "unstructuredName",
                    "schema": {
                        "type": "string",
                        "example": "Michael Chen"
                    }
                },
                {
                    "label": "Photo URL",
                    "value": "photoUrl",
                    "schema": {
                        "type": "string",
                        "example": "https://lh3.googleusercontent.com/contacts/ANfB_t5_updated"
                    }
                },
                {
                    "label": "Memberships",
                    "value": "memberships",
                    "schema": {
                        "type": "array",
                        "example": [
                            {
                                "metadata": {
                                    "source": {
                                        "type": "CONTACT",
                                        "id": "4e3b2a1c0f9d8e7a"
                                    }
                                },
                                "contactGroupMembership": {
                                    "contactGroupId": "myContacts",
                                    "contactGroupResourceName": "contactGroups/myContacts"
                                }
                            }
                        ]
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}
