{
    "name": "appmixer.googleContacts.core.GetContact",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieves information about the specified contact.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:googleContacts",
        "scope": [
            "https://www.googleapis.com/auth/contacts.readonly"
        ]
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "contactId": {
                        "type": "string"
                    }
                },
                "required": [
                    "contactId"
                ]
            },
            "inspector": {
                "inputs": {
                    "contactId": {
                        "type": "text",
                        "label": "Contact ID",
                        "index": 0,
                        "tooltip": "Accepts either raw ID (e.g., c123...) or full resource name (people/c123...)."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Contact ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "people/c1234567890123456"
                    }
                },
                {
                    "label": "ETag",
                    "value": "etag",
                    "schema": {
                        "type": "string",
                        "example": "%EgUBAi43PRoEAQIFByIMV3B2dUNUZkFXdz0="
                    }
                },
                {
                    "label": "Update Time",
                    "value": "updateTime",
                    "schema": {
                        "type": "string",
                        "example": "2026-01-14T16:30:00.000Z"
                    }
                },
                {
                    "label": "Display Name",
                    "value": "displayName",
                    "schema": {
                        "type": "string",
                        "example": "Jane Wilson"
                    }
                },
                {
                    "label": "First Name",
                    "value": "givenName",
                    "schema": {
                        "type": "string",
                        "example": "Jane"
                    }
                },
                {
                    "label": "Display Name Last First",
                    "value": "displayNameLastFirst",
                    "schema": {
                        "type": "string",
                        "example": "Wilson, Jane"
                    }
                },
                {
                    "label": "Unstructured Name",
                    "value": "unstructuredName",
                    "schema": {
                        "type": "string",
                        "example": "Jane Wilson"
                    }
                },
                {
                    "label": "Photo URL",
                    "value": "photoUrl",
                    "schema": {
                        "type": "string",
                        "example": "https://lh3.googleusercontent.com/contacts/ANfB_t5_abc123"
                    }
                },
                {
                    "label": "Memberships",
                    "value": "memberships",
                    "schema": {
                        "type": "array",
                        "example": [
                            {
                                "metadata": {
                                    "source": {
                                        "type": "CONTACT",
                                        "id": "4e3b2a1c0f9d8e7a"
                                    }
                                },
                                "contactGroupMembership": {
                                    "contactGroupId": "myContacts",
                                    "contactGroupResourceName": "contactGroups/myContacts"
                                }
                            }
                        ]
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}
