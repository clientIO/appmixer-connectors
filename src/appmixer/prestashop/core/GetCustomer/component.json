{
    "name": "appmixer.prestashop.core.GetCustomer",
    "label": "Get Customer",
    "description": "Retrieve a customer and all associated data by ID, including the customer group they belong to and the reduction configured for that group.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:prestashop"
    },
    "quota": {
        "manager": "appmixer:prestashop",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "customerId": { "type": "string" }
                },
                "required": ["customerId"]
            },
            "inspector": {
                "inputs": {
                    "customerId": {
                        "type": "text",
                        "index": 1,
                        "label": "Customer ID",
                        "tooltip": "The unique identifier of the customer."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": { "type": "string", "title": "Customer ID", "example": "2" },
                    "id_default_group": { "type": "string", "title": "Default Group ID", "example": "3" },
                    "firstname": { "type": "string", "title": "First Name", "example": "John" },
                    "lastname": { "type": "string", "title": "Last Name", "example": "Doe" },
                    "email": { "type": "string", "title": "Email", "example": "john.doe@example.com" },
                    "company": { "type": "string", "title": "Company", "example": "Acme Inc." },
                    "newsletter": { "type": "string", "title": "Newsletter", "example": "1" },
                    "active": { "type": "string", "title": "Active", "example": "1" },
                    "note": { "type": "string", "title": "Note", "example": "VIP customer" },
                    "date_add": { "type": "string", "title": "Created Date", "example": "2024-01-15 10:30:00" },
                    "date_upd": { "type": "string", "title": "Updated Date", "example": "2024-02-20 08:15:00" },
                    "default_group": {
                        "type": "object",
                        "title": "Default Group",
                        "properties": {
                            "id": { "type": "string", "title": "Group ID", "example": "3" },
                            "reduction": { "type": "string", "title": "Reduction (%)", "example": "10.000000" },
                            "price_display_method": { "type": "string", "title": "Price Display Method", "example": "0" },
                            "name": {
                                "type": "array",
                                "title": "Group Name",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "id": { "type": "string" },
                                        "value": { "type": "string" }
                                    }
                                },
                                "example": [{ "id": "1", "value": "Customer" }]
                            }
                        }
                    },
                    "associations": {
                        "type": "object",
                        "title": "Associations",
                        "properties": {
                            "groups": {
                                "type": "array",
                                "title": "Groups",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "id": { "type": "string" }
                                    }
                                },
                                "example": [{ "id": "3" }]
                            }
                        }
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
