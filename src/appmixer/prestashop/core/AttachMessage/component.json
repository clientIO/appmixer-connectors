{
    "name": "appmixer.prestashop.core.AttachMessage",
    "label": "Attach Message To Customer",
    "description": "Attach a message back to a customer by posting it to an existing customer service thread. Use this to send a reply that is visible to the customer.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:prestashop"
    },
    "quota": {
        "manager": "appmixer:prestashop",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "customerThreadId": { "type": "string" },
                    "message": { "type": "string" }
                },
                "required": ["customerThreadId", "message"]
            },
            "inspector": {
                "inputs": {
                    "customerThreadId": {
                        "type": "text",
                        "index": 1,
                        "label": "Customer Thread ID",
                        "tooltip": "The ID of the customer service thread the message belongs to."
                    },
                    "message": {
                        "type": "textarea",
                        "index": 2,
                        "label": "Message",
                        "tooltip": "The message content to send back to the customer."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": { "type": "string", "title": "Message ID", "example": "42" },
                    "id_customer_thread": { "type": "string", "title": "Customer Thread ID", "example": "7" },
                    "message": { "type": "string", "title": "Message", "example": "Your order has been shipped." },
                    "private": { "type": "string", "title": "Private", "example": "0" },
                    "date_add": { "type": "string", "title": "Created Date", "example": "2024-02-20 08:15:00" }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
