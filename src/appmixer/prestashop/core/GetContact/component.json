{
    "name": "appmixer.prestashop.core.GetContact",
    "label": "Get Contact",
    "description": "Retrieve a store contact and all of its associated data by ID. Contacts are the customer-service contacts configured in your PrestaShop back office.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:prestashop"
    },
    "quota": {
        "manager": "appmixer:prestashop",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "contactId": { "type": "string" }
                },
                "required": ["contactId"]
            },
            "inspector": {
                "inputs": {
                    "contactId": {
                        "type": "text",
                        "index": 1,
                        "label": "Contact ID",
                        "tooltip": "The unique identifier of the contact."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": { "type": "string", "title": "Contact ID", "example": "1" },
                    "email": { "type": "string", "title": "Email", "example": "support@example.com" },
                    "customer_service": { "type": "string", "title": "Customer Service", "example": "1" },
                    "position": { "type": "string", "title": "Position", "example": "0" },
                    "name": {
                        "type": "array",
                        "title": "Name",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": { "type": "string" },
                                "value": { "type": "string" }
                            }
                        },
                        "example": [{ "id": "1", "value": "Customer service" }]
                    },
                    "description": {
                        "type": "array",
                        "title": "Description",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": { "type": "string" },
                                "value": { "type": "string" }
                            }
                        },
                        "example": [{ "id": "1", "value": "If a technical problem occurs on this website" }]
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
