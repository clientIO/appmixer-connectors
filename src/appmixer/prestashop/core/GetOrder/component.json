{
    "name": "appmixer.prestashop.core.GetOrder",
    "label": "Get Order",
    "description": "Get all information about an order by ID: the carrier, the order detail rows, the current and historical states and the associated customer.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:prestashop"
    },
    "quota": {
        "manager": "appmixer:prestashop",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "orderId": { "type": "string" }
                },
                "required": ["orderId"]
            },
            "inspector": {
                "inputs": {
                    "orderId": {
                        "type": "text",
                        "index": 1,
                        "label": "Order ID",
                        "tooltip": "The unique identifier of the order."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": { "type": "string", "title": "Order ID", "example": "5" },
                    "reference": { "type": "string", "title": "Reference", "example": "XKBKNABJK" },
                    "id_customer": { "type": "string", "title": "Customer ID", "example": "2" },
                    "id_cart": { "type": "string", "title": "Cart ID", "example": "5" },
                    "id_carrier": { "type": "string", "title": "Carrier ID", "example": "2" },
                    "current_state": { "type": "string", "title": "Current State ID", "example": "5" },
                    "payment": { "type": "string", "title": "Payment Method", "example": "Bank wire" },
                    "total_paid": { "type": "string", "title": "Total Paid", "example": "79.900000" },
                    "date_add": { "type": "string", "title": "Created Date", "example": "2024-01-15 10:30:00" },
                    "associations": {
                        "type": "object",
                        "title": "Associations",
                        "properties": {
                            "order_rows": {
                                "type": "array",
                                "title": "Order Rows",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "id": { "type": "string" },
                                        "product_id": { "type": "string" },
                                        "product_name": { "type": "string" },
                                        "product_quantity": { "type": "string" },
                                        "unit_price_tax_incl": { "type": "string" }
                                    }
                                },
                                "example": [{ "id": "9", "product_id": "1", "product_name": "Hummingbird printed t-shirt", "product_quantity": "1", "unit_price_tax_incl": "23.900000" }]
                            }
                        }
                    },
                    "customer": {
                        "type": "object",
                        "title": "Customer",
                        "properties": {
                            "id": { "type": "string", "title": "Customer ID", "example": "2" },
                            "firstname": { "type": "string", "title": "First Name", "example": "John" },
                            "lastname": { "type": "string", "title": "Last Name", "example": "Doe" },
                            "email": { "type": "string", "title": "Email", "example": "john.doe@example.com" }
                        }
                    },
                    "state_history": {
                        "type": "array",
                        "title": "State History",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": { "type": "string" },
                                "id_order_state": { "type": "string" },
                                "date_add": { "type": "string" }
                            }
                        },
                        "example": [{ "id": "10", "id_order_state": "2", "date_add": "2024-01-15 10:35:00" }]
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
