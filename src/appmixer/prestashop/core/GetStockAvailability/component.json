{
    "name": "appmixer.prestashop.core.GetStockAvailability",
    "label": "Get Stock Availability",
    "description": "Get the stock availability for a product by its product ID. Returns the total available quantity as well as the per-combination stock records.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:prestashop"
    },
    "quota": {
        "manager": "appmixer:prestashop",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "productId": { "type": "string" }
                },
                "required": ["productId"]
            },
            "inspector": {
                "inputs": {
                    "productId": {
                        "type": "text",
                        "index": 1,
                        "label": "Product ID",
                        "tooltip": "The unique identifier of the product to check stock for."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id_product": { "type": "string", "title": "Product ID", "example": "1" },
                    "quantity": { "type": "integer", "title": "Total Quantity", "example": 300 },
                    "stock_availables": {
                        "type": "array",
                        "title": "Stock Records",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": { "type": "string", "title": "Stock Available ID", "example": "1" },
                                "id_product": { "type": "string", "title": "Product ID", "example": "1" },
                                "id_product_attribute": { "type": "string", "title": "Combination ID", "example": "0" },
                                "quantity": { "type": "string", "title": "Quantity", "example": "300" },
                                "out_of_stock": { "type": "string", "title": "Out Of Stock Behaviour", "example": "2" },
                                "location": { "type": "string", "title": "Location", "example": "" }
                            }
                        },
                        "example": [{ "id": "1", "id_product": "1", "id_product_attribute": "0", "quantity": "300", "out_of_stock": "2", "location": "" }]
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
