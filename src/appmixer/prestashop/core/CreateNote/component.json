{
    "name": "appmixer.prestashop.core.CreateNote",
    "label": "Create Note",
    "description": "Create an internal (private) note on a customer service thread. The note is stored as a private customer message and is not shown to the customer.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:prestashop"
    },
    "quota": {
        "manager": "appmixer:prestashop",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "customerThreadId": { "type": "string" },
                    "note": { "type": "string" }
                },
                "required": ["customerThreadId", "note"]
            },
            "inspector": {
                "inputs": {
                    "customerThreadId": {
                        "type": "text",
                        "index": 1,
                        "label": "Customer Thread ID",
                        "tooltip": "The ID of the customer service thread to attach the note to."
                    },
                    "note": {
                        "type": "textarea",
                        "index": 2,
                        "label": "Note",
                        "tooltip": "The internal note content. Only visible to employees, not to the customer."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": { "type": "string", "title": "Message ID", "example": "43" },
                    "id_customer_thread": { "type": "string", "title": "Customer Thread ID", "example": "7" },
                    "message": { "type": "string", "title": "Note", "example": "Customer requested a callback." },
                    "private": { "type": "string", "title": "Private", "example": "1" },
                    "date_add": { "type": "string", "title": "Created Date", "example": "2024-02-20 08:15:00" }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
