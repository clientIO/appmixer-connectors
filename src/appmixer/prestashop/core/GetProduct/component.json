{
    "name": "appmixer.prestashop.core.GetProduct",
    "label": "Get Product",
    "description": "Retrieve a single product by its ID, including all details such as price, reference and descriptions.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:prestashop"
    },
    "quota": {
        "manager": "appmixer:prestashop",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "productId": { "type": "string" }
                },
                "required": ["productId"]
            },
            "inspector": {
                "inputs": {
                    "productId": {
                        "type": "text",
                        "index": 1,
                        "label": "Product ID",
                        "tooltip": "The unique identifier of the product. Usually obtained via the List Products action."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": { "type": "string", "title": "Product ID", "example": "1" },
                    "reference": { "type": "string", "title": "Reference", "example": "demo_1" },
                    "price": { "type": "string", "title": "Price", "example": "23.900000" },
                    "wholesale_price": { "type": "string", "title": "Wholesale Price", "example": "10.000000" },
                    "active": { "type": "string", "title": "Active", "example": "1" },
                    "ean13": { "type": "string", "title": "EAN-13", "example": "0700580198882" },
                    "id_category_default": { "type": "string", "title": "Default Category ID", "example": "2" },
                    "id_manufacturer": { "type": "string", "title": "Manufacturer ID", "example": "1" },
                    "quantity": { "type": "string", "title": "Quantity", "example": "300" },
                    "date_add": { "type": "string", "title": "Created Date", "example": "2024-01-15 10:30:00" },
                    "date_upd": { "type": "string", "title": "Updated Date", "example": "2024-02-20 08:15:00" },
                    "name": {
                        "type": "array",
                        "title": "Name",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": { "type": "string" },
                                "value": { "type": "string" }
                            }
                        },
                        "example": [{ "id": "1", "value": "Hummingbird printed t-shirt" }]
                    },
                    "description_short": {
                        "type": "array",
                        "title": "Short Description",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": { "type": "string" },
                                "value": { "type": "string" }
                            }
                        },
                        "example": [{ "id": "1", "value": "<p>Regular fit, round neckline, short sleeves.</p>" }]
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
