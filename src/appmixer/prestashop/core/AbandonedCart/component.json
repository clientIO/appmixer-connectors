{
    "name": "appmixer.prestashop.core.AbandonedCart",
    "label": "Abandoned Cart",
    "description": "Triggers when a cart is abandoned (a cart that has not been converted into an order) and pulls the cart contents.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": false,
    "trigger": true,
    "tick": true,
    "auth": {
        "service": "appmixer:prestashop"
    },
    "quota": {
        "manager": "appmixer:prestashop",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": { "type": "string", "title": "Cart ID", "example": "12" },
                    "id_customer": { "type": "string", "title": "Customer ID", "example": "2" },
                    "id_currency": { "type": "string", "title": "Currency ID", "example": "1" },
                    "id_carrier": { "type": "string", "title": "Carrier ID", "example": "2" },
                    "id_address_delivery": { "type": "string", "title": "Delivery Address ID", "example": "4" },
                    "date_add": { "type": "string", "title": "Created Date", "example": "2024-02-20 08:15:00" },
                    "date_upd": { "type": "string", "title": "Updated Date", "example": "2024-02-20 08:30:00" },
                    "associations": {
                        "type": "object",
                        "title": "Associations",
                        "properties": {
                            "cart_rows": {
                                "type": "array",
                                "title": "Cart Rows",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "id_product": { "type": "string" },
                                        "id_product_attribute": { "type": "string" },
                                        "quantity": { "type": "string" }
                                    }
                                },
                                "example": [{ "id_product": "1", "id_product_attribute": "1", "quantity": "2" }]
                            }
                        }
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
