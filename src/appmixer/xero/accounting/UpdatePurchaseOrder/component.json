{
    "name": "appmixer.xero.accounting.UpdatePurchaseOrder",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Update an existing purchase order.",
    "private": false,
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:xero",
        "scope": [
            "accounting.transactions"
        ]
    },
    "quota": {
        "manager": "appmixer:xero:accounting",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "tenantId": {
                        "type": "string"
                    },
                    "PurchaseOrderID": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "ContactID": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "LineItems": {
                        "type": "string"
                    },
                    "Date": {
                        "type": "string",
                        "format": "date"
                    },
                    "DeliveryDate": {
                        "type": "string",
                        "format": "date"
                    },
                    "LineAmountTypes": {
                        "type": "string",
                        "enum": [
                            "Exclusive",
                            "Inclusive",
                            "NoTax"
                        ]
                    },
                    "PurchaseOrderNumber": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "Reference": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "CurrencyCode": {
                        "type": "string"
                    },
                    "CurrencyRate": {
                        "type": "number"
                    },
