                            "url": "/component/appmixer/xero/accounting/ListContacts?outPort=contacts",
                            "data": {
                                "messages": {
                                    "in/tenantId": "inputs/in/tenantId"
                                },
                                "transform": "./transformers#contactsToSelectArray"
                            }
