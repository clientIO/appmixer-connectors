{
    "name": "appmixer.freshdesk.companies.UpdateCompany",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Update an existing company in Freshdesk.",
    "private": false,
    "auth": {
        "service": "appmixer:freshdesk"
    },
    "quota": {
        "manager": "appmixer:freshdesk",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "companyId": {
                        "type": [
                            "number",
                            "string"
                        ]
                    },
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "note": {
                        "type": "string"
                    },
                    "domains": {
                        "type": "string"
                    },
                    "healthScore": {
                        "type": "string"
                    },
                    "accountTier": {
                        "type": "string"
                    },
                    "renewalDate": {
                        "type": "string"
                    },
                    "industry": {
                        "type": "string"
                    }
                },
                "required": [
                    "companyId"
                ]
            },
            "inspector": {
                "inputs": {
                    "companyId": {
                        "type": "number",
                        "label": "Company ID",
                        "index": 1,
                        "tooltip": "ID of the company to update."
                    },
                    "name": {
                        "type": "text",
                        "label": "Name",
                        "index": 2,
                        "tooltip": "New name of the company."
                    },
                    "description": {
                        "type": "text",
                        "label": "Description",
                        "index": 3,
                        "tooltip": "Description of the company."
                    },
                    "note": {
                        "type": "text",
                        "label": "Note",
                        "index": 4,
                        "tooltip": "Any additional information about the company."
                    },
                    "domains": {
                        "type": "text",
                        "label": "Domains",
                        "index": 5,
                        "tooltip": "Comma-separated list of company domains (e.g. <code>example.com,example.org</code>)."
                    },
                    "healthScore": {
                        "type": "text",
                        "label": "Health Score",
                        "index": 6,
                        "tooltip": "Health score of the company. Allowed values: <code>Good</code>, <code>Bad</code>, <code>Ugly</code>."
                    },
                    "accountTier": {
                        "type": "text",
                        "label": "Account Tier",
                        "index": 7,
                        "tooltip": "Tier of the company. Allowed values: <code>Basic</code>, <code>Premium</code>, <code>Enterprise</code>."
                    },
                    "renewalDate": {
                        "type": "text",
                        "label": "Renewal Date",
                        "index": 8,
                        "tooltip": "Date when the company's contract is up for renewal (ISO 8601, e.g. <code>2025-12-31</code>)."
                    },
                    "industry": {
                        "type": "text",
                        "label": "Industry",
                        "index": 9,
                        "tooltip": "Industry the company belongs to."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "company",
            "options": [
                {
                    "label": "Company ID",
                    "value": "id",
                    "schema": {
                        "type": "integer",
                        "example": 5000123456
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Acme Corp"
                    }
                },
                {
                    "label": "Description",
                    "value": "description",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "Enterprise customer since 2021"
                    }
                },
                {
                    "label": "Note",
                    "value": "note",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "Renewal call scheduled for November"
                    }
                },
                {
                    "label": "Domains",
                    "value": "domains",
                    "schema": {
                        "type": "array",
                        "example": [
                            "acme.example.com",
                            "acme.io"
                        ]
                    }
                },
                {
                    "label": "Health Score",
                    "value": "healthScore",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "Happy"
                    }
                },
                {
                    "label": "Account Tier",
                    "value": "accountTier",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "Enterprise"
                    }
                },
                {
                    "label": "Renewal Date",
                    "value": "renewalDate",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "2026-12-31T00:00:00Z"
                    }
                },
                {
                    "label": "Industry",
                    "value": "industry",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "Software"
                    }
                },
                {
                    "label": "Created At",
                    "value": "createdAt",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00Z"
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updatedAt",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-11T10:05:00Z"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}