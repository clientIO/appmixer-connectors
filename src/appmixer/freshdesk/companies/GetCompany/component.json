{
    "name": "appmixer.freshdesk.companies.GetCompany",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Get a company by ID from Freshdesk.",
    "private": false,
    "auth": {
        "service": "appmixer:freshdesk"
    },
    "quota": {
        "manager": "appmixer:freshdesk",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "companyId": {
                        "type": [
                            "number",
                            "string"
                        ]
                    }
                },
                "required": [
                    "companyId"
                ]
            },
            "inspector": {
                "inputs": {
                    "companyId": {
                        "type": "number",
                        "label": "Company ID",
                        "index": 1,
                        "tooltip": "The ID of the company to retrieve."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "company",
            "options": [
                {
                    "label": "Company ID",
                    "value": "id",
                    "schema": {
                        "type": "integer",
                        "example": 5000123456
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Acme Corp"
                    }
                },
                {
                    "label": "Description",
                    "value": "description",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "Enterprise customer since 2021"
                    }
                },
                {
                    "label": "Note",
                    "value": "note",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "Prefers email contact"
                    }
                },
                {
                    "label": "Domains",
                    "value": "domains",
                    "schema": {
                        "type": "array",
                        "example": [
                            "acme.example.com"
                        ]
                    }
                },
                {
                    "label": "Health Score",
                    "value": "healthScore",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "Happy"
                    }
                },
                {
                    "label": "Account Tier",
                    "value": "accountTier",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "Premium"
                    }
                },
                {
                    "label": "Renewal Date",
                    "value": "renewalDate",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "2026-12-31T00:00:00Z"
                    }
                },
                {
                    "label": "Industry",
                    "value": "industry",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "Software"
                    }
                },
                {
                    "label": "Created At",
                    "value": "createdAt",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00Z"
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updatedAt",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T09:12:00Z"
                    }
                }
            ]
        },
        {
            "name": "notFound",
            "options": [
                {
                    "label": "Company ID",
                    "value": "companyId",
                    "schema": {
                        "type": "integer",
                        "example": 5000123456
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}