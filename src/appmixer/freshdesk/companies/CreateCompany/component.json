{
    "name": "appmixer.freshdesk.companies.CreateCompany",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new company in Freshdesk.",
    "private": false,
    "auth": { "service": "appmixer:freshdesk" },
    "quota": { "manager": "appmixer:freshdesk", "resources": "requests", "scope": { "userId": "{{userId}}" } },
    "inPorts": [{
        "name": "in",
        "schema": {
            "type": "object",
            "properties": {
                "name": { "type": "string" },
                "description": { "type": "string" },
                "note": { "type": "string" },
                "domains": { "type": "string" },
                "healthScore": { "type": "string" },
                "accountTier": { "type": "string" },
                "renewalDate": { "type": "string" },
                "industry": { "type": "string" }
            },
            "required": ["name"]
        },
        "inspector": {
            "inputs": {
                "name": { "type": "text", "label": "Name", "index": 1, "tooltip": "Name of the company." },
                "description": { "type": "text", "label": "Description", "index": 2, "tooltip": "Description of the company." },
                "note": { "type": "text", "label": "Note", "index": 3, "tooltip": "Any additional information about the company." },
                "domains": { "type": "text", "label": "Domains", "index": 4, "tooltip": "Comma-separated list of company domains (e.g. <code>example.com,example.org</code>). Used to auto-associate contacts with this company." },
                "healthScore": { "type": "text", "label": "Health Score", "index": 5, "tooltip": "Health score of the company. Allowed values: <code>Good</code>, <code>Bad</code>, <code>Ugly</code>." },
                "accountTier": { "type": "text", "label": "Account Tier", "index": 6, "tooltip": "Tier of the company. Allowed values: <code>Basic</code>, <code>Premium</code>, <code>Enterprise</code>." },
                "renewalDate": { "type": "text", "label": "Renewal Date", "index": 7, "tooltip": "Date when the company's contract is up for renewal (ISO 8601, e.g. <code>2025-12-31</code>)." },
                "industry": { "type": "text", "label": "Industry", "index": 8, "tooltip": "Industry the company belongs to. Allowed values: <code>Aerospace</code>, <code>Agriculture</code>, <code>Apparel</code>, <code>Banking</code>, <code>Biotechnology</code>, <code>Chemicals</code>, <code>Communications</code>, <code>Construction</code>, <code>Consulting</code>, <code>Education</code>, <code>Electronics</code>, <code>Energy</code>, <code>Engineering</code>, <code>Entertainment</code>, <code>Environmental</code>, <code>Finance</code>, <code>Food &amp; Beverage</code>, <code>Government</code>, <code>Healthcare</code>, <code>Hospitality</code>, <code>Insurance</code>, <code>Machinery</code>, <code>Manufacturing</code>, <code>Media</code>, <code>Not for Profit</code>, <code>Recreation</code>, <code>Retail</code>, <code>Shipping</code>, <code>Technology</code>, <code>Telecommunications</code>, <code>Transportation</code>, <code>Utilities</code>, <code>Other</code>." }
            }
        }
    }],
    "outPorts": [{
        "name": "company",
        "options": [
            {
                "label": "Company ID",
                "value": "id",
                "schema": {
                    "type": "integer",
                    "example": 5000123456
                }
            },
            {
                "label": "Name",
                "value": "name",
                "schema": {
                    "type": "string",
                    "example": "Acme Corp"
                }
            },
            {
                "label": "Description",
                "value": "description",
                "schema": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "example": "Enterprise customer since 2021"
                }
            },
            {
                "label": "Note",
                "value": "note",
                "schema": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "example": "Prefers email contact"
                }
            },
            {
                "label": "Domains",
                "value": "domains",
                "schema": {
                    "type": "array",
                    "example": [
                        "acme.example.com"
                    ]
                }
            },
            {
                "label": "Health Score",
                "value": "healthScore",
                "schema": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "example": "Happy"
                }
            },
            {
                "label": "Account Tier",
                "value": "accountTier",
                "schema": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "example": "Premium"
                }
            },
            {
                "label": "Renewal Date",
                "value": "renewalDate",
                "schema": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "example": "2026-12-31T00:00:00Z"
                }
            },
            {
                "label": "Industry",
                "value": "industry",
                "schema": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "example": "Software"
                }
            },
            {
                "label": "Created At",
                "value": "createdAt",
                "schema": {
                    "type": "string",
                    "example": "2026-09-10T08:30:00Z"
                }
            },
            {
                "label": "Updated At",
                "value": "updatedAt",
                "schema": {
                    "type": "string",
                    "example": "2026-09-10T08:30:00Z"
                }
            }
        ]
    }],
    "icon": "data:image/svg+xml;base64,"
}
