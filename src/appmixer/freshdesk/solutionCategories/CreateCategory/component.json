{
    "name": "appmixer.freshdesk.solutionCategories.CreateCategory",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new solution category in Freshdesk.",
    "private": false,
    "auth": {
        "service": "appmixer:freshdesk"
    },
    "quota": {
        "manager": "appmixer:freshdesk",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "icon": "data:image/svg+xml;base64,",
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    }
                },
                "required": [
                    "name"
                ]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "label": "Name",
                        "index": 1,
                        "tooltip": "Name of the solution category. Required."
                    },
                    "description": {
                        "type": "text",
                        "label": "Description",
                        "index": 2,
                        "tooltip": "Description of the solution category."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "category",
            "options": [
                {
                    "label": "Category ID",
                    "value": "id",
                    "schema": {
                        "type": "integer",
                        "example": 5000184300
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Getting started"
                    }
                },
                {
                    "label": "Description",
                    "value": "description",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "Guides for getting started and managing your account"
                    }
                },
                {
                    "label": "Position",
                    "value": "position",
                    "schema": {
                        "type": "integer",
                        "example": 1
                    }
                },
                {
                    "label": "Portal ID",
                    "value": "portalId",
                    "schema": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "example": 5000045678
                    }
                },
                {
                    "label": "Created At",
                    "value": "createdAt",
                    "schema": {
                        "type": "string",
                        "example": "2026-01-12T09:00:00Z"
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updatedAt",
                    "schema": {
                        "type": "string",
                        "example": "2026-01-12T09:00:00Z"
                    }
                }
            ]
        }
    ]
}