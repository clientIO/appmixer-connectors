{
    "name": "appmixer.freshdesk.solutionArticles.CreateArticle",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new solution article in Freshdesk.",
    "private": false,
    "auth": {
        "service": "appmixer:freshdesk"
    },
    "quota": {
        "manager": "appmixer:freshdesk",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "icon": "data:image/svg+xml;base64,",
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "folderId": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "status": {
                        "type": "number"
                    },
                    "tags": {
                        "type": "string"
                    }
                },
                "required": [
                    "folderId",
                    "title",
                    "description"
                ]
            },
            "inspector": {
                "inputs": {
                    "folderId": {
                        "type": "text",
                        "label": "Folder ID",
                        "index": 1,
                        "tooltip": "ID of the solution folder to create the article in. Required."
                    },
                    "title": {
                        "type": "text",
                        "label": "Title",
                        "index": 2,
                        "tooltip": "Title of the article. Required."
                    },
                    "description": {
                        "type": "textarea",
                        "label": "Description",
                        "index": 3,
                        "tooltip": "HTML content of the article. Required."
                    },
                    "status": {
                        "type": "select",
                        "label": "Status",
                        "index": 4,
                        "tooltip": "Status of the article.",
                        "defaultValue": 2,
                        "options": [
                            {
                                "label": "Draft",
                                "value": 1
                            },
                            {
                                "label": "Published",
                                "value": 2
                            }
                        ]
                    },
                    "tags": {
                        "type": "text",
                        "label": "Tags",
                        "index": 5,
                        "tooltip": "Comma-separated list of tags for the article."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "article",
            "options": [
                {
                    "label": "Article ID",
                    "value": "id",
                    "schema": {
                        "type": "integer",
                        "example": 5000321654
                    }
                },
                {
                    "label": "Title",
                    "value": "title",
                    "schema": {
                        "type": "string",
                        "example": "How to reset your password"
                    }
                },
                {
                    "label": "Description",
                    "value": "description",
                    "schema": {
                        "type": "string",
                        "example": "<p>Open Settings, then Security, and click Reset password.</p>"
                    }
                },
                {
                    "label": "Article Type",
                    "value": "articleType",
                    "schema": {
                        "type": "integer",
                        "example": 1
                    }
                },
                {
                    "label": "Folder ID",
                    "value": "folderId",
                    "schema": {
                        "type": "integer",
                        "example": 5000184301
                    }
                },
                {
                    "label": "Category ID",
                    "value": "categoryId",
                    "schema": {
                        "type": "integer",
                        "example": 5000184300
                    }
                },
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "integer",
                        "example": 2
                    }
                },
                {
                    "label": "Agent ID",
                    "value": "agentId",
                    "schema": {
                        "type": "integer",
                        "example": 5006713800
                    }
                },
                {
                    "label": "Tags",
                    "value": "tags",
                    "schema": {
                        "type": "array",
                        "example": [
                            "password",
                            "account"
                        ]
                    }
                },
                {
                    "label": "Created At",
                    "value": "createdAt",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00Z"
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updatedAt",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00Z"
                    }
                }
            ]
        }
    ]
}