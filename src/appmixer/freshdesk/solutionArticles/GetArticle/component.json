{
    "name": "appmixer.freshdesk.solutionArticles.GetArticle",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Get a solution article from Freshdesk.",
    "private": false,
    "auth": {
        "service": "appmixer:freshdesk"
    },
    "quota": {
        "manager": "appmixer:freshdesk",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "icon": "data:image/svg+xml;base64,",
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "articleId": {
                        "type": "string"
                    }
                },
                "required": [
                    "articleId"
                ]
            },
            "inspector": {
                "inputs": {
                    "articleId": {
                        "type": "text",
                        "label": "Article ID",
                        "index": 1,
                        "tooltip": "ID of the solution article. Required."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "article",
            "options": [
                {
                    "label": "Article ID",
                    "value": "id",
                    "schema": {
                        "type": "integer",
                        "example": 5000321654
                    }
                },
                {
                    "label": "Title",
                    "value": "title",
                    "schema": {
                        "type": "string",
                        "example": "How to reset your password"
                    }
                },
                {
                    "label": "Description",
                    "value": "description",
                    "schema": {
                        "type": "string",
                        "example": "<p>Open Settings, then Security, and click Reset password.</p>"
                    }
                },
                {
                    "label": "Article Type",
                    "value": "articleType",
                    "schema": {
                        "type": "integer",
                        "example": 1
                    }
                },
                {
                    "label": "Folder ID",
                    "value": "folderId",
                    "schema": {
                        "type": "integer",
                        "example": 5000184301
                    }
                },
                {
                    "label": "Category ID",
                    "value": "categoryId",
                    "schema": {
                        "type": "integer",
                        "example": 5000184300
                    }
                },
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "integer",
                        "example": 2
                    }
                },
                {
                    "label": "Agent ID",
                    "value": "agentId",
                    "schema": {
                        "type": "integer",
                        "example": 5006713800
                    }
                },
                {
                    "label": "Tags",
                    "value": "tags",
                    "schema": {
                        "type": "array",
                        "example": [
                            "password",
                            "account"
                        ]
                    }
                },
                {
                    "label": "Created At",
                    "value": "createdAt",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00Z"
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updatedAt",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T09:12:00Z"
                    }
                }
            ]
        }
    ]
}