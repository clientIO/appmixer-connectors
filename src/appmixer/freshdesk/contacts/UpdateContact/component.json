{
    "name": "appmixer.freshdesk.contacts.UpdateContact",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Update an existing contact in Freshdesk.",
    "private": false,
    "auth": {
        "service": "appmixer:freshdesk"
    },
    "quota": {
        "manager": "appmixer:freshdesk",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "contactId": { "type": "number" },
                    "name": { "type": "string" },
                    "email": { "type": "string" },
                    "phone": { "type": "string" },
                    "mobile": { "type": "string" },
                    "twitterId": { "type": "string" },
                    "uniqueExternalId": { "type": "string" },
                    "otherEmails": { "type": "string" },
                    "companyId": { "type": "number" },
                    "viewAllTickets": { "type": "boolean" },
                    "description": { "type": "string" },
                    "jobTitle": { "type": "string" },
                    "tags": { "type": "string" },
                    "address": { "type": "string" }
                },
                "required": ["contactId"]
            },
            "inspector": {
                "inputs": {
                    "contactId": {
                        "type": "number",
                        "label": "Contact ID",
                        "index": 1,
                        "group": "contactIdGroup",
                        "tooltip": "The ID of the contact to update."
                    },
                    "name": {
                        "type": "text",
                        "label": "Full Name",
                        "index": 1,
                        "group": "basic",
                        "tooltip": "Full name of the contact."
                    },
                    "email": {
                        "type": "text",
                        "label": "Email",
                        "index": 2,
                        "group": "basic",
                        "tooltip": "Primary email address of the contact."
                    },
                    "phone": {
                        "type": "text",
                        "label": "Phone",
                        "index": 3,
                        "group": "basic",
                        "tooltip": "Telephone number of the contact."
                    },
                    "mobile": {
                        "type": "text",
                        "label": "Mobile",
                        "index": 4,
                        "group": "basic",
                        "tooltip": "Mobile number of the contact."
                    },
                    "twitterId": {
                        "type": "text",
                        "label": "Twitter Handle",
                        "index": 5,
                        "group": "basic",
                        "tooltip": "Twitter handle of the contact."
                    },
                    "uniqueExternalId": {
                        "type": "text",
                        "label": "Unique External ID",
                        "index": 6,
                        "group": "basic",
                        "tooltip": "External ID to identify the contact uniquely in another system."
                    },
                    "otherEmails": {
                        "type": "text",
                        "label": "Other Emails",
                        "index": 7,
                        "group": "basic",
                        "tooltip": "Comma-separated list of additional email addresses."
                    },
                    "jobTitle": {
                        "type": "text",
                        "label": "Job Title",
                        "index": 1,
                        "group": "details",
                        "tooltip": "Job title of the contact."
                    },
                    "companyId": {
                        "type": "number",
                        "label": "Company ID",
                        "index": 2,
                        "group": "details",
                        "tooltip": "ID of the company to associate with this contact."
                    },
                    "viewAllTickets": {
                        "type": "toggle",
                        "label": "View All Tickets",
                        "index": 3,
                        "group": "details",
                        "tooltip": "Set to true if the contact can see all tickets from their company."
                    },
                    "address": {
                        "type": "text",
                        "label": "Address",
                        "index": 4,
                        "group": "details",
                        "tooltip": "Address of the contact."
                    },
                    "description": {
                        "type": "textarea",
                        "label": "Description",
                        "index": 5,
                        "group": "details",
                        "tooltip": "A short description of the contact."
                    },
                    "tags": {
                        "type": "text",
                        "label": "Tags",
                        "index": 6,
                        "group": "details",
                        "tooltip": "Comma-separated tags for this contact."
                    }
                },
                "groups": {
                    "contactIdGroup": {
                        "label": "Contact",
                        "index": 1
                    },
                    "basic": {
                        "label": "Basic Info",
                        "index": 2
                    },
                    "details": {
                        "label": "Additional Details",
                        "index": 3
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "contact",
            "options": [
                {
                    "label": "Contact ID",
                    "value": "id",
                    "schema": {
                        "type": "integer",
                        "example": 5006713841
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Jane Doe"
                    }
                },
                {
                    "label": "Email",
                    "value": "email",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "jane.doe@example.com"
                    }
                },
                {
                    "label": "Phone",
                    "value": "phone",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "+1 415 555 0100"
                    }
                },
                {
                    "label": "Mobile",
                    "value": "mobile",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "+1 415 555 0199"
                    }
                },
                {
                    "label": "Twitter Handle",
                    "value": "twitterId",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "Unique External ID",
                    "value": "uniqueExternalId",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "Company ID",
                    "value": "companyId",
                    "schema": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "example": 5000123456
                    }
                },
                {
                    "label": "View All Tickets",
                    "value": "viewAllTickets",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "Job Title",
                    "value": "jobTitle",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "CTO"
                    }
                },
                {
                    "label": "Description",
                    "value": "description",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "Address",
                    "value": "address",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "500 Howard St, San Francisco, CA 94105"
                    }
                },
                {
                    "label": "Tags",
                    "value": "tags",
                    "schema": {
                        "type": "array",
                        "example": [
                            "vip",
                            "renewal"
                        ]
                    }
                },
                {
                    "label": "Active",
                    "value": "active",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "Created At",
                    "value": "createdAt",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00Z"
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updatedAt",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-11T10:05:00Z"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
