{
    "name": "appmixer.freshdesk.contacts.ExportContacts",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Export contacts from Freshdesk to a CSV file. Initiates the export, waits for it to complete, then streams the file into Appmixer file storage and returns the file ID.",
    "private": false,
    "auth": {
        "service": "appmixer:freshdesk"
    },
    "quota": {
        "manager": "appmixer:freshdesk",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "defaultFields": { "type": "string" },
                    "customFields": { "type": "string" }
                }
            },
            "inspector": {
                "inputs": {
                    "defaultFields": {
                        "type": "text",
                        "label": "Default Fields",
                        "index": 1,
                        "tooltip": "Comma-separated list of default contact fields to include in the export. At least one of Default Fields or Custom Fields must be provided.<br><br>Allowed values: <code>name</code>, <code>email</code>, <code>phone</code>, <code>mobile</code>, <code>job_title</code>, <code>company_name</code>, <code>address</code>, <code>description</code>, <code>time_zone</code>, <code>language</code>, <code>twitter_id</code>, <code>twitter_profile_status</code>, <code>twitter_followers_count</code>, <code>social_handler</code>, <code>unique_external_id</code>, <code>tag_names</code>, <code>other_phone_numbers</code>, <code>client_manager</code>"
                    },
                    "customFields": {
                        "type": "text",
                        "label": "Custom Fields",
                        "index": 2,
                        "tooltip": "Comma-separated list of custom contact field names to include in the export. Use the field names as defined in your Freshdesk account (e.g. <code>department,region</code>). At least one of Default Fields or Custom Fields must be provided."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "File ID", "value": "fileId", "schema": { "type": "string", "example": "64f1c2e8a1b2c3d4e5f60718" } }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
