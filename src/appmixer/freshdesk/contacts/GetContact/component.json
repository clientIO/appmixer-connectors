{
    "name": "appmixer.freshdesk.contacts.GetContact",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Get a contact by ID from Freshdesk.",
    "private": false,
    "auth": {
        "service": "appmixer:freshdesk"
    },
    "quota": {
        "manager": "appmixer:freshdesk",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "contactId": { "type": "number" }
                },
                "required": ["contactId"]
            },
            "inspector": {
                "inputs": {
                    "contactId": {
                        "type": "number",
                        "label": "Contact ID",
                        "index": 1,
                        "tooltip": "The ID of the contact to retrieve."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "contact",
            "options": [
                {
                    "label": "Contact ID",
                    "value": "id",
                    "schema": {
                        "type": "integer",
                        "example": 5006713841
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Jane Doe"
                    }
                },
                {
                    "label": "Email",
                    "value": "email",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "jane.doe@example.com"
                    }
                },
                {
                    "label": "Phone",
                    "value": "phone",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "+1 415 555 0100"
                    }
                },
                {
                    "label": "Mobile",
                    "value": "mobile",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "+1 415 555 0199"
                    }
                },
                {
                    "label": "Twitter Handle",
                    "value": "twitterId",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "Unique External ID",
                    "value": "uniqueExternalId",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "Company ID",
                    "value": "companyId",
                    "schema": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "example": 5000123456
                    }
                },
                {
                    "label": "View All Tickets",
                    "value": "viewAllTickets",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Job Title",
                    "value": "jobTitle",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "Head of IT"
                    }
                },
                {
                    "label": "Description",
                    "value": "description",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "Address",
                    "value": "address",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "500 Howard St, San Francisco, CA 94105"
                    }
                },
                {
                    "label": "Tags",
                    "value": "tags",
                    "schema": {
                        "type": "array",
                        "example": [
                            "vip"
                        ]
                    }
                },
                {
                    "label": "Active",
                    "value": "active",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "Created At",
                    "value": "createdAt",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00Z"
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updatedAt",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T09:12:00Z"
                    }
                }
            ]
        },
        {
            "name": "notFound",
            "options": [
                {
                    "label": "Contact ID",
                    "value": "contactId",
                    "schema": {
                        "type": "integer",
                        "example": 5006713841
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
