{
    "name": "appmixer.freshdesk.tickets.CreateNote",
    "author": "Camilo Manrique <camilo@client.io>",
    "description": "Add a note to a Freshdesk ticket.",
    "private": false,
    "auth": {
        "service": "appmixer:freshdesk"
    },
    "quota": {
        "manager": "appmixer:freshdesk",
        "resources": "tickets.update",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "ticketId": {
                        "type": "number"
                    },
                    "body": {
                        "type": "string"
                    },
                    "agentId": {
                        "type": "number"
                    },
                    "private": {
                        "type": "boolean"
                    },
                    "notifyEmails": {
                        "type": "string"
                    }
                },
                "required": [
                    "ticketId",
                    "body"
                ]
            },
            "inspector": {
                "inputs": {
                    "ticketId": {
                        "type": "text",
                        "label": "Ticket ID",
                        "index": 1
                    },
                    "body": {
                        "type": "textarea",
                        "label": "Body",
                        "index": 2
                    },
                    "agentId": {
                        "type": "text",
                        "label": "Agent",
                        "index": 3,
                        "source": {
                            "url": "/component/appmixer/freshdesk/agents/ListAgents?outPort=agents",
                            "data": {
                                "transform": "./ListAgents#agentsToSelectArray"
                            }
                        }
                    },
                    "private": {
                        "type": "toggle",
                        "label": "Private",
                        "defaultValue": true,
                        "index": 4
                    },
                    "notifyEmails": {
                        "type": "text",
                        "label": "Notify Emails",
                        "tooltip": "Comma-separated email addresses to notify about this note",
                        "index": 5
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "newNote",
            "options": [
                {
                    "label": "Note ID",
                    "value": "id",
                    "schema": {
                        "type": "integer",
                        "example": 5000456789
                    }
                },
                {
                    "label": "Ticket ID",
                    "value": "ticketId",
                    "schema": {
                        "type": "integer",
                        "example": 1024
                    }
                },
                {
                    "label": "Body (HTML)",
                    "value": "body",
                    "schema": {
                        "type": "string",
                        "example": "<div>Called the customer, waiting for the logs.</div>"
                    }
                },
                {
                    "label": "Body (Text)",
                    "value": "bodyText",
                    "schema": {
                        "type": "string",
                        "example": "Called the customer, waiting for the logs."
                    }
                },
                {
                    "label": "Agent ID",
                    "value": "agentId",
                    "schema": {
                        "type": "integer",
                        "example": 5006713800
                    }
                },
                {
                    "label": "Private",
                    "value": "private",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "Created At",
                    "value": "createdAt",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00Z"
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updatedAt",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00Z"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}