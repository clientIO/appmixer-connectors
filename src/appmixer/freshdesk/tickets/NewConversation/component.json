{
    "name": "appmixer.freshdesk.tickets.NewConversation",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Triggers when a new conversation (reply or private note) is added to a ticket.",
    "private": false,
    "tick": true,
    "auth": {
        "service": "appmixer:freshdesk"
    },
    "quota": {
        "manager": "appmixer:freshdesk",
        "resources": "tickets.polling",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "ignoreAgents": {
                    "type": ["array", "string"]
                },
                "include": {
                    "type": ["array", "string"]
                }
            }
        },
        "inspector": {
            "inputs": {
                "include": {
                    "type": "multiselect",
                    "label": "Include",
                    "index": 1,
                    "defaultValue": ["conversations", "notes"],
                    "tooltip": "Choose which types of conversations to detect. <b>Conversations</b> are public replies; <b>Notes</b> are private notes. Both are selected by default.",
                    "options": [
                        { "label": "Conversations (replies)", "value": "conversations" },
                        { "label": "Notes (private)", "value": "notes" }
                    ]
                },
                "ignoreAgents": {
                    "type": "multiselect",
                    "label": "Ignore Agents",
                    "index": 2,
                    "tooltip": "If the new conversation was added by any of these agents, the trigger will not fire.",
                    "source": {
                        "url": "/component/appmixer/freshdesk/agents/ListAgents?outPort=agents",
                        "data": {
                            "transform": "./ListAgents#agentsToSelectArray"
                        }
                    }
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Conversation",
                    "value": "conversation",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "id": { "type": "number", "title": "Conversation.ID" },
                            "body": { "type": "string", "title": "Conversation.Body (HTML)" },
                            "body_text": { "type": "string", "title": "Conversation.Body (Text)" },
                            "ticket_id": { "type": "number", "title": "Conversation.Ticket ID" },
                            "user_id": { "type": "number", "title": "Conversation.User ID" },
                            "private": { "type": "boolean", "title": "Conversation.Private" },
                            "source": { "type": "number", "title": "Conversation.Source" },
                            "created_at": { "type": "string", "title": "Conversation.Created At" },
                            "updated_at": { "type": "string", "title": "Conversation.Updated At" }
                        },
                        "example": {
                            "id": 5024536,
                            "body": "<div>Thanks, the reset link worked.</div>",
                            "body_text": "Thanks, the reset link worked.",
                            "ticket_id": 1042,
                            "user_id": 5006713841,
                            "private": false,
                            "source": 0,
                            "created_at": "2026-09-10T08:30:00Z",
                            "updated_at": "2026-09-10T08:30:00Z"
                        }
                    }
                },
                {
                    "label": "Conversation Type",
                    "value": "conversationType",
                    "schema": {
                        "type": "string",
                        "example": "reply"
                    }
                },
                {
                    "label": "All Conversations",
                    "value": "conversationsList",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": { "type": "number", "title": "Conversation.ID" },
                                "body": { "type": "string", "title": "Conversation.Body (HTML)" },
                                "body_text": { "type": "string", "title": "Conversation.Body (Text)" },
                                "ticket_id": { "type": "number", "title": "Conversation.Ticket ID" },
                                "user_id": { "type": "number", "title": "Conversation.User ID" },
                                "private": { "type": "boolean", "title": "Conversation.Private" },
                                "source": { "type": "number", "title": "Conversation.Source" },
                                "created_at": { "type": "string", "title": "Conversation.Created At" },
                                "updated_at": { "type": "string", "title": "Conversation.Updated At" }
                            }
                        },
                        "example": [
                            {
                                "id": 5024536,
                                "body": "<div>Thanks, the reset link worked.</div>",
                                "body_text": "Thanks, the reset link worked.",
                                "ticket_id": 1042,
                                "user_id": 5006713841,
                                "private": false,
                                "source": 0,
                                "created_at": "2026-09-10T08:30:00Z",
                                "updated_at": "2026-09-10T08:30:00Z"
                            }
                        ]
                    }
                },
                {
                    "label": "Ticket",
                    "value": "ticket",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "id": { "type": "number", "title": "Ticket.ID" },
                            "subject": { "type": "string", "title": "Ticket.Subject" },
                            "status": { "type": "number", "title": "Ticket.Status" },
                            "priority": { "type": "number", "title": "Ticket.Priority" },
                            "type": { "type": "string", "title": "Ticket.Type" },
                            "responder_id": { "type": "number", "title": "Ticket.Agent ID" },
                            "requester_id": { "type": "number", "title": "Ticket.Requester ID" },
                            "group_id": { "type": "number", "title": "Ticket.Group ID" },
                            "due_by": { "type": "string", "title": "Ticket.Due By" },
                            "created_at": { "type": "string", "title": "Ticket.Created At" },
                            "updated_at": { "type": "string", "title": "Ticket.Updated At" }
                        },
                        "example": {
                            "id": 1042,
                            "subject": "Cannot reset my password",
                            "status": 2,
                            "priority": 1,
                            "type": "Question",
                            "responder_id": 5006713800,
                            "requester_id": 5006713841,
                            "group_id": 5000245123,
                            "due_by": "2026-09-12T08:00:00Z",
                            "created_at": "2026-09-09T15:02:00Z",
                            "updated_at": "2026-09-10T08:30:00Z"
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
