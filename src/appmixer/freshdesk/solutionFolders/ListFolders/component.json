{
    "name": "appmixer.freshdesk.solutionFolders.ListFolders",
    "author": "Appmixer <info@appmixer.com>",
    "description": "List all solution folders in a category in Freshdesk.",
    "private": false,
    "auth": {
        "service": "appmixer:freshdesk"
    },
    "quota": {
        "manager": "appmixer:freshdesk",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "icon": "data:image/svg+xml;base64,",
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "categoryId": {
                        "type": "string"
                    }
                },
                "required": [
                    "categoryId"
                ]
            },
            "inspector": {
                "inputs": {
                    "categoryId": {
                        "type": "text",
                        "label": "Category ID",
                        "index": 1,
                        "tooltip": "ID of the solution category to list folders from. Required."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "folders",
            "options": [
                {
                    "label": "Folders",
                    "value": "folders",
                    "schema": {
                        "type": "array",
                        "example": [
                            {
                                "id": 5000184301,
                                "name": "Account and billing",
                                "description": "Managing your account, invoices and payment methods",
                                "visibility": 1,
                                "created_at": "2026-01-12T09:30:00Z",
                                "updated_at": "2026-06-02T11:15:00Z"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}