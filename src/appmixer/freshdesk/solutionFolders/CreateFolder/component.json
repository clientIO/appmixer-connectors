{
    "name": "appmixer.freshdesk.solutionFolders.CreateFolder",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new solution folder in Freshdesk.",
    "private": false,
    "auth": {
        "service": "appmixer:freshdesk"
    },
    "quota": {
        "manager": "appmixer:freshdesk",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "icon": "data:image/svg+xml;base64,",
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "categoryId": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "visibility": {
                        "type": "number"
                    }
                },
                "required": [
                    "categoryId",
                    "name"
                ]
            },
            "inspector": {
                "inputs": {
                    "categoryId": {
                        "type": "text",
                        "label": "Category ID",
                        "index": 1,
                        "tooltip": "ID of the parent solution category. Required."
                    },
                    "name": {
                        "type": "text",
                        "label": "Name",
                        "index": 2,
                        "tooltip": "Name of the solution folder. Required."
                    },
                    "description": {
                        "type": "text",
                        "label": "Description",
                        "index": 3,
                        "tooltip": "Description of the solution folder."
                    },
                    "visibility": {
                        "type": "select",
                        "label": "Visibility",
                        "index": 4,
                        "tooltip": "Who can see this folder.",
                        "defaultValue": 1,
                        "options": [
                            {
                                "label": "All Visitors (Public)",
                                "value": 1
                            },
                            {
                                "label": "Logged-in Users",
                                "value": 2
                            },
                            {
                                "label": "Agents Only",
                                "value": 3
                            },
                            {
                                "label": "Selected Companies",
                                "value": 4
                            },
                            {
                                "label": "Bots",
                                "value": 5
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "folder",
            "options": [
                {
                    "label": "Folder ID",
                    "value": "id",
                    "schema": {
                        "type": "integer",
                        "example": 5000184301
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Account and billing"
                    }
                },
                {
                    "label": "Description",
                    "value": "description",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "Managing your account, invoices and payment methods"
                    }
                },
                {
                    "label": "Category ID",
                    "value": "categoryId",
                    "schema": {
                        "type": "integer",
                        "example": 5000184300
                    }
                },
                {
                    "label": "Visibility",
                    "value": "visibility",
                    "schema": {
                        "type": "integer",
                        "example": 1
                    }
                },
                {
                    "label": "Company IDs",
                    "value": "companyIds",
                    "schema": {
                        "type": [
                            "array",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "Position",
                    "value": "position",
                    "schema": {
                        "type": "integer",
                        "example": 1
                    }
                },
                {
                    "label": "Created At",
                    "value": "createdAt",
                    "schema": {
                        "type": "string",
                        "example": "2026-01-12T09:30:00Z"
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updatedAt",
                    "schema": {
                        "type": "string",
                        "example": "2026-01-12T09:30:00Z"
                    }
                }
            ]
        }
    ]
}