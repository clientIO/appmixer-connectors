{
    "name": "appmixer.sendgrid.core.DeleteList",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Delete a contact list.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:sendgrid"
    },
    "quota": {
        "manager": "appmixer:sendgrid",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "listId": {
                        "type": "string"
                    },
                    "deleteContacts": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "listId"
                ]
            },
            "inspector": {
                "inputs": {
                    "listId": {
                        "type": "select",
                        "label": "List",
                        "tooltip": "Select the contact list to delete.",
                        "index": 1,
                        "source": {
                            "url": "/component/appmixer/sendgrid/core/ListListsSelect?outPort=out",
                            "data": {
                                "transform": "./transformers#listsToSelectArray"
                            }
                        }
                    },
                    "deleteContacts": {
                        "type": "toggle",
                        "label": "Delete Contacts",
                        "tooltip": "Whether to delete all contacts on the list.",
                        "index": 2
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
