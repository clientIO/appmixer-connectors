{
    "name": "appmixer.sendgrid.core.UpsertContact",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new contact, or update the current one if it already exists (upsert).",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:sendgrid"
    },
    "quota": {
        "manager": "appmixer:sendgrid",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string"
                    },
                    "firstName": {
                        "type": "string"
                    },
                    "lastName": {
                        "type": "string"
                    },
                    "addressLine1": {
                        "type": "string"
                    },
                    "addressLine2": {
                        "type": "string"
                    },
                    "city": {
                        "type": "string"
                    },
                    "stateProvinceRegion": {
                        "type": "string"
                    },
                    "postalCode": {
                        "type": "string"
                    },
                    "country": {
                        "type": "string"
                    },
                    "alternateEmails": {
                        "type": "string"
                    },
                    "listIds": {
                        "type": "string"
                    }
                },
                "required": [
                    "email"
                ]
            },
            "inspector": {
                "inputs": {
                    "email": {
                        "type": "text",
                        "label": "Email",
                        "tooltip": "Primary email for the contact.",
                        "index": 1
                    },
                    "firstName": {
                        "type": "text",
                        "label": "First Name",
                        "tooltip": "First name of the contact.",
                        "index": 2
                    },
                    "lastName": {
                        "type": "text",
                        "label": "Last Name",
                        "tooltip": "Last name of the contact.",
                        "index": 3
                    },
                    "addressLine1": {
                        "type": "text",
                        "label": "Address Line 1",
                        "tooltip": "First line of the contact's address.",
                        "index": 4
                    },
                    "addressLine2": {
                        "type": "text",
                        "label": "Address Line 2",
                        "tooltip": "Second line of the contact's address.",
                        "index": 5
                    },
                    "city": {
                        "type": "text",
                        "label": "City",
                        "tooltip": "City of the contact.",
                        "index": 6
                    },
                    "stateProvinceRegion": {
                        "type": "text",
                        "label": "State/Province/Region",
                        "tooltip": "State, province, or region of the contact.",
                        "index": 7
                    },
                    "postalCode": {
                        "type": "text",
                        "label": "Postal Code",
                        "tooltip": "Postal code of the contact.",
                        "index": 8
                    },
                    "country": {
                        "type": "text",
                        "label": "Country",
                        "tooltip": "Country of the contact.",
                        "index": 9
                    },
                    "alternateEmails": {
                        "type": "text",
                        "label": "Alternate Emails",
                        "tooltip": "Comma-separated list of alternate email addresses.",
                        "index": 10
                    },
                    "listIds": {
                        "type": "text",
                        "label": "List IDs",
                        "tooltip": "Comma-separated list of contact list IDs to add the contact to.",
                        "index": 11
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Job ID",
                    "value": "job_id"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
