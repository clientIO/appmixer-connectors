{
    "name": "appmixer.sendgrid.core.SendEmail",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Send an email through SendGrid.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:sendgrid"
    },
    "quota": {
        "manager": "appmixer:sendgrid",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "fromEmail": {
                        "type": "string"
                    },
                    "fromName": {
                        "type": "string"
                    },
                    "toEmail": {
                        "type": "string"
                    },
                    "subject": {
                        "type": "string"
                    },
                    "contentType": {
                        "type": "string"
                    },
                    "content": {
                        "type": "string"
                    },
                    "ccEmail": {
                        "type": "string"
                    },
                    "bccEmail": {
                        "type": "string"
                    },
                    "replyToEmail": {
                        "type": "string"
                    },
                    "categories": {
                        "type": "string"
                    },
                    "sendAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "enableSandbox": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "fromEmail",
                    "toEmail",
                    "subject",
                    "content"
                ]
            },
            "inspector": {
                "inputs": {
                    "fromEmail": {
                        "type": "text",
                        "label": "Sender Email",
                        "tooltip": "Email address of the sender.",
                        "index": 1
                    },
                    "fromName": {
                        "type": "text",
                        "label": "Sender Name",
                        "tooltip": "Name of the sender.",
                        "index": 2
                    },
                    "toEmail": {
                        "type": "text",
                        "label": "Recipient Email",
                        "tooltip": "Comma-separated list of recipient email addresses.",
                        "index": 3
                    },
                    "subject": {
                        "type": "text",
                        "label": "Subject",
                        "tooltip": "Subject of the email.",
                        "index": 4
                    },
                    "contentType": {
                        "type": "select",
                        "label": "Content Type",
                        "tooltip": "MIME type of the email content.",
                        "index": 5,
                        "defaultValue": "text/plain",
                        "options": [
                            {
                                "label": "Plain Text",
                                "value": "text/plain"
                            },
                            {
                                "label": "HTML",
                                "value": "text/html"
                            }
                        ]
                    },
                    "content": {
                        "type": "textarea",
                        "label": "Message Body",
                        "tooltip": "The body content of the email.",
                        "index": 6
                    },
                    "ccEmail": {
                        "type": "text",
                        "label": "CC Email",
                        "tooltip": "Comma-separated list of CC recipient email addresses.",
                        "index": 7
                    },
                    "bccEmail": {
                        "type": "text",
                        "label": "BCC Email",
                        "tooltip": "Comma-separated list of BCC recipient email addresses.",
                        "index": 8
                    },
                    "replyToEmail": {
                        "type": "text",
                        "label": "Reply-To Email",
                        "tooltip": "Comma-separated list of reply-to email addresses.",
                        "index": 9
                    },
                    "categories": {
                        "type": "text",
                        "label": "Categories",
                        "tooltip": "Comma-separated list of categories. Each category name may not exceed 255 characters.",
                        "index": 10
                    },
                    "sendAt": {
                        "type": "date-time",
                        "label": "Send At",
                        "tooltip": "When to deliver the email. Scheduling more than 72 hours in advance is forbidden.",
                        "index": 11
                    },
                    "enableSandbox": {
                        "type": "toggle",
                        "label": "Enable Sandbox",
                        "tooltip": "Whether to use the sandbox for testing email-sending functionality.",
                        "index": 12
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Message ID",
                    "value": "messageId"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
