{
    "name": "appmixer.utils.rss.GetFeed",
    "author": "David Durman <david@client.io>",
    "description": "Get a RSS feed.",
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "url": { "type": "string", "format": "uri" }
                },
                "required": [ "url" ]
            },
            "inspector": {
                "inputs": {
                    "url": {
                        "type": "text",
                        "label": "URL",
                        "index": 1,
                        "tooltip": "A URL to a RSS feed. Example <code>https://www.nasa.gov/rss/dyn/breaking_news.rss</code>."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Feed",
                    "value": "feed",
                    "schema": {
                        "type": "object",
                        "example": {
                            "items": [
                                {
                                    "title": "Introducing the new reporting API",
                                    "link": "https://example.com/blog/new-reporting-api",
                                    "pubDate": "Fri, 15 Mar 2024 10:30:00 GMT",
                                    "content": "<p>Today we are releasing a new reporting API.</p>",
                                    "contentSnippet": "Today we are releasing a new reporting API.",
                                    "guid": "https://example.com/blog/?p=1001",
                                    "categories": [
                                        "Product",
                                        "API"
                                    ],
                                    "isoDate": "2024-03-15T10:30:00.000Z"
                                }
                            ],
                            "image": {
                                "link": "https://example.com/blog",
                                "url": "https://example.com/images/logo.png",
                                "title": "Example Blog"
                            },
                            "feedUrl": "https://example.com/blog/feed.xml",
                            "title": "Example Blog",
                            "description": "News and updates from the Example team",
                            "link": "https://example.com/blog",
                            "lastBuildDate": "Fri, 15 Mar 2024 10:30:00 GMT"
                        }
                    }
                },
                { "label": "Feed URL", "value": "feed.feedUrl", "schema": { "type": "string", "example": "https://example.com/blog/feed.xml" } },
                { "label": "Feed Title", "value": "feed.title", "schema": { "type": "string", "example": "Example Blog" } },
                {
                    "label": "Feed Description",
                    "value": "feed.description",
                    "schema": {
                        "type": "string",
                        "example": "News and updates from the Example team"
                    }
                },
                { "label": "Feed Link", "value": "feed.link", "schema": { "type": "string", "example": "https://example.com/blog" } },
                {
                    "label": "Feed Items",
                    "value": "feed.items",
                    "schema": {
                        "type": "array",
                        "example": [
                            {
                                "title": "Introducing the new reporting API",
                                "link": "https://example.com/blog/new-reporting-api",
                                "pubDate": "Fri, 15 Mar 2024 10:30:00 GMT",
                                "content": "<p>Today we are releasing a new reporting API.</p>",
                                "contentSnippet": "Today we are releasing a new reporting API.",
                                "guid": "https://example.com/blog/?p=1001",
                                "categories": [
                                    "Product",
                                    "API"
                                ],
                                "isoDate": "2024-03-15T10:30:00.000Z"
                            }
                        ]
                    }
                },
                { "label": "Feed Image Link", "value": "feed.image.link", "schema": { "type": "string", "example": "https://example.com/blog" } },
                { "label": "Feed Image URL", "value": "feed.image.url", "schema": { "type": "string", "example": "https://example.com/images/logo.png" } },
                { "label": "Feed Image Title", "value": "feed.image.title", "schema": { "type": "string", "example": "Example Blog" } }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
