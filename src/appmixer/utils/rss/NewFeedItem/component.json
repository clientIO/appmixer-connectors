{
    "name": "appmixer.utils.rss.NewFeedItem",
    "author": "David Durman <david@client.io>",
    "description": "Triger on new RSS feed item.",
    "tick": true,
    "properties": {
        "schema": {
            "properties": {
                "url": {
                    "type": "string",
                    "format": "uri"
                }
            },
            "required": [
                "url"
            ]
        },
        "inspector": {
            "inputs": {
                "url": {
                    "type": "text",
                    "label": "URL",
                    "index": 1,
                    "tooltip": "A URL to a RSS feed. Example <code>https://www.nasa.gov/rss/dyn/breaking_news.rss</code>."
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Title",
                    "value": "title",
                    "schema": {
                        "type": "string",
                        "example": "Introducing the new reporting API"
                    }
                },
                {
                    "label": "Link",
                    "value": "link",
                    "schema": {
                        "type": "string",
                        "example": "https://example.com/blog/new-reporting-api"
                    }
                },
                {
                    "label": "Publication Date",
                    "value": "pubDate",
                    "schema": {
                        "type": "string",
                        "example": "Fri, 15 Mar 2024 10:30:00 GMT"
                    }
                },
                {
                    "label": "Content",
                    "value": "content",
                    "schema": {
                        "type": "string",
                        "example": "<p>Today we are releasing a new reporting API.</p>"
                    }
                },
                {
                    "label": "Content Snippet",
                    "value": "contentSnippet",
                    "schema": {
                        "type": "string",
                        "example": "Today we are releasing a new reporting API."
                    }
                },
                {
                    "label": "GUID",
                    "value": "guid",
                    "schema": {
                        "type": "string",
                        "example": "https://example.com/blog/?p=1001"
                    }
                },
                {
                    "label": "Categories",
                    "value": "categories",
                    "schema": {
                        "type": "array",
                        "example": [
                            "Product",
                            "API"
                        ]
                    }
                },
                {
                    "label": "ISO Date",
                    "value": "isoDate",
                    "schema": {
                        "type": "string",
                        "example": "2024-03-15T10:30:00.000Z"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
