{
    "name": "appmixer.utils.storage.OnItemRemoved",
    "author": "Tomas Waldauf <tomas@client.io>",
    "description": "This trigger fires any time item is removed from storage.",
    "webhook": true,
    "private": false,
    "properties": {
        "schema": {
            "properties": {
                "storeId": {
                    "type": "string"
                }
            },
            "required": ["storeId"]
        },
        "inspector": {
            "inputs": {
                "storeId": {
                    "type": "select",
                    "label": "Storage",
                    "index": 1,
                    "source": {

                        "url": "/component/appmixer/utils/storage/ListStores?outPort=out",
                        "data": {
                            "transform": "./ListStores#toSelectArray"
                        }
                    },
                    "tooltip": "Select storage."
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "item",
            "options": [
                { "label": "Key", "value": "key", "schema": { "type": "string", "example": "order-1001" } },
                { "label": "Store Id", "value": "storeId", "schema": { "type": "string", "example": "63eba211974f513887b03d27" } },
                { "label": "Value", "value": "value", "schema": { "type": "string", "example": "shipped" } },
                { "label": "Updated at", "value": "updatedAt", "schema": { "type": "string", "example": "2024-03-15T11:45:00.000Z" } },
                { "label": "Created at", "value": "createdAt", "schema": { "type": "string", "example": "2024-03-15T10:30:00.000Z" } }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
