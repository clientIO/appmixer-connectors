{
    "name": "appmixer.utils.http.Uptime",
    "author": "David Durman <david@client.io>",
    "description": "Periodically checks if a site is up or down. Message is sent to output port when site's availability is changed (site goes up or down).",
    "tick": true,
    "outPorts": [
        {
            "name": "up",
            "options": [
                {
                    "label": "Target URL",
                    "value": "target",
                    "schema": {
                        "type": "string",
                        "example": "https://www.example.com/"
                    }
                },
                {
                    "label": "Down time (ms)",
                    "value": "downTimeMs",
                    "schema": {
                        "type": "integer",
                        "example": 300000
                    }
                },
                {
                    "label": "Down time (text)",
                    "value": "downTimeText",
                    "schema": {
                        "type": "string",
                        "example": "5 minutes"
                    }
                },
                {
                    "label": "Status code",
                    "value": "statusCode",
                    "schema": {
                        "type": "integer",
                        "example": 200
                    }
                }
            ]
        },
        {
            "name": "down",
            "options": [
                {
                    "label": "Target URL",
                    "value": "target",
                    "schema": {
                        "type": "string",
                        "example": "https://www.example.com/"
                    }
                },
                {
                    "label": "Status code",
                    "value": "statusCode",
                    "schema": {
                        "type": "integer",
                        "example": 503
                    }
                }
            ]
        }
    ],
    "properties": {
        "schema": {
            "properties": {
                "target": {
                    "type": "string",
                    "format": "uri"
                }
            },
            "required": [
                "target"
            ]
        },
        "inspector": {
            "inputs": {
                "target": {
                    "type": "text",
                    "label": "Site URL",
                    "index": 1,
                    "tooltip": "A site URL to check for uptime. Must start with either http:// or https:// protocol."
                }
            }
        }
    },
    "icon": "data:image/svg+xml;base64,"
}
