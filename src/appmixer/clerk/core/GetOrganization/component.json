{
    "name": "appmixer.clerk.core.GetOrganization",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieve details of a specific organization by its unique identifier.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:clerk"
    },
    "quota": {
        "manager": "appmixer:clerk",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    }
                },
                "required": [
                    "id"
                ]
            },
            "inspector": {
                "inputs": {
                    "id": {
                        "type": "text",
                        "tooltip": "Unique identifier of the organization.",
                        "label": "Organization ID",
                        "index": 0
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "org_2c9aJGKx3b4mZF1"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Acme Corporation"
                    }
                },
                {
                    "label": "Metadata",
                    "value": "metadata",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "industry": {
                                "type": "string",
                                "title": "Metadata.Industry"
                            }
                        },
                        "example": {
                            "plan": "enterprise"
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
