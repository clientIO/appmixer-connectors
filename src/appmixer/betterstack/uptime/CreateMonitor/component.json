{
    "name": "appmixer.betterstack.uptime.CreateMonitor",
    "description": "Create a new Better Stack Uptime monitor.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:betterstack"
    },
    "quota": {
        "manager": "appmixer:betterstack",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "monitorName": {
                        "type": "string"
                    },
                    "url": {
                        "type": "string"
                    },
                    "monitorType": {
                        "type": "string"
                    },
                    "checkFrequency": {
                        "type": "integer"
                    },
                    "paused": {
                        "type": "boolean"
                    },
                    "email": {
                        "type": "boolean"
                    },
                    "sms": {
                        "type": "boolean"
                    },
                    "call": {
                        "type": "boolean"
                    },
                    "push": {
                        "type": "boolean"
                    },
                    "regions": {
                        "type": "string"
                    },
                    "verifySSL": {
                        "type": "boolean"
                    },
                    "requiredKeyword": {
                        "type": "string"
                    },
                    "recoveryPeriod": {
                        "type": "integer"
                    },
                    "confirmationPeriod": {
                        "type": "integer"
                    },
                    "requestTimeout": {
                        "type": "integer"
                    },
                    "httpMethod": {
                        "type": "string"
                    },
                    "followRedirects": {
                        "type": "boolean"
                    },
                    "port": {
                        "type": "integer"
                    }
                },
                "required": [
                    "monitorName",
                    "url"
                ]
            },
            "inspector": {
                "inputs": {
                    "monitorName": {
                        "type": "text",
                        "label": "Monitor Name",
                        "index": 1,
                        "tooltip": "A human-readable name for this monitor."
                    },
                    "url": {
                        "type": "text",
                        "label": "URL",
                        "index": 2,
                        "tooltip": "The URL to monitor."
                    },
                    "monitorType": {
                        "type": "select",
                        "label": "Monitor Type",
                        "index": 3,
                        "defaultValue": "status",
                        "tooltip": "How to determine whether the monitor is up or down.",
                        "options": [
                            { "label": "Status", "value": "status" },
                            { "label": "Expected Status Code", "value": "expected_status_code" },
                            { "label": "Keyword", "value": "keyword" },
                            { "label": "Keyword Absent", "value": "keyword_absent" },
                            { "label": "Ping", "value": "ping" },
                            { "label": "TCP", "value": "tcp" },
                            { "label": "UDP", "value": "udp" },
                            { "label": "SMTP", "value": "smtp" },
                            { "label": "POP", "value": "pop" },
                            { "label": "IMAP", "value": "imap" }
                        ]
                    },
                    "checkFrequency": {
                        "type": "number",
                        "label": "Check Frequency (seconds)",
                        "index": 4,
                        "tooltip": "How often to check the URL. Minimum 30 seconds."
                    },
                    "httpMethod": {
                        "type": "select",
                        "label": "HTTP Method",
                        "index": 5,
                        "options": [
                            { "label": "GET", "value": "GET" },
                            { "label": "POST", "value": "POST" },
                            { "label": "PUT", "value": "PUT" },
                            { "label": "PATCH", "value": "PATCH" },
                            { "label": "DELETE", "value": "DELETE" },
                            { "label": "HEAD", "value": "HEAD" },
                            { "label": "OPTIONS", "value": "OPTIONS" }
                        ]
                    },
                    "requiredKeyword": {
                        "type": "text",
                        "label": "Required Keyword",
                        "index": 6,
                        "tooltip": "Required for keyword monitor type. The keyword to search for in the response body."
                    },
                    "requestTimeout": {
                        "type": "number",
                        "label": "Request Timeout (seconds)",
                        "index": 7,
                        "tooltip": "How long to wait for a response before considering the monitor down."
                    },
                    "recoveryPeriod": {
                        "type": "number",
                        "label": "Recovery Period (seconds)",
                        "index": 8,
                        "tooltip": "How long the monitor must be up before sending a recovery notification."
                    },
                    "confirmationPeriod": {
                        "type": "number",
                        "label": "Confirmation Period (seconds)",
                        "index": 9,
                        "tooltip": "How long the monitor must be down before an incident is created."
                    },
                    "regions": {
                        "type": "text",
                        "label": "Regions",
                        "index": 10,
                        "tooltip": "Comma-separated list of regions to check from (e.g. us,eu,as,au)."
                    },
                    "port": {
                        "type": "number",
                        "label": "Port",
                        "index": 11,
                        "tooltip": "Required for TCP, UDP, SMTP, POP, IMAP monitor types."
                    },
                    "verifySSL": {
                        "type": "toggle",
                        "label": "Verify SSL",
                        "index": 12,
                        "tooltip": "Whether to verify the SSL certificate."
                    },
                    "followRedirects": {
                        "type": "toggle",
                        "label": "Follow Redirects",
                        "index": 13
                    },
                    "email": {
                        "type": "toggle",
                        "label": "Notify via Email",
                        "index": 14
                    },
                    "sms": {
                        "type": "toggle",
                        "label": "Notify via SMS",
                        "index": 15
                    },
                    "call": {
                        "type": "toggle",
                        "label": "Notify via Call",
                        "index": 16
                    },
                    "push": {
                        "type": "toggle",
                        "label": "Notify via Push",
                        "index": 17
                    },
                    "paused": {
                        "type": "toggle",
                        "label": "Paused",
                        "index": 18
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Monitor ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "2145078"
                    }
                },
                {
                    "label": "Monitor Name",
                    "value": "pronounceable_name",
                    "schema": {
                        "type": "string",
                        "example": "Acme homepage"
                    }
                },
                {
                    "label": "URL",
                    "value": "url",
                    "schema": {
                        "type": "string",
                        "example": "https://acme.example.com"
                    }
                },
                {
                    "label": "Monitor Type",
                    "value": "monitor_type",
                    "schema": {
                        "type": "string",
                        "example": "status"
                    }
                },
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "string",
                        "example": "pending"
                    }
                },
                {
                    "label": "Paused",
                    "value": "paused",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Check Frequency (s)",
                    "value": "check_frequency",
                    "schema": {
                        "type": "integer",
                        "example": 180
                    }
                },
                {
                    "label": "HTTP Method",
                    "value": "http_method",
                    "schema": {
                        "type": "string",
                        "example": "get"
                    }
                },
                {
                    "label": "Required Keyword",
                    "value": "required_keyword",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "Request Timeout (s)",
                    "value": "request_timeout",
                    "schema": {
                        "type": "integer",
                        "example": 30
                    }
                },
                {
                    "label": "Recovery Period (s)",
                    "value": "recovery_period",
                    "schema": {
                        "type": "integer",
                        "example": 180
                    }
                },
                {
                    "label": "Confirmation Period (s)",
                    "value": "confirmation_period",
                    "schema": {
                        "type": "integer",
                        "example": 0
                    }
                },
                {
                    "label": "Regions",
                    "value": "regions",
                    "schema": {
                        "type": "array",
                        "example": [
                            "us",
                            "eu",
                            "as",
                            "au"
                        ]
                    }
                },
                {
                    "label": "Verify SSL",
                    "value": "verify_ssl",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "Follow Redirects",
                    "value": "follow_redirects",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "Email Notifications",
                    "value": "email",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "SMS Notifications",
                    "value": "sms",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Call Notifications",
                    "value": "call",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Push Notifications",
                    "value": "push",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "Last Checked At",
                    "value": "last_checked_at",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00.000Z"
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updated_at",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00.000Z"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
