{
    "name": "appmixer.betterstack.uptime.GetMonitor",
    "description": "Get a Better Stack Uptime monitor by ID.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:betterstack"
    },
    "quota": {
        "manager": "appmixer:betterstack",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "monitorId": {
                        "type": "string"
                    }
                },
                "required": [
                    "monitorId"
                ]
            },
            "inspector": {
                "inputs": {
                    "monitorId": {
                        "type": "text",
                        "label": "Monitor ID",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Monitor ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "2145078"
                    }
                },
                {
                    "label": "Monitor Name",
                    "value": "pronounceable_name",
                    "schema": {
                        "type": "string",
                        "example": "Acme homepage"
                    }
                },
                {
                    "label": "URL",
                    "value": "url",
                    "schema": {
                        "type": "string",
                        "example": "https://acme.example.com"
                    }
                },
                {
                    "label": "Monitor Type",
                    "value": "monitor_type",
                    "schema": {
                        "type": "string",
                        "example": "status"
                    }
                },
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "string",
                        "example": "up"
                    }
                },
                {
                    "label": "Paused",
                    "value": "paused",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Check Frequency (s)",
                    "value": "check_frequency",
                    "schema": {
                        "type": "integer",
                        "example": 180
                    }
                },
                {
                    "label": "HTTP Method",
                    "value": "http_method",
                    "schema": {
                        "type": "string",
                        "example": "get"
                    }
                },
                {
                    "label": "Required Keyword",
                    "value": "required_keyword",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "Request Timeout (s)",
                    "value": "request_timeout",
                    "schema": {
                        "type": "integer",
                        "example": 30
                    }
                },
                {
                    "label": "Recovery Period (s)",
                    "value": "recovery_period",
                    "schema": {
                        "type": "integer",
                        "example": 180
                    }
                },
                {
                    "label": "Confirmation Period (s)",
                    "value": "confirmation_period",
                    "schema": {
                        "type": "integer",
                        "example": 0
                    }
                },
                {
                    "label": "Regions",
                    "value": "regions",
                    "schema": {
                        "type": "array",
                        "example": [
                            "us",
                            "eu",
                            "as",
                            "au"
                        ]
                    }
                },
                {
                    "label": "Verify SSL",
                    "value": "verify_ssl",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "Follow Redirects",
                    "value": "follow_redirects",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "Email Notifications",
                    "value": "email",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "SMS Notifications",
                    "value": "sms",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Call Notifications",
                    "value": "call",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Push Notifications",
                    "value": "push",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "Last Checked At",
                    "value": "last_checked_at",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "2026-09-10T08:35:12.000Z"
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00.000Z"
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updated_at",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00.000Z"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
