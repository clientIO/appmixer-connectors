{
    "name": "appmixer.betterstack.statuspages.GetStatusPage",
    "description": "Retrieve a specific status page by ID from Better Stack Uptime.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:betterstack"
    },
    "quota": {
        "manager": "appmixer:betterstack",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "statusPageId": { "type": "string" }
                },
                "required": ["statusPageId"]
            },
            "inspector": {
                "inputs": {
                    "statusPageId": {
                        "type": "text",
                        "index": 1,
                        "label": "Status Page ID",
                        "tooltip": "The ID of the status page to retrieve"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Status Page ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "175203"
                    }
                },
                {
                    "label": "Company Name",
                    "value": "company_name",
                    "schema": {
                        "type": "string",
                        "example": "Acme Inc"
                    }
                },
                {
                    "label": "Company URL",
                    "value": "company_url",
                    "schema": {
                        "type": "string",
                        "example": "https://acme.example.com"
                    }
                },
                {
                    "label": "Contact URL",
                    "value": "contact_url",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "https://acme.example.com/support"
                    }
                },
                {
                    "label": "Logo URL",
                    "value": "logo_url",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "https://acme.example.com/logo.png"
                    }
                },
                {
                    "label": "Timezone",
                    "value": "timezone",
                    "schema": {
                        "type": "string",
                        "example": "Eastern Time (US & Canada)"
                    }
                },
                {
                    "label": "Subdomain",
                    "value": "subdomain",
                    "schema": {
                        "type": "string",
                        "example": "acme"
                    }
                },
                {
                    "label": "Custom Domain",
                    "value": "custom_domain",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "status.acme.example.com"
                    }
                },
                {
                    "label": "Custom CSS",
                    "value": "custom_css",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "Custom JavaScript",
                    "value": "custom_javascript",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "Google Analytics ID",
                    "value": "google_analytics_id",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "Min Incident Length",
                    "value": "min_incident_length",
                    "schema": {
                        "type": "integer",
                        "example": 0
                    }
                },
                {
                    "label": "Announcement",
                    "value": "announcement",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "Scheduled maintenance on Saturday, 22:00-23:00 UTC."
                    }
                },
                {
                    "label": "Announcement Embed Visible",
                    "value": "announcement_embed_visible",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "Announcement Embed CSS",
                    "value": "announcement_embed_css",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "Announcement Embed Link",
                    "value": "announcement_embed_link",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "https://status.acme.example.com"
                    }
                },
                {
                    "label": "Automatic Reports",
                    "value": "automatic_reports",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Status Page Group ID",
                    "value": "status_page_group_id",
                    "schema": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "Subscribable",
                    "value": "subscribable",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "Hide from Search Engines",
                    "value": "hide_from_search_engines",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Password Enabled",
                    "value": "password_enabled",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "History Days",
                    "value": "history",
                    "schema": {
                        "type": "integer",
                        "example": 90
                    }
                },
                {
                    "label": "Aggregate State",
                    "value": "aggregate_state",
                    "schema": {
                        "type": "string",
                        "example": "operational"
                    }
                },
                {
                    "label": "Design",
                    "value": "design",
                    "schema": {
                        "type": "string",
                        "example": "v2"
                    }
                },
                {
                    "label": "Theme",
                    "value": "theme",
                    "schema": {
                        "type": "string",
                        "example": "light"
                    }
                },
                {
                    "label": "Layout",
                    "value": "layout",
                    "schema": {
                        "type": "string",
                        "example": "vertical"
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00.000Z"
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updated_at",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T09:12:44.000Z"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
