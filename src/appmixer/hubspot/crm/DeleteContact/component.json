{
    "name": "appmixer.hubspot.crm.DeleteContact",
    "author": "Zulkafil Tabish <zulkafil@client.io>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Delete a contact.",
    "private": false,
    "auth": {
        "service": "appmixer:hubspot"
    },
    "quota": {
        "manager": "appmixer:hubspot",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "contactId": {
                        "type": "string"
                    }
                },
                "required": [
                    "contactId"
                ]
            },
            "inspector": {
                "inputs": {
                    "contactId": {
                        "type": "text",
                        "label": "Contact ID",
                        "tooltip": "The contact ID.",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Contact ID",
                    "value": "contactId",
                    "schema": {
                        "type": "string",
                        "example": "151"
                    }
                }
            ]
        }
    ],
    "version": "1.0.1",
    "dependencies": {
        "service": "1.0.1"
    }
}
