{
    "name": "appmixer.hubspot.crm.UpdateDeal",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Update a deal.",
    "version": "1.0.3",
    "private": false,
    "auth": {
        "service": "appmixer:hubspot"
    },
    "quota": {
        "manager": "appmixer:hubspot",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "dealId": {
                        "type": "string"
                    },
                    "dealname": {
                        "type": "string"
                    },
                    "dealstage": {
                        "type": "string"
                    },
                    "pipeline": {
                        "type": "string"
                    },
                    "hubSpotOwnerId": {
                        "type": "string"
                    },
                    "closedate": {
                        "type": "string"
                    },
                    "amount": {
                        "type": "string"
                    },
                    "additionalProperties": {
                        "type": "object"
                    }
                },
                "required": [
                    "dealId"
                ]
            },
            "inspector": {
                "inputs": {
                    "dealId": {
                        "type": "text",
                        "label": "Deal ID",
                        "tooltip": "Deal ID",
                        "index": 1
                    },
                    "dealname": {
                        "type": "text",
                        "label": "Deal Name",
                        "tooltip": "Deal Name.",
                        "index": 2
                    },
                    "pipeline": {
                        "type": "text",
                        "label": "Pipeline",
                        "tooltip": "If the pipeline property is not specified, the default pipeline is assumed. However, it is recommended to always specify the pipeline, especially on accounts with multiple pipelines.",
                        "source": {
                            "url": "/component/appmixer/hubspot/crm/ListPipelines?outPort=out",
                            "data": {
                                "messages": {
                                    "in/objectType": "deals"
                                },
                                "transform": "./ListPipelines#toSelectArray"
                            }
                        },
                        "index": 3
                    },
                    "dealstage": {
                        "type": "text",
                        "label": "Deal Stage",
                        "tooltip": "Deal Stage. Select a pipeline first to see available stages.",
                        "source": {
                            "url": "/component/appmixer/hubspot/crm/ListPipelineStages?outPort=out",
                            "data": {
                                "messages": {
                                    "in/pipelineId": "inputs/in/pipeline",
                                    "in/isSource": true
                                },
                                "transform": "./ListPipelineStages#toSelectArray"
                            }
                        },
                        "index": 4
                    },
                    "hubSpotOwnerId": {
                        "type": "text",
                        "label": "Owner ID",
                        "tooltip": "Owner ID.",
                        "index": 5
                    },
                    "closedate": {
                        "type": "date-time",
                        "label": "Close Date",
                        "tooltip": "Close Date.",
                        "index": 6
                    },
                    "amount": {
                        "type": "text",
                        "label": "Amount",
                        "tooltip": "Amount.",
                        "index": 7
                    },
                    "additionalProperties": {
                        "type": "expression",
                        "label": "Additional Properties",
                        "tooltip": "Addition HubSpot or custom properties to add to the deal.",
                        "exclusiveFields": [
                            "name"
                        ],
                        "index": 8,
                        "levels": [
                            "AND"
                        ],
                        "fields": {
                            "name": {
                                "type": "select",
                                "label": "Property",
                                "tooltip": "The property to add to the deal.",
                                "index": 1,
                                "source": {
                                    "url": "/component/appmixer/hubspot/crm/GetDealsProperties?outPort=out",
                                    "data": {
                                        "transform": "./GetDealsProperties#additionalFieldsToSelectArray"
                                    }
                                }
                            },
                            "value": {
                                "type": "text",
                                "label": "Value",
                                "tooltip": "The value for the property.",
                                "index": 2
                            }
                        }
                    }
                },
                "groups": {
                    "associations": {
                        "label": "Associations",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "updateDeal",
            "source": {
                "url": "/component/appmixer/hubspot/crm/GetDealsProperties?outPort=out",
                "data": {
                    "transform": "./GetDealsProperties#dealToSelectArray",
                    "messages": {
                        "in/dealId": "dummy"
                    }
                }
            }
        },
        {
            "name": "notUpdated",
            "options": [
                {
                    "label": "Deal ID",
                    "value": "dealId",
                    "schema": {
                        "type": "string",
                        "example": "931201"
                    }
                }
            ]
        }
    ],
    "dependencies": {
        "service": "1.0.1"
    }
}
