{
    "name": "appmixer.hubspot.crm.DeletedContact",
    "icon": "data:image/svg+xml;base64,",
    "description": "Triggers when a contact is deleted",
    "author": "Vladimir Talas <lades@client.io>",
    "webhook": true,
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:hubspot"
    },
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Deleted at",
                    "value": "occurredAt",
                    "schema": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-07-24T12:00:00.000Z"
                    }
                },
                {
                    "label": "Contact Id",
                    "value": "objectId",
                    "schema": {
                        "type": "string",
                        "example": "151"
                    }
                }
            ]
        }
    ],
    "dependencies": {
        "service": "1.0.1"
    }
}
