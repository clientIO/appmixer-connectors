{
    "name": "appmixer.hubspot.crm.FormSubmission",
    "icon": "data:image/svg+xml;base64,",
    "description": "Triggers when a form is submitted in HubSpot.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:hubspot"
    },
    "quota": {
        "manager": "appmixer:hubspot",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "properties": {
        "schema": {
            "properties": {
                "formId": {
                    "type": "string"
                }
            },
            "required": [
                "formId"
            ]
        },
        "inspector": {
            "inputs": {
                "formId": {
                    "type": "text",
                    "label": "Form ID",
                    "tooltip": "Select the HubSpot form to watch for new submissions.",
                    "index": 1,
                    "source": {
                        "url": "/component/appmixer/hubspot/crm/ListForms?outPort=out",
                        "data": {
                            "transform": "./ListForms#formsToSelectArray"
                        }
                    }
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "submission",
            "options": [
                {
                    "label": "Form ID",
                    "value": "formId",
                    "schema": {
                        "type": "string",
                        "example": "a2c3e5f7-1b2d-4e6f-8a9b-0c1d2e3f4a5b"
                    }
                },
                {
                    "label": "Submitted At (epoch ms)",
                    "value": "submittedAt",
                    "schema": {
                        "type": "number",
                        "example": 1784548800000
                    }
                },
                {
                    "label": "Page URL",
                    "value": "pageUrl",
                    "schema": {
                        "type": "string",
                        "example": "https://www.example.com/contact-us"
                    }
                },
                {
                    "label": "Page Name",
                    "value": "pageName",
                    "schema": {
                        "type": "string",
                        "example": "Contact Us"
                    }
                },
                {
                    "label": "Portal ID",
                    "value": "portalId",
                    "schema": {
                        "type": "number",
                        "example": 12345678
                    }
                },
                {
                    "label": "Values",
                    "value": "values",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": "string"
                                },
                                "value": {
                                    "type": "string"
                                }
                            }
                        },
                        "example": [
                            {
                                "name": "email",
                                "value": "jane.doe@example.com"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
