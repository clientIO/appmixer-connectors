{
    "name": "appmixer.hubspot.crm.CreateContact",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Create a new contact.",
    "private": false,
    "auth": {
        "service": "appmixer:hubspot"
    },
    "quota": {
        "manager": "appmixer:hubspot",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string"
                    },
                    "firstname": {
                        "type": "string"
                    },
                    "lastname": {
                        "type": "string"
                    },
                    "website": {
                        "type": "string"
                    },
                    "company": {
                        "type": "string"
                    },
                    "phone": {
                        "type": "string"
                    },
                    "address": {
                        "type": "string"
                    },
                    "city": {
                        "type": "string"
                    },
                    "state": {
                        "type": "string"
                    },
                    "zip": {
                        "type": "string"
                    },
                    "additionalProperties": {
                        "type": "object"
                    }
                },
                "required": [
                    "email"
                ]
            },
            "inspector": {
                "inputs": {
                    "email": {
                        "type": "text",
                        "label": "Email",
                        "tooltip": "The contact's email.",
                        "index": 1
                    },
                    "firstname": {
                        "type": "text",
                        "label": "First name",
                        "tooltip": "The contact's first name.",
                        "index": 2
                    },
                    "lastname": {
                        "type": "text",
                        "label": "Last name",
                        "tooltip": "The contact's last name.",
                        "index": 3
                    },
                    "phone": {
                        "type": "text",
                        "label": "Phone",
                        "tooltip": "The contact's phone number.",
                        "index": 4
                    },
                    "website": {
                        "type": "text",
                        "label": "Website",
                        "tooltip": "The contact's website.",
                        "index": 5
                    },
                    "company": {
                        "type": "text",
                        "label": "Company",
                        "tooltip": "The contact's company.",
                        "index": 6
                    },
                    "address": {
                        "type": "text",
                        "label": "Address",
                        "tooltip": "The contact's address.",
                        "index": 7
                    },
                    "city": {
                        "type": "text",
                        "label": "City",
                        "tooltip": "The contact's city.",
                        "index": 8
                    },
                    "state": {
                        "type": "text",
                        "label": "State",
                        "tooltip": "The contact's state.",
                        "index": 9
                    },
                    "zip": {
                        "type": "text",
                        "label": "Zip",
                        "tooltip": "The contact's zip.",
                        "index": 10
                    },
                    "additionalProperties": {
                        "type": "expression",
                        "label": "Additional Properties",
                        "tooltip": "Addition HubSpot or custom properties to add to the contact.",
                        "exclusiveFields": [
                            "name"
                        ],
                        "index": 11,
                        "levels": [
                            "AND"
                        ],
                        "fields": {
                            "name": {
                                "type": "select",
                                "label": "Property",
                                "tooltip": "The property to add to the contact.",
                                "index": 1,
                                "source": {
                                    "url": "/component/appmixer/hubspot/crm/GetContactsProperties?outPort=out",
                                    "data": {
                                        "transform": "./GetContactsProperties#additionalFieldsToSelectArray"
                                    }
                                }
                            },
                            "value": {
                                "type": "text",
                                "label": "Value",
                                "tooltip": "The value for the property.",
                                "index": 2
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "contact",
            "options": [
                {
                    "label": "Contact ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "151"
                    }
                },
                {
                    "label": "Email",
                    "value": "email",
                    "schema": {
                        "type": "string",
                        "example": "jane.doe@example.com"
                    }
                },
                {
                    "label": "Website",
                    "value": "website",
                    "schema": {
                        "type": "string",
                        "example": "https://www.example.com"
                    }
                },
                {
                    "label": "First Name",
                    "value": "firstname",
                    "schema": {
                        "type": "string",
                        "example": "Jane"
                    }
                },
                {
                    "label": "Last Name",
                    "value": "lastname",
                    "schema": {
                        "type": "string",
                        "example": "Doe"
                    }
                },
                {
                    "label": "Phone",
                    "value": "phone",
                    "schema": {
                        "type": "string",
                        "example": "+15551234567"
                    }
                },
                {
                    "label": "Address",
                    "value": "address",
                    "schema": {
                        "type": "string",
                        "example": "25 First Street"
                    }
                },
                {
                    "label": "State",
                    "value": "state",
                    "schema": {
                        "type": "string",
                        "example": "MA"
                    }
                },
                {
                    "label": "City",
                    "value": "city",
                    "schema": {
                        "type": "string",
                        "example": "Cambridge"
                    }
                },
                {
                    "label": "Zip",
                    "value": "zip",
                    "schema": {
                        "type": "string",
                        "example": "02141"
                    }
                }
            ]
        }
    ],
    "version": "1.0.2",
    "dependencies": {
        "service": "1.0.1"
    }
}
