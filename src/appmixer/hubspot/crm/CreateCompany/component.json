{
    "name": "appmixer.hubspot.crm.CreateCompany",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Create a new company in HubSpot CRM.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:hubspot"
    },
    "quota": {
        "manager": "appmixer:hubspot",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "dependencies": {
        "service": "1.0.1"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "domain": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "numberofemployees": {
                        "type": "string"
                    },
                    "industry": {
                        "type": "string"
                    },
                    "additionalProperties": {
                        "type": "object"
                    }
                },
                "required": [
                    "domain"
                ]
            },
            "inspector": {
                "inputs": {
                    "domain": {
                        "type": "text",
                        "label": "Domain",
                        "tooltip": "The company's domain (required).",
                        "index": 1
                    },
                    "name": {
                        "type": "text",
                        "label": "Company Name",
                        "tooltip": "The company's name.",
                        "index": 2
                    },
                    "numberofemployees": {
                        "type": "text",
                        "label": "Number of Employees",
                        "tooltip": "Total number of employees.",
                        "index": 3
                    },
                    "industry": {
                        "type": "text",
                        "label": "Industry",
                        "tooltip": "The company's industry.",
                        "index": 4
                    },
                    "additionalProperties": {
                        "type": "expression",
                        "label": "Additional Properties",
                        "tooltip": "Additional HubSpot or custom properties to add to the company.",
                        "exclusiveFields": [
                            "name"
                        ],
                        "index": 5,
                        "levels": [
                            "AND"
                        ],
                        "fields": {
                            "name": {
                                "type": "select",
                                "label": "Property",
                                "tooltip": "The property to add to the company.",
                                "index": 1,
                                "source": {
                                    "url": "/component/appmixer/hubspot/crm/GetCompaniesProperties?outPort=out",
                                    "data": {
                                        "transform": "./GetCompaniesProperties#additionalFieldsToSelectArray"
                                    }
                                }
                            },
                            "value": {
                                "type": "text",
                                "label": "Value",
                                "tooltip": "The value for the property.",
                                "index": 2
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/hubspot/crm/GetCompaniesProperties?outPort=out",
                "data": {
                    "transform": "./GetCompaniesProperties#companyToSelectArray",
                    "messages": {
                        "in/domain": "dummy"
                    }
                }
            }
        }
    ]
}
