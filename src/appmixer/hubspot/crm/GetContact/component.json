{
    "name": "appmixer.hubspot.crm.GetContact",
    "author": "Zulkafil Tabish <zulkafil@client.io>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Get a contact by Email or ID.",
    "version": "1.0.3",
    "private": false,
    "auth": {
        "service": "appmixer:hubspot"
    },
    "quota": {
        "manager": "appmixer:hubspot",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "contactId": {
                        "type": "string"
                    },
                    "properties": {
                        "type": "string"
                    },
                    "associations": {
                        "type": "string"
                    }
                },
                "oneOf": [
                    {
                        "required": [
                            "contactId"
                        ]
                    },
                    {
                        "required": [
                            "email"
                        ]
                    }
                ]
            },
            "inspector": {
                "inputs": {
                    "email": {
                        "type": "text",
                        "label": "Contact Email",
                        "tooltip": "The contact's Email.",
                        "index": 1
                    },
                    "contactId": {
                        "type": "text",
                        "label": "Contact ID",
                        "tooltip": "The contact's ID.",
                        "index": 1
                    },
                    "properties": {
                        "type": "text",
                        "label": "Properties",
                        "tooltip": "A comma separated list of the properties to be returned in the response.",
                        "source": {
                            "url": "/component/appmixer/hubspot/crm/GetContactsProperties?outPort=out",
                            "data": {
                                "transform": "./transformers#contactToLabelNameArray"
                            }
                        },
                        "index": 2
                    },
                    "associations": {
                        "type": "text",
                        "label": "Associations",
                        "tooltip": "A comma separated list of objects to retrieve associated IDs for. Any specified associations that don't exist will not be returned in the response. Learn more about the <a href=\"https://developers.hubspot.com/docs/api/crm/associations\" target=\"_blank\"> associations API</a>.",
                        "index": 3
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "contact",
            "source": {
                "url": "/component/appmixer/hubspot/crm/GetContactsProperties?outPort=out",
                "data": {
                    "messages": {
                        "in/properties": "inputs/in/properties"
                    },
                    "transform": "./transformers#contactToSelectArray"
                }
            }
        },
        {
            "name": "notFound",
            "options": [
                {
                    "label": "Email",
                    "value": "email",
                    "schema": {
                        "type": "string",
                        "example": "jane.doe@example.com"
                    }
                },
                {
                    "label": "Contact ID",
                    "value": "contactId",
                    "schema": {
                        "type": "string",
                        "example": "151"
                    }
                }
            ]
        }
    ],
    "dependencies": {
        "service": "1.0.1"
    }
}
