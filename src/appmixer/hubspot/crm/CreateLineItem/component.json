{
    "name": "appmixer.hubspot.crm.CreateLineItem",
    "author": "Zulkafil Tabish <zulkafil@client.io>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Create a new line item.",
    "private": false,
    "auth": {
        "service": "appmixer:hubspot"
    },
    "quota": {
        "manager": "appmixer:hubspot",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "lineItem",
            "schema": {
                "type": "object",
                "properties": {
                    "productId": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "quantity": {
                        "type": "string"
                    },
                    "price": {
                        "type": "number"
                    },
                    "recurringBillingPeriod": {
                        "type": "number"
                    },
                    "recurringBillingFrequency": {
                        "type": "string"
                    }
                },
                "required": [
                    "productId",
                    "name",
                    "quantity"
                ]
            },
            "inspector": {
                "inputs": {
                    "productId": {
                        "type": "text",
                        "label": "Product ID",
                        "index": 1,
                        "source": {
                            "url": "/component/appmixer/hubspot/crm/ListProducts?outPort=out",
                            "data": {
                                "transform": "./ListProducts#productsToSelectArray"
                            }
                        },
                        "tooltip": "Select a product ID."
                    },
                    "name": {
                        "type": "text",
                        "label": "Name",
                        "tooltip": "Name",
                        "index": 2
                    },
                    "quantity": {
                        "type": "text",
                        "label": "Quantity",
                        "tooltip": "Quantity",
                        "index": 3
                    },
                    "price": {
                        "type": "text",
                        "label": "Price",
                        "tooltip": "Price",
                        "index": 4
                    },
                    "recurringBillingPeriod": {
                        "type": "text",
                        "label": "Recurring Billing Period",
                        "tooltip": "Recurring Billing Period. example: 24",
                        "index": 5
                    },
                    "recurringBillingFrequency": {
                        "type": "text",
                        "label": "Recurring Billing Frequency",
                        "tooltip": "Recurring Billing Frequency. example: monthly",
                        "index": 6
                    }
                },
                "groups": {
                    "associations": {
                        "label": "Associations",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "newLineItem",
            "options": [
                {
                    "label": "ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "151"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Premium subscription"
                    }
                },
                {
                    "label": "Product ID",
                    "value": "productId",
                    "schema": {
                        "type": "string",
                        "example": "2054630347"
                    }
                },
                {
                    "label": "Quantity",
                    "value": "quantity",
                    "schema": {
                        "type": "string",
                        "example": "2"
                    }
                },
                {
                    "label": "Price",
                    "value": "price",
                    "schema": {
                        "type": "string",
                        "example": "19.99"
                    }
                },
                {
                    "label": "Amount",
                    "value": "amount",
                    "schema": {
                        "type": "string",
                        "example": "39.98"
                    }
                },
                {
                    "label": "Recurring Billing Period",
                    "value": "recurringBillingPeriod",
                    "schema": {
                        "type": "string",
                        "example": "P12M"
                    }
                },
                {
                    "label": "Recurring Billing Frequency",
                    "value": "recurringBillingFrequency",
                    "schema": {
                        "type": "string",
                        "example": "monthly"
                    }
                }
            ]
        }
    ],
    "version": "1.0.1",
    "dependencies": {
        "service": "1.0.1"
    }
}
