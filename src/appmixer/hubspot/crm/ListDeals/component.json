{
    "name": "appmixer.hubspot.crm.ListDeals",
    "author": "Zulkafil Tabish <zulkafil@client.io>",
    "icon": "data:image/svg+xml;base64,",
    "description": "List and filter deals.",
    "private": false,
    "auth": {
        "service": "appmixer:hubspot"
    },
    "quota": {
        "manager": "appmixer:hubspot",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "properties": {
        "schema": {
            "properties": {
                "generateOutputPortOptions": {
                    "type": "boolean"
                }
            }
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "limit": {
                        "type": "string"
                    },
                    "search": {
                        "type": "string"
                    },
                    "pipeline": {
                        "type": "string"
                    },
                    "dealstage": {
                        "type": "string"
                    },
                    "allAtOnce": {
                        "type": "boolean"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "limit": {
                        "type": "number",
                        "label": "Limit",
                        "tooltip": "The maximum number of deals to fetch. If left blank, the limit will be 100.",
                        "defaultValue": 100,
                        "index": 1
                    },
                    "search": {
                        "type": "text",
                        "label": "Search",
                        "tooltip": "Search deals that match the given value in the title, contact names or organization.",
                        "index": 2
                    },
                    "pipeline": {
                        "type": "text",
                        "label": "Pipeline",
                        "tooltip": "Optional. Filter deals by pipeline.",
                        "source": {
                            "url": "/component/appmixer/hubspot/crm/ListPipelines?outPort=out",
                            "data": {
                                "messages": {
                                    "in/objectType": "deals"
                                },
                                "transform": "./ListPipelines#toSelectArray"
                            }
                        },
                        "index": 3
                    },
                    "dealstage": {
                        "type": "text",
                        "label": "Deal Stage",
                        "tooltip": "Optional. Filter deals by stage. Requires a pipeline to be selected.",
                        "source": {
                            "url": "/component/appmixer/hubspot/crm/ListPipelineStages?outPort=out",
                            "data": {
                                "messages": {
                                    "in/pipelineId": "inputs/in/pipeline",
                                    "in/isSource": true
                                },
                                "transform": "./ListPipelineStages#toSelectArray"
                            }
                        },
                        "index": 4
                    },
                    "allAtOnce": {
                        "type": "toggle",
                        "label": "Send all deals at once",
                        "tooltip": "Set it to true to send all deals in one message. If false, it will send one message per each deal. Order of the deals is not guaranteed.",
                        "defaultValue": false,
                        "index": 5
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/hubspot/crm/ListDeals?outPort=out",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/allAtOnce": "inputs/in/allAtOnce"
                    }
                }
            }
        }
    ],
    "version": "1.0.1",
    "dependencies": {
        "service": "1.0.1"
    }
}
