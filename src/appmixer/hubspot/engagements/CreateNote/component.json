{
    "name": "appmixer.hubspot.engagements.CreateNote",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a Note associated with a specific contact, company, deal, ticket, or other supported object.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:hubspot"
    },
    "quota": {
        "manager": "appmixer:hubspot",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "associationTypeId": {
                        "type": "integer"
                    },
                    "objectId": {
                        "type": "string"
                    },
                    "hsNoteBody": {
                        "type": "string"
                    }
                },
                "required": [
                    "objectId",
                    "hsNoteBody",
                    "associationTypeId"
                ]
            },
            "inspector": {
                "inputs": {
                    "associationTypeId": {
                        "type": "select",
                        "tooltip": "Id of the association type to use for the note. <a href='https://developers.hubspot.com/docs/guides/api/crm/associations/associations-v4#association-type-id-values' target='_blank'>See available association types for Notes</a>",
                        "label": "Association Type Id",
                        "options": [
                            {
                                "label": "Note to Contact (202)",
                                "value": 202
                            },
                            {
                                "label": "Note to Company (190)",
                                "value": 190
                            },
                            {
                                "label": "Note to Deal (214)",
                                "value": 214
                            },
                            {
                                "label": "Note to Ticket (228)",
                                "value": 228
                            },
                            {
                                "label": "Note to Appointment (921)",
                                "value": 921
                            },
                            {
                                "label": "Note to Course (875)",
                                "value": 875
                            },
                            {
                                "label": "Note to Listing (899)",
                                "value": 899
                            },
                            {
                                "label": "Note to Service (837)",
                                "value": 837
                            }
                        ],
                        "index": 0
                    },
                    "objectId": {
                        "type": "text",
                        "tooltip": "Id of the object to associate with the note",
                        "label": "Object Id",
                        "index": 1
                    },
                    "hsNoteBody": {
                        "type": "text",
                        "tooltip": "Content of the note",
                        "label": "Content",
                        "index": 2
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "87654321"
                    }
                },
                {
                    "label": "Properties",
                    "value": "properties",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "hs_body_preview": {
                                "type": "string",
                                "title": "Properties.Hs Body Preview"
                            },
                            "hs_body_preview_html": {
                                "type": "string",
                                "title": "Properties.Hs Body Preview Html"
                            },
                            "hs_body_preview_is_truncated": {
                                "type": "string",
                                "title": "Properties.Hs Body Preview Is Truncated"
                            },
                            "hs_createdate": {
                                "type": "string",
                                "title": "Properties.Hs Createdate"
                            },
                            "hs_lastmodifieddate": {
                                "type": "string",
                                "title": "Properties.Hs Lastmodifieddate"
                            },
                            "hs_note_body": {
                                "type": "string",
                                "title": "Properties.Hs Note Body"
                            },
                            "hs_obj_coords": {
                                "type": "string",
                                "title": "Properties.Hs Obj Coords"
                            },
                            "hs_object_id": {
                                "type": "string",
                                "title": "Properties.Hs Object Id"
                            },
                            "hs_object_source": {
                                "type": "string",
                                "title": "Properties.Hs Object Source"
                            },
                            "hs_object_source_id": {
                                "type": "string",
                                "title": "Properties.Hs Object Source Id"
                            },
                            "hs_object_source_label": {
                                "type": "string",
                                "title": "Properties.Hs Object Source Label"
                            },
                            "hs_timestamp": {
                                "type": "string",
                                "title": "Properties.Hs Timestamp"
                            }
                        },
                        "example": {
                            "hs_note_body": "Follow-up scheduled",
                            "hs_lastmodifieddate": "2026-07-24T12:00:00.000Z"
                        }
                    }
                },
                {
                    "label": "Created At",
                    "value": "createdAt",
                    "schema": {
                        "type": "string",
                        "example": "2026-02-10T08:15:00.000Z"
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updatedAt",
                    "schema": {
                        "type": "string",
                        "example": "2026-02-10T08:15:00.000Z"
                    }
                },
                {
                    "label": "Archived",
                    "value": "archived",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
