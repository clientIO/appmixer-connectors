{
    "name": "appmixer.hubspot.engagements.CreateTask",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a Task associated with a specific contact, company, deal, ticket, or other supported object.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:hubspot"
    },
    "quota": {
        "manager": "appmixer:hubspot",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "associationTypeId": {
                        "type": "integer"
                    },
                    "objectId": {
                        "type": "string"
                    },
                    "hsTaskSubject": {
                        "type": "string"
                    },
                    "hsTaskBody": {
                        "type": "string"
                    },
                    "hsTaskStatus": {
                        "type": "string"
                    },
                    "hsTaskType": {
                        "type": "string"
                    },
                    "hsTimestamp": {
                        "type": "string"
                    }
                },
                "required": [
                    "objectId",
                    "hsTaskSubject",
                    "associationTypeId"
                ]
            },
            "inspector": {
                "inputs": {
                    "associationTypeId": {
                        "type": "select",
                        "tooltip": "Id of the association type to use for the task. <a href='https://developers.hubspot.com/docs/guides/api/crm/associations/associations-v4#association-type-id-values' target='_blank'>See available association types for Tasks</a>",
                        "label": "Association Type Id",
                        "options": [
                            {
                                "label": "Task to Contact (204)",
                                "value": 204
                            },
                            {
                                "label": "Task to Company (192)",
                                "value": 192
                            },
                            {
                                "label": "Task to Deal (216)",
                                "value": 216
                            },
                            {
                                "label": "Task to Ticket (230)",
                                "value": 230
                            }
                        ],
                        "index": 0
                    },
                    "objectId": {
                        "type": "text",
                        "tooltip": "Id of the object to associate with the task.",
                        "label": "Object Id",
                        "index": 1
                    },
                    "hsTaskSubject": {
                        "type": "text",
                        "tooltip": "Title/subject of the task.",
                        "label": "Subject",
                        "index": 2
                    },
                    "hsTaskBody": {
                        "type": "text",
                        "tooltip": "Body/description of the task.",
                        "label": "Body",
                        "index": 3
                    },
                    "hsTaskStatus": {
                        "type": "select",
                        "tooltip": "Status of the task.",
                        "label": "Status",
                        "options": [
                            {
                                "label": "Not started",
                                "value": "NOT_STARTED"
                            },
                            {
                                "label": "In progress",
                                "value": "IN_PROGRESS"
                            },
                            {
                                "label": "Waiting",
                                "value": "WAITING"
                            },
                            {
                                "label": "Completed",
                                "value": "COMPLETED"
                            },
                            {
                                "label": "Deferred",
                                "value": "DEFERRED"
                            }
                        ],
                        "defaultValue": "NOT_STARTED",
                        "index": 4
                    },
                    "hsTaskType": {
                        "type": "select",
                        "tooltip": "Type of the task.",
                        "label": "Task Type",
                        "options": [
                            {
                                "label": "To-do",
                                "value": "TODO"
                            },
                            {
                                "label": "Call",
                                "value": "CALL"
                            },
                            {
                                "label": "Email",
                                "value": "EMAIL"
                            }
                        ],
                        "defaultValue": "TODO",
                        "index": 5
                    },
                    "hsTimestamp": {
                        "type": "text",
                        "tooltip": "Due date/time for the task (ISO 8601 format, e.g. 2024-01-31T12:00:00Z). Defaults to now if not provided.",
                        "label": "Due Date",
                        "index": 6
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "506841230547"
                    }
                },
                {
                    "label": "Properties",
                    "value": "properties",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "hs_task_subject": {
                                "type": "string",
                                "title": "Properties.Hs Task Subject"
                            },
                            "hs_task_body": {
                                "type": "string",
                                "title": "Properties.Hs Task Body"
                            },
                            "hs_task_status": {
                                "type": "string",
                                "title": "Properties.Hs Task Status"
                            },
                            "hs_task_type": {
                                "type": "string",
                                "title": "Properties.Hs Task Type"
                            },
                            "hs_timestamp": {
                                "type": "string",
                                "title": "Properties.Hs Timestamp"
                            },
                            "hs_createdate": {
                                "type": "string",
                                "title": "Properties.Hs Createdate"
                            },
                            "hs_lastmodifieddate": {
                                "type": "string",
                                "title": "Properties.Hs Lastmodifieddate"
                            },
                            "hs_object_id": {
                                "type": "string",
                                "title": "Properties.Hs Object Id"
                            }
                        },
                        "example": {
                            "hs_task_subject": "Follow up with contact",
                            "hs_task_status": "NOT_STARTED",
                            "hs_task_type": "TODO"
                        }
                    }
                },
                {
                    "label": "Created At",
                    "value": "createdAt",
                    "schema": {
                        "type": "string",
                        "example": "2026-07-24T12:00:00.000Z"
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updatedAt",
                    "schema": {
                        "type": "string",
                        "example": "2026-07-24T12:00:00.000Z"
                    }
                },
                {
                    "label": "Archived",
                    "value": "archived",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
