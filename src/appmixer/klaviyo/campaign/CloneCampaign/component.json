{
    "name": "appmixer.klaviyo.campaign.CloneCampaign",
    "label": "Clone Campaign",
    "description": "Create a copy of an existing campaign",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:klaviyo"
    },
    "quota": {
        "manager": "appmixer:klaviyo",
        "resources": "ten-requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "campaignId": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    }
                },
                "required": [
                    "campaignId",
                    "name"
                ]
            },
            "inspector": {
                "inputs": {
                    "campaignId": {
                        "type": "text",
                        "label": "Campaign ID",
                        "index": 0,
                        "tooltip": "ID of the campaign to clone"
                    },
                    "name": {
                        "type": "text",
                        "label": "New Campaign Name",
                        "index": 1,
                        "tooltip": "Name for the cloned campaign"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Type",
                    "value": "type",
                    "schema": {
                        "type": "string",
                        "example": "campaign"
                    }
                },
                {
                    "label": "Campaign ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "01JBXYZ1234567890ABCDEF"
                    }
                },
                {
                    "label": "Attributes.Name",
                    "value": "attributes.name",
                    "schema": {
                        "type": "string",
                        "example": "Summer Sale 2025"
                    }
                },
                {
                    "label": "Attributes.Status",
                    "value": "attributes.status",
                    "schema": {
                        "type": "string",
                        "example": "draft"
                    }
                },
                {
                    "label": "Attributes.Archived",
                    "value": "attributes.archived",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Attributes.Audiences.Included",
                    "value": "attributes.audiences.included",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "Y6nRLr"
                        ]
                    }
                },
                {
                    "label": "Attributes.Audiences.Excluded",
                    "value": "attributes.audiences.excluded",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "UTd5ui"
                        ]
                    }
                },
                {
                    "label": "Attributes.Send Options.Use Smart Sending",
                    "value": "attributes.send_options.use_smart_sending",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "Attributes.Send Options.Ignore Unsubscribes",
                    "value": "attributes.send_options.ignore_unsubscribes",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Attributes.Tracking Options.Add Tracking Params",
                    "value": "attributes.tracking_options.add_tracking_params",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Attributes.Tracking Options.Custom Tracking Params",
                    "value": "attributes.tracking_options.custom_tracking_params",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "example": []
                    }
                },
                {
                    "label": "Attributes.Tracking Options.Is Tracking Clicks",
                    "value": "attributes.tracking_options.is_tracking_clicks",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "Attributes.Tracking Options.Is Tracking Opens",
                    "value": "attributes.tracking_options.is_tracking_opens",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "Attributes.Send Strategy.Method",
                    "value": "attributes.send_strategy.method",
                    "schema": {
                        "type": "string",
                        "example": "static"
                    }
                },
                {
                    "label": "Attributes.Send Strategy.Datetime",
                    "value": "attributes.send_strategy.datetime",
                    "schema": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-10-31T13:00:00+00:00"
                    }
                },
                {
                    "label": "Attributes.Send Strategy.Throttle Percentage",
                    "value": "attributes.send_strategy.throttle_percentage",
                    "schema": {
                        "type": "number",
                        "example": 50
                    }
                },
                {
                    "label": "Attributes.Created At",
                    "value": "attributes.created_at",
                    "schema": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-01-15T10:30:00+00:00"
                    }
                },
                {
                    "label": "Attributes.Scheduled At",
                    "value": "attributes.scheduled_at",
                    "schema": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-10-31T13:00:00+00:00"
                    }
                },
                {
                    "label": "Attributes.Updated At",
                    "value": "attributes.updated_at",
                    "schema": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-01-16T08:45:00+00:00"
                    }
                },
                {
                    "label": "Attributes.Send Time",
                    "value": "attributes.send_time",
                    "schema": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-10-31T13:00:00+00:00"
                    }
                },
                {
                    "label": "Relationships.Campaign Messages.Data",
                    "value": "relationships.campaign-messages.data",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object"
                        },
                        "example": [
                            {
                                "type": "campaign-message",
                                "id": "01JBXYZ1234567890ABCDEG"
                            }
                        ]
                    }
                },
                {
                    "label": "Links.Self",
                    "value": "links.self",
                    "schema": {
                        "type": "string",
                        "example": "https://a.]klaviyo.com/api/campaigns/01JBXYZ1234567890ABCDEF"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}
