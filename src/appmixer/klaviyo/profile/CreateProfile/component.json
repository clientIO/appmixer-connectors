                        "type": "text",
                        "label": "Address 1",
                        "index": 8,
                        "group": "location"
                    },
                    "address2": {
                        "type": "text",
                        "label": "Address 2",
                        "index": 9,
                        "group": "location"
                    },
                    "city": {
                        "type": "text",
                        "label": "City",
                        "index": 10,
                        "group": "location"
                    },
                    "country": {
                        "type": "text",
                        "label": "Country",
                        "index": 11,
                        "group": "location"
                    },
                    "latitude": {
                        "type": "text",
                        "tooltip": "Latitude coordinate. Precision of four decimal places is recommended.",
                        "label": "Latitude",
                        "index": 12,
                        "group": "location"
                    },
                    "longitude": {
                        "type": "text",
                        "tooltip": "Longitude coordinate. Precision of four decimal places is recommended.",
                        "label": "Longitude",
                        "index": 13,
                        "group": "location"
                    },
                    "region": {
                        "type": "text",
                        "tooltip": "Region within a country, such as state or province.",
