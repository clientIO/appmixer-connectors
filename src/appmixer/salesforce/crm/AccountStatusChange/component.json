{
    "name": "appmixer.salesforce.crm.AccountStatusChange",
    "author": "Appmixer <info@appmixer.ai>",
    "description": "Triggers with the account details when a chosen status field changes on an Account.",
    "private": false,
    "auth": {
        "service": "appmixer:salesforce"
    },
    "quota": {
        "manager": "appmixer:salesforce",
        "resources": "requests"
    },
    "version": "1.1.2",
    "dependencies": {
        "service": "1.1.2"
    },
    "tick": true,
    "trigger": true,
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "fieldName": {
                    "type": "string"
                }
            },
            "required": [
                "fieldName"
            ]
        },
        "inspector": {
            "inputs": {
                "fieldName": {
                    "type": "text",
                    "label": "Status Field",
                    "index": 1,
                    "tooltip": "The Account field to monitor for changes (e.g. a Type or custom Status field).",
                    "source": {
                        "url": "/component/appmixer/salesforce/crm/GetObjectFields?outPort=out",
                        "data": {
                            "messages": {
                                "in": {
                                    "objectName": "Account"
                                }
                            },
                            "transform": "./transformers#fieldsToSelectOptions",
                            "properties": {
                                "variableFetch": true
                            }
                        }
                    }
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "account",
            "source": {
                "url": "/component/appmixer/salesforce/crm/GetObjectFields?outPort=out",
                "data": {
                    "messages": {
                        "in": {
                            "objectName": "Account"
                        }
                    },
                    "transform": "./transformers#fieldsToSelectOptions",
                    "properties": {
                        "variableFetch": true
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
