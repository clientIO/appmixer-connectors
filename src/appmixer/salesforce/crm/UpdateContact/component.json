{
    "name": "appmixer.salesforce.crm.UpdateContact",
    "author": "Tomasz Hencel <thencel@ntrc.eu>",
    "description": "Update a contact in Salesforce.",
    "private": false,
    "auth": {
        "service": "appmixer:salesforce"
    },
    "quota": {
        "manager": "appmixer:salesforce",
        "resources": "requests"
    },
    "version": "1.1.2",
    "dependencies": {
        "service": "1.1.2"
    },
    "inPorts": [
        {
            "name": "contact",
            "schema": {
                "type": "object",
                "properties": {
                    "accountId": {
                        "type": "string"
                    },
                    "contactId": {
                        "type": "string"
                    },
                    "salutation": {
                        "type": "string",
                        "maxLength": 40
                    },
                    "firstName": {
                        "type": "string",
                        "maxLength": 40
                    },
                    "lastName": {
                        "type": "string",
                        "maxLength": 80
                    },
                    "title": {
                        "type": "string",
                        "maxLength": 80
                    },
                    "department": {
                        "type": "string",
                        "maxLength": 80
                    },
                    "email": {
                        "type": "string",
                        "maxLength": 80,
                        "format": "email"
                    },
                    "phone": {
                        "type": "string",
                        "maxLength": 40
                    },
                    "fax": {
                        "type": "string",
                        "maxLength": 40
                    },
                    "mobile": {
                        "type": "string",
                        "maxLength": 40
                    },
                    "mailingStreet": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "mailingCity": {
                        "type": "string",
                        "maxLength": 40
                    },
                    "mailingState": {
                        "type": "string",
                        "maxLength": 80
                    },
                    "mailingZip": {
                        "type": "string",
                        "maxLength": 20
                    },
                    "mailingCountry": {
                        "type": "string",
                        "maxLength": 80
                    },
                    "customFields": {
                        "type": "object"
                    }
                },
                "required": [
                    "contactId"
                ]
            },
            "inspector": {
                "inputs": {
                    "contactId": {
                        "type": "text",
                        "label": "Contact",
                        "index": 1,
                        "source": {
                            "url": "/component/appmixer/salesforce/crm/ListContacts?outPort=contacts",
                            "data": {
                                "transform": "./transformers#contactsToSelectArray",
                                "properties": {
                                    "isSource": true
                                }
                            }
                        },
                        "tooltip": "Select contact to update."
                    },
                    "accountId": {
                        "type": "text",
                        "label": "Account name",
                        "index": 1,
                        "source": {
                            "url": "/component/appmixer/salesforce/crm/ListAccounts?outPort=accounts",
                            "data": {
                                "transform": "./transformers#accountsToSelectArray",
                                "properties": {
                                    "isSource": true
                                }
                            }
                        },
                        "tooltip": "Select account name."
                    },
                    "salutation": {
                        "type": "select",
                        "options": [
                            {
                                "value": "none",
                                "content": "none"
                            },
                            {
                                "value": "Mr.",
                                "content": "Mr."
                            },
                            {
                                "value": "Ms.",
                                "content": "Ms."
                            },
                            {
                                "value": "Mrs.",
                                "content": "Mrs."
                            },
                            {
                                "value": "Dr.",
                                "content": "Dr."
                            },
                            {
                                "value": "Prof.",
                                "content": "Prof."
                            }
                        ],
                        "defaultValue": "none",
                        "tooltip": "Honorific abbreviation, word, or phrase to be used in front of name in greetings, such as Dr. or Mrs.",
                        "label": "Salutation",
                        "index": 2
                    },
                    "firstName": {
                        "type": "text",
                        "tooltip": "First name of the contact.",
                        "label": "First name",
                        "index": 3
                    },
                    "lastName": {
                        "type": "text",
                        "tooltip": "Last name of the contact.",
                        "label": "Last name",
                        "index": 4
                    },
                    "title": {
                        "type": "text",
                        "tooltip": "Title of the contact such as CEO or Vice President.",
                        "label": "Title",
                        "index": 5
                    },
                    "department": {
                        "type": "text",
                        "tooltip": "The department of the contact.",
                        "label": "Department",
                        "index": 6
                    },
                    "email": {
                        "type": "text",
                        "tooltip": "Email address for the contact.",
                        "label": "Email",
                        "index": 7
                    },
                    "phone": {
                        "type": "text",
                        "tooltip": "Telephone number for the contact.",
                        "label": "Phone",
                        "index": 8
                    },
                    "fax": {
                        "type": "text",
                        "tooltip": "Fax number for the contact.",
                        "label": "Fax",
                        "index": 9
                    },
                    "mobile": {
                        "type": "text",
                        "tooltip": "Contact\u2019s mobile phone number.",
                        "label": "Mobile phone",
                        "index": 10
                    },
                    "mailingStreet": {
                        "type": "text",
                        "tooltip": "Street address for mailing address.",
                        "label": "Mailing street",
                        "index": 11
                    },
                    "mailingCity": {
                        "type": "text",
                        "tooltip": "City for mailing address.",
                        "label": "Mailing city",
                        "index": 12
                    },
                    "mailingState": {
                        "type": "text",
                        "tooltip": "State for mailing address.",
                        "label": "Mailing state",
                        "index": 13
                    },
                    "mailingZip": {
                        "type": "text",
                        "tooltip": "Postal code for mailing address.",
                        "label": "Mailing postal code",
                        "index": 14
                    },
                    "mailingCountry": {
                        "type": "text",
                        "tooltip": "Country for mailing address.",
                        "label": "Mailing county",
                        "index": 15
                    },
                    "customFields": {
                        "type": "expression",
                        "label": "Custom Fields",
                        "tooltip": "Custom fields to update a contact.",
                        "exclusiveFields": [
                            "field"
                        ],
                        "index": 16,
                        "levels": [
                            "AND"
                        ],
                        "fields": {
                            "field": {
                                "type": "select",
                                "label": "Field",
                                "tooltip": "The field to append.",
                                "index": 1,
                                "source": {
                                    "url": "/component/appmixer/salesforce/crm/ListCustomFields?outPort=out",
                                    "data": {
                                        "transform": "./ListCustomFields#fieldsToSelectArray"
                                    }
                                }
                            },
                            "value": {
                                "type": "text",
                                "label": "Value",
                                "tooltip": "The value for the custom field.",
                                "index": 2
                            }
                        }
                    }
                }
            }
        }
    ],
