{
    "name": "appmixer.salesforce.crm.CreateAccount",
    "author": "Appmixer <info@appmixer.ai>",
    "description": "Create a new account in Salesforce.",
    "private": false,
    "auth": {
        "service": "appmixer:salesforce"
    },
    "quota": {
        "manager": "appmixer:salesforce",
        "resources": "requests"
    },
    "version": "1.1.2",
    "dependencies": {
        "service": "1.1.2"
    },
    "inPorts": [
        {
            "name": "account",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "parentId": {
                        "type": "string"
                    },
                    "website": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "phone": {
                        "type": "string",
                        "maxLength": 40
                    },
                    "fax": {
                        "type": "string",
                        "maxLength": 40
                    },
                    "industry": {
                        "type": "string",
                        "maxLength": 40
                    },
                    "type": {
                        "type": "string",
                        "maxLength": 40
                    },
                    "accountNumber": {
                        "type": "string",
                        "maxLength": 40
                    },
                    "numberOfEmployees": {
                        "type": "number"
                    },
                    "annualRevenue": {
                        "type": "number"
                    },
                    "description": {
                        "type": "string"
                    },
                    "billingStreet": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "billingCity": {
                        "type": "string",
                        "maxLength": 40
                    },
                    "billingState": {
                        "type": "string",
                        "maxLength": 80
                    },
                    "billingZip": {
                        "type": "string",
                        "maxLength": 20
                    },
                    "billingCountry": {
                        "type": "string",
                        "maxLength": 80
                    }
                },
                "required": [
                    "name"
                ]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "label": "Account name",
                        "index": 1,
                        "tooltip": "Name of the account."
                    },
                    "parentId": {
                        "type": "text",
                        "label": "Parent account",
                        "index": 2,
                        "source": {
                            "url": "/component/appmixer/salesforce/crm/ListAccounts?outPort=accounts",
                            "data": {
                                "transform": "./transformers#accountsToSelectArray",
                                "properties": {
                                    "isSource": true
                                }
                            }
                        },
                        "tooltip": "Optional parent account."
                    },
                    "website": {
                        "type": "text",
                        "label": "Website",
                        "index": 3,
                        "tooltip": "Website of the account."
                    },
                    "phone": {
                        "type": "text",
                        "label": "Phone",
                        "index": 4,
                        "tooltip": "Phone number of the account."
                    },
                    "fax": {
                        "type": "text",
                        "label": "Fax",
                        "index": 5,
                        "tooltip": "Fax number of the account."
                    },
                    "industry": {
                        "type": "text",
                        "label": "Industry",
                        "index": 6,
                        "tooltip": "Industry of the account, for example Technology or Banking."
                    },
                    "type": {
                        "type": "text",
                        "label": "Type",
                        "index": 7,
                        "tooltip": "Type of the account, for example Customer, Partner or Prospect."
                    },
                    "accountNumber": {
                        "type": "text",
                        "label": "Account number",
                        "index": 8,
                        "tooltip": "Account number assigned to this account."
                    },
                    "numberOfEmployees": {
                        "type": "number",
                        "label": "Employees",
                        "index": 9,
                        "tooltip": "Number of employees."
                    },
                    "annualRevenue": {
                        "type": "number",
                        "label": "Annual revenue",
                        "index": 10,
                        "tooltip": "Estimated annual revenue of the account."
                    },
                    "description": {
                        "type": "textarea",
                        "label": "Description",
                        "index": 11,
                        "tooltip": "Description of the account."
                    },
                    "billingStreet": {
                        "type": "text",
                        "label": "Billing street",
                        "index": 12,
                        "tooltip": "Street address for the billing address."
                    },
                    "billingCity": {
                        "type": "text",
                        "label": "Billing city",
                        "index": 13,
                        "tooltip": "City for the billing address."
                    },
                    "billingState": {
                        "type": "text",
                        "label": "Billing state",
                        "index": 14,
                        "tooltip": "State for the billing address."
                    },
                    "billingZip": {
                        "type": "text",
                        "label": "Billing zip",
                        "index": 15,
                        "tooltip": "Zip/postal code for the billing address."
                    },
                    "billingCountry": {
                        "type": "text",
                        "label": "Billing country",
                        "index": 16,
                        "tooltip": "Country for the billing address."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "newAccount",
            "schema": {
                "type": "object",
                "properties": {
                    "Id": {
                        "type": "string",
                        "title": "Account ID",
                        "example": "0017R00002yg2OmQAI"
                    },
                    "Name": {
                        "type": "string",
                        "title": "Account Name",
                        "example": "Edge Communications"
                    },
                    "Type": {
                        "type": "string",
                        "title": "Type",
                        "example": "Customer - Direct"
                    },
                    "ParentId": {
                        "type": "string",
                        "title": "Parent Account ID",
                        "example": "0017R00002yg2OnQAI"
                    },
                    "Website": {
                        "type": "string",
                        "title": "Website",
                        "example": "http://edgecomm.com"
                    },
                    "Phone": {
                        "type": "string",
                        "title": "Phone",
                        "example": "(512) 757-6000"
                    },
                    "Fax": {
                        "type": "string",
                        "title": "Fax",
                        "example": "(512) 757-9000"
                    },
                    "AccountNumber": {
                        "type": "string",
                        "title": "Account Number",
                        "example": "CD451796"
                    },
                    "Industry": {
                        "type": "string",
                        "title": "Industry",
                        "example": "Electronics"
                    },
                    "AnnualRevenue": {
                        "type": "number",
                        "title": "Annual Revenue",
                        "example": 139000000
                    },
                    "NumberOfEmployees": {
                        "type": "number",
                        "title": "Employees",
                        "example": 1000
                    },
                    "Description": {
                        "type": "string",
                        "title": "Description",
                        "example": "Leading provider of edge devices."
                    },
                    "BillingStreet": {
                        "type": "string",
                        "title": "Billing Street",
                        "example": "312 Constitution Place"
                    },
                    "BillingCity": {
                        "type": "string",
                        "title": "Billing City",
                        "example": "Austin"
                    },
                    "BillingState": {
                        "type": "string",
                        "title": "Billing State",
                        "example": "TX"
                    },
                    "BillingPostalCode": {
                        "type": "string",
                        "title": "Billing Zip/Postal Code",
                        "example": "78767"
                    },
                    "BillingCountry": {
                        "type": "string",
                        "title": "Billing Country",
                        "example": "USA"
                    },
                    "OwnerId": {
                        "type": "string",
                        "title": "Owner ID",
                        "example": "0057R00000ClpTIQAZ"
                    },
                    "CreatedDate": {
                        "type": "string",
                        "title": "Created Date",
                        "example": "2026-08-18T09:30:00.000+0000"
                    },
                    "LastModifiedDate": {
                        "type": "string",
                        "title": "Last Modified Date",
                        "example": "2026-08-18T09:30:00.000+0000"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
