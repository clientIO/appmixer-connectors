{
    "name": "Demo Salesforce - Lead Status Change",
    "type": "automation",
    "flow": {
        "c1000000-0000-0000-0000-000000000001": {
            "type": "appmixer.salesforce.crm.LeadStatusChange",
            "x": 64,
            "y": 300,
            "source": {},
            "config": {
                "properties": {
                    "fieldName": "Status"
                }
            },
            "errorHandling": {
                "autoRetry": false,
                "onError": "stopFlow"
            }
        },
        "c1000000-0000-0000-0000-000000000002": {
            "type": "appmixer.utils.controls.SetVariable",
            "x": 272,
            "y": 300,
            "source": {
                "in": {
                    "c1000000-0000-0000-0000-000000000001": [
                        "lead"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "c1000000-0000-0000-0000-000000000001": {
                            "lead": {
                                "type": "json2new",
                                "modifiers": {
                                    "variables": {
                                        "v-leadId": {
                                            "variable": "$.c1000000-0000-0000-0000-000000000001.lead",
                                            "functions": [
                                                {
                                                    "name": "g_jsonPath",
                                                    "params": [
                                                        {
                                                            "value": "$.Id"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        "v-leadName": {
                                            "variable": "$.c1000000-0000-0000-0000-000000000001.lead",
                                            "functions": [
                                                {
                                                    "name": "g_jsonPath",
                                                    "params": [
                                                        {
                                                            "value": "$.Name"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        "v-company": {
                                            "variable": "$.c1000000-0000-0000-0000-000000000001.lead",
                                            "functions": [
                                                {
                                                    "name": "g_jsonPath",
                                                    "params": [
                                                        {
                                                            "value": "$.Company"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        "v-email": {
                                            "variable": "$.c1000000-0000-0000-0000-000000000001.lead",
                                            "functions": [
                                                {
                                                    "name": "g_jsonPath",
                                                    "params": [
                                                        {
                                                            "value": "$.Email"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        "v-newStatus": {
                                            "variable": "$.c1000000-0000-0000-0000-000000000001.lead",
                                            "functions": [
                                                {
                                                    "name": "g_jsonPath",
                                                    "params": [
                                                        {
                                                            "value": "$.Status"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    }
                                },
                                "lambda": {
                                    "variables": {
                                        "ADD": [
                                            {
                                                "type": "text",
                                                "name": "leadId",
                                                "text": "{{{v-leadId}}}"
                                            },
                                            {
                                                "type": "text",
                                                "name": "leadName",
                                                "text": "{{{v-leadName}}}"
                                            },
                                            {
                                                "type": "text",
                                                "name": "company",
                                                "text": "{{{v-company}}}"
                                            },
                                            {
                                                "type": "text",
                                                "name": "email",
                                                "text": "{{{v-email}}}"
                                            },
                                            {
                                                "type": "text",
                                                "name": "newStatus",
                                                "text": "{{{v-newStatus}}}"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "errorHandling": {
                "autoRetry": false,
                "onError": "stopFlow"
            }
        }
    },
    "wizard": {
        "fields": []
    }
}
