{
    "name": "appmixer.kit.form.AddSubscriberToForm",
    "label": "Add Subscriber to Form",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Adds a subscriber to a specified form.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:kit"
    },
    "quota": {
        "manager": "appmixer:kit",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "formId": {
                        "type": "string"
                    },
                    "subscriberId": {
                        "type": "string"
                    }
                },
                "required": [
                    "formId",
                    "subscriberId"
                ]
            },
            "inspector": {
                "inputs": {
                    "formId": {
                        "type": "text",
                        "tooltip": "Unique identifier of the form.",
                        "label": "Form ID",
                        "index": 0,
                        "source": {
                            "url": "/component/appmixer/kit/form/FindForms?outPort=out",
                            "data": {
                                "message": {
                                    "in/outputType": "array"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./FindForms#toSelectArray"
                            }
                        }
                    },
                    "subscriberId": {
                        "type": "text",
                        "tooltip": "Unique identifier of the subscriber.",
                        "label": "Subscriber ID",
                        "index": 1,
                        "source": {
                            "url": "/component/appmixer/kit/subscriber/FindSubscribers?outPort=out",
                            "data": {
                                "message": {
                                    "in/outputType": "array"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./FindSubscribers#toSelectArray"
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Subscriber ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "sub_abc123def456"
                    }
                },
                {
                    "label": "First Name",
                    "value": "first_name",
                    "schema": {
                        "type": "string",
                        "example": "Jane"
                    }
                },
                {
                    "label": "Email Address",
                    "value": "email_address",
                    "schema": {
                        "type": "string",
                        "example": "subscriber@example.com"
                    }
                },
                {
                    "label": "State",
                    "value": "state",
                    "schema": {
                        "type": "string",
                        "example": "active"
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-01-15T10:30:00Z"
                    }
                },
                {
                    "label": "Added At",
                    "value": "added_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-01-15T10:30:00Z"
                    }
                },
                {
                    "label": "Fields",
                    "value": "fields",
                    "schema": {
                        "type": "object",
                        "properties": {},
                        "example": {
                            "company": "Acme Inc"
                        }
                    }
                },
                {
                    "label": "Referrer",
                    "value": "referrer",
                    "schema": {
                        "type": "string",
                        "example": "https://example.com"
                    }
                },
                {
                    "label": "Referrer Utm Parameters",
                    "value": "referrer_utm_parameters",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "source": {
                                "type": "string",
                                "title": "Referrer Utm Parameters.Source",
                                "example": "google"
                            },
                            "medium": {
                                "type": "string",
                                "title": "Referrer Utm Parameters.Medium",
                                "example": "cpc"
                            },
                            "campaign": {
                                "type": "string",
                                "title": "Referrer Utm Parameters.Campaign",
                                "example": "spring_sale"
                            },
                            "term": {
                                "type": "string",
                                "title": "Referrer Utm Parameters.Term",
                                "example": "newsletter"
                            },
                            "content": {
                                "type": "string",
                                "title": "Referrer Utm Parameters.Content",
                                "example": "banner_ad"
                            }
                        },
                        "example": {
                            "source": "google",
                            "medium": "cpc",
                            "campaign": "spring_sale",
                            "term": "newsletter",
                            "content": "banner_ad"
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}
