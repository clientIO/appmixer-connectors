{
    "name": "appmixer.activecampaign.deals.FindDeals",
    "description": "Retrieve deals with all of their details, with optional filtering. Returns a maximum of 100 deals.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:activecampaign"
    },
    "quota": {
        "manager": "appmixer:activecampaign",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "search": { "type": "string" },
                    "stage": { "type": "string" },
                    "status": { "type": "string" },
                    "outputType": { "type": "string" }
                }
            },
            "inspector": {
                "inputs": {
                    "search": {
                        "type": "text",
                        "label": "Search",
                        "index": 1,
                        "tooltip": "Filter deals whose title matches the given value."
                    },
                    "stage": {
                        "type": "text",
                        "label": "Stage ID",
                        "index": 2,
                        "tooltip": "Filter deals by the ID of the stage they belong to.",
                        "source": {
                            "url": "/component/appmixer/activecampaign/stages/ListStages?outPort=out",
                            "data": {
                                "transform": "./ListStages#dealStagesToSelectArray"
                            }
                        }
                    },
                    "status": {
                        "type": "select",
                        "label": "Status",
                        "index": 3,
                        "tooltip": "Filter deals by their status.",
                        "options": [
                            { "label": "Open", "value": "0" },
                            { "label": "Won", "value": "1" },
                            { "label": "Lost", "value": "2" }
                        ]
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "index": 4,
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "options": [
                            { "label": "First Item Only", "value": "first" },
                            { "label": "All items at once", "value": "array" },
                            { "label": "One item at a time", "value": "object" },
                            { "label": "Store to CSV file", "value": "file" }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/activecampaign/deals/FindDeals?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        },
        {
            "name": "notFound"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
