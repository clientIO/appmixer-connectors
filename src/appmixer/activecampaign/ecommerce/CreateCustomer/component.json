{
    "name": "appmixer.activecampaign.ecommerce.CreateCustomer",
    "description": "Create an e-commerce customer.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:activecampaign"
    },
    "quota": {
        "manager": "appmixer:activecampaign",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "connectionid": {
                        "type": "string"
                    },
                    "externalid": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "acceptsMarketing": {
                        "type": "string"
                    }
                },
                "required": [
                    "connectionid",
                    "externalid",
                    "email"
                ]
            },
            "inspector": {
                "inputs": {
                    "connectionid": {
                        "type": "text",
                        "label": "Connection ID",
                        "index": 1,
                        "tooltip": "The e-commerce connection this customer belongs to."
                    },
                    "externalid": {
                        "type": "text",
                        "label": "External ID",
                        "index": 2,
                        "tooltip": "Your unique identifier for this customer."
                    },
                    "email": {
                        "type": "text",
                        "label": "Email",
                        "index": 3,
                        "tooltip": "Customer email address."
                    },
                    "acceptsMarketing": {
                        "type": "text",
                        "label": "Accepts Marketing",
                        "index": 4,
                        "tooltip": "Whether the customer accepts marketing (0 or 1)."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Customer ID",
                        "example": "8"
                    },
                    "connectionid": {
                        "type": "string",
                        "title": "Connection ID",
                        "example": "1"
                    },
                    "email": {
                        "type": "string",
                        "title": "Email",
                        "example": "jane.doe@example.com"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
