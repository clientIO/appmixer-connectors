{
    "name": "appmixer.activecampaign.ecommerce.AbandonedCart",
    "description": "Triggers when an e-commerce cart is abandoned.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "trigger": true,
    "tick": true,
    "auth": {
        "service": "appmixer:activecampaign"
    },
    "quota": {
        "manager": "appmixer:activecampaign",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "connectionid": { "type": "string" }
            }
        },
        "inspector": {
            "inputs": {
                "connectionid": {
                    "type": "text",
                    "label": "Connection ID",
                    "index": 1,
                    "tooltip": "Optional. Limit the trigger to abandoned carts of a single e-commerce connection (store). Leave empty to watch all connections."
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": { "type": "string", "title": "Order ID", "example": "42" },
                    "externalid": { "type": "string", "title": "External ID", "example": "ext-9981" },
                    "externalcheckoutid": { "type": "string", "title": "External Checkout ID", "example": "chk-7712" },
                    "source": { "type": "string", "title": "Source", "example": "1" },
                    "email": { "type": "string", "title": "Email", "example": "jane.doe@example.com" },
                    "currency": { "type": "string", "title": "Currency", "example": "USD" },
                    "connectionid": { "type": "string", "title": "Connection ID", "example": "1" },
                    "customerid": { "type": "string", "title": "Customer ID", "example": "8" },
                    "totalPrice": { "type": "string", "title": "Total Price (cents)", "example": "12999" },
                    "orderUrl": { "type": "string", "title": "Order URL", "example": "https://shop.example.com/cart/42" },
                    "state": { "type": "string", "title": "State", "example": "2" },
                    "totalProducts": { "type": "string", "title": "Total Products", "example": "3" },
                    "externalCreatedDate": { "type": "string", "format": "date-time", "title": "External Created Date", "example": "2025-02-20T08:15:00-06:00" },
                    "createdDate": { "type": "string", "format": "date-time", "title": "Created Date", "example": "2025-02-20T08:16:00-06:00" }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
