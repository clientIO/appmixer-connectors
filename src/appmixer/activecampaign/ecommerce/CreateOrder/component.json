{
    "name": "appmixer.activecampaign.ecommerce.CreateOrder",
    "description": "Create an e-commerce order or abandoned cart. Provide External ID for a completed order, or External Checkout ID (with Abandoned Date) for an abandoned cart.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:activecampaign"
    },
    "quota": {
        "manager": "appmixer:activecampaign",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "externalid": {
                        "type": "string"
                    },
                    "externalcheckoutid": {
                        "type": "string"
                    },
                    "source": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "currency": {
                        "type": "string"
                    },
                    "connectionid": {
                        "type": "string"
                    },
                    "customerid": {
                        "type": "string"
                    },
                    "totalPrice": {
                        "type": "string"
                    },
                    "externalCreatedDate": {
                        "type": "string"
                    },
                    "orderUrl": {
                        "type": "string"
                    },
                    "abandonedDate": {
                        "type": "string"
                    },
                    "productName": {
                        "type": "string"
                    },
                    "productPrice": {
                        "type": "string"
                    },
                    "productQuantity": {
                        "type": "string"
                    }
                },
                "required": [
                    "source",
                    "email",
                    "currency",
                    "connectionid",
                    "customerid",
                    "totalPrice",
                    "externalCreatedDate",
                    "orderUrl",
                    "productName",
                    "productPrice"
                ]
            },
            "inspector": {
                "inputs": {
                    "externalid": {
                        "type": "text",
                        "label": "External ID",
                        "index": 1,
                        "tooltip": "Your unique identifier for a completed order. Leave empty and use External Checkout ID to create an abandoned cart."
                    },
                    "externalcheckoutid": {
                        "type": "text",
                        "label": "External Checkout ID",
                        "index": 2,
                        "tooltip": "Your unique identifier for an abandoned cart. When set, ActiveCampaign creates the order as an abandoned cart (state Abandoned)."
                    },
                    "source": {
                        "type": "select",
                        "label": "Source",
                        "index": 3,
                        "defaultValue": "1",
                        "tooltip": "Where the order data comes from.",
                        "options": [
                            {
                                "label": "Real-time",
                                "value": "1"
                            },
                            {
                                "label": "Historical sync",
                                "value": "0"
                            }
                        ]
                    },
                    "email": {
                        "type": "text",
                        "label": "Email",
                        "index": 4,
                        "tooltip": "Customer email address."
                    },
                    "currency": {
                        "type": "text",
                        "label": "Currency",
                        "index": 5,
                        "tooltip": "ISO currency code (e.g. USD)."
                    },
                    "connectionid": {
                        "type": "text",
                        "label": "Connection ID",
                        "index": 6,
                        "tooltip": "The e-commerce connection ID."
                    },
                    "customerid": {
                        "type": "text",
                        "label": "Customer ID",
                        "index": 7,
                        "tooltip": "The e-commerce customer ID."
                    },
                    "totalPrice": {
                        "type": "text",
                        "label": "Total Price (cents)",
                        "index": 8,
                        "tooltip": "Total order price in cents (e.g. 12999)."
                    },
                    "externalCreatedDate": {
                        "type": "date-time",
                        "label": "External Created Date",
                        "index": 9,
                        "tooltip": "When the order was created in the source system."
                    },
                    "orderUrl": {
                        "type": "text",
                        "label": "Order URL",
                        "index": 10,
                        "tooltip": "URL of the order/cart."
                    },
                    "abandonedDate": {
                        "type": "date-time",
                        "label": "Abandoned Date",
                        "index": 11,
                        "tooltip": "Set this to create an abandoned cart (otherwise a normal order)."
                    },
                    "productName": {
                        "type": "text",
                        "label": "Product Name",
                        "index": 12,
                        "tooltip": "Name of a product line item."
                    },
                    "productPrice": {
                        "type": "text",
                        "label": "Product Price (cents)",
                        "index": 13,
                        "tooltip": "Price of the product in cents."
                    },
                    "productQuantity": {
                        "type": "text",
                        "label": "Product Quantity",
                        "index": 14,
                        "tooltip": "Quantity of the product. Defaults to 1."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Order ID",
                        "example": "42"
                    },
                    "externalid": {
                        "type": "string",
                        "title": "External ID",
                        "example": "ext-9981"
                    },
                    "email": {
                        "type": "string",
                        "title": "Email",
                        "example": "jane.doe@example.com"
                    },
                    "totalPrice": {
                        "type": "string",
                        "title": "Total Price (cents)",
                        "example": "12999"
                    },
                    "currency": {
                        "type": "string",
                        "title": "Currency",
                        "example": "USD"
                    },
                    "connectionid": {
                        "type": "string",
                        "title": "Connection ID",
                        "example": "1"
                    },
                    "state": {
                        "type": "string",
                        "title": "State",
                        "example": "2"
                    },
                    "abandonedDate": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Abandoned Date",
                        "example": "2025-02-20T08:15:00-06:00"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
