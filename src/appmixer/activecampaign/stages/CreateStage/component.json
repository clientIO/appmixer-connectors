{
    "name": "appmixer.activecampaign.stages.CreateStage",
    "description": "Create a deal stage within a pipeline.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:activecampaign"
    },
    "quota": {
        "manager": "appmixer:activecampaign",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string"
                    },
                    "group": {
                        "type": "string"
                    },
                    "color": {
                        "type": "string"
                    },
                    "order": {
                        "type": "string"
                    }
                },
                "required": [
                    "title",
                    "group"
                ]
            },
            "inspector": {
                "inputs": {
                    "title": {
                        "type": "text",
                        "label": "Title",
                        "index": 1,
                        "tooltip": "Name of the stage."
                    },
                    "group": {
                        "type": "text",
                        "label": "Pipeline",
                        "index": 2,
                        "tooltip": "The pipeline (deal group) ID this stage belongs to."
                    },
                    "color": {
                        "type": "text",
                        "label": "Color",
                        "index": 3,
                        "tooltip": "Hex color of the stage without the leading # (e.g. a6b1e1). Defaults to a6b1e1."
                    },
                    "order": {
                        "type": "text",
                        "label": "Order",
                        "index": 4,
                        "tooltip": "Position of the stage in the pipeline. Defaults to 1."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Stage ID",
                        "example": "12"
                    },
                    "title": {
                        "type": "string",
                        "title": "Title",
                        "example": "Qualified"
                    },
                    "group": {
                        "type": "string",
                        "title": "Pipeline ID",
                        "example": "5"
                    },
                    "color": {
                        "type": "string",
                        "title": "Color",
                        "example": "a6b1e1"
                    },
                    "order": {
                        "type": "string",
                        "title": "Order",
                        "example": "1"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
