{
    "version": "1.0.0",
    "name": "appmixer.smartsheet.core.UpdateWorkspace",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Updates a workspace.",
    "private": false,
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "required": [
                    "workspaceId"
                ],
                "properties": {
                    "workspaceId": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "workspaceId": {
                        "type": "text",
                        "index": 0,
                        "label": "Workspace Id",
                        "tooltip": "<p>WorkspaceID of the worksheet being accessed.</p>",
                        "source": {
                            "url": "/component/appmixer/smartsheet/core/ListWorkspaces?outPort=out",
                            "data": {
                                "transform": "./ListWorkspaces#workspacesToSelectArray"
                            }
                        }
                    },
                    "name": {
                        "type": "text",
                        "index": 1,
                        "label": "Name",
                        "tooltip": "<p>Name of the workspace.</p>"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Version",
                    "value": "version",
                    "schema": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "Failed Items",
                    "value": "failedItems",
                    "schema": {
                        "description": "Array of BulkItemFailure objects which represents the items that failed to be added or updated. See [Partial Success](/partial-success) for more information. Applicable only for bulk operations that support partial success.",
                        "type": "array",
                        "nullable": true,
                        "items": {
                            "type": "object",
                            "properties": {
                                "rowId": {
                                    "description": "The Id of the row that failed. Applicable only to bulk row operations.",
                                    "type": "number",
                                    "nullable": true,
                                    "example": 1
                                },
                                "error": {
                                    "description": "The error caused by the failed item.",
                                    "type": "object",
                                    "properties": {
                                        "refId": {
                                            "description": "The Id of the specific error occurrence. Please include this information when contacting Smartsheet support.",
                                            "type": "string",
                                            "example": "abc123def456"
                                        },
                                        "errorCode": {
                                            "description": "Custom error code from Smartsheet. See the complete [Error Code List](../#section/Error-Code-List).",
                                            "type": "number",
                                            "example": 1
                                        },
                                        "message": {
                                            "description": "Descriptive error message.",
                                            "type": "string",
                                            "example": "The row was not found."
                                        }
                                    }
                                },
                                "index": {
                                    "description": "The index of the failed item in the bulk request array.",
                                    "type": "number",
                                    "example": 1
                                }
                            }
                        },
                        "example": []
                    }
                },
                {
                    "label": "Message",
                    "value": "message",
                    "schema": {
                        "type": "string",
                        "example": "SUCCESS"
                    }
                },
                {
                    "label": "Result Code",
                    "value": "resultCode",
                    "schema": {
                        "type": "integer",
                        "example": 0
                    }
                },
                {
                    "label": "Result",
                    "value": "result",
                    "schema": {
                        "type": "object",
                        "example": {
                            "id": 5629298236827524,
                            "name": "Marketing EMEA",
                            "accessLevel": "OWNER",
                            "permalink": "https://app.smartsheet.com/workspaces/3Vn8kR2wHq7vMc4pXj3gLf6c"
                        }
                    }
                },
                {
                    "label": "Result Id",
                    "value": "result.id",
                    "schema": {
                        "type": "number",
                        "example": 5629298236827524
                    }
                },
                {
                    "label": "Result Name",
                    "value": "result.name",
                    "schema": {
                        "type": "string",
                        "example": "Marketing EMEA"
                    }
                },
                {
                    "label": "Result Access Level",
                    "value": "result.accessLevel",
                    "schema": {
                        "type": "string",
                        "example": "OWNER"
                    }
                },
                {
                    "label": "Result Permalink",
                    "value": "result.permalink",
                    "schema": {
                        "type": "string",
                        "example": "https://app.smartsheet.com/workspaces/3Vn8kR2wHq7vMc4pXj3gLf6c"
                    }
                }
            ]
        }
    ],
    "auth": {
        "service": "appmixer:smartsheet"
    },
    "icon": "data:image/svg+xml;base64,"
}
