{
    "version": "1.0.0",
    "name": "appmixer.smartsheet.core.GetSheet",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Gets a sheet in the format specified, based on the sheet Id.",
    "private": false,
   
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "required": [
                    "sheetId"
                ],
                "properties": {
                    
                    "sheetId": {
                        "type": "number"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "sheetId": {
                        "type": "number",
                        "index": 0,
                        "label": "Sheet Id",
                        "tooltip": "<p>Sheet Id of the sheet being accessed.</p>",
                        "source": {
                            "url": "/component/appmixer/smartsheet/core/ListSheets?outPort=out",
                            "data": {
                                "transform": "./ListSheets#sheetsToSelectArray"
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Sheet ID",
                    "value": "id",
                    "schema": {
                        "type": "number",
                        "example": 4583173393803140
                    }
                },
                {
                    "label": "From ID",
                    "value": "fromId",
                    "schema": {
                        "type": [
                            "number",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "Owner ID",
                    "value": "ownerId",
                    "schema": {
                        "type": "number",
                        "example": 94094820842
                    }
                },
                {
                    "label": "Access Level",
                    "value": "accessLevel",
                    "schema": {
                        "type": "string",
                        "example": "OWNER"
                    }
                },
                {
                    "label": "Attachments",
                    "value": "attachments",
                    "schema": {
                        "type": "array",
                        "example": []
                    }
                },
                {
                    "label": "Columns",
                    "value": "columns",
                    "schema": {
                        "type": "array",
                        "example": [
                            {
                                "id": 7960873114331012,
                                "index": 0,
                                "title": "Task",
                                "type": "TEXT_NUMBER",
                                "primary": true,
                                "width": 150
                            },
                            {
                                "id": 642523719853956,
                                "index": 1,
                                "title": "Status",
                                "type": "PICKLIST",
                                "options": [
                                    "Not started",
                                    "In progress",
                                    "Done"
                                ],
                                "width": 100
                            }
                        ]
                    }
                },
                {
                    "label": "Created At",
                    "value": "createdAt",
                    "schema": {
                        "type": "string",
                        "example": "2026-01-10T08:00:00Z"
                    }
                },
                {
                    "label": "Dependencies Enabled",
                    "value": "dependenciesEnabled",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Discussions",
                    "value": "discussions",
                    "schema": {
                        "type": "array",
                        "example": []
                    }
                },
                {
                    "label": "Effective Attachment Options",
                    "value": "effectiveAttachmentOptions",
                    "schema": {
                        "type": "array",
                        "example": [
                            "FILE",
                            "GOOGLE_DRIVE",
                            "LINK"
                        ]
                    }
                },
                {
                    "label": "Favorite",
                    "value": "favorite",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Gantt Enabled",
                    "value": "ganttEnabled",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Has Summary Fields",
                    "value": "hasSummaryFields",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Modified At",
                    "value": "modifiedAt",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00Z"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Project Plan"
                    }
                },
                {
                    "label": "Owner",
                    "value": "owner",
                    "schema": {
                        "type": "string",
                        "example": "jane.doe@example.com"
                    }
                },
                {
                    "label": "Permalink",
                    "value": "permalink",
                    "schema": {
                        "type": "string",
                        "example": "https://app.smartsheet.com/sheets/8Qp3vW6xJk2mNr5tYh9cLb4d"
                    }
                },
                {
                    "label": "Project Settings",
                    "value": "projectSettings",
                    "schema": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "Read Only",
                    "value": "readOnly",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Resource Management Enabled",
                    "value": "resourceManagementEnabled",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Resource Management Type",
                    "value": "resourceManagementType",
                    "schema": {
                        "type": "string",
                        "example": "NONE"
                    }
                },
                {
                    "label": "Rows",
                    "value": "rows",
                    "schema": {
                        "type": "array",
                        "example": [
                            {
                                "id": 2361756178769796,
                                "rowNumber": 1,
                                "expanded": true,
                                "createdAt": "2026-01-10T08:05:00Z",
                                "modifiedAt": "2026-09-10T08:30:00Z",
                                "cells": [
                                    {
                                        "columnId": 7960873114331012,
                                        "value": "Launch plan",
                                        "displayValue": "Launch plan"
                                    },
                                    {
                                        "columnId": 642523719853956,
                                        "value": "In progress",
                                        "displayValue": "In progress"
                                    }
                                ]
                            }
                        ]
                    }
                },
                {
                    "label": "Show Parent Rows For Filters",
                    "value": "showParentRowsForFilters",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Source",
                    "value": "source",
                    "schema": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "Summary",
                    "value": "summary",
                    "schema": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "Total Row Count",
                    "value": "totalRowCount",
                    "schema": {
                        "type": "integer",
                        "example": 12
                    }
                },
                {
                    "label": "User Permissions",
                    "value": "userPermissions",
                    "schema": {
                        "type": "object",
                        "example": {
                            "summaryPermissions": "ADMIN"
                        }
                    }
                },
                {
                    "label": "User Settings",
                    "value": "userSettings",
                    "schema": {
                        "type": "object",
                        "example": {
                            "criticalPathEnabled": false,
                            "displaySummaryTasks": true
                        }
                    }
                },
                {
                    "label": "Version",
                    "value": "version",
                    "schema": {
                        "type": "integer",
                        "example": 42
                    }
                },
                {
                    "label": "Workspace",
                    "value": "workspace",
                    "schema": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "example": {
                            "id": 5629298236827524,
                            "name": "Marketing"
                        }
                    }
                }
            ]            
        }
    ],
   
    "auth": {
        "service": "appmixer:smartsheet"
    },
    "icon": "data:image/svg+xml;base64,"
}