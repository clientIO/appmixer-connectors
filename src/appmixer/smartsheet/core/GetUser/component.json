{
    "version": "1.0.0",
    "name": "appmixer.smartsheet.core.GetUser",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieves details of the specified user. For system administrators, additional UserProfile attributes in the response include admin, customWelcomeScreenViewed (only if an Enterprise user has viewed the Custom Welcome Screen), groupAdmin, lastLogin (if the user has logged in), licensedSheetCreator, resourceViewer, sheetCount (if the user’s status is ACTIVE), and status.",
    "private": false,
   
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "required": [
                    "userId"
                ],
                "properties": {
                    
                    "userId": {
                        "type": "number"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "userId": {
                        "type": "number",
                        "index": 0,
                        "label": "User Id",
                        "tooltip": "<p>User Id</p>",
                        "source": {
                            "url": "/component/appmixer/smartsheet/core/ListUsers?outPort=out",
                            "data": {
                                "transform": "./ListUsers#usersToSelectArray"
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "number",
                        "example": 4583173393803140
                    }
                },
                {
                    "label": "Account",
                    "value": "account",
                    "schema": {
                        "type": "object",
                        "example": {
                            "id": 2331373580117892,
                            "name": "Acme Corp"
                        }
                    }
                },
                {
                    "label": "Account Id",
                    "value": "account.id",
                    "schema": {
                        "type": "number",
                        "example": 2331373580117892
                    }
                },
                {
                    "label": "Account Name",
                    "value": "account.name",
                    "schema": {
                        "type": "string",
                        "example": "Acme Corp"
                    }
                },
                {
                    "label": "Admin",
                    "value": "admin",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Alternate Emails",
                    "value": "alternateEmails",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "number",
                                    "title": "Alternate Emails.ID"
                                },
                                "confirmed": {
                                    "type": "boolean",
                                    "title": "Alternate Emails.Confirmed"
                                },
                                "email": {
                                    "type": "string",
                                    "title": "Alternate Emails.Email"
                                }
                            }
                        },
                        "example": [
                            {
                                "id": 7616317696272260,
                                "confirmed": true,
                                "email": "jane.doe.alt@acme.example.com"
                            }
                        ]
                    }
                },
                {
                    "label": "Company",
                    "value": "company",
                    "schema": {
                        "type": "string",
                        "example": "Acme Corp"
                    }
                },
                {
                    "label": "Custom Welcome Screen Viewed",
                    "value": "customWelcomeScreenViewed",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "2026-03-02T09:15:00Z"
                    }
                },
                {
                    "label": "Department",
                    "value": "department",
                    "schema": {
                        "type": "string",
                        "example": "Operations"
                    }
                },
                {
                    "label": "Email",
                    "value": "email",
                    "schema": {
                        "type": "string",
                        "example": "jane.doe@acme.example.com"
                    }
                },
                {
                    "label": "First Name",
                    "value": "firstName",
                    "schema": {
                        "type": "string",
                        "example": "Jane"
                    }
                },
                {
                    "label": "Group Admin",
                    "value": "groupAdmin",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Jira Admin",
                    "value": "jiraAdmin",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Last Login",
                    "value": "lastLogin",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "2026-09-10T08:30:00Z"
                    }
                },
                {
                    "label": "Last Name",
                    "value": "lastName",
                    "schema": {
                        "type": "string",
                        "example": "Doe"
                    }
                },
                {
                    "label": "Licensed Sheet Creator",
                    "value": "licensedSheetCreator",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "Locale",
                    "value": "locale",
                    "schema": {
                        "type": "string",
                        "example": "en_US"
                    }
                },
                {
                    "label": "Mobile Phone",
                    "value": "mobilePhone",
                    "schema": {
                        "type": "string",
                        "example": "+1 555 010 0199"
                    }
                },
                {
                    "label": "Profile Image",
                    "value": "profileImage",
                    "schema": {
                        "type": "object",
                        "example": {
                            "imageId": "u!1!nAtdn5RJB_o!k6_e_3h2R3w!wmYXPek-yVD",
                            "height": 1050,
                            "width": 1050
                        }
                    }
                },
                {
                    "label": "Profile Image Image Id",
                    "value": "profileImage.imageId",
                    "schema": {
                        "type": "string",
                        "example": "u!1!nAtdn5RJB_o!k6_e_3h2R3w!wmYXPek-yVD"
                    }
                },
                {
                    "label": "Profile Image Height",
                    "value": "profileImage.height",
                    "schema": {
                        "type": "integer",
                        "example": 1050
                    }
                },
                {
                    "label": "Profile Image Width",
                    "value": "profileImage.width",
                    "schema": {
                        "type": "integer",
                        "example": 1050
                    }
                },
                {
                    "label": "Resource Viewer",
                    "value": "resourceViewer",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Role",
                    "value": "role",
                    "schema": {
                        "type": "string",
                        "example": "Project Manager"
                    }
                },
                {
                    "label": "Salesforce Admin",
                    "value": "salesforceAdmin",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Salesforce User",
                    "value": "salesforceUser",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Sheet Count",
                    "value": "sheetCount",
                    "schema": {
                        "type": "integer",
                        "example": 42
                    }
                },
                {
                    "label": "Time Zone",
                    "value": "timeZone",
                    "schema": {
                        "type": "string",
                        "example": "US/Pacific"
                    }
                },
                {
                    "label": "Title",
                    "value": "title",
                    "schema": {
                        "type": "string",
                        "example": "Senior Project Manager"
                    }
                },
                {
                    "label": "Work Phone",
                    "value": "workPhone",
                    "schema": {
                        "type": "string",
                        "example": "+1 555 010 0100"
                    }
                }
            ]
        }
    ],
   
    "auth": {
        "service": "appmixer:smartsheet"
    },
    "icon": "data:image/svg+xml;base64,"
}