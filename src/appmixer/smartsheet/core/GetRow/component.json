{
    "version": "1.0.0",
    "name": "appmixer.smartsheet.core.GetRow",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Gets the row specified in the URL.",
    "private": false,
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "required": [
                    "sheetId",
                    "rowId"
                ],
                "properties": {
                    "sheetId": {
                        "type": "number"
                    },
                    "rowId": {
                        "type": "number"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "sheetId": {
                        "type": "number",
                        "index": 0,
                        "label": "Sheet Id",
                        "tooltip": "<p>Sheet Id of the sheet being accessed.</p>",
                        "source": {
                            "url": "/component/appmixer/smartsheet/core/ListSheets?outPort=out",
                            "data": {
                                "transform": "./ListSheets#sheetsToSelectArray"
                            }
                        }
                    },
                    "rowId": {
                        "type": "number",
                        "index": 1,
                        "label": "Row Id",
                        "tooltip": "<p>Row Id in the sheet being accessed.</p>"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "number",
                        "example": 2361756178769796
                    }
                },
                {
                    "label": "Sheet Id",
                    "value": "sheetId",
                    "schema": {
                        "type": "number",
                        "example": 4583173393803140
                    }
                },
                {
                    "label": "Row Number",
                    "value": "rowNumber",
                    "schema": {
                        "type": "integer",
                        "example": 1
                    }
                },
                {
                    "label": "Expanded",
                    "value": "expanded",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "Cells",
                    "value": "cells",
                    "schema": {
                        "description": "Cells objects.",
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "columnId": {
                                    "type": "number",
                                    "description": "The Id of the column that the cell is located in.",
                                    "example": 1
                                },
                                "columnType": {
                                    "type": "string",
                                    "description": "Only returned if the include query string parameter contains **columnType**.",
                                    "example": "TEXT_NUMBER"
                                },
                                "value": {
                                    "anyOf": [
                                        {
                                            "type": "string"
                                        },
                                        {
                                            "type": "number"
                                        },
                                        {
                                            "type": "boolean"
                                        }
                                    ],
                                    "description": "A string, number, or a Boolean value -- depending on the cell type and the data in the cell. Cell values larger than 4000 characters are silently truncated. An empty cell returns no value.",
                                    "example": "Sample cell value"
                                },
                                "displayValue": {
                                    "type": "string",
                                    "description": "Visual representation of cell contents, as presented to the user in the UI.",
                                    "example": "$1,000.00"
                                }
                            }
                        },
                        "example": [
                            {
                                "columnId": 1,
                                "columnType": "TEXT_NUMBER",
                                "value": "Sample cell value",
                                "displayValue": "$1,000.00"
                            }
                        ]
                    }
                },
                {
                    "label": "Created At",
                    "value": "createdAt",
                    "schema": {
                        "type": "string",
                        "example": "2026-01-10T08:05:00Z"
                    }
                },
                {
                    "label": "Modified At",
                    "value": "modifiedAt",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00Z"
                    }
                }
            ]
        }
    ],
    "auth": {
        "service": "appmixer:smartsheet"
    },
    "icon": "data:image/svg+xml;base64,"
}
