{
    "name": "appmixer.telegram.user.GetChannel",
    "label": "Get Channel",
    "description": "Retrieves details of a public Telegram channel without joining it: title, description, subscriber count, and whether the channel is public, verified, or restricted.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:telegram:user"
    },
    "quota": {
        "manager": "appmixer:telegram:user",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "channel": {
                        "type": "string"
                    }
                },
                "required": [
                    "channel"
                ]
            },
            "inspector": {
                "inputs": {
                    "channel": {
                        "type": "text",
                        "index": 1,
                        "label": "Channel",
                        "tooltip": "Public channel <i>@username</i> or <i>https://t.me/username</i> link. Private channels and invite links are not supported."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": { "type": "string", "title": "Channel ID", "example": "1006503122" },
                    "username": { "type": "string", "title": "Username", "example": "durov" },
                    "title": { "type": "string", "title": "Title", "example": "Du Rove's Channel" },
                    "description": { "type": "string", "title": "Description", "example": "Thoughts from the founder of Telegram." },
                    "url": { "type": "string", "title": "URL", "example": "https://t.me/durov" },
                    "type": { "type": "string", "title": "Type", "example": "channel" },
                    "subscribers_count": { "type": "integer", "title": "Subscribers Count", "example": 10234567 },
                    "is_public": { "type": "boolean", "title": "Is Public", "example": true },
                    "is_verified": { "type": "boolean", "title": "Is Verified", "example": true },
                    "is_scam": { "type": "boolean", "title": "Is Scam", "example": false },
                    "is_fake": { "type": "boolean", "title": "Is Fake", "example": false },
                    "is_restricted": { "type": "boolean", "title": "Is Restricted", "example": false },
                    "restriction_reason": { "type": "string", "title": "Restriction Reason", "example": "This channel can't be displayed in your region." },
                    "created_at": { "type": "string", "title": "Created At", "format": "date-time", "example": "2015-09-17T19:40:12.000Z" },
                    "linked_chat_id": { "type": "string", "title": "Linked Discussion Group ID", "example": "1293754880" }
                },
                "required": [
                    "id",
                    "title",
                    "type",
                    "is_public",
                    "is_verified"
                ]
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
