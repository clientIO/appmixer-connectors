{
    "name": "appmixer.telegram.core.ForwardMessage",
    "label": "Forward Message",
    "description": "Forwards a message from one chat to another, keeping the original author attribution. The bot must be a member of both chats.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:telegram"
    },
    "quota": {
        "manager": "appmixer:telegram",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "chatId": {
                        "type": "string"
                    },
                    "fromChatId": {
                        "type": "string"
                    },
                    "messageId": {
                        "type": "integer"
                    },
                    "disableNotification": {
                        "type": "boolean"
                    },
                    "protectContent": {
                        "type": "boolean"
                    },
                    "messageThreadId": {
                        "type": "integer"
                    }
                },
                "required": [
                    "chatId",
                    "fromChatId",
                    "messageId"
                ]
            },
            "inspector": {
                "inputs": {
                    "chatId": {
                        "type": "text",
                        "index": 1,
                        "label": "Chat ID",
                        "tooltip": "Numeric chat ID (for example <i>-1002345678901</i> for a group or channel) or a public <i>@channelusername</i>. The bot must be a member of the chat. Chat IDs are emitted by the New Message trigger."
                    },
                    "fromChatId": {
                        "type": "text",
                        "index": 2,
                        "label": "From Chat ID",
                        "tooltip": "Chat the message is forwarded from - numeric ID or @channelusername."
                    },
                    "messageId": {
                        "type": "number",
                        "index": 3,
                        "label": "Message ID",
                        "tooltip": "ID of the message in the source chat."
                    },
                    "disableNotification": {
                        "type": "toggle",
                        "index": 4,
                        "label": "Disable Notification",
                        "tooltip": "Deliver the message silently - recipients get no sound notification."
                    },
                    "protectContent": {
                        "type": "toggle",
                        "index": 5,
                        "label": "Protect Content",
                        "tooltip": "Block forwarding and saving of the sent message."
                    },
                    "messageThreadId": {
                        "type": "number",
                        "index": 6,
                        "label": "Thread ID",
                        "tooltip": "Target a specific topic in a forum supergroup."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "message_id": {
                        "type": "integer",
                        "title": "Message ID",
                        "example": 1042
                    },
                    "message_thread_id": {
                        "type": "integer",
                        "title": "Thread ID",
                        "example": 12
                    },
                    "from": {
                        "type": "object",
                        "title": "From",
                        "required": [
                            "id",
                            "is_bot",
                            "first_name"
                        ],
                        "properties": {
                            "id": {
                                "type": "integer",
                                "title": "From.ID",
                                "example": 8865231953
                            },
                            "is_bot": {
                                "type": "boolean",
                                "title": "From.Is Bot",
                                "example": true
                            },
                            "first_name": {
                                "type": "string",
                                "title": "From.First Name",
                                "example": "AppmixerTest"
                            },
                            "last_name": {
                                "type": "string",
                                "title": "From.Last Name",
                                "example": "Novakova"
                            },
                            "username": {
                                "type": "string",
                                "title": "From.Username",
                                "example": "appmixer_test_bot"
                            },
                            "language_code": {
                                "type": "string",
                                "title": "From.Language Code",
                                "example": "cs"
                            }
                        },
                        "example": {
                            "id": 8865231953,
                            "is_bot": true,
                            "first_name": "AppmixerTest",
                            "username": "appmixer_test_bot"
                        }
                    },
                    "chat": {
                        "type": "object",
                        "title": "Chat",
                        "required": [
                            "id",
                            "type"
                        ],
                        "properties": {
                            "id": {
                                "type": "integer",
                                "title": "Chat.ID",
                                "example": -1002345678901
                            },
                            "type": {
                                "type": "string",
                                "title": "Chat.Type",
                                "example": "supergroup"
                            },
                            "title": {
                                "type": "string",
                                "title": "Chat.Title",
                                "example": "Product Team"
                            },
                            "username": {
                                "type": "string",
                                "title": "Chat.Username",
                                "example": "product_team"
                            },
                            "first_name": {
                                "type": "string",
                                "title": "Chat.First Name",
                                "example": "Jana"
                            },
                            "last_name": {
                                "type": "string",
                                "title": "Chat.Last Name",
                                "example": "Novakova"
                            },
                            "is_forum": {
                                "type": "boolean",
                                "title": "Chat.Is Forum",
                                "example": false
                            },
                            "all_members_are_administrators": {
                                "type": "boolean",
                                "title": "Chat.All Members Are Administrators",
                                "example": false
                            }
                        },
                        "example": {
                            "id": -1002345678901,
                            "type": "supergroup",
                            "title": "Product Team"
                        }
                    },
                    "date": {
                        "type": "integer",
                        "title": "Date (Unix Time)",
                        "example": 1756200000
                    },
                    "forward_origin": {
                        "type": "object",
                        "title": "Forward Origin",
                        "properties": {
                            "type": {
                                "type": "string",
                                "title": "Forward Origin.Type",
                                "example": "user"
                            },
                            "date": {
                                "type": "integer",
                                "title": "Forward Origin.Original Date (Unix Time)",
                                "example": 1735689600
                            },
                            "sender_user": {
                                "type": "object",
                                "title": "Forward Origin.Original Sender",
                                "required": [
                                    "id",
                                    "is_bot",
                                    "first_name"
                                ],
                                "properties": {
                                    "id": {
                                        "type": "integer",
                                        "title": "Forward Origin.Original Sender.ID",
                                        "example": 6412345678
                                    },
                                    "is_bot": {
                                        "type": "boolean",
                                        "title": "Forward Origin.Original Sender.Is Bot",
                                        "example": false
                                    },
                                    "first_name": {
                                        "type": "string",
                                        "title": "Forward Origin.Original Sender.First Name",
                                        "example": "Jana"
                                    },
                                    "last_name": {
                                        "type": "string",
                                        "title": "Forward Origin.Original Sender.Last Name",
                                        "example": "Novakova"
                                    },
                                    "username": {
                                        "type": "string",
                                        "title": "Forward Origin.Original Sender.Username",
                                        "example": "jana_novakova"
                                    },
                                    "language_code": {
                                        "type": "string",
                                        "title": "Forward Origin.Original Sender.Language Code",
                                        "example": "cs"
                                    }
                                },
                                "example": {
                                    "id": 6412345678,
                                    "is_bot": false,
                                    "first_name": "Jana",
                                    "username": "jana_novakova"
                                }
                            },
                            "sender_user_name": {
                                "type": "string",
                                "title": "Forward Origin.Original Sender Name",
                                "example": "Jana N."
                            },
                            "sender_chat": {
                                "type": "object",
                                "title": "Forward Origin.Original Sender Chat",
                                "required": [
                                    "id",
                                    "type"
                                ],
                                "properties": {
                                    "id": {
                                        "type": "integer",
                                        "title": "Forward Origin.Original Sender Chat.ID",
                                        "example": -1002345678901
                                    },
                                    "type": {
                                        "type": "string",
                                        "title": "Forward Origin.Original Sender Chat.Type",
                                        "example": "supergroup"
                                    },
                                    "title": {
                                        "type": "string",
                                        "title": "Forward Origin.Original Sender Chat.Title",
                                        "example": "Product Team"
                                    },
                                    "username": {
                                        "type": "string",
                                        "title": "Forward Origin.Original Sender Chat.Username",
                                        "example": "product_team"
                                    },
                                    "first_name": {
                                        "type": "string",
                                        "title": "Forward Origin.Original Sender Chat.First Name",
                                        "example": "Jana"
                                    },
                                    "last_name": {
                                        "type": "string",
                                        "title": "Forward Origin.Original Sender Chat.Last Name",
                                        "example": "Novakova"
                                    },
                                    "is_forum": {
                                        "type": "boolean",
                                        "title": "Forward Origin.Original Sender Chat.Is Forum",
                                        "example": false
                                    },
                                    "all_members_are_administrators": {
                                        "type": "boolean",
                                        "title": "Forward Origin.Original Sender Chat.All Members Are Administrators",
                                        "example": false
                                    }
                                },
                                "example": {
                                    "id": -1002345678901,
                                    "type": "supergroup",
                                    "title": "Product Team"
                                }
                            },
                            "chat": {
                                "type": "object",
                                "title": "Forward Origin.Origin Channel",
                                "required": [
                                    "id",
                                    "type"
                                ],
                                "properties": {
                                    "id": {
                                        "type": "integer",
                                        "title": "Forward Origin.Origin Channel.ID",
                                        "example": -1002345678901
                                    },
                                    "type": {
                                        "type": "string",
                                        "title": "Forward Origin.Origin Channel.Type",
                                        "example": "channel"
                                    },
                                    "title": {
                                        "type": "string",
                                        "title": "Forward Origin.Origin Channel.Title",
                                        "example": "Product Team"
                                    },
                                    "username": {
                                        "type": "string",
                                        "title": "Forward Origin.Origin Channel.Username",
                                        "example": "product_team"
                                    },
                                    "first_name": {
                                        "type": "string",
                                        "title": "Forward Origin.Origin Channel.First Name",
                                        "example": "Jana"
                                    },
                                    "last_name": {
                                        "type": "string",
                                        "title": "Forward Origin.Origin Channel.Last Name",
                                        "example": "Novakova"
                                    },
                                    "is_forum": {
                                        "type": "boolean",
                                        "title": "Forward Origin.Origin Channel.Is Forum",
                                        "example": false
                                    },
                                    "all_members_are_administrators": {
                                        "type": "boolean",
                                        "title": "Forward Origin.Origin Channel.All Members Are Administrators",
                                        "example": false
                                    }
                                },
                                "example": {
                                    "id": -1002345678901,
                                    "type": "channel",
                                    "title": "Product Team"
                                }
                            },
                            "message_id": {
                                "type": "integer",
                                "title": "Forward Origin.Original Message ID",
                                "example": 1042
                            },
                            "author_signature": {
                                "type": "string",
                                "title": "Forward Origin.Author Signature",
                                "example": "Jana"
                            }
                        },
                        "required": [
                            "type",
                            "date"
                        ]
                    },
                    "is_automatic_forward": {
                        "type": "boolean",
                        "title": "Is Automatic Forward",
                        "example": false
                    },
                    "text": {
                        "type": "string",
                        "title": "Text",
                        "example": "Hello from your workflow!"
                    },
                    "caption": {
                        "type": "string",
                        "title": "Caption",
                        "example": "Quarterly report"
                    },
                    "photo": {
                        "type": "array",
                        "title": "Photo Sizes",
                        "items": {
                            "type": "object",
                            "required": [
                                "file_id",
                                "file_unique_id",
                                "width",
                                "height"
                            ],
                            "properties": {
                                "file_id": {
                                    "type": "string",
                                    "title": "File ID"
                                },
                                "file_unique_id": {
                                    "type": "string",
                                    "title": "File Unique ID"
                                },
                                "width": {
                                    "type": "integer",
                                    "title": "Width"
                                },
                                "height": {
                                    "type": "integer",
                                    "title": "Height"
                                },
                                "file_size": {
                                    "type": "integer",
                                    "title": "File Size"
                                }
                            }
                        },
                        "example": [
                            {
                                "file_id": "AgACAgIAAxkBAAIB",
                                "file_unique_id": "AQADr8gxG9c",
                                "width": 1280,
                                "height": 720,
                                "file_size": 84213
                            }
                        ]
                    },
                    "document": {
                        "type": "object",
                        "title": "Document",
                        "required": [
                            "file_id",
                            "file_unique_id"
                        ],
                        "properties": {
                            "file_id": {
                                "type": "string",
                                "title": "Document.File ID"
                            },
                            "file_unique_id": {
                                "type": "string",
                                "title": "Document.File Unique ID"
                            },
                            "file_name": {
                                "type": "string",
                                "title": "Document.File Name"
                            },
                            "mime_type": {
                                "type": "string",
                                "title": "Document.MIME Type"
                            },
                            "file_size": {
                                "type": "integer",
                                "title": "Document.File Size"
                            }
                        },
                        "example": {
                            "file_id": "BQACAgIAAxkBAAIB",
                            "file_unique_id": "AgADr8gxG9c",
                            "file_name": "report.pdf",
                            "mime_type": "application/pdf",
                            "file_size": 24518
                        }
                    }
                },
                "required": [
                    "message_id",
                    "date",
                    "chat"
                ]
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
