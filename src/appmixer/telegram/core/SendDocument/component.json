{
    "name": "appmixer.telegram.core.SendDocument",
    "label": "Send Document",
    "description": "Sends a file to a Telegram chat. Provide either a public file URL or a Telegram file ID, or pick a stored file to upload. Bot uploads are capped at 50 MB by Telegram.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:telegram"
    },
    "quota": {
        "manager": "appmixer:telegram",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "chatId": {
                        "type": "string"
                    },
                    "document": {
                        "type": "string"
                    },
                    "fileId": {
                        "type": "string"
                    },
                    "fileName": {
                        "type": "string"
                    },
                    "caption": {
                        "type": "string"
                    },
                    "parseMode": {
                        "type": "string"
                    },
                    "disableNotification": {
                        "type": "boolean"
                    },
                    "protectContent": {
                        "type": "boolean"
                    },
                    "messageThreadId": {
                        "type": "integer"
                    },
                    "replyToMessageId": {
                        "type": "integer"
                    }
                },
                "required": [
                    "chatId"
                ]
            },
            "inspector": {
                "inputs": {
                    "chatId": {
                        "type": "text",
                        "index": 1,
                        "label": "Chat ID",
                        "tooltip": "Numeric chat ID (for example <i>-1002345678901</i> for a group or channel) or a public <i>@channelusername</i>. The bot must be a member of the chat. Chat IDs are emitted by the New Message trigger."
                    },
                    "document": {
                        "type": "text",
                        "index": 2,
                        "label": "Document URL or File ID",
                        "tooltip": "A public HTTPS file URL, or a Telegram file ID of a document already on Telegram's servers. Leave empty when uploading a stored file instead."
                    },
                    "fileId": {
                        "type": "filepicker",
                        "index": 3,
                        "label": "File",
                        "tooltip": "Upload a stored file instead of referencing a URL. Takes precedence over Document URL or File ID."
                    },
                    "fileName": {
                        "type": "text",
                        "index": 4,
                        "label": "File Name",
                        "tooltip": "Override the name shown in Telegram. Defaults to the uploaded file's own name."
                    },
                    "caption": {
                        "type": "textarea",
                        "index": 5,
                        "label": "Caption",
                        "tooltip": "Text shown under the document. Up to 1024 characters."
                    },
                    "parseMode": {
                        "type": "select",
                        "index": 6,
                        "label": "Parse Mode",
                        "tooltip": "How to interpret formatting in the text or caption.",
                        "options": [
                            {
                                "label": "Plain text",
                                "value": ""
                            },
                            {
                                "label": "HTML",
                                "value": "HTML"
                            },
                            {
                                "label": "MarkdownV2",
                                "value": "MarkdownV2"
                            },
                            {
                                "label": "Markdown (legacy)",
                                "value": "Markdown"
                            }
                        ],
                        "defaultValue": ""
                    },
                    "disableNotification": {
                        "type": "toggle",
                        "index": 7,
                        "label": "Disable Notification",
                        "tooltip": "Deliver the message silently - recipients get no sound notification."
                    },
                    "protectContent": {
                        "type": "toggle",
                        "index": 8,
                        "label": "Protect Content",
                        "tooltip": "Block forwarding and saving of the sent message."
                    },
                    "messageThreadId": {
                        "type": "number",
                        "index": 9,
                        "label": "Thread ID",
                        "tooltip": "Target a specific topic in a forum supergroup."
                    },
                    "replyToMessageId": {
                        "type": "number",
                        "index": 10,
                        "label": "Reply To Message ID",
                        "tooltip": "Send this message as a reply to an existing message in the same chat."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "message_id": {
                        "type": "integer",
                        "title": "Message ID",
                        "example": 1042
                    },
                    "message_thread_id": {
                        "type": "integer",
                        "title": "Thread ID",
                        "example": 12
                    },
                    "from": {
                        "type": "object",
                        "title": "From",
                        "required": [
                            "id",
                            "is_bot",
                            "first_name"
                        ],
                        "properties": {
                            "id": {
                                "type": "integer",
                                "title": "From.ID",
                                "example": 8865231953
                            },
                            "is_bot": {
                                "type": "boolean",
                                "title": "From.Is Bot",
                                "example": true
                            },
                            "first_name": {
                                "type": "string",
                                "title": "From.First Name",
                                "example": "AppmixerTest"
                            },
                            "last_name": {
                                "type": "string",
                                "title": "From.Last Name",
                                "example": "Novakova"
                            },
                            "username": {
                                "type": "string",
                                "title": "From.Username",
                                "example": "appmixer_test_bot"
                            },
                            "language_code": {
                                "type": "string",
                                "title": "From.Language Code",
                                "example": "cs"
                            }
                        },
                        "example": {
                            "id": 8865231953,
                            "is_bot": true,
                            "first_name": "AppmixerTest",
                            "username": "appmixer_test_bot"
                        }
                    },
                    "chat": {
                        "type": "object",
                        "title": "Chat",
                        "required": [
                            "id",
                            "type"
                        ],
                        "properties": {
                            "id": {
                                "type": "integer",
                                "title": "Chat.ID",
                                "example": -1002345678901
                            },
                            "type": {
                                "type": "string",
                                "title": "Chat.Type",
                                "example": "supergroup"
                            },
                            "title": {
                                "type": "string",
                                "title": "Chat.Title",
                                "example": "Product Team"
                            },
                            "username": {
                                "type": "string",
                                "title": "Chat.Username",
                                "example": "product_team"
                            },
                            "first_name": {
                                "type": "string",
                                "title": "Chat.First Name",
                                "example": "Jana"
                            },
                            "last_name": {
                                "type": "string",
                                "title": "Chat.Last Name",
                                "example": "Novakova"
                            },
                            "is_forum": {
                                "type": "boolean",
                                "title": "Chat.Is Forum",
                                "example": false
                            },
                            "all_members_are_administrators": {
                                "type": "boolean",
                                "title": "Chat.All Members Are Administrators",
                                "example": false
                            }
                        },
                        "example": {
                            "id": -1002345678901,
                            "type": "supergroup",
                            "title": "Product Team"
                        }
                    },
                    "date": {
                        "type": "integer",
                        "title": "Date (Unix Time)",
                        "example": 1756200000
                    },
                    "document": {
                        "type": "object",
                        "title": "Document",
                        "required": [
                            "file_id",
                            "file_unique_id"
                        ],
                        "properties": {
                            "file_id": {
                                "type": "string",
                                "title": "Document.File ID"
                            },
                            "file_unique_id": {
                                "type": "string",
                                "title": "Document.File Unique ID"
                            },
                            "file_name": {
                                "type": "string",
                                "title": "Document.File Name"
                            },
                            "mime_type": {
                                "type": "string",
                                "title": "Document.MIME Type"
                            },
                            "file_size": {
                                "type": "integer",
                                "title": "Document.File Size"
                            }
                        },
                        "example": {
                            "file_id": "BQACAgIAAxkBAAIB",
                            "file_unique_id": "AgADr8gxG9c",
                            "file_name": "report.pdf",
                            "mime_type": "application/pdf",
                            "file_size": 24518
                        }
                    },
                    "caption": {
                        "type": "string",
                        "title": "Caption",
                        "example": "Quarterly report"
                    },
                    "reply_to_message": {
                        "type": "object",
                        "title": "Reply To Message",
                        "required": [
                            "message_id",
                            "date",
                            "chat"
                        ],
                        "properties": {
                            "message_id": {
                                "type": "integer",
                                "title": "Reply To Message.ID",
                                "example": 1041
                            },
                            "from": {
                                "type": "object",
                                "title": "Reply To Message.From",
                                "required": [
                                    "id",
                                    "is_bot",
                                    "first_name"
                                ],
                                "properties": {
                                    "id": {
                                        "type": "integer",
                                        "title": "Reply To Message.From.ID",
                                        "example": 6412345678
                                    },
                                    "is_bot": {
                                        "type": "boolean",
                                        "title": "Reply To Message.From.Is Bot",
                                        "example": false
                                    },
                                    "first_name": {
                                        "type": "string",
                                        "title": "Reply To Message.From.First Name",
                                        "example": "Jana"
                                    },
                                    "last_name": {
                                        "type": "string",
                                        "title": "Reply To Message.From.Last Name",
                                        "example": "Novakova"
                                    },
                                    "username": {
                                        "type": "string",
                                        "title": "Reply To Message.From.Username",
                                        "example": "jana_novakova"
                                    },
                                    "language_code": {
                                        "type": "string",
                                        "title": "Reply To Message.From.Language Code",
                                        "example": "cs"
                                    }
                                },
                                "example": {
                                    "id": 6412345678,
                                    "is_bot": false,
                                    "first_name": "Jana",
                                    "username": "jana_novakova"
                                }
                            },
                            "chat": {
                                "type": "object",
                                "title": "Reply To Message.Chat",
                                "required": [
                                    "id",
                                    "type"
                                ],
                                "properties": {
                                    "id": {
                                        "type": "integer",
                                        "title": "Reply To Message.Chat.ID",
                                        "example": -1002345678901
                                    },
                                    "type": {
                                        "type": "string",
                                        "title": "Reply To Message.Chat.Type",
                                        "example": "supergroup"
                                    },
                                    "title": {
                                        "type": "string",
                                        "title": "Reply To Message.Chat.Title",
                                        "example": "Product Team"
                                    },
                                    "username": {
                                        "type": "string",
                                        "title": "Reply To Message.Chat.Username",
                                        "example": "product_team"
                                    },
                                    "first_name": {
                                        "type": "string",
                                        "title": "Reply To Message.Chat.First Name",
                                        "example": "Jana"
                                    },
                                    "last_name": {
                                        "type": "string",
                                        "title": "Reply To Message.Chat.Last Name",
                                        "example": "Novakova"
                                    },
                                    "is_forum": {
                                        "type": "boolean",
                                        "title": "Reply To Message.Chat.Is Forum",
                                        "example": false
                                    },
                                    "all_members_are_administrators": {
                                        "type": "boolean",
                                        "title": "Reply To Message.Chat.All Members Are Administrators",
                                        "example": false
                                    }
                                },
                                "example": {
                                    "id": -1002345678901,
                                    "type": "supergroup",
                                    "title": "Product Team"
                                }
                            },
                            "date": {
                                "type": "integer",
                                "title": "Reply To Message.Date (Unix Time)",
                                "example": 1756199000
                            },
                            "text": {
                                "type": "string",
                                "title": "Reply To Message.Text",
                                "example": "What is the status?"
                            }
                        },
                        "example": {
                            "message_id": 1041,
                            "date": 1756199000,
                            "text": "What is the status?"
                        }
                    }
                },
                "required": [
                    "message_id",
                    "date",
                    "chat"
                ]
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
