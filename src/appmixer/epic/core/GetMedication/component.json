{
    "name": "appmixer.epic.core.GetMedication",
    "label": "Get Medication",
    "description": "Retrieve a single Medication resource from Epic by its FHIR ID. The Medication ID is typically taken from a Medication Request's medicationReference.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:epic"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "medicationId": {
                        "type": "string"
                    }
                },
                "required": [
                    "medicationId"
                ]
            },
            "inspector": {
                "inputs": {
                    "medicationId": {
                        "type": "text",
                        "label": "Medication ID",
                        "index": 1,
                        "tooltip": "The FHIR ID of the Medication resource."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "resourceType": {
                        "type": "string",
                        "title": "Resource Type",
                        "example": "Medication"
                    },
                    "id": {
                        "type": "string",
                        "title": "Medication ID",
                        "example": "eXYZ1234567890"
                    },
                    "status": {
                        "type": "string",
                        "title": "Status",
                        "example": "active"
                    },
                    "code": {
                        "type": "object",
                        "title": "Code",
                        "properties": {
                            "coding": {
                                "type": "array",
                                "title": "Code Coding",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "system": {
                                            "type": "string",
                                            "title": "Code Coding System",
                                            "example": "http://www.nlm.nih.gov/research/umls/rxnorm"
                                        },
                                        "code": {
                                            "type": "string",
                                            "title": "Code Coding Code",
                                            "example": "314076"
                                        },
                                        "display": {
                                            "type": "string",
                                            "title": "Code Coding Display",
                                            "example": "lisinopril 10 MG Oral Tablet"
                                        }
                                    }
                                },
                                "example": [
                                    {
                                        "system": "http://www.nlm.nih.gov/research/umls/rxnorm",
                                        "code": "314076",
                                        "display": "lisinopril 10 MG Oral Tablet"
                                    }
                                ]
                            },
                            "text": {
                                "type": "string",
                                "title": "Code Text",
                                "example": "Lisinopril 10 MG Oral Tablet"
                            }
                        }
                    },
                    "manufacturer": {
                        "type": "object",
                        "title": "Manufacturer",
                        "properties": {
                            "reference": {
                                "type": "string",
                                "title": "Manufacturer Reference",
                                "example": "Organization/eGmO0h6H1cVDlLimIL5x4Vg3"
                            },
                            "display": {
                                "type": "string",
                                "title": "Manufacturer Display",
                                "example": "Acme Pharmaceuticals"
                            }
                        }
                    },
                    "form": {
                        "type": "object",
                        "title": "Form",
                        "properties": {
                            "coding": {
                                "type": "array",
                                "title": "Form Coding",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "system": {
                                            "type": "string",
                                            "title": "Form Coding System",
                                            "example": "http://snomed.info/sct"
                                        },
                                        "code": {
                                            "type": "string",
                                            "title": "Form Coding Code",
                                            "example": "421026006"
                                        },
                                        "display": {
                                            "type": "string",
                                            "title": "Form Coding Display",
                                            "example": "Oral tablet"
                                        }
                                    }
                                },
                                "example": [
                                    {
                                        "system": "http://snomed.info/sct",
                                        "code": "421026006",
                                        "display": "Oral tablet"
                                    }
                                ]
                            },
                            "text": {
                                "type": "string",
                                "title": "Form Text",
                                "example": "Oral Tablet"
                            }
                        }
                    },
                    "ingredient": {
                        "type": "array",
                        "title": "Ingredient",
                        "items": {
                            "type": "object",
                            "properties": {
                                "itemCodeableConcept": {
                                    "type": "object",
                                    "title": "Ingredient Item",
                                    "properties": {
                                        "coding": {
                                            "type": "array",
                                            "title": "Ingredient Item Coding",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "system": {
                                                        "type": "string",
                                                        "title": "Ingredient Item Coding System",
                                                        "example": "http://www.nlm.nih.gov/research/umls/rxnorm"
                                                    },
                                                    "code": {
                                                        "type": "string",
                                                        "title": "Ingredient Item Coding Code",
                                                        "example": "29046"
                                                    },
                                                    "display": {
                                                        "type": "string",
                                                        "title": "Ingredient Item Coding Display",
                                                        "example": "lisinopril"
                                                    }
                                                }
                                            }
                                        },
                                        "text": {
                                            "type": "string",
                                            "title": "Ingredient Item Text",
                                            "example": "Lisinopril"
                                        }
                                    }
                                },
                                "strength": {
                                    "type": "object",
                                    "title": "Ingredient Strength",
                                    "properties": {
                                        "numerator": {
                                            "type": "object",
                                            "title": "Ingredient Strength Numerator",
                                            "properties": {
                                                "value": {
                                                    "type": "number",
                                                    "title": "Ingredient Strength Numerator Value",
                                                    "example": 10
                                                },
                                                "unit": {
                                                    "type": "string",
                                                    "title": "Ingredient Strength Numerator Unit",
                                                    "example": "mg"
                                                }
                                            }
                                        },
                                        "denominator": {
                                            "type": "object",
                                            "title": "Ingredient Strength Denominator",
                                            "properties": {
                                                "value": {
                                                    "type": "number",
                                                    "title": "Ingredient Strength Denominator Value",
                                                    "example": 1
                                                },
                                                "unit": {
                                                    "type": "string",
                                                    "title": "Ingredient Strength Denominator Unit",
                                                    "example": "tablet"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "example": [
                            {
                                "itemCodeableConcept": {
                                    "text": "Lisinopril"
                                },
                                "strength": {
                                    "numerator": {
                                        "value": 10,
                                        "unit": "mg"
                                    },
                                    "denominator": {
                                        "value": 1,
                                        "unit": "tablet"
                                    }
                                }
                            }
                        ]
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
