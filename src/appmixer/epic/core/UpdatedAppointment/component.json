{
    "name": "appmixer.epic.core.UpdatedAppointment",
    "label": "Updated Appointment",
    "description": "Triggers when an appointment of a patient is updated in Epic (time, status or other changes). Emits all available appointment data.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": false,
    "tick": true,
    "auth": {
        "service": "appmixer:epic"
    },
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "patient": {
                    "type": "string"
                }
            },
            "required": [
                "patient"
            ]
        },
        "inspector": {
            "inputs": {
                "patient": {
                    "type": "text",
                    "index": 1,
                    "label": "Patient ID",
                    "tooltip": "The FHIR ID of the patient whose appointments should be watched. Use Find Patients to look it up."
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Appointment ID",
                        "example": "eAppointment123"
                    },
                    "status": {
                        "type": "string",
                        "title": "Status",
                        "example": "booked"
                    },
                    "start": {
                        "type": "string",
                        "title": "Start",
                        "example": "2026-08-01T14:00:00Z"
                    },
                    "end": {
                        "type": "string",
                        "title": "End",
                        "example": "2026-08-01T14:30:00Z"
                    },
                    "minutesDuration": {
                        "type": "number",
                        "title": "Duration (minutes)",
                        "example": 30
                    },
                    "created": {
                        "type": "string",
                        "title": "Created",
                        "example": "2026-07-01T09:12:00Z"
                    },
                    "description": {
                        "type": "string",
                        "title": "Description",
                        "example": "Office Visit"
                    },
                    "comment": {
                        "type": "string",
                        "title": "Comment",
                        "example": "Follow-up visit"
                    },
                    "serviceType": {
                        "type": "string",
                        "title": "Service Type",
                        "example": "Office Visit"
                    },
                    "appointmentType": {
                        "type": "string",
                        "title": "Appointment Type",
                        "example": "Routine"
                    },
                    "reason": {
                        "type": "string",
                        "title": "Reason",
                        "example": "Hypertension"
                    },
                    "patient": {
                        "type": "string",
                        "title": "Patient",
                        "example": "Camila Maria Lopez"
                    },
                    "patientReference": {
                        "type": "string",
                        "title": "Patient Reference",
                        "example": "Patient/erXuFYUfucBZaryVksYEcMg3"
                    },
                    "practitioners": {
                        "type": "array",
                        "title": "Practitioners",
                        "items": {
                            "type": "string",
                            "example": "Physician Family Medicine, MD"
                        },
                        "example": [
                            "Physician Family Medicine, MD"
                        ]
                    },
                    "locations": {
                        "type": "array",
                        "title": "Locations",
                        "items": {
                            "type": "string",
                            "example": "EMC Family Medicine"
                        },
                        "example": [
                            "EMC Family Medicine"
                        ]
                    },
                    "participants": {
                        "type": "array",
                        "title": "Participants",
                        "items": {
                            "type": "object",
                            "properties": {
                                "reference": {
                                    "type": "string",
                                    "title": "Reference",
                                    "example": "Practitioner/eM5CWtq15N0WJeuCet5bJlQ3"
                                },
                                "display": {
                                    "type": "string",
                                    "title": "Display",
                                    "example": "Physician Family Medicine, MD"
                                },
                                "status": {
                                    "type": "string",
                                    "title": "Participation Status",
                                    "example": "accepted"
                                }
                            }
                        },
                        "example": [
                            {
                                "reference": "Practitioner/eM5CWtq15N0WJeuCet5bJlQ3",
                                "display": "Physician Family Medicine, MD",
                                "status": "accepted"
                            }
                        ]
                    },
                    "lastUpdated": {
                        "type": "string",
                        "title": "Last Updated",
                        "example": "2026-07-10T08:00:00Z"
                    },
                    "resource": {
                        "type": "object",
                        "title": "Raw FHIR Resource",
                        "example": {
                            "resourceType": "Appointment",
                            "id": "eAppointment123",
                            "status": "booked"
                        }
                    }
                }
            }
        }
    ]
}
