{
    "name": "appmixer.ntfy.core.PublishNotification",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Publishes a push notification to an ntfy topic. The notification is delivered instantly to all subscribers of the topic (Android, iOS, and web).",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:ntfy"
    },
    "quota": {
        "manager": "appmixer:ntfy",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "topic": {
                        "type": "string"
                    },
                    "message": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "priority": {
                        "type": "string",
                        "enum": ["min", "low", "default", "high", "urgent"]
                    },
                    "tags": {
                        "type": "string"
                    },
                    "clickUrl": {
                        "type": "string"
                    },
                    "iconUrl": {
                        "type": "string"
                    },
                    "attachUrl": {
                        "type": "string"
                    },
                    "markdown": {
                        "type": "boolean"
                    },
                    "delay": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    }
                },
                "required": ["topic", "message"]
            },
            "inspector": {
                "inputs": {
                    "topic": {
                        "type": "text",
                        "label": "Topic",
                        "tooltip": "The ntfy topic to publish to. Topics are created automatically on first use. Use a hard-to-guess name for private topics — the topic name acts as a shared secret. Example: <b>my-alerts-xk29a</b>",
                        "index": 0
                    },
                    "message": {
                        "type": "text",
                        "label": "Message",
                        "tooltip": "The notification message body.",
                        "index": 1
                    },
                    "title": {
                        "type": "text",
                        "label": "Title",
                        "tooltip": "Optional notification title shown above the message. Defaults to the topic name if not set.",
                        "index": 2
                    },
                    "priority": {
                        "type": "select",
                        "label": "Priority",
                        "tooltip": "Notification priority which controls the sound, vibration, and urgency. <b>Default</b> is recommended for most use cases.",
                        "index": 3,
                        "defaultValue": "default",
                        "options": [
                            { "content": "Min (no sound/vibration)", "value": "min" },
                            { "content": "Low (no sound)", "value": "low" },
                            { "content": "Default", "value": "default" },
                            { "content": "High (always sound)", "value": "high" },
                            { "content": "Urgent (breaks through do-not-disturb)", "value": "urgent" }
                        ]
                    },
                    "tags": {
                        "type": "text",
                        "label": "Tags",
                        "tooltip": "Comma-separated list of tags or emoji shortcodes. Tags starting with a known emoji shortcode are displayed as an emoji. Example: <b>warning,skull</b> or <b>white_check_mark,cd</b>. See <a href=\"https://docs.ntfy.sh/emojis/\">full emoji list</a>.",
                        "index": 4
                    },
                    "clickUrl": {
                        "type": "text",
                        "label": "Click URL",
                        "tooltip": "Optional URL to open when the user clicks the notification. Example: <b>https://example.com/dashboard</b>",
                        "index": 5
                    },
                    "iconUrl": {
                        "type": "text",
                        "label": "Icon URL",
                        "tooltip": "Optional URL of an icon image to show with the notification (Android only). Must be a publicly accessible HTTPS URL.",
                        "index": 6
                    },
                    "attachUrl": {
                        "type": "text",
                        "label": "Attachment URL",
                        "tooltip": "Optional URL of an image or file to attach to the notification. The image will be shown inline on supported clients. Must be a publicly accessible HTTPS URL.",
                        "index": 7
                    },
                    "markdown": {
                        "type": "toggle",
                        "label": "Markdown",
                        "tooltip": "Enable Markdown rendering in the notification body. When enabled, the message supports basic Markdown formatting.",
                        "defaultValue": false,
                        "index": 8
                    },
                    "delay": {
                        "type": "text",
                        "label": "Delay",
                        "tooltip": "Optional scheduled delivery time. Supports durations like <b>30m</b>, <b>2h</b>, <b>1d</b>, or Unix timestamps and natural language like <b>tomorrow, 3pm</b>. Leave blank to deliver immediately.",
                        "index": 9
                    },
                    "email": {
                        "type": "text",
                        "label": "Email Forward",
                        "tooltip": "Optional email address to forward the notification to. Requires your ntfy account to have email forwarding enabled.",
                        "index": 10
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Message ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "sPs71M8A2T"
                    }
                },
                {
                    "label": "Topic",
                    "value": "topic",
                    "schema": {
                        "type": "string",
                        "example": "alerts"
                    }
                },
                {
                    "label": "Message",
                    "value": "message",
                    "schema": {
                        "type": "string",
                        "example": "Backup finished successfully"
                    }
                },
                {
                    "label": "Title",
                    "value": "title",
                    "schema": {
                        "type": "string",
                        "example": "Nightly backup"
                    }
                },
                {
                    "label": "Priority",
                    "value": "priority",
                    "schema": {
                        "type": "number",
                        "example": 3
                    }
                },
                {
                    "label": "Tags",
                    "value": "tags",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "white_check_mark"
                        ]
                    }
                },
                {
                    "label": "Timestamp",
                    "value": "time",
                    "schema": {
                        "type": "number",
                        "example": 1757493000
                    }
                },
                {
                    "label": "Event",
                    "value": "event",
                    "schema": {
                        "type": "string",
                        "example": "message"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
