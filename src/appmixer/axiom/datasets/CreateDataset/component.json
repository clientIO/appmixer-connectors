{
    "name": "appmixer.axiom.datasets.CreateDataset",
    "label": "Create Dataset",
    "description": "Create a new dataset in Axiom.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:axiom"
    },
    "quota": {
        "manager": "appmixer:axiom",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "kind": {
                        "type": "string",
                        "enum": [
                            "otel:metrics:v1",
                            "otel:traces:v1",
                            "otel:logs:v1",
                            "axiom:events:v1"
                        ],
                        "default": "axiom:events:v1"
                    },
                    "retentionDays": {
                        "type": "integer"
                    },
                    "useRetentionPeriod": {
                        "type": "boolean"
                    },
                    "region": {
                        "type": "string"
                    }
                },
                "required": [
                    "name"
                ]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "label": "Dataset Name",
                        "index": 1,
                        "tooltip": "The unique name of the dataset to create"
                    },
                    "description": {
                        "type": "textarea",
                        "label": "Description",
                        "index": 2,
                        "tooltip": "Optional description of the dataset"
                    },
                    "kind": {
                        "type": "select",
                        "label": "Dataset Kind",
                        "index": 3,
                        "defaultValue": "axiom:events:v1",
                        "tooltip": "The type of dataset to create",
                        "options": [
                            {
                                "label": "Axiom Events",
                                "value": "axiom:events:v1"
                            },
                            {
                                "label": "OpenTelemetry Metrics",
                                "value": "otel:metrics:v1"
                            },
                            {
                                "label": "OpenTelemetry Traces",
                                "value": "otel:traces:v1"
                            },
                            {
                                "label": "OpenTelemetry Logs",
                                "value": "otel:logs:v1"
                            }
                        ]
                    },
                    "retentionDays": {
                        "type": "number",
                        "label": "Retention Days",
                        "index": 4,
                        "tooltip": "Number of days to retain data in the dataset"
                    },
                    "useRetentionPeriod": {
                        "type": "toggle",
                        "label": "Use Retention Period",
                        "index": 5,
                        "tooltip": "Whether to use the retention period"
                    },
                    "region": {
                        "type": "text",
                        "label": "Region",
                        "index": 6,
                        "tooltip": "Optional region of the dataset"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Dataset ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "http-logs"
                    },
                    "example": "my-dataset-001"
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "http-logs"
                    },
                    "example": "server-logs"
                },
                {
                    "label": "Description",
                    "value": "description",
                    "schema": {
                        "type": "string",
                        "example": "HTTP access logs from the edge proxies"
                    },
                    "example": "Production server access logs"
                },
                {
                    "label": "Kind",
                    "value": "kind",
                    "schema": {
                        "type": "string",
                        "example": "axiom:events:v1"
                    },
                    "example": "axiom:events:v1"
                },
                {
                    "label": "Retention Days",
                    "value": "retentionDays",
                    "schema": {
                        "type": "integer",
                        "example": 30
                    },
                    "example": 30
                },
                {
                    "label": "Use Retention Period",
                    "value": "useRetentionPeriod",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    },
                    "example": true
                },
                {
                    "label": "Created By",
                    "value": "who",
                    "schema": {
                        "type": "string",
                        "example": "f83e245a-afdc-47ad-a765-4addd1994321"
                    },
                    "example": "user@example.com"
                },
                {
                    "label": "Created At",
                    "value": "created",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00.000Z"
                    },
                    "example": "2024-01-15T10:30:00Z"
                },
                {
                    "label": "Can Write",
                    "value": "canWrite",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    },
                    "example": true
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}