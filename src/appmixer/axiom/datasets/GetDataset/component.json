{
    "name": "appmixer.axiom.datasets.GetDataset",
    "label": "Get Dataset",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Get details about a specific dataset by its ID.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:axiom"
    },
    "quota": {
        "manager": "appmixer:axiom",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "datasetId": {
                        "type": "string"
                    }
                },
                "required": [
                    "datasetId"
                ]
            },
            "inspector": {
                "inputs": {
                    "datasetId": {
                        "type": "text",
                        "label": "Dataset ID",
                        "index": 1,
                        "tooltip": "The unique identifier of the dataset to retrieve"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Dataset ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "http-logs"
                    },
                    "example": "my-dataset-001"
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "http-logs"
                    },
                    "example": "server-logs"
                },
                {
                    "label": "Description",
                    "value": "description",
                    "schema": {
                        "type": "string",
                        "example": "HTTP access logs from the edge proxies"
                    },
                    "example": "Production server access logs"
                },
                {
                    "label": "Created By",
                    "value": "who",
                    "schema": {
                        "type": "string",
                        "example": "f83e245a-afdc-47ad-a765-4addd1994321"
                    },
                    "example": "user@example.com"
                },
                {
                    "label": "Created At",
                    "value": "created",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00.000Z"
                    },
                    "example": "2024-01-15T10:30:00Z"
                },
                {
                    "label": "Kind",
                    "value": "kind",
                    "schema": {
                        "type": "string",
                        "example": "axiom:events:v1"
                    },
                    "example": "axiom:events:v1"
                },
                {
                    "label": "Retention Days",
                    "value": "retentionDays",
                    "schema": {
                        "type": "integer",
                        "example": 30
                    },
                    "example": 30
                },
                {
                    "label": "Use Retention Period",
                    "value": "useRetentionPeriod",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    },
                    "example": true
                },
                {
                    "label": "Can Write",
                    "value": "canWrite",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    },
                    "example": true
                },
                {
                    "label": "Map Fields",
                    "value": "mapFields",
                    "schema": {
                        "type": "null",
                        "example": null
                    },
                    "example": null
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}