{
    "name": "appmixer.merk.database.GetCompanyInfo",
    "author": "David Durman <david@client.io>",
    "description": "This action provides you extensive company information for given registration or VAT number.",
    "auth": {
        "service": "appmixer:merk"
    },
    "inPorts": [
        {
            "name": "query",
            "schema": {
                "type": "object",
                "properties": {
                    "regno": { "type": "string" },
                    "vatno": { "type": "string" },
                    "src_app": { "type": "string" },
                    "country_code": { "type": "string" }
                }
            },
            "inspector": {
                "inputs": {
                    "regno": {
                        "type": "text",
                        "group": "transformation",
                        "index": 1,
                        "label": "Company registration number (IC)",
                        "attrs": {
                            "label": { "data-tooltip": "Company registration number (IC) with or without leading zeros." }
                        }
                    },
                    "vatno": {
                        "type": "text",
                        "group": "transformation",
                        "index": 2,
                        "label": "Company VAT number (DIC or IC DPH)",
                        "attrs": {
                            "label": { "data-tooltip": "Company VAT number (DIC or IC DPH) in international format f.e. CZ00014915]." }
                        }
                    },
                    "src_app": {
                        "type": "text",
                        "group": "transformation",
                        "index": 3,
                        "label": "Optional application indentifier",
                        "attrs": {
                            "label": { "data-tooltip": "Optional application indentifier." }
                        }
                    },
                    "country_code": {
                        "type": "select",
                        "group": "transformation",
                        "index": 4,
                        "label": "Optional country code.",
                        "options": ["cz", "sk"],
                        "attrs": {
                            "label": { "data-tooltip": "Optional country code." }
                        }
                    }
                },
                "groups": {
                    "transformation": {
                        "label": "Transformation",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "company",
            "options": [
                { "label": "Registration number", "value": "regno", "schema": { "type": "integer", "example": 28547888 } },
                { "label": "TAX number (cz: DIC, sk: IC DPH)", "value": "vatno", "schema": { "type": ["string", "null"], "example": "CZ28547888" } },
                { "label": "VAT number (cz: null, sk: DIC)", "value": "taxno", "schema": { "type": ["string", "null"], "example": null } },
                { "label": "Databox IDs (datové schránky)", "value": "databox_ids", "schema": {
                        "type": [
                            "array",
                            "null"
                        ],
                        "example": [
                            "v4vhaq5"
                        ]
                    } },
                { "label": "Subject name", "value": "name", "schema": { "type": "string", "example": "Imper CZ s.r.o." } },
                { "label": "Legal form name", "value": "legal_form.text", "schema": { "type": "string", "example": "Společnost s ručením omezeným" } },
                { "label": "Legal form ID", "value": "legal_form.id", "schema": { "type": "integer", "example": 112 } },
                { "label": "Establishment date", "value": "estab_date", "schema": { "type": ["string", "null"], "example": "2009-03-20T00:00:00" } },
                { "label": "Is subject active or not", "value": "is_active", "schema": { "type": "boolean", "example": true } },
                { "label": "Country code (2 char)", "value": "address.country_code", "schema": { "type": "string", "example": "cz" } },
                { "label": "Address descriptive number", "value": "address.number_descriptive", "schema": { "type": ["string", "null"], "example": "359" } },
                { "label": "Address municipality part", "value": "address.municipality_part", "schema": { "type": ["string", "null"], "example": "Smíchov" } },
                { "label": "Address municipality", "value": "address.municipality", "schema": { "type": "string", "example": "Praha" } },
                { "label": "Address number", "value": "address.number", "schema": { "type": ["string", "null"], "example": "359/6" } },
                { "label": "Address municipality first", "value": "address.municipality_first", "schema": { "type": ["string", "null"], "example": "Praha" } },
                { "label": "Address street fixed", "value": "address.street_fixed", "schema": { "type": ["string", "null"], "example": "Viktora Huga" } },
                { "label": "Address street", "value": "address.street", "schema": { "type": ["string", "null"], "example": "Viktora Huga" } },
                { "label": "Address postal code", "value": "address.postal_code", "schema": { "type": ["string", "null"], "example": "15000" } },
                { "label": "Address number orientation", "value": "address.number_orientation", "schema": { "type": ["string", "null"], "example": "6" } },
                { "label": "Address region ID", "value": "address.region.id", "schema": { "type": ["string", "null"], "example": "CZ010" } },
                { "label": "Address region Text", "value": "address.region.text", "schema": { "type": ["string", "null"], "example": "Hlavní město Praha" } },
                { "label": "Address county ID", "value": "address.county.id", "schema": { "type": ["string", "null"], "example": "CZ0100" } },
                { "label": "Address county", "value": "address.county.text", "schema": { "type": ["string", "null"], "example": "Praha" } },
                { "label": "List of bank accounts", "value": "bank_accounts", "schema": { "type": ["array", "null"], "example": [{ "account_number": "123456789", "bank_code": "0100" }] } },
                { "label": "List of contact phones", "value": "phones", "schema": { "type": ["array", "null"], "example": [{ "score": "A", "acc": "2024-05-14T00:00:00", "number": "+420123456789", "source": "https://www.example.com/kontakt" }] } },
                { "label": "List of contact mobile phones", "value": "mobiles", "schema": { "type": ["array", "null"], "example": [] } },
                { "label": "List of contact emails", "value": "emails", "schema": { "type": ["array", "null"], "example": [{ "score": "A", "acc": "2024-05-14T00:00:00", "email": "info@example.com", "source": "https://www.example.com/kontakt" }] } },
                { "label": "List of web pages", "value": "webs", "schema": { "type": ["array", "null"], "example": [{ "score": "A", "acc": "2024-05-14T00:00:00", "url": "https://www.example.com" }] } },
                { "label": "Main industry ID", "value": "industry.id", "schema": { "type": ["string", "null"], "example": "68310" } },
                { "label": "Main industry text", "value": "industry.text", "schema": { "type": ["string", "null"], "example": "Zprostředkovatelské činnosti realitních agentur" } },
                { "label": "Secondary industries and their codes", "value": "secondary_industries", "schema": { "type": ["array", "null"], "example": [{ "id": "73200", "text": "Průzkum trhu a veřejného mínění" }] } },
                { "label": "Company magnitude ID", "value": "magnitude.id", "schema": { "type": ["integer", "null"], "example": 210 } },
                { "label": "Company magnitude trend", "value": "magnitude.trend", "schema": { "type": ["string", "null"], "example": "rising" } },
                { "label": "Company magnitude lower bound", "value": "magnitude.lower_bound", "schema": { "type": ["string", "null"], "example": "10 zam." } },
                { "label": "Company magnitude upper bound", "value": "magnitude.upper_bound", "schema": { "type": ["string", "null"], "example": "19 zam." } },
                { "label": "Company magnitude text", "value": "magnitude.text", "schema": { "type": ["string", "null"], "example": "10 - 19 zaměstnanců" } },
                { "label": "Company turnover ID", "value": "turnover.id", "schema": { "type": ["integer", "null"], "example": 70 } },
                { "label": "Company turnover trend", "value": "turnover.trend", "schema": { "type": ["string", "null"], "example": "rising" } },
                { "label": "Company turnover lower bound", "value": "turnover.lower_bound", "schema": { "type": ["string", "null"], "example": "10 mil. Kč" } },
                { "label": "Company turnover upper bound", "value": "turnover.upper_bound", "schema": { "type": ["string", "null"], "example": "29,999 mil. Kč" } },
                { "label": "Company turnover text", "value": "turnover.text", "schema": { "type": ["string", "null"], "example": "10 000 000 - 29 999 999 Kč" } },
                { "label": "Court file number", "value": "court.file_nr", "schema": { "type": ["string", "null"], "example": "C 149457" } },
                { "label": "Court name", "value": "court.name", "schema": { "type": ["string", "null"], "example": "Městský soud v Praze" } },
                { "label": "Is company a VAT payer?", "value": "is_vatpayer", "schema": { "type": "boolean", "example": true } },
                { "label": "Vatpayer registration §", "value": "vat_registration_type", "schema": { "type": ["boolean", "string", "null"], "example": null } },
                { "label": "Unreliable VAT payer", "value": "is_unreliable_vatpayer", "schema": { "type": "boolean", "example": false } },
                { "label": "Unreliable VAT payer date since", "value": "unreliable_vatpayer_since", "schema": { "type": ["string", "null"], "example": null } },
                { "label": "Currently owed sum to VZP", "value": "vzp_debt", "schema": { "type": ["string", "number", "null"], "example": null } },
                { "label": "GPS latitude", "value": "gps.lat", "schema": { "type": ["number", "null"], "example": 50.07121 } },
                { "label": "GPS longitude", "value": "gps.lon", "schema": { "type": ["number", "null"], "example": 14.40628 } },
                { "label": "Company name as vokativ", "value": "salutation", "schema": { "type": ["string", "null"], "example": "Imper CZ s.r.o." } },
                { "label": "Owning type ID", "value": "owning_type.id", "schema": { "type": ["string", "null"], "example": "2" } },
                { "label": "Owning type text", "value": "owning_type.text", "schema": { "type": ["string", "null"], "example": "Soukromé tuzemské" } },
                { "label": "Company status ID", "value": "status.id", "schema": { "type": ["string", "null"], "example": "1" } },
                { "label": "Company status text", "value": "status.text", "schema": { "type": ["string", "null"], "example": "Aktivní subjekt" } },
                { "label": "Profit trend", "value": "profit.trend", "schema": { "type": ["string", "null"], "example": "rising" } },
                { "label": "Profit year", "value": "profit.year", "schema": { "type": ["integer", "null"], "example": 2023 } },
                { "label": "Profit amount (in thousands)", "value": "profit.amount", "schema": { "type": ["integer", "null"], "example": 4520 } },
                { "label": "EBIDTA year", "value": "ebidta.year", "schema": { "type": ["integer", "null"], "example": 2023 } },
                { "label": "EBIDTA amount (in thousands)", "value": "ebidta.amount", "schema": { "type": ["integer", "null"], "example": 6180 } },
                { "label": "Bank account balance year", "value": "bank_accounts_balance.year", "schema": { "type": ["integer", "null"], "example": 2023 } },
                { "label": "Bank account balance amount (in thousands)", "value": "bank_accounts_balance.amount", "schema": { "type": ["integer", "null"], "example": 12850 } },
                { "label": "Link to Merk.cz", "value": "link", "schema": { "type": "string", "example": "https://www.merk.cz/search/detail/cz-28547888/" } },
                { "label": "Business premises (branches) count", "value": "business_premises_count", "schema": { "type": ["integer", "null"], "example": 1 } },
                { "label": "Persons associated average age", "value": "body.average_age", "schema": { "type": ["integer", "null"], "example": 46 } },
                { "label": "Persons associated with the company", "value": "body.persons", "schema": { "type": ["array", "null"], "example": [{ "country_code": "cz", "first_name": "Jan", "last_name": "Novák", "age": 46, "degree_after": "", "degree_before": "Ing.", "link": "https://www.merk.cz/search/person/cz-12345/", "gender": "male", "salutation": "Pane Nováku", "company_role": "jednatel", "company_role_id": 1, "address": { "country_code": "cz", "municipality": "Praha", "street": "Viktora Huga", "number": "359/6", "postal_code": "15000", "text": "Viktora Huga 359/6, 150 00 Praha" } }] } },
                { "label": "European Structural & Investment Funds grants project name", "value": "esi.[0].project_name", "schema": { "type": ["string", "null"], "example": "Digitalizace obchodních procesů" } },
                { "label": "ESI Funds grants ESI program", "value": "esi.[0].esi_program", "schema": { "type": ["string", "null"], "example": "Operační program Technologie a aplikace pro konkurenceschopnost" } },
                { "label": "ESI Funds grants EU fund", "value": "esi.[0].eu_fund", "schema": { "type": ["string", "null"], "example": "Evropský fond pro regionální rozvoj" } },
                { "label": "ESI Funds grants allocation amount", "value": "esi.[0].allocation_amount", "schema": { "type": ["integer", "null"], "example": 1500000 } },
                { "label": "ESI total paid from project start ", "value": "esi.[0].total_paid_from_project_start", "schema": { "type": ["integer", "null"], "example": 1200000 } },
                { "label": "ESI iterim payment date ", "value": "esi.[0].iterim_payment_date", "schema": { "type": ["string", "null"], "example": "2024-03-15T00:00:00" } },
                { "label": "ESI allocation date", "value": "esi.[0].allocation_date", "schema": { "type": ["string", "null"], "example": "2023-06-01T00:00:00" } },
                { "label": "ESI status ID", "value": "esi.[0].status_id", "schema": { "type": ["integer", "null"], "example": 5 } },
                { "label": "ESI expected end date of the operation", "value": "esi.[0].expected_end_date_of_the_operation", "schema": { "type": ["string", "null"], "example": "2024-12-31T00:00:00" } },
                { "label": "ESI union cofinancing rate", "value": "esi.[0].union_cofinancing_rate", "schema": { "type": ["number", "null"], "example": 85 } },
                { "label": "Gov contracts (CZ only)", "value": "contracts", "schema": { "type": ["array", "null"], "example": [{ "subject": "Dodávka kancelářského nábytku", "price_with_vat": 245000, "contract_date": "2024-02-12T00:00:00", "published_date": "2024-02-14T00:00:00", "payer_regno": 64581, "payer_name": "Hlavní město Praha", "has_multiple_contractors": false, "url": "https://smlouvy.gov.cz/smlouva/12345678" }] } },
                { "label": "Trademarks", "value": "trademarks", "schema": { "type": ["array", "null"], "example": [{ "wording": "MERK", "reproduction": "slovní", "stamp_application": "2019-04-10T00:00:00", "stamp_registered": "2019-09-20T00:00:00", "product_or_service_classes": "35, 42", "image_classes": "", "nr_register": "374512", "nr_application": 551234, "source": "UPV", "url": "https://isdv.upv.gov.cz/webapp/resdb.print_detail.det?pspis=TM/551234", "url_doc": "https://isdv.upv.gov.cz/doc/551234.pdf", "tm_type": "slovní", "status": "zapsaná" }] } },
                { "label": "Insolvency cases", "value": "insolvency_cases", "schema": { "type": ["array", "null"], "example": [{ "stamp": "2024-01-15", "status": 1, "ws_id": "12345678", "court_file_nr": "KSPH 36 INS 1234/2024" }] } },
                { "label": "List of Twitter accounts", "value": "twitter", "schema": { "type": ["array", "null"], "example": [] } },
                { "label": "List of Facebook accounts", "value": "facebook", "schema": { "type": ["array", "null"], "example": [] } },
                { "label": "List of LinkedIn profiles", "value": "linkedin", "schema": { "type": ["array", "null"], "example": [] } }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
