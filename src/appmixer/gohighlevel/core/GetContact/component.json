{
    "name": "appmixer.gohighlevel.core.GetContact",
    "label": "Get Contact",
    "description": "Retrieve a contact by their ID from GoHighLevel.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:gohighlevel"
    },
    "quota": {
        "manager": "appmixer:gohighlevel",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "contactId": {
                        "type": "string"
                    }
                },
                "required": [
                    "contactId"
                ]
            },
            "inspector": {
                "inputs": {
                    "contactId": {
                        "type": "text",
                        "label": "Contact ID",
                        "index": 1,
                        "tooltip": "The unique ID of the contact to retrieve."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Contact ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "ocQHyuzHvysMo5N5VsXc"
                    }
                },
                {
                    "label": "First Name",
                    "value": "firstName",
                    "schema": {
                        "type": "string",
                        "example": "Jane"
                    }
                },
                {
                    "label": "Last Name",
                    "value": "lastName",
                    "schema": {
                        "type": "string",
                        "example": "Doe"
                    }
                },
                {
                    "label": "Full Name",
                    "value": "contactName",
                    "schema": {
                        "type": "string",
                        "example": "jane doe"
                    }
                },
                {
                    "label": "Email",
                    "value": "email",
                    "schema": {
                        "type": "string",
                        "example": "jane.doe@example.com"
                    }
                },
                {
                    "label": "Phone",
                    "value": "phone",
                    "schema": {
                        "type": "string",
                        "example": "+14155550123"
                    }
                },
                {
                    "label": "Company Name",
                    "value": "companyName",
                    "schema": {
                        "type": "string",
                        "example": "Acme Inc"
                    }
                },
                {
                    "label": "Address",
                    "value": "address1",
                    "schema": {
                        "type": "string",
                        "example": "123 Market St"
                    }
                },
                {
                    "label": "City",
                    "value": "city",
                    "schema": {
                        "type": "string",
                        "example": "San Francisco"
                    }
                },
                {
                    "label": "State",
                    "value": "state",
                    "schema": {
                        "type": "string",
                        "example": "CA"
                    }
                },
                {
                    "label": "Postal Code",
                    "value": "postalCode",
                    "schema": {
                        "type": "string",
                        "example": "94105"
                    }
                },
                {
                    "label": "Country",
                    "value": "country",
                    "schema": {
                        "type": "string",
                        "example": "US"
                    }
                },
                {
                    "label": "Website",
                    "value": "website",
                    "schema": {
                        "type": "string",
                        "example": "https://acme.example.com"
                    }
                },
                {
                    "label": "Source",
                    "value": "source",
                    "schema": {
                        "type": "string",
                        "example": "api"
                    }
                },
                {
                    "label": "Location ID",
                    "value": "locationId",
                    "schema": {
                        "type": "string",
                        "example": "ve9EPM428h8vShlRW1KT"
                    }
                },
                {
                    "label": "Date Added",
                    "value": "dateAdded",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00.000Z"
                    }
                },
                {
                    "label": "Date Updated",
                    "value": "dateUpdated",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T09:15:00.000Z"
                    }
                },
                {
                    "label": "Tags",
                    "value": "tags",
                    "schema": {
                        "type": "array",
                        "example": [
                            "customer",
                            "newsletter"
                        ]
                    }
                }
            ],
            "example": {
                "id": "abc123def456",
                "firstName": "Jane",
                "lastName": "Doe",
                "contactName": "Jane Doe",
                "email": "jane.doe@example.com",
                "phone": "+15551234567",
                "companyName": "Acme Corp",
                "address1": "123 Main Street",
                "city": "Austin",
                "state": "TX",
                "postalCode": "78701",
                "country": "US",
                "website": "https://example.com",
                "source": "API",
                "locationId": "loc123abc",
                "dateAdded": "2026-01-15T10:30:00.000Z",
                "dateUpdated": "2026-01-15T10:30:00.000Z",
                "tags": ["customer", "newsletter"]
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
