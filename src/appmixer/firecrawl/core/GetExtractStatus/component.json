{
    "name": "appmixer.firecrawl.core.GetExtractStatus",
    "label": "Get Extract Status",
    "description": "Get the status of an extraction job and, when it is completed, the extracted data. Use it with a job ID returned by Extract Data.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:firecrawl"
    },
    "quota": {
        "manager": "appmixer:firecrawl",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "jobId": { "type": "string" }
                },
                "required": ["jobId"]
            },
            "inspector": {
                "inputs": {
                    "jobId": {
                        "type": "text",
                        "index": 0,
                        "label": "Job ID",
                        "tooltip": "The ID of the extraction job, as returned by the Extract Data component."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "jobId": {
                        "type": "string",
                        "title": "Job ID",
                        "example": "7c1d9e3a-2f4b-4a8c-b5e6-0d9f2a7b4c8e"
                    },
                    "status": {
                        "type": "string",
                        "title": "Status",
                        "example": "completed"
                    },
                    "data": {
                        "type": "object",
                        "title": "Extracted Data",
                        "example": { "productName": "Acme Anvil", "price": 49.99 }
                    },
                    "tokensUsed": {
                        "type": "number",
                        "title": "Tokens Used",
                        "example": 1730
                    },
                    "expiresAt": {
                        "type": "string",
                        "title": "Expires At",
                        "example": "2026-08-25T12:00:00Z"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
