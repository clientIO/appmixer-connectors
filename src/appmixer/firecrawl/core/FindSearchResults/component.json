{
    "name": "appmixer.firecrawl.core.FindSearchResults",
    "label": "Find Search Results",
    "description": "Search the web, news or images with Firecrawl and return the ranked results. Returns up to 20 results per search.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:firecrawl"
    },
    "quota": {
        "manager": "appmixer:firecrawl",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string",
                        "maxLength": 500
                    },
                    "source": {
                        "type": "string"
                    },
                    "includeDomains": {
                        "type": "string"
                    },
                    "excludeDomains": {
                        "type": "string"
                    },
                    "outputType": {
                        "type": "string"
                    }
                },
                "required": [
                    "query"
                ]
            },
            "inspector": {
                "inputs": {
                    "query": {
                        "type": "text",
                        "index": 0,
                        "label": "Query",
                        "tooltip": "The search query, at most 500 characters. Supports search operators such as <code>site:</code>."
                    },
                    "source": {
                        "type": "select",
                        "index": 1,
                        "label": "Source",
                        "defaultValue": "web",
                        "tooltip": "Which result type to search.",
                        "options": [
                            {
                                "label": "Web",
                                "value": "web"
                            },
                            {
                                "label": "News",
                                "value": "news"
                            },
                            {
                                "label": "Images",
                                "value": "images"
                            }
                        ]
                    },
                    "includeDomains": {
                        "type": "text",
                        "index": 2,
                        "label": "Include Domains",
                        "tooltip": "Optional comma separated list of domains to restrict the search to, e.g. <code>example.com, docs.example.com</code>. Cannot be combined with Exclude Domains."
                    },
                    "excludeDomains": {
                        "type": "text",
                        "index": 3,
                        "label": "Exclude Domains",
                        "tooltip": "Optional comma separated list of domains to exclude from the search. Cannot be combined with Include Domains."
                    },
                    "outputType": {
                        "type": "select",
                        "index": 4,
                        "label": "Output Type",
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/firecrawl/core/FindSearchResults?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/query": "dummy",
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        },
        {
            "name": "notFound"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
