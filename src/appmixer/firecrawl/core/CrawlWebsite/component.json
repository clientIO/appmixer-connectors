{
    "name": "appmixer.firecrawl.core.CrawlWebsite",
    "label": "Crawl Website",
    "description": "Start an asynchronous crawl of a website and scrape every discovered page into markdown. The job reference is emitted immediately on \"out\"; Firecrawl calls back when the crawl finishes and the scraped pages are emitted on \"done\".",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "webhook": true,
    "auth": {
        "service": "appmixer:firecrawl"
    },
    "quota": {
        "manager": "appmixer:firecrawl",
        "resources": "jobs",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "url": {
                        "type": "string"
                    },
                    "maxPages": {
                        "type": "number"
                    },
                    "maxDiscoveryDepth": {
                        "type": "number"
                    },
                    "includePaths": {
                        "type": "string"
                    },
                    "excludePaths": {
                        "type": "string"
                    },
                    "crawlEntireDomain": {
                        "type": "boolean"
                    },
                    "allowSubdomains": {
                        "type": "boolean"
                    },
                    "onlyMainContent": {
                        "type": "boolean"
                    },
                    "correlationId": {
                        "type": "string"
                    }
                },
                "required": [
                    "url"
                ]
            },
            "inspector": {
                "inputs": {
                    "url": {
                        "type": "text",
                        "index": 0,
                        "label": "URL",
                        "tooltip": "The base URL to start crawling from, e.g. <code>https://example.com/docs</code>."
                    },
                    "maxPages": {
                        "type": "number",
                        "index": 1,
                        "label": "Max Pages",
                        "defaultValue": 100,
                        "tooltip": "Maximum number of pages to crawl. Defaults to 100. Each crawled page consumes Firecrawl credits."
                    },
                    "maxDiscoveryDepth": {
                        "type": "number",
                        "index": 2,
                        "label": "Max Discovery Depth",
                        "tooltip": "Maximum depth to follow links from the base URL. Leave empty for no depth limit."
                    },
                    "includePaths": {
                        "type": "text",
                        "index": 3,
                        "label": "Include Paths",
                        "tooltip": "Optional comma separated list of URL path regex patterns to include, e.g. <code>blog/.*, docs/.*</code>. Only matching URLs are crawled."
                    },
                    "excludePaths": {
                        "type": "text",
                        "index": 4,
                        "label": "Exclude Paths",
                        "tooltip": "Optional comma separated list of URL path regex patterns to exclude from the crawl."
                    },
                    "crawlEntireDomain": {
                        "type": "toggle",
                        "index": 5,
                        "label": "Crawl Entire Domain",
                        "defaultValue": false,
                        "tooltip": "Also follow links to sibling and parent pages of the base URL, not only its children."
                    },
                    "allowSubdomains": {
                        "type": "toggle",
                        "index": 6,
                        "label": "Allow Subdomains",
                        "defaultValue": false,
                        "tooltip": "Also follow links to subdomains of the website."
                    },
                    "onlyMainContent": {
                        "type": "toggle",
                        "index": 7,
                        "label": "Only Main Content",
                        "defaultValue": true,
                        "tooltip": "Scrape only the main content of each page, excluding headers, navigation and footers."
                    },
                    "correlationId": {
                        "type": "text",
                        "index": 8,
                        "label": "Correlation ID",
                        "tooltip": "Any value of your own - an order number, a record ID - echoed on both output ports. One component instance has one callback URL, so parallel crawls report back to the same place in completion order; this is how a downstream component tells them apart."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "jobId": {
                        "type": "string",
                        "title": "Job ID",
                        "example": "3f8c2a1e-5b7d-4e0a-9c6f-2d1b8e4a7c9d"
                    },
                    "status": {
                        "type": "string",
                        "title": "Status",
                        "example": "scraping"
                    },
                    "url": {
                        "type": "string",
                        "title": "URL",
                        "example": "https://example.com/docs"
                    },
                    "correlationId": {
                        "type": "string",
                        "title": "Correlation ID",
                        "example": "order-1042"
                    }
                }
            }
        },
        {
            "name": "done",
            "schema": {
                "type": "object",
                "properties": {
                    "jobId": {
                        "type": "string",
                        "title": "Job ID",
                        "example": "3f8c2a1e-5b7d-4e0a-9c6f-2d1b8e4a7c9d"
                    },
                    "status": {
                        "type": "string",
                        "title": "Status",
                        "example": "completed"
                    },
                    "total": {
                        "type": "number",
                        "title": "Total Pages",
                        "example": 42
                    },
                    "completed": {
                        "type": "number",
                        "title": "Completed Pages",
                        "example": 42
                    },
                    "creditsUsed": {
                        "type": "number",
                        "title": "Credits Used",
                        "example": 42
                    },
                    "data": {
                        "type": "array",
                        "title": "Pages",
                        "example": [
                            {
                                "markdown": "# Getting Started\n\nWelcome to the documentation.",
                                "metadata": {
                                    "title": "Getting Started",
                                    "sourceURL": "https://example.com/docs/getting-started",
                                    "statusCode": 200
                                }
                            }
                        ],
                        "items": {
                            "type": "object",
                            "properties": {
                                "markdown": {
                                    "type": "string",
                                    "title": "Markdown",
                                    "example": "# Getting Started\n\nWelcome to the documentation."
                                },
                                "metadata": {
                                    "type": "object",
                                    "title": "Metadata",
                                    "properties": {
                                        "title": {
                                            "type": "string",
                                            "title": "Page Title",
                                            "example": "Getting Started"
                                        },
                                        "sourceURL": {
                                            "type": "string",
                                            "title": "Source URL",
                                            "example": "https://example.com/docs/getting-started"
                                        },
                                        "statusCode": {
                                            "type": "number",
                                            "title": "Status Code",
                                            "example": 200
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "truncated": {
                        "type": "boolean",
                        "title": "Truncated",
                        "example": false
                    },
                    "url": {
                        "type": "string",
                        "title": "URL",
                        "example": "https://example.com/docs"
                    },
                    "correlationId": {
                        "type": "string",
                        "title": "Correlation ID",
                        "example": "order-1042"
                    },
                    "error": {
                        "type": "string",
                        "title": "Error",
                        "example": ""
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
