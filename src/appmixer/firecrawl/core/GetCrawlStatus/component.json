{
    "name": "appmixer.firecrawl.core.GetCrawlStatus",
    "label": "Get Crawl Status",
    "description": "Get the status of a crawl job and, when it is completed, the scraped pages. Use it with a job ID returned by Crawl Website.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:firecrawl"
    },
    "quota": {
        "manager": "appmixer:firecrawl",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "jobId": {
                        "type": "string"
                    }
                },
                "required": [
                    "jobId"
                ]
            },
            "inspector": {
                "inputs": {
                    "jobId": {
                        "type": "text",
                        "index": 0,
                        "label": "Job ID",
                        "tooltip": "The ID of the crawl job, as returned by the Crawl Website component."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "jobId": {
                        "type": "string",
                        "title": "Job ID",
                        "example": "3f8c2a1e-5b7d-4e0a-9c6f-2d1b8e4a7c9d"
                    },
                    "status": {
                        "type": "string",
                        "title": "Status",
                        "example": "completed"
                    },
                    "total": {
                        "type": "number",
                        "title": "Total Pages",
                        "example": 42
                    },
                    "completed": {
                        "type": "number",
                        "title": "Completed Pages",
                        "example": 42
                    },
                    "creditsUsed": {
                        "type": "number",
                        "title": "Credits Used",
                        "example": 42
                    },
                    "truncated": {
                        "type": "boolean",
                        "title": "Truncated",
                        "example": false
                    },
                    "data": {
                        "type": "array",
                        "title": "Pages",
                        "example": [
                            {
                                "markdown": "# Getting Started\n\nWelcome to the documentation.",
                                "metadata": {
                                    "title": "Getting Started",
                                    "sourceURL": "https://example.com/docs/getting-started",
                                    "statusCode": 200
                                }
                            }
                        ],
                        "items": {
                            "type": "object",
                            "properties": {
                                "markdown": {
                                    "type": "string",
                                    "title": "Markdown",
                                    "example": "# Getting Started\n\nWelcome to the documentation."
                                },
                                "metadata": {
                                    "type": "object",
                                    "title": "Metadata",
                                    "properties": {
                                        "title": {
                                            "type": "string",
                                            "title": "Page Title",
                                            "example": "Getting Started"
                                        },
                                        "sourceURL": {
                                            "type": "string",
                                            "title": "Source URL",
                                            "example": "https://example.com/docs/getting-started"
                                        },
                                        "statusCode": {
                                            "type": "number",
                                            "title": "Status Code",
                                            "example": 200
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
