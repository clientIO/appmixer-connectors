{
    "name": "appmixer.attio.core.CreateRecord",
    "label": "Create Record",
    "description": "Create a record of any object. Fails if a value conflicts with a unique attribute; use Upsert Record to update an existing record instead.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:attio"
    },
    "quota": {
        "manager": "appmixer:attio",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "objectId": {
                        "type": "string"
                    },
                    "values": {
                        "type": "string"
                    }
                },
                "required": [
                    "objectId",
                    "values"
                ]
            },
            "inspector": {
                "inputs": {
                    "objectId": {
                        "type": "text",
                        "label": "Object",
                        "index": 1,
                        "tooltip": "Pick an object or type its API slug or ID, for example <code>people</code>, <code>companies</code> or <code>deals</code>.",
                        "source": {
                            "url": "/component/appmixer/attio/core/ListObjects?outPort=out",
                            "data": {
                                "messages": {
                                    "in/outputType": "array"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListObjects#toSelectArray"
                            }
                        }
                    },
                    "values": {
                        "type": "textarea",
                        "label": "Values",
                        "index": 2,
                        "tooltip": "A JSON object mapping attribute API slugs to values, for example <code>{\"name\": \"Acme Inc.\", \"domains\": [\"acme.com\"]}</code>. Use List Attributes to see the slugs of an object. Plain values are accepted for most attribute types (text, number, email, domain, select option title, status title, checkbox). Multiselect attributes take an array. See <a href=\"https://docs.attio.com/rest-api/attribute-types/attribute-types\" target=\"_blank\">attribute types</a>."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Record ID",
                        "example": "bf071e1f-6035-429d-b874-d83ea64ea13b"
                    },
                    "objectId": {
                        "type": "string",
                        "title": "Object ID",
                        "example": "97052eb9-e65e-443f-a297-f2d9a4a7f795"
                    },
                    "workspaceId": {
                        "type": "string",
                        "title": "Workspace ID",
                        "example": "14beef7a-99f7-4534-a87e-70b564330a4c"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created At",
                        "example": "2026-10-20T08:00:00.000000000Z"
                    },
                    "webUrl": {
                        "type": "string",
                        "title": "Web URL",
                        "example": "https://app.attio.com/acme/company/bf071e1f-6035-429d-b874-d83ea64ea13b"
                    },
                    "values": {
                        "type": "object",
                        "title": "Values",
                        "example": {
                            "name": "Acme Inc.",
                            "domains": "acme.com",
                            "description": "Maker of fine widgets"
                        }
                    },
                    "rawValues": {
                        "type": "object",
                        "title": "Raw Values",
                        "example": {
                            "name": [
                                {
                                    "active_from": "2026-10-20T08:00:00.000000000Z",
                                    "active_until": null,
                                    "value": "Acme Inc."
                                }
                            ],
                            "domains": [
                                {
                                    "active_from": "2026-10-20T08:00:00.000000000Z",
                                    "active_until": null,
                                    "value": "acme.com"
                                }
                            ],
                            "description": [
                                {
                                    "active_from": "2026-10-20T08:00:00.000000000Z",
                                    "active_until": null,
                                    "value": "Maker of fine widgets"
                                }
                            ]
                        }
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
