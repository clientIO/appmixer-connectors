{
    "name": "appmixer.attio.core.CreateComment",
    "label": "Create Comment",
    "description": "Start a comment thread on a record, or reply to an existing thread.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:attio"
    },
    "quota": {
        "manager": "appmixer:attio",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "objectId": {
                        "type": "string"
                    },
                    "recordId": {
                        "type": "string"
                    },
                    "threadId": {
                        "type": "string"
                    },
                    "content": {
                        "type": "string"
                    },
                    "authorId": {
                        "type": "string"
                    }
                },
                "required": [
                    "content",
                    "authorId"
                ]
            },
            "inspector": {
                "inputs": {
                    "objectId": {
                        "type": "text",
                        "label": "Record Object",
                        "index": 1,
                        "tooltip": "The object of the record to comment on. Not needed when replying to a thread.",
                        "source": {
                            "url": "/component/appmixer/attio/core/ListObjects?outPort=out",
                            "data": {
                                "messages": {
                                    "in/outputType": "array"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListObjects#toSelectArray"
                            }
                        }
                    },
                    "recordId": {
                        "type": "text",
                        "label": "Record ID",
                        "index": 2,
                        "tooltip": "The ID of the record to comment on. Not needed when replying to a thread."
                    },
                    "threadId": {
                        "type": "text",
                        "label": "Thread ID",
                        "index": 3,
                        "tooltip": "Optional: reply to this existing thread instead of starting a new one on the record."
                    },
                    "content": {
                        "type": "textarea",
                        "label": "Content",
                        "index": 4,
                        "tooltip": "Plain text content. Mention workspace members by their email address."
                    },
                    "authorId": {
                        "type": "text",
                        "label": "Author",
                        "index": 5,
                        "tooltip": "The workspace member the comment is posted as. Pick a member or type the workspace member ID.",
                        "source": {
                            "url": "/component/appmixer/attio/core/ListWorkspaceMembers?outPort=out",
                            "data": {
                                "messages": {
                                    "in/outputType": "array"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListWorkspaceMembers#toSelectArray"
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Comment ID",
                        "example": "aa1dc1d9-93ac-4c6c-987e-16b6eea9aab2"
                    },
                    "workspaceId": {
                        "type": "string",
                        "title": "Workspace ID",
                        "example": "14beef7a-99f7-4534-a87e-70b564330a4c"
                    },
                    "threadId": {
                        "type": "string",
                        "title": "Thread ID",
                        "example": "a649e4d9-435c-43fb-83ba-847b4876f27a"
                    },
                    "content": {
                        "type": "string",
                        "title": "Content",
                        "example": "Can you take a look at this account?"
                    },
                    "recordId": {
                        "type": "string",
                        "title": "Record ID",
                        "example": "bf071e1f-6035-429d-b874-d83ea64ea13b"
                    },
                    "objectId": {
                        "type": "string",
                        "title": "Object ID",
                        "example": "97052eb9-e65e-443f-a297-f2d9a4a7f795"
                    },
                    "entryId": {
                        "type": "string",
                        "title": "Entry ID",
                        "example": "2e6e29ea-c4e0-4f44-842d-78a891f8c156"
                    },
                    "listId": {
                        "type": "string",
                        "title": "List ID",
                        "example": "33ebdbe9-e529-47c9-b894-0ba25e9c15c0"
                    },
                    "authorType": {
                        "type": "string",
                        "title": "Author Type",
                        "example": "workspace-member"
                    },
                    "authorId": {
                        "type": "string",
                        "title": "Author ID",
                        "example": "50cf242c-7fa3-4cad-87d0-75b1af71c57b"
                    },
                    "resolvedAt": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Resolved At",
                        "example": "2026-10-21T10:00:00.000000000Z"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created At",
                        "example": "2026-10-20T08:00:00.000000000Z"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
