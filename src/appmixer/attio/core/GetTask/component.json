{
    "name": "appmixer.attio.core.GetTask",
    "label": "Get Task",
    "description": "Get a task by its ID.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:attio"
    },
    "quota": {
        "manager": "appmixer:attio",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "taskId": {
                        "type": "string"
                    }
                },
                "required": [
                    "taskId"
                ]
            },
            "inspector": {
                "inputs": {
                    "taskId": {
                        "type": "text",
                        "label": "Task ID",
                        "index": 1,
                        "tooltip": "The ID of the task. Use Find Tasks or Create Task to get it."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Task ID",
                        "example": "649e34f4-c39a-4f4d-99ef-48a36bef8f04"
                    },
                    "workspaceId": {
                        "type": "string",
                        "title": "Workspace ID",
                        "example": "14beef7a-99f7-4534-a87e-70b564330a4c"
                    },
                    "content": {
                        "type": "string",
                        "title": "Content",
                        "example": "Follow up on the proposal"
                    },
                    "deadlineAt": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Deadline At",
                        "example": "2026-10-27T09:00:00.000000000Z"
                    },
                    "isCompleted": {
                        "type": "boolean",
                        "title": "Is Completed",
                        "example": false
                    },
                    "completedAt": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Completed At",
                        "example": "2026-10-21T15:30:00.000000000Z"
                    },
                    "linkedRecords": {
                        "type": "array",
                        "title": "Linked Records",
                        "items": {
                            "type": "object",
                            "properties": {
                                "targetObjectId": {
                                    "type": "string",
                                    "title": "Target Object ID"
                                },
                                "targetRecordId": {
                                    "type": "string",
                                    "title": "Target Record ID"
                                }
                            }
                        },
                        "example": [
                            {
                                "targetObjectId": "97052eb9-e65e-443f-a297-f2d9a4a7f795",
                                "targetRecordId": "bf071e1f-6035-429d-b874-d83ea64ea13b"
                            }
                        ]
                    },
                    "assignees": {
                        "type": "array",
                        "title": "Assignees",
                        "items": {
                            "type": "object",
                            "properties": {
                                "actorType": {
                                    "type": "string",
                                    "title": "Actor Type"
                                },
                                "actorId": {
                                    "type": "string",
                                    "title": "Actor ID"
                                }
                            }
                        },
                        "example": [
                            {
                                "actorType": "workspace-member",
                                "actorId": "50cf242c-7fa3-4cad-87d0-75b1af71c57b"
                            }
                        ]
                    },
                    "createdByActorType": {
                        "type": "string",
                        "title": "Created By Actor Type",
                        "example": "api-token"
                    },
                    "createdByActorId": {
                        "type": "string",
                        "title": "Created By Actor ID",
                        "example": "a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created At",
                        "example": "2026-10-20T08:00:00.000000000Z"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
