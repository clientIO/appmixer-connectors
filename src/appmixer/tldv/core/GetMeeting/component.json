{
    "name": "appmixer.tldv.core.GetMeeting",
    "label": "Get Meeting",
    "description": "Retrieve a single tl;dv meeting by its ID, including organizer, invitees and template details.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:tldv"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "meetingId": {
                        "type": "string"
                    }
                },
                "required": [
                    "meetingId"
                ]
            },
            "inspector": {
                "inputs": {
                    "meetingId": {
                        "type": "text",
                        "index": 1,
                        "label": "Meeting ID",
                        "tooltip": "The unique identifier of the tl;dv meeting. You can obtain it from List Meetings, Find Meetings or the New Meeting trigger."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": { "type": "string", "title": "Meeting ID", "example": "657f1e2b9a1c4d0012ab34cd" },
                    "name": { "type": "string", "title": "Name", "example": "Acme <> Widgets weekly sync" },
                    "happenedAt": { "type": "string", "format": "date-time", "title": "Happened At", "example": "2025-01-15T10:30:00Z" },
                    "url": { "type": "string", "title": "tl;dv URL", "example": "https://tldv.io/app/meetings/657f1e2b9a1c4d0012ab34cd" },
                    "duration": { "type": "integer", "title": "Duration (seconds)", "example": 1830 },
                    "organizer": {
                        "type": "object",
                        "title": "Organizer",
                        "properties": {
                            "name": { "type": "string", "title": "Name", "example": "Jane Doe" },
                            "email": { "type": "string", "title": "Email", "example": "jane@acme.com" }
                        }
                    },
                    "invitees": {
                        "type": "array",
                        "title": "Invitees",
                        "items": {
                            "type": "object",
                            "properties": {
                                "name": { "type": "string" },
                                "email": { "type": "string" }
                            }
                        },
                        "example": [{ "name": "John Smith", "email": "john@widgets.com" }]
                    },
                    "template": {
                        "type": "object",
                        "title": "Template",
                        "properties": {
                            "id": { "type": "string", "title": "Template ID", "example": "tmpl_123" },
                            "label": { "type": "string", "title": "Template Label", "example": "Sales Call" }
                        }
                    },
                    "extraProperties": {
                        "type": "object",
                        "title": "Extra Properties",
                        "properties": {
                            "conferenceId": { "type": "string", "title": "Conference ID", "example": "abc-defg-hij" }
                        }
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
