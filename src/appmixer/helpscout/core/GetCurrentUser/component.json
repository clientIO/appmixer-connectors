{
    "name": "appmixer.helpscout.core.GetCurrentUser",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieve the current authenticated user profile.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:helpscout"
    },
    "quota": {
        "manager": "appmixer:helpscout",
        "resources": "requests"
    },
    "inPorts": [
        "in"
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "User ID",
                    "value": "id",
                    "schema": {
                        "type": "number",
                        "example": 12345
                    }
                },
                {
                    "label": "First Name",
                    "value": "firstName",
                    "schema": {
                        "type": "string",
                        "example": "John"
                    }
                },
                {
                    "label": "Last Name",
                    "value": "lastName",
                    "schema": {
                        "type": "string",
                        "example": "Doe"
                    }
                },
                {
                    "label": "Email",
                    "value": "email",
                    "schema": {
                        "type": "string",
                        "example": "john.doe@example.com"
                    }
                },
                {
                    "label": "Role",
                    "value": "role",
                    "schema": {
                        "type": "string",
                        "example": "owner"
                    }
                },
                {
                    "label": "Timezone",
                    "value": "timezone",
                    "schema": {
                        "type": "string",
                        "example": "America/New_York"
                    }
                },
                {
                    "label": "Photo Url",
                    "value": "photoUrl",
                    "schema": {
                        "type": "string",
                        "example": "https://example.com/photos/user123.jpg"
                    }
                },
                {
                    "label": "Created At",
                    "value": "createdAt",
                    "schema": {
                        "type": "string",
                        "example": "2024-01-15T10:30:00Z"
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updatedAt",
                    "schema": {
                        "type": "string",
                        "example": "2024-01-16T14:20:00Z"
                    }
                },
                {
                    "label": "Type",
                    "value": "type",
                    "schema": {
                        "type": "string",
                        "example": "email"
                    }
                },
                {
                    "label": "Mention",
                    "value": "mention",
                    "schema": {
                        "type": "string",
                        "example": "@johndoe"
                    }
                },
                {
                    "label": "Initials",
                    "value": "initials",
                    "schema": {
                        "type": "string",
                        "example": "JD"
                    }
                },
                {
                    "label": "Job Title",
                    "value": "jobTitle",
                    "schema": {
                        "type": "string",
                        "example": "Software Engineer"
                    }
                },
                {
                    "label": "Phone",
                    "value": "phone",
                    "schema": {
                        "type": "string",
                        "example": "+1-555-0123"
                    }
                },
                {
                    "label": "Alternate Emails",
                    "value": "alternateEmails",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "john.doe@personal-example.com"
                        ]
                    }
                },
                {
                    "label": "Company ID",
                    "value": "companyId",
                    "schema": {
                        "type": "number",
                        "example": 100
                    }
                },
                {
                    "label": "Links",
                    "value": "_links",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "self": {
                                "type": "object",
                                "properties": {
                                    "href": {
                                        "type": "string",
                                        "title": "Links.Self.Href",
                                        "example": "https://api.example.com/resource/123"
                                    }
                                },
                                "title": "Links.Self"
                            }
                        },
                        "example": {
                            "self": {
                                "href": "https://api.helpscout.net/v2/users/12345"
                            }
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
