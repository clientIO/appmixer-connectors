                            "photoUrl": {
                                "type": "string",
                                "title": "Closed By User.Photo Url",
                                "example": "https://example.com/photos/user123.jpg"
                            },
                            "email": {
                                "type": "string",
                                "title": "Closed By User.Email",
                                "example": "john.doe@example.com"
                            }
                        },
                        "example": {
                            "id": 256,
                            "type": "user",
                            "first": "Jane",
                            "last": "Smith",
                            "email": "jane.smith@example.com"
                        }
                    }
                },
                {
                    "label": "Closed At",
                    "value": "closedAt",
                    "schema": {
                        "type": "string",
                        "example": "2024-01-17T09:00:00Z"
                    }
                },
                {
                    "label": "User Updated At",
                    "value": "userUpdatedAt",
                    "schema": {
                        "type": "string",
                        "example": "2024-01-16T14:20:00Z"
                    }
                },
