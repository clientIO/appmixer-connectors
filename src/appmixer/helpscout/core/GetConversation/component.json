                                "type": "string",
                                "title": "Source.Via",
                                "example": "customer"
                            }
                        },
                        "example": {
                            "type": "email",
                            "via": "customer"
                        }
                    }
                },
                {
                    "label": "Tags",
                    "value": "tags",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "number",
