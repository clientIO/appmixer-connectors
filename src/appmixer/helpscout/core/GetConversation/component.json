                                    "example": 12345
                                },
                                "color": {
                                    "type": "string",
                                    "title": "Tags.Color",
                                    "example": "blue"
                                },
                                "tag": {
                                    "type": "string",
                                    "title": "Tags.Tag",
                                    "example": "important"
                                }
                            }
                        },
                        "example": [
                            {
                                "id": 12345,
                                "color": "#929499",
                                "tag": "billing"
                            }
                        ]
                    }
                },
                {
                    "label": "Cc",
                    "value": "cc",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "string"
