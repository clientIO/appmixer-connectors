                    "label": "Primary Customer",
                    "value": "primaryCustomer",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "number",
                                "title": "Primary Customer.Id",
                                "example": 12345
                            },
                            "type": {
                                "type": "string",
                                "title": "Primary Customer.Type",
                                "example": "user"
                            },
                            "first": {
                                "type": "string",
