                                    "example": "John Doe"
                                },
                                "value": {
                                    "type": "string",
                                    "title": "Custom Fields.Value",
                                    "example": "custom-value"
                                },
                                "text": {
                                    "type": "string",
                                    "title": "Custom Fields.Text",
                                    "example": "Custom field text"
                                }
                            },
                            "required": [
                                "id",
                                "name",
                                "value",
                                "text"
                            ]
                        },
                        "example": [
                            {
                                "id": 8,
                                "name": "Account Type",
                                "value": "Premium",
                                "text": "Premium"
                            }
                        ]
                    }
                },
