                            "id": {
                                "type": "number",
                                "title": "Assignee.ID",
                                "example": 12345
                            },
                            "type": {
                                "type": "string",
                                "title": "Assignee.Type",
                                "example": "user"
                            },
                            "first": {
                                "type": "string",
                                "title": "Assignee.First",
                                "example": "John"
                            },
                            "last": {
                                "type": "string",
                                "title": "Assignee.Last",
                                "example": "Doe"
                            },
                            "email": {
                                "type": "string",
                                "title": "Assignee.Email",
                                "example": "john.doe@example.com"
                            }
                        },
                        "example": {
                            "id": 256,
                            "type": "user",
                            "first": "Jane",
                            "last": "Smith",
                            "email": "jane.smith@example.com"
                        }
                    }
                },
                {
                    "label": "Created By",
                    "value": "createdBy",
