                            "type": {
                                "type": "string",
                                "title": "Created By.Type",
                                "example": "user"
                            },
                            "email": {
                                "type": "string",
                                "title": "Created By.Email",
                                "example": "john.doe@example.com"
                            }
                        },
                        "example": {
                            "id": 367,
                            "type": "customer",
                            "first": "John",
                            "last": "Doe",
                            "email": "john.doe@example.com"
                        }
                    }
                },
                {
                    "label": "Created At",
                    "value": "createdAt",
                    "schema": {
                        "type": "string",
                        "example": "2024-01-15T10:30:00Z"
                    }
                },
                {
                    "label": "Closed By",
                    "value": "closedBy",
                    "schema": {
                        "type": "number",
                        "example": 67890
                    }
