                                "example": "John"
                            },
                            "last": {
                                "type": "string",
                                "title": "Primary Customer.Last",
                                "example": "Doe"
                            },
                            "email": {
                                "type": "string",
                                "title": "Primary Customer.Email",
                                "example": "john.doe@example.com"
                            }
                        },
                        "example": {
                            "id": 367,
                            "type": "customer",
                            "first": "John",
                            "last": "Doe",
                            "email": "john.doe@example.com"
                        }
                    }
                },
                {
                    "label": "Snooze",
