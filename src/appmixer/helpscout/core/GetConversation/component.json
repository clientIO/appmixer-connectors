{
    "name": "appmixer.helpscout.core.GetConversation",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieve a specific conversation by ID.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:helpscout"
    },
    "quota": {
        "manager": "appmixer:helpscout",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    }
                },
                "required": [
                    "id"
                ]
            },
            "inspector": {
                "inputs": {
                    "id": {
                        "type": "text",
                        "tooltip": "Conversation ID.",
                        "label": "Conversation ID",
                        "index": 0
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Conversation ID",
                    "value": "id",
                    "schema": {
                        "type": "number",
                        "example": 12345
                    }
                },
                {
                    "label": "Number",
                    "value": "number",
                    "schema": {
                        "type": "number",
                        "example": 1001
                    }
                },
                {
                    "label": "Threads",
                    "value": "threads",
                    "schema": {
                        "type": "number",
                        "example": 3
                    }
                },
                {
                    "label": "Type",
                    "value": "type",
                    "schema": {
                        "type": "string",
                        "example": "email"
                    }
                },
                {
                    "label": "Folder Id",
                    "value": "folderId",
                    "schema": {
                        "type": "number",
                        "example": 12345
                    }
                },
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "string",
                        "example": "active"
                    }
                },
                {
                    "label": "State",
                    "value": "state",
                    "schema": {
                        "type": "string",
                        "example": "published"
                    }
                },
                {
                    "label": "Subject",
                    "value": "subject",
                    "schema": {
                        "type": "string",
                        "example": "Inquiry about your services"
                    }
                },
                {
                    "label": "Preview",
                    "value": "preview",
                    "schema": {
                        "type": "string",
                        "example": "Hello, I am writing to ask about..."
                    }
                },
                {
                    "label": "Mailbox ID",
                    "value": "mailboxId",
                    "schema": {
                        "type": "number",
                        "example": 12345
                    }
                },
                {
