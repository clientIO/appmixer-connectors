                                "type": "boolean",
                                "title": "Snooze.Unsnooze On Customer Reply",
                                "example": true
                            }
                        },
                        "example": {
                            "snoozedBy": 256,
                            "snoozedUntil": "2024-01-20T09:00:00Z",
                            "unsnoozeOnCustomerReply": true
                        }
                    }
                },
                {
                    "label": "Next Event",
                    "value": "nextEvent",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "time": {
                                "type": "string",
                                "title": "Next Event.Time",
                                "example": "2024-01-15T10:30:00Z"
                            },
                            "eventType": {
                                "type": "string",
                                "title": "Next Event.Event Type",
                                "example": "snooze"
                            },
                            "userId": {
                                "type": "number",
                                "title": "Next Event.User Id",
                                "example": 67890
                            },
                            "cancelOnCustomerReply": {
                                "type": "boolean",
                                "title": "Next Event.Cancel On Customer Reply",
                                "example": true
                            }
                        },
                        "example": {
                            "time": "2024-01-20T09:00:00Z",
                            "eventType": "scheduled",
                            "userId": 256,
                            "cancelOnCustomerReply": false
                        }
                    }
                },
