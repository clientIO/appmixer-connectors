                            "time": {
                                "type": "string",
                                "title": "Customer Waiting Since.Time",
                                "example": "2024-01-15T10:30:00Z"
                            },
                            "friendly": {
                                "type": "string",
                                "title": "Customer Waiting Since.Friendly",
                                "example": "3 hours ago"
                            }
                        },
                        "example": {
                            "time": "2024-01-15T10:30:00Z",
                            "friendly": "2 hours ago"
                        }
                    }
