{
    "name": "appmixer.microsoft.sharepoint.DeletedFile",
    "label": "Deleted File",
    "author": "Zbynek Pelunek <zbynek.pelunek@client.io>",
    "description": "This trigger fires every time there's a file deleted in the selected Drive.",
    "version": "1.0.0",
    "private": false,
    "webhook": true,
    "tick": true,
    "auth": {
        "service": "appmixer:microsoft",
        "scope": [
            "Files.Read.All",
            "Sites.Read.All",
            "Subscription.Read.All"
        ]
    },
    "properties": {
        "schema": {
            "properties": {
                "siteId": {
                    "type": "string"
                },
                "driveId": {
                    "type": "string"
                },
                "parentPath": {
                    "type": "string"
                }
            },
            "required": [
                "siteId",
                "driveId"
            ]
        },
        "inspector": {
            "inputs": {
                "siteId": {
                    "type": "text",
                    "label": " Site ID",
                    "index": 1,
                    "tooltip": "Provide a site ID.",
                    "source": {
                        "url": "/component/appmixer/microsoft/sharepoint/ListSites?outPort=out",
                        "data": {
                            "transform": "./ListSites#sitesToSelectArray"
                        }
                    }
                },
                "driveId": {
                    "type": "text",
                    "index": 2,
                    "label": "Drive ID",
                    "tooltip": "ID of the drive where the file is located.",
                    "source": {
                        "url": "/component/appmixer/microsoft/sharepoint/ListDrives?outPort=out",
                        "data": {
                            "messages": {
                                "in/siteId": "properties/siteId"
                            },
                            "transform": "./ListDrives#drivesToSelectArray"
                        }
                    }
                },
                "parentPath": {
                    "type": "text",
                    "index": 3,
                    "label": "Parent Path",
                    "group": "parent",
                    "tooltip": "Specify the path of the parent folder. Leave empty to use the selected Drive as the parent. Example: <code>path/to/parent/folder</code>."
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "file",
            "options": [
                {
                    "label": "@Odata.Type",
                    "value": "@odata.type",
                    "schema": {
                        "type": "string",
                        "example": "#microsoft.graph.driveItem"
                    }
                },
                {
                    "label": "Item ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "01ABC123DEF456"
                    }
                },
                {
                    "label": "Parent Reference",
                    "value": "parentReference",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "driveType": {
                                "type": "string",
                                "title": "Parent Reference.Drive Type"
                            },
                            "driveId": {
                                "type": "string",
                                "title": "Parent Reference.Drive ID"
                            },
                            "id": {
                                "type": "string",
                                "title": "Parent Referenced.ID"
                            },
                            "siteId": {
                                "type": "string",
                                "title": "Parent Reference.Site ID"
                            }
                        },
                        "example": {
                            "driveId": "b!xyz123",
                            "id": "01ABC000",
                            "path": "/drive/root:/Documents"
                        }
                    }
                },
                {
                    "label": "C Tag",
                    "value": "cTag",
                    "schema": {
                        "type": "string",
                        "example": "aYzpCQUJDMTIz.247"
                    }
                },
                {
                    "label": "Deleted",
                    "value": "deleted",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "state": {
                                "type": "string",
                                "title": "Deleted.State"
                            }
                        },
                        "example": {
                            "state": "deleted"
                        }
                    }
                },
                {
                    "label": "File",
                    "value": "file",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "hashes": {
                                "type": "object",
                                "properties": {
                                    "quickXorHash": {
                                        "type": "string",
                                        "title": "File.Hashes.Quick Xor Hash"
                                    }
                                },
                                "title": "File.Hashes"
                            }
                        },
                        "example": {
                            "mimeType": "application/pdf",
                            "hashes": {}
                        }
                    }
                },
                {
                    "label": "File System Info",
                    "value": "fileSystemInfo",
                    "schema": {
                        "type": "object",
                        "example": {
                            "createdDateTime": "2025-12-01T08:00:00Z",
                            "lastModifiedDateTime": "2026-01-10T14:30:00Z"
                        }
                    }
                },
                {
                    "label": "Shared",
                    "value": "shared",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "scope": {
                                "type": "string",
                                "title": "Shared.Scope"
                            }
                        },
                        "example": {
                            "scope": "users"
                        }
                    }
                },
                {
                    "label": "Size",
                    "value": "size",
                    "schema": {
                        "type": "number",
                        "example": 0
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
