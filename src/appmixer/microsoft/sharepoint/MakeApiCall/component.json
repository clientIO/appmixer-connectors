{
    "name": "appmixer.microsoft.sharepoint.MakeApiCall",
    "author": "Harsha Surisetty <harsha@client.io>",
    "description": "Performs an arbitrary authorized API call.",
    "private": false,
    "auth": {
        "service": "appmixer:microsoft",
        "scope": [
            "Files.Read.All",
            "Files.ReadWrite.All",
            "Sites.Read.All",
            "Sites.ReadWrite.All",
            "Subscription.Read.All"
        ]
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "url": {
                        "type": "string"
                    },
                    "method": {
                        "type": "string",
                        "enum": [
                            "GET",
                            "POST",
                            "PUT",
                            "PATCH",
                            "DELETE"
                        ]
                    },
                    "body": {
                        "type": "string"
                    },
                    "headers": {
                        "type": "string"
                    },
                    "parameters": {
                        "type": "string"
                    }
                },
                "required": [
                    "url",
                    "method"
                ]
            },
            "inspector": {
                "inputs": {
                    "url": {
                        "type": "text",
                        "index": 1,
                        "label": "API Endpoint URL",
                        "tooltip": "Enter the API endpoint path relative to <code>https://graph.microsoft.com/v1.0/</code> (for example <code>/me/drive/root/children</code>) or provide a full URL."
                    },
                    "method": {
                        "type": "select",
                        "index": 2,
                        "label": "HTTP Method",
                        "defaultValue": "GET",
                        "tooltip": "Select the HTTP method for the API call.",
                        "options": [
                            {
                                "label": "GET",
                                "value": "GET"
                            },
                            {
                                "label": "POST",
                                "value": "POST"
                            },
                            {
                                "label": "PUT",
                                "value": "PUT"
                            },
                            {
                                "label": "PATCH",
                                "value": "PATCH"
                            },
                            {
                                "label": "DELETE",
                                "value": "DELETE"
                            }
                        ]
                    },
                    "body": {
                        "type": "textarea",
                        "index": 4,
                        "label": "Body",
                        "tooltip": "Enter the request body as a JSON object (supports nested objects, arrays, and non-string values)."
                    },
                    "headers": {
                        "type": "key-value",
                        "keyLabel": "Key",
                        "valueLabel": "Value",
                        "addLabel": "Add item",
                        "removeLabel": "Remove item",
                        "label": "Request Headers",
                        "index": 5,
                        "tooltip": "Optional additional request headers."
                    },
                    "parameters": {
                        "type": "key-value",
                        "keyLabel": "Key",
                        "valueLabel": "Value",
                        "addLabel": "Add item",
                        "removeLabel": "Remove item",
                        "label": "Query Parameters",
                        "index": 3,
                        "tooltip": "Optional query parameters."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Response",
                    "value": "response"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
