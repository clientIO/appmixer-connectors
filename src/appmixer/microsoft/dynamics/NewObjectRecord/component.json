{
    "name": "appmixer.microsoft.dynamics.NewObjectRecord",
    "author": "AppMixer <info@appmixer.com>",
    "label": "New Object Record",
    "description": "Triggers when a new record of the selected Entity type is created in Microsoft Dynamics 365. Works with any entity, including custom ones.",
    "private": false,
    "auth": {
        "service": "appmixer:microsoft:dynamics",
        "scope": []
    },
    "version": "1.0.0",
    "tick": true,
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/microsoft/dynamics/DynamicEntity?outPort=out",
                "data": {
                    "messages": {
                        "in/logicalName": "properties/objectName",
                        "in/outputType": "object"
                    },
                    "properties": {
                        "generateOutputPortOptions": true
                    }
                }
            }
        }
    ],
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "objectName": {
                    "type": "string"
                }
            },
            "required": [
                "objectName"
            ]
        },
        "inspector": {
            "inputs": {
                "objectName": {
                    "type": "text",
                    "index": 1,
                    "label": "Object Name",
                    "source": {
                        "url": "/component/appmixer/microsoft/dynamics/CreateObjectRecord?outPort=out",
                        "data": {
                            "properties": {
                                "listDefaultEntities": true
                            }
                        }
                    },
                    "tooltip": "The logical name of the entity to watch. The suggestions list only the most common entities. You can type any other entity logical name manually, or use the 'List Entities' component to fetch the full list."
                }
            }
        }
    },
    "icon": "data:image/svg+xml;base64,"
}
