{
    "name": "appmixer.microsoft.dynamics.DealStageChanged",
    "author": "AppMixer <info@appmixer.com>",
    "label": "Deal Stage Changed",
    "description": "Triggers when the sales stage of an opportunity (deal) changes in Microsoft Dynamics 365. The trigger remembers the stage of each opportunity it has seen and fires only on an actual stage transition - creating or editing an opportunity without changing its stage does not fire it.",
    "private": false,
    "auth": {
        "service": "appmixer:microsoft:dynamics",
        "scope": []
    },
    "version": "1.0.0",
    "tick": true,
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/microsoft/dynamics/DynamicEntity?outPort=out",
                "data": {
                    "messages": {
                        "in/logicalName": "opportunity",
                        "in/outputType": "object"
                    },
                    "properties": {
                        "generateOutputPortOptions": true
                    }
                }
            }
        }
    ],
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "stageField": {
                    "type": "string"
                }
            }
        },
        "inspector": {
            "inputs": {
                "stageField": {
                    "type": "text",
                    "index": 1,
                    "label": "Stage Field",
                    "defaultValue": "salesstage",
                    "tooltip": "The opportunity attribute watched for changes. Defaults to 'salesstage' (Qualify/Develop/Propose/Close). You can also use 'stepname', 'salesstagecode' or any custom stage attribute logical name."
                }
            }
        }
    },
    "icon": "data:image/svg+xml;base64,"
}
