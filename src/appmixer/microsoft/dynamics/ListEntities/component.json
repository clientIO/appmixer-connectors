{
    "name": "appmixer.microsoft.dynamics.ListEntities",
    "author": "AppMixer <info@appmixer.com>",
    "label": "List Entities",
    "description": "Retrieve the list of entities (object types) available in your Dynamics 365 organization. Use the 'Logical Name' output as the Object Name in other components.",
    "private": false,
    "auth": {
        "service": "appmixer:microsoft:dynamics",
        "scope": []
    },
    "version": "1.0.0",
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "userFacingOnly": { "type": "boolean" },
                    "outputType": { "type": "string" }
                }
            },
            "required": [],
            "inspector": {
                "inputs": {
                    "userFacingOnly": {
                        "type": "toggle",
                        "label": "User-Facing Entities Only",
                        "index": 1,
                        "defaultValue": true,
                        "tooltip": "When enabled, system, internal and many-to-many relationship entities are excluded so you only get the entities a user normally works with. Disable to return every entity in the organization."
                    },
                    "outputType": {
                        "group": "last",
                        "type": "select",
                        "label": "Output Type",
                        "index": 2,
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, one item at a time, or streamed into a file.",
                        "options": [
                            { "label": "All items at once", "value": "array" },
                            { "label": "One item at a time", "value": "object" },
                            { "label": "File", "value": "file" }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/microsoft/dynamics/ListEntities?outPort=out&ignoreAuth=true",
                "data": {
                    "messages": {
                        "in/outputType": "inputs/in/outputType"
                    },
                    "properties": {
                        "generateOutputPortOptions": true
                    }
                }
            }
        },
        {
            "name": "emptyResult",
            "options": [
                { "label": "Message", "value": "message", "schema": { "example": "No entities returned." } }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
