{
    "name": "appmixer.microsoft.mail.NewEmail",
    "author": "David Durman <david@client.io>",
    "description": "Watch your Inbox for new messages.",
    "webhook": true,
    "auth": {
        "service": "appmixer:microsoft",
        "scope": ["Mail.Read"]
    },
    "properties": {
        "schema": {
            "properties": {
                "resource": { "type": "string" }
            }
        },
        "inspector": {
            "inputs": {
                "resource": {
                    "type": "text",
                    "defaultValue": "/me/mailfolders('inbox')/messages",
                    "index": 1,
                    "label": "Resource",
                    "tooltip": "The URI of the resource that emitted the change notification relative to https://graph.microsoft.com. See more details in <a target=\"_blank\" href=\"https://docs.microsoft.com/en-us/graph/outlook-change-notifications-overview\">the Microsoft documentation</a>. For example, to watch for new messages in the Drafts folder, use <code>me/mailfolders('Drafts')/messages</code>."
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Message Id",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "AAMkAGVmMDEzMTM4LTZmYWUtNDdkNC1hMDZiLTU1OGY5OTZhYmY4OABGAAAAAAAiQ8W967B7TKBjgx9rVEURBwAiIsqMbYjsT5e-T7KzowPTAAAAAAEMAAAiIsqMbYjsT5e-T7KzowPTAAAYbvZDAAA="
                    }
                },
                {
                    "label": "Subject",
                    "value": "subject",
                    "schema": {
                        "type": "string",
                        "example": "Quarterly report"
                    }
                },
                {
                    "label": "Body Preview",
                    "value": "bodyPreview",
                    "schema": {
                        "type": "string",
                        "example": "Hi team, please find the quarterly report attached."
                    }
                },
                {
                    "label": "Web Link",
                    "value": "webLink",
                    "schema": {
                        "type": "string",
                        "example": "https://outlook.office365.com/owa/?ItemID=AAMkAGVmMDEzMTM4LTZmYWUtNDdkNC1hMDZiLTU1OGY5OTZhYmY4OABGAAAAAAAiQ8W967B7TKBjgx9rVEURBwAiIsqMbYjsT5e%2FT7KzowPTAAAYbvZDAAA%3D&exvsurl=1&viewmodel=ReadMessageItem"
                    }
                },
                {
                    "label": "Body",
                    "value": "body",
                    "schema": {
                        "type": "object",
                        "example": {
                            "contentType": "html",
                            "content": "<html><body><p>Hi team, please find the quarterly report attached.</p></body></html>"
                        }
                    }
                },
                {
                    "label": "Sender Email Address Name",
                    "value": "sender.emailAddress.name",
                    "schema": {
                        "type": "string",
                        "example": "Jane Doe"
                    }
                },
                {
                    "label": "Sender Email Address",
                    "value": "sender.emailAddress.address",
                    "schema": {
                        "type": "string",
                        "example": "jane.doe@contoso.com"
                    }
                },
                {
                    "label": "From Email Address Name",
                    "value": "from.emailAddress.name",
                    "schema": {
                        "type": "string",
                        "example": "Jane Doe"
                    }
                },
                {
                    "label": "From Email Address",
                    "value": "from.emailAddress.address",
                    "schema": {
                        "type": "string",
                        "example": "jane.doe@contoso.com"
                    }
                },
                {
                    "label": "To Recipients",
                    "value": "toRecipients",
                    "schema": {
                        "type": "array",
                        "example": [
                            {
                                "emailAddress": {
                                    "name": "Team",
                                    "address": "team@contoso.com"
                                }
                            }
                        ]
                    }
                },
                {
                    "label": "CC Recipients",
                    "value": "ccRecipients",
                    "schema": {
                        "type": "array",
                        "example": [
                            {
                                "emailAddress": {
                                    "name": "Manager",
                                    "address": "manager@contoso.com"
                                }
                            }
                        ]
                    }
                },
                {
                    "label": "BCC Recipients",
                    "value": "bccRecipients",
                    "schema": {
                        "type": "array",
                        "example": []
                    }
                },
                {
                    "label": "Reply To",
                    "value": "replyTo",
                    "schema": {
                        "type": "array",
                        "example": []
                    }
                },
                {
                    "label": "Created Time",
                    "value": "createdDateTime",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00Z"
                    }
                },
                {
                    "label": "Last Modified Date Time",
                    "value": "lastModifiedDateTime",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:05Z"
                    }
                },
                {
                    "label": "Change Key",
                    "value": "changeKey",
                    "schema": {
                        "type": "string",
                        "example": "CQAAABYAAAAiIsqMbYjsT5e/T7KzowPTAAAYbvZD"
                    }
                },
                {
                    "label": "Categories",
                    "value": "categories",
                    "schema": {
                        "type": "array",
                        "example": []
                    }
                },
                {
                    "label": "Received Date Time",
                    "value": "receivedDateTime",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00Z"
                    }
                },
                {
                    "label": "Sent Date Time",
                    "value": "sentDateTime",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:29:58Z"
                    }
                },
                {
                    "label": "Has Attachments",
                    "value": "hasAttachments",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "Internet Message Id",
                    "value": "internetMessageId",
                    "schema": {
                        "type": "string",
                        "example": "<CAF3b8Qw9xLm2@mail.contoso.com>"
                    }
                },
                {
                    "label": "Importance",
                    "value": "importance",
                    "schema": {
                        "type": "string",
                        "example": "normal"
                    }
                },
                {
                    "label": "Parent Folder Id",
                    "value": "parentFolderId",
                    "schema": {
                        "type": "string",
                        "example": "AAMkAGVmMDEzMTM4LTZmYWUtNDdkNC1hMDZiLTU1OGY5OTZhYmY4OAAuAAAAAAAiQ8W967B7TKBjgx9rVEURAQAiIsqMbYjsT5e-T7KzowPTAAAAAAEMAAA="
                    }
                },
                {
                    "label": "Conversation Id",
                    "value": "conversationId",
                    "schema": {
                        "type": "string",
                        "example": "AAQkAGVmMDEzMTM4LTZmYWUtNDdkNC1hMDZiLTU1OGY5OTZhYmY4OAAQAMrXvmW3m1ZNnxEuLdEk2sE="
                    }
                },
                {
                    "label": "Is Delivery Receipt Requested",
                    "value": "isDeliveryReceiptRequested",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Is ReadReceipt Requested",
                    "value": "isReadReceiptRequested",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Is Read",
                    "value": "isRead",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Is Draft",
                    "value": "isDraft",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Web Link",
                    "value": "webLink",
                    "schema": {
                        "type": "string",
                        "example": "https://outlook.office365.com/owa/?ItemID=AAMkAGVmMDEzMTM4LTZmYWUtNDdkNC1hMDZiLTU1OGY5OTZhYmY4OABGAAAAAAAiQ8W967B7TKBjgx9rVEURBwAiIsqMbYjsT5e%2FT7KzowPTAAAYbvZDAAA%3D&exvsurl=1&viewmodel=ReadMessageItem"
                    }
                },
                {
                    "label": "Inference Classification",
                    "value": "inferenceClassification",
                    "schema": {
                        "type": "string",
                        "example": "focused"
                    }
                },
                {
                    "label": "Flag Status",
                    "value": "flag.flagStatus",
                    "schema": {
                        "type": "string",
                        "example": "notFlagged"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
