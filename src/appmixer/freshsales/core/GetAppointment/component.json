{
    "name": "appmixer.freshsales.core.GetAppointment",
    "description": "Retrieve an appointment by ID.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:freshsales"
    },
    "quota": {
        "manager": "appmixer:freshsales",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    }
                },
                "required": [
                    "id"
                ]
            },
            "inspector": {
                "inputs": {
                    "id": {
                        "type": "text",
                        "label": "Appointment ID",
                        "tooltip": "The ID of the appointment.",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "ID",
                        "example": 1
                    },
                    "title": {
                        "type": "string",
                        "title": "Title",
                        "example": "Product Demo"
                    },
                    "description": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Description",
                        "example": "The contact expressed interest to know more about the product. Giving her a demo."
                    },
                    "from_date": {
                        "type": "string",
                        "title": "From Date",
                        "example": "2024-06-20T10:00:00Z"
                    },
                    "end_date": {
                        "type": "string",
                        "title": "End Date",
                        "example": "2024-06-20T11:00:00Z"
                    },
                    "time_zone": {
                        "type": "string",
                        "title": "Time Zone",
                        "example": "Eastern Time (US & Canada)"
                    },
                    "location": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Location",
                        "example": "Elite conference room"
                    },
                    "is_allday": {
                        "type": "boolean",
                        "title": "Is All Day",
                        "example": false
                    },
                    "outcome_id": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "title": "Outcome ID",
                        "example": null
                    },
                    "provider": {
                        "type": "string",
                        "title": "Provider",
                        "example": "freshsales"
                    },
                    "creater_id": {
                        "type": "integer",
                        "title": "Creator ID",
                        "example": 223
                    },
                    "created_at": {
                        "type": "string",
                        "title": "Created At",
                        "example": "2024-06-10T09:00:00Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "title": "Updated At",
                        "example": "2024-06-10T09:00:00Z"
                    },
                    "latitude": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Latitude",
                        "example": "34.4208"
                    },
                    "longitude": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Longitude",
                        "example": "119.6982"
                    },
                    "checkedin_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Checked In At",
                        "example": null
                    },
                    "checkedout_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Checked Out At",
                        "example": null
                    },
                    "checkedin_duration": {
                        "type": [
                            "number",
                            "null"
                        ],
                        "title": "Checked In Duration",
                        "example": null
                    },
                    "checkedout_latitude": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Checked Out Latitude",
                        "example": null
                    },
                    "checkedout_longitude": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Checked Out Longitude",
                        "example": null
                    },
                    "checkedout_location": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Checked Out Location",
                        "example": null
                    },
                    "can_checkin": {
                        "type": "boolean",
                        "title": "Can Check In",
                        "example": false
                    },
                    "can_checkin_checkout": {
                        "type": "boolean",
                        "title": "Can Check In/Out",
                        "example": false
                    },
                    "conference_id": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "title": "Conference ID",
                        "example": null
                    },
                    "note_id": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "title": "Note ID",
                        "example": null
                    },
                    "has_multiple_emails": {
                        "type": "boolean",
                        "title": "Has Multiple Emails",
                        "example": false
                    },
                    "targetable": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "title": "Targetable",
                        "example": {
                            "type": "contact",
                            "id": 115765
                        }
                    },
                    "targetables": {
                        "type": "array",
                        "title": "Targetables",
                        "items": {
                            "type": "object"
                        },
                        "example": [
                            {
                                "type": "contact",
                                "id": 115765
                            }
                        ]
                    },
                    "targetables_with_email": {
                        "type": "array",
                        "title": "Targetables With Email",
                        "items": {
                            "type": "object"
                        },
                        "example": [
                            {
                                "type": "contact",
                                "id": 115765,
                                "email": "eric.sampleton@example.com"
                            }
                        ]
                    },
                    "appointment_attendee_ids": {
                        "type": "array",
                        "title": "Attendee IDs",
                        "items": {
                            "type": "integer"
                        },
                        "example": [
                            94649,
                            94648
                        ]
                    }
                },
                "required": []
            }
        }
    ],
    "icon": "data:image/png;base64,"
}