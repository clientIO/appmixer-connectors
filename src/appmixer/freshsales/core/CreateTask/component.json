{
    "name": "appmixer.freshsales.core.CreateTask",
    "description": "Create a new task in Freshsales. Tasks can be associated with contacts, accounts, or deals.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:freshsales"
    },
    "quota": {
        "manager": "appmixer:freshsales",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "due_date": {
                        "type": "string"
                    },
                    "task_type": {
                        "type": "string"
                    },
                    "priority": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "owner_id": {
                        "type": "string"
                    },
                    "contact_id": {
                        "type": "string"
                    },
                    "account_id": {
                        "type": "string"
                    },
                    "deal_id": {
                        "type": "string"
                    },
                    "is_notification_set": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "title",
                    "due_date"
                ]
            },
            "inspector": {
                "inputs": {
                    "title": {
                        "type": "text",
                        "index": 0,
                        "label": "Title",
                        "tooltip": "The title of the task"
                    },
                    "description": {
                        "type": "textarea",
                        "index": 1,
                        "label": "Description",
                        "tooltip": "The description of the task"
                    },
                    "due_date": {
                        "type": "date-time",
                        "index": 2,
                        "label": "Due Date",
                        "tooltip": "The due date of the task",
                        "config": {
                            "enableTime": false
                        }
                    },
                    "task_type": {
                        "type": "select",
                        "index": 3,
                        "label": "Task Type",
                        "tooltip": "The type of the task",
                        "options": [
                            {
                                "label": "Call",
                                "value": "Call"
                            },
                            {
                                "label": "Email",
                                "value": "Email"
                            },
                            {
                                "label": "Follow-up",
                                "value": "Follow-up"
                            },
                            {
                                "label": "Meeting",
                                "value": "Meeting"
                            },
                            {
                                "label": "Reminder",
                                "value": "Reminder"
                            },
                            {
                                "label": "Send Email",
                                "value": "Send Email"
                            }
                        ]
                    },
                    "priority": {
                        "type": "select",
                        "index": 4,
                        "label": "Priority",
                        "tooltip": "The priority of the task",
                        "options": [
                            {
                                "label": "Low",
                                "value": "Low"
                            },
                            {
                                "label": "Medium",
                                "value": "Medium"
                            },
                            {
                                "label": "High",
                                "value": "High"
                            }
                        ]
                    },
                    "status": {
                        "type": "select",
                        "index": 5,
                        "label": "Status",
                        "tooltip": "The status of the task",
                        "options": [
                            {
                                "label": "Open",
                                "value": "Open"
                            },
                            {
                                "label": "Completed",
                                "value": "Completed"
                            }
                        ]
                    },
                    "owner_id": {
                        "type": "text",
                        "index": 6,
                        "label": "Owner ID",
                        "tooltip": "The ID of the user who owns the task"
                    },
                    "contact_id": {
                        "type": "text",
                        "index": 7,
                        "label": "Contact ID",
                        "tooltip": "The ID of the contact associated with the task"
                    },
                    "account_id": {
                        "type": "text",
                        "index": 8,
                        "label": "Account ID",
                        "tooltip": "The ID of the account associated with the task"
                    },
                    "deal_id": {
                        "type": "text",
                        "index": 9,
                        "label": "Deal ID",
                        "tooltip": "The ID of the deal associated with the task"
                    },
                    "is_notification_set": {
                        "type": "toggle",
                        "index": 10,
                        "label": "Send Notification",
                        "tooltip": "Whether a notification should be sent for this task"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": [
                            "string",
                            "integer"
                        ],
                        "title": "Task ID",
                        "example": 1
                    },
                    "title": {
                        "type": "string",
                        "title": "Title",
                        "example": "Follow up with Jane"
                    },
                    "description": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Description",
                        "example": "Do a follow-up call with Jane."
                    },
                    "due_date": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Due Date",
                        "example": "2024-03-21T11:00:00Z"
                    },
                    "status": {
                        "type": [
                            "integer",
                            "string",
                            "null"
                        ],
                        "title": "Status",
                        "example": 0
                    },
                    "task_type": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Task Type",
                        "example": "Follow-up"
                    },
                    "task_type_id": {
                        "type": [
                            "string",
                            "integer",
                            "null"
                        ],
                        "title": "Task Type ID",
                        "example": 2
                    },
                    "priority": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Priority",
                        "example": "Medium"
                    },
                    "owner_id": {
                        "type": [
                            "string",
                            "integer",
                            "null"
                        ],
                        "title": "Owner ID",
                        "example": 1
                    },
                    "contact_id": {
                        "type": [
                            "string",
                            "integer",
                            "null"
                        ],
                        "title": "Contact ID",
                        "example": 1
                    },
                    "account_id": {
                        "type": [
                            "string",
                            "integer",
                            "null"
                        ],
                        "title": "Account ID",
                        "example": null
                    },
                    "deal_id": {
                        "type": [
                            "string",
                            "integer",
                            "null"
                        ],
                        "title": "Deal ID",
                        "example": null
                    },
                    "is_notification_set": {
                        "type": "boolean",
                        "title": "Notification Set",
                        "example": false
                    },
                    "creater_id": {
                        "type": [
                            "string",
                            "integer",
                            "null"
                        ],
                        "title": "Creator ID",
                        "example": 1
                    },
                    "updater_id": {
                        "type": [
                            "string",
                            "integer",
                            "null"
                        ],
                        "title": "Updater ID",
                        "example": 1
                    },
                    "outcome_id": {
                        "type": [
                            "string",
                            "integer",
                            "null"
                        ],
                        "title": "Outcome ID",
                        "example": null
                    },
                    "completed_date": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Completed Date",
                        "example": null
                    },
                    "is_linkedin_type": {
                        "type": "boolean",
                        "title": "Is LinkedIn Type",
                        "example": false
                    },
                    "targetables": {
                        "type": "array",
                        "title": "Targetables",
                        "example": [
                            {
                                "type": "contact",
                                "id": 1
                            }
                        ]
                    },
                    "targetables_with_email": {
                        "type": "array",
                        "title": "Targetables With Email",
                        "example": [
                            {
                                "type": "contact",
                                "id": 1,
                                "email": "jane.doe@example.com"
                            }
                        ]
                    },
                    "has_multiple_emails": {
                        "type": "boolean",
                        "title": "Has Multiple Emails",
                        "example": false
                    },
                    "created_at": {
                        "type": "string",
                        "title": "Created At",
                        "example": "2024-03-14T03:56:22Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "title": "Updated At",
                        "example": "2024-03-14T04:03:16Z"
                    }
                },
                "required": []
            }
        }
    ],
    "icon": "data:image/png;base64,"
}