{
    "name": "appmixer.freshsales.core.UpdateTask",
    "description": "Update an existing task by ID.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:freshsales"
    },
    "quota": {
        "manager": "appmixer:freshsales",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "title": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "due_date": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "task_type": {
                        "type": "string"
                    },
                    "priority": {
                        "type": "integer"
                    },
                    "status": {
                        "type": "integer"
                    },
                    "owner_id": {
                        "type": "integer"
                    }
                },
                "required": [
                    "id"
                ]
            },
            "inspector": {
                "inputs": {
                    "id": {
                        "type": "text",
                        "label": "Task ID",
                        "tooltip": "The ID of the task to update.",
                        "index": 1
                    },
                    "title": {
                        "type": "text",
                        "label": "Title",
                        "tooltip": "Task title.",
                        "index": 2
                    },
                    "description": {
                        "type": "textarea",
                        "label": "Description",
                        "tooltip": "Task description.",
                        "index": 3
                    },
                    "due_date": {
                        "type": "date-time",
                        "label": "Due Date",
                        "tooltip": "Due date and time for the task.",
                        "index": 4
                    },
                    "task_type": {
                        "type": "text",
                        "label": "Task Type",
                        "tooltip": "Type of task.",
                        "index": 5
                    },
                    "priority": {
                        "type": "select",
                        "label": "Priority",
                        "tooltip": "Priority level of the task.",
                        "index": 6,
                        "options": [
                            {
                                "label": "None",
                                "value": 0
                            },
                            {
                                "label": "Low",
                                "value": 1
                            },
                            {
                                "label": "Medium",
                                "value": 2
                            },
                            {
                                "label": "High",
                                "value": 3
                            }
                        ]
                    },
                    "status": {
                        "type": "select",
                        "label": "Status",
                        "tooltip": "Status of the task.",
                        "index": 7,
                        "options": [
                            {
                                "label": "Open",
                                "value": 0
                            },
                            {
                                "label": "Completed",
                                "value": 1
                            }
                        ]
                    },
                    "owner_id": {
                        "type": "number",
                        "label": "Owner ID",
                        "tooltip": "User ID of the task owner.",
                        "index": 8
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "ID",
                    "value": "id",
                    "schema": {
                        "type": "integer",
                        "example": 1
                    }
                },
                {
                    "label": "Title",
                    "value": "title",
                    "schema": {
                        "type": "string",
                        "example": "Follow up with Jane"
                    }
                },
                {
                    "label": "Description",
                    "value": "description",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "Do a follow-up call with Jane."
                    }
                },
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "integer",
                        "example": 0
                    }
                },
                {
                    "label": "Due Date",
                    "value": "due_date",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time",
                        "example": "2024-03-21T11:00:00Z"
                    }
                },
                {
                    "label": "Completed Date",
                    "value": "completed_date",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time",
                        "example": null
                    }
                },
                {
                    "label": "Task Type ID",
                    "value": "task_type_id",
                    "schema": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "example": 2
                    }
                },
                {
                    "label": "Owner ID",
                    "value": "owner_id",
                    "schema": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "example": 1
                    }
                },
                {
                    "label": "Outcome ID",
                    "value": "outcome_id",
                    "schema": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "example": null
                    }
                },
                {
                    "label": "Creator ID",
                    "value": "creater_id",
                    "schema": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "example": 1
                    }
                },
                {
                    "label": "Updater ID",
                    "value": "updater_id",
                    "schema": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "example": 1
                    }
                },
                {
                    "label": "Is LinkedIn Type",
                    "value": "is_linkedin_type",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Has Multiple Emails",
                    "value": "has_multiple_emails",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Targetables",
                    "value": "targetables",
                    "schema": {
                        "type": "array",
                        "example": [
                            {
                                "type": "contact",
                                "id": 1
                            }
                        ]
                    }
                },
                {
                    "label": "Targetables With Email",
                    "value": "targetables_with_email",
                    "schema": {
                        "type": "array",
                        "example": [
                            {
                                "type": "contact",
                                "id": 1,
                                "email": "jane.doe@example.com"
                            }
                        ]
                    }
                },
                {
                    "label": "User IDs",
                    "value": "user_ids",
                    "schema": {
                        "type": "array",
                        "example": [
                            2
                        ]
                    }
                },
                {
                    "label": "Targetable",
                    "value": "targetable",
                    "schema": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "example": {
                            "type": "contact",
                            "id": 1
                        }
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2024-03-14T03:56:22Z"
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updated_at",
                    "schema": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2024-03-14T04:03:16Z"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}