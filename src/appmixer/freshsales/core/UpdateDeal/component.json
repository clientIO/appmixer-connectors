{
    "name": "appmixer.freshsales.core.UpdateDeal",
    "description": "Update an existing deal by ID.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:freshsales"
    },
    "quota": {
        "manager": "appmixer:freshsales",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "amount": {
                        "type": "number"
                    },
                    "currency_code": {
                        "type": "string"
                    },
                    "expected_close": {
                        "type": "string",
                        "format": "date"
                    },
                    "deal_stage_id": {
                        "type": "integer"
                    },
                    "deal_pipeline_id": {
                        "type": "integer"
                    },
                    "probability": {
                        "type": "integer"
                    },
                    "owner_id": {
                        "type": "integer"
                    },
                    "contacts_added_list": {
                        "type": "string"
                    },
                    "contacts_removed_list": {
                        "type": "string"
                    }
                },
                "required": [
                    "id"
                ]
            },
            "inspector": {
                "inputs": {
                    "id": {
                        "type": "number",
                        "label": "Deal ID",
                        "tooltip": "The ID of the deal to update.",
                        "index": 1
                    },
                    "name": {
                        "type": "text",
                        "label": "Deal Name",
                        "tooltip": "Name of the deal.",
                        "index": 2
                    },
                    "amount": {
                        "type": "number",
                        "label": "Amount",
                        "tooltip": "Value of the deal.",
                        "index": 3
                    },
                    "currency_code": {
                        "type": "text",
                        "label": "Currency Code",
                        "tooltip": "Currency code (e.g. USD).",
                        "index": 4
                    },
                    "expected_close": {
                        "type": "date-time",
                        "label": "Expected Close",
                        "tooltip": "Expected close date.",
                        "config": {
                            "enableTime": false
                        },
                        "index": 5
                    },
                    "deal_stage_id": {
                        "type": "number",
                        "label": "Stage ID",
                        "tooltip": "Pipeline stage ID.",
                        "index": 6
                    },
                    "deal_pipeline_id": {
                        "type": "number",
                        "label": "Pipeline ID",
                        "tooltip": "Deal pipeline ID.",
                        "index": 7
                    },
                    "probability": {
                        "type": "number",
                        "label": "Probability",
                        "tooltip": "Win probability percentage (0-100).",
                        "index": 8
                    },
                    "owner_id": {
                        "type": "number",
                        "label": "Owner ID",
                        "tooltip": "Owner/agent user ID.",
                        "index": 9
                    },
                    "contacts_added_list": {
                        "type": "text",
                        "label": "Add Contact IDs",
                        "tooltip": "Comma-separated contact IDs to associate with the deal.",
                        "index": 10
                    },
                    "contacts_removed_list": {
                        "type": "text",
                        "label": "Remove Contact IDs",
                        "tooltip": "Comma-separated contact IDs to disassociate from the deal.",
                        "index": 11
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Deal ID",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "title": "Deal Name",
                        "example": "Acme Corp - Annual Plan"
                    },
                    "amount": {
                        "type": "string",
                        "title": "Amount",
                        "example": "23456.0"
                    },
                    "base_currency_amount": {
                        "type": "string",
                        "title": "Base Currency Amount",
                        "example": "23456.0"
                    },
                    "currency_code": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Currency Code",
                        "example": "USD"
                    },
                    "expected_close": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Expected Close",
                        "example": "2024-06-30"
                    },
                    "closed_date": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Closed Date",
                        "example": null
                    },
                    "stage_updated_time": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Stage Updated Time",
                        "example": "2024-03-12T10:00:00Z"
                    },
                    "deal_pipeline_id": {
                        "type": "integer",
                        "title": "Pipeline ID",
                        "example": 1
                    },
                    "deal_stage_id": {
                        "type": "integer",
                        "title": "Stage ID",
                        "example": 2
                    },
                    "probability": {
                        "type": "integer",
                        "title": "Probability",
                        "example": 10
                    },
                    "expected_deal_value": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Expected Deal Value",
                        "example": "2345.6"
                    },
                    "age": {
                        "type": "integer",
                        "title": "Age (days)",
                        "example": 2
                    },
                    "owner_id": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "title": "Owner ID",
                        "example": 1
                    },
                    "updater_id": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "title": "Updater ID",
                        "example": 1
                    },
                    "creater_id": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "title": "Creater ID",
                        "example": 1
                    },
                    "created_at": {
                        "type": "string",
                        "title": "Created At",
                        "example": "2024-03-12T10:00:00Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "title": "Updated At",
                        "example": "2024-03-14T10:30:00Z"
                    },
                    "tags": {
                        "type": "array",
                        "title": "Tags",
                        "example": [
                            "enterprise"
                        ]
                    },
                    "is_deleted": {
                        "type": "boolean",
                        "title": "Is Deleted",
                        "example": false
                    },
                    "has_products": {
                        "type": "boolean",
                        "title": "Has Products",
                        "example": false
                    },
                    "products": {
                        "type": "array",
                        "title": "Products",
                        "example": []
                    },
                    "team_user_ids": {
                        "type": "array",
                        "title": "Team User IDs",
                        "example": [
                            2
                        ]
                    },
                    "deal_price_adjustments": {
                        "type": "array",
                        "title": "Deal Price Adjustments",
                        "example": []
                    },
                    "custom_field": {
                        "type": "object",
                        "title": "Custom Fields",
                        "example": {
                            "cf_number_of_agents": 45
                        }
                    },
                    "rotten_days": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "title": "Rotten Days",
                        "example": null
                    },
                    "avatar": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Avatar",
                        "example": null
                    },
                    "web_form_id": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "title": "Web Form ID",
                        "example": null
                    },
                    "recent_note": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Recent Note",
                        "example": "Sent the pricing quote."
                    },
                    "last_assigned_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Last Assigned At",
                        "example": "2024-03-12T10:00:00Z"
                    },
                    "last_contacted_sales_activity_mode": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Last Contacted Sales Activity Mode",
                        "example": "Call"
                    },
                    "last_contacted_via_sales_activity": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Last Contacted Via Sales Activity",
                        "example": "2024-03-13T15:00:00Z"
                    },
                    "upcoming_activities_time": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Upcoming Activities Time",
                        "example": "2024-03-20T09:00:00Z"
                    },
                    "completed_sales_sequences": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Completed Sales Sequences",
                        "example": null
                    },
                    "active_sales_sequences": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Active Sales Sequences",
                        "example": null
                    },
                    "collaboration": {
                        "type": "object",
                        "title": "Collaboration",
                        "example": {}
                    }
                }
            }
        }
    ],
    "icon": "data:image/png;base64,"
}