{
    "name": "appmixer.replicate.core.GetModel",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieves detailed information about a specific model.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:replicate"
    },
    "quota": {
        "manager": "appmixer:replicate",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "modelOwner": {
                        "type": "string"
                    },
                    "modelName": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "modelOwner": {
                        "type": "text",
                        "tooltip": "The owner of the model.",
                        "label": "Model Owner",
                        "index": 0
                    },
                    "modelName": {
                        "type": "text",
                        "tooltip": "The name of the model.",
                        "label": "Model Name",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Model Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "sdxl"
                    }
                },
                {
                    "label": "Model Owner",
                    "value": "owner",
                    "schema": {
                        "type": "string",
                        "example": "stability-ai"
                    }
                },
                {
                    "label": "Description",
                    "value": "description",
                    "schema": {
                        "type": "string",
                        "example": "A text-to-image generative AI model that creates beautiful images"
                    }
                },
                {
                    "label": "Cover Image Url",
                    "value": "cover_image_url",
                    "schema": {
                        "type": "string",
                        "example": "https://replicate.delivery/pbxt/abc123/cover.png"
                    }
                },
                {
                    "label": "Url",
                    "value": "url",
                    "schema": {
                        "type": "string",
                        "example": "https://replicate.com/stability-ai/sdxl"
                    }
                },
                {
                    "label": "Run Count",
                    "value": "run_count",
                    "schema": {
                        "type": "number",
                        "example": 1500000
                    }
                },
                {
                    "label": "Latest Version",
                    "value": "latest_version",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Latest Version.Id",
                                "example": "a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2"
                            }
                        },
                        "example": {
                            "id": "39ed52f2a78e934b3ba6e2a89f5b1c712de7dfea535525255b1aa35c5565e08b",
                            "created_at": "2023-07-26T17:01:26.066941Z",
                            "cog_version": "0.8.1"
                        }
                    }
                },
                {
                    "label": "Default Example",
                    "value": "default_example",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "input": {
                                "type": "object",
                                "properties": {
                                    "text": {
                                        "type": "string",
                                        "title": "Default Example.Input.Text",
                                        "example": "An astronaut riding a horse"
                                    }
                                },
                                "title": "Default Example.Input"
                            },
                            "output": {
                                "type": "string",
                                "title": "Default Example.Output",
                                "example": "https://replicate.delivery/pbxt/abc123/output.png"
                            }
                        },
                        "example": {
                            "id": "vu42q7dbkm6iicbpal4v6uvbqm",
                            "model": "stability-ai/sdxl",
                            "status": "succeeded",
                            "input": {
                                "prompt": "An astronaut riding a rainbow unicorn, cinematic, dramatic"
                            },
                            "output": [
                                "https://replicate.delivery/pbxt/abc123/out-0.png"
                            ]
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}