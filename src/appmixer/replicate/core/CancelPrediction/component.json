{
    "name": "appmixer.replicate.core.CancelPrediction",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Cancels a running prediction.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:replicate"
    },
    "quota": {
        "manager": "appmixer:replicate",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "predictionId": {
                        "type": "string"
                    }
                },
                "required": ["predictionId"]
            },
            "inspector": {
                "inputs": {
                    "predictionId": {
                        "type": "text",
                        "tooltip": "The unique identifier of the prediction to cancel.",
                        "label": "Prediction Id",
                        "index": 0
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Completed At",
                    "value": "completed_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-03-01T12:05:30.000Z"
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-03-01T12:00:00.000Z"
                    }
                },
                {
                    "label": "Data Removed",
                    "value": "data_removed",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Error",
                    "value": "error",
                    "schema": {
                        "type": "string",
                        "example": "Prediction was cancelled"
                    }
                },
                {
                    "label": "Prediction Id",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "abcd1234efgh5678"
                    }
                },
                {
                    "label": "Input",
                    "value": "input",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "prompt": {
                                "type": "string",
                                "title": "Input.Prompt",
                                "example": "A photo of a mountain landscape"
                            }
                        },
                        "example": {
                            "prompt": "An astronaut riding a horse on the moon"
                        }
                    }
                },
                {
                    "label": "Is Free Trial Prediction",
                    "value": "is_free_trial_prediction",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Logs",
                    "value": "logs",
                    "schema": {
                        "type": "string",
                        "example": "Using seed: 12345\nRunning prediction..."
                    }
                },
                {
                    "label": "Metrics",
                    "value": "metrics",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "predict_time": {
                                "type": "number",
                                "title": "Metrics.Predict Time",
                                "example": 3.45
                            },
                            "total_time": {
                                "type": "number",
                                "title": "Metrics.Total Time",
                                "example": 5.12
                            }
                        },
                        "example": {
                            "predict_time": 2.13
                        }
                    }
                },
                {
                    "label": "Model",
                    "value": "model",
                    "schema": {
                        "type": "string",
                        "example": "stability-ai/sdxl"
                    }
                },
                {
                    "label": "Output",
                    "value": "output",
                    "schema": {
                        "type": "string",
                        "example": "https://replicate.delivery/pbxt/abc123/output.png"
                    }
                },
                {
                    "label": "Started At",
                    "value": "started_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-03-01T12:00:01.000Z"
                    }
                },
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "string",
                        "example": "canceled"
                    }
                },
                {
                    "label": "Urls",
                    "value": "urls",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "stream": {
                                "type": "string",
                                "title": "Urls.Stream",
                                "example": "https://streaming.api.replicate.com/v1/predictions/abcd1234"
                            },
                            "get": {
                                "type": "string",
                                "title": "Urls.Get",
                                "example": "https://api.replicate.com/v1/predictions/abcd1234"
                            },
                            "cancel": {
                                "type": "string",
                                "title": "Urls.Cancel",
                                "example": "https://api.replicate.com/v1/predictions/abcd1234/cancel"
                            },
                            "web": {
                                "type": "string",
                                "title": "Urls.Web",
                                "example": "https://replicate.com/p/abcd1234"
                            }
                        },
                        "example": {
                            "get": "https://api.replicate.com/v1/predictions/abcd1234efgh5678",
                            "cancel": "https://api.replicate.com/v1/predictions/abcd1234efgh5678/cancel"
                        }
                    }
                },
                {
                    "label": "Version",
                    "value": "version",
                    "schema": {
                        "type": "string",
                        "example": "a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}