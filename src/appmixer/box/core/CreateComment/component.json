{
    "name": "appmixer.box.core.CreateComment",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Creates a new comment on a file.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:box"
    },
    "quota": {
        "manager": "appmixer:box",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "itemType": {
                        "type": "string",
                        "default": "file"
                    },
                    "itemId": {
                        "type": "string"
                    },
                    "message": {
                        "type": "string"
                    },
                    "taggedMessage": {
                        "type": "string"
                    }
                },
                "required": [
                    "itemId"
                ]
            },
            "inspector": {
                "inputs": {
                    "itemType": {
                        "type": "select",
                        "tooltip": "Type of item to comment on.",
                        "label": "Item Type",
                        "index": 1,
                        "defaultValue": "file",
                        "options": [
                            {
                                "label": "File",
                                "value": "file"
                            }
                        ]
                    },
                    "itemId": {
                        "type": "text",
                        "tooltip": "The ID of the file.",
                        "label": "Item ID",
                        "index": 2
                    },
                    "message": {
                        "type": "textarea",
                        "tooltip": "Plain text of the comment. Either message or tagged message is required.",
                        "label": "Message",
                        "index": 3
                    },
                    "taggedMessage": {
                        "type": "textarea",
                        "tooltip": "Alternative to message. Allows @mentions using @[name:#user_id].",
                        "label": "Tagged Message",
                        "index": 4
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Type",
                    "value": "type",
                    "schema": {
                        "type": "string",
                        "example": "comment"
                    }
                },
                {
                    "label": "Comment ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "123456789"
                    }
                },
                {
                    "label": "Message",
                    "value": "message",
                    "schema": {
                        "type": "string",
                        "example": "Looks good to me!"
                    }
                },
                {
                    "label": "Created By",
                    "value": "created_by",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "type": {
                                "type": "string",
                                "title": "Created By.Type",
                                "example": "comment"
                            },
                            "id": {
                                "type": "string",
                                "title": "Created By.Id",
                                "example": "123456789"
                            },
                            "name": {
                                "type": "string",
                                "title": "Created By.Name",
                                "example": "Documents"
                            }
                        },
                        "example": {
                            "type": "comment",
                            "id": "123456789",
                            "name": "Documents"
                        }
                    }
                },
                {
                    "label": "Item",
                    "value": "item",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "type": {
                                "type": "string",
                                "title": "Item.Type",
                                "example": "comment"
                            },
                            "id": {
                                "type": "string",
                                "title": "Item.Id",
                                "example": "123456789"
                            },
                            "name": {
                                "type": "string",
                                "title": "Item.Name",
                                "example": "Documents"
                            }
                        },
                        "example": {
                            "type": "comment",
                            "id": "123456789",
                            "name": "Documents"
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
