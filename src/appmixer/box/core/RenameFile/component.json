{
    "name": "appmixer.box.core.RenameFile",
    "description": "Rename a file by its ID.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:box"
    },
    "quota": {
        "manager": "appmixer:box",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "fileId": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "ifMatch": {
                        "type": "string"
                    }
                },
                "required": [
                    "fileId",
                    "name"
                ]
            },
            "inspector": {
                "inputs": {
                    "fileId": {
                        "type": "text",
                        "index": 1,
                        "label": "File ID",
                        "tooltip": "The ID of the file to rename."
                    },
                    "name": {
                        "type": "text",
                        "index": 2,
                        "label": "Name",
                        "tooltip": "The new file name (must include extension)."
                    },
                    "ifMatch": {
                        "type": "text",
                        "index": 3,
                        "label": "If Match",
                        "tooltip": "Optional ETag to prevent race conditions. Sent as If-Match header."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "File ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "123456789"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "quarterly-report.pdf"
                    }
                },
                {
                    "label": "Type",
                    "value": "type",
                    "schema": {
                        "type": "string",
                        "example": "file"
                    }
                },
                {
                    "label": "Size",
                    "value": "size",
                    "schema": {
                        "type": "number",
                        "example": 1048576
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-01-15T10:30:00-08:00"
                    }
                },
                {
                    "label": "Modified At",
                    "value": "modified_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-02-20T14:45:00-08:00"
                    }
                },
                {
                    "label": "Etag",
                    "value": "etag",
                    "schema": {
                        "type": "string",
                        "example": "3"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
