{
    "name": "appmixer.box.core.CopyFolder",
    "description": "Creates a copy of an existing folder to a destination parent folder.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:box"
    },
    "quota": {
        "manager": "appmixer:box",
        "resources": "requests",
        "scope": {
            "userId": ""
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "folderId": {
                        "type": "string"
                    },
                    "parentId": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    }
                },
                "required": [
                    "folderId",
                    "parentId"
                ]
            },
            "inspector": {
                "inputs": {
                    "folderId": {
                        "type": "text",
                        "label": "Folder ID",
                        "tooltip": "The ID of the folder to copy.",
                        "index": 1
                    },
                    "parentId": {
                        "type": "text",
                        "label": "Parent Folder ID",
                        "tooltip": "Destination parent folder ID.",
                        "index": 2
                    },
                    "name": {
                        "type": "text",
                        "label": "Name",
                        "tooltip": "Optional new name for the copied folder.",
                        "index": 3
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Type",
                    "value": "type",
                    "schema": {
                        "type": "string",
                        "example": "folder"
                    }
                },
                {
                    "label": "Folder ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "123456789"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Documents"
                    }
                },
                {
                    "label": "Parent",
                    "value": "parent",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "type": {
                                "type": "string",
                                "title": "Parent.Type",
                                "example": "folder"
                            },
                            "id": {
                                "type": "string",
                                "title": "Parent.Id",
                                "example": "123456789"
                            },
                            "name": {
                                "type": "string",
                                "title": "Parent.Name",
                                "example": "Documents"
                            }
                        },
                        "example": {
                            "type": "folder",
                            "id": "123456789",
                            "name": "Documents"
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
