{
    "name": "appmixer.box.core.AddSharedLinkToFolder",
    "description": "Adds or updates a shared link on a folder.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:box"
    },
    "quota": {
        "manager": "appmixer:box",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "folderId": {
                        "type": "string"
                    },
                    "access": {
                        "type": "string"
                    },
                    "password": {
                        "type": "string"
                    },
                    "unsharedAt": {
                        "type": "string"
                    },
                    "canDownload": {
                        "type": "boolean"
                    },
                    "canPreview": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "folderId"
                ]
            },
            "inspector": {
                "inputs": {
                    "folderId": {
                        "type": "text",
                        "label": "Folder ID",
                        "tooltip": "The ID of the folder to set a shared link on.",
                        "index": 1
                    },
                    "access": {
                        "type": "select",
                        "label": "Access Level",
                        "tooltip": "The level of access for the shared link.",
                        "index": 2,
                        "options": [
                            {
                                "label": "Open (anyone with the link)",
                                "value": "open"
                            },
                            {
                                "label": "Company (only people within your company)",
                                "value": "company"
                            },
                            {
                                "label": "Collaborators (only collaborators)",
                                "value": "collaborators"
                            }
                        ]
                    },
                    "password": {
                        "type": "text",
                        "label": "Password",
                        "tooltip": "Optional password to protect the shared link.",
                        "index": 3
                    },
                    "unsharedAt": {
                        "type": "text",
                        "label": "Unshared At",
                        "tooltip": "ISO 8601 date-time when the link should be disabled (e.g., 2025-12-31T23:59:59Z).",
                        "index": 4
                    },
                    "canDownload": {
                        "type": "toggle",
                        "label": "Can Download",
                        "tooltip": "Allow downloads through the shared link.",
                        "index": 5
                    },
                    "canPreview": {
                        "type": "toggle",
                        "label": "Can Preview",
                        "tooltip": "Allow previews through the shared link.",
                        "index": 6
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Type",
                    "value": "type",
                    "schema": {
                        "type": "string",
                        "example": "folder"
                    }
                },
                {
                    "label": "ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "123456789"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Documents"
                    }
                },
                {
                    "label": "Shared Link URL",
                    "value": "shared_link.url",
                    "schema": {
                        "type": "string",
                        "example": "https://app.box.com/s/abc123xyz"
                    }
                },
                {
                    "label": "Shared Link Access",
                    "value": "shared_link.access",
                    "schema": {
                        "type": "string",
                        "example": "open"
                    }
                },
                {
                    "label": "Shared Link Download URL",
                    "value": "shared_link.download_url",
                    "schema": {
                        "type": "string",
                        "example": "https://app.box.com/s/abc123xyz"
                    }
                },
                {
                    "label": "Shared Link Can Download",
                    "value": "shared_link.permissions.can_download",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Shared Link Can Preview",
                    "value": "shared_link.permissions.can_preview",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Shared Link",
                    "value": "shared_link",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "access": {
                                "type": "string",
                                "title": "Shared Link.Access",
                                "example": "open"
                            },
                            "url": {
                                "type": "string",
                                "title": "Shared Link.Url",
                                "example": "https://app.box.com/s/abc123xyz"
                            },
                            "download_url": {
                                "type": "string",
                                "title": "Shared Link.Download Url",
                                "example": "https://app.box.com/s/abc123xyz"
                            },
                            "permissions": {
                                "type": "object",
                                "properties": {
                                    "can_download": {
                                        "type": "boolean",
                                        "title": "Shared Link.Permissions.Can Download",
                                        "example": false
                                    },
                                    "can_preview": {
                                        "type": "boolean",
                                        "title": "Shared Link.Permissions.Can Preview",
                                        "example": false
                                    }
                                },
                                "title": "Shared Link.Permissions"
                            }
                        },
                        "example": {
                            "access": "open",
                            "url": "https://app.box.com/s/abc123xyz",
                            "download_url": "https://app.box.com/s/abc123xyz",
                            "permissions": {
                                "can_download": false,
                                "can_preview": false
                            }
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
