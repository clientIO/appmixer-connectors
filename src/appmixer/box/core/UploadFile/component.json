{
    "name": "appmixer.box.core.UploadFile",
    "description": "Upload a file to a specified folder in Box. Maximum file size is 50MB. If a file with the same name already exists in the target folder, a 409 Conflict error will be thrown.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:box"
    },
    "quota": {
        "manager": "appmixer:box",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "fileId": {
                        "type": "string"
                    },
                    "parentId": {
                        "type": "string"
                    },
                    "fileName": {
                        "type": "string"
                    }
                },
                "required": [
                    "fileId"
                ]
            },
            "inspector": {
                "inputs": {
                    "fileId": {
                        "type": "filepicker",
                        "label": "File",
                        "tooltip": "Select an existing file or upload a new file from your computer.",
                        "index": 1
                    },
                    "parentId": {
                        "type": "text",
                        "label": "Parent Folder ID",
                        "tooltip": "The parent folder ID where the file will be uploaded. If not specified, the file will be uploaded to the root directory.",
                        "index": 2
                    },
                    "fileName": {
                        "type": "text",
                        "label": "File Name",
                        "tooltip": "Optional new file name (including extension). Defaults to original filename.",
                        "index": 3
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Entries",
                    "value": "entries",
                    "schema": {
                        "type": "array",
                        "example": [
                            {
                                "type": "file",
                                "id": "123456789",
                                "name": "report.txt"
                            }
                        ],
                        "items": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "title": "Entries.Type",
                                    "example": "file"
                                },
                                "id": {
                                    "type": "string",
                                    "title": "Entries.ID",
                                    "example": "123456789"
                                },
                                "name": {
                                    "type": "string",
                                    "title": "Entries.Name",
                                    "example": "report.txt"
                                }
                            }
                        }
                    }
                },
                {
                    "label": "ID",
                    "value": "entries.0.id",
                    "schema": {
                        "type": "string",
                        "example": "987654321"
                    }
                },
                {
                    "label": "Name",
                    "value": "entries.0.name",
                    "schema": {
                        "type": "string",
                        "example": "annual-report.pdf"
                    }
                },
                {
                    "label": "Size",
                    "value": "entries.0.size",
                    "schema": {
                        "type": "number",
                        "example": 2048000
                    }
                },
                {
                    "label": "Type",
                    "value": "entries.0.type",
                    "schema": {
                        "type": "string",
                        "example": "file"
                    }
                },
                {
                    "label": "Parent Folder ID",
                    "value": "entries.0.parent.id",
                    "schema": {
                        "type": "string",
                        "example": "0"
                    }
                },
                {
                    "label": "Parent Folder Name",
                    "value": "entries.0.parent.name",
                    "schema": {
                        "type": "string",
                        "example": "All Files"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
