{
    "name": "appmixer.box.core.GetFolder",
    "label": "Get Folder",
    "description": "Retrieve information about a specific folder, including the first 100 items in item_collection.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:box"
    },
    "quota": {
        "manager": "appmixer:box",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "folderId": {
                        "type": "string"
                    },
                    "fields": {
                        "type": "string"
                    }
                },
                "required": [
                    "folderId"
                ]
            },
            "inspector": {
                "inputs": {
                    "folderId": {
                        "type": "text",
                        "index": 1,
                        "label": "Folder ID",
                        "tooltip": "The unique identifier of the folder to retrieve"
                    },
                    "fields": {
                        "type": "text",
                        "index": 2,
                        "label": "Fields",
                        "tooltip": "Comma-separated list of fields to include in the response (e.g., id,name,type,created_at,modified_at)"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Type",
                    "value": "type",
                    "schema": {
                        "type": "string",
                        "example": "folder"
                    }
                },
                {
                    "label": "Folder ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "123456789"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Documents"
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-01-15T10:30:00-08:00"
                    }
                },
                {
                    "label": "Modified At",
                    "value": "modified_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-01-15T10:30:00-08:00"
                    }
                },
                {
                    "label": "Item Collection",
                    "value": "item_collection",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "total_count": {
                                "type": "number",
                                "title": "Item Collection.Total Count",
                                "example": 3
                            },
                            "entries": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "type": {
                                            "type": "string",
                                            "title": "Item Collection.Entries.Type",
                                            "example": "folder"
                                        },
                                        "id": {
                                            "type": "string",
                                            "title": "Item Collection.Entries.Id",
                                            "example": "123456789"
                                        },
                                        "name": {
                                            "type": "string",
                                            "title": "Item Collection.Entries.Name",
                                            "example": "Documents"
                                        }
                                    }
                                },
                                "title": "Item Collection.Entries"
                            },
                            "limit": {
                                "type": "number",
                                "title": "Item Collection.Limit",
                                "example": 42
                            },
                            "offset": {
                                "type": "number",
                                "title": "Item Collection.Offset",
                                "example": 42
                            }
                        },
                        "example": {
                            "total_count": 3,
                            "entries": [
                                {
                                    "type": "folder",
                                    "id": "123456789",
                                    "name": "Documents"
                                }
                            ],
                            "limit": 42,
                            "offset": 42
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
