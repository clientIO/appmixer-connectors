{
    "name": "appmixer.box.core.AddSharedLinkToFile",
    "description": "Add or update a shared link on a file. Configure access levels, passwords, expiration dates, and download/preview permissions.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:box"
    },
    "quota": {
        "manager": "appmixer:box",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "fileId": {
                        "type": "string"
                    },
                    "access": {
                        "type": "string"
                    },
                    "password": {
                        "type": "string"
                    },
                    "unsharedAt": {
                        "type": "string"
                    },
                    "canDownload": {
                        "type": "boolean"
                    },
                    "canPreview": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "fileId"
                ]
            },
            "inspector": {
                "inputs": {
                    "fileId": {
                        "type": "text",
                        "label": "File ID",
                        "tooltip": "The ID of the file to set a shared link on.",
                        "index": 1
                    },
                    "access": {
                        "type": "select",
                        "label": "Access Level",
                        "tooltip": "The level of access for the shared link.",
                        "index": 2,
                        "options": [
                            {
                                "label": "Open (Anyone with the link)",
                                "value": "open"
                            },
                            {
                                "label": "Company (Only people in your company)",
                                "value": "company"
                            },
                            {
                                "label": "Collaborators (Only people with access to the folder)",
                                "value": "collaborators"
                            }
                        ]
                    },
                    "password": {
                        "type": "text",
                        "label": "Password",
                        "tooltip": "The password required to access the shared link. Leave empty for no password.",
                        "index": 3
                    },
                    "unsharedAt": {
                        "type": "text",
                        "label": "Unshared At",
                        "tooltip": "The date-time when the shared link will be automatically disabled (ISO 8601 format, e.g., 2024-12-31T23:59:59Z). Leave empty for no expiration.",
                        "index": 4
                    },
                    "canDownload": {
                        "type": "toggle",
                        "label": "Can Download",
                        "tooltip": "If the shared link allows for downloading of files. This can only be set when access is set to open or company.\n\n",
                        "index": 5
                    },
                    "canPreview": {
                        "type": "toggle",
                        "label": "Can Preview",
                        "tooltip": "Allow users to preview the file through the shared link.",
                        "index": 6
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Type",
                    "value": "type",
                    "schema": {
                        "type": "string",
                        "example": "file"
                    }
                },
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "123456789"
                    }
                },
                {
                    "label": "File Version",
                    "value": "file_version",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "type": {
                                "type": "string",
                                "title": "File Version.Type",
                                "example": "file"
                            },
                            "id": {
                                "type": "string",
                                "title": "File Version.Id",
                                "example": "123456789"
                            },
                            "sha1": {
                                "type": "string",
                                "title": "File Version.Sha1",
                                "example": "example"
                            }
                        },
                        "example": {
                            "type": "file",
                            "id": "123456789",
                            "sha1": "example"
                        }
                    }
                },
                {
                    "label": "Sequence Id",
                    "value": "sequence_id",
                    "schema": {
                        "type": "string",
                        "example": "123456789"
                    }
                },
                {
                    "label": "Etag",
                    "value": "etag",
                    "schema": {
                        "type": "string",
                        "example": "1"
                    }
                },
                {
                    "label": "Sha1",
                    "value": "sha1",
                    "schema": {
                        "type": "string",
                        "example": "example"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Documents"
                    }
                },
                {
                    "label": "Description",
                    "value": "description",
                    "schema": {
                        "type": "string",
                        "example": "Team documents"
                    }
                },
                {
                    "label": "Size",
                    "value": "size",
                    "schema": {
                        "type": "number",
                        "example": 1048576
                    }
                },
                {
                    "label": "Path Collection",
                    "value": "path_collection",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "total_count": {
                                "type": "number",
                                "title": "Path Collection.Total Count",
                                "example": 3
                            },
                            "entries": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "type": {
                                            "type": "string",
                                            "title": "Path Collection.Entries.Type",
                                            "example": "file"
                                        },
                                        "id": {
                                            "type": "string",
                                            "title": "Path Collection.Entries.Id",
                                            "example": "123456789"
                                        },
                                        "sequence_id": {
                                            "type": "null",
                                            "title": "Path Collection.Entries.Sequence Id"
                                        },
                                        "etag": {
                                            "type": "null",
                                            "title": "Path Collection.Entries.Etag"
                                        },
                                        "name": {
                                            "type": "string",
                                            "title": "Path Collection.Entries.Name",
                                            "example": "Documents"
                                        }
                                    }
                                },
                                "title": "Path Collection.Entries"
                            }
                        },
                        "example": {
                            "total_count": 3,
                            "entries": [
                                {
                                    "type": "file",
                                    "id": "123456789",
                                    "sequence_id": null,
                                    "etag": null,
                                    "name": "Documents"
                                }
                            ]
                        }
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-01-15T10:30:00-08:00"
                    }
                },
                {
                    "label": "Modified At",
                    "value": "modified_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-01-15T10:30:00-08:00"
                    }
                },
                {
                    "label": "Trashed At",
                    "value": "trashed_at",
                    "schema": {
                        "type": "null",
                        "example": null
                    }
                },
                {
                    "label": "Purged At",
                    "value": "purged_at",
                    "schema": {
                        "type": "null",
                        "example": null
                    }
                },
                {
                    "label": "Content Created At",
                    "value": "content_created_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-01-15T10:30:00-08:00"
                    }
                },
                {
                    "label": "Content Modified At",
                    "value": "content_modified_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-01-15T10:30:00-08:00"
                    }
                },
                {
                    "label": "Created By",
                    "value": "created_by",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "type": {
                                "type": "string",
                                "title": "Created By.Type",
                                "example": "file"
                            },
                            "id": {
                                "type": "string",
                                "title": "Created By.Id",
                                "example": "123456789"
                            },
                            "name": {
                                "type": "string",
                                "title": "Created By.Name",
                                "example": "Documents"
                            },
                            "login": {
                                "type": "string",
                                "title": "Created By.Login",
                                "example": "user@example.com"
                            }
                        },
                        "example": {
                            "type": "file",
                            "id": "123456789",
                            "name": "Documents",
                            "login": "user@example.com"
                        }
                    }
                },
                {
                    "label": "Modified By",
                    "value": "modified_by",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "type": {
                                "type": "string",
                                "title": "Modified By.Type",
                                "example": "file"
                            },
                            "id": {
                                "type": "string",
                                "title": "Modified By.Id",
                                "example": "123456789"
                            },
                            "name": {
                                "type": "string",
                                "title": "Modified By.Name",
                                "example": "Documents"
                            },
                            "login": {
                                "type": "string",
                                "title": "Modified By.Login",
                                "example": "user@example.com"
                            }
                        },
                        "example": {
                            "type": "file",
                            "id": "123456789",
                            "name": "Documents",
                            "login": "user@example.com"
                        }
                    }
                },
                {
                    "label": "Owned By",
                    "value": "owned_by",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "type": {
                                "type": "string",
                                "title": "Owned By.Type",
                                "example": "file"
                            },
                            "id": {
                                "type": "string",
                                "title": "Owned By.Id",
                                "example": "123456789"
                            },
                            "name": {
                                "type": "string",
                                "title": "Owned By.Name",
                                "example": "Documents"
                            },
                            "login": {
                                "type": "string",
                                "title": "Owned By.Login",
                                "example": "user@example.com"
                            }
                        },
                        "example": {
                            "type": "file",
                            "id": "123456789",
                            "name": "Documents",
                            "login": "user@example.com"
                        }
                    }
                },
                {
                    "label": "Shared Link",
                    "value": "shared_link",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "url": {
                                "type": "string",
                                "title": "Shared Link.Url",
                                "example": "https://app.box.com/s/abc123xyz"
                            },
                            "download_url": {
                                "type": "string",
                                "title": "Shared Link.Download Url",
                                "example": "https://app.box.com/s/abc123xyz"
                            },
                            "vanity_url": {
                                "type": "null",
                                "title": "Shared Link.Vanity Url"
                            },
                            "vanity_name": {
                                "type": "null",
                                "title": "Shared Link.Vanity Name"
                            },
                            "effective_access": {
                                "type": "string",
                                "title": "Shared Link.Effective Access",
                                "example": "open"
                            },
                            "effective_permission": {
                                "type": "string",
                                "title": "Shared Link.Effective Permission",
                                "example": "can_download"
                            },
                            "is_password_enabled": {
                                "type": "boolean",
                                "title": "Shared Link.Is Password Enabled",
                                "example": false
                            },
                            "unshared_at": {
                                "type": "null",
                                "title": "Shared Link.Unshared At"
                            },
                            "download_count": {
                                "type": "number",
                                "title": "Shared Link.Download Count",
                                "example": 3
                            },
                            "preview_count": {
                                "type": "number",
                                "title": "Shared Link.Preview Count",
                                "example": 3
                            },
                            "access": {
                                "type": "string",
                                "title": "Shared Link.Access",
                                "example": "open"
                            },
                            "permissions": {
                                "type": "object",
                                "properties": {
                                    "can_preview": {
                                        "type": "boolean",
                                        "title": "Shared Link.Permissions.Can Preview",
                                        "example": false
                                    },
                                    "can_download": {
                                        "type": "boolean",
                                        "title": "Shared Link.Permissions.Can Download",
                                        "example": false
                                    },
                                    "can_edit": {
                                        "type": "boolean",
                                        "title": "Shared Link.Permissions.Can Edit",
                                        "example": false
                                    }
                                },
                                "title": "Shared Link.Permissions"
                            }
                        },
                        "example": {
                            "url": "https://app.box.com/s/abc123xyz",
                            "download_url": "https://app.box.com/s/abc123xyz",
                            "vanity_url": null,
                            "vanity_name": null,
                            "effective_access": "open",
                            "effective_permission": "can_download",
                            "is_password_enabled": false,
                            "unshared_at": null,
                            "download_count": 3,
                            "preview_count": 3,
                            "access": "open",
                            "permissions": {
                                "can_preview": false,
                                "can_download": false,
                                "can_edit": false
                            }
                        }
                    }
                },
                {
                    "label": "Parent",
                    "value": "parent",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "type": {
                                "type": "string",
                                "title": "Parent.Type",
                                "example": "file"
                            },
                            "id": {
                                "type": "string",
                                "title": "Parent.Id",
                                "example": "123456789"
                            },
                            "sequence_id": {
                                "type": "null",
                                "title": "Parent.Sequence Id"
                            },
                            "etag": {
                                "type": "null",
                                "title": "Parent.Etag"
                            },
                            "name": {
                                "type": "string",
                                "title": "Parent.Name",
                                "example": "Documents"
                            }
                        },
                        "example": {
                            "type": "file",
                            "id": "123456789",
                            "sequence_id": null,
                            "etag": null,
                            "name": "Documents"
                        }
                    }
                },
                {
                    "label": "Item Status",
                    "value": "item_status",
                    "schema": {
                        "type": "string",
                        "example": "active"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
