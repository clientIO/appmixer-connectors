{
    "name": "appmixer.box.core.FindFilesOrFolders",
    "label": "Find Files or Folders",
    "description": "Search for files and folders by name, content, type, owner, etc. This component will return a maximum of 200 records per search. Note: Box Search uses an index that may take several minutes to index newly created or modified files. If a recently created file is not found, wait a few minutes and try again.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:box"
    },
    "quota": {
        "manager": "appmixer:box",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string"
                    },
                    "type": {
                        "type": "string"
                    },
                    "ancestorFolderIds": {
                        "type": "string"
                    },
                    "contentTypes": {
                        "type": [
                            "array",
                            "string"
                        ]
                    },
                    "fields": {
                        "type": "string"
                    },
                    "outputType": {
                        "type": "string",
                        "default": "array"
                    },
                    "exactMatch": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "query"
                ]
            },
            "inspector": {
                "inputs": {
                    "query": {
                        "type": "text",
                        "index": 0,
                        "label": "Query",
                        "tooltip": "The search query string (e.g., file name fragment)."
                    },
                    "exactMatch": {
                        "type": "toggle",
                        "index": 1,
                        "label": "Exact Match",
                        "defaultValue": false,
                        "tooltip": "When enabled, only returns items whose name exactly matches the query. Box search uses fuzzy/tokenized matching by default, so this option filters results client-side to return only exact matches."
                    },
                    "type": {
                        "type": "select",
                        "index": 2,
                        "label": "Type",
                        "tooltip": "Filter by item type: file or folder.",
                        "options": [
                            {
                                "label": "File",
                                "value": "file"
                            },
                            {
                                "label": "Folder",
                                "value": "folder"
                            }
                        ]
                    },
                    "ancestorFolderIds": {
                        "type": "text",
                        "index": 3,
                        "label": "Ancestor Folder IDs",
                        "tooltip": "Comma-separated list of ancestor folder IDs to limit scope."
                    },
                    "contentTypes": {
                        "type": "multiselect",
                        "index": 4,
                        "label": "Content Types",
                        "tooltip": "Select content types to search: name, description, file_content, comments, tags.",
                        "options": [
                            {
                                "label": "Name",
                                "value": "name"
                            },
                            {
                                "label": "Description",
                                "value": "description"
                            },
                            {
                                "label": "File Content",
                                "value": "file_content"
                            },
                            {
                                "label": "Comments",
                                "value": "comments"
                            },
                            {
                                "label": "Tags",
                                "value": "tags"
                            }
                        ]
                    },
                    "fields": {
                        "type": "text",
                        "index": 5,
                        "label": "Fields",
                        "tooltip": "Comma-separated list of fields to include."
                    },
                    "outputType": {
                        "type": "select",
                        "index": 6,
                        "label": "Output Type",
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/box/core/FindFilesOrFolders?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType",
                        "in/query": "any"
                    }
                }
            }
        },
        {
            "name": "notFound"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
