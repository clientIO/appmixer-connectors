{
    "name": "appmixer.front.rule.GetRule",
    "description": "Get a specific automation rule by ID from Front. Requires Enterprise plan.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:front"
    },
    "quota": {
        "manager": "appmixer:front",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "ruleId": {
                        "type": "string"
                    }
                },
                "required": ["ruleId"]
            },
            "inspector": {
                "inputs": {
                    "ruleId": {
                        "type": "text",
                        "index": 0,
                        "label": "Rule ID",
                        "tooltip": "The ID of the rule to retrieve"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Rule ID", "value": "id", "schema": { "type": "string", "example": "rul_58xhq" } },
                { "label": "Rule Name", "value": "name", "schema": { "type": "string", "example": "Tag and assign billing emails" } },
                { "label": "Actions", "value": "actions", "schema": { "type": "array", "example": ["Tag with Billing", "Assign to Jane Doe"] } },
                { "label": "Is Private", "value": "is_private", "schema": { "type": "boolean", "example": false } },
                { "label": "Self Link", "value": "_links.self", "schema": { "type": "string", "example": "https://api2.frontapp.com/rules/rul_58xhq" } },
                { "label": "Owner Link", "value": "_links.related.owner", "schema": { "type": "string", "example": "https://api2.frontapp.com/teams/tim_k30" } }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}
