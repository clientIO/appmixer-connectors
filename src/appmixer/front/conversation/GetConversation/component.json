{
    "name": "appmixer.front.conversation.GetConversation",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieve a specific conversation by ID.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:front"
    },
    "quota": {
        "manager": "appmixer:front",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "id": {
                        "type": "text",
                        "tooltip": "Id of the conversation (e.g., cnv_123)",
                        "label": "Conversation ID",
                        "index": 0
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "_links",
                    "value": "_links",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "self": {
                                "type": "string",
                                "title": "_links.Self",
                                "example": "https://api2.frontapp.com/conversations/cnv_123"
                            },
                            "related": {
                                "type": "object",
                                "properties": {
                                    "events": {
                                        "type": "string",
                                        "title": "_links.Related.Events",
                                        "example": "https://api2.frontapp.com/conversations/cnv_123/events"
                                    },
                                    "followers": {
                                        "type": "string",
                                        "title": "_links.Related.Followers",
                                        "example": "https://api2.frontapp.com/conversations/cnv_123/followers"
                                    },
                                    "messages": {
                                        "type": "string",
                                        "title": "_links.Related.Messages",
                                        "example": "https://api2.frontapp.com/conversations/cnv_123/messages"
                                    },
                                    "comments": {
                                        "type": "string",
                                        "title": "_links.Related.Comments",
                                        "example": "https://api2.frontapp.com/conversations/cnv_123/comments"
                                    },
                                    "inboxes": {
                                        "type": "string",
                                        "title": "_links.Related.Inboxes",
                                        "example": "https://api2.frontapp.com/conversations/cnv_123/inboxes"
                                    },
                                    "last_message": {
                                        "type": "string",
                                        "title": "_links.Related.Last Message",
                                        "example": "https://api2.frontapp.com/messages/msg_456"
                                    }
                                },
                                "title": "_links.Related"
                            }
                        },
                        "example": {
                            "self": "https://api2.frontapp.com/conversations/cnv_123",
                            "related": {
                                "events": "https://api2.frontapp.com/conversations/cnv_123/events",
                                "followers": "https://api2.frontapp.com/conversations/cnv_123/followers",
                                "messages": "https://api2.frontapp.com/conversations/cnv_123/messages",
                                "comments": "https://api2.frontapp.com/conversations/cnv_123/comments",
                                "inboxes": "https://api2.frontapp.com/conversations/cnv_123/inboxes",
                                "last_message": "https://api2.frontapp.com/messages/msg_456"
                            }
                        }
                    }
                },
                {
                    "label": "Conversation ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "cnv_123"
                    }
                },
                {
                    "label": "Subject",
                    "value": "subject",
                    "schema": {
                        "type": "string",
                        "example": "Inquiry about your services"
                    }
                },
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "string",
                        "example": "assigned"
                    }
                },
                {
                    "label": "Status Id",
                    "value": "status_id",
                    "schema": {
                        "type": "string",
                        "example": "sta_123"
                    }
                },
                {
                    "label": "Status Category",
                    "value": "status_category",
                    "schema": {
                        "type": "string",
                        "example": "open"
                    }
                },
                {
                    "label": "Ticket Ids",
                    "value": "ticket_ids",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "TICKET-1"
                        ]
                    }
                },
                {
                    "label": "Assignee",
                    "value": "assignee",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "_links": {
                                "type": "object",
                                "properties": {
                                    "self": {
                                        "type": "string",
                                        "title": "Assignee._links.Self",
                                        "example": "https://api2.frontapp.com/teammates/tea_123"
                                    },
                                    "related": {
                                        "type": "object",
                                        "properties": {
                                            "inboxes": {
                                                "type": "string",
                                                "title": "Assignee._links.Related.Inboxes",
                                                "example": "https://api2.frontapp.com/conversations/cnv_123/inboxes"
                                            },
                                            "conversations": {
                                                "type": "string",
                                                "title": "Assignee._links.Related.Conversations",
                                                "example": "https://api2.frontapp.com/teammates/tea_123/conversations"
                                            }
                                        },
                                        "title": "Assignee._links.Related"
                                    }
                                },
                                "title": "Assignee._links"
                            },
                            "id": {
                                "type": "string",
                                "title": "Assignee.Id",
                                "example": "tea_123"
                            },
                            "email": {
                                "type": "string",
                                "title": "Assignee.Email",
                                "example": "john.doe@example.com"
                            },
                            "username": {
                                "type": "string",
                                "title": "Assignee.Username",
                                "example": "johndoe"
                            },
                            "first_name": {
                                "type": "string",
                                "title": "Assignee.First Name",
                                "example": "John"
                            },
                            "last_name": {
                                "type": "string",
                                "title": "Assignee.Last Name",
                                "example": "Doe"
                            },
                            "is_admin": {
                                "type": "boolean",
                                "title": "Assignee.Is Admin",
                                "example": true
                            },
                            "is_available": {
                                "type": "boolean",
                                "title": "Assignee.Is Available",
                                "example": true
                            },
                            "is_blocked": {
                                "type": "boolean",
                                "title": "Assignee.Is Blocked",
                                "example": false
                            },
                            "type": {
                                "type": "string",
                                "title": "Assignee.Type",
                                "example": "user"
                            },
                            "custom_fields": {
                                "type": "object",
                                "title": "Assignee.Custom Fields"
                            }
                        },
                        "example": {
                            "_links": {
                                "self": "https://api2.frontapp.com/teammates/tea_123",
                                "related": {
                                    "inboxes": "https://api2.frontapp.com/teammates/tea_123/inboxes",
                                    "conversations": "https://api2.frontapp.com/teammates/tea_123/conversations"
                                }
                            },
                            "id": "tea_123",
                            "email": "john.doe@example.com",
                            "username": "johndoe",
                            "first_name": "John",
                            "last_name": "Doe",
                            "is_admin": true,
                            "is_available": true,
                            "is_blocked": false,
                            "type": "user",
                            "custom_fields": {}
                        }
                    }
                },
                {
                    "label": "Recipient",
                    "value": "recipient",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "_links": {
                                "type": "object",
                                "properties": {
                                    "related": {
                                        "type": "object",
                                        "properties": {
                                            "contact": {
                                                "type": "string",
                                                "title": "Recipient._links.Related.Contact",
                                                "example": "https://api2.frontapp.com/contacts/cnt_456"
                                            }
                                        },
                                        "title": "Recipient._links.Related"
                                    }
                                },
                                "title": "Recipient._links"
                            },
                            "name": {
                                "type": "string",
                                "title": "Recipient.Name",
                                "example": "Jane Smith"
                            },
                            "handle": {
                                "type": "string",
                                "title": "Recipient.Handle",
                                "example": "jane@example.com"
                            },
                            "role": {
                                "type": "string",
                                "title": "Recipient.Role",
                                "example": "to"
                            }
                        },
                        "example": {
                            "_links": {
                                "related": {
                                    "contact": "https://api2.frontapp.com/contacts/cnt_456"
                                }
                            },
                            "name": "Jane Smith",
                            "handle": "jane@example.com",
                            "role": "to"
                        }
                    }
                },
                {
                    "label": "Tags",
                    "value": "tags",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "Billing",
                            "Urgent"
                        ]
                    }
                },
                {
                    "label": "Links",
                    "value": "links",
                    "schema": {
                        "type": "array",
                        "items": {},
                        "example": [
                            {
                                "_links": {
                                    "self": "https://api2.frontapp.com/links/top_b2wpa"
                                },
                                "id": "top_b2wpa",
                                "name": "PB-4567",
                                "type": "web",
                                "external_url": "https://jira.example.com/browse/PB-4567",
                                "custom_fields": {}
                            }
                        ]
                    }
                },
                {
                    "label": "Is Private",
                    "value": "is_private",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Draft Mode",
                    "value": "draft_mode",
                    "schema": {
                        "type": "string",
                        "example": "shared"
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "number",
                        "example": 1678901234.567
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}
