{
    "name": "appmixer.front.tag.GetTag",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Get a specific tag by its ID.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:front"
    },
    "quota": {
        "manager": "appmixer:front",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    }
                },
                "required": [
                    "id"
                ]
            },
            "inspector": {
                "inputs": {
                    "id": {
                        "type": "text",
                        "label": "Tag ID",
                        "index": 0,
                        "tooltip": "The unique identifier of the tag"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Tag ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "tag_123"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Billing"
                    }
                },
                {
                    "label": "Highlight",
                    "value": "highlight",
                    "schema": {
                        "type": "string",
                        "example": "blue"
                    }
                },
                {
                    "label": "Description",
                    "value": "description",
                    "schema": {
                        "type": "string",
                        "example": "Invoices, refunds and payment questions"
                    }
                },
                {
                    "label": "Is Private",
                    "value": "is_private",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Is Visible in Conversation Lists",
                    "value": "is_visible_in_conversation_lists",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updated_at",
                    "schema": {
                        "type": "number",
                        "example": 1717516800.186
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "number",
                        "example": 1717430400.583
                    }
                },
                {
                    "label": "Links",
                    "value": "_links",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "self": {
                                "type": "string",
                                "title": "Self URL",
                                "example": "https://api2.frontapp.com/tags/tag_123"
                            },
                            "related": {
                                "type": "object",
                                "properties": {
                                    "conversations": {
                                        "type": "string",
                                        "title": "Conversations URL",
                                        "example": "https://api2.frontapp.com/tags/tag_123/conversations"
                                    },
                                    "owner": {
                                        "type": "string",
                                        "title": "Owner URL",
                                        "example": "https://api2.frontapp.com/teams/tim_123"
                                    },
                                    "parent_tag": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "title": "Parent Tag URL",
                                        "example": "https://api2.frontapp.com/tags/tag_456"
                                    },
                                    "children": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "title": "Children URL",
                                        "example": "https://api2.frontapp.com/tags/tag_123/children"
                                    }
                                },
                                "title": "Related Links"
                            }
                        },
                        "example": {
                            "self": "https://api2.frontapp.com/tags/tag_123",
                            "related": {
                                "conversations": "https://api2.frontapp.com/tags/tag_123/conversations",
                                "owner": "https://api2.frontapp.com/teams/tim_123",
                                "parent_tag": "https://api2.frontapp.com/tags/tag_456",
                                "children": "https://api2.frontapp.com/tags/tag_123/children"
                            }
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}
