{
    "name": "appmixer.front.contacts.CreateContact",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new contact.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:front"
    },
    "quota": {
        "manager": "appmixer:front",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "links": {
                        "type": "string"
                    },
                    "handles": {
                        "type": "object"
                    }
                },
                "required": [
                    "name"
                ]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "label": "Name",
                        "index": 0,
                        "tooltip": "Full name of the contact"
                    },
                    "handles": {
                        "type": "expression",
                        "label": "Handles",
                        "tooltip": "List of the handles for this contact",
                        "levels": [
                            "ADD"
                        ],
                        "index": 1,
                        "fields": {
                            "source": {
                                "type": "select",
                                "label": "Source",
                                "index": 1,
                                "required": true,
                                "tooltip": "Source of the handle",
                                "options": [
                                    {
                                        "label": "Email",
                                        "value": "email"
                                    },
                                    {
                                        "label": "Phone",
                                        "value": "phone"
                                    },
                                    {
                                        "label": "Twitter",
                                        "value": "twitter"
                                    },
                                    {
                                        "label": "Facebook",
                                        "value": "facebook"
                                    },
                                    {
                                        "label": "Intercom",
                                        "value": "intercom"
                                    },
                                    {
                                        "label": "Front Chat",
                                        "value": "front_chat"
                                    },
                                    {
                                        "label": "Custom",
                                        "value": "custom"
                                    }
                                ]
                            },
                            "handle": {
                                "type": "text",
                                "label": "Value",
                                "index": 2,
                                "required": true
                            }
                        }
                    },
                    "description": {
                        "type": "textarea",
                        "label": "Description",
                        "index": 2,
                        "tooltip": "Notes about the contact"
                    },
                    "links": {
                        "type": "text",
                        "label": "Links",
                        "index": 3,
                        "tooltip": "Comma-separated list of links (URLs)"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Contact ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "crd_3cgz4ge"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Jane Doe"
                    }
                },
                {
                    "label": "Description",
                    "value": "description",
                    "schema": {
                        "type": "string",
                        "example": "Head of Operations at Example Corp"
                    }
                },
                {
                    "label": "Avatar URL",
                    "value": "avatar_url",
                    "schema": {
                        "type": "string",
                        "example": "https://api2.frontapp.com/contacts/crd_3cgz4ge/avatar-1717430400000"
                    }
                },
                {
                    "label": "Is Private",
                    "value": "is_private",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Account",
                    "value": "account",
                    "schema": {
                        "type": "object",
                        "example": {
                            "id": "acc_1w3d",
                            "name": "Example Corp"
                        }
                    }
                },
                {
                    "label": "Links",
                    "value": "links",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "https://www.example.com",
                            "https://blog.example.com"
                        ]
                    }
                },
                {
                    "label": "Handles",
                    "value": "handles",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "source": {
                                    "type": "string",
                                    "example": "email"
                                },
                                "handle": {
                                    "type": "string",
                                    "example": "jane@example.com"
                                }
                            }
                        },
                        "example": [
                            {
                                "source": "email",
                                "handle": "jane@example.com"
                            },
                            {
                                "source": "phone",
                                "handle": "+15555550123"
                            }
                        ]
                    }
                },
                {
                    "label": "Groups",
                    "value": "groups",
                    "schema": {
                        "type": "array",
                        "example": [
                            {
                                "_links": {
                                    "self": "https://api2.frontapp.com/contact_lists/grp_3j342",
                                    "related": {
                                        "contacts": "https://api2.frontapp.com/contact_lists/grp_3j342/contacts",
                                        "owner": "https://api2.frontapp.com/teammates/tea_6r55a"
                                    }
                                },
                                "id": "grp_3j342",
                                "name": "VIP Customers",
                                "is_private": false
                            }
                        ]
                    }
                },
                {
                    "label": "Custom Fields",
                    "value": "custom_fields",
                    "schema": {
                        "type": "object",
                        "example": {
                            "city": "London, UK",
                            "isVIP": true
                        }
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "number",
                        "example": 1717430400.123
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updated_at",
                    "schema": {
                        "type": "number",
                        "example": 1717434000.456
                    }
                },
                {
                    "label": "Links",
                    "value": "_links",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "self": {
                                "type": "string",
                                "example": "https://api2.frontapp.com/contacts/crd_3cgz4ge"
                            },
                            "related": {
                                "type": "object"
                            }
                        },
                        "example": {
                            "self": "https://api2.frontapp.com/contacts/crd_3cgz4ge",
                            "related": {
                                "notes": "https://api2.frontapp.com/contacts/crd_3cgz4ge/notes",
                                "conversations": "https://api2.frontapp.com/contacts/crd_3cgz4ge/conversations",
                                "owner": null
                            }
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}
