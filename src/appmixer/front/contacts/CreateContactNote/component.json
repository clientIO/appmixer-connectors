{
    "name": "appmixer.front.contacts.CreateContactNote",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Add a note to a contact.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:front"
    },
    "quota": {
        "manager": "appmixer:front",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "contactId": {
                        "type": "string"
                    },
                    "body": {
                        "type": "string"
                    },
                    "authorId": {
                        "type": "string"
                    }
                },
                "required": [
                    "contactId",
                    "body",
                    "authorId"
                ]
            },
            "inspector": {
                "inputs": {
                    "contactId": {
                        "type": "text",
                        "label": "Contact ID",
                        "index": 1,
                        "tooltip": "The unique identifier of the contact"
                    },
                    "body": {
                        "type": "textarea",
                        "label": "Note Body",
                        "index": 2,
                        "tooltip": "The content of the note (required)"
                    },
                    "authorId": {
                        "type": "text",
                        "label": "Author ID",
                        "index": 3,
                        "tooltip": "The ID of the teammate who is creating the note",
                        "source": {
                            "url": "/component/appmixer/front/teammates/ListTeammates?outPort=out",
                            "data": {
                                "message": {
                                    "in/outputType": "array"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListTeammates#toSelectArray"
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Links",
                    "value": "_links",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "related": {
                                "type": "object",
                                "properties": {
                                    "author": {
                                        "type": "string",
                                        "example": "https://api2.frontapp.com/teammates/tea_123"
                                    },
                                    "owner": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    }
                                }
                            }
                        },
                        "example": {
                            "related": {
                                "author": "https://api2.frontapp.com/teammates/tea_123",
                                "owner": null
                            }
                        }
                    }
                },
                {
                    "label": "Author",
                    "value": "author",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "_links": {
                                "type": "object"
                            },
                            "id": {
                                "type": "string",
                                "example": "tea_123"
                            },
                            "email": {
                                "type": "string",
                                "example": "john.doe@example.com"
                            },
                            "username": {
                                "type": "string",
                                "example": "johndoe"
                            },
                            "first_name": {
                                "type": "string",
                                "example": "John"
                            },
                            "last_name": {
                                "type": "string",
                                "example": "Doe"
                            },
                            "is_admin": {
                                "type": "boolean",
                                "example": true
                            },
                            "is_available": {
                                "type": "boolean",
                                "example": true
                            },
                            "is_blocked": {
                                "type": "boolean",
                                "example": false
                            },
                            "type": {
                                "type": "string",
                                "example": "user"
                            },
                            "custom_fields": {
                                "type": "object"
                            }
                        },
                        "example": {
                            "_links": {
                                "self": "https://api2.frontapp.com/teammates/tea_123",
                                "related": {
                                    "inboxes": "https://api2.frontapp.com/teammates/tea_123/inboxes",
                                    "conversations": "https://api2.frontapp.com/teammates/tea_123/conversations"
                                }
                            },
                            "id": "tea_123",
                            "email": "john.doe@example.com",
                            "username": "johndoe",
                            "first_name": "John",
                            "last_name": "Doe",
                            "is_admin": true,
                            "is_available": true,
                            "is_blocked": false,
                            "type": "user",
                            "custom_fields": {}
                        }
                    }
                },
                {
                    "label": "Author ID",
                    "value": "author.id",
                    "schema": {
                        "type": "string",
                        "example": "tea_123"
                    }
                },
                {
                    "label": "Author Email",
                    "value": "author.email",
                    "schema": {
                        "type": "string",
                        "example": "john.doe@example.com"
                    }
                },
                {
                    "label": "Author Username",
                    "value": "author.username",
                    "schema": {
                        "type": "string",
                        "example": "johndoe"
                    }
                },
                {
                    "label": "Author First Name",
                    "value": "author.first_name",
                    "schema": {
                        "type": "string",
                        "example": "John"
                    }
                },
                {
                    "label": "Author Last Name",
                    "value": "author.last_name",
                    "schema": {
                        "type": "string",
                        "example": "Doe"
                    }
                },
                {
                    "label": "Author Is Admin",
                    "value": "author.is_admin",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "Author Is Available",
                    "value": "author.is_available",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "Author Is Blocked",
                    "value": "author.is_blocked",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Author Type",
                    "value": "author.type",
                    "schema": {
                        "type": "string",
                        "example": "user"
                    }
                },
                {
                    "label": "Author Custom Fields",
                    "value": "author.custom_fields",
                    "schema": {
                        "type": "object",
                        "example": {}
                    }
                },
                {
                    "label": "Body",
                    "value": "body",
                    "schema": {
                        "type": "string",
                        "example": "Prefers to be contacted by email before 10am."
                    }
                },
                {
                    "label": "Is Private",
                    "value": "is_private",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "number",
                        "example": 1717430400.536
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}
