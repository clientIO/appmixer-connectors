{
    "name": "appmixer.front.inbox.GetInbox",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Fetch an inbox by its ID.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:front"
    },
    "quota": {
        "manager": "appmixer:front",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "inboxId": {
                        "type": "string"
                    }
                },
                "required": [
                    "inboxId"
                ]
            },
            "inspector": {
                "inputs": {
                    "inboxId": {
                        "type": "text",
                        "label": "Inbox ID",
                        "index": 0,
                        "tooltip": "The unique identifier of the inbox to fetch"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Inbox ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "inb_1ix6"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Customer Support"
                    }
                },
                {
                    "label": "Type",
                    "value": "type",
                    "schema": {
                        "type": "string",
                        "example": "team"
                    }
                },
                {
                    "label": "Is Private",
                    "value": "is_private",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Is Public",
                    "value": "is_public",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "Custom Fields",
                    "value": "custom_fields",
                    "schema": {
                        "type": "object",
                        "example": {
                            "city": "London, UK",
                            "isVIP": false,
                            "renewal_date": 1717430400,
                            "sla_time": 90,
                            "owner": "michael.scott@example.com",
                            "replyTo": "inb_55c8c149",
                            "Job Title": "Support Lead"
                        }
                    }
                },
                {
                    "label": "Custom Fields City",
                    "value": "custom_fields.city",
                    "schema": {
                        "type": "string",
                        "example": "London, UK"
                    }
                },
                {
                    "label": "Custom Fields Is VIP",
                    "value": "custom_fields.isVIP",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Custom Fields Renewal Date",
                    "value": "custom_fields.renewal_date",
                    "schema": {
                        "type": "number",
                        "example": 1717430400
                    }
                },
                {
                    "label": "Custom Fields SLA Time",
                    "value": "custom_fields.sla_time",
                    "schema": {
                        "type": "number",
                        "example": 90
                    }
                },
                {
                    "label": "Custom Fields Owner",
                    "value": "custom_fields.owner",
                    "schema": {
                        "type": "string",
                        "example": "michael.scott@example.com"
                    }
                },
                {
                    "label": "Custom Fields Reply To",
                    "value": "custom_fields.replyTo",
                    "schema": {
                        "type": "string",
                        "example": "inb_55c8c149"
                    }
                },
                {
                    "label": "Custom Fields Job Title",
                    "value": "custom_fields['Job Title']",
                    "schema": {
                        "type": "string",
                        "example": "Support Lead"
                    }
                },
                {
                    "label": "Links",
                    "value": "_links",
                    "schema": {
                        "type": "object",
                        "example": {
                            "self": "https://api2.frontapp.com/inboxes/inb_1ix6",
                            "related": {
                                "teammates": "https://api2.frontapp.com/inboxes/inb_1ix6/teammates",
                                "conversations": "https://api2.frontapp.com/inboxes/inb_1ix6/conversations",
                                "channels": "https://api2.frontapp.com/inboxes/inb_1ix6/channels",
                                "owner": "https://api2.frontapp.com/teams/tim_k30"
                            }
                        }
                    }
                },
                {
                    "label": "Links Self",
                    "value": "_links.self",
                    "schema": {
                        "type": "string",
                        "example": "https://api2.frontapp.com/inboxes/inb_1ix6"
                    }
                },
                {
                    "label": "Links Related",
                    "value": "_links.related",
                    "schema": {
                        "type": "object",
                        "example": {
                            "teammates": "https://api2.frontapp.com/inboxes/inb_1ix6/teammates",
                            "conversations": "https://api2.frontapp.com/inboxes/inb_1ix6/conversations",
                            "channels": "https://api2.frontapp.com/inboxes/inb_1ix6/channels",
                            "owner": "https://api2.frontapp.com/teams/tim_k30"
                        }
                    }
                },
                {
                    "label": "Links Related Teammates",
                    "value": "_links.related.teammates",
                    "schema": {
                        "type": "string",
                        "example": "https://api2.frontapp.com/inboxes/inb_1ix6/teammates"
                    }
                },
                {
                    "label": "Links Related Conversations",
                    "value": "_links.related.conversations",
                    "schema": {
                        "type": "string",
                        "example": "https://api2.frontapp.com/inboxes/inb_1ix6/conversations"
                    }
                },
                {
                    "label": "Links Related Channels",
                    "value": "_links.related.channels",
                    "schema": {
                        "type": "string",
                        "example": "https://api2.frontapp.com/inboxes/inb_1ix6/channels"
                    }
                },
                {
                    "label": "Links Related Owner",
                    "value": "_links.related.owner",
                    "schema": {
                        "type": "string",
                        "example": "https://api2.frontapp.com/teams/tim_k30"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}
