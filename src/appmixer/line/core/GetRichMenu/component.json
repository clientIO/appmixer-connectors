{
    "name": "appmixer.line.core.GetRichMenu",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Gets the data of a specified rich menu only created by API.",
    "version": "1.0.0",
    "private": true,
    "auth": {
        "service": "appmixer:line"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "richMenuId": {
                        "type": "string"
                    }
                },
                "required": [
                    "richMenuId"
                ]
            },
            "inspector": {
                "inputs": {
                    "richMenuId": {
                        "type": "text",
                        "tooltip": "ID of the rich menu.",
                        "label": "Rich Menu ID",
                        "index": 0
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Rich Menu ID",
                    "value": "richMenuId",
                    "schema": {
                        "type": "string",
                        "example": "richmenu-abc123def456"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Main Menu"
                    }
                },
                {
                    "label": "Size",
                    "value": "size",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "width": {
                                "type": "number",
                                "title": "Size.Width"
                            },
                            "height": {
                                "type": "number",
                                "title": "Size.Height"
                            }
                        },
                        "example": {
                            "width": 2500,
                            "height": 1686
                        }
                    }
                },
                {
                    "label": "Chat Bar Text",
                    "value": "chatBarText",
                    "schema": {
                        "type": "string",
                        "example": "Tap to open"
                    }
                },
                {
                    "label": "Selected",
                    "value": "selected",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "Areas",
                    "value": "areas",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "bounds": {
                                    "type": "object",
                                    "properties": {
                                        "x": {
                                            "type": "number",
                                            "title": "Areas.Bounds.X"
                                        },
                                        "y": {
                                            "type": "number",
                                            "title": "Areas.Bounds.Y"
                                        },
                                        "width": {
                                            "type": "number",
                                            "title": "Areas.Bounds.Width"
                                        },
                                        "height": {
                                            "type": "number",
                                            "title": "Areas.Bounds.Height"
                                        }
                                    },
                                    "title": "Areas.Bounds"
                                },
                                "action": {
                                    "type": "object",
                                    "properties": {
                                        "type": {
                                            "type": "string",
                                            "title": "Areas.Action.Type"
                                        },
                                        "data": {
                                            "type": "string",
                                            "title": "Areas.Action.Data"
                                        }
                                    },
                                    "title": "Areas.Action"
                                }
                            }
                        },
                        "example": [
                            {
                                "bounds": {
                                    "x": 0,
                                    "y": 0,
                                    "width": 1250,
                                    "height": 843
                                },
                                "action": {
                                    "type": "postback",
                                    "data": "action=buy"
                                }
                            }
                        ]
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
