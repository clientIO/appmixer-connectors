{
    "name": "appmixer.line.core.GetNumberOfMessageDeliveries",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Returns the number of messages sent from LINE Official Account on a specified day.",
    "version": "1.0.0",
    "private": false,
    "label": "Get Number of Message Deliveries",
    "auth": {
        "service": "appmixer:line"
    },
    "quota": {
        "manager": "appmixer:line",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "date": {
                        "type": "string"
                    }
                },
                "required": [
                    "date"
                ]
            },
            "inspector": {
                "inputs": {
                    "date": {
                        "type": "date-time",
                        "label": "Date",
                        "index": 0,
                        "config": {
                            "enableTime": false,
                            "format": "YYYYMMDD"
                        },
                        "tooltip": "Date for which to retrieve number of sent messages. Format: YYYYMMDD"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "string",
                        "example": "ready"
                    }
                },
                {
                    "label": "Broadcast",
                    "value": "broadcast",
                    "schema": {
                        "type": "integer",
                        "example": 5000
                    }
                },
                {
                    "label": "Targeting",
                    "value": "targeting",
                    "schema": {
                        "type": "integer",
                        "example": 3200
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
