{
    "name": "appmixer.line.core.SendReplyMessage",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Sends a reply message in response to an event from a user, group, or room.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:line"
    },
    "quota": {
        "manager": "appmixer:line",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "replyToken": {
                        "type": "string"
                    },
                    "messages": {
                        "type": "object"
                    },
                    "notificationDisabled": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "messages", "replyToken"
                ]
            },
            "inspector": {
                "inputs": {
                    "replyToken": {
                        "type": "text",
                        "label": "Reply Token",
                        "index": 0,
                        "tooltip": "Reply token received via webhook. Reply tokens must be used within one minute after receiving the webhook. Use beyond one minute isn't guaranteed to work."
                    },
                    "messages": {
                        "type": "expression",
                        "label": "Messages",
                        "index": 1,
                        "levels": ["ADD"],
                        "fields": {
                            "type": {
                                "type": "select",
                                "label": "Type",
                                "options": [
                                    {
                                        "value": "text",
                                        "label": "Text"
                                    },
                                    {
                                        "value": "sticker",
                                        "label": "Sticker"
                                    }
                                ]
                            },
                            "text": {
                                "type": "text",
                                "label": "Text",
                                "when": { "eq": { "./type": "text" } },
                                "required": true
                            },
                            "packageId": {
                                "type": "text",
                                "label": "Package ID",
                                "when": { "eq": { "./type": "sticker" } },
                                "required": true,
                                "tooltip": "Package ID for a set of stickers. For information on package IDs, see the <a href=\"https://developers.line.biz/en/docs/messaging-api/sticker-list/\" target=\"_blank\">Sticker list</a>."
                            },
                            "stickerId": {
                                "type": "text",
                                "label": "Sticker ID",
                                "when": { "eq": { "./type": "sticker" } },
                                "required": true,
                                "tooltip": "Sticker ID. For a list of sticker IDs for stickers that can be sent with the Messaging API, see the <a href=\"https://developers.line.biz/en/docs/messaging-api/sticker-list/\" target=\"_blank\">Sticker list</a>."
                            }
                        }
                    },
                    "notificationDisabled": {
                        "type": "toggle",
                        "index": 2,
                        "label": "Notification Disabled"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [

            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
