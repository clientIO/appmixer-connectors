{
    "name": "appmixer.line.core.NewMessages",
    "author": "Appmixer <info@appmixer.com>",
    "label": "Watch New Messages",
    "description": "Watches for new messages.",
    "private": false,
    "webhook": true,
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:line"
    },
    "quota": {
        "manager": "appmixer:line",
        "resources": "requests"
    },
    "properties": {},
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Event Type",
                    "value": "type",
                    "schema": {
                        "type": "string",
                        "example": "message"
                    }
                },
                {
                    "label": "Message",
                    "value": "message",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "type": {
                                "type": "string",
                                "title": "Message.Type"
                            },
                            "id": {
                                "type": "string",
                                "title": "Message.ID"
                            },
                            "quoteToken": {
                                "type": "string",
                                "title": "Message.Quote Token"
                            },
                            "text": {
                                "type": "string",
                                "title": "Message.Text"
                            }
                        },
                        "example": {
                            "type": "text",
                            "id": "468789577898754",
                            "quoteToken": "q3Plxr4AgKd...",
                            "text": "Hello, world!"
                        }
                    }
                },
                {
                    "label": "Webhook Event ID",
                    "value": "webhookEventId",
                    "schema": {
                        "type": "string",
                        "example": "01FZ34WDXJ8GKNP0R1YMVH3TNF"
                    }
                },
                {
                    "label": "Delivery Context",
                    "value": "deliveryContext",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "isRedelivery": {
                                "type": "boolean",
                                "title": "Delivery Context.Is Redelivery"
                            }
                        },
                        "example": {
                            "isRedelivery": false
                        }
                    }
                },
                {
                    "label": "Timestamp",
                    "value": "timestamp",
                    "schema": {
                        "type": "number",
                        "example": 1704067200000
                    }
                },
                {
                    "label": "Source",
                    "value": "source",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "type": {
                                "type": "string",
                                "title": "Source.Type"
                            },
                            "groupId": {
                                "type": "string",
                                "title": "Source.Group ID"
                            },
                            "userId": {
                                "type": "string",
                                "title": "Source.User ID"
                            },
                            "roomId": {
                                "type": "string",
                                "title": "Source.Room ID"
                            }
                        },
                        "example": {
                            "type": "group",
                            "groupId": "C4af4980629...",
                            "userId": "U4af4980629..."
                        }
                    }
                },
                {
                    "label": "Reply Token",
                    "value": "replyToken",
                    "schema": {
                        "type": "string",
                        "example": "0f3779fba3b349968c5d07db31eab56f"
                    }
                },
                {
                    "label": "Mode",
                    "value": "mode",
                    "schema": {
                        "type": "string",
                        "example": "active"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
