{
    "name": "appmixer.emarsys.core.BillingDueDate",
    "label": "Billing Due Date",
    "description": "Fires when Emarsys posts a contact whose bill is due to the webhook URL. Emarsys has no billing object and no date-based entry point, so keep the due date in a custom contact date field and drive this from an audience-based program with a daily 'Recurring' entry point, a segment on that field, and a webhook node pointing at the URL below.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "webhook": true,
    "auth": {
        "service": "appmixer:emarsys"
    },
    "quota": {
        "manager": "appmixer:emarsys",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "webhookUrl": {},
                "dueDateKey": {
                    "type": "string"
                },
                "enrich": {
                    "type": "boolean"
                }
            }
        },
        "inspector": {
            "inputs": {
                "webhookUrl": {
                    "source": {
                        "url": "/component/appmixer/emarsys/core/BillingDueDate?outPort=out",
                        "data": {
                            "properties": {
                                "generateInspector": true
                            }
                        }
                    }
                },
                "dueDateKey": {
                    "type": "text",
                    "index": 1,
                    "label": "Due Date Key",
                    "defaultValue": "due_date",
                    "tooltip": "The contact data <b>key</b> under which the webhook node preset sends the billing due date. Its value is emitted as Due Date."
                },
                "enrich": {
                    "type": "toggle",
                    "index": 2,
                    "label": "Load All Contact Fields",
                    "tooltip": "A webhook node preset can carry at most 20 contact fields. Turn this on to also read every field of the contact through the Core API and emit them as Contact Fields. Needs the <code>contact.getdata</code> and <code>field.list</code> permissions, and the preset must send the contact ID as <code>contact_id</code>."
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "contactId": {
                        "type": "string",
                        "title": "Contact ID",
                        "example": "2451"
                    },
                    "email": {
                        "type": "string",
                        "title": "Email",
                        "example": "jane.doe@example.com"
                    },
                    "dueDate": {
                        "type": "string",
                        "title": "Due Date",
                        "example": "2026-10-01"
                    },
                    "deduplicationId": {
                        "type": "string",
                        "title": "Deduplication ID",
                        "example": "8f1d2e3a-4b5c-6d7e-8f90-a1b2c3d4e5f6"
                    },
                    "programId": {
                        "type": "string",
                        "title": "Program ID",
                        "example": "1044"
                    },
                    "eventTime": {
                        "type": "string",
                        "title": "Event Time",
                        "example": "2026-09-18T06:00:12Z"
                    },
                    "eventData": {
                        "type": "object",
                        "title": "Event Data",
                        "example": {}
                    },
                    "contact": {
                        "type": "object",
                        "title": "Contact",
                        "example": {
                            "contact_id": "2451",
                            "email": "jane.doe@example.com",
                            "due_date": "2026-10-01"
                        }
                    },
                    "contactFields": {
                        "type": "object",
                        "title": "Contact Fields",
                        "example": {
                            "id": "2451",
                            "uid": "CMLOReArrR",
                            "email": "jane.doe@example.com",
                            "first_name": "Jane",
                            "last_name": "Doe",
                            "opt_in": "1"
                        }
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
