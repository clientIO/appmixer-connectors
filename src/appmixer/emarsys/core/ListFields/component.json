{
    "name": "appmixer.emarsys.core.ListFields",
    "label": "List Contact Fields",
    "description": "Lists the contact field definitions of the Emarsys account, including each field's numeric ID. Emarsys identifies contact data by field ID, so this is how you find the ID of a field to filter or return in Find Contacts. Returns all fields of the account in one page.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:emarsys"
    },
    "quota": {
        "manager": "appmixer:emarsys",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "language": {
                        "type": "string"
                    },
                    "isSource": {
                        "type": "boolean"
                    },
                    "outputType": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "language": {
                        "type": "text",
                        "index": 1,
                        "label": "Language",
                        "defaultValue": "en",
                        "tooltip": "Two-letter language code used to translate the field labels, e.g. <code>en</code> or <code>de</code>. The String ID of a field is the same in every language."
                    },
                    "outputType": {
                        "type": "select",
                        "index": 2,
                        "label": "Output Type",
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, first item only, one item at a time, or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/emarsys/core/ListFields?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
