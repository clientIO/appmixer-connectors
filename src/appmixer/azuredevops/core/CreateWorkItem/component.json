{
    "name": "appmixer.azuredevops.core.CreateWorkItem",
    "label": "Create Work Item",
    "description": "Create a new work item (Bug, Task, User Story, etc.) in an Azure DevOps project.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:azuredevops"
    },
    "quota": {
        "manager": "appmixer:azuredevops",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "organization": {
                        "type": "string"
                    },
                    "project": {
                        "type": "string"
                    },
                    "workItemType": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "priority": {
                        "type": "integer"
                    },
                    "assignedTo": {
                        "type": "string"
                    },
                    "areaPath": {
                        "type": "string"
                    },
                    "iterationPath": {
                        "type": "string"
                    },
                    "tags": {
                        "type": "string"
                    }
                },
                "required": [
                    "organization",
                    "project",
                    "workItemType",
                    "title"
                ]
            },
            "inspector": {
                "inputs": {
                    "organization": {
                        "type": "text",
                        "index": 1,
                        "label": "Organization",
                        "tooltip": "The name of your Azure DevOps organization (e.g. <b>mycompany</b> from <i>https://dev.azure.com/mycompany</i>)."
                    },
                    "project": {
                        "type": "text",
                        "index": 2,
                        "label": "Project",
                        "tooltip": "The name or ID of the Azure DevOps project."
                    },
                    "workItemType": {
                        "type": "select",
                        "index": 3,
                        "label": "Work Item Type",
                        "tooltip": "The type of work item to create.",
                        "options": [
                            {
                                "label": "Bug",
                                "value": "Bug"
                            },
                            {
                                "label": "Task",
                                "value": "Task"
                            },
                            {
                                "label": "User Story",
                                "value": "User Story"
                            },
                            {
                                "label": "Feature",
                                "value": "Feature"
                            },
                            {
                                "label": "Epic",
                                "value": "Epic"
                            },
                            {
                                "label": "Issue",
                                "value": "Issue"
                            },
                            {
                                "label": "Test Case",
                                "value": "Test Case"
                            }
                        ]
                    },
                    "title": {
                        "type": "text",
                        "index": 4,
                        "label": "Title",
                        "tooltip": "The title of the work item."
                    },
                    "description": {
                        "type": "textarea",
                        "index": 5,
                        "label": "Description",
                        "tooltip": "A detailed description of the work item. HTML is supported."
                    },
                    "priority": {
                        "type": "number",
                        "index": 6,
                        "label": "Priority",
                        "tooltip": "Priority of the work item. Common values: 1 (Critical), 2 (High), 3 (Medium), 4 (Low)."
                    },
                    "assignedTo": {
                        "type": "text",
                        "index": 7,
                        "label": "Assigned To",
                        "tooltip": "Email address or display name of the user to assign the work item to."
                    },
                    "areaPath": {
                        "type": "text",
                        "index": 8,
                        "label": "Area Path",
                        "tooltip": "The area path for the work item (e.g. <b>MyProject\\TeamA</b>). Defaults to the project root if not specified."
                    },
                    "iterationPath": {
                        "type": "text",
                        "index": 9,
                        "label": "Iteration Path",
                        "tooltip": "The iteration path (sprint) for the work item (e.g. <b>MyProject\\Sprint 1</b>)."
                    },
                    "tags": {
                        "type": "text",
                        "index": 10,
                        "label": "Tags",
                        "tooltip": "Semicolon-separated list of tags to add to the work item (e.g. <b>security; api; critical</b>)."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Work Item ID",
                    "value": "id",
                    "schema": {
                        "type": "integer",
                        "example": 1042
                    },
                    "example": 42
                },
                {
                    "label": "Revision",
                    "value": "rev",
                    "schema": {
                        "type": "integer",
                        "example": 1
                    },
                    "example": 1
                },
                {
                    "label": "API URL",
                    "value": "url",
                    "schema": {
                        "type": "string",
                        "example": "https://dev.azure.com/acme/6ce954b1-ce1f-45d1-b94d-e6bf2464ba2c/_apis/wit/workItems/1042"
                    },
                    "example": "https://dev.azure.com/myorg/myproject/_apis/wit/workItems/42"
                },
                {
                    "label": "Title",
                    "value": "fields.System.Title",
                    "schema": {
                        "type": "string",
                        "example": "Login page returns 500 after password reset"
                    },
                    "example": "Fix login page timeout"
                },
                {
                    "label": "State",
                    "value": "fields.System.State",
                    "schema": {
                        "type": "string",
                        "example": "New"
                    },
                    "example": "New"
                },
                {
                    "label": "Work Item Type",
                    "value": "fields.System.WorkItemType",
                    "schema": {
                        "type": "string",
                        "example": "Bug"
                    },
                    "example": "Bug"
                },
                {
                    "label": "Project",
                    "value": "fields.System.TeamProject",
                    "schema": {
                        "type": "string",
                        "example": "Web Platform"
                    },
                    "example": "MyProject"
                },
                {
                    "label": "Area Path",
                    "value": "fields.System.AreaPath",
                    "schema": {
                        "type": "string",
                        "example": "Web Platform\\Auth"
                    },
                    "example": "MyProject\\Web"
                },
                {
                    "label": "Iteration Path",
                    "value": "fields.System.IterationPath",
                    "schema": {
                        "type": "string",
                        "example": "Web Platform\\Sprint 42"
                    },
                    "example": "MyProject\\Sprint 1"
                },
                {
                    "label": "Description",
                    "value": "fields.System.Description",
                    "schema": {
                        "type": "string",
                        "example": "<div>Steps to reproduce: reset the password, then sign in.</div>"
                    },
                    "example": "<p>Users experience timeout on login page</p>"
                },
                {
                    "label": "Tags",
                    "value": "fields.System.Tags",
                    "schema": {
                        "type": "string",
                        "example": "auth; regression"
                    },
                    "example": "security; api; critical"
                },
                {
                    "label": "Priority",
                    "value": "fields.Microsoft.VSTS.Common.Priority",
                    "schema": {
                        "type": "integer",
                        "example": 2
                    },
                    "example": 2
                },
                {
                    "label": "Assigned To (Display Name)",
                    "value": "fields.System.AssignedTo.displayName",
                    "schema": {
                        "type": "string",
                        "example": "Jane Doe"
                    },
                    "example": "John Doe"
                },
                {
                    "label": "Assigned To (Email)",
                    "value": "fields.System.AssignedTo.uniqueName",
                    "schema": {
                        "type": "string",
                        "example": "jane.doe@acme.com"
                    },
                    "example": "john.doe@example.com"
                },
                {
                    "label": "Created Date",
                    "value": "fields.System.CreatedDate",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00.123Z"
                    },
                    "example": "2024-01-15T10:30:00Z"
                },
                {
                    "label": "Changed Date",
                    "value": "fields.System.ChangedDate",
                    "schema": {
                        "type": "string",
                        "example": "2026-09-10T08:30:00.123Z"
                    },
                    "example": "2024-01-16T14:20:00Z"
                },
                {
                    "label": "Created By (Display Name)",
                    "value": "fields.System.CreatedBy.displayName",
                    "schema": {
                        "type": "string",
                        "example": "John Smith"
                    },
                    "example": "Jane Smith"
                },
                {
                    "label": "Web URL",
                    "value": "_links.html.href",
                    "schema": {
                        "type": "string",
                        "example": "https://dev.azure.com/acme/6ce954b1-ce1f-45d1-b94d-e6bf2464ba2c/_workitems/edit/1042"
                    },
                    "example": "https://dev.azure.com/myorg/myproject/_workitems/edit/42"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
