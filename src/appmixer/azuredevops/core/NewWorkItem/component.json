{
    "name": "appmixer.azuredevops.core.NewWorkItem",
    "label": "New Work Item",
    "description": "Triggers when a new work item is created in an Azure DevOps project.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "trigger": true,
    "webhook": true,
    "auth": {
        "service": "appmixer:azuredevops"
    },
    "quota": {
        "manager": "appmixer:azuredevops",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "organization": {
                    "type": "string"
                },
                "projectId": {
                    "type": "string"
                },
                "workItemType": {
                    "type": "string"
                }
            },
            "required": [
                "organization",
                "projectId"
            ]
        },
        "inspector": {
            "inputs": {
                "organization": {
                    "type": "text",
                    "index": 1,
                    "label": "Organization",
                    "tooltip": "The name of your Azure DevOps organization (e.g. <b>mycompany</b> from <i>https://dev.azure.com/mycompany</i>)."
                },
                "projectId": {
                    "type": "text",
                    "index": 2,
                    "label": "Project ID",
                    "tooltip": "The ID (GUID) of the Azure DevOps project to monitor. You can find this in the project settings or by using the List Projects component."
                },
                "workItemType": {
                    "type": "text",
                    "index": 3,
                    "label": "Work Item Type Filter",
                    "tooltip": "Optional. Filter triggers to a specific work item type (e.g. <b>Bug</b>, <b>Task</b>). Leave blank to trigger for all work item types."
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Work Item ID",
                    "value": "resource.id",
                    "schema": {
                        "type": "integer",
                        "example": 42
                    }
                },
                {
                    "label": "Revision",
                    "value": "resource.rev",
                    "schema": {
                        "type": "integer",
                        "example": 1
                    }
                },
                {
                    "label": "API URL",
                    "value": "resource.url",
                    "schema": {
                        "type": "string",
                        "example": "https://dev.azure.com/myorg/myproject/_apis/wit/workItems/42"
                    }
                },
                {
                    "label": "Title",
                    "value": "resource.fields.System.Title",
                    "schema": {
                        "type": "string",
                        "example": "Fix login page timeout"
                    }
                },
                {
                    "label": "State",
                    "value": "resource.fields.System.State",
                    "schema": {
                        "type": "string",
                        "example": "New"
                    }
                },
                {
                    "label": "Work Item Type",
                    "value": "resource.fields.System.WorkItemType",
                    "schema": {
                        "type": "string",
                        "example": "Bug"
                    }
                },
                {
                    "label": "Project",
                    "value": "resource.fields.System.TeamProject",
                    "schema": {
                        "type": "string",
                        "example": "MyProject"
                    }
                },
                {
                    "label": "Area Path",
                    "value": "resource.fields.System.AreaPath",
                    "schema": {
                        "type": "string",
                        "example": "MyProject\\Web"
                    }
                },
                {
                    "label": "Description",
                    "value": "resource.fields.System.Description",
                    "schema": {
                        "type": "string",
                        "example": "<p>Users experience timeout on login page</p>"
                    }
                },
                {
                    "label": "Tags",
                    "value": "resource.fields.System.Tags",
                    "schema": {
                        "type": "string",
                        "example": "security; api"
                    }
                },
                {
                    "label": "Priority",
                    "value": "resource.fields.Microsoft.VSTS.Common.Priority",
                    "schema": {
                        "type": "integer",
                        "example": 2
                    }
                },
                {
                    "label": "Assigned To (Display Name)",
                    "value": "resource.fields.System.AssignedTo.displayName",
                    "schema": {
                        "type": "string",
                        "example": "John Doe"
                    }
                },
                {
                    "label": "Assigned To (Email)",
                    "value": "resource.fields.System.AssignedTo.uniqueName",
                    "schema": {
                        "type": "string",
                        "example": "john.doe@example.com"
                    }
                },
                {
                    "label": "Created Date",
                    "value": "resource.fields.System.CreatedDate",
                    "schema": {
                        "type": "string",
                        "example": "2024-01-15T10:30:00Z"
                    }
                },
                {
                    "label": "Created By (Display Name)",
                    "value": "resource.fields.System.CreatedBy.displayName",
                    "schema": {
                        "type": "string",
                        "example": "Jane Smith"
                    }
                },
                {
                    "label": "Event Type",
                    "value": "eventType",
                    "schema": {
                        "type": "string",
                        "example": "workitem.created"
                    }
                },
                {
                    "label": "Event ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "5b6c7d8e-9f01-4a2b-8c3d-4e5f6a7b8c9d"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
