{
    "name": "appmixer.azuredevops.core.UpdatedWorkItem",
    "label": "Updated Work Item",
    "description": "Triggers when a work item is updated in an Azure DevOps project.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "trigger": true,
    "webhook": true,
    "auth": {
        "service": "appmixer:azuredevops"
    },
    "quota": {
        "manager": "appmixer:azuredevops",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "organization": {
                    "type": "string"
                },
                "projectId": {
                    "type": "string"
                },
                "workItemType": {
                    "type": "string"
                }
            },
            "required": [
                "organization",
                "projectId"
            ]
        },
        "inspector": {
            "inputs": {
                "organization": {
                    "type": "text",
                    "index": 1,
                    "label": "Organization",
                    "tooltip": "The name of your Azure DevOps organization (e.g. <b>mycompany</b> from <i>https://dev.azure.com/mycompany</i>)."
                },
                "projectId": {
                    "type": "text",
                    "index": 2,
                    "label": "Project ID",
                    "tooltip": "The ID (GUID) of the Azure DevOps project to monitor. You can find this in the project settings or by using the List Projects component."
                },
                "workItemType": {
                    "type": "text",
                    "index": 3,
                    "label": "Work Item Type Filter",
                    "tooltip": "Optional. Filter triggers to a specific work item type (e.g. <b>Bug</b>, <b>Task</b>). Leave blank to trigger for all work item types."
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Work Item ID",
                    "value": "resource.workItemId",
                    "schema": {
                        "type": "integer",
                        "example": 42
                    }
                },
                {
                    "label": "Revision Number",
                    "value": "resource.rev",
                    "schema": {
                        "type": "integer",
                        "example": 2
                    }
                },
                {
                    "label": "API URL",
                    "value": "resource.url",
                    "schema": {
                        "type": "string",
                        "example": "https://dev.azure.com/myorg/myproject/_apis/wit/workItems/42"
                    }
                },
                {
                    "label": "Title (Revised)",
                    "value": "resource.revision.fields.System.Title",
                    "schema": {
                        "type": "string",
                        "example": "Fix login page timeout"
                    }
                },
                {
                    "label": "State (Revised)",
                    "value": "resource.revision.fields.System.State",
                    "schema": {
                        "type": "string",
                        "example": "Active"
                    }
                },
                {
                    "label": "Work Item Type",
                    "value": "resource.revision.fields.System.WorkItemType",
                    "schema": {
                        "type": "string",
                        "example": "Bug"
                    }
                },
                {
                    "label": "Project",
                    "value": "resource.revision.fields.System.TeamProject",
                    "schema": {
                        "type": "string",
                        "example": "MyProject"
                    }
                },
                {
                    "label": "Area Path (Revised)",
                    "value": "resource.revision.fields.System.AreaPath",
                    "schema": {
                        "type": "string",
                        "example": "MyProject\\Web"
                    }
                },
                {
                    "label": "Tags (Revised)",
                    "value": "resource.revision.fields.System.Tags",
                    "schema": {
                        "type": "string",
                        "example": "security; api"
                    }
                },
                {
                    "label": "Priority (Revised)",
                    "value": "resource.revision.fields.Microsoft.VSTS.Common.Priority",
                    "schema": {
                        "type": "integer",
                        "example": 2
                    }
                },
                {
                    "label": "Assigned To (Revised, Display Name)",
                    "value": "resource.revision.fields.System.AssignedTo.displayName",
                    "schema": {
                        "type": "string",
                        "example": "John Doe"
                    }
                },
                {
                    "label": "Assigned To (Revised, Email)",
                    "value": "resource.revision.fields.System.AssignedTo.uniqueName",
                    "schema": {
                        "type": "string",
                        "example": "john.doe@example.com"
                    }
                },
                {
                    "label": "Changed Date",
                    "value": "resource.revision.fields.System.ChangedDate",
                    "schema": {
                        "type": "string",
                        "example": "2024-01-16T14:20:00Z"
                    }
                },
                {
                    "label": "Changed By (Display Name)",
                    "value": "resource.revision.fields.System.ChangedBy.displayName",
                    "schema": {
                        "type": "string",
                        "example": "Jane Smith"
                    }
                },
                {
                    "label": "Updated Fields",
                    "value": "resource.fields",
                    "schema": {
                        "type": "object",
                        "example": {
                            "System.State": {
                                "oldValue": "New",
                                "newValue": "Active"
                            }
                        }
                    }
                },
                {
                    "label": "Event Type",
                    "value": "eventType",
                    "schema": {
                        "type": "string",
                        "example": "workitem.updated"
                    }
                },
                {
                    "label": "Event ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "7d8e9f01-2a3b-4c5d-8e6f-7a8b9c0d1e2f"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
