{
    "name": "appmixer.jotform.core.NewFormSubmission",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Triggers when a form is submitted. To retrieve submission answers, use Get Form Submission component.",
    "private": false,
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "formId": {
                    "type": "string",
                    "x-connector-source": {
                        "operationId": "GetUserForms",
                        "transform": "result[].{value: id, label: title }"
                    }
                }
            },
            "required": [
                "formId"
            ]
        },
        "inspector": {
            "inputs": {
                "formId": {
                    "type": "text",
                    "index": 0,
                    "label": "Form ID",
                    "source": {
                        "url": "/component/appmixer/jotform/core/GetUserForms?outPort=out",
                        "data": {
                            "transform": "./transform#toSelectOptions"
                        }
                    }
                }
            }
        }
    },
    "auth": {
