{
    "name": "appmixer.jotform.core.GetFormSubmission",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Get Form Submission",
    "version": "1.0.1",
    "private": false,
    "auth": {
        "service": "appmixer:jotform"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "required": [
                    "id"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "id": {
                        "type": "text",
                        "index": 0,
                        "label": "Submission ID"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Response Code",
                    "value": "responseCode",
                    "schema": {
                        "type": "integer",
                        "example": 200
                    }
                },
                {
                    "label": "Message",
                    "value": "message",
                    "schema": {
                        "type": "string",
                        "example": "success"
                    }
                },
                {
                    "label": "Content",
                    "value": "content",
                    "schema": {
                        "type": "object",
                        "example": {
                            "id": "6328482234222812384",
                            "form_id": "242678198603467",
                            "ip": "193.179.66.224",
                            "created_at": "2025-09-04 22:23:43",
                            "updated_at": "2025-09-05 08:10:12",
                            "status": "ACTIVE",
                            "new": "1",
                            "workflowStatus": "Approve",
                            "answers": {
                                "3": {
                                    "name": "fullName3",
                                    "order": "1",
                                    "text": "Full Name",
                                    "type": "control_fullname",
                                    "answer": {
                                        "first": "John",
                                        "last": "Doe"
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "label": "Content.Submission ID",
                    "value": "content.id",
                    "schema": {
                        "type": "string",
                        "example": "6328482234222812384"
                    }
                },
                {
                    "label": "Content.Form ID",
                    "value": "content.form_id",
                    "schema": {
                        "type": "string",
                        "example": "242678198603467"
                    }
                },
                {
                    "label": "Content.Ip",
                    "value": "content.ip",
                    "schema": {
                        "type": "string",
                        "example": "193.179.66.224"
                    }
                },
                {
                    "label": "Content.Created At",
                    "value": "content.created_at",
                    "schema": {
                        "type": "string",
                        "example": "2025-09-04 22:23:43"
                    }
                },
                {
                    "label": "Content.Updated At",
                    "value": "content.updated_at",
                    "schema": {
                        "type": "string",
                        "example": "2025-09-05 08:10:12"
                    }
                },
                {
                    "label": "Content.Status",
                    "value": "content.status",
                    "schema": {
                        "type": "string",
                        "example": "ACTIVE"
                    }
                },
                {
                    "label": "Content.New",
                    "value": "content.new",
                    "schema": {
                        "type": "string",
                        "example": "1"
                    }
                },
                {
                    "label": "Content.Answers",
                    "value": "content.answers",
                    "schema": {
                        "type": "object",
                        "example": {
                            "3": {
                                "name": "fullName3",
                                "order": "1",
                                "text": "Full Name",
                                "type": "control_fullname",
                                "answer": {
                                    "first": "John",
                                    "last": "Doe"
                                }
                            }
                        }
                    }
                },
                {
                    "label": "Content.Answers List",
                    "value": "content.answersList",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "example": "phoneNumber5"
                                },
                                "order": {
                                    "type": "string",
                                    "example": "5"
                                },
                                "text": {
                                    "type": "string",
                                    "example": "Phone Number"
                                },
                                "type": {
                                    "type": "string",
                                    "example": "control_phone"
                                },
                                "sublabels": {
                                    "type": "object",
                                    "example": {
                                        "area": "Area Code",
                                        "phone": "Phone Number"
                                    }
                                },
                                "answer": {
                                    "examples": [
                                        "Internet",
                                        {
                                            "first": "FULL NAME",
                                            "last": "LAST NAME"
                                        },
                                        [
                                            [
                                                "me",
                                                "there",
                                                "123456"
                                            ],
                                            [
                                                "",
                                                "",
                                                ""
                                            ]
                                        ]
                                    ]
                                },
                                "prettyFormat": {
                                    "type": "string",
                                    "example": "FULL NAME LAST NAME"
                                }
                            }
                        },
                        "example": [
                            {
                                "name": "phoneNumber5",
                                "order": "5",
                                "text": "Phone Number",
                                "type": "control_phone",
                                "sublabels": {
                                    "area": "Area Code",
                                    "phone": "Phone Number"
                                },
                                "answer": {
                                    "area": "555",
                                    "phone": "555-0123"
                                },
                                "prettyFormat": "(555) 555-0123"
                            }
                        ]
                    }
                },
                {
                    "label": "Content.Workflow Status",
                    "value": "content.workflowStatus",
                    "schema": {
                        "type": "string",
                        "example": "Approve"
                    }
                },
                {
                    "label": "Limit Left",
                    "value": "limit-left",
                    "schema": {
                        "type": "integer",
                        "example": 943
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
