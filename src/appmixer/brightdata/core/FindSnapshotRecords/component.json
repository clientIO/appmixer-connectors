{
    "name": "appmixer.brightdata.core.FindSnapshotRecords",
    "label": "Find Snapshot Records",
    "description": "Download the records collected in a ready Bright Data Web Scraper API snapshot.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:brightdata"
    },
    "quota": {
        "manager": "appmixer:brightdata",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "snapshotId": {
                        "type": "string"
                    },
                    "outputType": {
                        "type": "string"
                    }
                },
                "required": [
                    "snapshotId"
                ]
            },
            "inspector": {
                "inputs": {
                    "snapshotId": {
                        "type": "text",
                        "index": 1,
                        "label": "Snapshot ID",
                        "tooltip": "The snapshot ID returned by <b>Trigger Dataset Collection</b>. Required at run time. The snapshot must be <code>ready</code> — check it first with <b>Get Snapshot Status</b>."
                    },
                    "outputType": {
                        "type": "select",
                        "index": 2,
                        "label": "Output Type",
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/brightdata/core/FindSnapshotRecords?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType",
                        "in/snapshotId": "dummy"
                    }
                }
            }
        },
        {
            "name": "notFound"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
