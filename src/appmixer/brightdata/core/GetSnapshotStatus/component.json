{
    "name": "appmixer.brightdata.core.GetSnapshotStatus",
    "label": "Get Snapshot Status",
    "description": "Check whether a Bright Data Web Scraper API snapshot is still collecting, ready to download or failed.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:brightdata"
    },
    "quota": {
        "manager": "appmixer:brightdata",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "snapshotId": {
                        "type": "string"
                    }
                },
                "required": [
                    "snapshotId"
                ]
            },
            "inspector": {
                "inputs": {
                    "snapshotId": {
                        "type": "text",
                        "index": 1,
                        "label": "Snapshot ID",
                        "tooltip": "The snapshot ID returned by <b>Trigger Dataset Collection</b>, for example <code>sd_mt8vchh6qim0z7s05</code>."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "snapshotId": {
                        "type": "string",
                        "title": "Snapshot ID",
                        "example": "sd_mt8vchh6qim0z7s05"
                    },
                    "datasetId": {
                        "type": "string",
                        "title": "Dataset ID",
                        "example": "gd_l1viktl72bvl7bjuj0"
                    },
                    "status": {
                        "type": "string",
                        "title": "Status",
                        "example": "ready"
                    },
                    "isReady": {
                        "type": "boolean",
                        "title": "Is Ready",
                        "example": true
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
