{
    "name": "appmixer.brightdata.core.MakeApiCall",
    "label": "Make API Call",
    "description": "Perform an arbitrary authorized API call to Bright Data. Provide a path (or full URL), method, headers, query parameters and body. The API token header is added automatically.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:brightdata"
    },
    "quota": {
        "manager": "appmixer:brightdata",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "url": {
                        "type": "string"
                    },
                    "method": {
                        "type": "string",
                        "enum": [
                            "GET",
                            "POST",
                            "PUT",
                            "PATCH",
                            "DELETE"
                        ]
                    },
                    "headers": {
                        "type": "string"
                    },
                    "parameters": {
                        "type": "string"
                    },
                    "body": {
                        "type": "string"
                    }
                },
                "required": [
                    "url",
                    "method"
                ]
            },
            "inspector": {
                "inputs": {
                    "url": {
                        "type": "text",
                        "index": 1,
                        "label": "API Endpoint Path",
                        "tooltip": "A path relative to <code>https://api.brightdata.com</code>, for example <code>/datasets/v3/snapshots</code>. A full URL is accepted only when it points at <code>https://api.brightdata.com</code>; any other host is rejected so your API token is never sent elsewhere."
                    },
                    "method": {
                        "type": "select",
                        "index": 2,
                        "label": "HTTP Method",
                        "defaultValue": "GET",
                        "tooltip": "The HTTP method for the API call.",
                        "options": [
                            {
                                "label": "GET",
                                "value": "GET"
                            },
                            {
                                "label": "POST",
                                "value": "POST"
                            },
                            {
                                "label": "PUT",
                                "value": "PUT"
                            },
                            {
                                "label": "PATCH",
                                "value": "PATCH"
                            },
                            {
                                "label": "DELETE",
                                "value": "DELETE"
                            }
                        ]
                    },
                    "parameters": {
                        "type": "key-value",
                        "keyLabel": "Key",
                        "valueLabel": "Value",
                        "addLabel": "Add item",
                        "removeLabel": "Remove item",
                        "index": 3,
                        "label": "Query Parameters",
                        "tooltip": "Optional query parameters, for example <code>dataset_id</code>."
                    },
                    "body": {
                        "type": "textarea",
                        "index": 4,
                        "label": "Request Body",
                        "tooltip": "Optional JSON request body."
                    },
                    "headers": {
                        "type": "key-value",
                        "keyLabel": "Key",
                        "valueLabel": "Value",
                        "addLabel": "Add item",
                        "removeLabel": "Remove item",
                        "index": 5,
                        "label": "Request Headers",
                        "tooltip": "Optional additional headers. The Authorization header is set automatically."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "statusCode": {
                        "type": "integer",
                        "title": "Status Code",
                        "example": 200
                    },
                    "headers": {
                        "type": "object",
                        "title": "Response Headers",
                        "properties": {}
                    },
                    "body": {
                        "type": "object",
                        "title": "Response Body",
                        "properties": {}
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
